cabal-version:      2.4
name:               interp-grade
version:            0.1.0.0
build-type:         Simple

library
  exposed-modules:  Prolog.Term
                  , Prolog.Solve
                  , Prolog.Read
                  , Prolog.Tabling
  hs-source-dirs:   src
  build-depends:    base >=4 && <5
                  , logict
                  , containers
                  , mtl
                  , text
  default-language: Haskell2010
  default-extensions: LambdaCase

executable interp-grade
  main-is:          Main.hs
  hs-source-dirs:   app
  build-depends:    base, interp-grade, containers, text
  default-language: Haskell2010
