; expect: rc=0
; A boop_lane relation a program would read; no executor serves the name yet.
(: boop_lane
   (* (: lane str)
      (: branch str)
      (: goal str)
      (: spawned_ts int)))

(: boop_lane_error
   (* (: lane str)
      (: message str)))

(: Watch (* (: lane str)))

(Watch "sprefa-coordinator")

(: Lane
   (* (: lane str)
      (: branch str)))

(<- (Lane ?Lane ?Branch)
    (Watch ?Lane)
    (boop_lane ?Lane ?Branch ?Goal ?SpawnedTs))
