; expect: rc=0
; A clock drives a poll; each poll reads fetch_json for the watched url.
(: timer
   (* (: period_ms int)
      (: tick int)))

(: fetch_json
   (* (: url str)
      (: body str)))

(: fetch_json_error
   (* (: url str)
      (: status int)
      (: message str)))

(: Watch (* (: url str)))

(Watch "http://127.0.0.1:9/repos/cli/cli")

(: Poll
   (* (: url str)
      (: tick int)))

(<- (Poll ?Url ?Tick)
    (Watch ?Url)
    (timer 100 ?Tick))

(: Response
   (* (: url str)
      (: tick int)
      (: body str)))

(<- (Response ?Url ?Tick ?Body)
    (Poll ?Url ?Tick)
    (fetch_json ?Url ?Body))

(: Failed
   (* (: url str)
      (: tick int)
      (: status int)))

(<- (Failed ?Url ?Tick ?Status)
    (Poll ?Url ?Tick)
    (fetch_json_error ?Url ?Status ?Message))
