; expect: rc=0
; A continuing file relation: one row per path and content id under a root.
(: soopy_files
   (* (: root str)
      (: path str)
      (: content str)))

(: soopy_files_error
   (* (: root str)
      (: message str)))

(: Watch (* (: root str)))

(Watch "__ROOT__")

(: File
   (* (: path str)
      (: content str)))

(<- (File ?Path ?Content)
    (Watch ?Root)
    (soopy_files ?Root ?Path ?Content))
