index ef91e0b6..a25f10fb 100644
--- a/v6/sprefa-store/src/engine.rs
+++ b/v6/sprefa-store/src/engine.rs
@@ -718,6 +718,135 @@ pub async fn retract_signed_delta(
     Ok(rounds)
 }
 
+/// PROBE (feature/sqlite-recursive-probe) Q1: the signed-delta survivor
+/// recomputation as ONE recursive CTE. `retract_signed_delta` climbs the reach
+/// wave one round per statement (~26-27 exec dispatches); this collapses the
+/// whole round loop into a single `WITH RECURSIVE alive(key)` reach walk from the
+/// surviving roots, then republishes the store's weight in one more statement.
+/// Byte-identical survivors: the round-per-row guard in the loop form only stops
+/// re-emission; the least-fixpoint reach set is the same set either way.
+///
+/// The probe wall, stated plainly: the ROUND cannot ride as a CTE column. SQLite
+/// rejects a second reference to the recursive CTE in its own recursive term
+/// ("multiple recursive references"), so the accumulated-set guard (`child NOT IN
+/// (SELECT key FROM alive)`) is impossible; and a `(round,key)` column breaks
+/// UNION-distinct termination (each round is a fresh key row, so a cycle never
+/// yields zero new rows). What survives the constraint is exactly the UNROUNDED
+/// distinct reach walk below, which is why the per-round delta/refcount fold (the
+/// half that must see the accumulated alive set) stays outside the CTE, in
+/// `retract_delta_fold` / `retract_signed_delta`.
+pub async fn retract_signed_delta_cte(
+    db: &DatabaseConnection,
+    ns: &GraphNs,
+    seeds: &[(i64, i64)],
+) -> Result<u64, DbErr> {
+    let txn = db.begin().await?;
+    let seed_in = {
+        let v: Vec<String> = seeds.iter().map(|(t, i)| key(*t, *i).to_string()).collect();
+        if v.is_empty() { "(-1)".to_string() } else { format!("({})", v.join(",")) }
+    };
+    // Sink = the reach set, in cx_frontier. The recursive walk is roots-minus-seeds
+    // then forward over every edge; UNION (distinct) terminates on cycles exactly
+    // like retract_dred_cte's cone.
+    exec(&txn, &format!("DELETE FROM {}", ns.frontier)).await?;
+    exec(&txn, &format!(
+        "INSERT INTO {frontier}(key)
+         WITH RECURSIVE alive(key) AS (
+            SELECT r.key FROM {row} r
+             WHERE r.key NOT IN {seed_in}
+               AND NOT EXISTS (SELECT 1 FROM {dep} d WHERE d.child_key = r.key)
+            UNION
+            SELECT d.child_key FROM alive
+              JOIN {dep} d ON d.parent_key = alive.key
+         )
+         SELECT key FROM alive",
+        frontier = ns.frontier, row = ns.row, dep = ns.dep,
+    ))
+    .await?;
+    exec(&txn, &format!(
+        "UPDATE {row} SET weight = CASE WHEN key IN (SELECT key FROM {frontier}) THEN 1 ELSE 0 END",
+        row = ns.row, frontier = ns.frontier,
+    ))
+    .await?;
+    txn.commit().await?;
+    Ok(0)
+}
+
+/// PROBE (feature/sqlite-recursive-probe) Q2: folded consolidation. Same
+/// least-fixpoint survivors as `retract_signed_delta`, but `cx_refcount` is an
+/// append-only accumulator that GROWS by `INSERT OR IGNORE` each round instead of
+/// being `DELETE`d then refilled from the whole `cx_row` (the 960k-row refill is
+/// the b-tree churn this removes). Consolidation is an incremental fold per round,
+/// never a periodic GROUP BY/HAVING sweep over accumulated deltas. `delta` stays
+/// append-only for the tick. Byte-identical survivors (the fold ends with
+/// refcount = exactly the reach set, n=1, which is what the loop form's refill
+/// plus OR-REPLACE produced).
+pub async fn retract_delta_fold(
+    db: &DatabaseConnection,
+    ns: &GraphNs,
+    seeds: &[(i64, i64)],
+) -> Result<u64, DbErr> {
+    let p = ns.row.trim_end_matches("cx_row");
+    let refcount = format!("{p}cx_refcount");
+    let delta = format!("{p}cx_delta");
+
+    let txn = db.begin().await?;
+    exec(&txn, &format!("DELETE FROM {refcount}", refcount = refcount)).await?;
+    exec(&txn, &format!("DELETE FROM {delta}", delta = delta)).await?;
+
+    let seed_in = {
+        let v: Vec<String> = seeds.iter().map(|(t, i)| key(*t, *i).to_string()).collect();
+        if v.is_empty() { "(-1)".to_string() } else { format!("({})", v.join(",")) }
+    };
+    // Round 0 fold: surviving roots into the delta, then into the accumulator.
+    exec(&txn, &format!(
+        "INSERT OR IGNORE INTO {delta}(round,key,diff)
+         SELECT 0, r.key, 1 FROM {row} r
+         WHERE r.key NOT IN {seed_in}
+           AND NOT EXISTS (SELECT 1 FROM {dep} d WHERE d.child_key = r.key)",
+        delta = delta, row = ns.row, dep = ns.dep,
+    ))
+    .await?;
+    exec(&txn, &format!(
+        "INSERT OR IGNORE INTO {refcount}(key,n) SELECT key, 1 FROM {delta} WHERE round = 0",
+        refcount = refcount, delta = delta,
+    ))
+    .await?;
+
+    let mut rounds = 0u64;
+    let mut r: i64 = 0;
+    loop {
+        if scalar(&txn, &format!("SELECT count(*) FROM {delta} WHERE round={r}", delta = delta)).await? == 0 {
+            break;
+        }
+        rounds += 1;
+        exec(&txn, &format!(
+            "INSERT OR IGNORE INTO {delta}(round,key,diff)
