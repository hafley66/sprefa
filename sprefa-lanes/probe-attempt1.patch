+//! PROBE (feature/sqlite-recursive-probe): the WITH RECURSIVE round collapser and
+//! the folded-consolidation delta.
+//!
+//! Questions, measured head-to-head on the SAME fixtures the appendix banked
+//! (DAG 960k = gen_multi_cyclic(6,160000,0); CYC 960k s7 = ...s7):
+//!
+//!   Q1 - can recursive CTEs collapse the retraction round loop into ONE VM entry?
+//!        * dred-loop (banked 1753.4ms / 53 stmt) vs dred-cte (6 stmt) vs
+//!          signed-delta (27 stmt) vs signed-delta-cte RS (~3 stmt).
+//!   Q2 - fewer b-tree writes via append-only delta + incremental fold?
+//!        * delta-fold FC: same survivors as signed-delta, but cx_refcount grows
+//!          by OR IGNORE per round (an incremental fold) instead of a full
+//!          DELETE+refill from cx_row. b-tree write volume = db/WAL byte delta
+//!          bracketing the retract (sqlite3_status PAGEWRITE is NOT compiled into
+//!          this bundled libsqlite3: opcode 7 is the deprecated PAGECACHE_SIZE
+//!          memory counter, so file bytes are the reachable proxy).
+//!
+//! Every variant is verified byte-identical to the resident oracle's survivor set.
+//!
+//!   cargo run --release --example recursive_probe -- [layers width stride]
+//!   (with args = one fixture; no args = the two 960k fixtures + small sanity set)
+
+use std::time::Instant;
+
+use sea_orm::{ConnectOptions, ConnectionTrait, Database};
+use sprefa_store::{benchgraph, benchgraph::MultiGraph, relstore::RelStore, stmt_counter};
+
+fn fingerprint(keys: &[i64]) -> String {
+    let mut h = blake3::Hasher::new();
+    for k in keys {
+        h.update(&k.to_le_bytes());
+    }
+    h.finalize().to_hex()[..16].to_string()
+}
+
+async fn open_store() -> (RelStore, std::path::PathBuf) {
+    static N: std::sync::atomic::AtomicU64 = std::sync::atomic::AtomicU64::new(0);
+    let uniq = N.fetch_add(1, std::sync::atomic::Ordering::Relaxed);
+    let path = std::env::temp_dir().join(format!("probe_{}_{uniq}.sqlite", std::process::id()));
+    let _ = std::fs::remove_file(&path);
+    let mut opt = ConnectOptions::new(format!("sqlite://{}?mode=rwc", path.display()));
+    opt.max_connections(1).min_connections(1);
+    let store = RelStore::attach(Database::connect(opt).await.unwrap())
+        .await
+        .unwrap();
+    (store, path)
+}
+
+fn db_bytes(path: &std::path::Path) -> i64 {
+    std::fs::metadata(path).map(|m| m.len() as i64).unwrap_or(0)
+        + std::fs::metadata(format!("{}-wal", path.display()))
+            .map(|m| m.len() as i64)
+            .unwrap_or(0)
+}
+
+struct Row {
+    variant: &'static str,
+    ms: f64,
+    stmts: u64,
+    survivors: usize,
+    correct: bool,
+    write_mb: f64,
+}
+
+/// Load the graph (untimed), then run `op` timed and gather metrics. WAL is
+/// checkpoint-truncated before and after so `write_mb` = persistent b-tree bytes
+/// written by the retract alone.
+async fn measure<F>(g: &MultiGraph, variant: &'static str, op: F) -> Row
+where
+    F: for<'a> FnOnce(
+        &'a RelStore,
+        (i64, i64),
+    ) -> std::pin::Pin<Box<dyn std::future::Future<Output = u64> + 'a>>,
+{
+    let rows: Vec<(i64, i64, i64)> = g.rows.iter().map(|(t, i, w)| (*t as i64, *i, *w)).collect();
+    let deps: Vec<(i64, i64, i64, i64)> = g
+        .edges
+        .iter()
+        .map(|(pt, pi, ct, ci)| (*pt as i64, *pi, *ct as i64, *ci))
+        .collect();
+    let seed = (g.seed.0 as i64, g.seed.1);
+    let (store, path) = open_store().await;
+    store.add_rows(&rows).await.unwrap();
+    store.add_deps(&deps).await.unwrap();
+    drop(rows);
+    drop(deps);
+    store
+        .conn()
+        .execute_unprepared("PRAGMA wal_checkpoint(TRUNCATE);")
+        .await
+        .ok();
+    let before = db_bytes(&path);
+
+    stmt_counter::reset();
+    let t = Instant::now();
+    op(&store, seed).await;
+    let ms = t.elapsed().as_secs_f64() * 1e3;
+    let stmts = stmt_counter::get();
+
+    store
+        .conn()
+        .execute_unprepared("PRAGMA wal_checkpoint(TRUNCATE);")
+        .await
+        .ok();
+    let after = db_bytes(&path);
+    let survivors = store.alive_keys().await.unwrap();
+    let correct = fingerprint(&survivors) == {
+        // oracle survivor hash for this graph/seed
+        let o: Vec<i64> = benchgraph::oracle_survivors(g, g.seed)
+            .into_iter()
+            .collect();
+        fingerprint(&o)
+    };
+    let write_mb = (after - before) as f64 / 1048576.0;
+    let r = Row {
+        variant,
+        ms,
+        stmts,
+        survivors: survivors.len(),
+        correct,
+        write_mb,
+    };
+    drop(store);
+    let _ = std::fs::remove_file(&path);
+    let _ = std::fs::remove_file(format!("{}-wal", path.display()));
+    let _ = std::fs::remove_file(format!("{}-shm", path.display()));
+    r
+}
+
+async fn dred_loop(s: &RelStore, seed: (i64, i64)) -> u64 {
+    s.retract_dred(&[seed]).await.unwrap()
+}
+async fn dred_cte(s: &RelStore, seed: (i64, i64)) -> u64 {
+    s.retract_dred_cte(&[seed]).await.unwrap()
+}
+async fn signed_delta(s: &RelStore, seed: (i64, i64)) -> u64 {
+    sprefa_store::cascade::retract_signed_delta(s.conn(), s.ns(), &[seed])
+        .await
+        .unwrap()
+}
+async fn signed_delta_cte(s: &RelStore, seed: (i64, i64)) -> u64 {
+    s.retract_signed_delta_cte(&[seed]).await.unwrap()
+}
+async fn delta_fold(s: &RelStore, seed: (i64, i64)) -> u64 {
+    s.retract_delta_fold(&[seed]).await.unwrap()
+}
+
+type VariantFn = for<'a> fn(
+    &'a RelStore,
+    (i64, i64),
+) -> std::pin::Pin<Box<dyn std::future::Future<Output = u64> + 'a>>;
+
+/// Each variant is a multi-statement set (5 store variants; dd/oracle handled
+/// separately in the report via the banked appendix).
+async fn run_fixture(label: &str, l: usize, w: usize, stride: usize) {
+    let g = benchgraph::gen_multi_cyclic(l, w, stride);
+    let nodes = g.rows.len();
+    let oracle: Vec<i64> = benchgraph::oracle_survivors(&g, g.seed)
+        .into_iter()
+        .collect();
+    let oracle_hash = fingerprint(&oracle);
+    println!(
+        "\n## {label} - nodes≈{nodes}, stride={shape}\n",
+        shape = if stride == 0 { "DAG" } else { "CYC" }
+    );
+    println!("oracle survivors={} hash={oracle_hash}\n", oracle.len());
+    println!("| variant | ms | stmts | survivors | correct | new-page MB |");
+    println!("|---|---:|---:|---:|:---:|---:|");
+
+    let fns: Vec<(VariantFn, &'static str)> = vec![
+        (|s, seed| Box::pin(dred_loop(s, seed)), "dred-loop"),
+        (|s, seed| Box::pin(dred_cte(s, seed)), "dred-cte"),
+        (|s, seed| Box::pin(signed_delta(s, seed)), "signed-delta"),
+        (
+            |s, seed| Box::pin(signed_delta_cte(s, seed)),
+            "signed-delta-cte (RS)",
+        ),
+        (|s, seed| Box::pin(delta_fold(s, seed)), "delta-fold (FC)"),
+    ];
+    for (f, name) in fns {
+        let r = measure(&g, name, f).await;
+        println!(
+            "| {} | {:.1} | {} | {} | {} | {:.2} |",
+            r.variant,
+            r.ms,
+            r.stmts,
+            r.survivors,
+            if r.correct { "yes" } else { "**NO**" },
+            r.write_mb
+        );
+    }
+}
+
+#[tokio::main]
+async fn main() {
+    let args: Vec<String> = std::env::args().collect();
+    if args.len() >= 4 {
+        let l: usize = args[1].parse().unwrap();
+        let w: usize = args[2].parse().unwrap();
+        let bs: usize = args[3].parse().unwrap();
+        let label = if bs == 0 {
+            "DAG".to_string()
+        } else {
+            format!("CYC s{bs}")
+        };
+        run_fixture(&format!("{label} l={l} w={w}"), l, w, bs).await;
+        return;
+    }
+    run_fixture("DAG 60k", 6, 10_000, 0).await;
+    run_fixture("DAG 960k", 6, 160_000, 0).await;
+    run_fixture("CYC 960k s7", 6, 160_000, 7).await;
+}
