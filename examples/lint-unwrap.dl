# Lint: flag `.unwrap()` outside test code. Run as a live linter:
#   dl examples/lint-unwrap.dl --lsp
# and any LSP client (VSCode, Claude Code) shows a squiggle per match.
# @op ast_yaml
#
# Two ast-grep ops, small and side by side:
#
#   sg(path, rev, :lang, "$X.unwrap()", line, col, end_line, end_col[, id])
#     A bare PATTERN. `$X` captures the receiver into dl var X (uppercase, same
#     name). Trailing positionals bind the match span (1-based line, 0-based byte
#     col). A pattern alone cannot say "but not inside a test".
#
#   ast_yaml(path, rev, :lang, `<RuleCore yaml>`, line, col, end_line, end_col)
#     A RELATIONAL rule (ast-grep's pattern/inside/has/not/any language, backtick
#     multiline). `not: inside: { kind: mod_item, has name ~ ^tests?$ }` walks the
#     CST ancestors and drops any unwrap contained in a `mod tests { }`. Real
#     structural containment — an unwrap in a comment/string, or in a differently
#     named production module, is judged correctly (no line-position heuristic).
#
# This program uses the relational form so the "outside test code" claim is true.
# `_` discards end_line; line/col/end_col drive the exact squiggle.
#
# SUPPRESSION: `use "std/suppress.dl"` brings the eslint/biome disable grammar
# into scope. An inline trailing `// dl-disable-line no-unwrap` on the offending
# line silences just that hit — the form a whole-line-only comment op could
# never express, now that `comment_node` sees inline comments. Block suppression
# (`dl-disable`/`dl-enable`) additionally needs the `lint_candidate` line below.
use "std/suppress.dl".

rel hit(path: file, line: int, col: int, end_col: int).

hit(path, line, col, end_col) <-
  scan("WORK", "src/**/*.rs", path, rev),
  ast_yaml(path, rev, :rust, `
pattern: $X.unwrap()
not:
  inside:
    kind: mod_item
    has:
      field: name
      regex: '^tests?$'
    stopBy: end
`, line, col, _, end_col).

# Expose the offense lines so a `dl-disable`/`dl-enable` BLOCK can close its
# range over them (line/next-line suppression needs no such contract).
lint_candidate(p, l) <- hit(p, l, _, _).

# Contribute the PRE-suppression findings so std/suppress.dl can warn on any
# `dl-disable no-unwrap` that covered no actual unwrap (the eslint
# reportUnusedDisableDirectives discipline). One extra head, like lint_candidate.
rail_finding(p, l, "no-unwrap") <- hit(p, l, _, _).

# Emit unless suppressed: check the specific code AND the unscoped `"*"` row.
diag(path, line, col, end_col, severity: "warn", code: "no-unwrap", msg: "unwrap() outside test code: use ? or expect(\"reason\")") <-
  hit(path, line, col, end_col),
  !suppressed(path, line, "no-unwrap"),
  !suppressed(path, line, "*").

? diag(path, line, col, end_col, severity, code, msg).
