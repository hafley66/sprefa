# The marker-splice codegen loop on v5's own type graph: keep a fan-out table
# inside this file's markers fresh. Run `dl examples/gen-type-table.dl` from
# the repo root; rerunning converges (no write when the table already matches).
# @op comment
#
# The three pieces:
#   comment  — extracts the marker pair's line coordinates (re-located every tick)
#   fan_out  — any derived relation (here: type_edge aggregation, top of the graph)
#   gen      — renders rows between the markers, in place
#
# BEGIN: fanout
# | BodyItem | 16 |
# | Daemon | 12 |
# | Engine | 13 |
# | ProjectCx | 11 |
# | Tok | 30 |
# END:
# (the table lands between the markers above, as `# | type | n |` rows)

rel seen(path: file).
seen(path) <- scan("WORK", "src/**/*.rs", path, rev), match(path, rev, /./, line).

rel fan_out(f: text, n: int).
fan_out(f, count(t)) <- type_edge(f, t, _, _).

rel hot(f: text, n: int).
hot(f, n) <- fan_out(f, n), n >= 10.

rel block(p: file, l0: int, l1: int, name: text).
block(p, l0, l1, name) <- scan("WORK", "examples/gen-type-table.dl", p, rev),
  comment(p, rev, /BEGIN: $name$/, /END:/, l0, l1, name).

gen(p, l0, l1, "# | {f} | {n} |") <- block(p, l0, l1, "fanout"), hot(f, n).
