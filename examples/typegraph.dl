# Self-hosted Rust type graph.
#
# `type_edge(from, to, kind, repo)` is a built-in relation populated by the
# syn-backed extractor. `kind` is one of field | variant | impl | generic.
# Closure walks the first two columns, so derive a relation over those columns
# when you want blast radius / fan-in queries. `repo` is trailing so it never
# disturbs that — it exists so two trees scanned in one engine instance that
# share a type name (e.g. comparing this crate against an old fork) don't
# collapse into one node; ignore it (`_`) for single-tree queries.
#
# `type_edge_rev(from, to, kind, rev, repo)` is the history-aware source of
# truth (same split as module_edge / module_edge_rev). Filter it to one rev
# before closure to diff the type graph across WORK vs HEAD. Plain `type_edge`
# is the rev-deduped union for simple current-state queries.
#
# Run: dl examples/typegraph.dl --root .

rel seen(path: file).
rel type_reaches(src: text, dst: text).
rel work_type(src: text, dst: text).
rel work_reaches(src: text, dst: text).

seen(path) <-
  scan("src/**/*.rs", path).

type_reaches(src, dst) <- closure(type_edge).

# rev-scoped blast radius: only the WORK type graph.
work_type(src, dst) <- type_edge_rev(src, dst, _, "WORK", _).
work_reaches(src, dst) <- closure(work_type).

? type_edge("Engine", to, kind, _).
? type_reaches("Engine", dst).
? type_edge_rev("Engine", to, kind, rev, _).
? work_reaches("Engine", dst).
