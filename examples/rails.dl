# Agent rails: checks scoped to the worktree diff, not the whole repo.
#
# The built-in `changed(path)` holds every path `git status` reports as
# differing from HEAD (modified, added, renamed, untracked). Joining a rail
# against it keeps the check from firing on pre-existing repo debt: only what
# the current edit session touched can trip it. That makes `--check` usable as
# an agent feedback loop (pre-commit hook, Claude Code PostToolUse hook):
# non-zero exit + diagnostic text comes back to the model, scoped to its diff.
#
# Run:   dl examples/rails.dl --root <repo> --check
# Hook:  dl examples/rails.dl --root <repo> --db .dl/rails.db --check
#
# Source rules (scan + match) extract per file and cannot join relations, so
# each rail is one extraction rule plus one derived rule joining `changed`.

# `col`/`end_col` are 0-based byte columns of the offending span within `line`
# (match's +2 trailing args bind the whole-match span). The LSP renders a
# sub-line squiggle when they are set; --check ignores them. end_line defaults
# to line, so each diagnostic stays single-line.

# ---- banned identifiers ------------------------------------------------------
rel banned_hit(p: file, l: int, c: int, ec: int, w: text).
banned_hit(p, l, c, ec, w) <-
    scan("WORK", "**/*.rs", p, rev),
    match(p, rev, /\b(?<w>provenance|substrate|regime)\b/, l, c, ec).

diag(path: p, line: l, col: c, end_col: ec, severity: "error", code: "banned-word", msg: "banned identifier `${w}`") <-
    banned_hit(p, l, c, ec, w), changed(p).

# ---- no new raw conn() outside the Db seam ------------------------------------
# The fenced typed literal fs:`src/db.rs` resolves against the scan root at
# check time, so a typo'd exemption path is itself a --check error instead of
# a silently never-matching string.
rel conn_hit(p: file, l: int, c: int, ec: int).
conn_hit(p, l, c, ec) <-
    scan("WORK", "src/**/*.rs", p, rev),
    match(p, rev, /\.conn\(\)/, l, c, ec).

diag(path: p, line: l, col: c, end_col: ec, severity: "warn", code: "conn-outside-db", msg: "raw .conn() in a changed file outside the Db seam") <-
    conn_hit(p, l, c, ec), changed(p),
    p != fs:`src/db.rs`.

# ---- unwrap budget per changed file -------------------------------------------
# Head-position aggregation: count(l) groups by p, so the budget is a number,
# not a boolean. Only changed files are counted.
rel unwrap_hit(p: file, l: int, c: int, ec: int).
unwrap_hit(p, l, c, ec) <-
    scan("WORK", "src/**/*.rs", p, rev),
    match(p, rev, /\.unwrap\(\)/, l, c, ec).

rel unwrap_count(p: text, n: int).
unwrap_count(p, count(l)) <- unwrap_hit(p, l, _, _), changed(p).

# Squiggle the exact `.unwrap()` span on every over-budget line, not line 1.
# Join the per-line hits back against the file count so each offending span
# carries the budget message. `unwrap_count` stays the per-file gate.
diag(path: p, line: l, col: c, end_col: ec, severity: "warn", code: "unwrap-budget", msg: "unwrap in a changed file over budget (${n} > 10)") <-
    unwrap_hit(p, l, c, ec), changed(p), unwrap_count(p, n), n > 10.

? diag(path, line, col, end_col, severity: sev, code, msg).
