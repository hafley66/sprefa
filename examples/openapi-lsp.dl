# OpenAPI -> code cross-link. Demonstrates: (1) one spec extract (json wildcard
# jpath), (2) one generic call extract + one generic def extract (regex over the
# codegen convention: operationId is the identifier), (3) the join that links
# them, (4) diag rows that become editor squiggles, (5) the ref-spine cross-link
# (cursor on getUser in client.ts -> references -> server.rs).
#
# Codegen contract: the TS call name and the RS fn name both equal the spec
# operationId verbatim. That identical string is what the spine interns, so
# definition/references crosses languages with no resolution logic.

rel diag(path: file, line: int, severity: text, code: text, msg: text).

# The contract: every operation in the spec.
rel spec_op(op: text).
spec_op(op) <- scan("WORK", "v5/examples/openapi-sim/openapi.json", p, rev),
               jsonp(p, rev, "paths.*.*.operationId", op).

# TS call sites. One regex over the codegen convention; the spec_op join filters.
rel call(p: file, l: int, op: text).
call(p, l, op) <- scan("WORK", "v5/examples/openapi-sim/client.ts", p, rev),
                  match(p, rev, /\b(?P<op>[A-Za-z_][A-Za-z0-9_]*)\s*\(/, l).

# RS definition sites.
rel def(p: file, l: int, op: text).
def(p, l, op) <- scan("WORK", "v5/examples/openapi-sim/server.rs", p, rev),
                 match(p, rev, /fn\s+(?P<op>[A-Za-z_][A-Za-z0-9_]*)\s*\(/, l).

# Happy path: a call that hits a spec op.
rel linked(op: text, p: file, l: int).
linked(op, p, l) <- call(p, l, op), spec_op(op).
diag(p, l, "info", "api-link", "calls spec op `${op}`") <- linked(op, p, l).

# Dead endpoint: defined in the server but never called by the client.
rel called(op: text).
called(op) <- call(_, _, op).
diag(p, l, "warn", "orphan-op", "spec op `${op}` defined but never called") <-
    def(p, l, op), !called(op).

? spec_op(op).
? linked(op, p, l).

# The two ends of the cross-language link, readable paths. `getUser` and
# `listUsers` each appear in BOTH: a TS call site and an RS def site. That shared
# string is what LSP textDocument/references joins across files (the raw `ref`
# spine stores file_id, not a path; the engine resolves it for the LSP handler).
? call(p, l, op).
? def(p, l, op).
