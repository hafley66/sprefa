# builtin-rels.dl — render the engine's self-describing `rel_catalog` into the
# README quick-reference rel_block. The engine emits one `rel_catalog` row per
# built-in relation (name, group, columns, one-line doc) from its OWN
# declarations (each RelDecl carries its group + doc), so this generator cannot drift: a
# new built-in appears in the table the next tick, and the doc-completeness test
# (tests/it/rel_catalog.rs) fails the build until it carries a summary. No
# source-scraping regex anymore — the engine introspects itself.
#
# Manual:  dl examples/builtin-rels.dl
# Daemon:  dl daemon load examples/builtin-rels.dl   (regens on engine.rs edits)
# Rerun converges (gen writes only when bytes differ; catalog order is the
# stable declaration order, so the rendered rows are deterministic).

# The marker pair wrapping the quick-reference rel_block in the README.
rel rel_block(p: file, l0: int, l1: int).
rel_block(p, l0, l1) <- scan("WORK", "README.md", p, rev),
  comment(p, rev, /BEGIN: builtin-rels/, /END: builtin-rels/, l0, l1).

gen(p, l0, l1, "| relation | group | columns | summary |") <- rel_block(p, l0, l1).
gen(p, l0, l1, "|---|---|---|---|") <- rel_block(p, l0, l1).
gen(p, l0, l1, "| `{name}` | {group} | `{cols}` | {doc} |") <-
  rel_block(p, l0, l1), rel_catalog(name, group, cols, doc).
