# Maintains the machine-written regions of the sprefa chapter in the anim deck
# (~/projects/anim/src/deck/02-sprefa.md). The root spans both repos:
#
#   dl examples/anim-deck.dl
#
# Rebuild the deck after: cd ~/projects/anim && npm run check

rel seen(path: file).
seen(path) <- scan("WORK", "sprefa/src/**/*.rs", path, rev),
  match(path, rev, /./, line).

# Non-variant edges between plain-ident type names (variant nodes like
# `Tok::Ident` are leaf noise and collide with d2 label syntax).
rel edge0(f: text, t: text).
edge0(f, t) <- type_edge(f, t, k, _), k != "variant",
  f =~ /^[A-Za-z]+$/, t =~ /^[A-Za-z]+$/.

rel fan_out(f: text, n: int).
fan_out(f, count(t)) <- edge0(f, t).

rel hub(f: text, n: int).
hub(f, n) <- fan_out(f, n), n >= 4.

# Marker regions inside the chapter's atlas fence. To the deck build these
# are throwaway d2 comments; to dl they are splice coordinates.
rel block(p: file, l0: int, l1: int, name: text).
block(p, l0, l1, name) <- scan("WORK", "anim/src/deck/02-sprefa.md", p, rev),
  comment(p, rev, /BEGIN: $name$/, /END:/, l0, l1, name).

gen(p, l0, l1, "{f} -> {t}") <-
  block(p, l0, l1, "edges"), hub(f, _), edge0(f, t).
gen(p, l0, l1, "# tag {f} : hub") <-
  block(p, l0, l1, "tags"), hub(f, _).
gen(p, l0, l1, "# @ {f} : fan-out {n}") <-
  block(p, l0, l1, "notes"), hub(f, n).

# Round player: hubs land tier by tier; leaves inherit the round of their
# earliest-revealed parent so nothing floats in unreachable. Literal round
# numbers per threshold; computed ranks wait on int arithmetic.
rel round(f: text, r: int).
round(f, 0) <- fan_out(f, n), n >= 6.
round(f, 1) <- fan_out(f, n), n >= 5, n < 6.
round(f, 2) <- fan_out(f, n), n >= 4, n < 5.

rel tgt_round(t: text, r: int).
tgt_round(t, min(r)) <- round(f, r), edge0(f, t).

rel leaf_round(t: text, r: int).
leaf_round(t, r) <- tgt_round(t, r), !round(t, _).

gen(p, l0, l1, "# step {f} = {r}") <-
  block(p, l0, l1, "steps"), round(f, r).
gen(p, l0, l1, "# step {t} = {r}") <-
  block(p, l0, l1, "steps"), leaf_round(t, r).

# ---- relational deck rows --------------------------------------------------
# The anim `atlas-db` fence reads rel_node / rel_edge / rel_tag / rel_node_ref
# / rel_tour / rel_tour_step / rel_card / rel_card_about / rel_view straight
# from this db (modelFromRows). No d2 text, no gen splice: the deck's atlas IS
# the database. `ref` is reserved (the engine's span spine), hence node_ref.

rel node(id: text, kind: text, label: text).
node(f, "type", f) <- hub(f, _).
node(t, "type", t) <- hub(f, _), edge0(f, t).

rel edge(f: text, t: text).
edge(f, t) <- hub(f, _), edge0(f, t).

rel tag(node: text, ns: text, value: text).
tag(f, "tag", "hub") <- hub(f, _).

# where each shown type is declared, as an fs ref (panel rows + periscope).
# `seen` above already scans sprefa/src/**/*.rs and triggers extraction, so
# this reads the syn-backed type_entity table directly instead of re-deriving
# declarations by regex.
rel decl(name: text, path: file, line: int).
decl(name, path, line) <- type_entity(_, _, name, k, _, path, line), k =~ /struct|enum/.

rel node_ref(node: text, panel: text, locator: text).
node_ref(n, "fs", "${path}:${line}") <- node(n, _, _), decl(n, path, line).

# notes: fan-out per hub (cards render as the node's hover/detail note)
rel card(id: text, body: text).
card("about.hubs", "every node here fans out to 4+ types; edges and tags are dl rows, not d2 text").

rel card_about(card: text, node: text).
card_about("about.hubs", f) <- hub(f, _).

# the authored layer: a tour and the opening view are plain facts
rel tour(id: text, title: text).
tour("rows", "the deck the engine wrote").

rel tour_step(tour: text, seq: int, target: text, comment: text).
tour_step("rows", 0, "Engine", "`Engine` owns the tick: scan, extract, fixpoint, sinks").
tour_step("rows", 1, "Engine+Db", "the engine drives one `Db`; every fact and derived row lands there").
tour_step("rows", 2, "Rule+GenRule", "parse lowers source into `Rule` and `GenRule`, the shapes the fixpoint executes").

rel view(id: text, focus: text, mode: text, layout: text, dir: text, iso: int).
view("seed", "Engine", "downstream", "dagre", "LR", 0).
