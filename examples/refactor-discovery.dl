# refactor-discovery.dl — refactor signals from the engine's resolved call graph.
# PURE query. Run:  dl v5/examples/refactor-discovery.dl --root .
#
# Originally a theory test: is "discovery free"? The per-fn signals (fan-in/out,
# move-candidates, seeded blast radius) always were. SCC clustering was BLOCKED
# (the naive scc<-reaches,reaches hits the unpinned-closure-read restriction),
# which motivated the `scc(edge)` builtin — now built, mirroring `closure(edge)`
# and reusing its Tarjan condensation. This file exercises all of it.

rel seen(path: file).
seen(path) <- scan("WORK", "v5/src/**/*.rs", path, rev), match(path, rev, /fn \w+/, line).

rel fan_out(caller: text, n: int).
rel fan_in(callee: text, n: int).
rel reaches(a: text, b: text).
rel mutual(a: text, b: text).
rel single_caller(callee: text, caller: text).
rel reaches_from_tick(b: text).

fan_out(caller, count(callee)) <- call_edge(caller, callee, _).
fan_in(callee, count(caller)) <- call_edge(caller, callee, _).

# closure relation: readable only with one endpoint pinned.
reaches(a, b) <- closure(call_edge).

# SCC membership: (component rep, member). rep = min member name in the component.
# A non-trivial cluster (size > 1) shows as multiple rows sharing a rep, some with
# rep != member. Reuses closure's Tarjan condensation — no second run.
rel cluster(rep: text, member: text).
cluster(rep, member) <- scc(call_edge).

# Tightly-coupled pairs: A calls B and B calls A (1-hop).
mutual(a, b) <- call_edge(a, b, _), call_edge(b, a, _).

# Move candidate: a fn called from exactly one site -> fold into its caller.
single_caller(callee, caller) <- call_edge(caller, callee, _), fan_in(callee, 1).

# Seeded reachability (pinned endpoint is allowed): everything Engine.tick reaches.
reaches_from_tick(b) <- reaches(a, b), a = "sprefa::v5/src/engine.rs::method::Engine.tick".

rel hub_out(caller: text, n: int).
hub_out(caller, n) <- fan_out(caller, n), n >= 8.
rel hub_in(callee: text, n: int).
hub_in(callee, n) <- fan_in(callee, n), n >= 8.

? cluster(rep, member).
? hub_out(caller, n).
? hub_in(callee, n).
? single_caller(callee, caller).
? reaches_from_tick(b).
