# op-table.dl — keep the README source-op table fresh from parse.rs dispatch.
#
# Twines match (parse.rs dispatch arms + README rows) + comment (marker bounds)
# + gen (splice). No new convention: the prose is the README's own rows, read
# verbatim and re-emitted byte-identical so the table converges. Op NAMES come
# from parse.rs's body_item dispatch. An op dispatched but absent from the table
# auto-appears as a stub row (ast_yaml today) so drift is visible in the doc;
# a human fills the prose and the next tick preserves it verbatim.
#
# Manual:  dl examples/op-table.dl
# Daemon:  dl daemon start examples/op-table.dl
#          Writes README.md (a watched non-program file) → converges, no respawn.
# Rerun converges (gen writes only when bytes differ).

# Op names dispatched in body_item: parse.rs `if s == "scan" { return self.scan(); }`.
# The structural if-eq-return shape excludes item-level keywords (`gen`/`anchor`/
# `def`/`_`) that also test `s == "..."` but through `&&`/`=>` forms, not this
# exact block. `closure`/`scc`/`node2vec` are body graph constructs, not source
# ops (they live in syntax.md's op_catalog, not this source-op table) → excluded.
rel dispatch_op(op: text).
dispatch_op(OP) <- scan("WORK", "src/parse.rs", p, rev),
  sg(p, rev, :rust, "if s == \"$OP\" { return self.$M(); }"),
  OP != "closure", OP != "scc", OP != "node2vec".

# The marker pair wrapping the whole table (header + separator + rows).
rel op_block(p: file, l0: int, l1: int).
op_block(p, l0, l1) <- scan("WORK", "README.md", p, rev),
  comment(p, rev, /BEGIN: op-table/, /END: op-table/, l0, l1).

# Extract every backtick-pipe row from README (SOURCE rule: scan+match only,
# no derived join — the extract-then-join split source rules require).
rel readme_row_raw(p: file, line: int, op: text, row: text).
readme_row_raw(p, line, op, row) <- scan("WORK", "README.md", p, rev),
  match(p, rev, /(?<row>\| `(?<op>\w+)` .+)/, line).

# Scope the rows to the op_block (DERIVED rule: may join op_block + compare). Verbatim
# re-emit = byte-identical = converge. Joining on op keeps only rows whose op is
# still dispatched, so a removed op drops out of the table.
rel readme_op_row(op: text, row: text).
readme_op_row(op, row) <- readme_row_raw(p, line, op, row), op_block(p, l0, l1),
  line > l0, line < l1.

# Header + separator (constant; body matches the op_block once).
gen(p, l0, l1, "| op | signature | what it does |") <- op_block(p, l0, l1).
gen(p, l0, l1, "|---|---|---|") <- op_block(p, l0, l1).

# Pass-through: re-emit each row verbatim (alpha by row text via gen's ORDER BY).
gen(p, l0, l1, "{row}") <- op_block(p, l0, l1), dispatch_op(op), readme_op_row(op, row).

# Stub: dispatched op with no README row → drift made visible in the doc.
gen(p, l0, l1, "| `{op}` | — | _undocumented_ |") <- op_block(p, l0, l1), dispatch_op(op),
  !readme_op_row(op, _).
