# Scan markdown into _file so refresh_doc_rels runs the IngestLang registry over it.
# (doc_node is populated lazily only for files a source rule has touched.)
rel md(path: file).
md(path) <- scan("WORK", "v5/**/*.md", path, rev), match(path, rev, /./, line).

# Each markdown doc's title = its top-level heading (parent = "").
rel doc_title(path: file, title: text).
doc_title(path, title) <- doc_node(_, path, _, "heading", title, "").

# Rust //! module docs. comment.rs strips the leading `//` marker, so a `//! x`
# line survives as `! x`; /^!/ picks module docs apart from item `///` (-> `/ x`)
# and plain `//` (-> the comment text). One region per //! line in sequential mode.
rel mod_doc(path: file, line: int, summary: text).
mod_doc(path, l0, summary) <- scan("WORK", "v5/src/**/*.rs", path, rev),
  comment(path, rev, /^!\s?(?<s>.+)/, l0, label: summary).

# First //! line per file: aggregate to the min line, then join back for its text.
# (Source rules can't join derived rels; this is the extract-then-join split.)
rel mod_first_line(path: file, line: int).
mod_first_line(path, min(line)) <- mod_doc(path, line, _).

rel mod_first(path: file, line: int, summary: text).
mod_first(path, line, summary) <- mod_first_line(path, line), mod_doc(path, line, summary).

# Re-locate this file's own marker pair every tick.
rel block(p: file, l0: int, l1: int).
block(p, l0, l1) <- scan("WORK", "v5/examples/gen-doc-index.dl", p, rev),
  comment(p, rev, /BEGIN: docmap/, /END:/, l0, l1).

gen(p, l0, l1, "# - md  {title}  ({path})") <- block(p, l0, l1), doc_title(path, title).
gen(p, l0, l1, "# - rs  {path}:{line}  {summary}") <- block(p, l0, l1), mod_first(path, line, summary).
