# debug_lgg.dl — inspect what type_edge rows exist for specific types
rel seen(path: file).
seen(path) <- scan("src/**/*.rs", path).

rel anch(from: text, to: text, kind: text).
anch(from, to, kind) <- type_edge(from, to, kind, _), from = "Anchors".
rel anch_to(from: text, to: text, kind: text).
anch_to(from, to, kind) <- type_edge(from, to, kind, _), to = "Anchors".

rel bodyitem(from: text, to: text, kind: text).
bodyitem(from, to, kind) <- type_edge(from, to, kind, _), from = "BodyItem".
rel bi_astyaml(from: text, to: text, kind: text).
bi_astyaml(from, to, kind) <- type_edge(from, to, kind, _), from = "BodyItem::AstYaml".

? anch(from, to, kind).
? anch_to(from, to, kind).
? bodyitem(from, to, kind).
? bi_astyaml(from, to, kind).
