; Resolved call edges per crate, from sprefa-extract through ryi,
; and every caller of one function name across all crates.
(ryi: (import "@std/ryi"))

(: Crate
   (* (: name str)
      (: root str)))

(Crate "soopy" "/Users/chrishafley/projects/hafley-rs/crates/soopy")

(Crate "ghcache" "/Users/chrishafley/projects/hafley-rs/crates/ghcache")

(: Resolved
   (* (: crate str)))

(<- (Resolved ?Name)
    (Crate ?Name ?Root)
    (ryi.resolve ?Root "call"))

(: Call
   (* (: crate str)
      (: caller_path str)
      (: caller (Option str))
      (: callee_path str)
      (: callee (Option str))
      (: caller_site_start int)
      (: caller_site_end int)
      (: callee_start int)
      (: callee_end int)
      (: kind str)
      (: origin str)))

(<- (Call ?Name ?CallerPath ?Caller ?CalleePath ?Callee ?SiteStart ?SiteEnd ?CalleeStart ?CalleeEnd ?Kind ?Origin)
    (Crate ?Name ?Root)
    (ryi.resolved_edge
       ?Root
       ?InputPath
       ?Fact
       ?CallerPath
       ?Caller
       ?CalleePath
       ?Callee
       ?SiteStart
       ?SiteEnd
       ?CalleeStart
       ?CalleeEnd
       ?Kind
       ?Origin))

(: Calls
   (* (: crate str)
      (: count int)))

(<- (Calls ?Name (count ?SiteStart))
    (Call ?Name ?CallerPath ?Caller ?CalleePath ?Callee ?SiteStart ?SiteEnd ?CalleeStart ?CalleeEnd ?Kind ?Origin))

(: CallsOpen
   (* (: crate str)
      (: caller_path str)
      (: caller_site_start int)))

(<- (CallsOpen ?Name ?CallerPath ?SiteStart)
    (Crate ?Name ?Root)
    (ryi.resolved_edge
       ?Root
       ?InputPath
       ?Fact
       ?CallerPath
       ?Caller
       ?CalleePath
       "open"
       ?SiteStart
       ?SiteEnd
       ?CalleeStart
       ?CalleeEnd
       ?Kind
       ?Origin))

(: Failed
   (* (: crate str)
      (: message str)))

(<- (Failed ?Name ?Message)
    (Crate ?Name ?Root)
    (ryi.resolve_error ?Root "call" ?Message))
