# debug_type.dl — check what's in type_edge and type_entity
rel seen(path: file).
seen(path) <- scan("src/**/*.rs", path).

# Named args: bind only the column you count, no positional `_` padding.
rel n_edge(n: int).
n_edge(count(from)) <- type_edge(from: from).

rel n_entity(n: int).
n_entity(count(sym)) <- type_entity(sym: sym).

rel n_shape(n: int).
n_shape(count(name)) <- type_shape(name, _).

? n_edge(n).
? n_entity(n).
? n_shape(n).
