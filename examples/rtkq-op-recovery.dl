# RTK Query op-name recovery. RTKQ generates a hook identifier from each
# endpoint name: `getUser` -> `useGetUserQuery`, `createOrder` ->
# `useCreateOrderMutation`, plus a `useLazyGetUserQuery` variant. The hook call
# in component code is therefore NOT the spec operationId verbatim (unlike
# openapi-lsp.dl, where the TS call name equals the operationId). The endpoint
# name is recovered with three string builtins composed in one head:
#
#   strip_prefix(h, "use")                 drop the leading `use`
#   replace_re(_, "^Lazy|(Query|Mutation)$", "")   drop a `Lazy` prefix + the
#                                          `Query`/`Mutation` suffix in one pass
#   lcfirst(_)                             `GetUser` -> `getUser`
#
# That recovered string is the join key against the spec. No engine special
# case: the recovery is ordinary derived-head SQL over the scanned hook calls.


# The contract: every operation declared in the OpenAPI spec.
rel spec_op(op: text).
spec_op(op) <- scan("WORK", "examples/openapi-sim/openapi.json", p, rev),
               jsonp(p, rev, "paths.*.*.operationId", op).

# RTKQ hook call sites in component code. One regex over the codegen naming
# convention captures the whole `use…Query`/`use…Mutation` identifier. The
# trailing `\(` keeps it to call sites, so a hook named in a comment is skipped.
rel hook_call(p: file, l: int, hook: text).
hook_call(p, l, hook) <-
    scan("WORK", "examples/openapi-sim/components.tsx", p, rev),
    match(p, rev, /\b(?P<hook>use[A-Z][A-Za-z0-9]*(?:Query|Mutation))\s*\(/, l).

# The recovery: hook identifier -> endpoint op name.
rel recovered(p: file, l: int, hook: text, op: text).
recovered(p, l, hook, lcfirst(replace_re(strip_prefix(hook, "use"), "^Lazy|(Query|Mutation)$", ""))) <-
    hook_call(p, l, hook).

# Happy path: a recovered op name that matches a real spec endpoint.
rel linked(op: text, p: file, l: int, hook: text).
linked(op, p, l, hook) <- recovered(p, l, hook, op), spec_op(op).
diag(path: p, line: l, severity: "info", code: "rtkq-link", msg: "hook `${hook}` -> spec op `${op}`") <- linked(op, p, l, hook).

# Orphan hook: a hook whose recovered name has no matching spec endpoint (a
# stale call left after the endpoint was renamed or removed).
diag(path: p, line: l, severity: "warn", code: "rtkq-orphan-hook", msg: "hook `${hook}` recovers to `${op}`, not in the spec") <-
    recovered(p, l, hook, op), !spec_op(op).

# Unhooked endpoint: a spec op no component hook reaches.
rel hooked(op: text).
hooked(op) <- recovered(_, _, _, op).
diag(path: "examples/openapi-sim/openapi.json", line: 0, severity: "warn", code: "rtkq-unhooked", msg: "spec op `${op}` has no client hook") <- spec_op(op), !hooked(op).

? spec_op(op).
? recovered(p, l, hook, op).
? linked(op, p, l, hook).
? diag(path: p, line: l, severity: sev, code, msg).
