# flow-interproc.dl — cross-function, SCIP-resolved value flow.
#
# Two graphs the engine already builds never touched each other:
#   - df_edge   : the intra-procedural value lift (syn / oxc / tree-sitter). Real
#                 typed nodes (param / var_read / binop / call_res / ...), but it
#                 STOPS at the function boundary.
#   - call_edge : the resolved caller-sym -> callee-sym graph. Cross-function and
#                 cross-language, SCIP-preferred (engine resolves a callee through
#                 scip_ref's def_file when an index.scip is present, single-def
#                 name resolution otherwise), but it walks SYMBOLS, not values.
#
# This program unions them into ONE edge relation so closure(flow_edge) walks
# value flow ACROSS calls. The interprocedural hop: an argument value that feeds
# a call result flows into the resolved callee's parameters.
#
#   dl examples/flow-interproc.dl --root .
#   SPREFA_SCIP_INDEX=index.scip dl examples/flow-interproc.dl --root .   # SCIP-resolved
#
# Precision notes (honest):
#   - The argument -> parameter hop is positional-blind: every arg feeding a call
#     reaches every parameter of the callee. Taint analysis is an over-
#     approximation by nature; this is that, made explicit.
#   - The RETURN hop (callee result -> call_res) IS modelled: the lift mints a
#     `ret` node per return point (explicit `return EXPR`, plus the implicit tail
#     expression in Rust/Kotlin), and the backward rule connects it to the
#     caller's call_res. A value passed in, transformed, and returned flows end to
#     end. TS arrow / function-expression consts (`const f = (x) => ...`) are
#     lifted as their own fn scope, so they participate too.
#   - Node-level types are not bound: type_sig is keyed by parameter POSITION,
#     df_node params by NAME, and df_node has no position column. The typed view
#     below is therefore function-level (callee sym + slot position + type).

rel src(p: file).
src(p) <- scan("WORK", "src/**/*.{rs,ts,kt}", p, rev), match(p, rev, /./, l).

# The unified value-flow edge relation: intra ∪ inter procedural. All-derived
# (no source rule heads it), so closure() may walk it.
rel flow_edge(from: text, to: text).

# Intra-procedural: the local lift, as-is.
flow_edge(a, b) <- df_edge(a, b).

# Sym-space bridge: df_node.fn is the BARE sym (file::kind::name) while
# call_edge's endpoints are repo-qualified (repo::file::kind::name). Strip the
# leading repo segment ONCE per call_edge row so every downstream join is a plain
# equality on the bare sym — indexable, O(|call_edge|) replace_re calls total.
# (The old per-pair suffix test `replace(qual, bare, "") != qual` was unindexable:
# ~25M string evals on this repo, 40s per fixpoint pass. An unresolved external
# callee has no repo prefix; the strip leaves it unchanged and it simply never
# matches a bare df_node.fn — same rows as before.)
rel call_edge_bare(caller: text, callee: text, caller_q: text, callee_q: text).
call_edge_bare(cb, eb, cq, eq) <-
    call_edge(cq, eq, _),
    cb = replace_re(cq, "^[^:]*::", ""),
    eb = replace_re(eq, "^[^:]*::", "").

# Interprocedural: an argument that feeds a call result flows into each parameter
# of the resolved callee. Resolution rides call_edge — the SCIP-preferred
# caller-sym -> callee-sym graph (scip_ref def_file when an index.scip is present,
# single-def name resolution otherwise). This is context-insensitive (per caller,
# not per call site) and positional-blind (every arg of a caller's call reaches
# every parameter of every callee it resolves to) — both the conventional taint
# over-approximation.
flow_edge(arg, param) <-
    df_node(call_id, "call_res", _, caller_bare, _, _),
    df_edge(arg, call_id),
    call_edge_bare(caller_bare, callee_bare, _, _),
    df_node(param, "param", _, callee_bare, _, _).

# Interprocedural, backward: the callee's returned value flows back OUT to the
# caller's call result. The `ret` node is minted per return point (explicit
# `return EXPR` and the implicit tail expression in Rust/Kotlin); the callee's
# param-to-ret path inside its body then carries taint end to end: a value passed
# IN as an argument, transformed, and returned, reaches the caller's call_res.
flow_edge(callee_ret, call_id) <-
    df_node(call_id, "call_res", _, caller_bare, _, _),
    call_edge_bare(caller_bare, callee_bare, _, _),
    df_node(callee_ret, "ret", _, callee_bare, _, _).

# Transitive value reachability across function boundaries.
rel flow_reach(from: text, to: text).
flow_reach(a, b) <- closure(flow_edge).

# Typed view (function-level): every callee that is an interprocedural sink, with
# the declared types of its parameter slots, pulled from the resolved type
# signature. This is the "type-carrying" axis — coarse (per slot, not per node)
# until the lift emits a parameter position.
rel sink_callee(callee_sym: text).
sink_callee(callee_q) <-
    df_node(_, "call_res", _, caller_bare, _, _),
    call_edge_bare(caller_bare, _, _, callee_q).

rel flow_param_type(callee_sym: text, pos: int, ty: text).
flow_param_type(callee_sym, pos, ty) <-
    sink_callee(callee_sym),
    type_sig(callee_sym, "param", pos, ty).

# Node-level typed view: bind a specific param df_node to its declared type. The
# df_param positional index counts only typed params (self skipped) so it aligns
# with type_sig's pos; the bridge rel ties the bare df_node.fn to the qualified
# callee sym. This is the per-node "type-carrying" form the function-level view
# above approximates.
rel flow_node_type(node: text, callee_sym: text, ty: text).
flow_node_type(param, callee_q, ty) <-
    sink_callee(callee_q),
    call_edge_bare(_, callee_bare, _, callee_q),
    df_node(param, "param", _, callee_bare, _, _),
    df_param(param, pos),
    type_sig(callee_q, "param", pos, ty).

? flow_edge(from, to).
? flow_reach(from, to).
? flow_param_type(callee_sym, pos, ty).
? flow_node_type(node, callee_sym, ty).
