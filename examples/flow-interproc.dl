# flow-interproc.dl — cross-function, SCIP-resolved value flow.
#
# Two graphs the engine already builds never touched each other:
#   - df_edge   : the intra-procedural value lift (syn / oxc / tree-sitter). Real
#                 typed nodes (param / var_read / binop / call_res / ...), but it
#                 STOPS at the function boundary.
#   - call_edge : the resolved caller-sym -> callee-sym graph. Cross-function and
#                 cross-language, SCIP-preferred (engine resolves a callee through
#                 scip_ref's def_file when an index.scip is present, single-def
#                 name resolution otherwise), but it walks SYMBOLS, not values.
#
# The union that connects them — flow_edge = df_edge ∪ the positional arg->param
# hop ∪ the ret->call_res backward hop — lives in std/flow.dl now, so every flow
# program shares ONE copy (this file used to carry its own; so did taint.dl and
# flow-jsx.dl). This program adds the transitive closure and the typed views.
#
#   dl examples/flow-interproc.dl --root .
#   SPREFA_SCIP_INDEX=index.scip dl examples/flow-interproc.dl --root .   # SCIP-resolved
#
# Precision notes (honest, inherited from std/flow.dl):
#   - The argument -> parameter hop is POSITIONAL (df_arg slot = df_param slot,
#     receiver at -1) and pinned PER CALL SITE (call_node + call_name tie each
#     call node to defs carrying ITS callee name, so f(secret); g(benign) in
#     one caller don't cross). Still merged: the callee's internal param->ret
#     path across callers (no per-site callee cloning).
#   - The RETURN hop IS modelled: the lift mints a `ret` node per return point
#     (explicit `return EXPR`, plus the implicit tail expression in Rust/Kotlin),
#     so a value passed in, transformed, and returned flows end to end. TS arrow /
#     function-expression consts (`const f = (x) => ...`) are lifted as their own
#     fn scope, so they participate too.
#   - Node-level types are not bound: type_sig is keyed by parameter POSITION,
#     df_node params by NAME, and df_node has no position column. The typed view
#     below is therefore function-level (callee sym + slot position + type).

use "std/flow.dl".

rel src(p: file).
src(p) <- scan("WORK", "src/**/*.{rs,ts,kt}", p, rev), match(p, rev, /./, l).

# Transitive value reachability across function boundaries.
rel flow_reach(from: text, to: text).
flow_reach(a, b) <- closure(flow_edge).

# Typed view (function-level): every callee that is an interprocedural sink, with
# the declared types of its parameter slots, pulled from the resolved type
# signature. This is the "type-carrying" axis — coarse (per slot, not per node)
# until the lift emits a parameter position.
rel sink_callee(callee_sym: text).
sink_callee(callee_q) <-
    df_node(_, "call_res", _, caller_bare, _, _),
    call_edge_bare(caller_bare, _, _, callee_q).

rel flow_param_type(callee_sym: text, pos: int, ty: text).
flow_param_type(callee_sym, pos, ty) <-
    sink_callee(callee_sym),
    type_sig(callee_sym, "param", pos, ty).

# Node-level typed view: bind a specific param df_node to its declared type. The
# df_param positional index counts only typed params (self skipped) so it aligns
# with type_sig's pos; the bridge rel ties the bare df_node.fn to the qualified
# callee sym. This is the per-node "type-carrying" form the function-level view
# above approximates.
rel flow_node_type(node: text, callee_sym: text, ty: text).
flow_node_type(param, callee_q, ty) <-
    sink_callee(callee_q),
    call_edge_bare(_, callee_bare, _, callee_q),
    df_node(param, "param", _, callee_bare, _, _),
    df_param(param, pos),
    type_sig(callee_q, "param", pos, ty).

? flow_edge(from, to).
? flow_reach(from, to).
? flow_param_type(callee_sym, pos, ty).
? flow_node_type(node, callee_sym, ty).
