# Ban a code move with ast-grep + the CLI. Each rule is one banned pattern.
# Run it as a gate (exits non-zero if any `error`-severity row exists):
#
#   dl examples/ban.dl --check        # human output on stderr
#   dl examples/ban.dl --diag-json     # JSON for a hook / CI
#
# `diag` is a plain relation; --check is one renderer of it, --lsp is another.
# Columns are mapped by name: path/line/msg required; severity/code/hint optional.


# Ban 1: a `dbg!(...)` left in committed code. $X captures the inner expr; the
# trailing line/col/end_line/end_col bind the match span for a tight squiggle.
diag(path, line, col, end_line, end_col, severity: "error", code: "no-dbg", msg: "dbg!() left in code: `dbg!(${X})`", hint: "remove the debug macro before committing") <-
  scan("WORK", "src/**/*.rs", path, rev),
  match_ast(path, rev, :rust, "dbg!($X)", line, col, end_line, end_col).

# Ban 2: a bare `panic!(...)` in library code. `$$$M` is the VARIADIC metavar:
# it matches the whole argument list (zero or more nodes), so `panic!("x", y)`
# matches too. A single `$M` would only match a one-argument panic!.
diag(path, line, col, end_line, end_col, severity: "error", code: "no-panic", msg: "panic!() in library code", hint: "return a Result and let the caller decide") <-
  scan("WORK", "src/**/*.rs", path, rev),
  match_ast(path, rev, :rust, "panic!($$$M)", line, col, end_line, end_col).
