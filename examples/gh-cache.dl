# gh-cache.dl — ghcacher, as a datalog program.
#
# ghcacher (a Rust service, ~/projects/ghcacher) polls the GitHub API on an
# interval, sends `If-None-Match: <etag>` so an unchanged resource comes back 304
# (free), normalizes the JSON into SQLite tables, and appends every change to an
# append-only `change_log` that an SSE endpoint tails. This file is that whole
# shape in the effect runtime: an interval clock (`every`), a cached conditional
# request (`@async` + an `@next` etag carry), JSON entity extraction (term-form
# `jsonp`), and a `@next`-accumulated `change_log`.
#
# The cache IS the content-addressed `pending_effect` digest plus the etag carry:
# a request is keyed by (head, kind, args), and `args` includes the prior etag and
# a cadence bucket, so the SAME (endpoint, etag, bucket) fires at most once. When
# the resource changes the server returns a NEW etag, which changes the args,
# which re-fires — the change itself is what advances the cache. A 304 carries the
# old etag forward and lands no entity rows, so `change_log` is untouched (the
# parity-critical behavior).
#
# RATE SAFETY: two intervals, do not confuse them. DL_POLL_SECS is how often the
# DAEMON re-ticks (cheap, in-process, no network). `clock(300, b)` is how often a
# watched endpoint is actually RE-FETCHED from GitHub. Between clock-bucket
# boundaries the request id is identical, so no call leaves the machine regardless
# of how fast the daemon ticks. One endpoint at clock(300, _) is <=12 conditional
# requests per hour against a 5000/hour authed limit.
#
# Run (daemon):  DL_POLL_SECS=5 dl --lsp examples/gh-cache.dl --root <repo>

# --- what to poll -----------------------------------------------------------
# One row per endpoint. `gh api {ep} -H "If-None-Match: {prev}"` is the call; the
# template lives in `effect_cmd`, filled from the request args.
rel watch(ep: text).
watch("repos/cli/cli").

# --- the conditional request (the cache) ------------------------------------
# Carry the last etag per endpoint across ticks. `etag` is written ONLY by the
# @next rule; `etag_next` is this tick's value (a 200's fresh etag, or the old one
# kept on a 304 / unchanged tick).
rel etag(ep: text, tag: text).
rel etag_next(ep: text, tag: text).

# --- cadence: the rate cap AND the re-poll trigger, in one join ------------
# The request id is content-addressed on (head, kind, args), and an already-fired
# id is never re-fired (INSERT-OR-IGNORE). So a poll whose args never change fires
# exactly once and then goes silent — it would never re-check the resource. The
# fix is a coarse time bucket in the args, and the engine already has one: the
# built-in `clock(secs, bucket)` binds `bucket = now/secs`, a monotone integer
# that advances once per `secs` wall-clock seconds and is present on every tick.
# Join it and the request id advances at most once per N seconds: a re-poll fires
# on cadence, and between boundaries the SAME (ep, etag, bucket) hashes to the
# same id, so nothing re-hits GitHub. This single N IS the rate knob — the worst
# case is one conditional (304-cheap) request per N seconds per endpoint. (Time
# as a fact you join against; no @next counter, that is the whole sugar.)
rel poll(ep: text, prev: text, bucket: int).
poll(ep, prev, b) <- watch(ep), etag(ep, prev), clock(300, b).
poll(ep, "",   b) <- watch(ep), !etag(ep, _),   clock(300, b).

# The conditional GET as a TYPED effect (not a string fact). `sh` = a read-effect
# (the @async kind); the signature names the request params and the TYPED response
# columns. `{ep}` is raw text (a clean path); `$prev` is the env-var form — the
# carried etag is `W/"..."`, whose quotes would corrupt a raw `{prev}` inside the
# quoted header, but survive intact as `$prev` (the shell expands it without
# re-parsing). The backtick body is raw shell, so no `\"`/`\\n` escaping. Output is
# newline-separated status / etag / body, the body slot absorbing the rest.
sh fetch(ep, prev) -> (status: int, tag: text, body: text) =
  `R=$(gh api {ep} -i -H "If-None-Match: $prev" 2>/dev/null)
   C=$(printf '%s' "$R" | head -1 | grep -oE '[0-9]{3}' | head -1)
   E=$(printf '%s' "$R" | grep -iE '^etag:' | head -1 | sed -E 's/^[Ee]tag:[[:space:]]*//; s/\r$//')
   B=$(printf '%s' "$R" | awk 'f{print} /^\r?$/{f=1}' | tr -d '\n')
   printf '%s\n%s\n%s' "$C" "$E" "$B"`.

# Fire it. `status`/`tag`/`body` are bound by `fetch(...) -> (status, tag, body)`
# (named, not positional); `ep` echoes from the request; `prev`/`bucket` are the
# request-only digest key. No `every` gate — the bucket throttles via the request
# id, and a gate would stall the first poll until a boundary.
# `resp` carries the cadence BUCKET it was fetched at, so responses are ordered
# in time. It ACCUMULATES (one row per (bucket) response) — that is the history,
# and a 304 collapses to a bodiless row.
rel resp(ep: text, b: int, status: int, tag: text, body: text).
resp(ep, b, status, tag, body) <- @async poll(ep, prev, b), fetch(ep, prev) -> (status, tag, body).

# --- latest-wins (the upsert reduction) -------------------------------------
# A resource that CHANGES lands several 200s with different etags; reducing over
# all of them (e.g. `etag_next <- resp(200, tag, _)`) would derive MANY etags and
# fan the next poll out. Pick the newest 200 by `max(bucket)` instead: `resp_current`
# is that single body, and a 304 (no new 200) leaves it at the last good version.
# The etag carry reads `resp_current`, so it stays single-valued. Entities derive
# from `resp_current`, not raw `resp`, so they reflect the NEWEST version.
rel resp_latest(ep: text, b: int).
resp_latest(ep, max(b)) <- resp(ep, b, 200, _, _).
rel resp_current(ep: text, tag: text, body: text).
resp_current(ep, tag, body) <- resp(ep, b, 200, tag, body), resp_latest(ep, b).
etag_next(ep, tag) <- resp_current(ep, tag, _).
etag(ep, tag) <- @next etag_next(ep, tag).

# --- normalize: entities from 200 bodies ------------------------------------
# Only a 200 carries a body; term-form `jsonp` parses the bound `body` value (the
# hybrid join+extract pass), no file, no scan. Add a rule per field you track.
rel stars(ep: text, n: text).
stars(ep, n) <- resp_current(ep, _, body), jsonp(body, "stargazers_count", n).

rel full_name(ep: text, name: text).
full_name(ep, name) <- resp_current(ep, _, body), jsonp(body, "full_name", name).

# A LIST endpoint (e.g. `gh api repos/cli/cli/pulls`) returns a JSON ARRAY of
# objects. One `json` brace pattern normalizes the whole array into one row per
# element, with sibling fields correlated and nested fields (user.login) descended
# in the same match — the full ghcacher `pull_request` row, no Rust, no per-field
# rule. Add `watch("repos/cli/cli/pulls").` to poll it.
rel pull_request(ep: text, num: text, title: text, state: text, author: text).
pull_request(ep, num, title, state, author) <-
    resp_current(ep, _, body),
    json(body, q:[... { number: $num, title: $title, state: $state,
                        user: { login: $author } } ]).

# --- the change feed (append-only) ------------------------------------------
# `change_log(ep, kind, val)` accumulates every observed entity value across
# ticks; the @next rule keeps the prior rows and unions this tick's entities, so a
# tick that lands no new entity (a 304) appends nothing. Dedup is structural (the
# same (ep, kind, val) never doubles), so re-deriving an unchanged entity is a
# no-op — idempotent, the ghcacher INSERT-OR-IGNORE property.
rel change_log(ep: text, kind: text, val: text).
rel change_log_next(ep: text, kind: text, val: text).
change_log_next(ep, kind, val) <- change_log(ep, kind, val).
change_log_next(ep, "stars", n)    <- stars(ep, n).
change_log_next(ep, "full_name", v) <- full_name(ep, v).
change_log(ep, kind, val) <- @next change_log_next(ep, kind, val).

# --- read the cache ---------------------------------------------------------
? change_log(ep, kind, val).
? effect_log(id, kind, head, state, args, req_tx).
