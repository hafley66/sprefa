# cli-doc.dl — keep the README CLI flag table fresh from the clap `Cli` struct
# in src/cli/mod.rs. Same shape as op-table.dl: flag NAMES come from the source
# (the struct fields under an `#[arg(long...)]`), the prose is the README's own
# rows re-emitted verbatim, and a flag with no row auto-appears as a stub so
# drift is visible. Reacts to a source edit directly — no compiled binary, no
# rebuild — because the watcher re-ticks when the scanned source file changes.
# Any `hide = true` flag is excluded, so the table mirrors the PUBLIC surface
# `dl --help` shows. Daemon control is the `dl daemon <verb>` subcommand, not a
# flag, so it never appears here (see docs/daemon.md).
#
# Manual:  dl examples/cli-doc.dl
# Daemon:  dl daemon start examples/cli-doc.dl
#          Writes README.md (a watched non-program file) → converges, no respawn.
# Rerun converges (gen writes only when bytes differ).

# A clap arg attribute line: `#[arg(long)]` / `#[arg(long = "move")]` / `#[arg(long, hide = true)]`.
rel arg_attr(line: int).
arg_attr(line) <- scan("WORK", "src/cli/mod.rs", p, rev),
  ast(p, rev, :rust, "(attribute_item) @cap", line).

# A hidden flag's attribute line (`#[arg(long, hide = true)]`): its field is a
# back-compat alias, excluded from the public table.
rel hidden_attr(line: int).
hidden_attr(line) <- scan("WORK", "src/cli/mod.rs", p, rev),
  match_line(p, rev, /#\[arg\([^)]*hide = true/, line).

# A struct field decl: `    fieldname: Type`. Trailing `_` (raw-ident workaround,
# e.g. `move_`) is dropped so the kebab name matches clap's derived long flag.
rel field_decl(line: int, fname: text).
field_decl(line, fname) <- scan("WORK", "src/cli/mod.rs", p, rev),
  match_line(p, rev, /^    (?<fname>[a-z0-9]+(?:_[a-z0-9]+)*)_*: /, line).

# A flag = a field whose immediately-preceding line is a NON-hidden
# `#[arg(long...)]`. That adjacency excludes the bare `programs` positional (no
# attr above it) and any stray `name: Type` line elsewhere in the file; the
# hidden-attr anti-join drops the back-compat daemon flags. Field → kebab flag.
rel flag(name: text).
flag(name) <- arg_attr(la), field_decl(lf, fname), lf = la + 1,
  !hidden_attr(la),
  name = replace(fname, "_", "-").

# Every README flag row, with its `--flag` name (SOURCE rule: scan+match_line only).
rel readme_row_raw(p: file, line: int, flag: text, row: text).
readme_row_raw(p, line, flag, row) <- scan("WORK", "README.md", p, rev),
  match_line(p, rev, /(?<row>\| `--(?<flag>[a-z][a-z0-9-]*)[^|]*\| .+)/, line).

# Scope the rows to the block. Joining on the flag name keeps only rows whose
# flag still exists in the struct, so a removed flag drops out of the table.
rel readme_flag_row(flag: text, row: text).
readme_flag_row(flag, row) <- readme_row_raw(p, line, flag, row).

# Header + separator (constant; body matches the block once).
gen(:zone, "README.md", "cli", "| flag | effect |") <- true().
gen(:zone, "README.md", "cli", "|---|---|") <- true().

# Pass-through: re-emit each documented flag's row verbatim (alpha by row text).
gen(:zone, "README.md", "cli", "{row}") <- flag(name), readme_flag_row(name, row).

# Stub: a flag in main.rs with no README row → drift made visible in the doc.
gen(:zone, "README.md", "cli", "| `--{name}` | _undocumented_ |") <- flag(name),
  !readme_flag_row(name, _).
