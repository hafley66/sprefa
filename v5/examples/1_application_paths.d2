# Conceptual SWI paths. DL7 mapping remains a design question.
# One row per operation; explanations stay inside the relevant row.
grid-columns: 1
grid-gap: 28

classes: {
  data_box: {
    style: {fill: "#DBEAFE"; stroke: "#2563EB"; font-color: "#172554"; border-radius: 10; font-size: 20}
  }
  proof_box: {
    style: {fill: "#DCFCE7"; stroke: "#15803D"; font-color: "#14532D"; border-radius: 10; font-size: 20}
  }
  write_box: {
    style: {fill: "#FFEDD5"; stroke: "#C2410C"; font-color: "#7C2D12"; border-radius: 10; font-size: 20}
  }
  note_box: {
    style: {fill: "#F1F5F9"; stroke: "#64748B"; font-color: "#0F172A"; border-radius: 10; font-size: 20}
  }
}

value_row: "1 · HAVE A VALUE" {
  direction: right
  style.fill: transparent
  value_code: "P = point(1,2)" {class: data_box}
  value_result: "P holds point(1,2)\nNo fact inserted" {class: data_box}
  value_code -> value_result: "unify" {
    style: {stroke: "#60A5FA"; font-color: "#60A5FA"; stroke-width: 2}
  }
}

proof_row: "2 · ASK A QUESTION" {
  direction: right
  style.fill: transparent
  query_code: "point(1,Y)?" {class: proof_box}
  proof_step: "Rule: Point follows Input\npoint(X,Y) :- input(X,Y).\n\nStored fact: input(1,2)" {class: proof_box}
  query_result: "Y = 2\nAnswer returned" {class: proof_box}
  query_code -> proof_step: "prove" {
    style: {stroke: "#4ADE80"; font-color: "#4ADE80"; stroke-width: 2}
  }
  proof_step -> query_result: "answer" {
    style: {stroke: "#4ADE80"; font-color: "#4ADE80"; stroke-width: 2}
  }
}

state_row: "3 · CHANGE STORED INPUT" {
  direction: right
  style.fill: transparent
  update_code: "assertz(input(1,2))\nretract(input(1,2))" {class: write_box}
  stored_facts: "Dynamic fact store\nempty ↔ input(1,2)" {
    class: write_box
    shape: cylinder
  }
  next_query: "Next fresh Point query:\nafter add → true\nafter remove → false" {class: write_box}
  update_code -> stored_facts: "add" {
    style: {stroke: "#FB923C"; font-color: "#FB923C"; stroke-width: 3}
  }
  update_code -> stored_facts: "remove" {
    style: {stroke: "#FB923C"; font-color: "#FB923C"; stroke-width: 3; stroke-dash: 5}
  }
  stored_facts -> next_query: "when asked" {
    style: {stroke: "#FB923C"; font-color: "#FB923C"; stroke-width: 2}
  }
}

design_row: "DL7 · THE QUESTION WE PAUSED ON" {
  direction: right
  style.fill: transparent
  product_code: "(: Point\n  (* (: x int) (: y int)))\n\nPrior audit: product gets\na callable signature" {class: note_box}
  application_code: "(Point 1 2)\n\nWhich uses produce a value?\nWhich uses request proof?" {class: note_box}
  capability_note: "Possible Call edge\n\nDescribe that behavior\nin the graph?\nStill undecided" {
    class: note_box
    style.stroke-dash: 5
  }
  product_code -> application_code: "callable" {
    style: {stroke: "#CBD5E1"; font-color: "#CBD5E1"; stroke-width: 2}
  }
  application_code -> capability_note: "proposal" {
    style: {stroke: "#CBD5E1"; font-color: "#CBD5E1"; stroke-dash: 5}
  }
}

# Explanatory scope:
# SWI term bindings can be undone by backtracking; assert/retract generally survive it.
# Each question shown starts fresh; in-flight calls follow the logical update view.
# Optional incremental tabling maintains answer tables after dynamic input changes.
# Modes specify known/unknown arguments within an operation, not its side effects.
# DL7 examples are illustrative. No new Call edge or kernel semantics are approved.
# https://www.swi-prolog.org/pldoc/man?section=dynpreds
# https://www.swi-prolog.org/pldoc/man?section=tabling-incremental
