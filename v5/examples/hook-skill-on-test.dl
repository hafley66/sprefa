# dl --hook condition: inject the "testing" skill when the agent touches a test
# file this turn — only if it wasn't already loaded. The load-once guard is the
# negated `!skill_loaded(_, s, "testing")` atom: skill_loaded is a built-in
# derived from the transcript (explicit Skill calls + dl's own prior injections),
# so the rule itself is idempotent. No state files.
#
# Install: put this (or your own .dl) at <repo>/.dl/ and register the hook in
# <repo>/.claude/settings.json:
#
#   { "hooks": { "PostToolUse": [ {
#       "matcher": "Read|Edit|Write|MultiEdit",
#       "hooks": [ { "type": "command", "command": "dl --hook" } ] } ] } }
#
# The condition is yours: swap agent_touch for agent_changed, join `changed`,
# `module_edge`, `type_edge`, whatever. `agent_touch(harness, session, path)` is
# the latest turn's edited files (git-free, from the harness session log).

rel inject_skill(name: text).

inject_skill("testing") <-
    agent_touch(_, s, p),
    p =~ /(_test\.|\.test\.|\.spec\.|test_|\/tests\/)/,
    !skill_loaded(_, s, "testing").

# A block example (uncomment to bounce a forbidden edit back at the agent):
# rel block(reason: text).
# block("do not edit generated files by hand") <-
#     agent_touch(_, _, p), p =~ /\.gen\./.
