# refactor-discovery.dl — refactor signals from the engine's resolved call graph.
# PURE query, no engine change. Run:  dl v5/examples/refactor-discovery.dl --root .
#
# THEORY TEST RESULT (this file's first purpose): the concept doc claimed SCC
# clustering is free via `scc(a,b) <- reaches(a,b), reaches(b,a)`. It is NOT:
# `reaches` is a closure relation, and the engine forbids reading a closure
# unpinned in a rule body (would materialize the full closure). So all-pairs SCC
# and connected-components are BLOCKED without a `comp(id,node)` Tarjan builtin.
# What IS free: fan-in/fan-out (count over call_edge), 1-hop mutual calls, and
# per-seed reachability (one endpoint pinned). This file exercises the free half.

rel seen(path: file).
seen(path) <- scan("WORK", "v5/src/**/*.rs", path, rev), match(path, rev, /fn \w+/, line).

rel fan_out(caller: text, n: int).
rel fan_in(callee: text, n: int).
rel reaches(a: text, b: text).
rel mutual(a: text, b: text).
rel single_caller(callee: text, caller: text).
rel reaches_from_tick(b: text).

fan_out(caller, count(callee)) <- call_edge(caller, callee, _).
fan_in(callee, count(caller)) <- call_edge(caller, callee, _).

# closure relation: readable only with one endpoint pinned (see theory note above).
reaches(a, b) <- closure(call_edge).

# Tightly-coupled pairs: A calls B and B calls A (1-hop, no transitive closure).
mutual(a, b) <- call_edge(a, b, _), call_edge(b, a, _).

# Move candidate: a fn called from exactly one site -> fold into its caller.
single_caller(callee, caller) <- call_edge(caller, callee, _), fan_in(callee, 1).

# Seeded reachability (pinned endpoint is allowed): everything Engine.tick can reach.
reaches_from_tick(b) <- reaches(a, b), a = "sprefa::v5/src/engine.rs::method::Engine.tick".

rel hub_out(caller: text, n: int).
hub_out(caller, n) <- fan_out(caller, n), n >= 8.
rel hub_in(callee: text, n: int).
hub_in(callee, n) <- fan_in(callee, n), n >= 8.

? hub_out(caller, n).
? hub_in(callee, n).
? single_caller(callee, caller).
? reaches_from_tick(b).
