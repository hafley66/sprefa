# Lint: flag `.unwrap()` outside test code. Run as a live linter:
#   dl examples/lint-unwrap.dl --root . --lsp
# and any LSP client (VSCode, Claude Code) shows a squiggle per match.
# @op ast_yaml
#
# Two ast-grep ops, small and side by side:
#
#   sg(path, rev, :lang, "$X.unwrap()", line, col, end_line, end_col[, id])
#     A bare PATTERN. `$X` captures the receiver into dl var X (uppercase, same
#     name). Trailing positionals bind the match span (1-based line, 0-based byte
#     col). A pattern alone cannot say "but not inside a test".
#
#   ast_yaml(path, rev, :lang, `<RuleCore yaml>`, line, col, end_line, end_col)
#     A RELATIONAL rule (ast-grep's pattern/inside/has/not/any language, backtick
#     multiline). `not: inside: { kind: mod_item, has name ~ ^tests?$ }` walks the
#     CST ancestors and drops any unwrap contained in a `mod tests { }`. Real
#     structural containment — an unwrap in a comment/string, or in a differently
#     named production module, is judged correctly (no line-position heuristic).
#
# This program uses the relational form so the "outside test code" claim is true.
# `_` discards end_line; line/col/end_col drive the exact squiggle.

rel hit(path: file, line: int, col: int, end_col: int).
rel diag(path: file, line: int, col: int, end_col: int, severity: text, msg: text).

hit(path, line, col, end_col) <-
  scan("WORK", "v5/src/**/*.rs", path, rev),
  ast_yaml(path, rev, :rust, `
pattern: $X.unwrap()
not:
  inside:
    kind: mod_item
    has:
      field: name
      regex: '^tests?$'
    stopBy: end
`, line, col, _, end_col).

diag(path, line, col, end_col, "warn", "unwrap() outside test code: use ? or expect(\"reason\")") <-
  hit(path, line, col, end_col).

? diag(path, line, col, end_col, severity, msg).
