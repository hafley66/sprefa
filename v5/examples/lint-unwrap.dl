# Lint: flag `.unwrap()` outside test code. Run as a live linter:
#   dl examples/lint-unwrap.dl --root . --lsp
# and any LSP client (VSCode, Claude Code) shows a squiggle per match.
#
# The sg pattern `$X.unwrap()` captures the RECEIVER into the metavar $X, which
# binds to the dl variable X (uppercase, same name). The trailing positionals
# bind the match span: line, col, end_line, end_col (1-based lines, 0-based byte
# columns). Passing col/end_col to diag underlines exactly the match, not the
# whole line.

rel hit(X: text, path: file, line: int, col: int, end_line: int, end_col: int).
rel diag(path: file, line: int, col: int, end_line: int, end_col: int, severity: text, msg: text).

hit(X, path, line, col, end_line, end_col) <-
  scan("WORK", "v5/src/**/*.rs", path, rev),
  sg(path, rev, :rust, "$X.unwrap()", line, col, end_line, end_col).

diag(path, line, col, end_line, end_col, "warn", "unwrap() on `${X}`: use ? or expect(\"reason\")") <-
  hit(X, path, line, col, end_line, end_col).

? diag(path, line, col, end_line, end_col, severity, msg).
