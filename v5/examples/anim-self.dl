# The deck tours its own diff. Scan anim's TypeScript (readable by dl as of
# today's oxc producer), derive deck rows from anim's OWN type graph, and
# author a tour of the day's changes as facts — span steps land in the very
# functions that render this slide. anim reads the result through its
# `atlas-db data/animself.sqlite` fence.
#
#   dl sprefa/v5/examples/anim-self.dl --root ~/projects --db ~/projects/anim/data/animself.sqlite

rel seen(path: file).
seen(path) <- scan("WORK", "anim/src/**/*.{ts,tsx}", path, rev),
  match(path, rev, /./, line).

# plain-ident edges, TS stdlib/DOM containers dropped (Map in a field is
# plumbing, not shape)
rel edge0(f: text, t: text).
edge0(f, t) <- type_edge(f, t, k), k != "variant",
  f =~ "^[A-Za-z]+$", t =~ "^[A-Za-z]+$",
  t != "Record", t != "Array", t != "Map", t != "Set", t != "Promise",
  t != "ReturnType", t != "Exclude", t != "Pick", t != "Omit", t != "Partial",
  t != "HTMLElement", t != "HTMLDivElement", t != "EventTarget", t != "Text".

rel fan(f: text, n: int).
fan(f, count(t)) <- edge0(f, t).

rel node(id: text, kind: text, label: text).
node(f, "type", f) <- fan(f, _).
node(t, "type", t) <- fan(f, _), edge0(f, t).

rel edge(f: text, t: text).
edge(f, t) <- fan(f, _), edge0(f, t).

rel tag(node: text, ns: text, value: text).
tag(f, "tag", "hub") <- fan(f, n), n >= 5.

# where each shown type is declared (panel rows + periscope)
rel decl(name: text, path: file, line: int).
decl(name, path, line) <- seen(path), scan("WORK", "anim/src/**/*.{ts,tsx}", path, rev),
  match(path, rev, /^(?:export )?(?:type|interface|class|enum) (?<name>[A-Za-z][A-Za-z0-9]*)/, line).

rel node_ref(node: text, panel: text, locator: text).
node_ref(n, "fs", "${path}:${line}") <- node(n, _, _), decl(n, path, line).

rel card(id: text, body: text).
card("about.today", "every node here is a type from anim's own src/, extracted by the oxc producer written today").

rel card_about(card: text, node: text).
card_about("about.today", "Model").
card_about("about.today", "RelRows").

# the day's diff as a tour: focus steps over the types, span steps into the
# exact functions, rendered by the machinery the spans describe
rel tour(id: text, title: text).
tour("today", "the deck tours its own diff").

rel tour_step(tour: text, seq: int, target: text, comment: text).
tour_step("today", 0, "RelRows", "`RelRows` is the contract: nine rel_* tables in, one model out. This slide IS that path -- the fence below names a db this program wrote.").
tour_step("today", 1, "src/core/views.ts:79..95", "the periscope query: `resolveIdent` matches id|label|lastSeg, `identRefs` returns the files. Hover any node on this slide to run it.").
tour_step("today", 2, "src/Frames.tsx:285..331", "the Periscope dock itself: kept rows FLIP, entering rows draw on with an index-staggered connector.").
tour_step("today", 3, "PanelState+Spot", "renderer state: tour position and the active span mirror into `PanelState` so the once-bound window hook never goes stale.").
tour_step("today", 4, "src/CodeSpotlight.tsx:44..60", "the shiki tokenize effect coloring the very text you are reading: lang by extension, light theme lazy, plain fallback.").
tour_step("today", 5, "bin/build-frames.mjs:99..135", "rowsFromDb: the build step that read rel_node/rel_edge/rel_tour rows out of animself.sqlite and put this slide on screen.").

rel view(id: text, focus: text, mode: text, layout: text, dir: text, iso: int).
view("seed", "RelRows", "cone", "dagre", "LR", 0).
