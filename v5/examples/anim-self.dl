# The deck tours its own diff. Scan anim's TypeScript (readable by dl as of
# today's oxc producer), derive deck rows from anim's OWN type graph, and
# author a tour of the day's changes as facts — span steps land in the very
# functions that render this slide. anim reads the result through its
# `atlas-db data/animself.sqlite` fence.
#
# Root is the anim repo itself, so every path matches anim's `doc:` keys
# (span targets must equal the docs key byte-for-byte).
#
#   dl sprefa/v5/examples/anim-self.dl --root ~/projects/anim --db ~/projects/anim/data/animself.sqlite

rel seen(path: file).
seen(path) <- scan("WORK", "src/**/*.{ts,tsx}", path, rev),
  match(path, rev, /./, line).

# plain-ident edges, TS stdlib/DOM containers dropped (Map in a field is
# plumbing, not shape)
rel edge0(f: text, t: text).
edge0(f, t) <- type_edge(f, t, k), k != "variant",
  f =~ /^[A-Za-z]+$/, t =~ /^[A-Za-z]+$/,
  t != "Record", t != "Array", t != "Map", t != "Set", t != "Promise",
  t != "ReturnType", t != "Exclude", t != "Pick", t != "Omit", t != "Partial",
  t != "HTMLElement", t != "HTMLDivElement", t != "EventTarget", t != "Text".

rel fan(f: text, n: int).
fan(f, count(t)) <- edge0(f, t).

rel node(id: text, kind: text, label: text).
node(f, "type", f) <- fan(f, _).
node(t, "type", t) <- fan(f, _), edge0(f, t).

rel edge(f: text, t: text).
edge(f, t) <- fan(f, _), edge0(f, t).

rel tag(node: text, ns: text, value: text).
tag(f, "tag", "hub") <- fan(f, n), n >= 5.

# where each shown node is declared: read straight from `type_entity`, the
# sem-style entity table the engine now emits (no regex). One row per declared
# type OR function, with its exact line -- so the periscope and panel rows point
# at real declaration sites and a function node carries kind = "function".
rel node_ref(node: text, panel: text, locator: text).
node_ref(n, "fs", "${file}:${line}") <- node(n, _, _), type_entity(sym, n, kind, parent, file, line).

# tag function nodes so the deck can tell a function apart from a data type
tag(n, "kind", k) <- node(n, _, _), type_entity(sym, n, k, parent, file, line).

rel card(id: text, body: text).
card("about.today", "every node here is a type from anim's own src/, extracted by the oxc producer written today").

rel card_about(card: text, node: text).
card_about("about.today", "Model").
card_about("about.today", "RelRows").

# the day's diff as a tour: focus steps over the types, span steps into the
# exact functions, rendered by the machinery the spans describe.
# Span anchors are DERIVED, not pinned. TS function heads come from
# `type_entity` (the engine already found every function's declaration line);
# the .mjs build step isn't TS-extracted, and the tokenize effect is an
# anonymous closure, so those two stay regex pins. A fixed window sets the span
# height, so the tour survives edits that shift the files.
# scan-sourced pins (the .mjs build step, the anonymous tokenize closure) live
# in their own rel: a rel that mixes a scan() rule with a derived-rel rule drops
# the scanned rows, so type_entity function pins go in `fpin` and the two are
# unioned downstream in span_of (which has no scan atom).
rel pin(name: text, path: file, line: int).
pin(name, path, line) <- scan("WORK", "bin/*.mjs", path, rev),
  match(path, rev, /^(?:export )?function (?<name>[A-Za-z][A-Za-z0-9]*)/, line).
pin("tokenize", path, line) <- scan("WORK", "src/CodeSpotlight.tsx", path, rev),
  match(path, rev, /tokenize per file/, line).

rel fpin(name: text, file: file, line: int).
fpin(name, file, line) <- type_entity(sym, name, "function", parent, file, line).

rel win(name: text, len: int).
win("resolveIdent", 16).
win("Periscope", 46).
win("tokenize", 16).
win("rowsFromDb", 36).

rel span_of(name: text, path: file, lo: int, hi: int).
span_of(name, path, line, line + len) <- pin(name, path, line), win(name, len).
span_of(name, file, line, line + len) <- fpin(name, file, line), win(name, len).

rel tour(id: text, title: text).
tour("today", "the deck tours its own diff").

rel tour_step(tour: text, seq: int, target: text, comment: text).
tour_step("today", 0, "RelRows", "`RelRows` is the contract: nine rel_* tables in, one model out. This slide IS that path -- the fence below names a db this program wrote.").
tour_step("today", 1, "${path}:${lo}..${hi}", "the periscope query: `resolveIdent` matches id|label|lastSeg, `identRefs` returns the files. Hover any node on this slide to run it.") <- span_of("resolveIdent", path, lo, hi).
tour_step("today", 2, "${path}:${lo}..${hi}", "the Periscope dock itself: kept rows FLIP, entering rows draw on with an index-staggered connector.") <- span_of("Periscope", path, lo, hi).
tour_step("today", 3, "PanelState+Spot", "renderer state: tour position and the active span mirror into `PanelState` so the once-bound window hook never goes stale.").
tour_step("today", 4, "${path}:${lo}..${hi}", "the shiki tokenize effect coloring the very text you are reading: lang by extension, light theme lazy, plain fallback.") <- span_of("tokenize", path, lo, hi).
tour_step("today", 5, "${path}:${lo}..${hi}", "rowsFromDb: the build step that read rel_node/rel_edge/rel_tour rows out of animself.sqlite and put this slide on screen.") <- span_of("rowsFromDb", path, lo, hi).

rel view(id: text, focus: text, mode: text, layout: text, dir: text, iso: int).
view("seed", "RelRows", "cone", "dagre", "LR", 0).
