# gen-reference.dl — programmable rustdoc/jsdoc for the engine's OWN surface.
#
# Writes a folder of reference pages from the engine's self-describing catalogs,
# using the :append form of `gen` (`gen(:append, "path", "row")`): every rule
# targeting one file concatenates in PROGRAM ORDER, so a title rule, a header
# rule, a separator rule, and a rows rule assemble one ordered page — no marker
# pairs, no in-place edit, no sort-key tricks. The engine creates the dir and
# skips the write when the bytes already match (convergence, safe under --watch /
# CI). README links to these pages instead of inlining the tables, so the docs
# cannot drift: a new built-in relation (RelDecl group/doc) or scalar function
# (fn_docs) appears on the next tick, and the doc-completeness tests fail the
# build until it carries a summary.
#
#   Run:     dl examples/gen-reference.dl   (paths are root-relative; default
#            --root = nearest .git, same convention as the other generators)
#   Output:  docs/reference/{relations,functions,syntax,examples,magic-rels}.md
#   Daemon:  dl daemon load examples/gen-reference.dl   (regens on engine.rs edits)
#
# Add a page by adding a catalog and a block of :append rules — the doc layout is
# entirely in dl, however you want it. This is the "auto-doc folder": a page is a
# query. `true` is the always-true singleton: a header line is one row over it.

# ── relations.md : every built-in relation, grouped, from rel_catalog ──────────
gen(:append, "docs/reference/relations.md", "# Built-in relations") <- true().
gen(:append, "docs/reference/relations.md", "") <- true().
gen(:append, "docs/reference/relations.md",
    "Generated from the engine's `rel_catalog` by examples/gen-reference.dl. Do not hand-edit.") <- true().
gen(:append, "docs/reference/relations.md", "") <- true().
gen(:append, "docs/reference/relations.md", "| relation | group | columns | summary |") <- true().
gen(:append, "docs/reference/relations.md", "|---|---|---|---|") <- true().
gen(:append, "docs/reference/relations.md", "| `{name}` | {group} | `{cols}` | {doc} |") <-
    rel_catalog(name, group, cols, doc).

# ── functions.md : every scalar function, from fn_catalog ──────────────────────
gen(:append, "docs/reference/functions.md", "# Scalar functions") <- true().
gen(:append, "docs/reference/functions.md", "") <- true().
gen(:append, "docs/reference/functions.md",
    "Callable in a rule head or a comparison side. Generated from the engine's `fn_catalog` by examples/gen-reference.dl. Do not hand-edit.") <- true().
gen(:append, "docs/reference/functions.md", "") <- true().
gen(:append, "docs/reference/functions.md", "| function | arity | group | what it does |") <- true().
gen(:append, "docs/reference/functions.md", "|---|---|---|---|") <- true().
gen(:append, "docs/reference/functions.md", "| `{name}` | {arity} | {group} | {doc} |") <-
    fn_catalog(name, arity, group, doc).

# ── syntax.md : every body/sink op (syntax + semantics), from op_catalog ───────
# The `example` column is a "see more": one program that uses each op, shown
# from the binary with `dl examples --show <name>` (no source tree needed). It
# is computed by joining the self-describing op_catalog against the op-call
# heads scanned out of the examples/ corpus — so a new example that uses an op
# lights up its row on the next gen, and an op no example exercises renders an
# empty cell (visible drift, same convention as an undocumented flag).
#
# Curation lives in COMMENT SPACE: a `# @op <name>` line in an example pins it as
# that op's canonical see-more (the min-pick below is only a fallback). The pin
# doubles as a live LSP squiggle — run this generator with --lsp and each `# @op`
# line carries an INFO diagnostic saying where it is transcluded (see the diag
# rules further down); a pin naming no known op WARNs (a typo in the marker).

# Every `ident(` call head in the examples corpus, with its line.
rel ex_call(op: text, ex: file, line: int).
ex_call(op, ex, l) <-
    scan("WORK", "examples/*.dl", ex, rev),
    match_line(ex, rev, /(?<op>[a-z_][a-z0-9_]*)\(/, l).

# Keep only heads that are a real op (join the catalog). op_used gates the
# empty-cell rule.
rel op_use(op: text, ex: file).
op_use(op, ex) <- op_catalog(op, _, _, _), ex_call(op, ex, _).
rel op_used(op: text).
op_used(op) <- op_use(op, _).

# `# @op <name>` pins in comment space: the curated see-more for that op. One
# file may pin several ops (one per line).
rel op_pin(op: text, ex: file, line: int).
op_pin(op, ex, l) <-
    scan("WORK", "examples/*.dl", ex, rev),
    comment(ex, rev, /^\s*@op\s+(?<s>[a-z_][a-z0-9_]*)/, l, label: op).

# Representative example per op = the pin if present (and a real op), else the
# lexicographically first path. op_show carries the basename for `dl examples
# --show`; the two rules are guarded so a pinned op never also takes the min.
rel op_example(op: text, ex: file).
op_example(op, min(ex)) <- op_use(op, ex).
rel op_show(op: text, name: text).
op_show(op, split(ex, "/", -1)) <- op_pin(op, ex, _), op_catalog(op, _, _, _).
op_show(op, split(ex, "/", -1)) <- op_example(op, ex), !op_pin(op, _, _).

# The pin as a live squiggle: gen rules skip under --lsp, diag rules do not, so
# the SAME op_pin set drives both the splice (above) and an editor diagnostic.
# INFO on a valid pin says where it lands; WARN on an unknown op catches a typo.
diag(path: ex, line: l, col: 0, end_line: l, end_col: 0, severity: "info", code: "op-example", msg: replace("curated `dl examples --show` for op @OP@ -> docs/reference/syntax.md", "@OP@", op)) <-
    op_pin(op, ex, l), op_catalog(op, _, _, _).
diag(path: ex, line: l, col: 0, end_line: l, end_col: 0, severity: "warn", code: "op-example-unknown", msg: replace("`# @op @OP@` names no known op (see op_catalog)", "@OP@", op)) <-
    op_pin(op, ex, l), !op_catalog(op, _, _, _).

gen(:append, "docs/reference/syntax.md", "# Syntax & semantics") <- true().
gen(:append, "docs/reference/syntax.md", "") <- true().
gen(:append, "docs/reference/syntax.md",
    "Source ops (extract facts from files), body constructs (derived rules), and sinks. The `kind` column groups them; `example` shows one program that uses the op (`dl examples --show <name>` prints it from the binary). Generated from the engine's `op_catalog` by examples/gen-reference.dl. Do not hand-edit.") <- true().
gen(:append, "docs/reference/syntax.md", "") <- true().
gen(:append, "docs/reference/syntax.md", "| op | kind | syntax | semantics | example |") <- true().
gen(:append, "docs/reference/syntax.md", "|---|---|---|---|---|") <- true().
# With a see-more example.
gen(:append, "docs/reference/syntax.md", "| `{op}` | {kind} | `{syntax}` | {doc} | `dl examples --show {name}` |") <-
    op_catalog(op, kind, syntax, doc), op_show(op, name).
# No example exercises this op yet (empty cell = visible drift).
gen(:append, "docs/reference/syntax.md", "| `{op}` | {kind} | `{syntax}` | {doc} | |") <-
    op_catalog(op, kind, syntax, doc), !op_used(op).

# ── examples.md : the examples/ corpus, first-comment summary per file ─────────
# example_doc keys each program on its filename and its first `#` comment line
# (the convention every example opens with). A pure scan+comment — no new catalog.
rel example_doc(name: text, desc: text).
example_doc(replace(p, "examples/", ""), desc) <-
    scan("examples/*.dl", p, rev), comment(p, rev, /^\s?(?<s>.*)$/, l, label: desc), l = 1.
example_doc(replace(p, "examples/", ""), desc) <-
    scan("examples/**/*.dl", p, rev), comment(p, rev, /^\s?(?<s>.*)$/, l, label: desc), l = 1.
gen(:append, "docs/reference/examples.md", "# Examples") <- true().
gen(:append, "docs/reference/examples.md", "") <- true().
gen(:append, "docs/reference/examples.md",
    "Every program in `examples/`, with its first-line summary. Generated by examples/gen-reference.dl (scan + match_line over the corpus). Do not hand-edit.") <- true().
gen(:append, "docs/reference/examples.md", "") <- true().
gen(:append, "docs/reference/examples.md", "| example | summary |") <- true().
gen(:append, "docs/reference/examples.md", "|---|---|") <- true().
gen(:append, "docs/reference/examples.md", "| [`{name}`](../../examples/{name}) | {desc} |") <-
    example_doc(name, desc).

# ── magic-rels.md : the demand/overlay SINK conventions, from rel_catalog ─────
# The relations a user HEADS from a rule (like diag/repo) whose rows drive engine
# behavior bound to the name — scip_want, rev_cmp_want, def_target, effect_cmd.
# They are first-class catalogued builtins (group `demand`), NOT a side channel;
# this page is just the `demand` slice of rel_catalog. The .dl/magic-rel-audit.dl
# rail fails `dl --check` if the engine ever reads a literal rel name that is not
# catalogued at all.
gen(:append, "docs/reference/magic-rels.md", "# Demand & overlay sink relations") <- true().
gen(:append, "docs/reference/magic-rels.md", "") <- true().
gen(:append, "docs/reference/magic-rels.md",
    "Built-in SINK relations a program HEADS from a rule (like `diag`/`repo`): deriving rows drives the engine behavior bound to the name — a SCIP index demand, a git ancestry demand, an LSP go-to-definition, an effect-template overlay. Pre-declared and catalogued (they are the `demand` group of `rel_catalog`), so the binding is visible and the engine reading them by name is reading a catalogued builtin, not magic. Do NOT `rel`-declare them; head them directly. The `.dl/magic-rel-audit.dl` rail fails `dl --check` if the engine reads any literal rel name that is not catalogued. Generated by examples/gen-reference.dl from `rel_catalog`. Do not hand-edit.") <- true().
gen(:append, "docs/reference/magic-rels.md", "") <- true().
gen(:append, "docs/reference/magic-rels.md", "| relation | columns | what heading it does |") <- true().
gen(:append, "docs/reference/magic-rels.md", "|---|---|---|") <- true().
gen(:append, "docs/reference/magic-rels.md", "| `{name}` | `{cols}` | {doc} |") <-
    rel_catalog(name, "demand", cols, doc).

# ── README splice : the full examples index, between the BEGIN/END markers ────
# Same example_doc set, spliced in place (marker form) so the README's full
# corpus list cannot drift from the files on disk.
rel ex_block(p: file, l0: int, l1: int).
ex_block(p, l0, l1) <- scan("WORK", "README.md", p, rev),
    comment(p, rev, /BEGIN: examples-index/, /END: examples-index/, l0, l1).
gen(p, l0, l1, "| example | summary |") <- ex_block(p, l0, l1).
gen(p, l0, l1, "|---|---|") <- ex_block(p, l0, l1).
gen(p, l0, l1, "| [`{name}`](examples/{name}) | {desc} |") <-
    ex_block(p, l0, l1), example_doc(name, desc).
