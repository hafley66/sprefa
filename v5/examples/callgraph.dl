# Call graph of dl's own source, discovered by pattern, queried as a graph.
# `path: file` is a checked type: rows whose path is not a real file are dropped.
# calls is file-scoped co-occurrence (caller's file mentions a known fn), a
# heuristic, not a resolved call graph. reaches is its transitive closure.

rel def(name: text, path: file, line: int).
rel use(name: text, path: file, line: int).
rel calls(caller: text, callee: text).
rel reaches(src: text, dst: text).
rel unused(name: text).

def(name, path, line) <-
  scan("WORK", "v5/src/**/*.rs", path, rev),
  match(path, rev, /fn\s+(?<name>[a-z_][a-z0-9_]+)/, line).

use(name, path, line) <-
  scan("WORK", "v5/src/**/*.rs", path, rev),
  match(path, rev, /(?<name>[a-z_][a-z0-9_]+)\s*\(/, line).

calls(caller, callee) <-
  def(caller, p, _),
  use(callee, p, _),
  def(callee, _, _),
  caller != callee.

reaches(src, dst) <- closure(calls).

unused(name) <- def(name, _, _), !calls(_, name).

? unused(name).
? calls(caller, callee) where caller = "lex".
? reaches(src, dst) where src = "lex".
