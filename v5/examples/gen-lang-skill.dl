# gen-lang-skill.dl — LANG-JUNCTION markers drive the add-a-language skill.
#
# Every per-language registration point in src/ carries a one-line marker:
#     // LANG-JUNCTION(<slug>): <what a new language wires here>
# This program scans the markers and regenerates the junction list in
# .agents/skills/sprf-add-language/SKILL.md between the lang-junctions
# comment markers. comment_node joins each match, so the marker text inside a
# string literal (or this file's own regex) can never mint a junction row —
# only a real comment counts. Both match_line() and comment_node are 1-based lines.
#
#   Run:    dl examples/gen-lang-skill.dl
#   Check:  dl examples/gen-lang-skill.dl --check   (drift rail: the slug set in
#           src vs the slug set in the skill; line-number drift alone never fails)
# Rerun converges (gen writes only when bytes differ).

# Raw text matches (source-extract rule; one rel = one rule kind, so the
# comment_node join lives in the DERIVED rel below — a match_line rule body
# cannot also join a rel). A marker inside a string literal CAN land here.
rel junction_text(src_path: file, marker_line: int, slug: text, what: text).
junction_text(src_path, marker_line, slug, what) <-
    scan("WORK", "src/**/*.rs", src_path, rev),
    match_line(src_path, rev, /LANG-JUNCTION\((?<slug>[a-z0-9-]+)\): (?<what>.+)$/, marker_line).

# A junction = a text match the grammar lexed as a comment.
rel junction(src_path: file, marker_line: int, slug: text, what: text).
junction(src_path, marker_line, slug, what) <-
    junction_text(src_path, marker_line, slug, what),
    comment_node(src_path, marker_line, _, _, _, _, _).

# ── splice: the generated junction list in the skill ───────────────────────────
rel skill_zone(skill_path: file, zone_start: int, zone_end: int).
skill_zone(skill_path, zone_start, zone_end) <-
    scan("WORK", ".agents/skills/sprf-add-language/SKILL.md", skill_path, rev),
    comment(skill_path, rev, /BEGIN: lang-junctions/, /END: lang-junctions/, zone_start, zone_end).
gen(skill_path, zone_start, zone_end, "- `{src_path}:{marker_line}` {slug}: {what}") <-
    skill_zone(skill_path, zone_start, zone_end), junction(src_path, marker_line, slug, what).

# ── drift rail ─────────────────────────────────────────────────────────────────
# The slug rows ACTUALLY present between the skill's markers on disk.
rel skill_row(skill_path: file, slug: text, row_line: int).
skill_row(skill_path, slug, row_line) <-
    scan("WORK", ".agents/skills/sprf-add-language/SKILL.md", skill_path, rev),
    match_line(skill_path, rev, /^- `[^`]+` (?<slug>[a-z0-9-]+): /, row_line).
rel skill_has(slug: text).
skill_has(slug) <- skill_row(skill_path, slug, row_line),
    skill_zone(skill_path, zone_start, zone_end),
    row_line > zone_start, row_line < zone_end.

# Forward: a marker in src whose slug is absent from the skill.
diag(path: src_path, line: marker_line, severity: "error", code: "lang-junction-drift",
     msg: "LANG-JUNCTION(${slug}) in source but absent from sprf-add-language SKILL.md; rerun examples/gen-lang-skill.dl") <-
    junction(src_path, marker_line, slug, _), !skill_has(slug).

# Reverse: the skill lists a slug with no marker left in src.
rel junction_slug(slug: text).
junction_slug(slug) <- junction(_, _, slug, _).
diag(path: skill_path, line: 1, severity: "error", code: "lang-junction-orphan",
     msg: "sprf-add-language SKILL.md lists junction ${slug} with no LANG-JUNCTION marker in src/; rerun examples/gen-lang-skill.dl") <-
    skill_zone(skill_path, _, _), skill_has(slug), !junction_slug(slug).
