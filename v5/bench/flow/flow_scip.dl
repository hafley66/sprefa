# Cross-language operation flow, SCIP-resolved. The OpenAPI spec is codegen'd into
# a client library (one exported symbol per operationId); a codebase imports that
# library. The blast radius of an operation is every resolved ref / import /
# callsite of its generated symbol — compiler-resolved across the package
# boundary, not name-matched. The operationId is needed only to label the one
# generated def; SCIP carries the rest.

rel src(p: file).
src(p) <- scan("WORK", "**/*.rs", p, rev).
src(p) <- scan("WORK", "**/*.ts", p, rev).

# the contract: every operationId declared in the spec (source of truth).
rel spec_op(op: text).
spec_op(op) <- scan("WORK", "**/openapi.yaml", p, rev),
  jsonp(p, rev, "paths.*.*.operationId", op).

# a generated file carries the codegen banner (how you really detect generated
# code: the banner, not a path convention).
rel gen_file(file: file).
gen_file(f) <- scan("WORK", "**/*.ts", f, rev), match(f, rev, /GENERATED from openapi/, l).
gen_file(f) <- scan("WORK", "**/*.rs", f, rev), match(f, rev, /GENERATED from openapi/, l).

# the generated symbol for an operation: a def in a generated file whose
# descriptor name IS the operationId. scip_name is the in-engine descriptor (a
# pure-dl split leaks `impl#[Type]` on methods).
rel gen_def(op: text, sym: text, file: file).
gen_def(op, sym, f) <- spec_op(op), scip_name(sym, op), scip_def(sym, f, _), gen_file(f).

# backend implementor: a def whose descriptor IS the operationId, in a Rust file
# (the handwritten handler the spec is implemented by). The .rs filter is the
# role; the spec doesn't say "backend", the repo does.
rel impl_sym(op: text, sym: text, file: file).
impl_sym(op, sym, f) <- spec_op(op), scip_name(sym, op), scip_def(sym, f, _),
  ext = split(f, ".", -1), ext = "rs".

# consumer: every resolved ref to a generated symbol — the import line and each
# callsite, resolved across the package boundary by SCIP. This is the blast
# radius of the operation in the consuming codebase.
rel consumer(op: text, file: file).
consumer(op, rf) <- gen_def(op, sym, _), scip_ref(rf, sym, _, _).

rel flow_sym(op: text, role: text, file: file).
flow_sym(op, "impl", f)      <- impl_sym(op, _, f).
flow_sym(op, "generated", f) <- gen_def(op, _, f).
flow_sym(op, "consumer", f)  <- consumer(op, f).

? gen_def(op, sym, file).
? consumer(op, file).
? flow_sym(op, role, file).
