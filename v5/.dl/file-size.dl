# 300-500: needs a written reason to stay this size, or a split.
diag(path, line: 1, severity: "warning", code: "file-over-soft-budget",
     msg: "`${path}` is ${line_count} lines (soft budget ${soft}) — needs a written reason to stay this size, or a split") <-
    src_file(path), file_lines(_, path, "WORK", line_count),
    soft_budget(soft), hard_budget(hard),
    line_count > soft, line_count <= hard.

# >500, already grandfathered in scripts/filesize-allow.txt: named, not silent.
diag(path, line: 1, severity: "warning", code: "file-over-budget-grandfathered",
     msg: "`${path}` is ${line_count} lines (hard budget ${hard}), ${reason}") <-
    src_file(path), file_lines(_, path, "WORK", line_count),
    hard_budget(hard), line_count > hard,
    big_file_ok(path, reason).

# >500, NOT grandfathered: the STOP protocol.
diag(path, line: 1, severity: "warning", code: "file-over-budget",
     msg: "STOP: `${path}` is ${line_count} lines (hard budget ${hard}) — propose 3 ways to split this file, or 1 justification, then add it to scripts/filesize-allow.txt with a plan pointer") <-
    src_file(path), file_lines(_, path, "WORK", line_count),
    hard_budget(hard), line_count > hard,
    !big_file_ok(path, _).

# The running debt count Chris specced, as one aggregate diag pinned to this
# program's own path/line 1.
rel offender_count(n: int).
offender_count(count(path)) <-
    src_file(path), file_lines(_, path, "WORK", line_count),
    hard_budget(hard), line_count > hard.

diag(path: ".dl/file-size.dl", line: 1, severity: "warning", code: "file-size-debt",
     msg: "you still have ${n} unacceptable files (>500 lines)") <- offender_count(n).

? diag(path, line, severity: sev, code, msg).
