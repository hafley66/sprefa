# The dl-native file-size law (Chris, 2026-07-11): no source file over 500
# lines, target 300. This is the ADVISORY twin of `scripts/filesize-rail.sh`
# (the exit-2 enforcement prong run by verify.sh / the pre-commit hook / CI).
# Every diag here is WARNING severity, never error — a --check run of this
# program alone always exits 0. That is deliberate: an error-severity rail
# exiting non-zero from a PostToolUse hook blocked every write repo-wide on
# 2026-07-11 (an outage). Live checks stay advisory; the bash rail is the
# only place that fails a build.
#
# Own bare scan so this program never rides another program's corpus — it
# works loaded alone (`dl .dl/file-size.dl`) or merged with anything else.
rel src_file(path: file).
src_file(path) <- scan("WORK", "src/**/*.rs", path, source_rev).

rel soft_budget(max_lines: int).
soft_budget(300).
rel hard_budget(max_lines: int).
hard_budget(500).

# Mirrors `scripts/filesize-allow.txt` — THAT file is canonical (CI diffs it;
# the allowlist may only shrink). This table exists so the advisory rail can
# name the same grandfathered files without shelling out; keep it in sync by
# hand when the script's list changes (a drift check is future work, same
# shape as the lang-junction skill rail).
rel big_file_ok(path: text, reason: text).
big_file_ok("src/anchor.rs", "grandfathered (scripts/filesize-allow.txt)").
big_file_ok("src/ast.rs", "grandfathered (scripts/filesize-allow.txt)").
