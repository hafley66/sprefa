# VSIX version-parity rail: the embedded VS Code extension and the `dl` binary
# ship as ONE version.
#
# `dl setup --vscode` installs a VSIX baked into the `dl` binary via
# `include_bytes!` (src/setup.rs). The filename is now FIXED (`dl-lsp.vsix`, no
# version in it), so the single source of truth for the version is Cargo.toml;
# `scripts/build-vsix.sh` stamps editors/vscode-dl/package.json to the crate
# version and rebuilds the VSIX. `build.rs` refuses to compile if the two
# disagree; this rail is the same guard for `dl --check` and the LSP squiggles.
#
# The fix when it fires: run `scripts/build-vsix.sh` (stamps package.json to the
# Cargo.toml version, rebuilds + stages editors/vscode-dl/dl-lsp.vsix), commit.

# The crate version (Cargo.toml [package] version — the ONLY line that starts
# with `version = "`; dependency pins are `name = "..."`).
rel crate_version(version: text).
crate_version(version) <-
    scan("WORK", "Cargo.toml", cargo_path, rev),
    match_line(cargo_path, rev, /^version = "(?<version>\d+\.\d+\.\d+)"/, line).

# The extension's own declared version (top-level "version" key; dependency
# ranges are keyed by package name, so only this one line matches).
rel ext_version(version: text).
ext_version(version) <-
    scan("WORK", "editors/vscode-dl/package.json", manifest_path, rev),
    match_line(manifest_path, rev, /"version"\s*:\s*"(?<version>\d+\.\d+\.\d+)"/, line).

# Drift: the extension's package.json version and the crate version disagree.
diag(path: "editors/vscode-dl/package.json", line: 1, severity: "error",
     code: "vsix-version-drift",
     msg: "extension package.json is ${ext} but Cargo.toml crate is ${crate} — run scripts/build-vsix.sh to rebuild dl-lsp.vsix at the crate version") <-
    crate_version(crate), ext_version(ext), crate != ext.

? diag(path, line, severity, code, msg).
