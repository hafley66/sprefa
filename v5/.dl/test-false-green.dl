# Rail: a test that CAN report pass without testing anything.
#
# Incident (2026-07-20). Three "green" results in one session meant nothing:
#   1. `verify.sh` stamped the tree verified having never run the 978-test `it`
#      binary — `cargo test` aborts remaining targets at the first failing one,
#      so one flaky `--lib` test hid the whole integration suite. Fixed with
#      --no-fail-fast; not this rail's job (that one is a harness bug).
#   2. `propose::tests::symbol_ranges_subset_of_ast_on_engine_rs` reported PASS
#      in 0.00s. It read `{CARGO_MANIFEST_DIR}/../index.scip`, a path that
#      stopped existing at the v5 lift (2026-07-01) when the crate became the
#      repo root, and on a load miss did `Err(_) => { warn; return; }`. It had
#      been asserting nothing for weeks while reporting success.
#   3. `extract_cache::df_twins_salt_ids_by_rev_and_join_within_a_rev` asserted
#      the PRE-change design after that design was inverted.
#
# Clippy cannot see any of this. Its only adjacent lint is
# `assertions_on_constants` (assert!(true)); there is no rustc/clippy lint for
# "no assertion in a #[test]", "early return past the asserts", or "#[ignore]
# parking a known bug". Hence a rail.
#
# The law: a #[test] must assert on EVERY path through its body, and an
# #[ignore] must name an ENVIRONMENTAL need, never an unfixed defect.

# SCOPE: tests/** AND src/**. The earlier call_def-based draft could not reach
# src/ at all —
# `call_def` does not emit functions inside `#[cfg(test)] mod tests` — verified
# 2026-07-20: between src/ast.rs:548 (`#[cfg(test)] mod tests`) and :650 the
# only call_def row is `SpliceMode.tag` at :643, so every unit test in that
# module is invisible to the call graph. Including src/** here does not extend
# coverage; it manufactures false positives, because a `#[test]` attribute then
# binds to the nearest VISIBLE fn, which is some unrelated method far below.
# Consequence worth knowing beyond this rail: the 617-test unit layer cannot be
# reached by ANY rail built on call_def. Covering it needs either cfg(test)
# extraction in the engine or a span model that does not depend on call_def.
rel src_scanned(file: file).
src_scanned(f) <- scan("WORK", "tests/**/*.rs", f, rev).

# --- fn spans from the resolved def graph -------------------------------------
# call_def carries (repo, sym, kind, file, line, end) — a REAL end line, so span
# containment is exact and needs none of the "nearest decl above" hackery that
# the recompute-guard rail had to use (and that closures defeated there).
# Closures are still excluded: a closure inside a test body is not the test.
rel fn_span(file: file, start: int, end: int).
fn_span(f, s, e) <- scan("WORK", "tests/**/*.rs", f, rev),
    match_ast(f, rev, :rust, "fn $NAME($$$PARAMS) { $$$BODY }", line: s, end_line: e).
fn_span(f, s, e) <- scan("WORK", "src/**/*.rs", f, rev),
    match_ast(f, rev, :rust, "fn $NAME($$$PARAMS) { $$$BODY }", line: s, end_line: e).

# --- which fns are tests ------------------------------------------------------
# `#[test]` sits above the fn, possibly with #[ignore]/#[should_panic] between.
# Bind the attribute to the NEAREST fn below it, the mirror of the recompute
# rail's nearest-above, and exclude closures so an inner closure cannot steal
# the attribute from the test that owns it.
rel test_attr(file: file, line: int).
test_attr(f, l) <- scan("WORK", "tests/**/*.rs", f, rev), match_ast(f, rev, :rust, "#[test]", line: l).
test_attr(f, l) <- scan("WORK", "src/**/*.rs", f, rev), match_ast(f, rev, :rust, "#[test]", line: l).
rel attr_fn_below(file: file, attrline: int, start: int).
attr_fn_below(f, al, s) <- test_attr(f, al), fn_span(f, s, _), al < s.
rel attr_fn_closer(file: file, attrline: int, start: int).
attr_fn_closer(f, al, s) <- attr_fn_below(f, al, s), fn_span(f, mid, _), al < mid, mid < s.
rel test_fn(file: file, start: int, end: int).
test_fn(f, s, e) <- attr_fn_below(f, al, s), !attr_fn_closer(f, al, s), fn_span(f, s, e).

# --- evidence that a body actually checks something ---------------------------
# `.unwrap()`/`.expect()` count: they panic on failure, so they ARE assertions
# about the value they unwrap. A test made only of unwraps is weak but not a
# false green, and this rail is about false greens.
rel assert_site(file: file, line: int).
assert_site(f, l) <- scan("WORK", "tests/**/*.rs", f, rev), match_ast(f, rev, :rust, "assert!($$$A)", line: l).
assert_site(f, l) <- scan("WORK", "src/**/*.rs", f, rev), match_ast(f, rev, :rust, "assert!($$$A)", line: l).
assert_site(f, l) <- scan("WORK", "tests/**/*.rs", f, rev), match_ast(f, rev, :rust, "assert_eq!($$$A)", line: l).
assert_site(f, l) <- scan("WORK", "src/**/*.rs", f, rev), match_ast(f, rev, :rust, "assert_eq!($$$A)", line: l).
assert_site(f, l) <- scan("WORK", "tests/**/*.rs", f, rev), match_ast(f, rev, :rust, "assert_ne!($$$A)", line: l).
assert_site(f, l) <- scan("WORK", "src/**/*.rs", f, rev), match_ast(f, rev, :rust, "assert_ne!($$$A)", line: l).
assert_site(f, l) <- scan("WORK", "tests/**/*.rs", f, rev), match_ast(f, rev, :rust, "panic!($$$A)", line: l).
assert_site(f, l) <- scan("WORK", "src/**/*.rs", f, rev), match_ast(f, rev, :rust, "panic!($$$A)", line: l).
assert_site(f, l) <- scan("WORK", "tests/**/*.rs", f, rev), match_ast(f, rev, :rust, "unreachable!($$$A)", line: l).
assert_site(f, l) <- scan("WORK", "src/**/*.rs", f, rev), match_ast(f, rev, :rust, "unreachable!($$$A)", line: l).
assert_site(f, l) <- scan("WORK", "tests/**/*.rs", f, rev), match_ast(f, rev, :rust, "prop_assert!($$$A)", line: l).
assert_site(f, l) <- scan("WORK", "src/**/*.rs", f, rev), match_ast(f, rev, :rust, "prop_assert!($$$A)", line: l).
assert_site(f, l) <- scan("WORK", "tests/**/*.rs", f, rev), match_ast(f, rev, :rust, "proptest!($$$A)", line: l).
assert_site(f, l) <- scan("WORK", "src/**/*.rs", f, rev), match_ast(f, rev, :rust, "proptest!($$$A)", line: l).
assert_site(f, l) <- scan("WORK", "tests/**/*.rs", f, rev), match_ast(f, rev, :rust, "$X.unwrap()", line: l).
assert_site(f, l) <- scan("WORK", "src/**/*.rs", f, rev), match_ast(f, rev, :rust, "$X.unwrap()", line: l).
assert_site(f, l) <- scan("WORK", "tests/**/*.rs", f, rev), match_ast(f, rev, :rust, "$X.expect($$$A)", line: l).
assert_site(f, l) <- scan("WORK", "src/**/*.rs", f, rev), match_ast(f, rev, :rust, "$X.expect($$$A)", line: l).

rel should_panic_attr(file: file, line: int).
should_panic_attr(f, l) <- scan("WORK", "tests/**/*.rs", f, rev), match_ast(f, rev, :rust, "#[should_panic]", line: l).
should_panic_attr(f, l) <- scan("WORK", "src/**/*.rs", f, rev), match_ast(f, rev, :rust, "#[should_panic]", line: l).


rel sp_fn_below(file: file, attrline: int, start: int).
sp_fn_below(f, al, s) <- should_panic_attr(f, al), fn_span(f, s, _), al < s.
rel sp_fn_closer(file: file, attrline: int, start: int).
sp_fn_closer(f, al, s) <- sp_fn_below(f, al, s), fn_span(f, mid, _), al < mid, mid < s.

rel test_asserts(file: file, start: int).
test_asserts(f, s) <- test_fn(f, s, e), assert_site(f, l), s <= l, l <= e.
# #[should_panic] tests assert by their attribute; the panic IS the assertion.
# Bound to the nearest fn below, same nearest-below shape as test_attr, so no
# arithmetic line-distance guess is needed.
test_asserts(f, s) <- sp_fn_below(f, al, s), !sp_fn_closer(f, al, s).

# --- arm 1: a #[test] whose body never checks anything ------------------------
rel asserts_nothing_finding(file: file, line: int).
asserts_nothing_finding(f, s) <- test_fn(f, s, _), !test_asserts(f, s).

# --- arm 2: a skip path that returns success ----------------------------------
# Matches a BARE `return;`, not a specific skip idiom. The first draft keyed on
# `Err(_) => ... return;` on one line and caught NOTHING — not even the SCIP
# incident that motivated the rail, whose arm spans three lines, and not the two
# the group-4 audit found independently:
#   tests/it/scip_name.rs:80   `let Some(ra) = find_ra() else { eprintln!(..); return; };`
#   tests/it/seam_bench.rs:162 `if !root.exists() { eprintln!(..); return; }`
# Neither is an `Err` arm. The invariant that actually generalizes is that a
# test should run to its end; every early exit is a path that reports PASS
# having skipped the assertions below it. A genuinely environmental precondition
# belongs behind #[ignore] with the need NAMED, so the run reports it as
# excluded rather than counting it as coverage.
rel bare_return_line(file: file, line: int).
bare_return_line(f, l) <- scan("WORK", "tests/**/*.rs", f, rev), match_ast(f, rev, :rust, "return;", line: l).
bare_return_line(f, l) <- scan("WORK", "src/**/*.rs", f, rev), match_ast(f, rev, :rust, "return;", line: l).
rel silent_skip_finding(file: file, line: int).
silent_skip_finding(f, l) <- test_fn(f, s, e), bare_return_line(f, l), s <= l, l <= e.

# --- arm 3: an #[ignore] parking a known defect -------------------------------
# ENV-GATED is legitimate (network, rust-analyzer, a specific OS, a corpus).
# Parking an unfixed BUG/GAP behind #[ignore] is how a real defect goes quiet:
# see `daemon::linux_inotify_watch_count_tracks_unignored`, ignored as "fails
# until Linux per-directory watch pruning lands; this test is its spec" — the
# feature it specs has not landed, so the #[ignore] names the real gap instead
# of a tool the environment lacks.
#
# The router empty-input footprint bug this arm originally found
# (`retraction_props::equivalence_and_memo_hold_at_every_step_high_volume`) was
# fixed by 2acf0c71; that test's #[ignore] reason is now "high-volume T4
# property suite: 200 cases" (a cost gate, not a bug), so it no longer matches
# this arm and its `ignore_bug_baseline` row was removed.
# THE ONE `match_line` IN THIS FILE, and it marks a real engine gap rather than
# laziness. The predicate is on the ignore reason's TEXT CONTENT. match_ast
# matches the shape `#[ignore = $REASON]` and yields its line, but
# metavariables are not exportable as output args (match_ast outputs are
# line/col/end_line/end_col/id only), so a bound $REASON cannot be
# regex-filtered downstream. Until match_ast can export a metavar's text, a
# content predicate over a matched string has no structural spelling. THIS is
# the shape of the remaining legitimate `match_line` use.
# `\bbug\b`, not bare `bug`: the substring version matched "debug" (e.g.
# src/propose/mod.rs's `#[ignore = "slow: SCIP load ... in debug mode
# (~80s)..."]`, a pure cost gate with no defect in it) and false-flagged a
# clean ignore reason as parking a bug.
rel ignore_hiding_bug(file: file, line: int).
ignore_hiding_bug(f, l) <- scan("WORK", "tests/**/*.rs", f, rev),
    match_line(f, rev, /#\[ignore[^\]]*(\bbug\b|blocked|broken|fails until|unfixed|FIXME|TODO)/, l).
ignore_hiding_bug(f, l) <- scan("WORK", "src/**/*.rs", f, rev),
    match_line(f, rev, /#\[ignore[^\]]*(\bbug\b|blocked|broken|fails until|unfixed|FIXME|TODO)/, l).

# ── Ratchet baselines (mirrors no-new-eprintln.dl and composite-key-string.dl) ─
# Measured 2026-07-20 on WORK, the day this rail was written: 50 findings over
# the tree the audit covered (39 silent skips, 8 assert-nothing tests, 3
# #[ignore]s parking a defect). Every one is PRE-EXISTING — this rail landed
# after them and none was introduced by the session that built it.
#
# They are grandfathered per file, NOT waived. Each row is a debt with a name.
# A file over its baseline errors at file-head; a file with NO baseline row
# errors per hit line, so a brand-new false green still blocks a commit on day
# one. Lower a row when a commit shrinks the count; delete rows that reach 0.
# Rows only ever go down. Raising one is the defect this rail exists to stop.
#
# The 39 silent skips were one shape: an early exit on a missing external tool
# (rust-analyzer, a language toolchain, a vendored corpus) with no #[ignore].
# `oracle_go.rs`/`oracle_ts.rs` module docs used to call this INTENTIONAL; the
# documented rationale WAS the anti-pattern, because a run that skips them
# counted them as coverage. The fix, `#[ignore = "<the tool it needs>"]`,
# reports them as excluded instead. Landed 2026-07-20 for every tests/it/ site
# (16 files, 35 sites) plus the 2 tests/it/ assert-nothing sites
# (call_golden.rs, family_scaling_probe.rs); the src/** sites and
# tests/it/daemon.rs were out of scope for that pass and stayed grandfathered.
# Tracked in plans/2026-07-20-test-audit.md.
#
# 2026-07-20 PM: drove the src/** sites and the stale retraction_props.rs
# ignore_bug row to zero (fixed the test in each case rather than gutting an
# assertion): src/parse/mod.rs's two `return;`s replaced with a found-flag +
# `break` + trailing `assert!`; src/propose/mod.rs's SCIP-load-miss `return;`
# now panics with the fix command (the test stays #[ignore]d for cost, but a
# deliberate --ignored run without the index fails loudly instead of reporting
# a false PASS); src/daemon/mod.rs's and src/trace.rs's "must not panic" tests
# now assert observable state (`tracing::dispatcher::has_been_set()` /
# `CHROME_GUARD` slot) instead of asserting nothing. Remaining rows are
# grandfathered, not fixed, for two DIFFERENT reasons:
#   - tests/it/daemon.rs silent_skip (1 row, line 286): the `bare_return_line`
#     match_ast pattern "return;" also matches "return true;" (verified: an
#     ast-grep probe over a 2-statement fn matched both), so this is a rail
#     false positive on `wait_up`'s polling-loop `return true;`, not an actual
#     skip — the real assertion runs after the loop. Not touched here: fixing
#     the pattern is a repo-wide match_ast change outside this pass's scope.
#   - tests/it/daemon.rs ignore_bug (1 row, line 1038): genuinely names an
#     unbuilt feature (`linux_inotify_watch_count_tracks_unignored` is its own
#     spec for Linux per-directory watch pruning, which has not landed).
#   - of the four asserts_nothing rows, the two src/engine/** ones
#     (ownership.rs, pipeline/stage.rs) were driven to 0 on 2026-07-21 and
#     their baseline rows removed; the two src/graph/typegraph/** ones
#     (go.rs:1185, ts/flow.rs:920) stay grandfathered pending the concurrent
#     symbol-dict rewrite that owns those files.

rel silent_skip_count(file: file, hits: int).
silent_skip_count(f, count(line)) <- silent_skip_finding(f, line).

rel silent_skip_baseline(file: file, allowed: int).
silent_skip_baseline("tests/it/daemon.rs", 1).

rel asserts_nothing_count(file: file, hits: int).
asserts_nothing_count(f, count(line)) <- asserts_nothing_finding(f, line).

rel asserts_nothing_baseline(file: file, allowed: int).
# ownership.rs + pipeline/stage.rs driven to 0 (2026-07-21): stage.rs's
# transition test now asserts the intent survives the full typestate chain;
# ownership.rs:324 asserted only through the `assert_delta_plan_is_bounded`
# helper (invisible to this rail's in-span assert scan) and now carries a
# direct non-empty guard so an empty EXPLAIN cannot pass vacuously. Rows
# removed, not lowered — a regression in either file re-blocks per-hit.
asserts_nothing_baseline("src/graph/typegraph/go.rs", 1).
asserts_nothing_baseline("src/graph/typegraph/ts/flow.rs", 1).

rel ignore_bug_count(file: file, hits: int).
ignore_bug_count(f, count(line)) <- ignore_hiding_bug(f, line).

rel ignore_bug_baseline(file: file, allowed: int).
ignore_bug_baseline("tests/it/daemon.rs", 1).

# --- diagnostics: over baseline, or no baseline at all ------------------------
diag(path: f, line: 1, severity: "error", code: "test-silent-skip-exceeded",
     msg: "bare `return;` skip paths inside #[test] bodies grew past this file's grandfathered baseline — a test must assert on every path. Assert the precondition, or move the test behind #[ignore] with the environmental need named") <-
    silent_skip_count(f, hits), silent_skip_baseline(f, allowed), hits > allowed.

diag(path: f, line: l, severity: "error", code: "test-silent-skip",
     msg: "bare `return;` inside a #[test] body — a path that exits reporting PASS without reaching the assertions. Assert the precondition instead, or move the test behind #[ignore] with the environmental need named") <-
    silent_skip_finding(f, l), !silent_skip_baseline(f, _).

diag(path: f, line: 1, severity: "error", code: "test-asserts-nothing-exceeded",
     msg: "#[test] bodies with no assertion grew past this file's grandfathered baseline — a test that cannot fail is not a test") <-
    asserts_nothing_count(f, hits), asserts_nothing_baseline(f, allowed), hits > allowed.

diag(path: f, line: s, severity: "error", code: "test-asserts-nothing",
     msg: "#[test] body contains no assert!/assert_eq!/panic!/unwrap/expect and is not #[should_panic] — it cannot fail, so it is not a test") <-
    asserts_nothing_finding(f, s), !asserts_nothing_baseline(f, _).

diag(path: f, line: 1, severity: "error", code: "ignore-parks-a-bug-exceeded",
     msg: "#[ignore]s naming an unfixed defect grew past this file's grandfathered baseline — fix the bug, or file it and cite the issue in the reason") <-
    ignore_bug_count(f, hits), ignore_bug_baseline(f, allowed), hits > allowed.

diag(path: f, line: l, severity: "error", code: "ignore-parks-a-bug",
     msg: "#[ignore] reason names an unfixed defect rather than an environmental need — the bug went quiet instead of getting fixed. Fix it, or file it and cite the issue in the reason") <-
    ignore_hiding_bug(f, l), !ignore_bug_baseline(f, _).

diag_stage("test-silent-skip", "commit").
diag_stage("test-silent-skip-exceeded", "commit").
diag_stage("test-asserts-nothing", "commit").
diag_stage("test-asserts-nothing-exceeded", "commit").
diag_stage("ignore-parks-a-bug", "commit").
diag_stage("ignore-parks-a-bug-exceeded", "commit").

? diag(path, line, severity, code, msg).
