  src/lib.rs :: NAME = evaluate
  src/lib.rs :: NAME = greet
  src/lib.rs :: NAME = lex
  src/lib.rs :: NAME = login
  src/lib.rs :: NAME = logout
  src/lib.rs :: NAME = parse
  src/lib.rs :: NAME = to_u32
tag_alias:
  charts/app/values.yaml :: VER = 3.5.0
  deploy/config.yaml :: VER = 3.5.0
  packages/auth/values.yaml :: VER = 1.0.0
ts_files:
  src/handlers/api.ts :: NAME = express
  src/handlers/api.ts :: PATH = express
  src/hooks/UserPanel.tsx :: NAME = { useUserQuery }
  src/hooks/UserPanel.tsx :: PATH = ./queries
workspace_member:
  Cargo.toml :: MEMBER = crates/alpha
  Cargo.toml :: MEMBER = crates/beta
  Cargo.toml :: MEMBER = crates/gamma
