  config.json :: PORT = 8443
  config.json :: PROTO = https
react_hook:
  src/hooks/UserPanel.tsx :: ARGS = { id: 1 }
  src/hooks/UserPanel.tsx :: ENTITY = User
readme_code_langs:
  README.md :: LANG = bash
  README.md :: LANG = rust
readme_deps:
  README.md :: ITEM = express
  README.md :: ITEM = lodash
readme_links:
  README.md :: TEXT = docs
  README.md :: TEXT = source
  README.md :: URL = https://example.com
  README.md :: URL = https://github.com/x
readme_sections:
  README.md :: SECTION = Dependencies
  README.md :: SECTION = Installation
  README.md :: SECTION = Usage
ref_no_block:
  package.json :: VERSION = 2.1.0
ref_with_block:
  package.json :: DEP = @myorg/utils
  package.json :: DEP = express
  package.json :: DEP = lodash
  package.json :: SPEC = 4.17.21
  package.json :: SPEC = 4.18.2
  package.json :: SPEC = ^1.0.0
region_fns:
  src/lib.rs :: NAME = login
  src/lib.rs :: NAME = logout
release_config:
  deploy/config.yaml :: VER = 3.5.0
rust_fn:
  src/lib.rs :: ARGS = name: &str
  src/lib.rs :: BODY = 42
  src/lib.rs :: BODY = format!("hi {}", name)
  src/lib.rs :: NAME = greet
  src/lib.rs :: NAME = to_u32
  src/lib.rs :: RET = String
  src/lib.rs :: RET = u32
scoped_deep:
