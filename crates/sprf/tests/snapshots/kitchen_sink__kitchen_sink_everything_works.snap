---
source: crates/sprf/tests/kitchen_sink.rs
expression: out
---
all_keys:
  data.json :: KEY = alpha
  data.json :: KEY = beta
  data.json :: KEY = gamma
  data.json :: VAL = one
  data.json :: VAL = three
  data.json :: VAL = two
any_object: (no refs)
bare_glob_rule:
  Makefile :: INCLUDE = build/rules.mk
  Makefile :: INCLUDE = common.mk
branch_alias:
  charts/app/values.yaml :: VER = 3.5.0
  deploy/config.yaml :: VER = 3.5.0
  packages/auth/values.yaml :: VER = 1.0.0
branched:
  deploy/deploy.yaml :: PROD = myorg/api-service
  deploy/deploy.yaml :: REPO = myorg/auth-service scan=repo
cargo_lock_pkg:
  Cargo.lock :: NAME = anyhow
  Cargo.lock :: NAME = fixture-app
  Cargo.lock :: NAME = pin-project-lite
  Cargo.lock :: NAME = serde
  Cargo.lock :: NAME = tokio
  Cargo.lock :: VERSION = 0.1.0
  Cargo.lock :: VERSION = 0.2.13
  Cargo.lock :: VERSION = 1.0.197
  Cargo.lock :: VERSION = 1.0.81
  Cargo.lock :: VERSION = 1.36.0
dep_name:
  Cargo.toml :: NAME = anyhow
  Cargo.toml :: NAME = insta
  Cargo.toml :: NAME = serde
  Cargo.toml :: NAME = tokio
dep_source:
