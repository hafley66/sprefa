  src/lib.rs :: NAME = evaluate
  src/lib.rs :: NAME = greet
  src/lib.rs :: NAME = lex
  src/lib.rs :: NAME = login
  src/lib.rs :: NAME = logout
  src/lib.rs :: NAME = parse
