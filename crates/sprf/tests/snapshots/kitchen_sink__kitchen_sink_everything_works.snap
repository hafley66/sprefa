  app/Dockerfile :: STAGE = builder
dockerfile_from:
  app/Dockerfile :: IMAGE = nginx
  app/Dockerfile :: IMAGE = node
  app/Dockerfile :: TAG = 1.25-alpine
  app/Dockerfile :: TAG = 20-alpine AS builder
env_var_ref:
  src/handlers/api.ts :: NAME = API_KEY
  src/handlers/api.ts :: NAME = DATABASE_URL
file_tag:
  README.md :: TITLE = fixture-app
folder_tag:
  src/components/widget/index.ts :: NAME = WIDGET_NAME
  src/components/widget/index.ts :: VAL = widget
go_mod_dep:
  services/api/go.mod :: MODULE = github.com/gin-gonic/gin
  services/api/go.mod :: MODULE = github.com/go-playground/validator/v10
  services/api/go.mod :: MODULE = golang.org/x/net
  services/api/go.mod :: VERSION = v0.17.0
  services/api/go.mod :: VERSION = v1.9.1
  services/api/go.mod :: VERSION = v10.14.0
inline_scan:
  deploy/services.yaml :: REPO = myorg/auth-service scan=repo
  deploy/services.yaml :: TAG = v1.2.3 scan=rev
inline_scan_norm_inline:
  deploy/services.yaml :: REPO = myorg/auth-service scan=repo.norm
  deploy/services.yaml :: TAG = v1.2.3 scan=rev.norm
inline_scan_norm_tag:
  deploy/services.yaml :: REPO = myorg/auth-service scan=repo.norm
  deploy/services.yaml :: TAG = v1.2.3 scan=rev.norm
install_cmds:
  README.md :: PKG = express
  README.md :: PKG = lodash
level0:
  deploy/deploy.yaml :: REPO = myorg/api-service
  deploy/deploy.yaml :: TAG = v3.1.0
level1:
  package.json :: DEP = @myorg/utils
  package.json :: DEP = express
  package.json :: DEP = lodash
  package.json :: SPEC = 4.17.21
  package.json :: SPEC = 4.18.2
  package.json :: SPEC = ^1.0.0
level2: (no refs)
line_regex:
  app/Dockerfile :: IMAGE = nginx
  app/Dockerfile :: IMAGE = node
  app/Dockerfile :: TAG = 1.25-alpine
  app/Dockerfile :: TAG = 20-alpine
multi_seg:
  app/Dockerfile :: DEST = .
  app/Dockerfile :: SRC = .
npm_lock_resolved:
  package-lock.json :: PKG_PATH = node_modules/express
  package-lock.json :: PKG_PATH = node_modules/lodash
  package-lock.json :: URL = https://registry.npmjs.org/express/-/express-4.18.2.tgz
  package-lock.json :: URL = https://registry.npmjs.org/lodash/-/lodash-4.17.21.tgz
  package-lock.json :: VERSION = 4.17.21
  package-lock.json :: VERSION = 4.18.2
package_name:
  Cargo.toml :: NAME = fixture-app
py_requirement:
