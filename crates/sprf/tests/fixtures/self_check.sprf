# self_check.sprf -- dogfooding: ensure README stays in sync with source code
#
# Sources of truth:
#   sprf-lsp TAGS constant   ->  which tags the LSP completes (includes aliases)
#   cli/src/main.rs           ->  which CLI subcommands exist
#   Cargo.toml workspace      ->  which crates exist
#   README.md                 ->  what is documented
#
# Run: sprefa eval -f self_check.sprf

# ════════════════════════════════════════════════════════
# 1. Tags the LSP completes (source of truth, includes aliases)
# ════════════════════════════════════════════════════════

rule(lsp_tag) {
  fs(crates/sprf-lsp/src/main.rs) > ast[rust](("$TAG", $$$_)) > line(re:$TAG)
};

# ════════════════════════════════════════════════════════
# 2. Tags documented in README selector tags table
# ════════════════════════════════════════════════════════

rule(readme_tag) {
  fs(**/README.md) > md(### Selector tags) > line(re:`$TAG\()
};

# ════════════════════════════════════════════════════════
# 3. CLI subcommands defined in code  
# ════════════════════════════════════════════════════════

# Match known CLI subcommand names at enum variant position
# Looking for "    Name," or "    Name {" patterns
rule(code_cmd) {
  fs(crates/cli/src/main.rs) > line(re:Init,) > line(Init)
};

rule(code_cmd) {
  fs(crates/cli/src/main.rs) > line(re:Add\s*\{) > line(Add)
};

rule(code_cmd) {
  fs(crates/cli/src/main.rs) > line(re:Scan\s*\{) > line(Scan)
};

rule(code_cmd) {
  fs(crates/cli/src/main.rs) > line(re:Query\s*\{) > line(Query)
};

rule(code_cmd) {
  fs(crates/cli/src/main.rs) > line(re:Status,) > line(Status)
};

rule(code_cmd) {
  fs(crates/cli/src/main.rs) > line(re:Serve,) > line(Serve)
};

rule(code_cmd) {
  fs(crates/cli/src/main.rs) > line(re:Watch\s*\{) > line(Watch)
};

rule(code_cmd) {
  fs(crates/cli/src/main.rs) > line(re:Sql\s*\{) > line(Sql)
};

rule(code_cmd) {
  fs(crates/cli/src/main.rs) > line(re:Reset,) > line(Reset)
};

rule(code_cmd) {
  fs(crates/cli/src/main.rs) > line(re:Config,) > line(Config)
};

rule(code_cmd) {
  fs(crates/cli/src/main.rs) > line(re:Eval\s*\{) > line(Eval)
};

rule(code_cmd) {
  fs(crates/cli/src/main.rs) > line(re:Check\s*\{) > line(Check)
};

rule(code_cmd) {
  fs(crates/cli/src/main.rs) > line(re:Daemon\s*\{) > line(Daemon)
};

# ════════════════════════════════════════════════════════
# 4. CLI subcommands documented in README
# ════════════════════════════════════════════════════════

rule(readme_cmd) {
  fs(**/README.md) > md(## CLI reference) > line(re:sprefa $CMD)
};

# ════════════════════════════════════════════════════════
# 5. Workspace crates
# ════════════════════════════════════════════════════════

rule(workspace_crate) {
  fs(Cargo.toml) > line(re:crates/$CRATE)
};

rule(readme_crate) {
  fs(**/README.md) > md(## Workspace) > line(re:$CRATE/)
};

# ════════════════════════════════════════════════════════
# Checks: cross-reference code vs README
# ════════════════════════════════════════════════════════

check(tag_missing_from_readme) {
  SELECT lt.tag_str
  FROM self_check__lsp_tag_data lt
  LEFT JOIN self_check__readme_tag_data rt ON rt.tag_str = lt.tag_str
  WHERE rt.tag_str IS NULL
};

check(cmd_missing_from_readme) {
  SELECT cc.cmd_str
  FROM self_check__code_cmd_data cc
  LEFT JOIN self_check__readme_cmd_data rc ON rc.cmd_str = cc.cmd_str
  WHERE rc.cmd_str IS NULL
};

check(crate_missing_from_readme) {
  SELECT wc.crate_str
  FROM self_check__workspace_crate_data wc
  LEFT JOIN self_check__readme_crate_data rc ON rc.crate_str = wc.crate_str
  WHERE rc.crate_str IS NULL
};
