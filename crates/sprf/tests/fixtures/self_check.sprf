# self_check.sprf -- dogfooding: ensure README stays in sync with source code
#
# Sources of truth:
#   sprf-lsp TAGS constant   ->  which tags the LSP completes (includes aliases)
#   cli/src/main.rs           ->  which CLI subcommands exist
#   Cargo.toml workspace      ->  which crates exist
#   README.md                 ->  what is documented

# ════════════════════════════════════════════════════════
# 1. LSP tags from sprf-lsp source
# ════════════════════════════════════════════════════════

rule(lsp_tag) {
  fs(crates/sprf-lsp/src/main.rs) > line(re:"$TAG",)
};

# ════════════════════════════════════════════════════════
# 2. Tags documented in README
# ════════════════════════════════════════════════════════

rule(readme_tag) {
  fs(**/README.md) > line(re:`$TAG\()
};

# ════════════════════════════════════════════════════════
# 3. CLI subcommands from source code (enum variants)
# ════════════════════════════════════════════════════════

rule(code_cmd) {
  fs(crates/cli/src/main.rs) > line(re:^    $CMD[,\{])
};

# ════════════════════════════════════════════════════════
# 4. CLI commands documented in README
# ════════════════════════════════════════════════════════

rule(readme_cmd) {
  fs(**/README.md) > line(re:sprefa\s+$CMD)
};

# ════════════════════════════════════════════════════════
# 5. Workspace crates from root Cargo.toml
# ════════════════════════════════════════════════════════

rule(workspace_crate) {
  fs(Cargo.toml) > line(re:crates/$CRATE)
};

# ════════════════════════════════════════════════════════
# 6. Crates documented in README
# ════════════════════════════════════════════════════════

rule(readme_crate) {
  fs(**/README.md) > line(re:$CRATE/)
};

# ════════════════════════════════════════════════════════
# Checks: cross-reference code vs README
# ════════════════════════════════════════════════════════

check(tag_missing_from_readme) {
  SELECT lt.tag_str
  FROM self_check__lsp_tag_data lt
  LEFT JOIN self_check__readme_tag_data rt ON rt.tag_str = lt.tag_str
  WHERE rt.tag_str IS NULL
};

check(cmd_missing_from_readme) {
  SELECT cc.cmd_str
  FROM self_check__code_cmd_data cc
  LEFT JOIN self_check__readme_cmd_data rc ON rc.cmd_str = cc.cmd_str
  WHERE rc.cmd_str IS NULL
    AND cc.cmd_str != 'BranchScope'
};

check(crate_missing_from_readme) {
  SELECT wc.crate_str
  FROM self_check__workspace_crate_data wc
  LEFT JOIN self_check__readme_crate_data rc ON rc.crate_str = wc.crate_str
  WHERE rc.crate_str IS NULL
};
