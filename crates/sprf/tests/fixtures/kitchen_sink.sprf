# kitchen_sink.sprf -- THE KITCHEN SINK
# 
# This single file exercises EVERY parser feature, every matcher, every emit pattern.
# If this file doesn't parse, lower, walk, and extract correctly, the system is BROKEN.
# E2E means: sprf -> SQL refs. Rust is just orchestrating.
#
# ═══════════════════════════════════════════════════════════════════════════════════════

# ════════════════════════════════════════════════════════
# SECTION 1: Basic mechanics (fs, json, flat chains)
# ════════════════════════════════════════════════════════

rule(package_name) {
  fs(**/Cargo.toml) > json({ package: { name: $NAME } })
};

rule(dep_name) {
  fs(**/Cargo.toml) > json({ re:^(dev-)?dependencies: { $NAME: $_ } })
};

rule(workspace_member) {
  fs(**/Cargo.toml) > json({ workspace: { members: [...$MEMBER] } })
};

# ════════════════════════════════════════════════════════
# SECTION 2: Recursive descent and deep nesting
# ════════════════════════════════════════════════════════

rule(deploy_image) {
  fs(**/values.yaml) > json({ **: { image: { repository: $REPO, tag: $TAG } } })
};

rule(deploy_values) {
  fs(**/values.yaml) > json({ **: $VAL })
};

# ════════════════════════════════════════════════════════
# SECTION 3: Scoped blocks (repo > rev > folder > fs)
# ════════════════════════════════════════════════════════

rule(scoped_deep) {
  repo($REPO) {
    rev(main) {
      folder(packages/$PKG) {
        fs(values.yaml) > json({ name: $NAME })
      }
    }
  }
};

rule(branch_alias) {
  repo(myorg/*) {
    branch(main|develop) {
      fs(**/*.yaml) > json({ version: $VER })
    }
  }
};

rule(tag_alias) {
  repo(myorg/*) {
    tag(v*) {
      fs(**/*.yaml) > json({ version: $VER })
    }
  }
};

# ════════════════════════════════════════════════════════
# SECTION 4: file() and folder() tags
# ════════════════════════════════════════════════════════

rule(file_tag) {
  file(**/README.md) > md(# $TITLE)
};

rule(folder_tag) {
  folder(src/components/*) {
    fs(index.ts) > line(re:export const $NAME = "$VAL")
  }
};

# ════════════════════════════════════════════════════════
# SECTION 5: Cross-rule references (DAG chains)
# ════════════════════════════════════════════════════════

rule(ref_no_block) {
  deploy_image(repo: $REPO, tag: $TAG)
  fs(**/package.json) > json({ version: $VERSION })
};

rule(ref_with_block) {
  deploy_image(repo: $REPO, tag: $TAG) {
    fs(**/package.json) > json({ dependencies: { $DEP: $SPEC } })
  }
};

# ════════════════════════════════════════════════════════
# SECTION 6: Monomorphization (semicolon branches)
# ════════════════════════════════════════════════════════

rule(branched) {
  repo($REPO) {
    rev(main) > fs(**/deploy.yaml) > json({ image: { repository: $PROD } });
    rev(staging) > fs(**/deploy.yaml) > json({ image: { repository: $STAGE } })
  }
};

# ════════════════════════════════════════════════════════
# SECTION 7: Rule union (same name, multiple definitions)
# ════════════════════════════════════════════════════════

rule(dep_source) {
  fs(**/package.json) > json({ dependencies: { $DEP: $_ } })
};

rule(dep_source) {
  fs(**/Cargo.toml) > json({ dependencies: { $DEP: $_ } })
};

# ════════════════════════════════════════════════════════
# SECTION 8: AST matching with patterns
# ════════════════════════════════════════════════════════

rule(env_var_ref) {
  fs(**/*.ts) > ast(process.env.$NAME)
};

rule(rust_fn) {
  fs(**/*.rs) > ast[rust](fn $NAME($$$ARGS) -> $RET { $$$BODY })
};

rule(react_hook) {
  fs(**/*.tsx) > ast[tsx](use${ENTITY}Query($$$ARGS))
};

# ════════════════════════════════════════════════════════
# SECTION 9: line() matcher with segment captures
# ════════════════════════════════════════════════════════

rule(dockerfile_from) {
  fs(**/Dockerfile) > line(FROM $IMAGE:$TAG)
};

rule(line_regex) {
  fs(**/Dockerfile) > line(re:FROM\s+$IMAGE:$TAG)
};

rule(docker_from_stage) {
  fs(**/Dockerfile) > line(FROM $IMAGE AS $STAGE)
};

rule(multi_seg) {
  fs(**/Dockerfile) > line(COPY $$$SRC $DEST)
};

# ════════════════════════════════════════════════════════
# SECTION 10: Glob alternation
# ════════════════════════════════════════════════════════

rule(ts_files) {
  fs(**/*.ts|**/*.tsx) > ast(import $NAME from "$PATH")
};

rule(release_config) {
  repo(myorg/*) {
    rev(main|release/*) {
      fs(**/config.yaml) > json({ version: $VER })
    }
  }
};

# ════════════════════════════════════════════════════════
# SECTION 11: Scan annotations (repo/rev wrappers)
# ════════════════════════════════════════════════════════

rule(inline_scan) {
  fs(**/services.yaml) > json({ image: { repository: repo($REPO), tag: rev($TAG) } })
};

rule(inline_scan_norm_tag) {
  repo.norm($REPO) {
    rev.norm($TAG) {
      fs(**/services.yaml) > json({ image: { repository: $REPO, tag: $TAG } })
    }
  }
};

rule(inline_scan_norm_inline) {
  fs(**/services.yaml) > json({ image: { repository: repo.norm($REPO), tag: rev.norm($TAG) } })
};

# ════════════════════════════════════════════════════════
# SECTION 12: Quoted patterns and scoped packages
# ════════════════════════════════════════════════════════

rule(quoted_val) {
  fs(**/config.json) > json({ endpoint: "$PROTO://$HOST:$PORT" })
};

rule(scoped_pkg) {
  fs(**/package.json) > json({ dependencies: { "@$SCOPE/$NAME": $_ } })
};

rule(all_keys) {
  fs(**/data.json) > json({ $KEY: $VAL })
};

# ════════════════════════════════════════════════════════
# SECTION 13: 3-level DAG chain (level0 -> level1 -> level2)
# ════════════════════════════════════════════════════════

rule(level0) {
  fs(**/deploy.yaml) > json({ image: { repository: $REPO, tag: $TAG } })
};

rule(level1) {
  level0(repo: $REPO, tag: $TAG) {
    fs(**/package.json) > json({ dependencies: { $DEP: $SPEC } })
  }
};

rule(level2) {
  fs(**/resolved.lock) > line(re:(?P<DEP>[a-z]+)\s+resolved\s+[^#]+#(?P<PINNED_REV>[a-f0-9]+))
};

# ════════════════════════════════════════════════════════
# SECTION 14: Check blocks with SQL
# ════════════════════════════════════════════════════════

check(version_drift) {
  SELECT s_repo.value as repo, s_tag.value as tag
  FROM deploy_image ds
  JOIN strings s_repo ON s_repo.id = ds.repo_ref
  JOIN strings s_tag ON s_tag.id = ds.tag_ref
  WHERE s_tag.value LIKE 'latest%'
};

check(orphan_dep) {
  SELECT s.value as dep
  FROM dep_source ds
  JOIN strings s ON s.id = ds.dep_ref
  LEFT JOIN package_name pn ON pn.name_ref = ds.dep_ref
  WHERE pn.name_ref IS NULL
};

# ════════════════════════════════════════════════════════
# SECTION 15: Bare glob (no tag)
# ════════════════════════════════════════════════════════

rule(bare_glob_rule) {
  **/Makefile > line(re:include\s+$INCLUDE)
};

# ════════════════════════════════════════════════════════
# SECTION 16: Vacuous/empty matches
# ════════════════════════════════════════════════════════

rule(any_object) {
  fs(**/has_empty.json) > json({ $KEY: {} })
};

# ════════════════════════════════════════════════════════
# SECTION 17: Lockfile patterns
# ════════════════════════════════════════════════════════

rule(npm_lock_resolved) {
  fs(**/package-lock.json) > json({ packages: { $PKG_PATH: { version: $VERSION, resolved: $URL } } })
};

rule(cargo_lock_pkg) {
  fs(**/Cargo.lock) > json({ package: [...{ name: $NAME, version: $VERSION }] })
};

rule(go_mod_dep) {
  fs(**/go.mod) > line(re:\t$MODULE $VERSION)
};

rule(py_requirement) {
  fs(**/requirements.txt) > line($PACKAGE==$VERSION)
};

# ════════════════════════════════════════════════════════
# SECTION 18: marker() regions
# ════════════════════════════════════════════════════════

rule(section_fns) {
  fs(**/*.rs) > marker("SECTION:") > line(re:fn\s+$NAME)
};

rule(region_fns) {
  fs(**/*.rs) > marker("BEGIN:", "END:") > line(re:fn\s+$NAME)
};

rule(section_block) {
  fs(**/*.rs) {
    marker("SECTION:") {
      line(re:fn\s+$NAME)
    }
  }
};

# ════════════════════════════════════════════════════════
# SECTION 19: Markdown matchers
# ════════════════════════════════════════════════════════

rule(readme_sections) {
  fs(**/*.md) > md(## $SECTION)
};

rule(readme_deps) {
  fs(**/*.md) > md(## Dependencies) > md(- $ITEM)
};

rule(readme_links) {
  fs(**/*.md) > md([$TEXT]($URL))
};

rule(readme_code_langs) {
  fs(**/*.md) > md(```$LANG)
};

rule(install_cmds) {
  fs(**/*.md) > md(## Installation) > line(re:npm install $PKG)
};

# ════════════════════════════════════════════════════════
# SECTION 20: TypeScript / tsconfig paths
# ════════════════════════════════════════════════════════

rule(tsconfig_paths) {
  fs(**/tsconfig.json) > json({ compilerOptions: { paths: { "$ALIAS": [...$TARGET] } } })
};

# ════════════════════════════════════════════════════════
# SECTION 21: Package.json exports
# ════════════════════════════════════════════════════════

rule(package_exports) {
  fs(**/package.json) > json({ exports: { $EXPORT_PATH: { $EXPORT_KEY: $EXPORT_VAL } } })
};

# ════════════════════════════════════════════════════════
# SECTION 22: K8s ConfigMap environment variables
# ════════════════════════════════════════════════════════

rule(k8s_configmap_envs) {
  fs(**/*configmap*.yaml) > json({ data: { $ENV_KEY: $ENV_VAL } })
};

# ════════════════════════════════════════════════════════
# SECTION 23: Docker Compose services
# ════════════════════════════════════════════════════════

rule(docker_compose_services) {
  fs(**/docker-compose.yaml|**/docker-compose.yml) > json({ services: { $SERVICE_NAME: { $SERVICE_KEY: $SERVICE_VAL } } })
};

# ════════════════════════════════════════════════════════
# SECTION 24: OpenAPI operations
# ════════════════════════════════════════════════════════

rule(openapi_operations) {
  fs(**/openapi.yaml|**/openapi.json) > json({ paths: { $API_PATH: { $METHOD: { operationId: $OP_ID } } } })
};

# ════════════════════════════════════════════════════════
# SECTION 25: PNPM workspace
# ════════════════════════════════════════════════════════

rule(pnpm_workspace) {
  fs(**/pnpm-workspace.yaml) > json({ packages: [...$PKG] })
};

# ════════════════════════════════════════════════════════
# SECTION 26: Cargo workspace members (from TOML)
# ════════════════════════════════════════════════════════

rule(cargo_workspace_members) {
  fs(**/Cargo.toml) > json({ workspace: { members: [...$MEMBER] } })
};

# ════════════════════════════════════════════════════════
# SECTION 27: Array iteration patterns
# ════════════════════════════════════════════════════════

rule(array_deps) {
  fs(**/package.json) > json({ bundles: [...$BUNDLE] })
};

# ════════════════════════════════════════════════════════
# SECTION 28: Depth-constrained patterns
# ════════════════════════════════════════════════════════

rule(deep_values) {
  fs(**/data.json) > json({ **: { $KEY: $VAL } })
};
