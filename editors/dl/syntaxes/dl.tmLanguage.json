{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "dl",
  "scopeName": "source.dl",
  "patterns": [
    { "include": "#comment" },
    { "include": "#declaration" },
    { "include": "#query" },
    { "include": "#arrow" },
    { "include": "#op" },
    { "include": "#builtin-rel" },
    { "include": "#regex" },
    { "include": "#scheme-literal" },
    { "include": "#string" },
    { "include": "#hole" },
    { "include": "#type" },
    { "include": "#number" },
    { "include": "#operator" }
  ],
  "repository": {
    "comment": {
      "match": "#.*$",
      "name": "comment.line.number-sign.dl"
    },

    "declaration": {
      "match": "^\\s*(rel|check|rule)\\b",
      "captures": {
        "1": { "name": "keyword.control.declaration.dl" }
      }
    },

    "query": {
      "match": "^\\s*(\\?)",
      "captures": {
        "1": { "name": "keyword.control.query.dl" }
      }
    },

    "arrow": {
      "match": "<-",
      "name": "keyword.operator.rule.dl"
    },

    "op": {
      "match": "\\b(scan|match|ast|sg|json|jsonp|cmd|comment|gen|node|child|move|closure)\\s*(?=\\()",
      "name": "support.function.op.dl"
    },

    "builtin-rel": {
      "match": "\\b(file|module_edge|module_edge_rev|module_unresolved|module_unresolved_rev|crate_edge|type_edge|type_edge_rev|type_entity|type_sig|type_link|call_def|call_site|call_kind|call_name|df_node|loop_over|allocates|nest|doc_node|doc_ref|scip_def|scip_ref|scip_edge|string|ref|program|head|rev_advanced)\\b",
      "name": "support.type.builtin-relation.dl"
    },

    "regex": {
      "begin": "/",
      "end": "/",
      "name": "string.regexp.dl",
      "patterns": [
        { "match": "\\\\.", "name": "constant.character.escape.dl" },
        { "include": "#hole" }
      ]
    },

    "scheme-literal": {
      "match": "\\b([a-z][a-z0-9_]*):(`[^`]*`|[^\\s,()]+)",
      "captures": {
        "1": { "name": "entity.name.tag.scheme.dl" },
        "2": { "name": "string.unquoted.scheme-body.dl" }
      }
    },

    "string": {
      "patterns": [
        {
          "begin": "\"",
          "end": "\"",
          "name": "string.quoted.double.dl",
          "patterns": [
            { "match": "\\\\.", "name": "constant.character.escape.dl" },
            { "include": "#hole" }
          ]
        },
        {
          "begin": "`",
          "end": "`",
          "name": "string.quoted.raw.dl",
          "patterns": [
            { "include": "#hole" }
          ]
        }
      ]
    },

    "hole": {
      "begin": "\\$\\{",
      "end": "\\}",
      "name": "variable.other.interpolation.dl",
      "beginCaptures": { "0": { "name": "punctuation.definition.interpolation.begin.dl" } },
      "endCaptures": { "0": { "name": "punctuation.definition.interpolation.end.dl" } }
    },

    "type": {
      "match": ":\\s*(text|int|file|repo|rev|bool|float)\\b",
      "captures": {
        "1": { "name": "support.type.primitive.dl" }
      }
    },

    "number": {
      "match": "\\b\\d+(\\.\\d+)?\\b",
      "name": "constant.numeric.dl"
    },

    "operator": {
      "match": "!=|<=|>=|=|<|>|\\?",
      "name": "keyword.operator.comparison.dl"
    }
  }
}
