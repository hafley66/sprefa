{
  "name": "sprefa-dl",
  "displayName": "sprefa-dl",
  "description": "Syntax highlighting and language server for .dl rule programs (sprefa v5 engine).",
  "version": "0.1.0",
  "publisher": "sprefa",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages",
    "Linters"
  ],
  "activationEvents": [
    "onLanguage:dl"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "dl",
        "aliases": [
          "dl",
          "sprefa",
          "datalog-over-code"
        ],
        "extensions": [
          ".dl"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "dl",
        "scopeName": "source.dl",
        "path": "./syntaxes/dl.tmLanguage.json"
      }
    ],
    "configuration": {
      "type": "object",
      "title": "sprefa-dl",
      "properties": {
        "sprefa-dl.serverPath": {
          "type": "string",
          "default": "dl",
          "description": "Path to the dl binary. The engine runs as an LSP server via `dl --lsp`. Defaults to `dl` on PATH."
        },
        "sprefa-dl.root": {
          "type": "string",
          "default": "",
          "description": "Project root passed as --root. Empty = the first workspace folder."
        }
      }
    }
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.0"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "@types/vscode": "^1.75.0",
    "typescript": "^5.0.0"
  },
  "scripts": {
    "compile": "tsc -p .",
    "watch": "tsc -w -p ."
  }
}
