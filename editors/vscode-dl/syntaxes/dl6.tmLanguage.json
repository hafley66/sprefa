{
  "scopeName": "source.dl6",
  "name": "dl6",
  "comment": "GENERATED by v6/prolog/compile/1_emit_registry_docs.pl from registry.pl",
  "patterns": [{ "include": "#main" }],
  "repository": {
    "main": {
      "patterns": [
        { "include": "#comment" },
        { "include": "#template" },
        { "include": "#string" },
        { "include": "#atom" },
        { "include": "#number" },
        { "include": "#rule-arrow" },
        { "include": "#semicolon" },
        { "include": "#enum-shape" },
        { "include": "#decl-words" },
        { "include": "#live-keywords" },
        { "include": "#reserved-keywords" },
        { "include": "#relation-call" },
        { "include": "#operators" },
        { "include": "#variable" }
      ]
    },
    "comment": {
      "name": "comment.line.number-sign.dl6",
      "match": "#.*$"
    },
    "template": {
      "name": "string.quoted.template.dl6",
      "begin": "\\x60",
      "end": "\\x60",
      "patterns": [
        { "name": "constant.character.escape.dl6", "match": "\\." }
      ]
    },
    "string": {
      "name": "string.quoted.double.dl6",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        { "name": "constant.character.escape.dl6", "match": "\\." }
      ]
    },
    "atom": {
      "name": "constant.language.atom.dl6",
      "begin": "'",
      "end": "'",
      "patterns": [
        { "name": "constant.character.escape.dl6", "match": "\\." }
      ]
    },
    "number": {
      "name": "constant.numeric.dl6",
      "match": "-?(?:\\b\\d+\\.\\d*|\\B\\.\\d+|\\b\\d+)(?:[eE][+-]?\\d+)?\\b"
    },
    "rule-arrow": {
      "name": "keyword.operator.arrow.dl6",
      "match": "<-|<+|->"
    },
    "semicolon": {
      "name": "punctuation.separator.enum.dl6",
      "match": ";"
    },
    "enum-shape": {
      "name": "storage.type.enum.dl6",
      "match": "\\brel\\b(?=\\s+[a-z_]\\w*\\s*\\([^\\n]*;)"
    },
    "decl-words": {
      "name": "storage.type.declaration.dl6",
      "match": "\\b(rel|sh|bind|log|keep|key|int|float|bool|text|json|salt)\\b"
    },
    "live-keywords": {
      "name": "keyword.control.dl6",
      "match": "\\b(avg|bind_decl|coalesce|combine|count|decode|finalize|is|latest|match|max|min|next|not|now|probe|query|sh_decl|sum|true|ts_query)\\b"
    },
    "reserved-keywords": {
      "name": "invalid.illegal.reserved.dl6",
      "match": "\\b(complete|error|json_array|json_each|json_object|pre|set|sg_pattern|subscribe|unsubscribe|zip)\\b"
    },
    "relation-call": {
      "name": "entity.name.function.dl6",
      "match": "\\b[a-z_]\\w*(?=\\()"
    },
    "operators": {
      "name": "keyword.operator.comparison.dl6",
      "match": ":=|<=|!=|==|>=|=<|\\==|<|>"
    },
    "variable": {
      "patterns": [
        {
          "name": "variable.other.constant.dl6",
          "match": "\\b[A-Z_][A-Za-z0-9_]*\\b"
        },
        {
          "name": "variable.other.readwrite.dl6",
          "match": "\\b[a-z][A-Za-z0-9_]*\\b"
        }
      ]
    }
  }
}
