(files: (* (run: str) (list: any)))
(files "r" (vec "a" "bb" "ccc"))
(files "s" (vec 4 5))
(each: (* (run: str) (index: int) (item: any)))
(<- (each ?Run ?Index ?Item) (files ?Run ?List) (vec.iter ?List ?Index ?Item))
(size: (* (run: str) (len: int)))
(<- (size ?Run ?Len) (files ?Run ?List) (vec.len ?List ?Len))
(next_index: (* (run: str) (index: int)))
(<- (next_index ?Run ?Next) (each ?Run ?Index ?Item) (int.add ?Index 1 ?Next))
(small: (* (run: str) (index: int)))
(<- (small ?Run ?Index) (each ?Run ?Index ?Item) (int.lt ?Index 2))
(back: (* (run: str) (item: any)))
(<- (back ?Run ?Item) (next_index ?Run ?Next) (files ?Run ?List) (vec.get ?List ?Next ?Item))
(loose: (* (run: str) (n: int)))
(<- (loose ?Run ?Item) (each ?Run ?Index ?Item))
(loose "z" 7)
(counted: (* (run: str) (n: int)))
(<- (counted ?Run (count ?Index)) (each ?Run ?Index ?Item))
(summed: (* (run: str) (n: int)))
(<- (summed ?Run (sum ?Index)) (each ?Run ?Index ?Item))
(lowest: (* (run: str) (n: int)))
(<- (lowest ?Run (max ?Index)) (each ?Run ?Index ?Item))
(counter: (* (n: int)))
(counter 0)
(<- (counter ?Next) (counter ?N) (int.lt ?N 5) (int.add ?N 1 ?Next))
(pair: (* (a: int) (b: int)))
(<- (pair ?N ?N) (counter ?N))
(diag: (* (n: int)))
(<- (diag ?N) (pair ?N ?N) (not (small "r" ?N)))
(three: (* (n: int)))
(<- (three ?N) (counter ?N) (int.eq ?N 3))
(lens: (* (item: any) (n: int)))
(<- (lens ?Item ?N) (each "r" ?Index ?Item) (str.len ?Item ?N))
(texts: (* (n: int) (t: str)))
(<- (texts ?N ?T) (counter ?N) (int.to_str ?N ?T))
(anyint: (* (v: any)))
(<- (anyint ?N) (counter ?N))
(fixed: (* (n: int)))
(<- (fixed 42) (counter 3))
