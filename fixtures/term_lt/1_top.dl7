(: Score (* (: player str) (: points int)))

(Score "ann" 4)

(Score "bob" 10)

(Score "cy" 7)

(: Beaten (* (: player str)))

(<- (Beaten ?Player)
    (Score ?Player ?Points)
    (Score ?Other ?More)
    (any.lt ?Points ?More))

(: Top (* (: player str)))

(<- (Top ?Player)
    (Score ?Player ?Points)
    (not (Beaten ?Player)))
