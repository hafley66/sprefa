(: Name (* (: name str)))

(Name "ada")

(: Word (* (: word str)))

(Word "hello")

(: Greeting (* (: greeting str)))

(<- (Greeting ?Greeting)
    (Name ?Name)
    (str.cons "hi " ?Name ?Greeting))

(: Split (* (: head str) (: rest str)))

(<- (Split ?Head ?Rest)
    (Word ?Word)
    (str.cons ?Head ?Rest ?Word))

(: Empty (* (: empty str)))

(<- (Empty ?Empty)
    (str.nil ?Empty))
