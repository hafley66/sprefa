(: Node (* (: name str)))

(Node "a")

(Node "b")

(Node "c")

(Node "d")

(: Edge (* (: from str) (: to str)))

(Edge "a" "b")

(Edge "b" "c")

(Edge "d" "a")

(: Reach (* (: from str) (: to str)))

(<- (Reach ?From ?To)
    (Edge ?From ?To))

(<- (Reach ?From ?To)
    (Reach ?From ?Middle)
    (Edge ?Middle ?To))

(: Unreached (* (: name str)))

(<- (Unreached ?Name)
    (Node ?Name)
    (not (Reach "a" ?Name)))

(: OutDegree (* (: from str) (: count int)))

(<- (OutDegree ?From (count ?To))
    (Reach ?From ?To))

(: Farthest (* (: from str) (: to str)))

(<- (Farthest ?From (max ?To))
    (Reach ?From ?To))
