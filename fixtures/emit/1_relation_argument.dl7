(: Edge (* (: from str) (: to str)))
(: Tagged (* (: from str) (: to str)))
(: Path (* (: from str) (: to str)))
(: Key (* (: name str) (: options type) (: return type)))
(<- (Key ?Name ?Options ?Result) (intern Key (tuple ?Name ?Options) ?Result))
(<- (Key ?Name ?Options ?Result) (intern_snapshot Key ?Arguments ?Result) (tuple ?Name ?Options ?Arguments))
(Edge "a" "b")
(Edge "b" "c")
(<- (Tagged ?A ?B) (Edge ?A ?B) (tuple ?A ?B ?Args) (intern Key ?Args ?Id))
(<- (Path ?A ?B) (Tagged ?A ?B))
(<- (Path ?A ?C) (Path ?A ?B) (Edge ?B ?C))
