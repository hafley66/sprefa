; Every parent edge reachable from HEAD.
(git: (import "@std/git"))

(: Watch (* (: root str)))

(Watch "__ROOT__")

(: Edge
   (* (: sha str)
      (: parent str)))

(<- (Edge ?Sha ?Parent)
    (Watch ?Root)
    (git.history ?Root ?Sha ?Parent))

(: Failed (* (: message str)))

(<- (Failed ?Message)
    (Watch ?Root)
    (git.history_error ?Root ?Message))
