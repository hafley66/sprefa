; Every parent edge reachable from HEAD.
(git: (import "@std/git"))

(: Watch (* (: root text)))

(Watch "__ROOT__")

(: Edge
   (* (: sha text)
      (: parent text)))

(<- (Edge ?Sha ?Parent)
    (Watch ?Root)
    (git.history ?Root ?Sha ?Parent))

(: Failed (* (: message text)))

(<- (Failed ?Message)
    (Watch ?Root)
    (git.history_error ?Root ?Message))
