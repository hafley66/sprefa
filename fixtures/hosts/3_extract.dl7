; Three extract families over one root; each record is a row.
(: extract
   (* (: root str)
      (: family str)
      (: kind str)
      (: payload str)))

(: extract_error
   (* (: root str)
      (: family str)
      (: message str)))

(: Want
   (* (: root str)
      (: family str)))

(Want "__ROOT__" "type")

(Want "__ROOT__" "call")

(Want "__ROOT__" "diet_scip")

(: Fact
   (* (: family str)
      (: kind str)
      (: payload str)))

(<- (Fact ?Family ?Kind ?Payload)
    (Want ?Root ?Family)
    (extract ?Root ?Family ?Kind ?Payload))

(: Failed
   (* (: family str)
      (: message str)))

(<- (Failed ?Family ?Message)
    (Want ?Root ?Family)
    (extract_error ?Root ?Family ?Message))
