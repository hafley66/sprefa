; One url, fetched once; an answer lands as a row the reader joins like a fact.
(: fetch_json
   (* (: url str)
      (: body str)))

(: fetch_json_error
   (* (: url str)
      (: status int)
      (: message str)))

(: Watch (* (: url str)))

(Watch "__URL__")

(: Body
   (* (: url str)
      (: body str)))

(<- (Body ?Url ?Body)
    (Watch ?Url)
    (fetch_json ?Url ?Body))

(: Failed
   (* (: url str)
      (: status int)))

(<- (Failed ?Url ?Status)
    (Watch ?Url)
    (fetch_json_error ?Url ?Status ?Message))
