; The loaded `Todo` carries no source name, so the probe reaches it through the
; route that returns it.

(api: (import "@std/oai"))

(tsi: (import "@std/tsi"))

(api.document "todo.json")

(: TodoShape
   (* (: id tsi.string)
      (: title tsi.string)))

(: route_returns_todo
   (* (: path str)
      (: method any)))

(<- (asked ?ResponseType TodoShape)
    (api.route ?Path ?Method ?OperationId ?RequestType ?ResponseType))

(<- (route_returns_todo ?Path ?Method)
    (api.route ?Path ?Method ?OperationId ?RequestType ?ResponseType)
    (Extends ?ResponseType TodoShape ?Checked))
