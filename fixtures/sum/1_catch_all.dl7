(: Result
   (+ (: loading (*))
      (: next (* (: value str)))
      (: error (* (: message str)))
      (: complete (*))))
(: Event (* (: key str) (: result Result)))
(: Pending (* (: key str)))
(Pending "loading")
(: Raw (* (: key str) (: value str)))
(Raw "next" "v")
(: Failed (* (: key str) (: message str)))
(Failed "error" "oops")
(: Finished (* (: key str)))
(Finished "complete")
(<- (Event ?Key Result.loading) (Pending ?Key))
(<- (Event ?Key (Result.next ?Value)) (Raw ?Key ?Value))
(<- (Event ?Key (Result.error ?Message)) (Failed ?Key ?Message))
(<- (Event ?Key Result.complete) (Finished ?Key))
(: Seen (* (: key str)))
(<- (Seen ?Key) (Event ?Key ?R))
