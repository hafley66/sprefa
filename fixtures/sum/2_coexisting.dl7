(: Result
   (+ (: loading (*))
      (: next (* (: value str)))
      (: error (* (: message str)))
      (: complete (*))))
(: Event (* (: key str) (: result Result)))
(: Pending (* (: key str)))
(Pending "a")
(: Raw (* (: key str) (: value str)))
(Raw "a" "v")
(<- (Event ?Key Result.loading) (Pending ?Key))
(<- (Event ?Key (Result.next ?Value)) (Raw ?Key ?Value))
(: Loading (* (: key str)))
(<- (Loading ?Key) (Event ?Key Result.loading))
(: Value (* (: key str) (: value str)))
(<- (Value ?Key ?Value) (Event ?Key (Result.next ?Value)))
(: Both (* (: key str)))
(<- (Both ?Key) (Event ?Key Result.loading) (Event ?Key (Result.next ?Value)))
