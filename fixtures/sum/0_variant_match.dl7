(: Result
   (+ (: loading (*))
      (: next (* (: value str)))
      (: error (* (: message str)))
      (: complete (*))))
(: Event (* (: key str) (: result Result)))
(: Watch (* (: key str)))
(Watch "a")
(<- (Event ?Key Result.loading) (Watch ?Key))
(: Raw (* (: key str) (: value str)))
(Raw "a" "v")
(<- (Event ?Key (Result.next ?V)) (Raw ?Key ?V))
(: Loading (* (: key str)))
(<- (Loading ?Key) (Watch ?Key) (Event ?Key Result.loading))
(: Value (* (: key str) (: value str)))
(<- (Value ?Key ?V) (Watch ?Key) (Event ?Key (Result.next ?V)))
