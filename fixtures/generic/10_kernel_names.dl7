; Compiler-generated goals over a generic bind, a rule-built instance and its
; readback, a bound checked by `Extends`, and a partial application. No rule here
; calls a kernel or prelude relation by name.
(Box:
   (* (Item: type)
      (return:
         (* (item: Item)))))

(Product:
   (* (name: str)
      (count: int)))

(Wrapped: (Box str))

(boxable:
   (* (product: type)))

(boxable Product)

(boxed_column:
   (* (product: type)
      (name: any)
      (boxed: any)))

(<- (boxed_column
       ?Product
       ?Name
       (Box ?ColumnType))
    (boxable ?Product)
    (: ?Product ?Name ?ColumnType ?Position))

(box_item_type:
   (* (boxed: any)
      (item_type: type)))

(<- (box_item_type
       ?Boxed
       ?ItemType)
    (Box ?ItemType ?Boxed))

(Named:
