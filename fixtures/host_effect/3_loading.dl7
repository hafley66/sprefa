; Loading is an ordinary rule over effect; the pattern opens with
; intern_snapshot then tuple, the way Partial reads back in the prelude.
(: fetch_json
   (* (: url str)
      (: body str)))

(: Watch (* (: url str)))

(Watch "https://a")

(Watch "https://b")

(: Body
   (* (: url str)
      (: body str)))

(<- (Body ?Url ?Body)
    (Watch ?Url)
    (fetch_json ?Url ?Body))

(: Loading (* (: url str)))

(<- (Loading ?Url)
    (effect fetch_json ?App)
    (intern_snapshot fetch_json ?Args ?App)
    (tuple ?Url ?_ ?Args))
