; No relation is served, so no effect row is written and the reader is empty.
(: fetch_json
   (* (: url str)
      (: body str)))

(: Watch (* (: url str)))

(Watch "https://a")

(Watch "https://b")

(: Body
   (* (: url str)
      (: body str)))

(<- (Body ?Url ?Body)
    (Watch ?Url)
    (fetch_json ?Url ?Body))
