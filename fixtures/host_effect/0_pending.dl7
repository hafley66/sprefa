; A miss on a served relation writes down the goal instead of failing.
(: fetch_json
   (* (: url str)
      (: body str)))

(: Watch (* (: url str)))

(Watch "https://a")

(Watch "https://b")

(: Body
   (* (: url str)
      (: body str)))

(<- (Body ?Url ?Body)
    (Watch ?Url)
    (fetch_json ?Url ?Body))
