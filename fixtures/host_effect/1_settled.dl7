; A settled row feeds the reader like any fact; the miss stays for the other url.
(: fetch_json
   (* (: url str)
      (: body str)))

(: Watch (* (: url str)))

(Watch "https://a")

(Watch "https://b")

(fetch_json "https://a" "hello")

(: Body
   (* (: url str)
      (: body str)))

(<- (Body ?Url ?Body)
    (Watch ?Url)
    (fetch_json ?Url ?Body))
