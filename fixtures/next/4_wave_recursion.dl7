; A relation derived recursively inside one wave: `reach` walks the wave's
; graph. The wave lowering evaluates the recursive component as a LetRec
; nested in the wave LetRec, so it runs to its fixed point in every wave.

(: graph_item (* (: owner int) (: child int)))
(: reach (* (: node int)))

(graph_item 0 1)
(graph_item 1 2)

(<- (reach 0))

(<- (reach ?Child)
    (reach ?Owner)
    (graph_item ?Owner ?Child))

(<- (next (graph_item ?Owner ?Child))
    (graph_item ?Owner ?Child)
    (reach ?Owner))
