; Example 1 of the page 3 proposal: the graph carried to the next wave minus
; what the wave removes, plus what it adds. `graph_item` is a wave relation;
; `removed_item` and `added_item` are evaluated inside each wave against that
; wave's graph. Each wave replaces a child that names a macro by the macro's
; output: 1 expands to 10 and 10 to 20, so two waves rewrite and the third
; repeats the graph.

(: graph_item (* (: owner int) (: child int) (: ordinal int)))
(: expand (* (: macro int) (: out int)))
(: removed_item (* (: owner int) (: child int) (: ordinal int)))
(: added_item (* (: owner int) (: child int) (: ordinal int)))

(graph_item 0 1 0)
(graph_item 0 2 1)
(expand 1 10)
(expand 10 20)

(<- (removed_item ?Owner ?Child ?Ordinal)
    (graph_item ?Owner ?Child ?Ordinal)
    (expand ?Child ?Out))

(<- (added_item ?Owner ?Out ?Ordinal)
    (graph_item ?Owner ?Child ?Ordinal)
    (expand ?Child ?Out))

(<- (next (graph_item ?Owner ?Child ?Ordinal))
    (graph_item ?Owner ?Child ?Ordinal)
    (not (removed_item ?Owner ?Child ?Ordinal)))

(<- (next (graph_item ?Owner ?Child ?Ordinal))
    (added_item ?Owner ?Child ?Ordinal))
