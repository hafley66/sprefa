# sprefa — entire codebase architecture
# render: d2 arch-codebase-claude.d2 arch-codebase-claude.svg

vars: {
  d2-config: {
    layout-engine: elk
    pad: 40
    theme-id: 300
  }
}

direction: down

# ───────────────────────────── classes ─────────────────────────────

classes: {
  io:       { shape: cloud;         style: { fill: "#e8f0fe"; stroke: "#1a73e8"; font-size: 14 } }
  grammar:  { shape: package;       style: { fill: "#fff8e1"; stroke: "#f9a825"; font-size: 14; bold: true } }
  cst:      { shape: rectangle;     style: { fill: "#fff3e0"; stroke: "#ef6c00"; font-size: 14; border-radius: 8 } }
  lower:    { shape: rectangle;     style: { fill: "#e0f7fa"; stroke: "#00838f"; font-size: 14; border-radius: 8; bold: true } }
  op:       { shape: hexagon;       style: { fill: "#ede7f6"; stroke: "#4527a0"; font-size: 13 } }
  stage:    { shape: rectangle;     style: { fill: "#1a73e8"; stroke: "#0b3d91"; font-color: white; font-size: 15; border-radius: 8; bold: true; shadow: true } }
  store:    { shape: cylinder;      style: { fill: "#fff8e1"; stroke: "#bf8a00"; font-size: 14 } }
  queue:    { shape: queue;         style: { fill: "#f1f8e9"; stroke: "#558b2f"; font-size: 13 } }
  rx:       { shape: rectangle;     style: { fill: "#fce4ec"; stroke: "#ad1457"; font-size: 14; border-radius: 16 } }
  effect:   { shape: parallelogram; style: { fill: "#f3e5f5"; stroke: "#6a1b9a"; font-size: 14 } }
  shell:    { shape: rectangle;     style: { fill: "#e8eaf6"; stroke: "#283593"; font-size: 14; border-radius: 4; stroke-width: 2 } }
  tier:     { style: { fill: white;     stroke: "#444";     stroke-width: 2; font-size: 18; bold: true } }
  v3wrap:   { style: { fill: "#fafafa"; stroke: "#9e9e9e"; stroke-width: 2; stroke-dash: 4; font-size: 15; bold: true; italic: true } }
  v4wrap:   { style: { fill: "#f6fbff"; stroke: "#0b3d91"; stroke-width: 2; font-size: 15; bold: true } }
  aux:      { style: { fill: "#f5f5f5"; stroke: "#9e9e9e"; font-size: 12; italic: true } }
}

# ───────────────────────────── master grid forces vertical stack ─────────────────────────────

diagram: "" {
  style: { fill: white; stroke: white }
  grid-rows: 12
  grid-columns: 1
  grid-gap: 40

header: "sprefa — entire codebase  ·  bytes → CST → rules → runtime → facts → effects  ·  v3 dashed gray  ·  v4 solid blue" {
  shape: text
  style: { font-size: 24; bold: true }
}

# ───────────────────────────── tier 0  inputs ─────────────────────────────

t0: "0 · inputs" {
  class: tier
  grid-columns: 6
  grid-gap: 16

  sprf:    ".sprf source"               { class: io }
  cfg:     "sprefa.toml"                { class: io }
  repos:   "git repos + revs"           { class: io }
  fs:      "files on disk"              { class: io }
  watcher: "FS / git watcher"           { class: io; tooltip: "v4 git_watch.rs · v3 fs_watcher.rs" }
  vscode:  "VS Code extension"          { class: shell; tooltip: "editors/vscode/src/extension.ts" }
}

# ───────────────────────────── tier 1  parse ─────────────────────────────

t1: "1 · parse — tree-sitter host + injected DSL grammars" {
  class: tier
  grid-columns: 3
  grid-gap: 18

  v3ts: "v3 tree-sitter-sprefa" {
    class: v3wrap
    g3:  "grammar.js + parser.c"  { class: grammar }
  }

  v4ts: "v4/crates/tree-sitter-sprefa" {
    class: v4wrap
    g4:  "grammar.js + bindings"  { class: grammar }
  }

  injected: "injected DSL grammars" {
    style: { fill: "#fff8e1"; stroke: "#f9a825" }
    grid-columns: 3
    grid-gap: 8
    re:   "re"                 { class: grammar }
    glob: "glob"               { class: grammar }
    ast:  "ast<lang>"          { class: grammar }
    json: "json"               { class: grammar }
    sql:  "sql · sql_where"    { class: grammar }
    md:   "markdown / yaml / toml" { class: grammar }
  }
}

# ───────────────────────────── tier 2  CST ─────────────────────────────

t2: "2 · CST + sprf AST" {
  class: tier
  grid-columns: 2
  grid-gap: 24

  v3parse: "v3/crates/sprefa_parse" {
    class: v3wrap
    grid-columns: 2
    ast3:   "ast.rs"                                   { class: cst }
    parse3: "parse.rs · site.rs"                       { class: cst; tooltip: "Pipe / Fork / OpInvocation / ParenSlot" }
  }

  v4cst: "v4/src/cst — current" {
    class: v4wrap
    grid-columns: 2
    cstmod:  "store · doc · diag · path · locate" { class: cst }
    cstbuild: "build / grammar_walk"               { class: cst }
    dsl:     "dsl · injected"                      { class: cst }
    dsls:    "dsls/ — per-DSL parsers"             { class: cst; tooltip: "re · glob · ast · json · sql · sql_where · markdown" }
    lspmod:  "cst/lsp — providers · semantic"      { class: cst; tooltip: "hover · completion · semantic tokens · inlay" }
  }
}

# ───────────────────────────── tier 3  lower / compile ─────────────────────────────

t3: "3 · lower — pipes to runnable graph" {
  class: tier
  grid-columns: 2
  grid-gap: 24

  v3lower: "v3 pipeline lower" {
    class: v3wrap
    grid-columns: 2
    p1: "lower.rs"                       { class: lower; tooltip: "two-pass walk" }
    p2: "binding_graph.rs"               { class: lower; tooltip: "Read / Unbound TermMode" }
    p3: "walk/ + pattern_op"             { class: lower }
    p4: "stratification + DSL lattice"   { class: lower; tooltip: "writer>reader · neg-cycle reject" }
  }

  v4lower: "v4/src/compile + ../stratify.rs" {
    class: v4wrap
    grid-columns: 3
    parse4: "parse.rs"          { class: lower }
    walk4:  "walk.rs"           { class: lower }
    ast4:   "ast.rs"            { class: lower }
    bind4:  "binding_graph.rs"  { class: lower }
    fuser4: "fuser.rs"          { class: lower; tooltip: "rule fusion + fused_sql" }
    probe4: "probe_wrap.rs"     { class: lower }
    lowerdir4: "lower/ — ctx · ops · op_def · registry · value · where_eval · liftable" { class: lower; style.bold: true }
    stratify4: "stratify.rs"    { class: lower }
  }
}

# ───────────────────────────── tier 4  ops / traits ─────────────────────────────

t4: "4 · ops + operator/component traits" {
  class: tier
  grid-columns: 4
  grid-gap: 18

  v3ops: "v3 pipeline/ops" {
    class: v3wrap
    grid-columns: 2
    pat3:  "patterns — re glob ast json comment" { class: op }
    src3:  "sources — repo rev fs read"           { class: op }
    eff3:  "effects — sh print write render lsp"  { class: op }
    rel3:  "tag fact rule relation"               { class: op }
    cur3:  "_0_cursor · _1_op · _2_pipeline"      { class: lower; tooltip: "Cursor + Op trait + Pipeline chain" }
    reg3:  "registry · op_ctor"                   { class: lower; tooltip: "string-shape to Box of dyn Op" }
  }

  spineSprefa: "v3 spine + sprefa bridge" {
    class: v3wrap
    grid-columns: 1
    sp_an:   "analysis · dag · extractor · jq_path" { class: lower }
    sp_ops:  "sprefa/ops — ast_grep fs json md repo rev rule" { class: op }
    sp_st:   "sprefa/store — sqlite ddl migrations udfs" { class: store }
    sp_mac:  "sprefa_macros — proc macros"          { class: aux }
  }

  v4ops: "v4/src/v2_ops.rs — 3953 LOC" {
    class: v4wrap
    grid-columns: 1
    v4od:   "OperatorDef · Component · Node · RenderCtx" { class: op; style.bold: true }
    v4pat:  "patterns + render + split + sh + lsp + str" { class: op }
    v4src:  "repo · rev · fs · read · source-aware ast/json" { class: op }
    v4rule: "rule call / force / query · fact write"     { class: op }
  }

  rt_traits: "runtime trait surface" {
    class: tier
    grid-columns: 1
    cursor4: "Cursor + Term + Coord"  { class: cst; tooltip: "v4/src/lib.rs · term.rs · template.rs · cursor_codec.rs" }
    op_trait: "Op + Component"        { class: op }
    rctx:    "RenderCtx"              { class: op; tooltip: "&RenderCtx · pipe_hash · depth · tick · bus" }
  }
}

# ───────────────────────────── tier 5  runtime ─────────────────────────────

t5: "5 · runtime — execute, batch, tick" {
  class: tier
  grid-columns: 2
  grid-gap: 24

  v3rt: "v3 effect_runtime" {
    class: v3wrap
    grid-columns: 2
    er_core: "generation · rx · subjects" { class: stage }
    er_bat:  "batchers — pass · cache · bounded · work-steal" { class: queue }
    er_v2:   "v2 — component · expand · node · queue · wake · memoize" { class: stage; style.bold: true }
    er_v2_q: "v2 queues — mem · hybrid · sqlite · dispatch · next" { class: queue }
  }

  v4rt: "v4 lib runtime" {
    class: v4wrap
    grid-columns: 3
    expand:    "pipeline.rs — expand"      { class: stage; style.bold: true }
    fix:       "fixpoint.rs · rule.rs"     { class: stage }
    runbridge: "runtime_bridge · replay"   { class: stage; tooltip: "bridges v4 ↔ v3 effect_runtime::v2" }
    runtime_g: "runtime_graph.rs · 2163 LOC" { class: rx; style.bold: true; tooltip: "RuntimeGraph facade · subscribe/support edges · dirty sweep" }
    sql_rt:    "sql.rs · 1558 LOC"         { class: stage; style.bold: true; tooltip: "SQL relational runtime · per-rule temp SQLite · joins · antijoins" }
    mounted:   "mounted_query.rs"          { class: rx }
    memo:      "memo · memo_seam_impl"     { class: queue }
    dirty:     "dirty_source.rs"           { class: rx }
    telem:     "telemetry · sprf_introspect" { class: aux }
  }
}

# ───────────────────────────── tier 6  stores / facts / reactive ─────────────────────────────

t6: "6 · stores · facts · reactive graph" {
  class: tier
  grid-columns: 4
  grid-gap: 20

  fact_store: "FactStore<Cursor>" {
    class: tier
    grid-columns: 1
    mem:    "MemFactStore"           { class: store }
    sqlite: "SqliteFactStore"        { class: store; tooltip: "rusqlite, bundled" }
    iden:   "row identity — declared cols + blake3 _id" { class: aux }
  }

  rgraph: "FactRuntimeGraph" {
    class: tier
    grid-columns: 1
    sub:    "subscribe — owner ← source"          { class: rx }
    supp:   "support — keyed keep-alive"          { class: rx }
    sweep:  "dirty sweep — re-run owners on Δ"    { class: rx }
    owner:  "owner_uri — switchMap key"           { class: rx }
  }

  rel_store: "v3 relation_store" {
    class: v3wrap
    grid-columns: 1
    bags:   "Bag — rows + waiters + open_writers + gen" { class: store }
    subreg: "SubjectRegistry — wakers"            { class: store }
  }

  queues: "queues + caches" {
    class: tier
    grid-columns: 1
    qsql:    "sqlite_queue — durable, parked"     { class: queue }
    qhyb:    "hybrid_queue · mem_queue"           { class: queue }
    cache:   "blake3 op-cache · disk_cache"       { class: queue }
    ghcache: "ghcache.rs — GitHub API"            { class: queue }
  }
}

# ───────────────────────────── tier 7  effects ─────────────────────────────

t7: "7 · effects fire post-seal (flush phase)" {
  class: tier
  grid-columns: 6
  grid-gap: 14

  e_wf:   "write_file"           { class: effect }
  e_wc:   "write_cursor"         { class: effect; tooltip: "WriteRange · per-target aggregation" }
  e_sh:   "sh"                   { class: effect; tooltip: "staged approval gate" }
  e_pr:   "print"                { class: effect }
  e_rn:   "render"               { class: effect; tooltip: "markdown · graphviz · dot · html" }
  e_lsp:  "lsp.warn/error/info"  { class: effect }
}

# ───────────────────────────── tier 8  shells ─────────────────────────────

t8: "8 · shells — CLI · LSP · daemon" {
  class: tier
  grid-columns: 2
  grid-gap: 24

  v3server: "v3/crates/server" {
    class: v3wrap
    grid-columns: 2
    s_back:  "backend.rs · tower-lsp"    { class: shell }
    s_sess:  "session.rs"                { class: shell }
    s_run:   "run.rs · per-seed loop"    { class: shell }
    s_cfg:   "config · workspace · state · snapshots" { class: shell }
    s_trans: "transport_lsp · transport_http" { class: shell }
    s_bins:  "bins — sprefa-run · sprefa-lsp · sprefa-server" { class: shell; style.bold: true }
  }

  v4shells: "v4 shells" {
    class: v4wrap
    grid-columns: 2
    app_host: "v4/app_host — Store · Dispatch · Handler · App · Service · Transport" { class: shell; style.bold: true; tooltip: "generic scaffold over tower::Service" }
    daemon:   "app_host/daemon.rs"        { class: shell }
    app4:     "v4/src/app.rs · 2824 LOC" { class: shell; style.bold: true; tooltip: "reducer + dispatch" }
    chan4:    "chan.rs · config.rs"      { class: shell }
    lsp4:     "v4/src/lsp.rs"            { class: shell }
    lspcrate: "v4/crates/sprefa-lsp"     { class: shell; style.bold: true; tooltip: "dsl_lookup · semantic · inlay · main" }
    bins:     "bins — sprefa-run · sprefa-daemon · v4-bench · stress" { class: shell }
  }
}

# ───────────────────────────── tier 9  outputs ─────────────────────────────

t9: "9 · outputs / sinks" {
  class: tier
  grid-columns: 5
  grid-gap: 16

  o_vsc:   "VS Code client"        { class: io; tooltip: "hover · diags · semantic tokens" }
  o_cli:   "stdout / stderr"       { class: io }
  o_files: "written files"         { class: io; tooltip: "splices from write_file / write_cursor" }
  o_html:  "HTML / MD / DOT / SVG" { class: io; tooltip: "examples/*.md · runtime-map.html · npm-reaches.svg" }
  o_bench: "benches"               { class: io; tooltip: "v4/bench · v4/perf · linux fixture" }
}

legend: "legend" {
  style: { fill: "#fffde7"; stroke: "#f9a825"; font-size: 13 }
  grid-columns: 6
  grid-gap: 6
  l_io: "cloud = IO"                  { class: aux }
  l_gr: "package = grammar"           { class: aux }
  l_lw: "teal = compile/lower"        { class: aux }
  l_op: "hexagon = op"                { class: aux }
  l_st: "blue solid = runtime stage"  { class: aux }
  l_sr: "cylinder = store"            { class: aux }
  l_qu: "queue = queue/cache"         { class: aux }
  l_rx: "pink rounded = reactive"     { class: aux }
  l_ef: "purple = effect"             { class: aux }
  l_sh: "double-border = shell"       { class: aux }
  l_v3: "dashed gray = v3 legacy"     { class: aux }
  l_v4: "solid blue = v4 current"     { class: aux }
}

} # end diagram master grid

# ───────────────────────────── edges (adjacent-tier spine + one cross-cut) ─────────────────────────────
# Edges only flow downward between adjacent tiers. The one exception:
# shells drive runtime (8 → 5), which is the application entry-point.
# Within-tier wiring is conveyed by containment + the tier title, not by lines.

# 0 → 1   bytes hit both grammars
diagram.t0.sprf -> diagram.t1.v3ts: "v3 path"
diagram.t0.sprf -> diagram.t1.v4ts: "v4 path"

# 1 → 2   CST nodes feed the AST/CST surface
diagram.t1.v3ts -> diagram.t2.v3parse
diagram.t1.v4ts -> diagram.t2.v4cst
diagram.t1.injected -> diagram.t2.v4cst: "DSL carveouts"

# 2 → 3   AST/CST feeds lower
diagram.t2.v3parse -> diagram.t3.v3lower
diagram.t2.v4cst -> diagram.t3.v4lower

# 3 → 4   lower picks ops from the registry
diagram.t3.v3lower -> diagram.t4.v3ops: "Pipeline of Arc dyn Op"
diagram.t3.v4lower -> diagram.t4.v4ops: "OperatorDef to Component"

# 4 → 5   ops execute in runtime
diagram.t4.v3ops -> diagram.t5.v3rt: "dispatch"
diagram.t4.v4ops -> diagram.t5.v4rt: "render_batch"
diagram.t4.rt_traits -> diagram.t5.v4rt: "trait contract"

# 5 ↔ 6   runtime writes/reads stores (+ wake)
diagram.t5.v3rt -> diagram.t6.rel_store: "tag / fact writes"
diagram.t5.v4rt -> diagram.t6.fact_store: "write rows"
diagram.t5.v4rt -> diagram.t6.rgraph: "subscribe / sweep"
diagram.t5.v4rt -> diagram.t6.queues: "park / cache"
diagram.t6.queues -> diagram.t5.v4rt: "revive parked"
diagram.t6.fact_store -> diagram.t6.rgraph: "Δ rows"

# 5 → 7   tick seal fires effects
diagram.t5.v3rt -> diagram.t7: "flush"
diagram.t5.v4rt -> diagram.t7: "flush"

# 7 → 9   effects land on sinks
diagram.t7.e_wf -> diagram.t9.o_files
diagram.t7.e_wc -> diagram.t9.o_files
diagram.t7.e_rn -> diagram.t9.o_html
diagram.t7.e_sh -> diagram.t9.o_cli
diagram.t7.e_pr -> diagram.t9.o_cli
diagram.t7.e_lsp -> diagram.t9.o_vsc

# 8 → 5   shells drive runtime ticks (the one back-edge)
diagram.t8.v3server -> diagram.t5.v3rt: "tick spawn"
diagram.t8.v4shells -> diagram.t5.v4rt: "dispatch / subscribe"

# 8 → 9   shells write LSP wire + CLI exit + benches
diagram.t8.v3server -> diagram.t9.o_vsc
diagram.t8.v4shells -> diagram.t9.o_vsc
diagram.t8.v4shells -> diagram.t9.o_cli
diagram.t8.v4shells -> diagram.t9.o_bench

# 0 → 8   editor + config terminate at shells
diagram.t0.vscode -> diagram.t8.v4shells: "LSP requests"
diagram.t0.cfg -> diagram.t8.v4shells: "TOML"
diagram.t0.cfg -> diagram.t8.v3server: "TOML"
diagram.t0.watcher -> diagram.t8.v4shells: "FS events"
diagram.t0.repos -> diagram.t5.v4rt: "repo / rev hydration"
diagram.t0.fs -> diagram.t5.v4rt: "bytes"
