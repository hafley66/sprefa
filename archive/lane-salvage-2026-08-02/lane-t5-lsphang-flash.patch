index 00000000..847d0932
--- /dev/null
+++ b/tests/it/lsp_exit.rs
@@ -0,0 +1,227 @@
+//! Regression rail for the `dl --lsp` shutdown hang (LSP-diags arc, 2026-07-29).
+//!
+//! Defect: the server answered the `shutdown` request, then HUNG instead of
+//! exiting when the client sent `exit` and closed stdin. The main message loop
+//! in src/lsp.rs never handled the `exit` notification (it fell through and the
+//! loop kept iterating), relying on lsp-server's internal `handle_shutdown`
+//! wait and on the stdio reader thread dropping its channel sender — a race that
+//! leaves the process alive.
+//!
+//! Contract under test (LSP 3.15 exit): after `exit`, the server process must
+//! terminate — exit code 0 if `shutdown` was received first, 1 otherwise. EOF
+//! on stdin with no `exit` must also terminate.
+//!
+//! The test drives the real binary over stdio. It primes by waiting for the
+//! `shutdown` response (guaranteeing the message loop + `handle_shutdown` were
+//! reached), THEN times the actual exit in a strict window — so slow cold-start
+//! never trips the hang assertion; only a genuine post-shutdown hang does.
+
+use std::fs;
+use std::io::{BufRead, BufReader, Read, Write};
+use std::path::{Path, PathBuf};
+use std::process::{Child, ChildStdout, Command, Stdio};
+use std::sync::mpsc;
+use std::time::{Duration, Instant};
+
+const DL: &str = env!("CARGO_BIN_EXE_dl");
+// Priming: how long to wait for the server to reach the message loop (answer
+// initialize + shutdown). Cold-first-start on a fresh db can be slow.
+const PRIME_TIMEOUT: Duration = Duration::from_secs(90);
+// The actual exit-after-shutdown window. Post-fix the process must exit well
+// inside this; pre-fix it hangs here (the test fails via the timeout).
+const EXIT_TIMEOUT: Duration = Duration::from_secs(15);
+
+fn sandbox(tag: &str) -> PathBuf {
+    let dir = std::env::temp_dir().join(format!("lsp_exit_{tag}"));
+    let _ = fs::remove_dir_all(&dir);
+    fs::create_dir_all(&dir).unwrap();
+    dir
+}
+
+/// A spawned `dl --lsp` over stdio. Frames come off a reader thread into `rx`.
+struct Session {
+    child: Child,
+    rx: mpsc::Receiver<String>,
+}
+
+impl Session {
+    /// Spawn with `--db` (hermetic; also keeps `--lsp`'s daemon subscriber off
+    /// a real daemon). cwd is the sandbox root so `WORK` scans the tiny root,
+    /// not the checkout the test binary lives in. stdout is drained so a
+    /// publish back-pressure deadlock is never confused with the exit hang.
+    fn spawn(prog: &Path, root: &Path, db: &Path) -> Session {
+        let mut child = Command::new(DL)
+            .arg(prog)
+            .args(["--lsp", "--db", db.to_str().unwrap()])
+            .current_dir(root)
+            .env("DL_NO_DAEMON", "1")
+            .stdin(Stdio::piped())
+            .stdout(Stdio::piped())
+            .stderr(Stdio::piped())
+            .spawn()
+            .expect("spawn dl --lsp");
+        let stdout = child.stdout.take().unwrap();
+        let (tx, rx) = mpsc::channel();
+        std::thread::spawn(move || read_frames(stdout, tx));
+        Session { child, rx }
+    }
+
+    fn send_json(&mut self, v: serde_json::Value) {
+        let body = serde_json::to_vec(&v).unwrap();
+        let stdin = self.child.stdin.as_mut().unwrap();
+        write!(stdin, "Content-Length: {}\r\n\r\n", body.len()).unwrap();
+        stdin.write_all(&body).unwrap();
+        stdin.flush().unwrap();
+    }
+
+    fn close_stdin(&mut self) {
+        // Dropping the child's stdin handle closes the pipe, giving the server
+        // EOF on its read side.
+        let _ = self.child.stdin.take();
+    }
+
+    /// Wait (up to `timeout`) for one received frame whose raw text contains
+    /// `needle`. Returns true on match.
+    fn recv_until(&self, needle: &str, timeout: Duration) -> bool {
+        let t0 = Instant::now();
+        while t0.elapsed() < timeout {
+            match self.rx.recv_timeout(timeout - t0.elapsed()) {
+                Ok(frame) => {
+                    if frame.contains(needle) {
+                        return true;
+                    }
+                }
+                Err(_) => return false,
+            }
+        }
+        false
+    }
+
+    /// Wait for the child to exit within `timeout`, returning its code.
+    /// Returns None if it is still alive when the window elapses.
+    fn wait_exit(&mut self, timeout: Duration) -> Option<i32> {
+        let t0 = Instant::now();
+        while t0.elapsed() < timeout {
+            match self.child.try_wait().unwrap_or(None) {
+                Some(st) => return st.code(),
+                None => std::thread::sleep(Duration::from_millis(25)),
+            }
+        }
+        None
+    }
+}
+
+impl Drop for Session {
+    /// Never leak a live server: on any assertion failure / timeout, reap the
+    /// child if it is still running.
+    fn drop(&mut self) {
+        if self.child.try_wait().ok().flatten().is_none() {
+            let _ = self.child.kill();
+            let _ = self.child.wait();
+        }
+    }
+}
+
+/// Read Content-Length framed JSON-RPC text off stdout, forward each frame into
+/// the channel. Exits when the stream closes.
+fn read_frames(stdout: ChildStdout, tx: mpsc::Sender<String>) {
+    let mut r = BufReader::new(stdout);
+    loop {
+        let mut len = 0usize;
+        loop {
+            let mut line = String::new();
+            if r.read_line(&mut line).unwrap_or(0) == 0 {
+                return;
+            }
+            let trimmed = line.trim_end();
+            if trimmed.is_empty() {
+                break;
+            }
+            if let Some(rest) = trimmed.strip_prefix("Content-Length:") {
+                len = rest.trim().parse().unwrap_or(0);
+            }
+        }
+        if len == 0 {
+            continue;
+        }
+        let mut buf = vec![0u8; len];
+        if r.read_exact(&mut buf).is_err() {
+            return;
+        }
+        if tx.send(String::from_utf8_lossy(&buf).into_owned()).is_err() {
+            return;
+        }
+    }
+}
+
+fn initialize(s: &mut Session, root: &Path) {
+    s.send_json(serde_json::json!({
+        "jsonrpc":"2.0","id":1,"method":"initialize",
+        "params":{"processId":serde_json::Value::Null,
+                  "rootUri": format!("file://{}", root.to_str().unwrap()),
+                  "capabilities":{}}
+    }));
+    s.send_json(serde_json::json!({"jsonrpc":"2.0","method":"initialized","params":{}}));
+    assert!(
+        s.recv_until("\"id\":1", PRIME_TIMEOUT),
+        "server never answered initialize within {PRIME_TIMEOUT:?}"
+    );
+}
+
+/// A tiny program + scanned file so `WORK` resolves to a 1-file root.
+fn write_fixture(root: &Path) -> PathBuf {
+    fs::create_dir_all(root.join("src")).unwrap();
+    fs::write(root.join("src/main.rs"), "fn main() {}\n").unwrap();
+    let prog = root.join("p.dl");
+    fs::write(
+        &prog,
+        "rel seen(p: file).\nseen(p) <- scan(\"WORK\", \"src/**/*.rs\", p, rev).\n",
+    )
+    .unwrap();
+    prog
+}
+
+/// Regression for the hang: shutdown -> exit -> close stdin must terminate with
+/// code 0 quickly. Pre-fix this HANGS after answering shutdown (test fails on
+/// the EXIT_TIMEOUT window); post-fix it exits cleanly.
+#[test]
+fn shutdown_then_exit_then_eof_terminates_with_code_0() {
+    let root = sandbox("shutdown");
+    let prog = write_fixture(&root);
+    let db = root.join("lsp.db");
+    let mut s = Session::spawn(&prog, &root, &db);
+    initialize(&mut s, &root);
+
+    // Send shutdown and answer it (priming the message loop + handle_shutdown).
+    s.send_json(serde_json::json!({"jsonrpc":"2.0","id":99,"method":"shutdown","params":{}}));
+    assert!(
+        s.recv_until("\"id\":99", PRIME_TIMEOUT),
+        "server never answered shutdown within {PRIME_TIMEOUT:?}"
+    );
+    // Now the client sends exit and closes stdin. The server must not hang.
+    s.send_json(serde_json::json!({"jsonrpc":"2.0","method":"exit","params":{}}));
+    s.close_stdin();
+
+    let code = s.wait_exit(EXIT_TIMEOUT).expect(
+        "server did not exit within {EXIT_TIMEOUT:?} after shutdown+exit — hang (pre-fix)",
+    );
+    assert_eq!(code, 0, "shutdown-first exit must be code 0");
+}
+
+/// Contract: exit WITHOUT a prior shutdown must terminate with code 1 (and not
+/// hang). Pre-fix this exited 0 (spec-wrong) or hung; post-fix it is code 1.
+#[test]
+fn exit_without_shutdown_terminates_with_code_1() {
+    let root = sandbox("exit-only");
+    let prog = write_fixture(&root);
+    let db = root.join("lsp.db");
+    let mut s = Session::spawn(&prog, &root, &db);
+    initialize(&mut s, &root);
+
+    s.send_json(serde_json::json!({"jsonrpc":"2.0","method":"exit","params":{}}));
+    s.close_stdin();
+
+    let code = s.wait_exit(EXIT_TIMEOUT)
+        .expect("server did not exit within {EXIT_TIMEOUT:?} after exit+EOF");
+    assert_eq!(code, 1, "exit without shutdown must be code 1");
+}
