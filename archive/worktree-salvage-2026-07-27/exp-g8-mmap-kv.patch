@@ -0,0 +1,78 @@
+//! Hermetic G8 measurement: one process per engine / DAG scale.
+//!
+//! The workload is a one-support-per-node DAG chain. Thus the counting rule is
+//! exercised as a full cascade and has the same result as the DAG oracle. The
+//! existing `DdReach` answers all-pairs reachability rather than this row Z-set,
+//! so it is not emitted as a false same-digest comparator here.
+
+use labkit::cascade::{cascade_oracle, CascadeZset};
+use labkit::{gun, RedbCount};
+use std::process::Command;
+use std::time::Instant;
+
+#[global_allocator]
+static GLOBAL: gun::Gun = gun::Gun;
+
+fn dag(nodes: usize) -> (Vec<(i64, i64)>, Vec<(i64, i64)>) {
+    let rows = (0..nodes as i64).map(|id| (id, 1)).collect();
+    let deps = (1..nodes as i64).map(|id| (id - 1, id)).collect();
+    (rows, deps)
+}
+
+fn load_sqlite(db: &mut CascadeZset, rows: &[(i64, i64)], deps: &[(i64, i64)]) {
+    // StoreDb's SQL builder materializes an INSERT statement. Chunk setup so the
+    // measurement can reach millions without one SQL string exceeding the gun.
+    for chunk in rows.chunks(50_000) { db.insert_rows(chunk); }
+    for chunk in deps.chunks(50_000) { db.insert_deps(chunk); }
+}
+
+fn child(engine: &str, nodes: usize) {
+    let (rows, deps) = dag(nodes);
+    let expected = cascade_oracle(&rows, &deps, &[0]);
+    match engine {
+        "redb-count" => {
+            let mut db = RedbCount::default();
+            db.insert_rows(&rows);
+            db.insert_deps(&deps);
+            drop(rows); drop(deps);
+            gun::reset_peak();
+            let started = Instant::now();
+            db.retract(&[0]);
+            let actual = db.survivors();
+            println!("RESULT engine=redb-count nodes={nodes} correct={} digest={} oracle={} live={} rust_mb={:.3} rss_mb={:.3} ms={:.3} disk_mb={:.3}", actual == expected, actual.0, expected.0, actual.1, gun::peak_mb(), gun::resident_rss_mb(), started.elapsed().as_secs_f64() * 1000.0, db.db_size_mb());
+        }
+        "sqlite-count" => {
+            let mut db = CascadeZset::default();
+            load_sqlite(&mut db, &rows, &deps);
+            drop(rows); drop(deps);
+            gun::reset_peak();
+            let started = Instant::now();
+            db.retract(&[0]);
+            let actual = db.survivors();
+            println!("RESULT engine=sqlite-count nodes={nodes} correct={} digest={} oracle={} live={} rust_mb={:.3} rss_mb={:.3} ms={:.3} disk_mb={:.3}", actual == expected, actual.0, expected.0, actual.1, gun::peak_mb(), gun::resident_rss_mb(), started.elapsed().as_secs_f64() * 1000.0, db.db_size_mb());
+        }
+        _ => panic!("unknown engine {engine}"),
+    }
+}
+
+fn main() {
+    let cap = std::env::var("DL_MEMCAP_MB").ok().and_then(|s| s.parse().ok()).unwrap_or(2048);
+    gun::install(cap);
+    let args: Vec<String> = std::env::args().collect();
+    if args.get(1).map(String::as_str) == Some("--child") {
+        child(&args[2], args[3].parse().unwrap());
+        return;
+    }
+    let executable = std::env::current_exe().unwrap();
+    for nodes in [100_000usize, 1_000_000, 2_000_000] {
+        for engine in ["redb-count", "sqlite-count"] {
+            let output = Command::new(&executable)
+                .args(["--child", engine, &nodes.to_string()])
+                .env("DL_MEMCAP_MB", cap.to_string())
+                .output()
+                .unwrap();
+            print!("{}", String::from_utf8_lossy(&output.stdout));
+            eprint!("{}", String::from_utf8_lossy(&output.stderr));
+        }
+    }
+}
