+#[cfg(test)]
+mod tests {
+    use super::RedbCount;
+    use crate::cascade::cascade_oracle;
+
+    #[test]
+    fn dag_retraction_matches_counting_oracle() {
+        let rows = [(0, 1), (1, 1), (2, 2), (3, 1), (4, 1)];
+        let deps = [(0, 2), (1, 2), (2, 3), (3, 4)];
+        let mut db = RedbCount::default();
+        db.insert_rows(&rows);
+        db.insert_deps(&deps);
+        db.retract(&[0, 1]);
+        assert_eq!(db.survivors(), cascade_oracle(&rows, &deps, &[0, 1]));
+    }
+}
