+
+/// Resident bytes now, rather than `getrusage`'s process-lifetime high-water.
+/// The mmap experiment uses this after setup staging has been dropped.
+#[cfg(target_os = "macos")]
+pub fn resident_rss_mb() -> f64 {
+    unsafe {
+        let mut info: libc::mach_task_basic_info = std::mem::zeroed();
+        let mut count = libc::MACH_TASK_BASIC_INFO_COUNT;
+        let rc = libc::task_info(
+            libc::mach_task_self(),
+            libc::MACH_TASK_BASIC_INFO,
+            &mut info as *mut _ as libc::task_info_t,
+            &mut count,
+        );
+        if rc == 0 { info.resident_size as f64 / (1024.0 * 1024.0) } else { 0.0 }
+    }
+}
+
+#[cfg(not(target_os = "macos"))]
+pub fn resident_rss_mb() -> f64 {
+    peak_rss_mb()
+}
