index 00000000..017fdf1f
--- /dev/null
+++ b/v6/labs/labkit/src/redb_count.rs
@@ -0,0 +1,186 @@
+//! File-backed counting Z-set cascade over redb cursors.
+//!
+//! `row` maps the dense `(tag=0, id)` key to its signed support count. `dep`
+//! maps the ordered packed `(parent, child)` key to `()`, so the key range
+//! `[parent << 64, (parent + 1) << 64)` is the native child cursor for a parent.
+//! The retraction algorithm is correct for DAGs. A cyclic graph needs SCC-aware
+//! deletion semantics and is deliberately outside this experiment.
+
+use crate::{Complexity, Experiment};
+use redb::{Database, ReadableDatabase, ReadableTable, TableDefinition};
+
+const ROW: TableDefinition<u64, i64> = TableDefinition::new("row");
+const DEP: TableDefinition<u128, u8> = TableDefinition::new("dep");
+static SEQ: std::sync::atomic::AtomicU64 = std::sync::atomic::AtomicU64::new(0);
+
+fn dep_key(parent: i64, child: i64) -> u128 {
+    ((parent as u64 as u128) << 64) | child as u64 as u128
+}
+
+pub struct RedbCount {
+    db: Database,
+    path: std::path::PathBuf,
+    writes: u64,
+    rounds: u64,
+    rows: u64,
+}
+
+impl Default for RedbCount {
+    fn default() -> Self {
+        let id = SEQ.fetch_add(1, std::sync::atomic::Ordering::Relaxed);
+        let path = std::env::temp_dir().join(format!("labkit_redb_count_{}_{}.redb", std::process::id(), id));
+        let _ = std::fs::remove_file(&path);
+        Self { db: Database::create(&path).unwrap(), path, writes: 0, rounds: 0, rows: 0 }
+    }
+}
+
+impl Drop for RedbCount {
+    fn drop(&mut self) {
+        let _ = std::fs::remove_file(&self.path);
+    }
+}
+
+impl RedbCount {
+    pub fn insert_rows(&mut self, rows: &[(i64, i64)]) {
+        let txn = self.db.begin_write().unwrap();
+        {
+            let mut table = txn.open_table(ROW).unwrap();
+            for &(id, weight) in rows {
+                table.insert(id as u64, weight).unwrap();
+            }
+        }
+        txn.commit().unwrap();
+        self.rows += rows.len() as u64;
+        self.writes += rows.len() as u64;
+    }
+
+    pub fn insert_deps(&mut self, edges: &[(i64, i64)]) {
+        let txn = self.db.begin_write().unwrap();
+        {
+            let mut table = txn.open_table(DEP).unwrap();
+            for &(parent, child) in edges {
+                table.insert(dep_key(parent, child), 0).unwrap();
+            }
+        }
+        txn.commit().unwrap();
+        self.writes += edges.len() as u64;
+    }
+
+    /// Decrement every seed once. A zero transition propagates exactly one lost
+    /// support down each stored edge. The frontier holds only newly dead rows.
+    pub fn retract(&mut self, seeds: &[i64]) -> u64 {
+        let txn = self.db.begin_write().unwrap();
+        let mut frontier = Vec::with_capacity(seeds.len());
+        {
+            let mut rows = txn.open_table(ROW).unwrap();
+            for &seed in seeds {
+                let Some(guard) = rows.get(seed as u64).unwrap() else { continue };
+                let before = guard.value();
+                let after = before - 1;
+                drop(guard);
+                rows.insert(seed as u64, after).unwrap();
+                self.writes += 1;
+                if before > 0 && after <= 0 {
+                    frontier.push(seed);
+                }
+            }
+        }
+
+        let mut rounds = 0;
+        while !frontier.is_empty() {
+            rounds += 1;
+            let mut hits = Vec::new();
+            {
+                let deps = txn.open_table(DEP).unwrap();
+                for &parent in &frontier {
+                    let start = (parent as u64 as u128) << 64;
+                    let end = start + (1u128 << 64);
+                    for entry in deps.range(start..end).unwrap() {
+                        let (key, _) = entry.unwrap();
+                        hits.push((key.value() & u64::MAX as u128) as u64 as i64);
+                    }
+                }
+            }
+
+            let mut next = Vec::new();
+            {
+                let mut rows = txn.open_table(ROW).unwrap();
+                for child in hits {
+                    let Some(guard) = rows.get(child as u64).unwrap() else { continue };
+                    let before = guard.value();
+                    let after = before - 1;
+                    drop(guard);
+                    rows.insert(child as u64, after).unwrap();
+                    self.writes += 1;
+                    if before > 0 && after <= 0 {
+                        next.push(child);
+                    }
+                }
+            }
+            frontier = next;
+        }
+        txn.commit().unwrap();
+        self.rounds = rounds;
+        rounds
+    }
+
+    pub fn survivors(&self) -> (i64, u64) {
+        let txn = self.db.begin_read().unwrap();
+        let table = txn.open_table(ROW).unwrap();
+        table.iter().unwrap().filter_map(|entry| {
+            let (id, weight) = entry.unwrap();
+            (weight.value() > 0).then(|| id.value() as i64)
+        }).fold((0, 0), |(digest, live), id| (digest ^ crate::mix(id), live + 1))
+    }
+
+    pub fn db_size_mb(&self) -> f64 {
+        std::fs::metadata(&self.path).map(|m| m.len() as f64 / (1024.0 * 1024.0)).unwrap_or(0.0)
+    }
+}
+
+impl Experiment for RedbCount {
+    fn name(&self) -> &'static str { "redb-count" }
+    fn complexity(&self) -> Complexity { Complexity { time: "O(Δ · log rows + cascade edges)", space: "O(frontier) Rust; mmap pages RSS" } }
+    fn rationale(&self) -> &'static str { "redb file-backed B-tree rows with native ordered dependency cursors; DAG counting only" }
+    fn reset(&mut self) { *self = Self::default(); }
+    fn setup(&mut self, base: usize) {
+        self.insert_rows(&(0..base as i64).map(|id| (id, 1)).collect::<Vec<_>>());
+    }
+    fn tick(&mut self, adds: &[i64], removes: &[i64]) {
+        if !adds.is_empty() {
+            let txn = self.db.begin_write().unwrap();
+            {
+                let mut rows = txn.open_table(ROW).unwrap();
+                for &id in adds {
+                    let before = rows.get(id as u64).unwrap().map(|v| v.value()).unwrap_or(0);
+                    rows.insert(id as u64, before + 1).unwrap();
+                    self.writes += 1;
+                }
+            }
+            txn.commit().unwrap();
+        }
+        if !removes.is_empty() { self.retract(removes); }
+    }
+    fn digest(&self) -> i64 { self.survivors().0 }
+    fn live(&self) -> u64 { self.survivors().1 }
+    fn total_rows(&self) -> u64 { self.rows }
+    fn recompute_units(&self) -> u64 { self.rounds }
+    fn writes(&self) -> u64 { self.writes }
+}
