#!/bin/sh
# Pre-commit: regenerate the live v6 markdown index and stage it.
# (dl --check rails gate removed for now — restore `exec dl --check` when dl is
#  back on PATH. Bypass this hook: git commit -n)
repo_root=$(git rev-parse --show-toplevel)
sh "$repo_root/v6/tools/gen-index.sh" && git add "$repo_root/v6/INDEX.md" || exit 1
# Comment budget (>2 consecutive comment lines = fail); default = the dl6 rail
# (comment_rail_golden/README.md), SPREFA_COMMENT_RAIL_DL6=0 = retired bash tool.
if [ "${SPREFA_COMMENT_RAIL_DL6:-1}" = 1 ]; then
  exec bash "$repo_root/v6/tsv2/scripts/comment-budget-rail.sh"
fi
