# The `/soopy/watch` rail: a resident `dl6 run` feeds this rel from soopy's watcher,
# one coalesced burst per tick, and the `?` re-prints as `+`/`-` TSV deltas.
#
# The digest is what makes the watch a FRESHNESS source rather than a
# notification: a save that changed no bytes re-enumerates to the same blob oid,
# which is zero delta at the rel boundary, so no extract re-runs.
#
# rx: watchSource(glob).pipe(
#       bufferTime(coalesceMs),
#       map(window => enumerate(glob)),
#       distinctUntilChanged(sameDigests),
#       mergeMap(rows => diffAgainstHeld(rows)))

# The program owns its seed: the watched glob is a fact.
rel want(glob: text).
want('crates/*/src/*.rs').

rel /soopy/watch(glob: text) -> (path: text, digest: text).

rel /extract/call_node_at(path: text, digest: text, families: text) ->
  (record: text, family: text, kind: text, name: text) key(1, 3).

# rx: watch$.pipe(map(({path, digest}) => ({path, digest})), distinct())
rel source_file(path: text, digest: text).
source_file(Path, Digest) <- want(Glob), /soopy/watch(Glob, Path, Digest).

rel def_site(path: text, name: text).
def_site(Path, Name) <-
  source_file(Path, Digest),
  /extract/call_node_at(Path, Digest, "call", 'node', 'call', 'function', Name).
def_site(Path, Name) <-
  source_file(Path, Digest),
  /extract/call_node_at(Path, Digest, "call", 'node', 'call', 'method', Name).

# rx: rows$.pipe(map(rows => sortBy(rows, [desc('defs'), 'path'])))
rel module_defs(path: text, defs: int).
module_defs(Path, count(Name)) <- def_site(Path, Name).

? module_defs(path, defs) order by defs desc, path.
