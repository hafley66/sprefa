# GENERATED by `dl6 build`. Do not hand-edit; rebuild.
# `[workspace]` makes the generated crate its own root, so it does not read the
# engine crate's workspace table from a parent directory.
[workspace]

[package]
name = "__DL6_CRATE_NAME__"
version = "0.0.0"
edition = "2021"

[[bin]]
name = "__DL6_CRATE_NAME__"
path = "src/main.rs"

[dependencies]
anyhow = "1"
clap = { version = "4", features = ["derive"] }
serde = { version = "1", features = ["derive"] }
serde_json = "1"
tempfile = "3"
tokio = { version = "1", features = ["rt-multi-thread", "macros", "signal", "net", "sync", "time"] }
tokio-util = "0.7"
sprefa-engine-rs = { path = "__DL6_ENGINE_PATH__" }
