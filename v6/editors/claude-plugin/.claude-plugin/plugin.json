{
  "name": "dl-rails",
  "description": "sprefa dl in one install: rails LSP diagnostics, the authoring skill, an MCP query server, and the rail hook. The whole dl surface, namespaced.",
  "version": "0.2.0",
  "lspServers": {
    "dl": {
      "command": "dl",
      "args": ["--lsp"],
      "extensionToLanguage": {
        ".rs": "rust"
      },
      "transport": "stdio",
      "diagnostics": true,
      "startupTimeout": 10000,
      "maxRestarts": 3
    }
  },
  "mcpServers": {
    "dl": {
      "command": "dl",
      "args": ["--mcp", "${CLAUDE_PLUGIN_ROOT}/mcp-server.dl"]
    }
  },
  "hooks": "./hooks/hooks.json"
}
