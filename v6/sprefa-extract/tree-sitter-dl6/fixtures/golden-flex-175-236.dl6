# Extracted verbatim from v6/dl/fixtures/golden-flex.dl6 lines 175-236.
# A bare `rel` whose NAME is used as another column's TYPE is a struct type
# (type_decl/2 in term form; ruling compound_storage = struct_as_rows). `plot`
# is the leaf, `patch` carries a plot, and `tree.site` carries a patch -- so
# reading one `tree` row is a two-hop dictionary chain. Both hop targets are
# ordinary public rels and appear in the tick log in the same tick as the parent.
rel plot(row: int, col: int).                      # type_decl/2 leaf; col_type/3 int
rel patch(label: text, at: plot).                  # depth 1: a struct field typed by a struct

# ═══ the world's arrival targets (EDB) ═══════════════════════════════════════════
# Nothing derives these; the schedule pushes them. Every column carries a
# col_type/3 entry, `bool` and `float` among them -- the two types a `rel` decl
# accepts and an `sh`/`bind` decl does not (the door disagreement above).
rel tree(tree_id: int, species: text, site: patch).   # depth 2: patch -> plot
rel pick_event(tree_id: int, picker: text, kilos: float, sugar: int).
rel retire_event(tree_id: int).
rel quarantined(species: text).
rel sensor(tree_id: int, healthy: bool).

# ═══ json value and pattern axis ═══════════════════════════════════════════════════
# JSON object pattern `{k: v}` over a decoded object.
rel orchard_json(tree_id: int, payload: json).
rel orchard_card(tree_id: int, species: text).
orchard_card(TreeId, Species) <-
  orchard_json(TreeId, JsonPayload),
  decode(JsonPayload, {species: Species}).

# Open object pattern with a typed capture `{stars: Stars: int}`.
rel orchard_stars(tree_id: int, stars: int).
orchard_stars(TreeId, Stars) <-
  orchard_json(TreeId, JsonPayload),
  decode(JsonPayload, {stars: Stars: int}).

# `$key` capture over the dynamic tag object, with an integer value capture.
rel orchard_tag(tree_id: int, tag: text, value: int).
orchard_tag(TreeId, TagKey, TagValue) <-
  orchard_json(TreeId, JsonPayload),
  decode(JsonPayload, {tags: {$TagKey: TagValue: int}}).

# `**` descent reaches the nested leaf at any object depth.
rel orchard_leaf(tree_id: int, leaf: int).
orchard_leaf(TreeId, Leaf) <-
  orchard_json(TreeId, JsonPayload),
  decode(JsonPayload, {'**': {leaf: Leaf: int}}).

# Array spread `[... {…}]` fans out correlated item fields.
rel orchard_item(tree_id: int, fruit: text, item_stars: int).
orchard_item(TreeId, Fruit, ItemStars) <-
  orchard_json(TreeId, JsonPayload),
  decode(JsonPayload, {items: spread({fruit: Fruit, stars: ItemStars: int})}).

# `{}` empty-object match accepts the empty object and excludes arrays/scalars.
rel orchard_has_empty(tree_id: int).
orchard_has_empty(TreeId) <-
  orchard_json(TreeId, JsonPayload),
  decode(JsonPayload, {empty: {}}).

# An arriving list(T) carrier fans out through spread.
rel orchard_list(tree_id: int, tags: json_list(text)).
rel orchard_list_tag(tree_id: int, tag: text).
orchard_list_tag(TreeId, Tag) <-
  orchard_list(TreeId, Tags),
  decode(Tags, spread(Tag)).
