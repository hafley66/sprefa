# rust execution-strategy shootout (interp/rxgraph/mono), chain/grid/layered at 10k/100k/1M
# standings: labs/exec_shootout/STANDINGS.md (expect: chain 10k mono fp rows/sec ~7e7)
shootout work_dir="/tmp/sprefa-shootout":
