# v6 — prolog compiler front (tsv2) + TS runtimes. Run from here:
# `cd v6 && just` (lists recipes). Every recipe is the exact command the
# coordinator runs as a review gate; nothing here is aspirational.
#
# Layout the recipes map onto:
#   prolog/conformance/  the 135-fixture baseline plus the keep refusal fixture
#   prolog/compile/      the tsv2 compiler: parse_dl/print_dl/analyze/lower/
#                        registry.pl, plunit tests, roundtrip.sh, sweep.pl
#   prolog/ARCH.pl       machine-checked architecture claims (go)
#   tsv2/                A runtime + generated programs, sweep driver, import gate
#   dl/                  the v6 dl app (http server, hosts, binds, tracing)
#   sprefa-store/        rust store + js port + the scale bench harness

v6 := justfile_directory()

default:
	@just --list

# ── prolog side ──

# the fixture corpus vs the oracle engine (expect: 156 PASS, nothing else)
conformance:
	cd {{v6}}/prolog/conformance && swipl -q -l go.pl -g go -g halt

# parse -> print -> reparse identity over all fixtures + real .dl files
roundtrip:
	cd {{v6}}/prolog/compile && bash scripts/roundtrip.sh

# term door vs .dl6 text door, byte-identical emitted modules (expect: 95/95/0)
text-door:
	cd {{v6}}/prolog && bash compile/scripts/text_door_receipt.sh

# compiler unit tests (expect: 137/137 and growing)
plunit:
	cd {{v6}}/prolog/compile && swipl -q -l test/plunit_tests.pl -g run_tests -g halt

# architecture claims machine-check + atlas re-emit
arch:
	swipl -q -l {{v6}}/prolog/ARCH.pl -g go -g halt

# read-only organization gate: parse errors, duplicate modules, undefined
# predicates, private cross-module calls, redefinitions, void declarations,
# trivial fails, format errors. Ratcheted against
# prolog/tools/prolog-lint-baseline.txt; unused exports are advisory output.
prolog-lint:
	cd {{v6}}/prolog && bash tools/prolog-lint.sh

# ── tsv2 (prolog compiles TO TypeScript) ──

# full corpus sweep: compile every fixture, replay vs oracle tick logs
# (expect: RUN total=95 identical=93 wrong=0; slow, minutes)
sweep:
	cd {{v6}}/tsv2 && bash scripts/sweep.sh

# the bop CLI's own receipts (exit-code contract 0/2/1 + inventory parity);
# convenience slice -- these also run inside tsv2-test
bop-test:
	cd {{v6}}/tsv2 && node --test --experimental-transform-types tests/bopCheck.test.ts tests/bopRun.test.ts tests/bopLoadQuery.test.ts tests/bopCommandInventory.test.ts

# tsv2 runtime + served-engine tests (expect: 92 pass / 1 skip, and growing)
tsv2-test:
	cd {{v6}}/tsv2 && npm test

# generated files import only the named runtime seams (class-34 law)
import-gate:
	cd {{v6}}/tsv2 && bash scripts/check-imports.sh

# the TypeScript compiler over tsv2 (runtime, serve, cli, gen_emitted, tests).
# `npm test` runs node --experimental-transform-types, which STRIPS types and
# checks none of them, so before this recipe existed the package sat 4 errors
# red with no gate noticing. Several standing laws in this repo (header
# interfaces, one-declaration-per-name, no free contract-carrying exports)
# are enforceable only by a compiler that actually runs.
# (expect: no output, exit 0)
typecheck:
	cd {{v6}}/tsv2 && npx tsgo --noEmit -p tsconfig.json

# ── TS apps ──

# the v6 dl app suite (expect: 97 tests, 1 soak skip)
dl-test:
	cd {{v6}}/dl && npm test

# js store port suite
store-test:
	cd {{v6}}/sprefa-store/js && npm test

# THE END GOAL, executable: kill -9 mid-delay, reboot, value lands exactly once
endurance:
	bash {{v6}}/dl/scripts/goal-endurance.sh

# long-running server leak gate: one process, repeated swaps/commits/SSE teardown
leak-soak:
	bash {{v6}}/dl/scripts/leak-soak.sh

# the SERVED TSV2 engine's own end goal: kill -9 mid-nap, restart, answered
# witnesses never refire (runtime-bridge arc receipt 5)
serve-endurance:
	cd {{v6}}/tsv2 && bash scripts/endurance.sh

# the served tsv2 engine's leak gate: 20 program swaps, handles/timers/SSE flat
serve-leak-soak:
	cd {{v6}}/tsv2 && bash scripts/leak-soak.sh

# the golden plan's PHASE 4 LSP EXIT RECEIPT: v5's own `dl --lsp --diag-db`
# reading a live tsv2-served diag_v5 table -- zero new LSP code, real stdio
# JSON-RPC against the real v5 binary, appear + retract proven engine-side
# and LSP-side (expect: LSP DIAGS HOLDS, exit 0)
lsp-diags:
	cd {{v6}}/tsv2 && bash scripts/lsp-diags.sh

# THE ALPHA'S HEADLINE RECEIPT: v5's own examples/callgraph-ast.dl and the v6
# port of it, both over one pinned corpus, diffed rel by rel with every row of
# difference bucketed and proven (expect: FLAGSHIP CALLGRAPH GRADED, 0
# unclassified, exit 0; builds target/release/dl and the release extractor on
# first run, seconds after)
flagship:
	cd {{v6}}/tsv2 && bash scripts/flagship-callgraph.sh

# the golden plan's PHASE 2 EXIT RECEIPT: an sg-rail-class diag rail end to end
# on real file edits -- watcher, extractor, retraction, and kill -9 mid-extraction
# (expect: EXTRACTION LIVE HOLDS, 8 phases, exit 0; builds the release extractor
# on first run via cargo build --release --features cli)
extraction-live:
	cd {{v6}}/tsv2 && bash scripts/extraction-live.sh

# Standing comment-node production rails: compile every rail, grade each
# technique against a fresh live extraction feed, then run the pinned v5/v6
# parity comparison for comment_node and arch_node.
comment-rails:
	bash {{v6}}/tsv2/scripts/comment-rails.sh
	bash {{v6}}/tsv2/scripts/comment-parity.sh

# the file-set feed against THIS repo: enumerate = git ls-files exactly, zero
# node_modules rows, enumerate_at reports git's own blob oids
# (expect: ENUMERATE HOSTS HOLD, exit 0; needs a populated node_modules)
enumerate:
	cd {{v6}}/tsv2 && bash scripts/enumerate.sh

# sustained assert/retract churn on one served program; process memory,
# sqlite page count, and statements/tick must all stay flat post-warmup
# (expect: MEMORY SOAK HOLDS, exit 0; TSV2_SOAK_LONG=1 for an overnight run)
memory-soak:
	cd {{v6}}/tsv2 && bash scripts/memory-soak.sh

# THE COMPOSITION RECEIPT: one program (dl/fixtures/golden-flex.dl6) exercising
# every live registry construct, graded six ways -- coverage gate (a new registry
# row fails it BY NAME), text door, three cardinalities (0 / 1 / 100 rows per
# input rel) plus a perturbed schedule against the oracle and BOTH emitter modes
# on tick log AND final state, emitter-mode parity, the norm/1 inverted receipt,
# and the served HTTP e2e leg with a live subprocess host
# (expect: GOLDEN FLEX HOLDS, exit 0; ~30s)
golden-flex:
	bash {{v6}}/tsv2/scripts/golden-flex.sh

# exactly one terminal subscription per app (dl/src and tsv2/serve)
one-subscribe:
	bash {{v6}}/tools/one-subscribe.sh

# stopping-point program #1 on the keyed clock/etag feedback shape: one hermetic
# five-tick schedule replayed through BOTH the oracle and the emitted runtime,
# byte-diffed three ways (expected vs oracle, expected vs emitted, oracle vs
# emitted) on tick logs and final relations. No gh, no shell host, no wall clock,
# no network. Tick 5 is the point: a late response for a departed witness
# replaces its raw host row and produces no public delta
# (expect: GHCACHER_CLOCK_GOLDEN_HOLDS ticks=5 final=1, exit 0)
ghcacher-golden:
	bash {{v6}}/tsv2/goldens/ghcacher_tick_golden/6_gate.sh

# checked-in gen_emitted modules with no fixture row (door-handwritten.ts)
# regenerated + diffed against their .dl6 source; target/release/dl and
# sprefa-extract's release binary refused if a source .rs/Cargo.toml is
# newer than the built binary -- both classes went silently stale before
# (expect: STALENESS_GATE_OK, exit 0)
staleness-gate:
	bash {{v6}}/tools/staleness-gate.sh

# ── benches ──

# the house scale-test rig (engines/*.sh emit a shared CSV protocol)
bench:
	cd {{v6}}/sprefa-store/bench && bash run.sh

# ── batteries ──

# the review-gate battery minus the slow sweep; what a merge must pass
green: conformance roundtrip text-door plunit prolog-lint typecheck tsv2-test import-gate one-subscribe golden-flex dl-test store-test

# everything, including the sweep
green-all: green endurance leak-soak serve-endurance serve-leak-soak memory-soak extraction-live enumerate flagship lsp-diags ghcacher-golden sweep staleness-gate
