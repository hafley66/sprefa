# v6 — prolog compiler front (tsv2) + TS runtimes. Run from here:
# `cd v6 && just` (lists recipes). Every recipe is the exact command the
# coordinator runs as a review gate; nothing here is aspirational.
#
# Layout the recipes map onto:
#   prolog/conformance/  the 221-fixture baseline (oracle engine + fixtures)
#   prolog/compile/      the tsv2 compiler: parse_dl_dcg/print_dl/analyze/lower/
#                        registry.pl, plunit tests, roundtrip.sh, sweep.pl
#   prolog/ARCH.pl       machine-checked architecture claims (go)
#   tsv2/                A runtime + generated programs, sweep driver, import gate
#   dl/                  the v6 dl app (http server, hosts, binds, tracing)
#   sprefa-store/        rust store + js port + the scale bench harness

v6 := justfile_directory()

# THE TIMEOUT GUN (timeout-gun lane, 2026-07-31). Standing law: every compute
# invocation runs under a budget with a NAMED timeout failure. The receipt
# SCRIPTS fire their own gun (each states its measured wall beside its default
# in its own header); the recipes below that call swipl / node / tsgo DIRECTLY
# have no script to carry a budget, so they go through the helper in command
# form. Exit 124 is the coreutils budget-exceeded convention, and `just`
# reports it as `Recipe <name> failed ... with exit code 124`, which names the
# recipe -- the helper's own named line only exists for its sourced form.
#
# Every default below is stated beside the wall it was measured against on the
# development machine, and every one is deliberately loose: these legs cost
# seconds, so a tight multiple would be measuring machine load rather than the
# work. The number each encodes is "this tool has stopped being this tool".
capped := justfile_directory() + "/tools/run-capped.sh"

default:
    @just --list

# ── prolog side ──

# the fixture corpus vs the oracle engine (expect: 281 PASS, 0 fail; go.pl
# exits 1 on any fail since the grader-exit gate landed)
# budget: measured 0.2s, default 300s (CONFORMANCE_BUDGET_S)
conformance:
    cd {{ v6 }}/prolog/conformance && {{ capped }} "${CONFORMANCE_BUDGET_S:-300}" swipl -q -l go.pl -g go -g halt

# parse -> print -> reparse identity over all fixtures + real .dl files
roundtrip:
    cd {{ v6 }}/prolog/compile && bash scripts/roundtrip.sh

# term door vs .dl6 text door, byte-identical emitted modules (expect: 196/196/0)
text-door:
    cd {{ v6 }}/prolog && bash compile/scripts/text_door_receipt.sh

# compiler unit tests (expect: the failing set allowlisted in
# .github/CI-KNOWN-RED.md and nothing else). test/run_plunit.pl runs the
# units on PLUNIT_JOBS workers (default cpu_count) and prints the slowest tests,
# the slowest units, and one sorted `FAIL unit:name` line per failure.
# PLUNIT_JOBS=1 is the old sequential run.
# budget: measured 37.2-45.6s at jobs=1 / 12.3-15.8s at jobs=12 (12-core), default
# 600s (PLUNIT_BUDGET_S)
plunit:
    cd {{ v6 }}/prolog/compile && {{ capped }} "${PLUNIT_BUDGET_S:-600}" swipl -q -l test/run_plunit.pl -g plunit_run -t halt

# The dead-module rail against the two tools that answer the same question in
# other ecosystems. rustc's dead_code lint cannot see a `pub` item in a lib
# crate; knip cannot see an imported module nothing calls. Each fixture labels
# every file with what BOTH tools must say, so a rail that drifts either way
# goes red. budget: measured 12s rust / 20s js (knip resolves through npx).
oracle-rustc:
    {{ capped }} "${ORACLE_BUDGET_S:-600}" bash {{ v6 }}/dl/deadcode/oracle-rustc.sh

oracle-knip:
    {{ capped }} "${ORACLE_BUDGET_S:-600}" bash {{ v6 }}/dl/deadcode/oracle-knip.sh

# scip + diet_scip extractor families smoke: real scip-typescript index
# through the served engine (SCIP FAMILIES HOLD). budget: measured 9s,
# default 600s (SCIP_FAMILIES_BUDGET_S)
scip-families:
    cd {{ v6 }}/tsv2 && {{ capped }} "${SCIP_FAMILIES_BUDGET_S:-600}" bash scripts/scip-families.sh

# extract ratchet (LOCAL-ONLY, never in CI): one process per (lang, tier) leg, so rss_mb is that pair's peak alone.
# Floors: plans/extract-bench-2026-08-29/RATCHET.tsv (lang, family, tier, oracle; 0.10pt) + RATCHET.cost.tsv (lang, tool, tier; +15%/+10%).
extract-ratchet:
    #!/usr/bin/env bash
    set -euo pipefail
    cd {{ v6 }}/sprefa-extract
    for leg in ts5_syntax ts5_checker go_syntax go_checker rust_syntax rust_checker; do
      {{ capped }} "${EXTRACT_RATCHET_BUDGET_S:-900}" cargo test --release --features cli,rust-checker,ts-checker,go-checker --test ratchet_recall -- --exact --ignored --nocapture "ratchet_${leg}"
    done
    # Same feature set as the legs above: a narrower one rebuilds the whole tree.
    {{ capped }} "${EXTRACT_RATCHET_BUDGET_S:-900}" cargo test --release --features cli,rust-checker,ts-checker,go-checker --test bench_normal_form -- --exact --ignored --nocapture rust_normal_form_agrees_with_normalize_py_over_the_go_corpus

# architecture claims machine-check + atlas re-emit
# budget: measured 0.9s, default 300s (ARCH_BUDGET_S)
arch:
    {{ capped }} "${ARCH_BUDGET_S:-300}" swipl -q -l {{ v6 }}/prolog/ARCH.pl -g go -g halt
    awk 'length($0) > 600 { printf "ARCH.pl:%d exceeds 600 characters\n", NR > "/dev/stderr"; failed = 1 } END { exit failed }' {{ v6 }}/prolog/ARCH.pl

# go-to-reference, both module systems; fails on a prolog import naming a
# predicate its target does not export. (expect: dangling=0, crossings=2, exit 0)
xref:
    bash {{ v6 }}/tools/xref.sh

# read-only organization gate: parse errors, duplicate modules, undefined
# predicates, private cross-module calls, redefinitions, void declarations,
# trivial fails, format errors. Ratcheted against
# prolog/tools/prolog-lint-baseline.txt; unused exports are advisory output.
prolog-lint:
    cd {{ v6 }}/prolog && bash tools/prolog-lint.sh

# lower.pl coverage census: throw sites vs manifest.json reasons, plus
# never-entered clause arms over the corpus compile. See scripts/arm_census.pl.
# `just optional`, not green-all: SWI coverage/2 wraps the whole 461-fixture
# corpus compile, which is a wall no merge gate can carry.
arm-census:
    {{ capped }} "${ARM_CENSUS_BUDGET_S:-3600}" bash {{ v6 }}/prolog/compile/scripts/arm_census.sh

# SYNTAX.md / CONSTRUCT-REFERENCE.md staleness (staleness-gate.sh §c shape):
# regenerate, fail if checked-in bytes differ, always restore the tree.
docs-staleness:
    swipl -q -l {{ v6 }}/prolog/compile/1_emit_registry_docs.pl -g emit_registry_docs -g halt
    test -x {{ v6 }}/sprefa-extract/target/release/extract || (cd {{ v6 }}/sprefa-extract && cargo build --release --features cli --bin extract)
    bash {{ v6 }}/tsv2/scripts/reference-docs.sh >/dev/null
    git diff --exit-code -- prolog/compile/SYNTAX.md prolog/compile/CONSTRUCT-REFERENCE.md; rc=$?; git checkout -- prolog/compile/SYNTAX.md prolog/compile/CONSTRUCT-REFERENCE.md prolog/compile/HOST-CONTRACTS.md ../editors/vscode-dl/syntaxes/dl6.tmLanguage.json; exit $rc

# ratcheted compiler-cost gate: SWI inference counts per pinned .dl6 program
# per phase, against scripts/compile-speed-baseline.tsv. Inferences because
# they are byte-reproducible run to run where wall ms is not -- the 255s
# clock_check SCC regression was invisible to every gate that existed.
# Wall ms printed informationally, never gated.
# (expect: COMPILE_SPEED programs=4 phases=24 regressions=0 improvements=0 OK)
compile-speed:
    cd {{ v6 }}/prolog/compile && bash scripts/1_compile_speed.sh

compile-profile program:
    program_name="{{ program }}"; program_name="${program_name#program=}"; profile_scratch="$(mktemp -d "${TMPDIR:-/tmp}/sprefa-compile-profile.XXXXXX")"; trap 'rm -rf "$profile_scratch"' EXIT; cd {{ v6 }}/prolog/compile && {{ capped }} 120 swipl -q -l ../6_profile.pl -g "compile_profile:execution_profile_dl6('{{ v6 }}/dl/fixtures/$program_name.dl6','$profile_scratch/$program_name.ts')" -g halt

# ── tsv2 (prolog compiles TO TypeScript) ──

# full corpus sweep: compile every fixture, replay vs oracle tick logs
# (expect: RUN total=211 identical=210 wrong=0 emitted_crash=0 rejection=1;
#  exits 1 if emitted_crash is non-zero -- an emitted module that died on a
#  schedule the oracle completed)
# Tail stage 4 prints MANIFEST_REASON_DIFF: refusal reasons vs git HEAD, the one
# gate here that is not a bucket count (expect: restated=0 on a no-op re-run).
# Informational; MANIFEST_DIFF_STRICT=1 makes a restatement fail the recipe.
sweep:
    cd {{ v6 }}/tsv2 && bash scripts/sweep.sh

# the bop CLI's own receipts (exit-code contract 0/2/1, the located refusal's
# file:line, and inventory parity); convenience slice -- these also run inside
# tsv2-test (expect: 15 pass)
# budget: measured 2.6s, default 300s (BOP_TEST_BUDGET_S)
bop-test:
    cd {{ v6 }}/tsv2 && {{ capped }} "${BOP_TEST_BUDGET_S:-300}" node --test --experimental-transform-types tests/bopCheck.test.ts tests/bopRun.test.ts tests/bopLoadQuery.test.ts tests/bopCommandInventory.test.ts

# tsv2 runtime + served-engine tests (expect: 127 pass / 1 skip, and growing)
tsv2-test:
    cd {{ v6 }}/tsv2 && npm test

# generated files import only the named runtime seams (class-34 law)
import-gate:
    cd {{ v6 }}/tsv2 && bash scripts/check-imports.sh

# the TypeScript compiler over tsv2 (runtime, serve, cli, gen_emitted, tests).
# `npm test` runs node --experimental-transform-types, which STRIPS types and
# checks none of them, so before this recipe existed the package sat 4 errors
# red with no gate noticing. Several standing laws in this repo (header
# interfaces, one-declaration-per-name, no free contract-carrying exports)
# are enforceable only by a compiler that actually runs.
# (expect: no output, exit 0)
# budget: measured 0.6s, default 600s -- looser than the wall suggests because
# a cold `npx` may fetch before it compiles (TYPECHECK_BUDGET_S)
typecheck:
    cd {{ v6 }}/tsv2 && {{ capped }} "${TYPECHECK_BUDGET_S:-600}" npx tsgo --noEmit -p tsconfig.json

