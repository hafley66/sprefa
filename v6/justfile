# v6 — prolog compiler front (tsv2) + TS runtimes. Run from here:
# `cd v6 && just` (lists recipes). Every recipe is the exact command the
# coordinator runs as a review gate; nothing here is aspirational.
#
# Layout the recipes map onto:
#   prolog/conformance/  the 221-fixture baseline (oracle engine + fixtures)
#   prolog/compile/      the tsv2 compiler: parse_dl/print_dl/analyze/lower/
#                        registry.pl, plunit tests, roundtrip.sh, sweep.pl
#   prolog/ARCH.pl       machine-checked architecture claims (go)
#   tsv2/                A runtime + generated programs, sweep driver, import gate
#   dl/                  the v6 dl app (http server, hosts, binds, tracing)
#   sprefa-store/        rust store + js port + the scale bench harness

v6 := justfile_directory()

# THE TIMEOUT GUN (timeout-gun lane, 2026-07-31). Standing law: every compute
# invocation runs under a budget with a NAMED timeout failure. The receipt
# SCRIPTS fire their own gun (each states its measured wall beside its default
# in its own header); the recipes below that call swipl / node / tsgo DIRECTLY
# have no script to carry a budget, so they go through the helper in command
# form. Exit 124 is the coreutils budget-exceeded convention, and `just`
# reports it as `Recipe <name> failed ... with exit code 124`, which names the
# recipe -- the helper's own named line only exists for its sourced form.
#
# Every default below is stated beside the wall it was measured against on the
# development machine, and every one is deliberately loose: these legs cost
# seconds, so a tight multiple would be measuring machine load rather than the
# work. The number each encodes is "this tool has stopped being this tool".
capped := justfile_directory() + "/tools/run-capped.sh"

default:
	@just --list

# ── prolog side ──

# the fixture corpus vs the oracle engine (expect: 281 PASS, 0 fail; go.pl
# exits 1 on any fail since the grader-exit gate landed)
# budget: measured 0.2s, default 300s (CONFORMANCE_BUDGET_S)
conformance:
	cd {{v6}}/prolog/conformance && {{capped}} "${CONFORMANCE_BUDGET_S:-300}" swipl -q -l go.pl -g go -g halt

# parse -> print -> reparse identity over all fixtures + real .dl files
roundtrip:
	cd {{v6}}/prolog/compile && bash scripts/roundtrip.sh

# term door vs .dl6 text door, byte-identical emitted modules (expect: 196/196/0)
text-door:
	cd {{v6}}/prolog && bash compile/scripts/text_door_receipt.sh

# compiler unit tests (expect: 269/269 and growing)
# budget: measured 40.8s, default 600s (PLUNIT_BUDGET_S)
plunit:
	cd {{v6}}/prolog/compile && {{capped}} "${PLUNIT_BUDGET_S:-600}" swipl -q -l test/plunit_tests.pl -g run_tests -g halt

# scip + diet_scip extractor families smoke: real scip-typescript index
# through the served engine (SCIP FAMILIES HOLD). budget: measured 9s,
# default 600s (SCIP_FAMILIES_BUDGET_S)
scip-families:
	cd {{v6}}/tsv2 && {{capped}} "${SCIP_FAMILIES_BUDGET_S:-600}" bash scripts/scip-families.sh

# architecture claims machine-check + atlas re-emit
# budget: measured 0.9s, default 300s (ARCH_BUDGET_S)
arch:
	{{capped}} "${ARCH_BUDGET_S:-300}" swipl -q -l {{v6}}/prolog/ARCH.pl -g go -g halt

# read-only organization gate: parse errors, duplicate modules, undefined
# predicates, private cross-module calls, redefinitions, void declarations,
# trivial fails, format errors. Ratcheted against
# prolog/tools/prolog-lint-baseline.txt; unused exports are advisory output.
prolog-lint:
	cd {{v6}}/prolog && bash tools/prolog-lint.sh

# ratcheted compiler-cost gate: SWI inference counts per pinned .dl6 program
# per phase, against scripts/compile-speed-baseline.tsv. Inferences because
# they are byte-reproducible run to run where wall ms is not -- the 255s
# clock_check SCC regression was invisible to every gate that existed.
# Wall ms printed informationally, never gated.
# (expect: COMPILE_SPEED programs=4 phases=24 regressions=0 improvements=0 OK)
compile-speed:
	cd {{v6}}/prolog/compile && bash scripts/1_compile_speed.sh

compile-profile program:
	program_name="{{program}}"; program_name="${program_name#program=}"; profile_scratch="$(mktemp -d "${TMPDIR:-/tmp}/sprefa-compile-profile.XXXXXX")"; trap 'rm -rf "$profile_scratch"' EXIT; cd {{v6}}/prolog/compile && {{capped}} 120 swipl -q -l ../6_profile.pl -g "compile_profile:execution_profile_dl6('{{v6}}/dl/fixtures/$program_name.dl6','$profile_scratch/$program_name.ts')" -g halt

# ── tsv2 (prolog compiles TO TypeScript) ──

# full corpus sweep: compile every fixture, replay vs oracle tick logs
# (expect: RUN total=196 identical=195 wrong=0 emitted_crash=0 rejection=1;
#  exits 1 if emitted_crash is non-zero -- an emitted module that died on a
#  schedule the oracle completed; slow, minutes)
# Tail stage 4 prints MANIFEST_REASON_DIFF: refusal reasons vs git HEAD, the one
# gate here that is not a bucket count (expect: restated=0 on a no-op re-run).
# Informational; MANIFEST_DIFF_STRICT=1 makes a restatement fail the recipe.
sweep:
	cd {{v6}}/tsv2 && bash scripts/sweep.sh

# the bop CLI's own receipts (exit-code contract 0/2/1, the located refusal's
# file:line, and inventory parity); convenience slice -- these also run inside
# tsv2-test (expect: 15 pass)
# budget: measured 2.6s, default 300s (BOP_TEST_BUDGET_S)
bop-test:
	cd {{v6}}/tsv2 && {{capped}} "${BOP_TEST_BUDGET_S:-300}" node --test --experimental-transform-types tests/bopCheck.test.ts tests/bopRun.test.ts tests/bopLoadQuery.test.ts tests/bopCommandInventory.test.ts

# tsv2 runtime + served-engine tests (expect: 127 pass / 1 skip, and growing)
tsv2-test:
	cd {{v6}}/tsv2 && npm test

# generated files import only the named runtime seams (class-34 law)
import-gate:
	cd {{v6}}/tsv2 && bash scripts/check-imports.sh

# the TypeScript compiler over tsv2 (runtime, serve, cli, gen_emitted, tests).
# `npm test` runs node --experimental-transform-types, which STRIPS types and
# checks none of them, so before this recipe existed the package sat 4 errors
# red with no gate noticing. Several standing laws in this repo (header
# interfaces, one-declaration-per-name, no free contract-carrying exports)
# are enforceable only by a compiler that actually runs.
# (expect: no output, exit 0)
# budget: measured 0.6s, default 600s -- looser than the wall suggests because
# a cold `npx` may fetch before it compiles (TYPECHECK_BUDGET_S)
typecheck:
	cd {{v6}}/tsv2 && {{capped}} "${TYPECHECK_BUDGET_S:-600}" npx tsgo --noEmit -p tsconfig.json

# ── TS apps ──

# the v6 dl app suite (expect: 97 tests, 1 soak skip)
dl-test:
	cd {{v6}}/dl && npm test

# js store port suite
store-test:
	cd {{v6}}/sprefa-store/js && npm test

# THE END GOAL, executable: kill -9 mid-delay, reboot, value lands exactly once
endurance:
	bash {{v6}}/dl/scripts/goal-endurance.sh

# long-running server leak gate: one process, repeated swaps/commits/SSE teardown
leak-soak:
	bash {{v6}}/dl/scripts/leak-soak.sh

# the SERVED TSV2 engine's own end goal: kill -9 mid-nap, restart, answered
# witnesses never refire (runtime-bridge arc receipt 5)
serve-endurance:
	cd {{v6}}/tsv2 && bash scripts/endurance.sh

# the served tsv2 engine's leak gate: 20 program swaps, handles/timers/SSE flat
serve-leak-soak:
	cd {{v6}}/tsv2 && bash scripts/leak-soak.sh

# the golden plan's PHASE 4 LSP EXIT RECEIPT: v5's own `dl --lsp --diag-db`
# reading a live tsv2-served diag_v5 table -- zero new LSP code, real stdio
# JSON-RPC against the real v5 binary, appear + retract proven engine-side
# and LSP-side (expect: LSP DIAGS HOLDS, exit 0)
lsp-diags:
	cd {{v6}}/tsv2 && bash scripts/lsp-diags.sh

# THE ALPHA'S HEADLINE RECEIPT: v5's own examples/callgraph-ast.dl and the v6
# port of it, both over one pinned corpus, diffed rel by rel with every row of
# difference bucketed and proven (expect: FLAGSHIP CALLGRAPH GRADED, 0
# unclassified, exit 0; builds target/release/dl and the release extractor on
# first run, seconds after)
flagship:
	cd {{v6}}/tsv2 && bash scripts/flagship-callgraph.sh

# the golden plan's PHASE 2 EXIT RECEIPT: an sg-rail-class diag rail end to end
# on real file edits -- watcher, extractor, retraction, and kill -9 mid-extraction
# (expect: EXTRACTION LIVE HOLDS, 8 phases, exit 0; builds the release extractor
# on first run via cargo build --release --features cli)
extraction-live:
	cd {{v6}}/tsv2 && bash scripts/extraction-live.sh

# Standing comment-node production rails: compile every rail, grade each
# technique against a fresh live extraction feed, then run the pinned v5/v6
# parity comparison for comment_node and arch_node.
comment-rails:
	bash {{v6}}/tsv2/scripts/comment-rails.sh
	bash {{v6}}/tsv2/scripts/comment-parity.sh

# the file-set feed against THIS repo: files = git ls-files exactly, zero
# node_modules rows, files_at reports git's own blob oids; then the REPO-SCOPED
# pair (repo_files / repo_files_at) against a scratch two-file repository that
# is not the server's cwd, with its worktree edited after the commit so the two
# hosts must disagree on the same path
# (expect: FILES HOSTS HOLD, 7 PASS lines, exit 0; needs a populated
#  node_modules)
files:
	cd {{v6}}/tsv2 && bash scripts/files.sh

# sustained assert/retract churn on one served program; process memory,
# sqlite page count, and statements/tick must all stay flat post-warmup
# (expect: MEMORY SOAK HOLDS, exit 0; TSV2_SOAK_LONG=1 for an overnight run)
memory-soak:
	cd {{v6}}/tsv2 && bash scripts/memory-soak.sh

# THE COMPOSITION RECEIPT: one program (dl/fixtures/golden-flex.dl6) exercising
# every live registry construct, graded six ways -- coverage gate (a new registry
# row fails it BY NAME), text door, three cardinalities (0 / 1 / 100 rows per
# input rel) plus a perturbed schedule against the oracle and BOTH emitter modes
# on tick log AND final state, emitter-mode parity, the norm/1 inverted receipt,
# and the served HTTP e2e leg with a live subprocess host
# (expect: GOLDEN FLEX HOLDS, exit 0; ~30s)
golden-flex:
	bash {{v6}}/tsv2/scripts/golden-flex.sh

# THE SYSTEM DESCRIBING ITSELF: v6/dl/fixtures/self-map.dl6 reads registry.pl's
# surface/5, 1_expansion.pl's expansion_phase/3, ARCH.pl's task/3 and its OWN
# rel graph (through analyze.pl) as `sh` host rows, derives the structure and
# complete document in ordinary dl6 rules, and writes v6/ARCH-MAP.md through
# the program's one output effect.
# Manual mode only -- no daemon, one ephemeral server, torn down on exit.
# Output is byte-stable across runs (ordered/value-sorted folds, no timestamps),
# which is what the staleness gate diffs.
# (expect: SELF MAP HOLDS, diagrams=4, exit 0; ~20s, spawns 4 swipl one-shots)
self-map:
	bash {{v6}}/tsv2/scripts/self-map.sh

# THE DATAFLOW ATLAS: four language planes auto-extracted (sprefa-extract over
# TypeScript, library(prolog_xref) over prolog, regex hosts over shell and over
# one emitted module's SQL), joined across the language gaps by six named bridge
# rules, and rendered by graphviz. v6/dl/fixtures/dataflow-atlas.dl6 derives
# every node, edge, count and the whole DOT text; the script owns only process
# lifecycle and the two env names the hosts read.
# FIVE drawings of the one graph: DATAFLOW-ATLAS.dot (clustered by language),
# -flat-td / -flat-lr (no clusters), -fs-td / -fs-lr (nested clusters mirroring
# the directory tree, the source read as one exploded file). All five .dot files
# are byte-stable across runs and the recipe PROVES it by running twice and
# digesting each (that is most of the wall time). It also asserts the five files
# hold the SAME node id set and that every node in the fs views sits inside the
# cluster chain its own path spells. NOT in green-all yet.
# (expect: ATLAS HOLDS, CYCLES=0 ORPHANS=0, SAME NODE SET, FS NESTING x2,
#  BYTE STABLE x5, exit 0; ~10min, two full runs, spawns one extractor process
#  per TS file and one swipl per .pl file. ~8.5min of that is the text door
#  compiling this program TWICE -- 4m16s each, up from 30s before the four
#  extra views, all of it 3_clock_check.pl's simple-path enumeration against
#  the filesystem fold; numbers in dataflow-atlas.dl6's header.)
atlas:
	bash {{v6}}/tsv2/scripts/atlas.sh

# v6/GETTING-STARTED.md, EXECUTED. Every marked block on that page is replayed
# in one persistent shell (so the backgrounded `bop serve` and the exports
# survive across blocks, exactly as a reader's terminal does) and its captured
# output is diffed against the text the page prints. Temp paths, content
# digests and epoch buckets normalize; every relation row is compared
# literally. A doc that drifts from the engine fails here rather than in a
# stranger's first thirty minutes.
# (expect: GETTING STARTED HOLDS: 24 blocks replayed, exit 0; ~16s)
getting-started:
	bash {{v6}}/tsv2/scripts/getting-started.sh

# exactly one terminal subscription per app (dl/src and tsv2/serve)
one-subscribe:
	bash {{v6}}/tools/one-subscribe.sh

# stopping-point program #1 on the keyed clock/etag feedback shape: one hermetic
# five-tick schedule replayed through BOTH the oracle and the emitted runtime,
# byte-diffed three ways (expected vs oracle, expected vs emitted, oracle vs
# emitted) on tick logs and final relations. No gh, no shell host, no wall clock,
# no network. Tick 5 is the point: a late response for a departed witness
# replaces its raw host row and produces no public delta
# (expect: GHCACHER_CLOCK_GOLDEN_HOLDS ticks=5 final=1, exit 0)
ghcacher-golden:
	bash {{v6}}/tsv2/goldens/ghcacher_tick_golden/6_gate.sh

# STOPPING-POINT PROGRAM #7: the RTK Query example corpus through the extraction
# spine. Four ast-grep patterns batch through ONE in-tree extractor process per
# file digest; the .dl6 does every union, capture join and scope-containment
# join. Graded against committed expected rows: exact half-open byte spans, the
# five-tick delta shape, demand add/del totals, and process count.
#
# The program, runner and pinned corpus all landed in 51ba4161 and were never
# wired into a battery; this recipe is that wiring, not a second rig. Its runner
# still lives under tsv2/labs/ and by the lab protocol ("labs die on landing")
# that residency is debt someone owns -- named here rather than moved, because
# the file is not this lane's.
#
# SABOTAGE RECEIPT (run 2026-07-30, reverted; tree clean after): added one
# `sabotage: builder.query(...)` endpoint to the pinned corpus fixture
# tests/fixtures/ast_pattern/0_rtkq.ts. The api_scope assertion went RED on the
# BYTE SPANS, not just the row count -- expected [api.ts,271,475] and
# [api.ts,505,643], got [api.ts,271,534] and [api.ts,564,702] -- ERR_ASSERTION,
# exit 1. Spans shifting is the discriminating signal: a gate that only counted
# rows would have caught the new endpoint but not a corpus edit that moves
# existing ones.
# (expect: exit 0, five ticks, responseRows [9,6], 2 processes, 2 demands)
rtkq-golden:
	bash {{v6}}/tsv2/scripts/6_rtkq-extraction-golden.sh

# STOPPING-POINT PROGRAM #5: the multirepo dep/repo/rev crawl, both engines over
# one pinned four-repo corpus. v5 runs examples/version-skew.dl byte-unmodified
# against a generated SPREFA_CONFIG; v6 runs goldens/multirepo_crawl over the
# same repos with the repo set posted as EDB rows. Every differing row is
# bucketed with a proof read from the corpus go.mod bytes.
# (expect: MULTIREPO CRAWL GRADED: 4/4 rels byte-identical, 1 named gap
#  (dep_ver = min/max over text refused), 0 unclassified, exit 0)
multirepo-golden:
	bash {{v6}}/tsv2/goldens/multirepo_crawl/2_gate.sh

# STOPPING-POINT PROGRAM #3: git pre-commit --changed, the biome-style
# recent-change-lines gating, spelled as ordinary rules. "Which files are NEW
# since a base revision" is a join between two rev-pinned `files_at` host
# answers with `not/1` over the base side; three finding classes ride it
# (banned pattern in a new file, missing required header, whole-tree ratchet
# above a committed ceiling) and land in v5's own 9-column diag_v5 schema.
#
# The receipt drives a REAL four-commit git repository through the served
# engine: c0 baseline, c1 adds one offending file AND one clean control file,
# c2 deletes the offender, c3 advances the base. Every assertion is sorted
# row-set equality, so a rail that fired on every new file would fail on the
# control rather than pass on a count. The ratchet's ceiling is proven data-
# driven by lowering it under an unchanged tree.
#
# The program and its receipt landed at 321a3d4c and were never wired into a
# battery; this recipe is that wiring.
# (expect: GIT-FACT DIAGS RAIL HOLDS, exit 0; ~20s, one ephemeral server)
precommit-changed:
	bash {{v6}}/tsv2/scripts/v5-git-diags.sh

# STOPPING-POINT PROGRAM #8 at scale: the watch bind's own cost and correctness
# curve. Duplicate path notifications, edits, identical re-saves and deletes are
# pushed through the real WatchBindRunner and coalesced by a virtual window; the
# final `watch` and `seen` relations are pinned by sha256, and any cell that
# decodes a duplicate, stale or missing row exits 1.
#
# Cost is REPORTED, not gated (wall ms and RSS are machine-dependent); the
# gated part is correctness at each size. A gated cost floor for this path --
# the scale-floor.sh treatment -- does not exist yet and is a named gap in
# v6/READINESS.md.
# (expect: two JSONL lines, correct:true, ticks flat at 3 across both sizes)
# budget: measured 0.7s at 100/1000 files, default 900s -- loose because the
# file counts are arguments and a bigger run is the point (WATCH_SCALE_BUDGET_S)
watch-scale:
	cd {{v6}}/tsv2 && {{capped}} "${WATCH_SCALE_BUDGET_S:-900}" env NODE_NO_WARNINGS=1 \
	  node --experimental-transform-types \
	  scripts/5_file-watch-scale.ts --files 100,1000 --events-per-file 3 \
	  --edit-ratio 0.25 --delete-ratio 0.10 --identical-resave-ratio 0.25

# the v5 surface inventory: every built-in rel, operator and function v5's
# examples/*.dl corpus actually uses, ranked by how many files name it, each
# marked covered / partial / absent against v6. Regenerates
# plans/2026-07-30-v5-parity-table.tsv, so it MUTATES A TRACKED FILE and is
# deliberately outside every battery -- run it when you want the number, and
# commit the table only when the movement is the point.
# (expect: V5 PARITY TABLE SEEDED, exit 0)
v5-parity:
	bash {{v6}}/tsv2/scripts/v5-parity.sh

# checked-in gen_emitted modules with no fixture row (door-handwritten.ts)
# regenerated + diffed against their .dl6 source; target/release/dl and
# sprefa-extract's release binary refused if a source .rs/Cargo.toml is
# newer than the built binary -- both classes went silently stale before
# (expect: STALENESS_GATE_OK, exit 0)
staleness-gate:
	bash {{v6}}/tools/staleness-gate.sh

# throughput floor at scale: s2 / 10k arrivals through the tsv2 emitter.
# statements-per-tick set is gated EXACTLY and must be the same at 10k and 1k
# (that equality across sizes is the delta-proportionality proof); ticks,
# arrivals, final rows and incrementalSafe are exact; wall gets a deliberately
# loose 3x floor because CI variance is real and a tight wall gate gets
# loosened until it catches nothing. Every run appends to
# goldens/scale-floor-history.jsonl so the curve exists over time.
# (expect: SCALE_FLOOR s2 rows=10000 stmts/tick=[37,41] flat-vs-1000 ... OK)
scale-floor:
	cd {{v6}}/tsv2 && bash scripts/7_scale-floor.sh

# ── benches ──

# the house scale-test rig (engines/*.sh emit a shared CSV protocol)
bench:
	cd {{v6}}/sprefa-store/bench && bash run.sh

# the language-agnostic CLI bench: one contract any engine implementation can
# satisfy, tick-log byte-diff against a referee, standings over the real
# programs + the s1/s2/s3 shapes. Gates the rust lowering (phase 0 of
# plans/2026-07-31-rust-course.md). Contract + buy-verdict + the promotion rule
# for the proven referee: v6/bench-cli/CONTRACT.md sections 2.5-2.7 and 7.
# (expect: BENCH-CLI timed=16 (swipl 11 / reference 5) disqualified=0
#  ungraded=0 hash-agreement=OK, exit 0. The 5 reference-tier cells are
#  s1/10k, s1/100k, s2/10k, s2/100k and s3/1k, where the swipl REFERENCE engine
#  exceeds its budget; they grade only while `just sweep`'s artifacts record
#  corpus-wide oracle agreement, and go no_reference + exit 1 otherwise.
#  ~5 min, half of it the swipl budgets running out.)
bench-cli:
	cd {{v6}}/bench-cli && bash bench.sh

# ── batteries ──

# the review-gate battery minus the slow sweep; what a merge must pass
green: conformance roundtrip text-door plunit prolog-lint typecheck tsv2-test import-gate one-subscribe golden-flex dl-test store-test

# everything, including the sweep
green-all: green endurance leak-soak serve-endurance serve-leak-soak memory-soak extraction-live files flagship lsp-diags ghcacher-golden sweep staleness-gate compile-speed scale-floor multirepo-golden rtkq-golden precommit-changed watch-scale getting-started
