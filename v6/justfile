# v6 — prolog compiler front (tsv2) + TS runtimes. Run from here:
# `cd v6 && just` (lists recipes). Every recipe is the exact command the
# coordinator runs as a review gate; nothing here is aspirational.
#
# Layout the recipes map onto:
#   prolog/conformance/  the 135-fixture baseline plus the keep refusal fixture
#   prolog/compile/      the tsv2 compiler: parse_dl/print_dl/analyze/lower/
#                        registry.pl, plunit tests, roundtrip.sh, sweep.pl
#   prolog/ARCH.pl       machine-checked architecture claims (go)
#   tsv2/                A runtime + generated programs, sweep driver, import gate
#   dl/                  the v6 dl app (http server, hosts, binds, tracing)
#   sprefa-store/        rust store + js port + the scale bench harness

v6 := justfile_directory()

default:
	@just --list

# ── prolog side ──

# the fixture corpus vs the oracle engine (expect: 137 PASS, nothing else)
conformance:
	cd {{v6}}/prolog/conformance && swipl -q -l go.pl -g go -g halt

# parse -> print -> reparse identity over all fixtures + real .dl files
roundtrip:
	cd {{v6}}/prolog/compile && bash scripts/roundtrip.sh

# term door vs .dl6 text door, byte-identical emitted modules (expect: 72/72/0)
text-door:
	cd {{v6}}/prolog && bash compile/scripts/text_door_receipt.sh

# compiler unit tests (expect: 124/124 and growing)
plunit:
	cd {{v6}}/prolog/compile && swipl -q -l test/plunit_tests.pl -g run_tests -g halt

# architecture claims machine-check + atlas re-emit
arch:
	swipl -q -l {{v6}}/prolog/ARCH.pl -g go -g halt

# read-only organization gate: parse errors, duplicate modules, undefined
# predicates, private cross-module calls, redefinitions, void declarations,
# trivial fails, format errors. Ratcheted against
# prolog/tools/prolog-lint-baseline.txt; unused exports are advisory output.
prolog-lint:
	cd {{v6}}/prolog && bash tools/prolog-lint.sh

# ── tsv2 (prolog compiles TO TypeScript) ──

# full corpus sweep: compile every fixture, replay vs oracle tick logs
# (expect: RUN total=72 identical=70 wrong=0; slow, minutes)
sweep:
	cd {{v6}}/tsv2 && bash scripts/sweep.sh

# tsv2 runtime + served-engine tests (expect: 28 pass / 1 skip, and growing)
tsv2-test:
	cd {{v6}}/tsv2 && npm test

# generated files import only the named runtime seams (class-34 law)
import-gate:
	cd {{v6}}/tsv2 && bash scripts/check-imports.sh

# ── TS apps ──

# the v6 dl app suite (expect: 96 tests)
dl-test:
	cd {{v6}}/dl && npm test

# js store port suite
store-test:
	cd {{v6}}/sprefa-store/js && npm test

# THE END GOAL, executable: kill -9 mid-delay, reboot, value lands exactly once
endurance:
	bash {{v6}}/dl/scripts/goal-endurance.sh

# long-running server leak gate: one process, repeated swaps/commits/SSE teardown
leak-soak:
	bash {{v6}}/dl/scripts/leak-soak.sh

# the SERVED TSV2 engine's own end goal: kill -9 mid-nap, restart, answered
# witnesses never refire (runtime-bridge arc receipt 5)
serve-endurance:
	cd {{v6}}/tsv2 && bash scripts/endurance.sh

# the served tsv2 engine's leak gate: 20 program swaps, handles/timers/SSE flat
serve-leak-soak:
	cd {{v6}}/tsv2 && bash scripts/leak-soak.sh

# the golden plan's PHASE 2 EXIT RECEIPT: an sg-rail-class diag rail end to end
# on real file edits -- watcher, extractor, retraction, and kill -9 mid-extraction
# (expect: EXTRACTION LIVE HOLDS, 8 phases, exit 0; builds the release extractor
# on first run via cargo build --release --features cli)
extraction-live:
	cd {{v6}}/tsv2 && bash scripts/extraction-live.sh

# the file-set feed against THIS repo: enumerate = git ls-files exactly, zero
# node_modules rows, enumerate_at reports git's own blob oids
# (expect: ENUMERATE HOSTS HOLD, exit 0; needs a populated node_modules)
enumerate:
	cd {{v6}}/tsv2 && bash scripts/enumerate.sh

# sustained assert/retract churn on one served program; process memory,
# sqlite page count, and statements/tick must all stay flat post-warmup
# (expect: MEMORY SOAK HOLDS, exit 0; TSV2_SOAK_LONG=1 for an overnight run)
memory-soak:
	cd {{v6}}/tsv2 && bash scripts/memory-soak.sh

# exactly one terminal subscription per app (dl/src and tsv2/serve)
one-subscribe:
	bash {{v6}}/tools/one-subscribe.sh

# ── benches ──

# the house scale-test rig (engines/*.sh emit a shared CSV protocol)
bench:
	cd {{v6}}/sprefa-store/bench && bash run.sh

# ── batteries ──

# the review-gate battery minus the slow sweep; what a merge must pass
green: conformance roundtrip text-door plunit prolog-lint tsv2-test import-gate one-subscribe dl-test store-test

# everything, including the sweep
green-all: green endurance leak-soak serve-endurance serve-leak-soak memory-soak extraction-live enumerate sweep
