# the PERF-REPORT matrix: 7 hermetic engines x 10 scales, the DD comparison
# table. Writes sprefa-store/PERF-REPORT.md; the receipt line is the footer
# "_Report generated in 958s._" (measured wall at the 471d0be9 refresh).
# NOT in green or green-all: 958s violates the 10-second law by three orders of
# magnitude, and this is a reporting matrix, not a gate. Run by hand on demand.
perf-report:
    cd {{ v6 }}/sprefa-store && cargo run --quiet --release --example perf_report

# ── the consolidated perf battery ──
#
# ONE command that runs every perf bench in the repo, reusing each bench's own
# recipe (just shootout / dl6-bench-full / ...) rather than restating its
# command line. Row-by-row documentation of every bench lives at
# v6/labs/BENCHMARKS.md (TOC + purpose + history + budget per bench).
#
# Every leg:
#   * echoes a ~ten-word purpose header (also printed by lab/BENCHMARKS.md);
#   * runs under a named run-capped budget (failure-modes class 38) so a hung
#     bench is killed with exit 124, never waited on;
#   * prints its own wall time.
# A failing leg does NOT abort the battery: it is echoed with its exit status
# and the batch continues, so a broken bench is reported and not silently
# dropped or commented out.
#
# The store rig is the one bench with two depths. Its full scale ladder
# (SCALES=2x200..14x80000 + the 9-cell TSV2/V1 ladders) runs past 3 min, so
# perf-all drives the rig at its SMALLEST scale and the full ladder lives at
# `just perf-all-deep` (set RIG_SCALES=full to switch). Budget defaults below
# were set against the measured wall on the dev machine when perf-all landed;
# each is deliberately loose (this batch costs minutes, so a tight multiple
# would be measuring machine load rather than the work).
perf-all:
	@echo "=== ATLAS: every leg below is documented at v6/labs/BENCHMARKS.md ==="
	@echo "=== shootout: in-RAM rust engines, fixpoint derived rows/sec ==="
	@{ start=$(date +%s); if {{ capped }} "${PERF_SHOOTOUT_S:-3600}" just --justfile {{ v6 }}/justfile shootout; then st=0; else st=$?; fi; end=$(date +%s); echo "==> shootout wall $((end-start))s (exit $st)"; }
	@echo "=== dl6-bench-full: emitted prolog runtime, grid/layered/chain build ==="
	@{ start=$(date +%s); if {{ capped }} "${PERF_DL6_FULL_S:-3600}" just --justfile {{ v6 }}/justfile dl6-bench-full; then st=0; else st=$?; fi; end=$(date +%s); echo "==> dl6-bench-full wall $((end-start))s (exit $st)"; }
	@echo "=== dl6-dred-bench: in-place DRed vs refCount, incremental ticks ==="
	@{ start=$(date +%s); if {{ capped }} "${PERF_DRED_S:-3600}" just --justfile {{ v6 }}/justfile dl6-dred-bench; then st=0; else st=$?; fi; end=$(date +%s); echo "==> dl6-dred-bench wall $((end-start))s (exit $st)"; }
	@echo "=== dl6-budget: budget cell, grid fixpoint time + RSS ceilings ==="
	@{ start=$(date +%s); if {{ capped }} "${PERF_BUDGET_S:-3600}" just --justfile {{ v6 }}/justfile dl6-budget; then st=0; else st=$?; fi; end=$(date +%s); echo "==> dl6-budget wall $((end-start))s (exit $st)"; }
	@echo "=== store-rig: hermetic engines, retract (small scale; perf-all-deep = full ladder) ==="
	@{ start=$(date +%s); if [ "${RIG_SCALES:-small}" = "full" ]; then {{ capped }} "${PERF_RIG_S:-7200}" just --justfile {{ v6 }}/justfile bench; else {{ capped }} "${PERF_RIG_S:-3600}" env SCALES="2x200" TSV2_SCALES="1x1000" V1_SCALES="1x1000" just --justfile {{ v6 }}/justfile bench; fi; st=$?; end=$(date +%s); echo "==> store-rig wall $((end-start))s (exit $st)"; }
	@echo "=== profile_dred: single cycle-safe retract, per-phase flame numbers ==="
	@{ start=$(date +%s); if {{ capped }} "${PERF_PROFILE_S:-3600}" bash -c 'cd {{ v6 }}/sprefa-store && cargo run --quiet --release --example profile_dred'; then st=0; else st=$?; fi; end=$(date +%s); echo "==> profile_dred wall $((end-start))s (exit $st)"; }
	@echo "=== sqlite_baseline: pure-SQLite closure build, grid_10000 naive (the emitter's ratchet floor) ==="
	@{ start=$(date +%s); if {{ capped }} "${PERF_SQLITE_BASELINE_S:-3600}" bash -c 'cd {{ v6 }}/labs/exec_shootout/sqlite_baseline && cargo run --quiet --release -- --case grid_10000 --variant naive --runs 3'; then st=0; else st=$?; fi; end=$(date +%s); echo "==> sqlite_baseline wall $((end-start))s (exit $st)"; }

# perf-all, but the store rig runs its FULL scale ladder (all engines over the
# SCALES=2x200..14x80000 default plus the 9-cell TSV2/V1 ladders); minutes longer.
perf-all-deep:
	RIG_SCALES=full just --justfile {{ v6 }}/justfile perf-all

