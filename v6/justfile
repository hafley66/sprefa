# against a generated SPREFA_CONFIG; v6 runs goldens/multirepo_crawl over the
# same repos with the repo set posted as EDB rows. Every differing row is
# bucketed with a proof read from the corpus go.mod bytes.
# (expect: MULTIREPO CRAWL GRADED: 4/4 rels byte-identical, 1 named gap
# (dep_ver = min/max over text refused), 0 unclassified, exit 0)
multirepo-golden:
    bash {{ v6 }}/tsv2/goldens/multirepo_crawl/2_gate.sh

