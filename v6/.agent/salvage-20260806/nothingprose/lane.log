--- /Users/chrishafley/projects/sprefa-lanes/nothingprose/v6/labs/prose_nothing/run.sh
+++ /Users/chrishafley/projects/sprefa-lanes/nothingprose/v6/labs/prose_nothing/run.sh
@@ -85,13 +85,20 @@
   cat "$WORK_DIR/arrivals.out" >&2
   exit 1
 fi
 
+# The corpus feed walks 200+ jsonl transcripts and can take seconds, so first
+# wait for the feed host to answer (sentence_row populated), then quiesce.
 last_size=-1
 idle_slept=0
 step_ms=50
 deadline=$((SECONDS + 600))
+populated=0
 while [ "$SECONDS" -lt "$deadline" ]; do
+  probe_rows="$(curl -s "$BASE/idb/sentence_side_count" 2>/dev/null)"
+  case "$probe_rows" in
+    *'assistant'*|*'user'*) populated=1 ;;
+  esac
   size="$(wc -c <"$WORK_DIR/ticks.sse" 2>/dev/null | tr -d ' ')"
   if [ "$size" = "$last_size" ]; then
     idle_slept=$((idle_slept + step_ms))
     [ "$idle_slept" -ge "$IDLE_MS" ] && break
@@ -100,8 +107,23 @@
     last_size="$size"
   fi
   sleep 0.05
 done
+# A host that delivered rows re-arms the idle window; settle its drain tick.
+if [ "$populated" = 1 ]; then
+  idle_slept=0
+  while [ "$SECONDS" -lt "$deadline" ]; do
+    size="$(wc -c <"$WORK_DIR/ticks.sse" 2>/dev/null | tr -d ' ')"
+    if [ "$size" = "$last_size" ]; then
+      idle_slept=$((idle_slept + step_ms))
+      [ "$idle_slept" -ge "$IDLE_MS" ] && break
+    else
+      idle_slept=0
+      last_size="$size"
+    fi
+    sleep 0.05
+  done
+fi
 
 curl -s "$BASE/idb/evaluative_no_receipt_count" >"$WORK_DIR/eval.json"
 curl -s "$BASE/idb/strawman_contrast_count" >"$WORK_DIR/straw.json"
 curl -s "$BASE/idb/pure_nothing_count" >"$WORK_DIR/nothing.json"

