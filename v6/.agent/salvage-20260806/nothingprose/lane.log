  const trimmed = stdout.trim();
  if (!trimmed) return [];
  function parseJsonItems(text){
    try { const p=JSON.parse(text); if(Array.isArray(p)) return p; } catch{}
    const lines=text.split("\n").filter(l=>l.trim().length>0);
    if(!lines.length) return null;
    const items=[]; for(const l of lines){ try{items.push(JSON.parse(l));}catch{return null;} }
    return items;
  }
  const items = parseJsonItems(trimmed);
  if (items){
    const objects = items.filter(i=> i!==null && typeof i==="object" && !Array.isArray(i));
    if (objects.length===items.length){
      // decodeObjectItems full path with coerce
      const out=[];
      for (const item of objects){
        const row=[];
        for (const col of outputs){
          const raw = item[col.name];
          if (col.type==="int"){
            const v = typeof raw==="number" ? raw : Number(String(raw??"").trim());
            if (!Number.isSafeInteger(v)) throw new Error(`int check failed for ${col.name}: ${JSON.stringify(raw)}`);
            row.push(v);
          } else {
            row.push(typeof raw==="string"?raw:(raw===null||raw===undefined?"":String(raw)));
          }
        }
        out.push(row);
      }
      return out;
    }
  }
  return [];
}
