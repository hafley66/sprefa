child.stdout?.on("data", (c) => { stdout += c; });
child.stderr?.on("data", (c) => { stderr += c; });
child.on("error", (e) => { console.error("ERROR:", e.message); process.exit(1); });
child.on("close", (code) => {
  clearTimeout(timer);
  console.error("closed code=", code, "timedout=", timed, "stdout bytes=", stdout.length, "stderr=", stderr.slice(0,500));
  process.exit(0);
});
