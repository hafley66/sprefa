cabal-version:      2.4
name:               starter
version:            0.1.0.0

executable starter
  main-is:          Main.hs
  build-depends:    base >=4.14 && <5
                  , co-log-core
                  , mtl
                  , safe-exceptions
                  , text
  hs-source-dirs:   src
  default-language: Haskell2010
  ghc-options:      -O2 -rtsopts

test-suite starter-test
  type:             exitcode-stdio-1.0
  main-is:          Spec.hs
  build-depends:    base, starter
  hs-source-dirs:   test
  default-language: Haskell2010
