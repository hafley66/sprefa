      border-radius: 8
    }
  }
  operation: {
    shape: hexagon
    style: {
      fill: "#fff6dc"
      stroke: "#9a6b00"
      font-color: "#2b220d"
    }
  }
  runtime: {
    style: {
      fill: "#eefaf1"
      stroke: "#3b7f50"
      font-color: "#17261b"
      border-radius: 8
    }
  }
  boundary: {
    style: {
      fill: "#fff0f0"
