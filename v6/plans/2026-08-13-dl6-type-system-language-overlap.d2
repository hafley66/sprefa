direction: down

vars: {
  d2-config: {
    layout-engine: elk
    theme-id: 200
    dark-theme-id: 200
    pad: 48
    sketch: false
  }
}

classes: {
  source: {
    style: {
      fill: "#eef6ff"
      stroke: "#3574a8"
