      border-radius: 4
    }
  }
  junction: {
    shape: diamond
    style: {
      fill: "#f5f0ff"
      stroke: "#7355a3"
      font-color: "#211a2b"
    }
  }
  proof: {
    shape: parallelogram
    style: {
      fill: "#eefaf1"
      stroke: "#3b7f50"
      font-color: "#17261b"
    }
  }
  artifact: {
    shape: cylinder
    style: {
      fill: "#eefaf1"
      stroke: "#3b7f50"
