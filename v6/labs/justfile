# v6 lab — turnkey experiments. Run from v6/labs:  `cd v6/labs && just <recipe>`
# `just` with no args lists everything.

store := justfile_directory() + "/../sprefa-store"
csv   := justfile_directory() + "/perf-runs.csv"

# list recipes
default:
    @just --list

# ── CORRECTNESS ──────────────────────────────────────────────────────────────

# the 7 covering functions vs v5's real functions, byte-identical (the whole proof)
cover:
    cd "{{store}}" && cargo test --test covering -- --nocapture

# counting cascade == differential-dataflow == oracle, over the shape matrix
agree:
    cd "{{store}}" && cargo test --test agreement

# every correctness test in the store
test:
    cd "{{store}}" && cargo test

# ── PERFORMANCE (turnkey: one command → appends to perf-runs.csv) ─────────────

# THE experiment. Runs the sweep, appends one row per cell to perf-runs.csv,
# then shows the result. `git diff perf-runs.csv` is the record of what changed.
perf:
    cd "{{store}}" && cargo run --release --example reach_perf
    @just results

# same, but under a hard 1GB address-space cap (the real deployment budget)
perf-1gb:
    cd "{{store}}" && DL_MEMCAP_MB=1024 cargo run --release --example reach_perf
    @just results

# ── RESULTS (one place to read the answer) ───────────────────────────────────

# the latest measurements, newest last, as an aligned table
results:
    @test -f "{{csv}}" || { echo "no perf-runs.csv yet — run 'just perf'"; exit 1; }
    @echo "rows: $(($(wc -l < '{{csv}}') - 1))   file: {{csv}}"
    @column -s, -t < "{{csv}}" | cut -c1-160

# raw csv (for piping / spreadsheets)
results-raw:
    @cat "{{csv}}"

# ── HOUSEKEEPING ─────────────────────────────────────────────────────────────

# wipe generated perf data (csv + binary archive)
clean-perf:
    rm -f "{{csv}}" "{{justfile_directory()}}/perf-runs.sqlite"*
    @echo "wiped perf-runs.*"
