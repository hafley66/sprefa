# 6_door_skew_files_at.dl6 -- THE PHANTOM-ROW PIN, NOW A REGRESSION TEST.
#
# One repository, one revision, one glob, one join. Both doors now answer the
# SAME row set: the tree at that revision, 2 rows on alpha at rev A, go.mod and
# main.go, each with its blob oid.
#
# ── THE DEFECT THIS FILE USED TO PIN ─────────────────────────────────────────
# The Rust runtime recognizes the ruled name and answers from Soopy in-process
# (`sprefa-engine-rs/src/hosts.rs:52-60` -> SoopyFilesExecutor). The served TS
# runtime has no such arm and used to run a template whose second half was:
#
#     oid="$(git -C '{repo}' rev-parse '{rev}':"$entry" 2>/dev/null)"
#     [ -n "$oid" ] && printf '%s %s\n' "$entry" "$oid"
#
# `git rev-parse <rev>:<absent-path>` exits 128, writes `fatal:` to stderr, and
# ECHOES ITS ARGUMENT to stdout, so `$oid` held the literal `<rev>:<path>` and
# the `[ -n "$oid" ]` guard passed: absence minted a row whose digest column
# carried the argument string. On rev A the index carries `src/core.ts`, which
# the tree at rev A does not, so the TS door answered 3 rows to the Rust door's
# 2. The shipped declaration's own header claimed the opposite --
# `v6/dl/fixtures/files-hosts.dl6:62-64` -- "rev-parse fails, the guard drops
# it, and it is no row". The guard tested whether git PRINTED, not whether it
# SUCCEEDED.
#
# ── THE FIX, WHICH IS BOTH HALVES ────────────────────────────────────────────
# The template now captures `rev-parse --verify --quiet '{rev}':"$entry"` (no
# echo, exit 1 on absence) and prints only under `if [ -n "$oid" ]`. The `if`
# is load-bearing: `[ -n "$oid" ] && printf` leaves the while loop's exit status
# at 1 whenever the last enumerated path is the absent one, and a nonzero exit
# is a host failure that answers zero rows (sabotage receipt 1 in 8_gate.sh).
#
# ── HOW THIS PROGRAM STAYS FALSIFIABLE ──────────────────────────────────────
# The demand is still posted at rev A, the revision BEFORE the sources land,
# because that is the only revision at which the index and the tree disagree.
# Posting HEAD would make the phantom row unreachable and this file green for
# the wrong reason; posting rev A makes the 2-row agreement a real check that
# the verify guard holds.
#
# ── THE RX LOWERING ─────────────────────────────────────────────────────────
#   wantRev$.pipe(map(mintIdentityAndWitness),
#                 distinct(demand => demand.witnessDigest),
#                 mergeMap(runFileFeed), mergeMap(commitEdbArrival))

sh repo_files_at(repo: text, rev: text, glob: text) -> (path: text, digest: text) =
  `git -C '{repo}' ls-files --with-tree='{rev}' -- '{glob}' | while IFS= read -r entry; do oid="$(git -C '{repo}' rev-parse --verify --quiet '{rev}':"$entry")"; if [ -n "$oid" ]; then printf '%s %s\n' "$entry" "$oid"; fi; done`.

rel want_rev(repo: text, rev: text, glob: text).

rel pinned_file(repo: text, path: text, digest: text).
pinned_file(repo, path, digest) <-
  want_rev(repo, rev, glob), repo_files_at(repo, rev, glob, path, digest).

rel pinned_file_count(repo: text, files: int).
pinned_file_count(repo, count(path)) <- pinned_file(repo, path, _).

? pinned_file(repo, path, digest).
? pinned_file_count(repo, files).
