# 7_door_skew_family.dl6 -- THE SECOND PRIZE: A FAMILY NAME ONE DOOR CANNOT READ.
#
# One extract host, one family name, one rule. The two doors answer DIFFERENT
# and neither one says a word about it.
#
#   TS DOOR     2 `resolved_edge` rows on the pinned corpus (beta_entry ->
#               beta_local, beta_uncommitted -> beta_local, both name_resolve).
#   RUST DOOR   A named stop. `--family diet_scip` names a whole-project MODE
#               the in-process mask parser refuses, so the host errors and
#               answers no rows.
#
# ── THE MECHANISM, MEASURED AND NOT ARGUED ──────────────────────────────────
# `--family` has TWO kinds of value and only one of them crosses the seam.
#
#   MASK NAMES    cst, type, call, df    a per-file extraction mask
#   MODE NAMES    scip, diet_scip        a whole-project pass over the paths
#
# The CLI knows both: `sprefa-extract/src/bin/extract.rs` `family_mode/1` reads
# a mode name first and refuses to mix it with a mask name. The in-process twin
# knows only the mask: `sprefa-engine-rs/src/hosts.rs` parses `--family` by
# matching `cst|type|call|df` and refuses every other name. A mode name is a
# named stop there: "mode `diet_scip` is not linked in-process". The same parser
# arm refuses an unrecognized FLAG by name, so a family name gets the same
# treatment rather than a silent empty answer.
#
# ── WHAT A GATE CANNOT SEE ──────────────────────────────────────────────────
# A named stop reads as a source file with no call sites to any rel that only
# counts rows: the response rel is EMPTY, not WRONG, and an empty rel is a
# legitimate answer on this path. The named stop is what the gate grades: the
# Rust door must ERROR naming the mode, and answering rc=0 with zero rows is
# the regression this pin exists to catch.
#
# ── THE RX LOWERING ─────────────────────────────────────────────────────────
#   scannedFile$.pipe(map(mintIdentityAndWitness),
#                     distinct(demand => demand.witnessDigest),
#                     mergeMap(runExtract), mergeMap(commitEdbArrival))

sh repo_files(repo: text, glob: text) -> (path: text, digest: text) =
  `git -C '{repo}' ls-files -- '{glob}' | while IFS= read -r entry; do printf '%s %s\n' "$entry" "$(git -C '{repo}' hash-object -- "$entry")"; done`.

sh extract(path: text, digest: text)
   -> (record: text, caller_name: text, callee_name: text, kind: text) =
  `"$DL_EXTRACT_BIN" --family diet_scip {path}`.

rel want_scan(repo: text, glob: text).

rel scanned_file(repo: text, path: text, abs_path: text, digest: text).
scanned_file(repo, path, abs_path, digest) <-
  want_scan(repo, glob),
  repo_files(repo, glob, path, digest),
  abs_path := concat([repo, '/', path]).

# `caller_path` and `callee_path` are absolute and therefore machine-dependent,
# so they are left undeclared: an undeclared key is simply not projected, and
# the four columns kept here are the same on any checkout.
rel resolved_edge(repo: text, caller_name: text, callee_name: text, kind: text).
resolved_edge(repo, caller_name, callee_name, kind) <-
  scanned_file(repo, path, abs_path, digest),
  extract(abs_path, digest, 'resolved_edge', caller_name, callee_name, kind).

rel resolved_edge_count(repo: text, edges: int).
resolved_edge_count(repo, count(callee_name)) <- resolved_edge(repo, _, callee_name, _).

? scanned_file(repo, path, abs_path, digest).
? resolved_edge(repo, caller_name, callee_name, kind).
? resolved_edge_count(repo, edges).
