node_modules/
dist/
*.tsbuildinfo
.pnpm-debug.log*

# golden-flex is COMPILED FRESH by scripts/golden-flex.sh on every run, so it
# cannot go stale the way a checked-in gen module can (the recurring class the
# staleness gate exists for). It is deliberately not tracked.
gen_emitted/golden-flex.ts

# scripts/7_scale-floor.sh APPENDS one line here on every run, pass or fail, so
# the throughput curve accumulates on whatever machine runs the gate. Tracking
# it would mean `just green-all` dirties the tree every single time, which is
# the same reason the compile-speed gate never rewrites its own baseline. The
# gated numbers live in scripts/scale-floor-reference.json, which IS tracked.
goldens/scale-floor-history.jsonl
# The whole directory is generated, EXCEPT the Spotlight exclusion marker:
# every sweep rewrites 355 modules here and mds/mdworker re-index each one, so
# the marker is tracked and the generated modules stay ignored.
gen_emitted/*
!gen_emitted/.metadata_never_index
gen/pe_emit/
