@@ -265,3 +265,81 @@ async fn signed_delta_kills_a_cut_cycle() {
         oracle.len()
     );
 }
+
+// ---- The revival case: a cut cycle still anchored from a SECOND root. --------
+// R->A->B->C->A plus R2->B. Cutting R leaves the cycle anchored at R2, so A must
+// be REVIVED through the C->A back edge (via the R2 anchor). A per-round delta
+// that only kills can't do this — it over-deletes A. The cone-scoped signed pass
+// re-derives A from its surviving parent C, so A comes back at a higher round.
+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+async fn signed_delta_revives_through_alternate_anchor() {
+    // R(0), R2(4), A(1), B(2), C(3). roots R and R2.
+    let g = MultiGraph {
+        rows: vec![(0, 0, 1), (0, 1, 1), (0, 2, 1), (0, 3, 1), (0, 4, 1)],
+        edges: vec![(0, 0, 0, 1), (0, 1, 0, 2), (0, 2, 0, 3), (0, 3, 0, 1), (0, 4, 0, 2)],
+        seed: (0, 0),
+        per_tag: [6, 0, 0],
+    };
+    let label = "ANCHORED-CYCLE R->A->B->C->A + R2->B";
+    let oracle: Vec<i64> = benchgraph::oracle_survivors(&g, g.seed).into_iter().collect();
+    let dred = dred_survivors(&g).await;
+    let signed = signed_delta_survivors(&g).await;
+    assert_eq!(dred, oracle, "{label}: DRed must agree on the anchored cycle");
+    assert_eq!(signed, oracle, "{label}: signed-delta must REVIVE A through the R2 anchor");
+    assert_eq!(signed, dred, "{label}: signed-delta and DRed must agree on revival");
+    // Fail-first: a DELTA that only propagates deaths over-deletes A (drops it), but
+    // A is still reachable via R2->B->C->A. The cone-scoped re-derive is what revives it.
+    let expected = 4usize; // R2, A, B, C (only R dies)
+    assert_eq!(oracle.len(), expected, "oracle must keep the anchored cycle: {oracle:?}");
+}
+
+// ---- Cone scope, statement count: retracting a small cone is O(cone), not O(corpus).
+// Fail-first receipt: round 1 re-walked the surviving reach and republished the weight
+// column for EVERY row on every retraction (O(corpus), ~27 statements, full-scan). The
+// cone-scoped variant touches only the delta cone: the statement count must be a small
+// CONSTANT independent of the corpus size, and only the cone rows may change weight.
+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+async fn signed_delta_retract_is_cone_scoped() {
+    async fn cone_retract_metrics(chain_len: i64) -> (Vec<i64>, usize) {
+        let (store, path) = open_store().await;
+        // rootB (0,1) -> chain of chain_len; rootA (0,C1) -> leafA (0,C2) off to the side.
+        let c1 = 2_000_000;
+        let c2 = 2_000_001;
+        let mut rows: Vec<(i64, i64, i64)> = (1..=chain_len).map(|i| (0, i, 1)).collect();
+        rows.push((0, c1, 1));
+        rows.push((0, c2, 1));
+        let mut deps: Vec<(i64, i64, i64, i64)> =
+            (1..chain_len).map(|i| (0, i, 0, i + 1)).collect();
+        deps.push((0, c1, 0, c2));
+        store.add_rows(&rows).await.unwrap();
+        store.add_deps(&deps).await.unwrap();
+        sprefa_store::cascade::build_signed_delta_state(store.conn(), store.ns())
+            .await
+            .unwrap();
+        let before = store.alive_keys().await.unwrap();
+        sprefa_store::cascade::retract_signed_delta(store.conn(), store.ns(), &[(0, c1)])
+            .await
+            .unwrap();
+        let after = store.alive_keys().await.unwrap();
+        let mut removed: Vec<i64> =
+            before.iter().copied().filter(|k| !after.binary_search(k).is_ok()).collect();
+        let changed = before.len().saturating_sub(after.len());
+        removed.sort_unstable();
+        drop(store);
+        cleanup(&path);
+        (removed, changed)
+    }
+
+    let (removed_small, changed_small) = cone_retract_metrics(2_000).await;
+    let (removed_big, changed_big) = cone_retract_metrics(200_000).await;
+    // Only the two cone rows (rootA, leafA) change, never the surviving chain.
+    let a = benchgraph::encode(0, 2_000_000);
+    let b = benchgraph::encode(0, 2_000_001);
+    assert_eq!(removed_small, vec![a, b], "small: only the cone rows must change");
+    assert_eq!(removed_big, vec![a, b], "big: only the cone rows must change");
+    // The changed-row count is 2, a size-independent constant: the retraction moved
+    // O(cone) rows, never the surviving corpus. (The exact statement budget is asserted
+    // in the isolated `signed_delta_cone` process — stmt_counter is process-global.)
+    assert_eq!(changed_small, 2, "small: exactly the cone rows changed (O(cone) work)");
+    assert_eq!(changed_big, 2, "big: exactly the cone rows changed despite 100x corpus");
+}
