+/// Build the persistent signed-delta alive mask `refcount(key, n, round)` from the
+/// current store: roots get round 0, then a per-round BFS assigns each reachable
+/// row its derivation depth. O(corpus), run in the UNTIMED setup window before the
+/// first outer tick; the retraction then reads and mutates only the delta cone.
+pub async fn build_signed_delta_state(db: &DatabaseConnection, ns: &GraphNs) -> Result<u64, DbErr> {
+    let p = ns.row.trim_end_matches("cx_row");
+    let refcount = format!("{p}cx_refcount");
+    let txn = db.begin().await?;
+    let rounds = build_state_inner(&txn, ns, &refcount).await?;
+    txn.commit().await?;
+    Ok(rounds)
+}
+
+async fn build_state_inner(txn: &impl ConnectionTrait, ns: &GraphNs, refcount: &str) -> Result<u64, DbErr> {
+    exec(txn, &format!("DELETE FROM {}; DELETE FROM {}; DELETE FROM {}", refcount, ns.frontier, ns.next)).await?;
+    exec(txn, &format!(
+        "INSERT INTO {refcount}(key,n,round) SELECT key, 1, 0 FROM {row} \
+         WHERE key NOT IN (SELECT child_key FROM {dep})",
+        refcount = refcount, row = ns.row, dep = ns.dep,
+    ))
+    .await?;
+    exec(txn, &format!("INSERT INTO {} SELECT key FROM {}", ns.frontier, refcount)).await?;
+    let mut frontier_table = ns.frontier.as_str();
+    let mut next_table = ns.next.as_str();
+    let mut rounds = 0u64;
+    loop {
+        exec(txn, &format!("DELETE FROM {next_table}")).await?;
+        exec(txn, &format!(
+            "INSERT OR IGNORE INTO {next_table}(key) \
+             SELECT d.child_key FROM {frontier_table} f CROSS JOIN {dep} d ON d.parent_key = f.key \
+             CROSS JOIN {row} r ON r.key = d.child_key WHERE r.key NOT IN (SELECT key FROM {refcount})",
+            dep = ns.dep, row = ns.row, refcount = refcount,
+        ))
+        .await?;
+        if scalar(txn, &format!("SELECT count(*) FROM {next_table}")).await? == 0 { break; }
+        rounds += 1;
+        exec(txn, &format!(
+            "INSERT INTO {refcount}(key,n,round) SELECT key, 1, {rn} FROM {next_table}",
+            refcount = refcount, rn = rounds, next_table = next_table,
+        ))
+        .await?;
+        std::mem::swap(&mut frontier_table, &mut next_table);
+    }
+    Ok(rounds)
+}
