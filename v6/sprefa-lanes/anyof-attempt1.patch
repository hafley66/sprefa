diff --git a/v6/prolog/compile/4_emit_jsonschema.pl b/v6/prolog/compile/4_emit_jsonschema.pl
index 6bd95109..edbec6f5 100644
--- a/v6/prolog/compile/4_emit_jsonschema.pl
