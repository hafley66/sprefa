+//! Snapshot identity: the interned `(repo, rev)` pair.
+//!
+//! A revision belongs to a repository. Carrying the two as independent columns
+//! makes the repo half optional in practice, and 12 built-in rels ended up with
+//! a `rev` column and no `repo` at all — which is why the rebuild deletes that
+//! scope by `rev` (`extract/mod.rs` `sweep_gone_revs`, `storage/call.rs`
+//! `sweep_sqlite_gone_call_inputs`) cannot be scoped to a repo: two repos
+//! sitting on the same branch name are indistinguishable to them.
+//!
+//! A `SnapshotId` is the pair, interned once. One integer column replaces two,
+//! and every delete that scopes by it is repo-qualified for free.
+//!
+//! INV-1: a `SnapshotId` is a pure function of `(repo_slug, rev_text)`. It is
+//! derivable in memory with no database round trip and is stable across
+//! database files, exactly like `StringId::of`. `_snapshot` is a DECODE table,
+//! never an allocator.
+//!
+//! INV-2: the two halves are LENGTH-PREFIXED into the hashed bytes, never
+//! joined by a separator character. `format!("{repo}:{rev}")` as a key is a
+//! first-normal-form violation and would make `("ab", "c")` and `("a", "bc")`
+//! the same snapshot the moment a slug contained the separator.
+
+use crate::engine::revid::RevId;
+use crate::spine::{hash64, StringId};
+
+/// Domain tag, so a `SnapshotId` can never collide with the `StringId` of some
+/// unrelated text that happens to hash the same way. The two id spaces share
+/// `hash64` and both land in INTEGER columns, so they must not share inputs.
+const DOMAIN_SNAPSHOT: &[u8] = b"SPRFSNAP\x01";
+
+/// The interned identity of one (repo, rev) pair.
+///
+/// Lifetime: VALUE type, no state. Minted per scan binding, copied onto every
+/// row that binding produces, dropped with them.
+#[derive(Clone, Copy, Debug, Default, PartialEq, Eq, Hash, PartialOrd, Ord)]
+pub(crate) struct SnapshotId(u64);
+
+impl SnapshotId {
+    /// The unstamped snapshot: no repo, no rev. Mirrors `StringId::EMPTY` and
+    /// `FileId::SYNTHETIC`, so a row that was never stamped is distinguishable
+    /// from one legitimately stamped with the empty repo slug (which hashes to
+    /// a nonzero id). Never written to `_snapshot`, so it joins to nothing.
+    pub(crate) const NONE: Self = Self(0);
+
+    /// Mint from a repo slug and a RESOLVED revision.
+    ///
+    /// `repo_slug` is the logical slug `Engine::resolve_repo` returns, not a
+    /// filesystem path. Taking `&RevId` rather than `&str` is the guard that
+    /// keeps the WORK alias out: `RevId` can only be built by resolution, so a
+    /// snapshot minted from one is never keyed on an unresolved alias.
+    pub(crate) fn of(repo_slug: &str, rev: &RevId) -> Self {
+        Self::of_text(repo_slug, &rev.text())
+    }
+
+    /// Mint from a stored rev text, for the read-back seams (`_file`, the
+    /// migration pass) that hold text rather than a resolved `RevId`.
+    ///
+    /// Callers here are responsible for the text being a stored rev and not an
+    /// alias; `RevId::parse` is the check where one is wanted.
+    pub(crate) fn of_text(repo_slug: &str, rev_text: &str) -> Self {
+        if repo_slug.is_empty() && rev_text.is_empty() {
+            return Self::NONE;
+        }
+        let mut bytes =
+            Vec::with_capacity(DOMAIN_SNAPSHOT.len() + 8 + repo_slug.len() + rev_text.len());
+        bytes.extend_from_slice(DOMAIN_SNAPSHOT);
+        push_len_prefixed(&mut bytes, repo_slug.as_bytes());
+        push_len_prefixed(&mut bytes, rev_text.as_bytes());
+        match hash64(&bytes) {
+            // Never alias the sentinel. One id is displaced onto its neighbour,
+            // which is a collision of exactly the same probability as any other
+            // pair and costs nothing to accept here.
+            0 => Self(1),
+            id => Self(id),
+        }
+    }
+
+    /// The id as it lives in a SQLite INTEGER cell: the u64 bit pattern
+    /// reinterpreted as i64. Same convention as `StringId::sqlite`, so a `snap`
+    /// column compares and joins as a single-word integer.
+    pub(crate) fn sqlite(self) -> i64 {
+        self.0 as i64
+    }
+
+    pub(crate) fn from_sqlite(value: i64) -> Self {
+        Self(value as u64)
+    }
+
+    pub(crate) fn is_none(self) -> bool {
+        self == Self::NONE
+    }
+}
+
+/// Length-prefix `field` into `out`. The prefix, not a separator byte, is what
+/// makes the concatenation injective (INV-2).
+fn push_len_prefixed(out: &mut Vec<u8>, field: &[u8]) {
+    out.extend_from_slice(&(field.len() as u64).to_le_bytes());
+    out.extend_from_slice(field);
+}
+
+/// Collects the (id, repo, rev) triples minted across one refresh pass, for a
+/// single batched `_snapshot` flush.
+///
+/// The `SymSink` shape restated: the only way to get a snapshot id that is
+/// GOING TO BE STORED is through `intern`, so an id can never land in a rel row
+/// without its decode row being queued alongside. `SnapshotId::of` stays public
+/// for the read-side (comparing against an id you are not writing).
+///
+/// Lifetime: ONE per refresh pass, stack-local, drained by `Db::flush_snapshots`.
+#[derive(Default)]
+pub(crate) struct SnapshotSink {
+    pending: Vec<(SnapshotId, String, String)>,
+    flushed: bool,
+}
+
+impl SnapshotSink {
+    pub(crate) fn new() -> Self {
+        Self::default()
+    }
+
+    /// Mint `(repo_slug, rev)` and queue its decode row.
+    pub(crate) fn intern(&mut self, repo_slug: &str, rev: &RevId) -> SnapshotId {
+        let id = SnapshotId::of(repo_slug, rev);
+        if !id.is_none() {
+            self.pending
+                .push((id, repo_slug.to_string(), rev.text()));
+        }
+        id
+    }
+
+    /// Drain every queued triple. Called once by `Db::flush_snapshots`.
+    pub(crate) fn drain(&mut self) -> Vec<(SnapshotId, String, String)> {
+        self.flushed = true;
+        std::mem::take(&mut self.pending)
+    }
+
+    pub(crate) fn is_empty(&self) -> bool {
+        self.pending.is_empty()
+    }
+}
+
+/// The `SymSink` silent-loss guard, restated: dropping a sink that still holds
+/// pending interns means a `snap` id may already sit in a rel row while its
+/// `_snapshot` decode row was never written, so the row's coordinate is
+/// unresolvable forever. Panic loud in debug rather than lose it quietly.
+impl Drop for SnapshotSink {
+    fn drop(&mut self) {
+        if cfg!(debug_assertions) && !self.pending.is_empty() && !self.flushed {
+            panic!(
+                "SnapshotSink dropped with {} pending intern(s) never flushed",
+                self.pending.len()
+            );
+        }
+    }
+}
+
+/// The `_strings` id of a repo slug, for the repo-scoped delete's WHERE clause.
+/// Computed, never looked up: `StringId::of` is a content hash.
+pub(crate) fn repo_sym(repo_slug: &str) -> i64 {
+    StringId::of(repo_slug).sqlite()
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    const OID: &str = "1234567890abcdef1234567890abcdef12345678";
+
+    fn rev() -> RevId {
+        RevId::worktree(OID, false)
+    }
+
+    #[test]
+    fn the_same_pair_mints_the_same_id_every_time() {
+        // INV-1: derivable with no database round trip, stable across files.
+        // Two independently-built ids, as two processes would produce.
+        assert_eq!(SnapshotId::of("sprefa", &rev()), SnapshotId::of("sprefa", &rev()));
+        assert_eq!(
+            SnapshotId::of_text("sprefa", OID),
+            SnapshotId::of("sprefa", &rev()),
+            "a live RevId and its stored text mint the same id"
+        );
+    }
+
+    #[test]
+    fn either_half_changing_changes_the_id() {
+        let base = SnapshotId::of("sprefa", &rev());
+        assert_ne!(base, SnapshotId::of("other-repo", &rev()));
+        assert_ne!(base, SnapshotId::of("sprefa", &RevId::worktree(OID, true)));
+    }
+
+    #[test]
+    fn the_dirty_marker_is_part_of_the_identity() {
+        // A dirty worktree is a different snapshot from its clean HEAD, because
+        // its bytes are different. The `+` rides into the hash via rev.text().
+        let clean = SnapshotId::of("sprefa", &RevId::worktree(OID, false));
+        let dirty = SnapshotId::of("sprefa", &RevId::worktree(OID, true));
+        assert_ne!(clean, dirty);
+    }
+
+    #[test]
+    fn a_shifted_boundary_between_the_halves_is_a_different_snapshot() {
+        // INV-2, the whole reason for the length prefix. Under a `format!`
+        // separator scheme these two collapse to one key the moment a slug
+        // contains the separator; under length prefixing they cannot.
+        assert_ne!(SnapshotId::of_text("ab", "c"), SnapshotId::of_text("a", "bc"));
+        assert_ne!(SnapshotId::of_text("a:b", "c"), SnapshotId::of_text("a", "b:c"));
+        assert_ne!(SnapshotId::of_text("", "ab"), SnapshotId::of_text("ab", ""));
+    }
+
+    #[test]
+    fn the_sentinel_is_reserved_and_never_minted() {
+        assert!(SnapshotId::NONE.is_none());
+        assert_eq!(SnapshotId::of_text("", ""), SnapshotId::NONE);
+        // An empty slug with a real rev is a REAL snapshot, not the sentinel:
+        // "unstamped" and "stamped with the empty repo" must stay distinct.
+        assert!(!SnapshotId::of_text("", OID).is_none());
+        assert!(!SnapshotId::of("sprefa", &rev()).is_none());
+    }
+
+    #[test]
+    fn sqlite_round_trips_through_the_i64_bit_pattern() {
+        let id = SnapshotId::of("sprefa", &rev());
+        assert_eq!(SnapshotId::from_sqlite(id.sqlite()), id);
+        assert_eq!(SnapshotId::from_sqlite(SnapshotId::NONE.sqlite()), SnapshotId::NONE);
+    }
+
+    #[test]
+    fn a_snapshot_id_is_not_the_string_id_of_either_half() {
+        // Domain separation: both id spaces run through hash64 and both land in
+        // INTEGER columns, so an accidental shared input would be a real bug.
+        let id = SnapshotId::of_text("sprefa", OID).sqlite();
+        assert_ne!(id, StringId::of("sprefa").sqlite());
+        assert_ne!(id, StringId::of(OID).sqlite());
+        assert_ne!(id, StringId::of(&format!("sprefa:{OID}")).sqlite());
+    }
+
+    #[test]
+    fn the_sink_queues_one_decode_row_per_intern() {
+        let mut sink = SnapshotSink::new();
+        assert!(sink.is_empty());
+        let first = sink.intern("sprefa", &rev());
+        let second = sink.intern("other", &rev());
+        let queued = sink.drain();
+        assert_eq!(queued.len(), 2);
+        assert_eq!(queued[0], (first, "sprefa".to_string(), OID.to_string()));
+        assert_eq!(queued[1].0, second);
+    }
+
+    #[test]
+    fn the_sink_agrees_with_the_bare_constructor() {
+        let mut sink = SnapshotSink::new();
+        assert_eq!(sink.intern("sprefa", &rev()), SnapshotId::of("sprefa", &rev()));
+        let _ = sink.drain();
+    }
+
+    #[test]
+    fn a_drained_sink_drops_clean() {
+        let mut sink = SnapshotSink::new();
+        sink.intern("sprefa", &rev());
+        let _ = sink.drain();
+        drop(sink); // must not panic
+    }
+
+    #[test]
+    #[should_panic(expected = "pending intern")]
+    fn dropping_a_sink_with_unflushed_interns_panics() {
+        let mut sink = SnapshotSink::new();
+        sink.intern("sprefa", &rev());
+        drop(sink);
+    }
+
+    #[test]
+    fn repo_sym_matches_the_intern_of_the_slug() {
+        assert_eq!(repo_sym("sprefa"), StringId::of("sprefa").sqlite());
+    }
+}
