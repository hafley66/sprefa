+## 1. Type signatures
+
+```rust
+// src/engine/snapshot.rs (new)
+
+/// The interned identity of one (repo, rev) pair: the coordinate every fact
+/// row is stamped with. One integer where two columns stood.
+///
+/// Content-addressed, like `StringId::of`, so it is derivable in memory with
+/// no database round trip and is stable across database files. Domain-separated
+/// from `StringId` so a snapshot id can never collide with the `StringId` of
+/// some unrelated text that happens to hash the same way.
+#[derive(Clone, Copy, Debug, Default, PartialEq, Eq, Hash, PartialOrd, Ord)]
+pub(crate) struct SnapshotId(u64);
+
+impl SnapshotId {
+    /// The zero snapshot: no repo, no rev. Mirrors `StringId::EMPTY` /
+    /// `FileId::SYNTHETIC` so an unstamped row is distinguishable from a
+    /// legitimately-stamped one rather than silently aliasing repo "".
+    pub(crate) const NONE: Self;
+
+    /// Mint from the two halves. `repo_slug` is the logical slug
+    /// (`Engine::resolve_repo` -> `.0`), NOT a filesystem path; `rev` is the
+    /// resolved revision, never an alias.
+    ///
+    /// NOT `format!("{repo}:{rev}")`. The two halves are length-prefixed into a
+    /// canonical byte string before hashing, so ("ab","c") and ("a","bc") are
+    /// distinct inputs. A separator character is not a key; a length prefix is.
+    pub(crate) fn of(repo_slug: &str, rev: &RevId) -> Self;
+
+    /// Same, from a stored rev text rather than a live `RevId`. For the read-back
+    /// seams (`_file`, migration) that hold text, not a resolved rev.
+    pub(crate) fn of_text(repo_slug: &str, rev_text: &str) -> Self;
+
+    /// The i64 cell value. Same convention as `StringId::sqlite`.
+    pub(crate) fn sqlite(self) -> i64;
+    pub(crate) fn from_sqlite(value: i64) -> Self;
+}
+
+/// A minted SnapshotId together with the two halves it was minted from, queued
+/// for the batched `_snapshot` flush. The `Sym`/`SymSink` shape, restated: the
+/// ONLY way to get a storable snapshot id is through the sink, so an id can
+/// never land in a row without its (repo, rev) decode row landing too.
+#[derive(Default)]
+pub(crate) struct SnapshotSink {
+    pending: Vec<(SnapshotId, String, String)>,
+    flushed: bool,
+}
+
+impl SnapshotSink {
+    pub(crate) fn new() -> Self;
+    pub(crate) fn intern(&mut self, repo_slug: &str, rev: &RevId) -> SnapshotId;
+    pub(crate) fn drain(&mut self) -> Vec<(SnapshotId, String, String)>;
+}
+
+// src/db.rs
+
+impl Db {
+    /// Flush every queued snapshot in ONE `INSERT OR IGNORE`. The N+1 law: the
+    /// sink collects, this writes once. Interns the two halves into `_strings`
+    /// through the existing `SymSink` in the same pass.
+    pub fn flush_snapshots(&self, sink: &mut SnapshotSink) -> Result<()>;
+
+    /// Replace a rel's rows for ONE snapshot, instead of wiping the table.
+    /// The repo-scoped successor to `reload_rel`.
+    pub fn reload_rel_for_snapshot(
+        &self, table: &str, snap_col: &str, snap: SnapshotId,
+        cols: &[&str], rows: &[Vec<Value>],
+    ) -> Result<usize>;
+
+    /// Delete every row of `table` belonging to any snapshot of `repo_slug`.
+    /// The one seam a repo-scoped rebuild delete goes through.
+    pub fn delete_rel_for_repo(&self, table: &str, snap_col: &str, repo_slug: &str) -> Result<usize>;
+}
+```
