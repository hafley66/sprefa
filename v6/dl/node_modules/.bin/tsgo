#!/bin/sh
basedir=$(dirname "$(echo "$0" | sed -e 's,\\,/,g')")
basedir_win="$basedir"
exe=""
msys=""

case `uname -a` in
  *CYGWIN*|*MINGW*|*MSYS*)
    if command -v cygpath > /dev/null 2>&1; then
      basedir_win=`cygpath -w "$basedir"`
    fi
    exe=".exe"
    msys="true"
  ;;
  *WSL2*)
    if command -v wslpath > /dev/null 2>&1; then
      basedir_win="$(wslpath -w "$basedir" 2> /dev/null)"
      if [ $? -ne 0 ] || [ -z "$basedir_win" ]; then
        basedir_win="$basedir"
      else
        exe=".exe"
      fi
    fi
  ;;
esac

if [ -z "$NODE_PATH" ]; then
  export NODE_PATH="/Users/chrishafley/projects/sprefa/v6/dl/node_modules/.pnpm/@typescript+native-preview@7.0.0-dev.20260707.2/node_modules/@typescript/native-preview/node_modules:/Users/chrishafley/projects/sprefa/v6/dl/node_modules/.pnpm/@typescript+native-preview@7.0.0-dev.20260707.2/node_modules:/Users/chrishafley/projects/sprefa/v6/dl/node_modules/.pnpm/node_modules"
else
  export NODE_PATH="/Users/chrishafley/projects/sprefa/v6/dl/node_modules/.pnpm/@typescript+native-preview@7.0.0-dev.20260707.2/node_modules/@typescript/native-preview/node_modules:/Users/chrishafley/projects/sprefa/v6/dl/node_modules/.pnpm/@typescript+native-preview@7.0.0-dev.20260707.2/node_modules:/Users/chrishafley/projects/sprefa/v6/dl/node_modules/.pnpm/node_modules:$NODE_PATH"
fi
if [ -n "$exe" ] && [ -x "$basedir/node.exe" ]; then
  exec "$basedir/node.exe"  "$basedir_win/../@typescript/native-preview/bin/tsgo" "$@"
elif [ -x "$basedir/node" ]; then
  exec "$basedir/node"  "$basedir/../@typescript/native-preview/bin/tsgo" "$@"
elif command -v node >/dev/null 2>&1; then
  exec node  "$basedir/../@typescript/native-preview/bin/tsgo" "$@"
elif [ -n "$exe" ] && command -v node.exe >/dev/null 2>&1; then
  exec node.exe  "$basedir_win/../@typescript/native-preview/bin/tsgo" "$@"
else
  exec node  "$basedir/../@typescript/native-preview/bin/tsgo" "$@"
fi
