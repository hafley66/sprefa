# A module every other module has stopped calling, in three buckets, because a
# call site names a FUNCTION and never a file:
#
#   rail_dead_module       no call site anywhere names any definition here
#   rail_unproven_module   reached only through a name several files define
#   rail_unreachable_module  the crawl from the declared roots never arrives

# The buckets do NOT read one graph. Dead and unproven are call-only, so a file
# imported and never called is dead: knip's blind spot, and the whole point.

# The crawl is BOTH calls and resolved import edges, because an entry point
# reaches a file either way and a star re-export writes no callee at all.

# The middle bucket is the point. Demanding a unique name reports live code as
# dead; ignoring ambiguity reports dead code as live. Neither is a good default
# for a tool whose false positives get code deleted, so the ambiguity is named
# instead of guessed. Deciding it needs the receiver's type, which the call
# family does not carry.
#
# rx: sourceFile$.pipe(distinct(row => row.witnessDigest), mergeMap(runExtract));
# liveFile$.pipe(mergeMap(callsOf), mergeMap(defFileOf), distinct()).

rel span(start: int, end: int).

# One `git hash-object` process for the whole set, never one per file: the
# per-file spelling measured 0.82s against 0.01s over 82 paths.
# Routed to the linked `soopy_files` adapter by the sidecar, so no `sh` runs:
# soopy enumerates the pathspec and batch-hashes the worktree in one call;
# the rel name IS the executor binding (registry.pl arrival_executor/2).
rel /soopy/files(glob: text) -> (path: text, digest: text).

# The `families` input replaces the dead template's --family flag; equal
# (path, digest, families) demands fold into ONE extractor run per file.
rel /extract/call_node_at(path: text, digest: text, families: text) -> (record: text, family: text, span: span, kind: text, name: text) key(1, 3).
# Emitted only for a def a cfg predicate naming `test` guards, so declaring the
# `cfg` column selects exactly that set and nothing else.
rel /extract/cfg_at(path: text, digest: text, families: text) -> (record: text, family: text, span: span, cfg: text) key(1, 3).
# NO `span` here, deliberately. The rule wants the SET of names this file
# calls, and a span makes every one of 17929 sites a distinct row where 5310
# distinct (file, callee) pairs exist. Declaring a column the rules never read
# is not a wasted field, it is a 6x row multiplier: dropping it took tick-2
# arrivals from 21194 to 3501 and the run from 4.8s to 3.55s.
rel /extract/records(path: text, digest: text, families: text) -> (record: text, family: text, callee: text) key(1, 3).
# NO `name`, `kind` or `span`: they would make `import {one, two} from './m'`
# two rows where the rules read one module text. `module` selects the record.
rel /extract/specifier_at(path: text, digest: text, families: text) -> (record: text, family: text, module: text) key(1, 3).

rel want(glob: text).
rel root_file(path: text).

rel source_file(path: text, digest: text).
source_file(Path, Digest) <- want(Glob), /soopy/files(Glob, Path, Digest).

# ── the entry plane ─────────────────────────────────────────────────────────

# Hand-typing one crate's main.rs made every OTHER crate's entry read as dead,
# so a cargo workspace's own bin and lib targets are read rather than typed.

# The host answers ONE json document; the declared output columns name two of
# its top-level keys and the value plane fans the rest out into rows.

# rx: metadata$.pipe(mergeMap(doc => doc.packages), mergeMap(pkg => pkg.targets),
# filter(target => target.kind.some(isRootKind)), map(relativeToWorkspaceRoot)).
rel /cargo/targets(manifest_dir: text) -> (workspace_root: text, packages: json).

rel cargo_manifest(dir: text).

rel cargo_metadata_doc(workspace_root: text, packages: json).
cargo_metadata_doc(WorkspaceRoot, Packages) <-
  cargo_manifest(Dir), /cargo/targets(Dir, WorkspaceRoot, Packages).

# `kind` is a json ARRAY per target, so the spread over it IS the membership
# test and the fact table below keeps the kinds that name an entry point.
rel cargo_target_source(workspace_root: text, kind: text, src_path: text).
cargo_target_source(WorkspaceRoot, Kind, SrcPath) <-
  cargo_metadata_doc(WorkspaceRoot, Packages),
  decode(Packages, [... {targets: [... {kind: [... Kind], src_path: SrcPath: text}]}]).

rel root_kind(kind: text).
root_kind('bin').        root_kind('lib').   root_kind('proc-macro').
root_kind('cdylib').     root_kind('rlib').

# cargo answers an absolute path and every other plane keys on the repo-relative
# one the pathspec produced.
rel derived_root(path: text).
derived_root(Path) <-
  cargo_target_source(WorkspaceRoot, Kind, SrcPath),
  root_kind(Kind),
  substr(SrcPath, 1, length(WorkspaceRoot)) == WorkspaceRoot,
  Path := substr(SrcPath, length(WorkspaceRoot) + 2).

rel cargo_root_count(roots: int).
cargo_root_count(count(Path)) <- derived_root(Path).

# The union both liveness planes read. One rel carrying arrivals AND a rule
# head would make every derived row arrive twice, so the union is its own rel.
rel entry_file(path: text).
entry_file(Path) <- root_file(Path).
entry_file(Path) <- derived_root(Path).

# ── the def plane ───────────────────────────────────────────────────────────
# Definition CLASS (free fn, inherent method, trait method) is not modelled.
# It was, through three more host declarations reading owner and trait spans,
# and every class ended up with the same liveness rule, because a call site
# names a method and never an impl. Re-earn those hosts only for something the
# name alone cannot decide, which means the receiver's type.
# A def the compiler only builds for tests is not part of the shipped module.
# Counting it inflates every per-file total and lets a file clear the floor on
# test helpers alone; the extractor made these visible when its projectors
# started descending inline mod bodies.
rel cfg_def(path: text, at: span).
cfg_def(Path, At) <-
  source_file(Path, Digest),
  /extract/cfg_at(Path, Digest, "call", 'cfg_scope', 'call', At, _Predicate).

rel def_site(path: text, name: text, at: span).
def_site(Path, Name, At) <-
  source_file(Path, Digest),
  /extract/call_node_at(Path, Digest, "call", 'node', 'call', At, 'function', Name),
  not(cfg_def(Path, At)).
def_site(Path, Name, At) <-
  source_file(Path, Digest),
  /extract/call_node_at(Path, Digest, "call", 'node', 'call', At, 'method', Name),
  not(cfg_def(Path, At)).

# ── the call plane ──────────────────────────────────────────────────────────
# A call site the compiler only builds for tests is not a use of the module it
# names: rustc's dead_code lint fires on exactly this file in a `cargo check`.
# The record is emitted ONLY for a callee every site in the file names under a
# cfg predicate naming `test`, so subtracting the NAME here is still a per-SITE
# filter: one shipped site anywhere in the file keeps the callee off the row.
rel test_only_call(path: text, callee: text).
test_only_call(Path, Callee) <-
  source_file(Path, Digest),
  /extract/records(Path, Digest, "call", 'test_only_call', 'call', Callee).

rel call_from(path: text, callee: text).
call_from(Path, Callee) <-
  source_file(Path, Digest),
  /extract/records(Path, Digest, "call", 'site', 'call', Callee),
  not(test_only_call(Path, Callee)).

# ── the import plane ────────────────────────────────────────────────────────

# Every rung of the ladder below is TypeScript's, so the demand is narrowed to
# the files it answers for: a 4th parse of 82 Rust files cost 0.5s for 0 edges.
rel module_extension(ext: text).
module_extension('.ts').  module_extension('.tsx'). module_extension('.mts').
module_extension('.cts'). module_extension('.js').  module_extension('.jsx').
module_extension('.mjs'). module_extension('.cjs').

rel module_source(path: text).
module_source(Path) <-
  source_file(Path, _Digest),
  module_extension(Ext),
  substr(Path, length(Path) - length(Ext) + 1) == Ext.

rel import_specifier(path: text, module: text).
import_specifier(Path, Module) <-
  source_file(Path, Digest),
  module_source(Path),
  /extract/specifier_at(Path, Digest, "call", 'specifier', 'call', Module).

rel source_dir(path: text, dir: text).
source_dir(Path, Dir) <-
  source_file(Path, _Digest),
  instr(reverse(Path), '/') > 0,
  Dir := substr(Path, 1, length(Path) - instr(reverse(Path), '/')).

# The basename as written, which is the join key the bare arm below matches on.
rel file_key(path: text, key: text).
file_key(Path, Key) <-
  source_dir(Path, Dir),
  Key := substr(Path, length(Dir) + 2).

# One rel per `../` level, never one recursive rel: a recursive arm may mint no
# interned text (lower.pl:5677), and every climb builds a new directory string.
rel dir_up_one(path: text, dir: text).
dir_up_one(Path, Parent) <-
  source_dir(Path, Dir),
  instr(reverse(Dir), '/') > 0,
  Parent := substr(Dir, 1, length(Dir) - instr(reverse(Dir), '/')).

rel dir_up_two(path: text, dir: text).
dir_up_two(Path, Parent) <-
  dir_up_one(Path, Dir),
  instr(reverse(Dir), '/') > 0,
  Parent := substr(Dir, 1, length(Dir) - instr(reverse(Dir), '/')).

rel dir_up_three(path: text, dir: text).
dir_up_three(Path, Parent) <-
  dir_up_two(Path, Dir),
  instr(reverse(Dir), '/') > 0,
  Parent := substr(Dir, 1, length(Dir) - instr(reverse(Dir), '/')).

# The ceiling is three `../`, which is where the unrolled rels stop. A deeper
# specifier resolves to nothing and its target reads as unreached, never as dead.
rel relative_specifier(path: text, base: text, tail: text).
relative_specifier(Path, Base, Tail) <-
  import_specifier(Path, Module),
  source_dir(Path, Base),
  substr(Module, 1, 2) == './',
  Tail := substr(Module, 3).
relative_specifier(Path, Base, Tail) <-
  import_specifier(Path, Module),
  dir_up_one(Path, Base),
  substr(Module, 1, 3) == '../',
  substr(Module, 4, 3) \== '../',
  Tail := substr(Module, 4).
relative_specifier(Path, Base, Tail) <-
  import_specifier(Path, Module),
  dir_up_two(Path, Base),
  substr(Module, 1, 6) == '../../',
  substr(Module, 7, 3) \== '../',
  Tail := substr(Module, 7).
relative_specifier(Path, Base, Tail) <-
  import_specifier(Path, Module),
  dir_up_three(Path, Base),
  substr(Module, 1, 9) == '../../../',
  substr(Module, 10, 3) \== '../',
  Tail := substr(Module, 10).

# TypeScript's own candidate ladder, as a fact table so the ladder is one rule.
# The empty suffix is the specifier that already names a file exactly.
rel module_suffix(suffix: text).
module_suffix('').        module_suffix('.ts').       module_suffix('.tsx').
module_suffix('.d.ts').   module_suffix('.mts').      module_suffix('.cts').
module_suffix('.js').     module_suffix('.jsx').      module_suffix('.mjs').
module_suffix('.cjs').    module_suffix('/index.ts'). module_suffix('/index.tsx').
module_suffix('/index.js').

rel import_candidate(path: text, target: text).
import_candidate(Path, Candidate) <-
  relative_specifier(Path, Base, Tail),
  module_suffix(Suffix),
  Candidate := concat([Base, '/', Tail, Suffix]).
# A NodeNext specifier names the file the compiler EMITS, so `./x.js` is `x.ts`.
import_candidate(Path, Candidate) <-
  relative_specifier(Path, Base, Tail),
  substr(Tail, length(Tail) - 2) == '.js',
  Candidate := concat([Base, '/', substr(Tail, 1, length(Tail) - 3), '.ts']).

# A tsconfig `paths` alias rewrites a prefix this rail cannot read, so the LAST
# SEGMENT matches instead: over-links, never under-links. No `/` = no arm.
rel bare_specifier(path: text, key: text).
bare_specifier(Path, Key) <-
  import_specifier(Path, Module),
  substr(Module, 1, 1) \== '.',
  instr(Module, '/') > 0,
  Key := substr(Module, length(Module) - instr(reverse(Module), '/') + 2).

rel imports(source: text, target: text).
imports(SourcePath, TargetPath) <-
  import_candidate(SourcePath, TargetPath),
  source_file(TargetPath, _Digest),
  SourcePath \== TargetPath.
imports(SourcePath, TargetPath) <-
  bare_specifier(SourcePath, Key),
  file_key(TargetPath, Key),
  SourcePath \== TargetPath.

# ── ambiguity, for the readable table only ──────────────────────────────────
rel name_def_files(name: text, files: int).
name_def_files(Name, count(Path)) <- def_site(Path, Name, _At).

rel unique_name(name: text).
unique_name(Name) <- name_def_files(Name, Files), Files == 1.

rel ambiguous_name(name: text).
ambiguous_name(Name) <- name_def_files(Name, Files), Files > 1.

rel def_ambiguous(path: text, name: text).
def_ambiguous(Path, Name) <- def_site(Path, Name, _At), ambiguous_name(Name).

rel file_ambiguous(path: text, ambiguous: int).
file_ambiguous(Path, count(Name)) <- def_ambiguous(Path, Name).

# ── used-across, per class ──────────────────────────────────────────────────
# ONE liveness rule for every definition class. A call site offers a NAME and
# nothing else: a receiver call (`directory.snapshot(...)`) carries no
# callee_path, and only 24% of sites in a real crate carry one at all. So a
# rule that demands a unique name can never mark an ambiguous one live, and the
# file reads as dead while its call sites sit in plain view. That defect
# reported soopy/src/_3a_files.rs dead against 19 live calls to `snapshot`.
#
# A dead-code rail may under-report and must never over-report: deleting live
# code is the expensive direction. So one live call on a name makes every
# definition of that name live, which is also exactly what dynamic dispatch
# already forced for trait methods.
rel def_used_across(path: text, name: text).
def_used_across(DefPath, Name) <-
  def_site(DefPath, Name, _At), call_from(CallPath, Name), DefPath \== CallPath.

rel file_defs(path: text, defs: int).
file_defs(Path, count(Name)) <- def_site(Path, Name, _At).

rel file_used(path: text, used: int).
file_used(Path, count(Name)) <- def_used_across(Path, Name).

# Every file with defs gets a used row and an ambiguous row, so the readable
# table never drops a file for having a zero in one column.
rel used_or_zero(path: text, used: int).
used_or_zero(Path, Used) <- file_used(Path, Used).
used_or_zero(Path, 0) <- file_defs(Path, _Defs), not(file_used(Path, _Used)).

rel ambiguous_or_zero(path: text, ambiguous: int).
ambiguous_or_zero(Path, Ambiguous) <- file_ambiguous(Path, Ambiguous).
ambiguous_or_zero(Path, 0) <- file_defs(Path, _Defs), not(file_ambiguous(Path, _Amb)).

rel module_reach(path: text, defs: int, used: int, ambiguous: int).
module_reach(Path, Defs, Used, Ambiguous) <-
  file_defs(Path, Defs), used_or_zero(Path, Used), ambiguous_or_zero(Path, Ambiguous).

# ── ONE HOP ─────────────────────────────────────────────────────────────────
# Liveness proven by a name only ONE file defines. A call on such a name can
# only mean this file, so the reach is certain rather than assumed.
rel def_used_uniquely(path: text, name: text).
def_used_uniquely(DefPath, Name) <-
  def_site(DefPath, Name, _At), unique_name(Name), call_from(CallPath, Name), DefPath \== CallPath.

# A declared root is live by definition: an entry point is the thing nothing
# calls into. Without this it is reported by the one-hop rule while the crawl
# correctly clears it, and the two rules disagree on every crate entry.
rel rail_dead_module(path: text, defs: int).
rail_dead_module(Path, Defs) <-
  file_defs(Path, Defs), Defs >= 5, not(file_used(Path, _Used)), not(entry_file(Path)).

# The third bucket, and the plain one. A file reached ONLY through names that
# several files define is neither proven live nor proven dead: the call sites
# exist, but nothing in the call family says which definition they meant.
# crates/boop/src/chat.rs lands here because it defines `snapshot`, a name 48
# other call sites use for other types; so does soopy/src/_3a_files.rs, which
# really is live. Separating them needs the receiver's TYPE, which the call
# family does not carry and `extract --resolve` does.
rel rail_unproven_module(path: text, defs: int).
rail_unproven_module(Path, Defs) <-
  file_defs(Path, Defs),
  Defs >= 5,
  file_used(Path, _Used),
  not(def_used_uniquely(Path, _Name)),
  not(entry_file(Path)).

# ── THE CRAWL ───────────────────────────────────────────────────────────────
# The crawl reaches by name for the same reason, one hop per tick until the
# fixpoint. A trait method needs no separate rule: a call names no impl, so
# every definition of the name is reached, which IS dynamic dispatch.
rel live_file(path: text).
live_file(Path) <- entry_file(Path).
live_file(Target) <-
  live_file(Source), call_from(Source, Callee), def_site(Target, Callee, _At).
live_file(Target) <- live_file(Source), imports(Source, Target).

rel rail_unreachable_module(path: text, defs: int).
rail_unreachable_module(Path, Defs) <- file_defs(Path, Defs), Defs >= 5, not(live_file(Path)).

# A root outside the glob seeds nothing and every file then reads as unreachable.
rel rail_root_not_a_source(path: text).
rail_root_not_a_source(Path) <- entry_file(Path), not(source_file(Path, _Digest)).

# rx: rows$.pipe(map(rows => sortBy(rows, [desc('defs'), 'path'])))
# The Rust door lowers the tail; the paused TypeScript door leaves it unordered.
? cargo_root_count(roots).
? rail_root_not_a_source(path).
? rail_dead_module(path, defs) order by defs desc, path.
? rail_unproven_module(path, defs) order by defs desc, path.
? rail_unreachable_module(path, defs) order by defs desc, path.
? module_reach(path, defs, used, ambiguous) order by defs desc, path.
