# @comment-ok: the dl6 door contract, the single doc site for the IR shape.
# render_ts.dl6 -- the dl6 door for the TS interface plane (Phase F).
# Reads the type plane as arrivals on EDB rel type_row/7 and type_storage/5
# (one JSONL line per semantic row, written by v6/prolog/compile/typegen_export.pl) and
# renders each renderable relation as a TS interface. The 3-rule IR shape is
# the proven probe (chat_log/20260813.2):
#   field_line(TypeName, Ordinal, LineText)   <- concat per column
#   body_text(TypeName, group_concat(LineText, '\n', Ordinal))
#   rendered_type(TypeName, FileText)         <- concat wrap
# Scope (Phase F): interfaces + option columns + list columns, single module,
# no type-name collisions. Module-prefix and generic-rel emission are future
# arcs, named in the report, not implemented here.
# type_row columns (from row/11): id, parent, ordinal, name, kind, type_id,
# module_id.

rel type_row(id: int, parent: int, ordinal: int, name: text, kind: text,
             type_id: int, module_id: int).
rel type_storage(id: int, column_id: int, ordinal: int, local_name: text,
                 module_id: int).

# Option is a tagged carrier so option(option(T)) retains every state.
rel has_option(value: int).
has_option(1) <- type_row(kind: 'option').

# PascalCase = replace(initcap(Name), '_', ''), matching the prolog emitter.
# Inline, because an assignment-only rule has no positive body to group on.

# A leaf type is a primitive or a reference to another relation. Rel references
# render as the referenced rel's own PascalCase name.
rel leaf_type(id: int, text: text).
leaf_type(Id, 'string') <- type_row(Id, name: 'text', kind: 'primitive').
leaf_type(Id, 'number') <- type_row(Id, name: 'int', kind: 'primitive').
leaf_type(Id, 'number') <- type_row(Id, name: 'float', kind: 'primitive').
leaf_type(Id, 'boolean') <- type_row(Id, name: 'bool', kind: 'primitive').
leaf_type(Id, 'unknown') <- type_row(Id, name: 'json', kind: 'primitive').
leaf_type(Id, TypeName) <- emitted_type_name(Id, TypeName).
leaf_type(Id, TypeName) <-
  type_row(id: Id, name: EnumName, kind: 'enum'),
  TypeName := replace(initcap(EnumName), '_', '').

# A type parameter stands for itself inside its generic's body, uncased.
leaf_type(Id, ParameterName) <-
  type_row(Id, name: ParameterName, kind: 'type_parameter').

# @comment-ok: the __ namespace filter; no contains/2 builtin, so instr marks it.
# The `__` namespace marks compiler-minted rels (list companions, option enums,
# split refs); only author rels render. There is no contains/2 builtin, so a
# name carries the marker when instr finds the double underscore at a position
# past the first character.
rel minted_rel(name: text).
minted_rel(Name) <-
  type_row(Name, kind: 'rel'),
  Position := instr(Name, '__'),
  Position > 0.

# A concrete_type row's parent is the rel id it instantiates; that rel reaches
# the file even when minted, mirroring 7_emit_ts_types.pl's concrete_rel/2.
rel concrete_type_row(id: int, rel_id: int).
concrete_type_row(Id, RelId) <-
  type_row(Id, parent: RelId, kind: 'concrete_type').

rel concrete_rel(rel_id: int).
concrete_rel(RelId) <- concrete_type_row(_, RelId).

# The rels that reach the file, with the PascalCase name each one asks for.
rel renderable_rel(rel_id: int, bare_type: text, module_id: int).
renderable_rel(RelId, BareType, ModuleId) <-
  type_row(id: RelId, name: RelName, kind: 'rel', module_id: ModuleId),
  not(minted_rel(RelName)),
  BareType := replace(initcap(RelName), '_', '').
renderable_rel(RelId, BareType, ModuleId) <-
  type_row(id: RelId, name: RelName, kind: 'rel', module_id: ModuleId),
  minted_rel(RelName),
  concrete_rel(RelId),
  BareType := replace(initcap(RelName), '_', '').

# Two rels asking for one name collide; the id inequality names each pair once.
rel colliding_type_name(bare_type: text).
colliding_type_name(BareType) <-
  renderable_rel(LeftRelId, BareType, _),
  renderable_rel(RightRelId, BareType, _),
  LeftRelId < RightRelId.

# @comment-ok: sanitizer bound; initcap_words lower-cases non-boundary chars,
# mangling camelCase ("myModule" -> "Mymodule"), so this caps only each split word's first character, mirroring module_type_name/2.
rel module_name_normalized(module_id: int, normalized: text).
module_name_normalized(ModuleId, Normalized) <-
  type_row(id: ModuleId, name: ModuleName, kind: 'module'),
  Normalized := replace(replace(replace(ModuleName, '.', '_'), '-', '_'), '/', '_').

rel module_name_parts(module_id: int, parts: list(text)).
module_name_parts(ModuleId, Parts) <-
  module_name_normalized(ModuleId, Normalized),
  Parts := split(Normalized, '_').

# A split word carries no internal separator, so capping only substr(.,1,1)
# preserves the rest verbatim instead of lower-casing it like initcap_words.
rel module_name_word(module_id: int, word: text).
module_name_word(ModuleId, Word) <-
  module_name_parts(ModuleId, Parts),
  decode(Parts, spread(Part)),
  Word := concat([upper(substr(Part, 1, 1)), substr(Part, 2)]).

rel module_type_stem(module_id: int, stem: text).
module_type_stem(ModuleId, group_concat(Word, '')) <-
  module_name_word(ModuleId, Word).

# A TS identifier cannot open on a digit, so a digit-leading stem takes an 'M'.
rel module_prefix(module_id: int, prefix: text).
module_prefix(ModuleId, Prefix) <-
  module_type_stem(ModuleId, Stem),
  DigitPosition := instr('0123456789', substr(Stem, 1, 1)),
  DigitPosition > 0,
  Prefix := concat(['M', Stem]).
module_prefix(ModuleId, Stem) <-
  module_type_stem(ModuleId, Stem),
  DigitPosition := instr('0123456789', substr(Stem, 1, 1)),
  DigitPosition < 1.

# The name a rel actually emits: bare when unique, module-prefixed when not.
rel emitted_type_name(rel_id: int, type_name: text).
emitted_type_name(RelId, BareType) <-
  renderable_rel(RelId, BareType, _),
  not(colliding_type_name(BareType)).
emitted_type_name(RelId, TypeName) <-
  renderable_rel(RelId, BareType, ModuleId),
  colliding_type_name(BareType),
  module_prefix(ModuleId, Prefix),
  TypeName := concat([Prefix, BareType]).

rel relation_id_column(column_id: int).
relation_id_column(ColumnId) <-
  type_storage(column_id: ColumnId, local_name: 'relation_id').

rel has_relation_id(value: int).
has_relation_id(1) <- relation_id_column(_).
has_relation_id(1) <- type_row(kind: 'relation_id_list').

rel relation_id_type(column_id: int, text: text).
relation_id_type(ColumnId, Text) <-
  relation_id_column(ColumnId),
  type_row(id: ColumnId, kind: 'column', type_id: TargetId),
  emitted_type_name(TargetId, Target),
  Text := concat(['RelationId<\'', Target, '\'>']).

# An option over a leaf, kept apart from option_type so a list can hold one
# without the list strata reading the option stratum that reads them back.
rel option_of_leaf(id: int, text: text).
option_of_leaf(Id, Text) <-
  type_row(Id, kind: 'option', type_id: ElemId),
  leaf_type(ElemId, Element),
  Text := concat(['Option<', Element, '>']).

# The innermost thing a list holds: a leaf, or a nullable leaf.
rel list_element(id: int, text: text).
list_element(Id, Text) <- leaf_type(Id, Text).
list_element(Id, Text) <- option_of_leaf(Id, Text).

# Both list spellings render one TS type: json_list(T) carries the array inline,
# list(T) carries the elements in a member rel, and a consumer sees Array<T>.
rel list_row(id: int, element_id: int).
list_row(Id, ElemId) <- type_row(Id, kind: 'json_list', type_id: ElemId).
list_row(Id, ElemId) <- type_row(Id, kind: 'list', type_id: ElemId).
list_row(Id, ElemId) <- type_row(Id, kind: 'relation_id_list', type_id: ElemId).

# Step 1 is the outermost wrap, inner_id what is left inside after that many.
# The head carries an int: lower.pl:5258 stops a built text in a recursive head.
rel list_step(list_id: int, step: int, inner_id: int).
list_step(Id, 1, ElemId) <- list_row(Id, ElemId).
list_step(Id, Step, InnerId) <-
  list_step(Id, Step0, MiddleId),
  list_row(MiddleId, InnerId),
  Step := Step0 + 1.

# Exactly one step of a chain lands on something a list can hold.
rel list_innermost(list_id: int, element_text: text).
list_innermost(Id, ElementText) <-
  list_step(Id, _, InnerId),
  not(list_relation_id_terminal(Id, _)),
  list_element(InnerId, ElementText).

rel list_relation_id_terminal(list_id: int, target_id: int).
list_relation_id_terminal(Id, TargetId) <-
  list_step(Id, _, RelationIdList),
  type_row(id: RelationIdList, kind: 'relation_id_list', type_id: TargetId).

list_innermost(Id, ElementText) <-
  list_relation_id_terminal(Id, TargetId),
  emitted_type_name(TargetId, Target),
  ElementText := concat(['RelationId<\'', Target, '\'>']).

# One opener and one closer per step, folded by group_concat, so nesting
# carries no depth bound.
rel list_open_part(list_id: int, step: int, part: text).
list_open_part(Id, Step, 'Array<') <- list_step(Id, Step, _).

rel list_close_part(list_id: int, step: int, part: text).
list_close_part(Id, Step, '>') <- list_step(Id, Step, _).

rel list_open_text(list_id: int, open_text: text).
list_open_text(Id, group_concat(Part, '', Step)) <- list_open_part(Id, Step, Part).

rel list_close_text(list_id: int, close_text: text).
list_close_text(Id, group_concat(Part, '', Step)) <- list_close_part(Id, Step, Part).

rel list_type(id: int, text: text).
list_type(Id, Text) <-
  list_innermost(Id, ElementText),
  list_open_text(Id, OpenText),
  list_close_text(Id, CloseText),
  Text := concat([OpenText, ElementText, CloseText]).

# What an option wraps: a leaf, or a list of any rendered depth.
rel element_type(id: int, text: text).
element_type(Id, Text) <- leaf_type(Id, Text).
element_type(Id, Text) <- list_type(Id, Text).

# The catalog refuses a source type deeper than five option edges before this
# renderer runs (type_emitter_option_depth/2). Each layer settles in one
# dataflow round, so the finite unroll renders from one arrival batch.
rel option_type(id: int, text: text).
rel option_depth_one(id: int, text: text).
option_depth_one(Id, Text) <-
  type_row(Id, kind: 'option', type_id: ElemId),
  element_type(ElemId, Element),
  Text := concat(['Option<', Element, '>']).

rel option_depth_two(id: int, text: text).
option_depth_two(Id, Text) <-
  type_row(Id, kind: 'option', type_id: ElemId),
  option_depth_one(ElemId, Element),
  Text := concat(['Option<', Element, '>']).
rel option_depth_three(id: int, text: text).
option_depth_three(Id, Text) <-
  type_row(Id, kind: 'option', type_id: ElemId),
  option_depth_two(ElemId, Element),
  Text := concat(['Option<', Element, '>']).
rel option_depth_four(id: int, text: text).
option_depth_four(Id, Text) <-
  type_row(Id, kind: 'option', type_id: ElemId),
  option_depth_three(ElemId, Element),
  Text := concat(['Option<', Element, '>']).
rel option_depth_five(id: int, text: text).
option_depth_five(Id, Text) <-
  type_row(Id, kind: 'option', type_id: ElemId),
  option_depth_four(ElemId, Element),
  Text := concat(['Option<', Element, '>']).
option_type(Id, Text) <- option_depth_one(Id, Text).
option_type(Id, Text) <- option_depth_two(Id, Text).
option_type(Id, Text) <- option_depth_three(Id, Text).
option_type(Id, Text) <- option_depth_four(Id, Text).
option_type(Id, Text) <- option_depth_five(Id, Text).

# type_of is the union of the kind arms; each type id is one kind.
rel type_of(id: int, text: text).
type_of(Id, Text) <- element_type(Id, Text).
type_of(Id, Text) <- option_type(Id, Text).

# Two rels can mint one PascalCase name, so the owner rel id is the key here
# and the name is joined on only at the wrap.
rel field_line(rel_id: int, ordinal: int, line_text: text).
field_line(RelId, Ordinal, LineText) <-
  type_row(id: ColumnId, parent: RelId, ordinal: Ordinal, name: ColumnName,
           kind: 'column', type_id: TypeId),
  renderable_rel(RelId, _, _),
  relation_id_type(ColumnId, Type),
  LineText := concat(['  ', ColumnName, ': ', Type, ';']).
field_line(RelId, Ordinal, LineText) <-
  type_row(id: ColumnId, parent: RelId, ordinal: Ordinal, name: ColumnName,
           kind: 'column', type_id: TypeId),
  renderable_rel(RelId, _, _),
  not(relation_id_column(ColumnId)),
  type_of(TypeId, Type),
  LineText := concat(['  ', ColumnName, ': ', Type, ';']).

# The interface body: field lines joined in ordinal order by newline.
rel body_text(rel_id: int, body: text).
body_text(RelId, group_concat(LineText, '\n', Ordinal)) <-
  field_line(RelId, Ordinal, LineText).

# Body carries no trailing newline, so the closing brace lands on its own line.
# Assembly order is (part_ordinal, source_id): interfaces 0, generic rels 1, rels 2.
rel rendered_type(type_name: text, part_ordinal: int, source_id: int,
                  file_text: text).
rendered_type(TypeName, 2, RelId, FileText) <-
  body_text(RelId, Body),
  emitted_type_name(RelId, TypeName),
  FileText := concat(['export interface ', TypeName, ' {\n', Body, '\n}\n']).

rel enum_variant_line(enum_id: int, ordinal: int, line: text).
enum_variant_line(EnumId, Ordinal, Line) <-
  type_row(parent: EnumId, ordinal: Ordinal, name: VariantName,
           kind: 'enum_variant'),
  not(enum_variant_field(EnumId, Ordinal, _, _, _)),
  Line := concat(['  | { tag: \'', VariantName, '\' }']).
enum_variant_line(EnumId, Ordinal, Line) <-
  type_row(parent: EnumId, ordinal: Ordinal, name: VariantName,
           kind: 'enum_variant'),
  enum_variant_body(EnumId, Ordinal, Body),
  Line := concat(['  | { tag: \'', VariantName, '\'; ', Body, ' }']).

rel enum_variant_field(enum_id: int, ordinal: int, field_ordinal: int, name: text, text: text).
enum_variant_field(EnumId, Ordinal, FieldOrdinal, FieldName, FieldText) <-
  type_row(parent: EnumId, ordinal: Ordinal, kind: 'enum_variant', type_id: VariantId),
  type_row(id: ColumnId, parent: VariantId, ordinal: FieldOrdinal, name: FieldName,
           kind: 'column', type_id: TypeId),
  FieldName != 'id',
  relation_id_type(ColumnId, Type),
  FieldText := concat([FieldName, ': ', Type, ';']).
enum_variant_field(EnumId, Ordinal, FieldOrdinal, FieldName, FieldText) <-
  type_row(parent: EnumId, ordinal: Ordinal, kind: 'enum_variant', type_id: VariantId),
  type_row(id: ColumnId, parent: VariantId, ordinal: FieldOrdinal, name: FieldName,
           kind: 'column', type_id: TypeId),
  FieldName != 'id',
  not(relation_id_column(ColumnId)),
  type_of(TypeId, Type),
  FieldText := concat([FieldName, ': ', Type, ';']).

rel enum_variant_body(enum_id: int, ordinal: int, body: text).
enum_variant_body(EnumId, Ordinal, group_concat(FieldText, ' ', FieldOrdinal)) <-
  enum_variant_field(EnumId, Ordinal, FieldOrdinal, _FieldName, FieldText).

rel enum_body(enum_id: int, body: text).
enum_body(EnumId, group_concat(Line, '\n', Ordinal)) <-
  enum_variant_line(EnumId, Ordinal, Line).

rendered_type(TypeName, 2, EnumId, FileText) <-
  type_row(id: EnumId, name: EnumName, kind: 'enum'),
  enum_body(EnumId, Body),
  TypeName := replace(initcap(EnumName), '_', ''),
  FileText := concat(['export type ', TypeName, ' =\n', Body, ';\n']).

rendered_type('Option', 0, 0,
              'export type Option<T> = { tag: \'none\' } | { tag: \'some\'; value: T };\n') <-
  has_option(1).

rendered_type('RelationId', 0, -1,
              'declare const __dl6RelationId: unique symbol;\nexport type RelationId<T extends string> = number & { readonly [__dl6RelationId]: T };\n') <-
  has_relation_id(1).

# An interface declaration names a capability and holds no columns, so its
# whole text is the empty-brace pair on one line.
rendered_type(TypeName, 0, InterfaceId, FileText) <-
  type_row(id: InterfaceId, name: InterfaceName, kind: 'interface'),
  TypeName := replace(initcap(InterfaceName), '_', ''),
  FileText := concat(['export interface ', TypeName, ' {}\n']).

# A constraint row hangs off the parameter it bounds; TS joins bounds with ' & '.
rel constraint_type(parameter_id: int, ordinal: int, type_name: text).
constraint_type(ParameterId, Ordinal, TypeName) <-
  type_row(parent: ParameterId, ordinal: Ordinal, name: InterfaceName,
           kind: 'constraint'),
  TypeName := replace(initcap(InterfaceName), '_', '').

rel parameter_bound(parameter_id: int, bound: text).
parameter_bound(ParameterId, group_concat(TypeName, ' & ', Ordinal)) <-
  constraint_type(ParameterId, Ordinal, TypeName).

rel bounded_parameter(parameter_id: int).
bounded_parameter(ParameterId) <- constraint_type(ParameterId, _, _).

# An unbounded parameter is its bare name; a bounded one carries `extends`.
rel parameter_text(generic_id: int, ordinal: int, parameter_text: text).
parameter_text(GenericId, Ordinal, ParameterText) <-
  type_row(id: ParameterId, parent: GenericId, ordinal: Ordinal,
           name: ParameterName, kind: 'type_parameter'),
  parameter_bound(ParameterId, Bound),
  ParameterText := concat([ParameterName, ' extends ', Bound]).
parameter_text(GenericId, Ordinal, ParameterName) <-
  type_row(id: ParameterId, parent: GenericId, ordinal: Ordinal,
           name: ParameterName, kind: 'type_parameter'),
  not(bounded_parameter(ParameterId)).

rel parameters_text(generic_id: int, parameters: text).
parameters_text(GenericId, group_concat(ParameterText, ', ', Ordinal)) <-
  parameter_text(GenericId, Ordinal, ParameterText).

rel parameterized_generic(generic_id: int).
parameterized_generic(GenericId) <-
  type_row(parent: GenericId, kind: 'type_parameter').

# The declaration head: PascalCase name, then the parameter list when there is one.
rel generic_head(generic_id: int, type_name: text, head_text: text).
generic_head(GenericId, TypeName, HeadText) <-
  type_row(id: GenericId, name: GenericName, kind: 'generic_rel'),
  parameters_text(GenericId, Parameters),
  TypeName := replace(initcap(GenericName), '_', ''),
  HeadText := concat([TypeName, '<', Parameters, '>']).
generic_head(GenericId, TypeName, TypeName) <-
  type_row(id: GenericId, name: GenericName, kind: 'generic_rel'),
  not(parameterized_generic(GenericId)),
  TypeName := replace(initcap(GenericName), '_', '').

rel generic_field_line(generic_id: int, ordinal: int, line_text: text).
generic_field_line(GenericId, Ordinal, LineText) <-
  type_row(parent: GenericId, ordinal: Ordinal, name: ColumnName,
           kind: 'generic_column', type_id: TypeId),
  type_of(TypeId, Type),
  LineText := concat(['  ', ColumnName, ': ', Type, ';']).

rel generic_body(generic_id: int, body: text).
generic_body(GenericId, group_concat(LineText, '\n', Ordinal)) <-
  generic_field_line(GenericId, Ordinal, LineText).

rel columned_generic(generic_id: int).
columned_generic(GenericId) <- generic_field_line(GenericId, _, _).

rendered_type(TypeName, 1, GenericId, FileText) <-
  generic_head(GenericId, TypeName, HeadText),
  generic_body(GenericId, Body),
  FileText := concat(['export interface ', HeadText, ' {\n', Body, '\n}\n']).
rendered_type(TypeName, 1, GenericId, FileText) <-
  generic_head(GenericId, TypeName, HeadText),
  not(columned_generic(GenericId)),
  FileText := concat(['export interface ', HeadText, ' {\n}\n']).
