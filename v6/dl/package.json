    "serve": "node --experimental-transform-types src/main.ts"
  },
  "dependencies": {
    "@libsql/client": "^0.17.4",
    "langium": "~4.3.1",
    "lodash-es": "^4.17.21",
    "pino": "10.3.1",
    "rxjs": "^7.8.2",
    "sprefa-store-engine": "link:../sprefa-store/js"
  },
  "devDependencies": {
    "@ast-grep/cli": "^0.39.0",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^24.0.0",
    "@typescript/native-preview": "^7.0.0-dev.20260707.2",
    "langium-cli": "~4.3.0"
  }
}
