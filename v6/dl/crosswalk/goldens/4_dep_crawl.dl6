# 4_dep_crawl.dl6 -- the dependency-crawl frontier closure, as authored dl6.
#
# 0_multirepo_crawl.dl6 reads each repository's pins with a line regex, one
# repository per posted `want_repo` row: the repo set is DATA and it is fixed
# before the program runs. This program asks the other half of the question --
# starting from ONE seed coordinate, which repositories does the corpus REACH,
# and which targets fall outside it -- so the repo set is the ANSWER instead of
# the input, and one `want_crawl` row can name a corpus the poster never
# enumerated.
#
# ── THE PROGRAM OWNS ITS SEEDS ───────────────────────────────────────────────
# `repo_known` is one posted row per local checkout, the same shape
# `want_repo` already is in 0_multirepo_crawl.dl6: the corpus builder knows
# every directory it made, so it posts the roster instead of a shell scanning
# a directory listing into a rel. There is no executor here at all: the
# closure over `repo_known` and `repo_grep_at`'s go.mod reads IS the crawl.
#
# ── LOCAL LOCATE ONLY, GO.MOD ONLY ───────────────────────────────────────────
# A require target with no matching `repo_known` row becomes a `crawl_gap`
# row carrying its reason, so the boundary of the corpus is a relation and not
# a silence. On the pinned corpus that boundary is exactly
# github.com/pkg/errors and golang.org/x/sync. This program answers only the
# go_mod frontier; a specifier-import crawl is not built here.
#
# ── THE CEILING IS WHAT MAKES THE FIXPOINT FINITE ───────────────────────────
# Read alongside `crosswalk.dl6`'s `reach_level`/`reach_step`/`hop_ceiling`:
# the level rides inside the recursion so a cyclic require graph settles
# instead of minting a new hop forever, and `min(Level)` is the shortest way
# in.
#
# ── THE RX LOWERING ─────────────────────────────────────────────────────────
#   wantCrawl$.pipe(                                       // crawl_level(0)
#     mergeMap(seed => repoKnown$.pipe(
#       filter(repo => repo.coordinate === seed.seed))))
#
#   crawlLevel$.pipe(                                       // crawl_step
#     expand(node => frontierTarget$.pipe(
#              filter(t => t.fromCoordinate === node.repo),
#              mergeMap(t => repoKnown$.pipe(
#                filter(r => r.coordinate === t.target)))),
#            HOP_CEILING),
#     groupBy(node => node.key), mergeMap(g => g.pipe(min(n => n.level))))
#
#   frontierTarget$.pipe(                                    // crawl_gap
#     mergeMap(t => repoKnown$.pipe(
#       filter(r => r.coordinate === t.target), isEmpty()),
#       map(() => ({ ...t, reason: 'no_local_checkout' }))))

rel repo_grep_at(root: text, rev: text, glob: text, pattern: text)
   -> (path: text, line: int, g1: text, g2: text, g3: text).

rel want_crawl(checkout_root: text, seed: text, frontier: text).

# One row per local checkout the corpus builder made.
rel repo_known(checkout_root: text, coordinate: text, dir: text).

rel hop_ceiling(hops: int).
hop_ceiling(6).

# ── every require line every known checkout's go.mod declares ───────────────
rel frontier_target(checkout_root: text, from_coordinate: text, target: text, version: text).
frontier_target(CheckoutRoot, FromCoordinate, Target, Version) <-
  repo_known(CheckoutRoot, FromCoordinate, Dir),
  repo_grep_at(Dir, 'HEAD', 'go.mod',
               '([a-zA-Z0-9._-]+/[a-zA-Z0-9._/-]+)[ ]+(v[0-9][a-zA-Z0-9._-]*)',
               _Path, _Line, Target, Version, _G3).

# ── the frontier closure, bounded so a cyclic require graph still settles ───
rel crawl_level(seed: text, repo: text, level: int).
rel crawl_step(seed: text, repo: text, level: int).

crawl_level(Seed, Seed, 0) <-
  want_crawl(CheckoutRoot, Seed, "go_mod"),
  repo_known(CheckoutRoot, Seed, _Dir).
crawl_level(Seed, Repo, Level) <- crawl_step(Seed, Repo, Level).

crawl_step(Seed, ToCoordinate, NextLevel) <-
  crawl_level(Seed, FromCoordinate, Level),
  hop_ceiling(Ceiling),
  Level < Ceiling,
  want_crawl(CheckoutRoot, Seed, "go_mod"),
  frontier_target(CheckoutRoot, FromCoordinate, ToCoordinate, _Version),
  repo_known(CheckoutRoot, ToCoordinate, _Dir),
  NextLevel := Level + 1.

rel crawl_hops(seed: text, repo: text, hops: int).
crawl_hops(Seed, Repo, min(Level)) <- crawl_level(Seed, Repo, Level).

# ── the four projections, each carrying the seed it came from ───────────────
rel crawl_repo(seed: text, coordinate: text, root: text).
crawl_repo(Seed, Coordinate, Dir) <-
  crawl_hops(Seed, Coordinate, _Hops),
  want_crawl(CheckoutRoot, Seed, "go_mod"),
  repo_known(CheckoutRoot, Coordinate, Dir).

rel crawl_visit(seed: text, repo: text, rev: text, hop: int).
crawl_visit(Seed, Repo, "HEAD", Hops) <- crawl_hops(Seed, Repo, Hops).

rel crawl_edge(seed: text, from_repo: text, from_rev: text, target: text, to_repo: text).
crawl_edge(Seed, FromRepo, "HEAD", Target, Target) <-
  crawl_hops(Seed, FromRepo, _Hops),
  want_crawl(CheckoutRoot, Seed, "go_mod"),
  frontier_target(CheckoutRoot, FromRepo, Target, _Version),
  repo_known(CheckoutRoot, Target, _Dir).

rel crawl_gap(seed: text, from_repo: text, target: text, reason: text).
crawl_gap(Seed, FromRepo, Target, "no_local_checkout") <-
  crawl_hops(Seed, FromRepo, _Hops),
  want_crawl(CheckoutRoot, Seed, "go_mod"),
  frontier_target(CheckoutRoot, FromRepo, Target, _Version),
  not(repo_known(CheckoutRoot, Target, _Dir)).

# ── the seed-free union, which is what 2_gate.sh's v5 golden can be diffed on
# Every dependency the corpus declares, whichever side of the checkout boundary
# it landed on. Two rules into one rel is the split-and-union shape: a resolved
# target and an unresolved one are the same fact about the go.mod line, and only
# the second half needs the reason column.
rel dep_target(from_repo: text, target: text).
dep_target(from_repo, target) <- crawl_edge(_, from_repo, _, target, _).
dep_target(from_repo, target) <- crawl_gap(_, from_repo, target, _).

# ── the boundary of the corpus, as a relation ───────────────────────────────
rel corpus_boundary(target: text, reason: text).
corpus_boundary(target, reason) <- crawl_gap(_, _, target, reason).

# ── blast radius of one seed: how many repositories it reaches ──────────────
# The grouping column is local to the rel being counted, which is what
# aggregate_group_not_delta_local requires.
rel crawl_reach(seed: text, repos: int).
crawl_reach(seed, count(repo)) <- crawl_visit(seed, repo, _, _).

? crawl_visit(seed, repo, rev, hop).
? dep_target(from_repo, target).
? corpus_boundary(target, reason).
? crawl_reach(seed, repos).
