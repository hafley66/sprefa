# 4_dep_crawl.dl6 -- the dependency-crawl frontier closure, as authored dl6.
#
# 0_multirepo_crawl.dl6 reads each repository's pins with a line regex, one
# repository per posted `want_repo` row: the repo set is DATA and it is fixed
# before the program runs. This program asks the other half of the question --
# starting from ONE seed coordinate, which repositories does the corpus REACH,
# and which targets fall outside it -- so the repo set is the ANSWER instead of
# the input, and one `want_crawl` row can name a corpus the poster never
# enumerated.
#
# ── FOUR NAMES, ONE FRONTIER CLOSURE ────────────────────────────────────────
# A crawl produces four relations of different arity, and a host answers with
# one output shape, so the crawl is declared as four hosts over the same three
# inputs. `sprefa-engine-rs/src/hosts.rs` recognizes the four ruled names, runs
# `dep_resolve.rs` in-process, and memoises on (frontier, checkout_root, seed),
# so the four demands settle one traversal. That is the SoopyFilesExecutor
# arrangement (`hosts.rs:46`) applied to a second family of ruled names, and it
# is why every template below exits nonzero: a runtime WITHOUT the linked arm
# must stop by name rather than answer zero rows out of a shell.
#
# ── LOCAL LOCATE ONLY ───────────────────────────────────────────────────────
# `dep_resolve.rs:1` never reaches the network. A target with no checkout under
# the root becomes a `dep_crawl_unresolved` row carrying the reason, so the
# boundary of the corpus is a relation and not a silence. On the pinned corpus
# that boundary is exactly github.com/pkg/errors and golang.org/x/sync.
#
# ── THE RX LOWERING ─────────────────────────────────────────────────────────
#   wantCrawl$.pipe(                                     // crawl_repo, and the
#     map(mintIdentityAndWitness),                       // three siblings, one
#     distinct(demand => demand.witnessDigest),          // shared traversal
#     mergeMap(runCrawlMemoised),
#     mergeMap(commitEdbArrival))
#
#   merge(crawlEdge$, crawlGap$).pipe(                   // dep_target
#     map(row => [row.fromRepo, row.target]), distinct())
#
#   crawlVisit$.pipe(groupBy(row => row.seed),           // crawl_reach
#                    mergeMap(group => group.pipe(count())))

rel dep_crawl_repo(checkout_root: text, seed: text, frontier: text)
   -> (coordinate: text, root: text).

rel dep_crawl_visited(checkout_root: text, seed: text, frontier: text)
   -> (repo: text, rev: text, hop: int).

rel dep_crawl_edge(checkout_root: text, seed: text, frontier: text)
   -> (from_repo: text, from_rev: text, target: text, to_repo: text).

rel dep_crawl_unresolved(checkout_root: text, seed: text, frontier: text)
   -> (from_repo: text, target: text, reason: text).

# One row per crawl. `frontier` names which reader answers `targets_at`:
# go_mod for a Go corpus, specifier for the import/require plane.
rel want_crawl(checkout_root: text, seed: text, frontier: text).

# ── the four projections, each carrying the seed it came from ───────────────
rel crawl_repo(seed: text, coordinate: text, root: text).
crawl_repo(seed, coordinate, root) <-
  want_crawl(checkout_root, seed, frontier),
  dep_crawl_repo(checkout_root, seed, frontier, coordinate, root).

rel crawl_visit(seed: text, repo: text, rev: text, hop: int).
crawl_visit(seed, repo, rev, hop) <-
  want_crawl(checkout_root, seed, frontier),
  dep_crawl_visited(checkout_root, seed, frontier, repo, rev, hop).

rel crawl_edge(seed: text, from_repo: text, from_rev: text, target: text, to_repo: text).
crawl_edge(seed, from_repo, from_rev, target, to_repo) <-
  want_crawl(checkout_root, seed, frontier),
  dep_crawl_edge(checkout_root, seed, frontier, from_repo, from_rev, target, to_repo).

rel crawl_gap(seed: text, from_repo: text, target: text, reason: text).
crawl_gap(seed, from_repo, target, reason) <-
  want_crawl(checkout_root, seed, frontier),
  dep_crawl_unresolved(checkout_root, seed, frontier, from_repo, target, reason).

# ── the seed-free union, which is what 2_gate.sh's v5 golden can be diffed on
# Every dependency the corpus declares, whichever side of the checkout boundary
# it landed on. Two rules into one rel is the split-and-union shape: a resolved
# target and an unresolved one are the same fact about the go.mod line, and only
# the second half needs the reason column.
rel dep_target(from_repo: text, target: text).
dep_target(from_repo, target) <- crawl_edge(_, from_repo, _, target, _).
dep_target(from_repo, target) <- crawl_gap(_, from_repo, target, _).

# ── the boundary of the corpus, as a relation ───────────────────────────────
rel corpus_boundary(target: text, reason: text).
corpus_boundary(target, reason) <- crawl_gap(_, _, target, reason).

# ── blast radius of one seed: how many repositories it reaches ──────────────
# The grouping column is local to the rel being counted, which is what
# aggregate_group_not_delta_local requires.
rel crawl_reach(seed: text, repos: int).
crawl_reach(seed, count(repo)) <- crawl_visit(seed, repo, _, _).

? crawl_visit(seed, repo, rev, hop).
? dep_target(from_repo, target).
? corpus_boundary(target, reason).
? crawl_reach(seed, repos).
