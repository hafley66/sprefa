# Five structural properties, argued in README.md, that a reader needs before
# editing any rule below.
#
# @comment-ok: the rate-budget contract, the one doc site.
# (1) A poll that is not due derives NO ROW in `due`, so `http.get` is never
# demanded and no request leaves the process.
# (2) `over_budget` anti-joins into `due`, so below the stop threshold the poll
# plane is empty until the reset bucket passes.
# (3) `endpoint_period` is a max over candidates, so X-Poll-Interval and the
# warn stretch can only SLOW a poll, never shorten the configured floor.
# (4) The transport holds NOTHING: the ETag, the 304 body, the page walk, the
# token and the GraphQL query are rules here, so a restart re-reads the db.
# (5) NO INPUT OF A DEMAND MOVES WITHIN A BUCKET. `page_prev_etag` is single
# valued and total per bucket, so one page asks one question per bucket.

use clock.
use dl.
use env.
use http.
use soopy.
use toml.

rel repo(owner: text, name: text).

rel config_candidate(search_rank: int, config_path: text).
config_candidate(1, "ghcache.toml").
config_candidate(2, "~/.config/ghcache/config.toml").
rel config_doc(config_path: text, doc: json).
rel config_present(search_rank: int, config_path: text).
rel best_config_rank(search_rank: int).
rel chosen_config(config_path: text, doc: json) key(1).

rel global_setting(poll_period: int, org_discovery_period: int,
                   rate_warn_threshold: int, rate_stop_threshold: int,
                   warn_stretch: int, heartbeat_ttl: int,
                   sync_notifications: int, staging_folder: text) key(1).

# Optional key: absent from the config yields no row, so the branches arm
# falls back to the global PollPeriod (the `not(...)` arm).
rel branches_period_setting(period_seconds: int) key(1).

rel org_config(owner: text, fs_alias: text, sync_prs: int, sync_events: int,
               sync_notifications: int, checkout_on_sync: int,
               checkout_pr_branches: int) key(1).
rel repo_config(owner: text, name: text, default_branch: text, sync_prs: int,
                sync_events: int, sync_notifications: int, sync_branches: text,
                checkout_on_sync: int, checkout_pr_branches: int) key(1, 2).
rel org_exclude(owner: text, name: text).

rel current_clock(period: int, bucket: int).

rel tick(every: int) -> (bucket: int).

rel period(every: int).
period(60).
period(3600).

# expand_probe_rule only desugars a probe inside `<-` (1_host_expand.pl:432);
# a slash executor in a `<+` body throws edge_body_shape (analyze.pl:999).
current_clock(Period, Bucket) <- period(Period), tick(Period, Bucket).

# bind_read_literals (emit_rust.pl:479) needs a literal interval/2 call
# somewhere; a bare-var call satisfies it too.
rel live_cadence(period: int).
live_cadence(60) <- interval(60, _Bucket).
live_cadence(3600) <- interval(3600, _Bucket).

# `tick(60, Bucket)` answers MINUTE buckets: a period spelled in seconds
# and compared against one fired hourly (issues/ghcache-dl6-poll).
rel clock_granularity(seconds: int).
clock_granularity(60).

# Every identity input must appear in the template (1_host_expand.pl:313) and
# the freshness input must not, which is why `bucket` is absent from all four.

rel json(config_path: text, bucket: int) -> (doc: json).

rel var(name: text, bucket: int) -> (value: text) key(1).

# ONE transport. `headers` is a JSON object of header name to value, so
# Authorization and If-None-Match reach the wire only from a rule's row.
#
# `prev_etag` shapes no header. It is demand identity, and `page_prev_etag` is
# what keeps it still for a whole bucket.
rel get(url: text, headers: text, prev_etag: text, bucket: int)
  -> (status: int, response_headers: json, body: json, bytes: int).

rel post(url: text, headers: text, request_body: text, bucket: int)
  -> (status: int, response_headers: json, body: json, bytes: int).

rel checkout(repo_slug: text, dest_root: text, want_sha: text)
  -> (checkout_path: text, head_sha: text).

rel mirror_pr_heads(repo_slug: text, dest_root: text, want_sha: text)
  -> (checkout_path: text, pr_head_count: int).

# ── config resolution ───────────────────────────────────────────────────────

config_doc(ConfigPath, Doc) <-
  config_candidate(ConfigPath),
  current_clock(3600, Bucket),
  json(ConfigPath, Bucket, Doc).

config_present(SearchRank, ConfigPath) <-
  config_candidate(SearchRank, ConfigPath),
  config_doc(ConfigPath).

best_config_rank(min(SearchRank)) <- config_present(SearchRank).

chosen_config(ConfigPath, Doc) <+
  best_config_rank(SearchRank),
  config_present(SearchRank, ConfigPath),
  config_doc(ConfigPath, Doc).

# The decode lands in the keyed fold itself: the source column is `json`, and
# that is the only axis decode/2 lowers on.
global_setting(PollPeriod, OrgDiscoveryPeriod, RateWarnThreshold,
               RateStopThreshold, WarnStretch, HeartbeatTtl,
               SyncNotifications, StagingFolder) <+
  chosen_config(Doc),
  decode(Doc, {global: {poll_interval_seconds: PollPeriod: int,
                        org_repo_discovery_interval_seconds: OrgDiscoveryPeriod: int,
                        rate_warn_threshold: RateWarnThreshold: int,
                        rate_stop_threshold: RateStopThreshold: int,
                        warn_stretch_multiplier: WarnStretch: int,
                        heartbeat_ttl_seconds: HeartbeatTtl: int,
                        sync_notifications: SyncNotifications: int,
                        staging_folder: StagingFolder: text}}).

branches_period_setting(BranchesPeriod) <+
  chosen_config(Doc),
  decode(Doc, {global: {branches_poll_interval_seconds: BranchesPeriod: int}}).

org_config(Owner, FsAlias, SyncPrs, SyncEvents, SyncNotifications,
           CheckoutOnSync, CheckoutPrBranches) <+
  chosen_config(Doc),
  decode(Doc, {org: [... {owner: Owner: text,
                          fs_alias: FsAlias: text,
                          sync_prs: SyncPrs: int,
                          sync_events: SyncEvents: int,
                          sync_notifications: SyncNotifications: int,
                          checkout_on_sync: CheckoutOnSync: int,
                          checkout_pr_branches: CheckoutPrBranches: int}]}).

repo_config(Owner, Name, DefaultBranch, SyncPrs, SyncEvents, SyncNotifications,
            SyncBranches, CheckoutOnSync, CheckoutPrBranches) <+
  chosen_config(Doc),
  decode(Doc, {repo: [... {owner: Owner: text,
                           name: Name: text,
                           default_branch: DefaultBranch: text,
                           sync_prs: SyncPrs: int,
                           sync_events: SyncEvents: int,
                           sync_notifications: SyncNotifications: int,
                           sync_branches: SyncBranches: text,
                           checkout_on_sync: CheckoutOnSync: int,
                           checkout_pr_branches: CheckoutPrBranches: int}]}).

# ── the token, read once an hour and carried on every request row ───────────

rel token_var(search_rank: int, var_name: text).
token_var(1, "GITHUB_TOKEN").
token_var(2, "GH_TOKEN").
rel token_seen(search_rank: int, token_value: text).
rel best_token_rank(search_rank: int).
rel api_token(token_value: text) key(1).

token_seen(SearchRank, TokenValue) <-
  token_var(SearchRank, VarName),
  current_clock(3600, Bucket),
  var(VarName, Bucket, TokenValue),
  TokenValue != "".

best_token_rank(min(SearchRank)) <- token_seen(SearchRank).

api_token(TokenValue) <+
  best_token_rank(SearchRank),
  token_seen(SearchRank, TokenValue).

# ── the rate budget ─────────────────────────────────────────────────────────

rel api_tier(api_type: text, warn_threshold: int, stop_threshold: int).
rel rate_state(api_type: text, remaining: int, reset_at: int) key(1).
rel rate_warm(api_type: text).
rel over_budget(api_type: text, bucket: int).

api_tier('rest', WarnThreshold, StopThreshold) <-
  global_setting(rate_warn_threshold: WarnThreshold, rate_stop_threshold: StopThreshold).
api_tier('graphql', WarnThreshold, StopThreshold) <-
  global_setting(rate_warn_threshold: WarnThreshold, rate_stop_threshold: StopThreshold).

# A rel keyed on api_type IS gh.rs:147-154's ORDER BY id DESC LIMIT 1: the last
# write for a key is the row.
rate_state(ApiType, Remaining, ResetAt) <+
  call_log(api_type: ApiType, rate_remaining: Remaining, rate_reset: ResetAt),
  Remaining >= 0.

rate_warm(ApiType) <-
  rate_state(ApiType, Remaining),
  api_tier(ApiType, WarnThreshold, StopThreshold),
  Remaining =< WarnThreshold,
  Remaining > StopThreshold.

# `x-ratelimit-reset` is EPOCH SECONDS and `Bucket` is epoch MINUTES, so the
# comparison is in buckets: raw, every reset is in the future and the poll
# never resumes (MEASURED live: zero calls after one stop, forever).
over_budget(ApiType, Bucket) <-
  current_clock(60, Bucket),
  rate_state(ApiType, Remaining, ResetAt),
  api_tier(ApiType, StopThreshold),
  Remaining =< StopThreshold,
  clock_granularity(Granularity),
  ResetBucket := ResetAt / Granularity,
  Bucket < ResetBucket.

# ── the endpoint plane ──────────────────────────────────────────────────────

rel watched_endpoint(endpoint_path: text, api_type: text, endpoint_kind: text,
                     repo_ref: repo).
rel watched_global(endpoint_path: text, api_type: text, endpoint_kind: text).
rel watched_repo(repo_ref: repo, owner: text, name: text, default_branch: text,
                 sync_prs: int, sync_events: int, sync_branches: text,
                 checkout_on_sync: int, checkout_pr_branches: int,
                 fs_alias: text) key(1).
rel watched_repo_seen(repo_ref: repo, owner: text, name: text,
                      default_branch: text, sync_prs: int, sync_events: int,
                      sync_branches: text, checkout_on_sync: int,
                      checkout_pr_branches: int, fs_alias: text).
rel org_owner(owner: text, fs_alias: text).
rel gh_username(login: text) key(1).
rel not_an_org(owner: text).
rel discovered_repo(owner: text, name: text, default_branch: text).

org_owner(Owner, FsAlias) <-
  org_config(Owner, FsAlias).

repo(Owner, Name) <- repo_config(Owner, Name).
repo(Owner, Name) <- discovered_repo(Owner, Name).

# A relation value may not appear anywhere in an edge rule (0_program_check.pl:
# 555-563), so every `repo(...)` is minted in a level rule and folded by variable.
watched_repo_seen(repo(Owner, Name), Owner, Name, DefaultBranch, SyncPrs,
                  SyncEvents, SyncBranches, CheckoutOnSync, CheckoutPrBranches,
                  Owner) <-
  repo_config(Owner, Name, DefaultBranch, SyncPrs, SyncEvents, SyncBranches, CheckoutOnSync, CheckoutPrBranches).

watched_repo_seen(repo(Owner, Name), Owner, Name, DefaultBranch, SyncPrs,
                  SyncEvents, "", CheckoutOnSync, CheckoutPrBranches,
                  FsAlias) <-
  discovered_repo(Owner, Name, DefaultBranch),
  org_config(Owner, FsAlias, SyncPrs, SyncEvents, CheckoutOnSync, CheckoutPrBranches),
  not(org_exclude(Owner, Name)).

watched_repo(RepoRef, Owner, Name, DefaultBranch, SyncPrs, SyncEvents,
             SyncBranches, CheckoutOnSync, CheckoutPrBranches, FsAlias) <+
  watched_repo_seen(RepoRef, Owner, Name, DefaultBranch, SyncPrs, SyncEvents,
                    SyncBranches, CheckoutOnSync, CheckoutPrBranches, FsAlias).

# The authenticated login, its own endpoint: the org-events path spells it and
# nothing else sources it (issues/ghcache-gh-username-unsourced).
watched_global("user", 'rest', 'gh_user') <- org_owner(_Owner, _FsAlias).

# An edge trigger atom binds by variable only (trigger_arg_not_var), so the
# endpoint kind is a guard here and a column pattern in a level body.
gh_username(Login) <+
  watched_global(endpoint_path: EndpointPath, endpoint_kind: EndpointKind),
  EndpointKind == "gh_user",
  rest_response(endpoint_path: EndpointPath, status: RespStatus, body: Body),
  RespStatus == 200,
  decode(Body, {login: Login: text}).

# A match scrutinee parses as a HEAD atom, so it is full arity or
# `partial_head` (parse_dl_dcg.pl:1400); the guard is an ordinary body.
match org_owner(Owner, _FsAlias) (
  ; not(not_an_org(Owner)),
    EndpointPath := concat(["orgs/", Owner, "/repos?per_page=100"])
    |-> watched_global(EndpointPath, 'rest', 'org_repos')
  ; not_an_org(Owner),
    EndpointPath := concat(["users/", Owner, "/repos?per_page=100"])
    |-> watched_global(EndpointPath, 'rest', 'user_repos')
).

watched_endpoint(EndpointPath, 'rest', 'repo_events', RepoRef) <-
  watched_repo(RepoRef, Owner, Name, SyncEvents),
  SyncEvents == 1,
  EndpointPath := concat(["repos/", Owner, "/", Name, "/events"]).

watched_endpoint(EndpointPath, 'rest', 'branches', RepoRef) <-
  watched_repo(RepoRef, Owner, Name, SyncBranches),
  SyncBranches != "",
  EndpointPath := concat(["repos/", Owner, "/", Name, "/branches?per_page=100"]).

# `users/<me>/events/orgs/<owner>` exists for an ORG account only; the two arms
# are exclusive on the same 404-sourced `not_an_org` the repos poll turns on.
match org_config(Owner, _FsAlias, _SyncPrs, SyncEvents, _SyncNotifications,
                 _CheckoutOnSync, _CheckoutPrBranches) (
  ; SyncEvents == 1,
    not(not_an_org(Owner)),
    gh_username(Username),
    EndpointPath := concat(["users/", Username, "/events/orgs/", Owner])
    |-> watched_global(EndpointPath, 'rest', 'org_events')
  ; SyncEvents == 1,
    not_an_org(Owner),
    EndpointPath := concat(["users/", Owner, "/events"])
    |-> watched_global(EndpointPath, 'rest', 'user_events')
).

watched_global("notifications", 'rest', 'notifications') <-
  global_setting(SyncNotifications),
  SyncNotifications == 1.

# ── the throttle, as rules ──────────────────────────────────────────────────

rel period_candidate(endpoint_path: text, period_ticks: int).
rel endpoint_period(endpoint_path: text, period_ticks: int).
rel poll_endpoint(endpoint_path: text, api_type: text, endpoint_kind: text).

poll_endpoint(EndpointPath, ApiType, EndpointKind) <-
  watched_endpoint(EndpointPath, ApiType, EndpointKind).
poll_endpoint(EndpointPath, ApiType, EndpointKind) <-
  watched_global(EndpointPath, ApiType, EndpointKind).

# Seconds to buckets, rounded UP: a period shorter than one bucket still polls
# every bucket rather than every bucket-count-of-seconds.
period_candidate(EndpointPath, PeriodTicks) <-
  poll_endpoint(EndpointPath, EndpointKind),
  EndpointKind != 'org_repos',
  EndpointKind != 'user_repos',
  EndpointKind != 'branches',
  global_setting(PollPeriod),
  clock_granularity(Granularity),
  Rounded := PollPeriod + Granularity - 1,
  PeriodTicks := Rounded / Granularity.

period_candidate(EndpointPath, PeriodTicks) <-
  poll_endpoint(endpoint_path: EndpointPath, endpoint_kind: 'org_repos'),
  global_setting(OrgDiscoveryPeriod),
  clock_granularity(Granularity),
  Rounded := OrgDiscoveryPeriod + Granularity - 1,
  PeriodTicks := Rounded / Granularity.
period_candidate(EndpointPath, PeriodTicks) <-
  poll_endpoint(endpoint_path: EndpointPath, endpoint_kind: 'user_repos'),
  global_setting(OrgDiscoveryPeriod),
  clock_granularity(Granularity),
  Rounded := OrgDiscoveryPeriod + Granularity - 1,
  PeriodTicks := Rounded / Granularity.

# Optional config key: absent from the config yields no row, so the branches
# arm falls back to the global PollPeriod, byte-identical to base.
period_candidate(EndpointPath, PeriodTicks) <-
  poll_endpoint(endpoint_path: EndpointPath, endpoint_kind: 'branches'),
  branches_period_setting(BranchesPeriod),
  clock_granularity(Granularity),
  Rounded := BranchesPeriod + Granularity - 1,
  PeriodTicks := Rounded / Granularity.
period_candidate(EndpointPath, PeriodTicks) <-
  poll_endpoint(endpoint_path: EndpointPath, endpoint_kind: 'branches'),
  not(branches_period_setting(_)),
  global_setting(PollPeriod),
  clock_granularity(Granularity),
  Rounded := PollPeriod + Granularity - 1,
  PeriodTicks := Rounded / Granularity.

period_candidate(EndpointPath, PeriodTicks) <-
  poll_state_period(EndpointPath, ServerPeriod),
  ServerPeriod > 0,
  clock_granularity(Granularity),
  Rounded := ServerPeriod + Granularity - 1,
  PeriodTicks := Rounded / Granularity.

period_candidate(EndpointPath, PeriodTicks) <-
  poll_endpoint(EndpointPath, ApiType),
  rate_warm(ApiType),
  global_setting(PollPeriod, WarnStretch),
  clock_granularity(Granularity),
  StretchSeconds := PollPeriod * WarnStretch,
  Rounded := StretchSeconds + Granularity - 1,
  PeriodTicks := Rounded / Granularity.

endpoint_period(EndpointPath, max(PeriodTicks)) <-
  period_candidate(EndpointPath, PeriodTicks).

# ── the 404 backoff, as rules (rx retryWhen with a delay) ───────────────────

rel miss_threshold(misses: int).
rel miss_cooloff(period_ticks: int).
rel endpoint_miss(endpoint_path: text, bucket: int).
rel endpoint_hit(endpoint_path: text, bucket: int).
rel miss_streak(endpoint_path: text, misses: int, at_bucket: int) key(1).
rel miss_next(endpoint_path: text, misses: int, at_bucket: int).
rel endpoint_cooling(endpoint_path: text, bucket: int).

miss_threshold(3).
miss_cooloff(60).

# Page 1 IS the endpoint: the repeated scrutinee variable keeps a page-walk 404
# out of the streak, and the hit arm's guard keeps a healthy endpoint off here.
match page_response(EndpointPath, EndpointPath, Bucket, _PrevEtag, RespStatus,
                    _Etag, _LastModified, _ServerPeriod, _RateRemaining,
                    _RateReset, _Link, _Bytes) (
  ; RespStatus == 404
    |-> endpoint_miss(EndpointPath, Bucket)
  ; RespStatus != 404,
    miss_streak(endpoint_path: EndpointPath, misses: Misses),
    Misses > 0
    |-> endpoint_hit(EndpointPath, Bucket)
).

# Two exclusive arms on `at_bucket`, the `page_prev_etag` shape: once this
# bucket's increment has folded, `at_bucket == Bucket` derives NO row at all.
match endpoint_miss(EndpointPath, Bucket) (
  ; miss_streak(endpoint_path: EndpointPath, misses: Misses,
                at_bucket: AtBucket),
    AtBucket < Bucket,
    NextMisses := Misses + 1
    |-> miss_next(EndpointPath, NextMisses, Bucket)
  ; not(miss_streak(EndpointPath))
    |-> miss_next(EndpointPath, 1, Bucket)
).

miss_streak(EndpointPath, NextMisses, Bucket) <+
  miss_next(EndpointPath, NextMisses, Bucket).

# Any non-404 answer resets the streak, so a flaky endpoint never cools.
miss_streak(EndpointPath, 0, Bucket) <+
  endpoint_hit(EndpointPath, Bucket).

# The cool-off is measured from the LAST miss, so a probe that 404s again pushes
# the resume bucket out by another cool-off rather than resuming every bucket.
endpoint_cooling(EndpointPath, Bucket) <-
  current_clock(60, Bucket),
  miss_streak(EndpointPath, Misses, AtBucket),
  miss_threshold(Threshold),
  Misses >= Threshold,
  miss_cooloff(CoolOff),
  ResumeBucket := AtBucket + CoolOff,
  Bucket < ResumeBucket.

# ── the poll, one demand row per PAGE ───────────────────────────────────────

rel due(endpoint_path: text, bucket: int, api_type: text).
rel poll_state(endpoint_path: text, etag: text, last_modified: text,
               poll_interval: int, last_polled_bucket: int,
               last_changed_bucket: int).
# `asked_etag` is the tag the request of `at_bucket` was ASKED with, and it is
# what the same bucket keeps reading once its own answer has moved `etag`.
rel poll_state_etag(page_url: text, etag: text, asked_etag: text,
                    at_bucket: int) key(1).
rel poll_state_modified(page_url: text, last_modified: text) key(1).
rel poll_state_period(page_url: text, server_period: int) key(1).
rel poll_state_polled(page_url: text, last_polled_bucket: int) key(1).
rel poll_state_changed(page_url: text, last_changed_bucket: int) key(1).

# `api_token` is a `<+` fold one tick behind `token_seen`: without it here the
# first poll is unauthenticated and reads the 60/hr bucket.
due(EndpointPath, Bucket, ApiType) <-
  current_clock(60, Bucket),
  poll_endpoint(EndpointPath, ApiType),
  endpoint_period(EndpointPath, PeriodTicks),
  api_token(TokenValue),
  not(over_budget(ApiType, Bucket)),
  not(endpoint_cooling(EndpointPath, Bucket)),
  PhaseSlot := Bucket mod PeriodTicks,
  PhaseSlot == 0.

# Page 1 is the endpoint; a later page is queued through a keyed rel so the
# walk carries ONE tick offset rather than a cycle through the transport.
rel page_cap(pages: int).
page_cap(10).
rel page_fetch(endpoint_path: text, page_url: text, page_ordinal: int,
               bucket: int).
rel page_queued(endpoint_path: text, page_url: text, page_ordinal: int,
                bucket: int) key(2, 4).
rel page_ordinal(page_url: text, bucket: int, page_ordinal: int) key(1, 2).

page_fetch(EndpointPath, EndpointPath, 1, Bucket) <-
  due(EndpointPath, Bucket).
# `page_queued` is a keyed fold and never retires, so without the clock join a
# page walked in ANY past bucket keeps re-deriving its question.
page_fetch(EndpointPath, PageUrl, PageOrdinal, Bucket) <-
  page_queued(EndpointPath, PageUrl, PageOrdinal, Bucket),
  current_clock(60, Bucket).

page_ordinal(EndpointPath, Bucket, 1) <+
  due(EndpointPath, Bucket).

page_ordinal(NextUrl, Bucket, NextOrdinal) <+
  next_page(PageUrl, Bucket, NextUrl),
  page_ordinal(PageUrl, Bucket, ParentOrdinal),
  page_cap(Cap),
  ParentOrdinal < Cap,
  NextOrdinal := ParentOrdinal + 1.

page_queued(EndpointPath, NextUrl, NextOrdinal, Bucket) <+
  next_page(EndpointPath, PageUrl, Bucket, NextUrl),
  page_ordinal(PageUrl, Bucket, ParentOrdinal),
  page_cap(Cap),
  ParentOrdinal < Cap,
  NextOrdinal := ParentOrdinal + 1.

# ── the request row: every header the wire sees is derived here ─────────────

rel request_header(page_url: text, header_name: text, header_value: text).
rel request_headers(page_url: text, headers: text).

request_header(PageUrl, "Accept", "application/vnd.github+json") <-
  page_fetch(PageUrl).

request_header(PageUrl, "Authorization", AuthValue) <-
  page_fetch(PageUrl),
  api_token(TokenValue),
  AuthValue := concat(["Bearer ", TokenValue]).

# The header and the `prev_etag` identity column read the SAME total rel, or a
# tick can mint a demand whose header says one thing and whose identity another.
request_header(PageUrl, "If-None-Match", PrevEtag) <-
  page_prev_etag(PageUrl, PrevEtag),
  PrevEtag != "".

request_headers(PageUrl, json_object(HeaderName, HeaderValue)) <-
  request_header(PageUrl, HeaderName, HeaderValue).

rel page_prev_etag(page_url: text, prev_etag: text).
rel page_arrival(endpoint_path: text, page_url: text, bucket: int,
                 prev_etag: text, status: int, response_headers: json,
                 body: json, bytes: int).

# @comment-ok: property (5) of the header, the one doc site for its shape.
# Three arms, exclusive on a key(1) rel and total, so the tag a bucket asks
# with is ONE value its own answer cannot move: before the answer `etag`, after
# it the `asked_etag` that answer was asked with, "" for a never-polled page.
# Arms rather than a coalesce: a coalesce over a DERIVED rel lets the read and
# the negation disagree for one tick, and that tick's demand is claimed before
# the disagreement settles.
page_prev_etag(PageUrl, PrevEtag) <-
  page_fetch(page_url: PageUrl, bucket: Bucket),
  poll_state_etag(page_url: PageUrl, etag: PrevEtag, at_bucket: AtBucket),
  AtBucket < Bucket.
page_prev_etag(PageUrl, PrevEtag) <-
  page_fetch(page_url: PageUrl, bucket: Bucket),
  poll_state_etag(page_url: PageUrl, asked_etag: PrevEtag, at_bucket: Bucket).
page_prev_etag(PageUrl, "") <-
  page_fetch(PageUrl),
  not(poll_state_etag(PageUrl)).

page_arrival(EndpointPath, PageUrl, Bucket, PrevEtag, Status, RespHeaders,
             Body, Bytes) <-
  page_fetch(EndpointPath, PageUrl, Bucket),
  request_headers(PageUrl, Headers),
  page_prev_etag(PageUrl, PrevEtag),
  get(PageUrl, Headers, PrevEtag, Bucket, Status, RespHeaders, Body,
           Bytes).

# ── the response headers, decoded ───────────────────────────────────────────

rel header_etag(page_url: text, bucket: int, etag: text).
rel header_modified(page_url: text, bucket: int, last_modified: text).
rel header_poll_interval(page_url: text, bucket: int, server_period: int).
rel header_rate_remaining(page_url: text, bucket: int, rate_remaining: int).
rel header_rate_reset(page_url: text, bucket: int, rate_reset: int).
rel header_link(page_url: text, bucket: int, link: text).

header_etag(PageUrl, Bucket, Etag) <-
  page_arrival(page_url: PageUrl, bucket: Bucket, response_headers: RespHeaders),
  decode(RespHeaders, {etag: Etag: text}).

header_modified(PageUrl, Bucket, LastModified) <-
  page_arrival(page_url: PageUrl, bucket: Bucket, response_headers: RespHeaders),
  decode(RespHeaders, {"last-modified": LastModified: text}).

header_poll_interval(PageUrl, Bucket, ServerPeriod) <-
  page_arrival(page_url: PageUrl, bucket: Bucket, response_headers: RespHeaders),
  decode(RespHeaders, {"x-poll-interval": ServerPeriod: int}).

header_rate_remaining(PageUrl, Bucket, RateRemaining) <-
  page_arrival(page_url: PageUrl, bucket: Bucket, response_headers: RespHeaders),
  decode(RespHeaders, {"x-ratelimit-remaining": RateRemaining: int}).

header_rate_reset(PageUrl, Bucket, RateReset) <-
  page_arrival(page_url: PageUrl, bucket: Bucket, response_headers: RespHeaders),
  decode(RespHeaders, {"x-ratelimit-reset": RateReset: int}).

header_link(PageUrl, Bucket, Link) <-
  page_arrival(page_url: PageUrl, bucket: Bucket, response_headers: RespHeaders),
  decode(RespHeaders, {link: Link: text}).

rel page_response(endpoint_path: text, page_url: text, bucket: int,
                  prev_etag: text, status: int, etag: text,
                  last_modified: text, server_period: int, rate_remaining: int,
                  rate_reset: int, link: text, bytes: int).

# An absent header is NO ROW out of decode, so every reading is a total read
# with the same default the deleted executor hard-coded.
page_response(EndpointPath, PageUrl, Bucket, PrevEtag, Status, Etag,
              LastModified, ServerPeriod, RateRemaining, RateReset, Link,
              Bytes) <-
  page_arrival(EndpointPath, PageUrl, Bucket, PrevEtag, Status, Bytes),
  coalesce(header_etag(PageUrl, Bucket, Etag), ""),
  coalesce(header_modified(PageUrl, Bucket, LastModified), ""),
  coalesce(header_poll_interval(PageUrl, Bucket, ServerPeriod), 0),
  coalesce(header_rate_remaining(PageUrl, Bucket, RateRemaining), -1),
  coalesce(header_rate_reset(PageUrl, Bucket, RateReset), 0),
  coalesce(header_link(PageUrl, Bucket, Link), "").

# ── RFC 5988 rel="next", read out of the Link header by rule ────────────────

rel link_part_list(endpoint_path: text, page_url: text, bucket: int,
                   parts: list(text)).
rel link_part(endpoint_path: text, page_url: text, bucket: int, part: text).
rel next_page(endpoint_path: text, page_url: text, bucket: int,
              next_url: text).

link_part_list(EndpointPath, PageUrl, Bucket, Parts) <-
  page_response(EndpointPath, PageUrl, Bucket, Status, Link),
  Status == 200,
  Link != "",
  Parts := split(Link, ',').

link_part(EndpointPath, PageUrl, Bucket, Part) <-
  link_part_list(EndpointPath, PageUrl, Bucket, Parts),
  decode(Parts, [... Part]).

next_page(EndpointPath, PageUrl, Bucket, NextUrl) <-
  link_part(EndpointPath, PageUrl, Bucket, Part),
  RelAt := instr(Part, "rel=\"next\""),
  RelAt > 0,
  OpenAt := instr(Part, "<"),
  CloseAt := instr(Part, ">"),
  OpenAt > 0,
  CloseAt > OpenAt,
  Start := OpenAt + 1,
  Span := CloseAt - Start,
  NextUrl := substr(Part, Start, Span).

# ── the 304, as a join against the body the program itself kept ─────────────

rel last_body(page_url: text, body: json) key(1).
rel rest_response(endpoint_path: text, bucket: int, status: int, body: json).

last_body(PageUrl, Body) <+
  page_arrival(PageUrl, Status, Body),
  Status == 200.

rest_response(EndpointPath, Bucket, Status, Body) <-
  page_arrival(EndpointPath, Bucket, Status, Body),
  Status == 200.

rest_response(EndpointPath, Bucket, Status, Body) <-
  page_arrival(EndpointPath, PageUrl, Bucket, Status),
  Status == 304,
  last_body(PageUrl, Body).

# Written direct from the response so every path back into the host demand
# carries ONE tick offset (3_clock_check.pl:336); not writing is db.rs:173's COALESCE.
# `prev_etag` comes off the ARRIVAL, so the write is one row per answer: a
# keyed rel updating mid-tick makes `page_prev_etag` momentarily two-valued.
poll_state_etag(PageUrl, Etag, AskedEtag, AtBucket) <+
  page_response(page_url: PageUrl, bucket: AtBucket, etag: Etag,
                prev_etag: AskedEtag),
  Etag != "".

poll_state_modified(PageUrl, LastModified) <+
  page_response(PageUrl, LastModified),
  LastModified != "".

poll_state_period(PageUrl, ServerPeriod) <+
  page_response(PageUrl, ServerPeriod),
  ServerPeriod > 0.

poll_state_polled(PageUrl, Bucket) <+
  page_response(PageUrl, Bucket).

poll_state_changed(PageUrl, Bucket) <+
  page_response(page_url: PageUrl, bucket: Bucket, status: RespStatus),
  RespStatus == 200.

# A coalesce source may leave exactly ONE column unbound
# (0_coalesce_expand.pl:161), so the tag reaches the view without its bucket.
rel poll_state_tag(page_url: text, etag: text).
poll_state_tag(PageUrl, Etag) <- poll_state_etag(PageUrl, Etag).

poll_state(PageUrl, Etag, LastModified, ServerPeriod, LastPolled,
           LastChanged) <-
  poll_state_polled(PageUrl, LastPolled),
  coalesce(poll_state_tag(PageUrl, Etag), ""),
  coalesce(poll_state_modified(PageUrl, LastModified), ""),
  coalesce(poll_state_period(PageUrl, ServerPeriod), 0),
  coalesce(poll_state_changed(PageUrl, LastChanged), 0).

# ── the call log ────────────────────────────────────────────────────────────

# 10.71 rows per minute bucket MEASURED over 1427 buckets; 16500 is 25.7 h.
rel call_log(at_tick: int, api_type: text, endpoint_path: text, status: int,
             rate_remaining: int, rate_reset: int, bytes: int,
             cache_hit: int) log keep(count(16500)).

# ONE edge arm: retention_head_conflict_risk (0_program_check.pl:666) refuses
# keep(count(N)) on a log head carrying two or more `<+` arms.
rel call_candidate(bucket: int, api_type: text, endpoint_path: text,
                   status: int, rate_remaining: int, rate_reset: int,
                   bytes: int, cache_hit: int).

# `bucket` rides the level row so an identical answer in a later bucket is still
# a positive delta, which is the granularity the three arms carried before.
match page_response(_EndpointPath, PageUrl, Bucket, _PrevEtag, Status, _Etag,
                    _LastModified, _ServerPeriod, RateRemaining, RateReset,
                    _Link, Bytes) (
  ; Status == 304
    |-> call_candidate(Bucket, 'rest', PageUrl, Status, RateRemaining,
                       RateReset, Bytes, 1)
  ; Status != 304
    |-> call_candidate(Bucket, 'rest', PageUrl, Status, RateRemaining,
                       RateReset, Bytes, 0)
).

call_candidate(Bucket, 'graphql', BatchKey, Status, RateRemaining, RateReset,
               Bytes, 0) <-
  pr_batch_response(batch_key: BatchKey, bucket: Bucket, status: Status,
                    rate_remaining: RateRemaining, rate_reset: RateReset,
                    bytes: Bytes).

call_log(AtTick, ApiType, EndpointPath, Status, RateRemaining, RateReset, Bytes,
         CacheHit) <+
  call_candidate(api_type: ApiType, endpoint_path: EndpointPath, status: Status,
                 rate_remaining: RateRemaining, rate_reset: RateReset,
                 bytes: Bytes, cache_hit: CacheHit),
  now(AtTick).

# ── org discovery ───────────────────────────────────────────────────────────

discovered_repo(Owner, Name, DefaultBranch) <-
  watched_global(endpoint_path: EndpointPath, endpoint_kind: 'org_repos'),
  org_owner(Owner),
  rest_response(endpoint_path: EndpointPath, status: RespStatus, body: Body),
  RespStatus == 200,
  decode(Body, [... {name: Name: text, default_branch: DefaultBranch: text}]).

discovered_repo(Owner, Name, DefaultBranch) <-
  watched_global(endpoint_path: EndpointPath, endpoint_kind: 'user_repos'),
  org_owner(Owner),
  rest_response(endpoint_path: EndpointPath, status: RespStatus, body: Body),
  RespStatus == 200,
  decode(Body, [... {name: Name: text, default_branch: DefaultBranch: text}]).

# "this owner is a user, not an org" is a durable fact and `call_log` is its
# durable record: the level arm derives it from ANY logged 404 on the org-repos
# path, so a restart re-learns it from history instead of waiting out the next
# poll period. A live 404 reaches `call_log` the same tick and lands here too.
not_an_org(Owner) <-
  call_log(_AtTick, _ApiType, LoggedPath, LoggedStatus, _Remaining, _Reset,
           _Bytes, _CacheHit),
  LoggedStatus == 404,
  org_owner(Owner),
  OrgReposPath := concat(["orgs/", Owner, "/repos?per_page=100"]),
  LoggedPath == OrgReposPath.

# ── repo events ─────────────────────────────────────────────────────────────

rel repo_event(repo_ref: repo, gh_id: text, event_type: text, actor: text,
               payload: json, created_at: text) key(1, 2).
rel repo_event_seen(repo_ref: repo, gh_id: text, event_type: text, actor: text,
                    payload: json, created_at: text).
rel dirty_pr(repo_ref: repo, number: int).
rel dirty_repo(repo_ref: repo).

# The keyed fold IS sync/events.rs:67's INSERT OR IGNORE: an already-stored
# event writes an identical row, and an identical write is a zero delta.
repo_event_seen(RepoRef, GhId, EventType, Actor, Payload, CreatedAt) <-
  watched_endpoint(endpoint_path: EndpointPath, endpoint_kind: 'repo_events', repo_ref: RepoRef),
  rest_response(endpoint_path: EndpointPath, status: RespStatus, body: Body),
  RespStatus == 200,
  decode(Body, [... {id: GhId: text, type: EventType: text,
                     actor: {login: Actor: text}, payload: Payload,
                     created_at: CreatedAt: text}]).

repo_event(RepoRef, GhId, EventType, Actor, Payload, CreatedAt) <+
  repo_event_seen(RepoRef, GhId, EventType, Actor, Payload, CreatedAt).

dirty_pr(RepoRef, Number) <-
  repo_event_seen(repo_ref: RepoRef, event_type: 'PullRequestEvent', payload: Payload),
  decode(Payload, {number: Number: int}).

dirty_pr(RepoRef, Number) <-
  repo_event_seen(repo_ref: RepoRef, event_type: 'PullRequestReviewEvent', payload: Payload),
  decode(Payload, {pull_request: {number: Number: int}}).

# A PushEvent carries a ref, not a number; the join against the stored open PR
# set is the whole of sync/events.rs:250-259 pr_numbers_from_branch.
dirty_pr(RepoRef, Number) <-
  repo_event_seen(repo_ref: RepoRef, event_type: 'PushEvent', payload: Payload),
  decode(Payload, {ref: PushRef: text}),
  HeadRef := substr(PushRef, 12),
  open_pr_head(RepoRef, Number, HeadRef).

dirty_pr(RepoRef, Number) <-
  repo_event_seen(repo_ref: RepoRef, event_type: 'StatusEvent', payload: Payload),
  decode(Payload, {sha: HeadSha: text}),
  open_pr_head(RepoRef, Number, HeadSha).

dirty_pr(RepoRef, Number) <-
  repo_event_seen(repo_ref: RepoRef, event_type: 'CheckRunEvent', payload: Payload),
  decode(Payload, {check_run: {head_sha: HeadSha: text}}),
  open_pr_head(RepoRef, Number, HeadSha).

dirty_pr(RepoRef, Number) <-
  repo_event_seen(repo_ref: RepoRef, event_type: 'CheckSuiteEvent', payload: Payload),
  decode(Payload, {check_suite: {head_sha: HeadSha: text}}),
  open_pr_head(RepoRef, Number, HeadSha).

rel open_pr_head(repo_ref: repo, number: int, head_ref: text, head_sha: text).
open_pr_head(RepoRef, Number, HeadRef, HeadSha) <-
  pull_request(repo_ref: RepoRef, number: Number, state: 'open', head_ref: HeadRef, head_sha: HeadSha).

dirty_repo(RepoRef) <- repo_event_seen(RepoRef).
dirty_repo(RepoRef) <- branch_seen(RepoRef).

# ── branches ────────────────────────────────────────────────────────────────

rel branch(repo_ref: repo, name: text, sha: text, updated_at: text) key(1, 2).
rel branch_seen(repo_ref: repo, name: text, sha: text, updated_at: text).
rel branch_pattern(repo_ref: repo, pattern: text).
rel branch_pattern_list(repo_ref: repo, patterns: list(text)).
rel candidate_branch(repo_ref: repo, branch_name: text, sha: text).
rel matched_branch(repo_ref: repo, branch_name: text, sha: text).

# split answers an interned list id, so the elements reach the row plane through
# a `list(text)` column and a spread (registry.pl:290-295).
branch_pattern_list(RepoRef, Patterns) <-
  watched_repo(RepoRef, SyncBranches),
  SyncBranches != "",
  Patterns := split(SyncBranches, ',').

branch_pattern(RepoRef, Pattern) <-
  branch_pattern_list(RepoRef, Patterns),
  decode(Patterns, [... Pattern]).

candidate_branch(RepoRef, BranchName, Sha) <-
  watched_endpoint(endpoint_path: EndpointPath, endpoint_kind: 'branches', repo_ref: RepoRef),
  rest_response(endpoint_path: EndpointPath, status: RespStatus, body: Body),
  RespStatus == 200,
  decode(Body, [... {name: BranchName: text, commit: {sha: Sha: text}}]).

# sync/branches.rs:90-95 matches_glob: a trailing `*` is a prefix test, anything
# else is exact.
matched_branch(RepoRef, BranchName, Sha) <-
  candidate_branch(RepoRef, BranchName, Sha),
  branch_pattern(RepoRef, Pattern),
  Pattern == BranchName.

matched_branch(RepoRef, BranchName, Sha) <-
  candidate_branch(RepoRef, BranchName, Sha),
  branch_pattern(RepoRef, Pattern),
  PatternLength := length(Pattern),
  Star := substr(Pattern, PatternLength, 1),
  Star == "*",
  PrefixLength := PatternLength - 1,
  Prefix := substr(Pattern, 1, PrefixLength),
  Head := substr(BranchName, 1, PrefixLength),
  Head == Prefix.

branch_seen(RepoRef, BranchName, Sha, UpdatedAt) <-
  matched_branch(RepoRef, BranchName, Sha),
  current_clock(60, Bucket),
  UpdatedAt := concat(["bucket:", Bucket]).

branch(RepoRef, BranchName, Sha, UpdatedAt) <+
  branch_seen(RepoRef, BranchName, Sha, UpdatedAt).

# ── pull requests, through the batched GraphQL call ─────────────────────────
#
# One aliased selection per repository in ONE query; the alias comes BACK
# through a `$` capture key, so the six fan-outs are six decode rules.

rel batch_size(rows_per_call: int) key(1).
rel repo_ordinal(repo_ref: repo, ordinal: int) key(1).
rel pr_batch_member(bucket: int, batch_index: int, batch_key: text,
                    repo_alias: text, owner: text, name: text).
rel pr_batch_alias(bucket: int, batch_key: text, repo_alias: text,
                   owner: text, name: text).
rel pr_selection(bucket: int, batch_key: text, repo_alias: text,
                 selection: text).
rel pr_batch(bucket: int, batch_key: text, selections: text).
rel pr_query(bucket: int, batch_key: text, query_text: text).
rel pr_post_field(bucket: int, batch_key: text, field_name: text,
                  field_value: text).
rel pr_post_body(bucket: int, batch_key: text, request_body: text).
rel pr_batch_arrival(batch_key: text, bucket: int, status: int,
                     response_headers: json, data: json, bytes: int).
rel pr_batch_response(batch_key: text, bucket: int, status: int,
                      rate_remaining: int, rate_reset: int, bytes: int,
                      data: json).
rel pr_due(repo_ref: repo, bucket: int).
rel pr_ever_synced(repo_ref: repo) key(1).

batch_size(20).

repo_ordinal(RepoRef, Ordinal) <+
  watched_repo(RepoRef),
  Ordinal := seq('repo').

# The dirty set IS the targeting: sync/mod.rs:242-248 asks for every repo on a
# full sweep and only event-touched repos afterwards.
pr_due(RepoRef, Bucket) <-
  current_clock(60, Bucket),
  dirty_repo(RepoRef).

pr_due(RepoRef, Bucket) <-
  current_clock(60, Bucket),
  watched_repo(RepoRef, SyncPrs),
  SyncPrs == 1,
  not(pr_ever_synced(RepoRef)).

pr_ever_synced(RepoRef) <+
  pull_request_seen(RepoRef).

pr_batch_member(Bucket, BatchIndex, BatchKey, RepoAlias, Owner, Name) <-
  pr_due(RepoRef, Bucket),
  watched_repo(RepoRef, Owner, Name, SyncPrs),
  SyncPrs == 1,
  not(over_budget('graphql', Bucket)),
  repo_ordinal(RepoRef, Ordinal),
  batch_size(RowsPerCall),
  BatchIndex := Ordinal / RowsPerCall,
  BatchKey := concat(["graphql:prs:batch/", BatchIndex]),
  RepoAlias := concat(["repo_", Ordinal]).

pr_batch_alias(Bucket, BatchKey, RepoAlias, Owner, Name) <-
  pr_batch_member(Bucket, BatchKey, RepoAlias, Owner, Name).

pr_selection(Bucket, BatchKey, RepoAlias, Selection) <-
  pr_batch_member(Bucket, BatchKey, RepoAlias, Owner, Name),
  Selection := concat([RepoAlias, ": repository(owner: \"", Owner,
    "\", name: \"", Name, "\") { pullRequests(first: 100, states: OPEN, ",
    "orderBy: {field: UPDATED_AT, direction: DESC}) { nodes { ",
    "number title state isDraft body headRefName headRefOid baseRefName ",
    "mergeable additions deletions changedFiles createdAt updatedAt ",
    "mergedAt closedAt databaseId id author { login } mergeCommit { oid } ",
    "reviews(last: 20) { nodes { databaseId author { login } state body ",
    "submittedAt } } comments(last: 50) { nodes { databaseId author { login } ",
    "body createdAt updatedAt } } reviewRequests(first: 20) { nodes { ",
    "requestedReviewer { ... on User { login } ... on Team { login: slug } ",
    "} } } labels(first: 10) { nodes { name color } } commits(last: 1) { ",
    "nodes { commit { statusCheckRollup { contexts(first: 50) { nodes { ",
    "__typename ... on StatusContext { context state targetUrl description } ",
    "... on CheckRun { name conclusion detailsUrl } } } } } } } } } } "]).

# An OPEN-only selection drops a PR once it stops being open; this rides the
# same batched query, alias `<RepoAlias>_recent` (issues/engine-tick-trace).
pr_selection(Bucket, BatchKey, RecentAlias, Selection) <-
  pr_batch_member(Bucket, BatchKey, RepoAlias, Owner, Name),
  RecentAlias := concat([RepoAlias, "_recent"]),
  Selection := concat([RecentAlias, ": repository(owner: \"", Owner,
    "\", name: \"", Name, "\") { pullRequests(first: 10, states: [MERGED, CLOSED], ",
    "orderBy: {field: UPDATED_AT, direction: DESC}) { nodes { ",
    "number title state isDraft body headRefName headRefOid baseRefName ",
    "mergeable additions deletions changedFiles createdAt updatedAt ",
    "mergedAt closedAt databaseId id author { login } mergeCommit { oid } ",
    "reviews(last: 20) { nodes { databaseId author { login } state body ",
    "submittedAt } } comments(last: 50) { nodes { databaseId author { login } ",
    "body createdAt updatedAt } } reviewRequests(first: 20) { nodes { ",
    "requestedReviewer { ... on User { login } ... on Team { login: slug } ",
    "} } } labels(first: 10) { nodes { name color } } commits(last: 1) { ",
    "nodes { commit { statusCheckRollup { contexts(first: 50) { nodes { ",
    "__typename ... on StatusContext { context state targetUrl description } ",
    "... on CheckRun { name conclusion detailsUrl } } } } } } } } } } "]).

pr_batch_alias(Bucket, BatchKey, RecentAlias, Owner, Name) <-
  pr_batch_member(Bucket, BatchKey, RepoAlias, Owner, Name),
  RecentAlias := concat([RepoAlias, "_recent"]).

# The aliased-query text is built by a SQL aggregate, never string code.
pr_batch(Bucket, BatchKey, group_concat(Selection, "")) <-
  pr_selection(Bucket, BatchKey, Selection).

pr_query(Bucket, BatchKey, QueryText) <-
  pr_batch(Bucket, BatchKey, Selections),
  QueryText := concat(["{ rateLimit { cost remaining resetAt } ", Selections,
                       "}"]).

pr_post_field(Bucket, BatchKey, "query", QueryText) <-
  pr_query(Bucket, BatchKey, QueryText).

# json_object is the escaper: the query text carries quotes and braces, and the
# envelope has to stay a valid JSON document.
pr_post_body(Bucket, BatchKey, json_object(FieldName, FieldValue)) <-
  pr_post_field(Bucket, BatchKey, FieldName, FieldValue).

rel graphql_header(url: text, header_name: text, header_value: text).
rel graphql_headers(url: text, headers: text).

graphql_header("graphql", "Accept", "application/vnd.github+json").
graphql_header("graphql", "Content-Type", "application/json").
graphql_header("graphql", "Authorization", AuthValue) <-
  api_token(TokenValue),
  AuthValue := concat(["Bearer ", TokenValue]).

graphql_headers(Url, json_object(HeaderName, HeaderValue)) <-
  graphql_header(Url, HeaderName, HeaderValue).

pr_batch_arrival(BatchKey, Bucket, Status, RespHeaders, Data, Bytes) <-
  pr_post_body(Bucket, BatchKey, RequestBody),
  graphql_headers(Url, Headers),
  post(Url, Headers, RequestBody, Bucket, Status, RespHeaders, Data,
            Bytes).

rel gql_rate_remaining(batch_key: text, bucket: int, rate_remaining: int).
rel gql_rate_reset(batch_key: text, bucket: int, rate_reset: int).

gql_rate_remaining(BatchKey, Bucket, RateRemaining) <-
  pr_batch_arrival(batch_key: BatchKey, bucket: Bucket, response_headers: RespHeaders),
  decode(RespHeaders, {"x-ratelimit-remaining": RateRemaining: int}).

gql_rate_reset(BatchKey, Bucket, RateReset) <-
  pr_batch_arrival(batch_key: BatchKey, bucket: Bucket, response_headers: RespHeaders),
  decode(RespHeaders, {"x-ratelimit-reset": RateReset: int}).

pr_batch_response(BatchKey, Bucket, Status, RateRemaining, RateReset, Bytes,
                  Data) <-
  pr_batch_arrival(BatchKey, Bucket, Status, Data, Bytes),
  coalesce(gql_rate_remaining(BatchKey, Bucket, RateRemaining), -1),
  coalesce(gql_rate_reset(BatchKey, Bucket, RateReset), 0).

rel pull_request(repo_ref: repo, number: int, gh_node_id: text, state: text,
                 title: text, author: text, head_ref: text, head_sha: text,
                 base_ref: text, mergeable: text, draft: int, additions: int,
                 deletions: int, changed_files: int, created_at: text,
                 updated_at: text, merged_at: text, closed_at: text,
                 body: text) key(1, 2).
rel pull_request_seen(repo_ref: repo, number: int, gh_node_id: text,
                      state: text, title: text, author: text, head_ref: text,
                      head_sha: text, base_ref: text, mergeable: text,
                      draft: int, additions: int, deletions: int,
                      changed_files: int, created_at: text, updated_at: text,
                      merged_at: text, closed_at: text, body: text).
rel gql_pull(batch_key: text, bucket: int, repo_alias: text, number: int,
             gh_node_id: text, gql_state: text, title: text, author: text,
             head_ref: text, head_sha: text, base_ref: text, mergeable: text,
             draft: int, additions: int, deletions: int, changed_files: int,
             created_at: text, updated_at: text, body: text).
# A json null in a captured field answers zero rows (measured: live PR batch,
# `mergedAt: MergedAt: text` on an open PR), so every nullable field is its
# own rel and absence is the absent row. `isDraft` is a json bool, captured
# untyped: no capture type spells bool (json_capture_type_unknown).
rel gql_pull_merged_at(batch_key: text, bucket: int, repo_alias: text,
                       number: int, merged_at: text).
rel gql_pull_closed_at(batch_key: text, bucket: int, repo_alias: text,
                       number: int, closed_at: text).

gql_pull(BatchKey, Bucket, RepoAlias, Number, GhNodeId, GqlState, Title, Author,
         HeadRef, HeadSha, BaseRef, Mergeable, Draft, Additions, Deletions,
         ChangedFiles, CreatedAt, UpdatedAt, PrBody) <-
  pr_batch_response(batch_key: BatchKey, bucket: Bucket, status: RespStatus, data: Data),
  RespStatus == 200,
  decode(Data, {data: {$RepoAlias: {pullRequests: {nodes: [...
    {number: Number: int, id: GhNodeId: text, state: GqlState: text,
     title: Title: text, author: {login: Author: text},
     headRefName: HeadRef: text, headRefOid: HeadSha: text,
     baseRefName: BaseRef: text, mergeable: Mergeable: text,
     isDraft: Draft, additions: Additions: int,
     deletions: Deletions: int, changedFiles: ChangedFiles: int,
     createdAt: CreatedAt: text, updatedAt: UpdatedAt: text,
     body: PrBody: text}]}}}}).

gql_pull_merged_at(BatchKey, Bucket, RepoAlias, Number, MergedAt) <-
  pr_batch_response(batch_key: BatchKey, bucket: Bucket, status: RespStatus, data: Data),
  RespStatus == 200,
  decode(Data, {data: {$RepoAlias: {pullRequests: {nodes: [...
    {number: Number: int, mergedAt: MergedAt: text}]}}}}).

gql_pull_closed_at(BatchKey, Bucket, RepoAlias, Number, ClosedAt) <-
  pr_batch_response(batch_key: BatchKey, bucket: Bucket, status: RespStatus, data: Data),
  RespStatus == 200,
  decode(Data, {data: {$RepoAlias: {pullRequests: {nodes: [...
    {number: Number: int, closedAt: ClosedAt: text}]}}}}).

# GraphQL answers OPEN/CLOSED/MERGED; the reader views and `open_pr_head` are
# written against the REST vocabulary, so the state is lowered here.
pull_request_seen(repo(Owner, Name), Number, GhNodeId, State, Title, Author,
                  HeadRef, HeadSha, BaseRef, Mergeable, Draft, Additions,
                  Deletions, ChangedFiles, CreatedAt, UpdatedAt, MergedAt,
                  ClosedAt, PrBody) <-
  gql_pull(BatchKey, Bucket, RepoAlias, Number, GhNodeId, GqlState, Title,
           Author, HeadRef, HeadSha, BaseRef, Mergeable, Draft, Additions,
           Deletions, ChangedFiles, CreatedAt, UpdatedAt, PrBody),
  pr_batch_alias(Bucket, BatchKey, RepoAlias, Owner, Name),
  coalesce(gql_pull_merged_at(BatchKey, Bucket, RepoAlias, Number, MergedAt), ""),
  coalesce(gql_pull_closed_at(BatchKey, Bucket, RepoAlias, Number, ClosedAt), ""),
  State := lower(GqlState).

pull_request(RepoRef, Number, GhNodeId, State, Title, Author, HeadRef, HeadSha,
             BaseRef, Mergeable, Draft, Additions, Deletions, ChangedFiles,
             CreatedAt, UpdatedAt, MergedAt, ClosedAt, PrBody) <+
  pull_request_seen(RepoRef, Number, GhNodeId, State, Title, Author, HeadRef,
                    HeadSha, BaseRef, Mergeable, Draft, Additions, Deletions,
                    ChangedFiles, CreatedAt, UpdatedAt, MergedAt, ClosedAt,
                    PrBody).

rel pr_merge_commit(repo_ref: repo, number: int, merge_commit_sha: text)
                    key(1, 2).
rel gql_merge_commit(batch_key: text, bucket: int, repo_alias: text,
                     number: int, merge_commit_sha: text).
rel pr_merge_commit_seen(repo_ref: repo, number: int, merge_commit_sha: text).

gql_merge_commit(BatchKey, Bucket, RepoAlias, Number, MergeCommitSha) <-
  pr_batch_response(batch_key: BatchKey, bucket: Bucket, status: RespStatus, data: Data),
  RespStatus == 200,
  decode(Data, {data: {$RepoAlias: {pullRequests: {nodes: [...
    {number: Number: int, mergeCommit: {oid: MergeCommitSha: text}}]}}}}).

pr_merge_commit_seen(repo(Owner, Name), Number, MergeCommitSha) <-
  gql_merge_commit(BatchKey, Bucket, RepoAlias, Number, MergeCommitSha),
  pr_batch_alias(Bucket, BatchKey, RepoAlias, Owner, Name).

pr_merge_commit(RepoRef, Number, MergeCommitSha) <+
  pr_merge_commit_seen(RepoRef, Number, MergeCommitSha).

rel pr_review(repo_ref: repo, number: int, gh_id: int, author: text,
              state: text, body: text, submitted_at: text) key(1, 2, 3).
rel pr_review_seen(repo_ref: repo, number: int, gh_id: int, author: text,
                   state: text, body: text, submitted_at: text).
rel gql_review(batch_key: text, bucket: int, repo_alias: text, number: int,
               gh_id: int, author: text, state: text, body: text,
               submitted_at: text).

gql_review(BatchKey, Bucket, RepoAlias, Number, GhId, Author, State,
           ReviewBody, SubmittedAt) <-
  pr_batch_response(batch_key: BatchKey, bucket: Bucket, status: RespStatus, data: Data),
  RespStatus == 200,
  decode(Data, {data: {$RepoAlias: {pullRequests: {nodes: [...
    {number: Number: int,
     reviews: {nodes: [... {databaseId: GhId: int,
                            author: {login: Author: text},
                            state: State: text, body: ReviewBody: text,
                            submittedAt: SubmittedAt: text}]}}]}}}}).

pr_review_seen(repo(Owner, Name), Number, GhId, Author, State, ReviewBody,
               SubmittedAt) <-
  gql_review(BatchKey, Bucket, RepoAlias, Number, GhId, Author, State,
             ReviewBody, SubmittedAt),
  pr_batch_alias(Bucket, BatchKey, RepoAlias, Owner, Name).

pr_review(RepoRef, Number, GhId, Author, State, ReviewBody, SubmittedAt) <+
  pr_review_seen(RepoRef, Number, GhId, Author, State, ReviewBody,
                 SubmittedAt).

rel pr_comment(repo_ref: repo, number: int, gh_id: int, author: text,
               body: text, path: text, line: int, in_reply_to_id: int,
               created_at: text, updated_at: text) key(1, 2, 3).
rel pr_comment_seen(repo_ref: repo, number: int, gh_id: int, author: text,
                    body: text, path: text, line: int, in_reply_to_id: int,
                    created_at: text, updated_at: text).
rel gql_comment(batch_key: text, bucket: int, repo_alias: text, number: int,
                gh_id: int, author: text, body: text, created_at: text,
                updated_at: text).

gql_comment(BatchKey, Bucket, RepoAlias, Number, GhId, Author, CommentBody,
            CreatedAt, UpdatedAt) <-
  pr_batch_response(batch_key: BatchKey, bucket: Bucket, status: RespStatus, data: Data),
  RespStatus == 200,
  decode(Data, {data: {$RepoAlias: {pullRequests: {nodes: [...
    {number: Number: int,
     comments: {nodes: [... {databaseId: GhId: int,
                             author: {login: Author: text},
                             body: CommentBody: text,
                             createdAt: CreatedAt: text,
                             updatedAt: UpdatedAt: text}]}}]}}}}).

# An issue comment carries no file position; `path`/`line`/`in_reply_to_id` are
# the REST review-comment columns and stay empty on this plane.
pr_comment_seen(repo(Owner, Name), Number, GhId, Author, CommentBody, "", 0, 0,
                CreatedAt, UpdatedAt) <-
  gql_comment(BatchKey, Bucket, RepoAlias, Number, GhId, Author, CommentBody,
              CreatedAt, UpdatedAt),
  pr_batch_alias(Bucket, BatchKey, RepoAlias, Owner, Name).

pr_comment(RepoRef, Number, GhId, Author, CommentBody, Path, Line,
           InReplyToId, CreatedAt, UpdatedAt) <+
  pr_comment_seen(RepoRef, Number, GhId, Author, CommentBody, Path, Line,
                  InReplyToId, CreatedAt, UpdatedAt).

rel pr_status_check(repo_ref: repo, number: int, context: text, state: text,
                    target_url: text, description: text, updated_at: text)
                    key(1, 2, 3).
rel pr_status_check_seen(repo_ref: repo, number: int, context: text,
                         state: text, target_url: text, description: text,
                         updated_at: text).
rel gql_status_context(batch_key: text, bucket: int, repo_alias: text,
                       number: int, context: text, state: text,
                       target_url: text, description: text).
rel gql_check_run(batch_key: text, bucket: int, repo_alias: text, number: int,
                  context: text, state: text, target_url: text).

# The rollup is a UNION of two GraphQL types, so it is two decode rules: a
# `... on` inline fragment cannot be aliased into one shape without a type clash.
gql_status_context(BatchKey, Bucket, RepoAlias, Number, Context, State,
                   TargetUrl, Description) <-
  pr_batch_response(batch_key: BatchKey, bucket: Bucket, status: RespStatus, data: Data),
  RespStatus == 200,
  decode(Data, {data: {$RepoAlias: {pullRequests: {nodes: [...
    {number: Number: int,
     commits: {nodes: [... {commit: {statusCheckRollup:
       {contexts: {nodes: [... {context: Context: text, state: State: text,
                                targetUrl: TargetUrl: text,
                                description: Description: text}]}}}}]}}]}}}}).

gql_check_run(BatchKey, Bucket, RepoAlias, Number, Context, State,
              TargetUrl) <-
  pr_batch_response(batch_key: BatchKey, bucket: Bucket, status: RespStatus, data: Data),
  RespStatus == 200,
  decode(Data, {data: {$RepoAlias: {pullRequests: {nodes: [...
    {number: Number: int,
     commits: {nodes: [... {commit: {statusCheckRollup:
       {contexts: {nodes: [... {name: Context: text,
                                conclusion: State: text,
                                detailsUrl: TargetUrl: text}]}}}}]}}]}}}}).

pr_status_check_seen(repo(Owner, Name), Number, Context, State, TargetUrl,
                     Description, "") <-
  gql_status_context(BatchKey, Bucket, RepoAlias, Number, Context, State,
                     TargetUrl, Description),
  pr_batch_alias(Bucket, BatchKey, RepoAlias, Owner, Name).

pr_status_check_seen(repo(Owner, Name), Number, Context, State, TargetUrl, "",
                     "") <-
  gql_check_run(BatchKey, Bucket, RepoAlias, Number, Context, State,
                TargetUrl),
  pr_batch_alias(Bucket, BatchKey, RepoAlias, Owner, Name).

pr_status_check(RepoRef, Number, Context, State, TargetUrl, Description,
                UpdatedAt) <+
  pr_status_check_seen(RepoRef, Number, Context, State, TargetUrl, Description,
                       UpdatedAt).

rel pr_label(repo_ref: repo, number: int, label: text, color: text)
             key(1, 2, 3).
rel pr_label_seen(repo_ref: repo, number: int, label: text, color: text).
rel gql_label(batch_key: text, bucket: int, repo_alias: text, number: int,
              label: text, color: text).

gql_label(BatchKey, Bucket, RepoAlias, Number, Label, Color) <-
  pr_batch_response(batch_key: BatchKey, bucket: Bucket, status: RespStatus, data: Data),
  RespStatus == 200,
  decode(Data, {data: {$RepoAlias: {pullRequests: {nodes: [...
    {number: Number: int,
     labels: {nodes: [... {name: Label: text, color: Color: text}]}}]}}}}).

pr_label_seen(repo(Owner, Name), Number, Label, Color) <-
  gql_label(BatchKey, Bucket, RepoAlias, Number, Label, Color),
  pr_batch_alias(Bucket, BatchKey, RepoAlias, Owner, Name).

pr_label(RepoRef, Number, Label, Color) <+
  pr_label_seen(RepoRef, Number, Label, Color).

rel pr_requested_reviewer(repo_ref: repo, number: int, reviewer: text)
                          key(1, 2, 3).
rel pr_requested_reviewer_seen(repo_ref: repo, number: int, reviewer: text).
rel gql_requested_reviewer(batch_key: text, bucket: int, repo_alias: text,
                           number: int, reviewer: text).

gql_requested_reviewer(BatchKey, Bucket, RepoAlias, Number, Reviewer) <-
  pr_batch_response(batch_key: BatchKey, bucket: Bucket, status: RespStatus, data: Data),
  RespStatus == 200,
  decode(Data, {data: {$RepoAlias: {pullRequests: {nodes: [...
    {number: Number: int,
     reviewRequests: {nodes: [... {requestedReviewer:
       {login: Reviewer: text}}]}}]}}}}).

pr_requested_reviewer_seen(repo(Owner, Name), Number, Reviewer) <-
  gql_requested_reviewer(BatchKey, Bucket, RepoAlias, Number, Reviewer),
  pr_batch_alias(Bucket, BatchKey, RepoAlias, Owner, Name).

pr_requested_reviewer(RepoRef, Number, Reviewer) <+
  pr_requested_reviewer_seen(RepoRef, Number, Reviewer).

# ── the pull-request state track, folded in from prwatch.dl6 ────────────────

rel lane_prefix(prefix: text).
lane_prefix("feature/").
lane_prefix("fix/").
lane_prefix("plan/").

# `pre/1` is the grade -1 read: without it `pull_request` reaches this rule at
# two clock offsets from one origin (3_clock_check.pl:336, clock_path_conflict).
rel pr_transition(repo_ref: repo, number: int, from_state: text,
                  to_state: text, at_tick: int) log keep(all).
pr_transition(RepoRef, Number, FromState, ToState, AtTick) <+
  pull_request_seen(repo_ref: RepoRef, number: Number, state: ToState),
  pre(pull_request(RepoRef, Number, _G2, FromState, _T2, _A2, _HR2, _HS2, _BR2,
                   _M2, _D2, _Ad2, _De2, _CF2, _C2, _U2, _Me2, _Cl2, _B2)),
  FromState != ToState,
  now(AtTick).

# `instr(HeadRef, Prefix) == 1` is starts-with: the language has no prefix
# operator and instr answers the 1-based position of the first occurrence.
rel lane_proof(repo_slug: text, branch: text, pr: int, merge_commit_sha: text).
lane_proof(RepoSlug, HeadRef, Number, MergeCommitSha) <-
  pull_request(repo_ref: repo(Owner, Name), number: Number, state: 'merged', head_ref: HeadRef),
  pr_merge_commit(repo(Owner, Name), Number, MergeCommitSha),
  lane_prefix(Prefix),
  PrefixAt := instr(HeadRef, Prefix),
  PrefixAt == 1,
  RepoSlug := concat([Owner, "/", Name]).

# ── notifications ───────────────────────────────────────────────────────────

rel notification(gh_id: text, repo_ref: repo, subject_type: text,
                 subject_title: text, subject_url: text, subject_number: int,
                 html_url: text, reason: text, unread: int, updated_at: text,
                 last_read_at: text) key(1).
rel notification_seen(gh_id: text, repo_ref: repo, subject_type: text,
                      subject_title: text, subject_url: text,
                      subject_number: int, html_url: text, reason: text,
                      unread: int, updated_at: text, last_read_at: text).

# `html_url` and `subject_number` are notifications.rs:77-99 parse_subject_url,
# answered by the executor beside the thread it belongs to.
notification_seen(GhId, repo(Owner, Name), SubjectType, SubjectTitle,
                  SubjectUrl, SubjectNumber, HtmlUrl, Reason, Unread,
                  UpdatedAt, LastReadAt) <-
  watched_global(endpoint_path: EndpointPath, endpoint_kind: 'notifications'),
  rest_response(endpoint_path: EndpointPath, status: RespStatus, body: Body),
  RespStatus == 200,
  decode(Body, [... {id: GhId: text,
                     repository: {owner: {login: Owner: text},
                                  name: Name: text},
                     subject: {type: SubjectType: text,
                               title: SubjectTitle: text,
                               url: SubjectUrl: text,
                               html_url: HtmlUrl: text,
                               number: SubjectNumber: int},
                     reason: Reason: text,
                     unread: Unread: int,
                     updated_at: UpdatedAt: text,
                     last_read_at: LastReadAt: text}]).

notification(GhId, RepoRef, SubjectType, SubjectTitle, SubjectUrl,
             SubjectNumber, HtmlUrl, Reason, Unread, UpdatedAt, LastReadAt) <+
  notification_seen(GhId, RepoRef, SubjectType, SubjectTitle, SubjectUrl,
                    SubjectNumber, HtmlUrl, Reason, Unread, UpdatedAt,
                    LastReadAt).

# ── checkout and PR head mirroring ──────────────────────────────────────────

rel checkout_task(repo_slug: text, dest_root: text, want_sha: text,
                  fetch_pr_branches: int).
rel repo_checkout(repo_ref: repo, branch: text, local_path: text, sha: text,
             checked_out_bucket: int) key(1, 2).
rel checkout_answer(repo_slug: text, checkout_path: text, head_sha: text).
rel pr_head_mirror(repo_slug: text, checkout_path: text, pr_head_count: int).

# `want_sha` carries the FRESHNESS role (registry.pl:429-439), so a branch that
# has not moved re-asks on a witness the host already answered: zero git work.
checkout_task(RepoSlug, DestRoot, WantSha, CheckoutPrBranches) <-
  watched_repo(RepoRef, Owner, Name, DefaultBranch, CheckoutOnSync, CheckoutPrBranches, FsAlias),
  CheckoutOnSync == 1,
  branch(repo_ref: RepoRef, name: DefaultBranch, sha: WantSha),
  global_setting(StagingFolder),
  RepoSlug := concat([Owner, "/", Name]),
  DestRoot := concat([StagingFolder, "/", FsAlias]).

checkout_answer(RepoSlug, CheckoutPath, HeadSha) <-
  checkout_task(RepoSlug, DestRoot, WantSha),
  checkout(RepoSlug, DestRoot, WantSha, CheckoutPath, HeadSha).

pr_head_mirror(RepoSlug, CheckoutPath, PrHeadCount) <-
  checkout_task(RepoSlug, DestRoot, WantSha, 1),
  mirror_pr_heads(RepoSlug, DestRoot, WantSha, CheckoutPath,
                       PrHeadCount).

repo_checkout(RepoRef, DefaultBranch, CheckoutPath, HeadSha, Bucket) <+
  checkout_answer(RepoSlug, CheckoutPath, HeadSha),
  current_clock(Period, Bucket),
  Period == 60,
  watched_repo(RepoRef, Owner, Name, DefaultBranch),
  RepoSlug == concat([Owner, "/", Name]).

# ── change_log, the delta rel ───────────────────────────────────────────────

# 22.29 rows per minute bucket MEASURED over 1427 buckets; 34000 is 25.4 h.
rel change_log(at_tick: int, entity_type: text, entity_key: text,
               repo_slug: text) log keep(count(34000)).
rel change_candidate(entity_type: text, entity_key: text, repo_slug: text).

# change_candidate is a LEVEL rel, so the edge rule below fires on its POSITIVE
# DELTA only: a tick that re-derives an identical row logs nothing.
change_candidate('pull_request', EntityKey, RepoSlug) <-
  pull_request_seen(repo_ref: repo(Owner, Name), number: Number),
  RepoSlug := concat([Owner, "/", Name]),
  EntityKey := concat([RepoSlug, "#", Number]).

change_candidate('repo_event', GhId, RepoSlug) <-
  repo_event_seen(repo_ref: repo(Owner, Name), gh_id: GhId),
  RepoSlug := concat([Owner, "/", Name]).

change_candidate('branch', EntityKey, RepoSlug) <-
  branch_seen(repo_ref: repo(Owner, Name), name: BranchName),
  RepoSlug := concat([Owner, "/", Name]),
  EntityKey := concat([RepoSlug, "@", BranchName]).

change_candidate('notification', GhId, RepoSlug) <-
  notification_seen(gh_id: GhId, repo_ref: repo(Owner, Name)),
  RepoSlug := concat([Owner, "/", Name]).

change_candidate('checkout', RepoSlug, RepoSlug) <-
  checkout_answer(RepoSlug).

change_log(AtTick, EntityType, EntityKey, RepoSlug) <+
  change_candidate(EntityType, EntityKey, RepoSlug),
  now(AtTick).

# ── the reader views (schema.sql:195-245) ───────────────────────────────────

rel open_pr(repo_slug: text, number: int, title: text, author: text,
            head_ref: text, draft: int, mergeable: text, additions: int,
            deletions: int, created_at: text, updated_at: text).
rel pr_approvals(repo_ref: repo, number: int, approvals: int).
rel pr_changes_requested(repo_ref: repo, number: int, changes_requested: int).
rel pr_comment_count(repo_ref: repo, number: int, comment_count: int).
rel unread_notification(gh_id: text, subject_type: text, subject_title: text,
                        subject_number: int, html_url: text, reason: text,
                        updated_at: text, repo_slug: text).
rel recent_event(repo_slug: text, event_type: text, actor: text,
                 created_at: text, action: text).
rel rate_pool(api_type: text, remaining: int, reset_at: int, calls: int).

open_pr(RepoSlug, Number, Title, Author, HeadRef, Draft, Mergeable, Additions,
        Deletions, CreatedAt, UpdatedAt) <-
  pull_request(repo_ref: repo(Owner, Name), number: Number, state: 'open', title: Title, author: Author, head_ref: HeadRef, mergeable: Mergeable, draft: Draft, additions: Additions, deletions: Deletions, created_at: CreatedAt, updated_at: UpdatedAt),
  RepoSlug := concat([Owner, "/", Name]).

pr_approvals(RepoRef, Number, count(GhId)) <-
  pr_review(repo_ref: RepoRef, number: Number, gh_id: GhId, state: 'APPROVED').

pr_changes_requested(RepoRef, Number, count(GhId)) <-
  pr_review(repo_ref: RepoRef, number: Number, gh_id: GhId, state: 'CHANGES_REQUESTED').

pr_comment_count(RepoRef, Number, count(GhId)) <-
  pr_comment(RepoRef, Number, GhId).

unread_notification(GhId, SubjectType, SubjectTitle, SubjectNumber, HtmlUrl,
                    Reason, UpdatedAt, RepoSlug) <-
  notification(gh_id: GhId, repo_ref: repo(Owner, Name), subject_type: SubjectType, subject_title: SubjectTitle, subject_number: SubjectNumber, html_url: HtmlUrl, reason: Reason, unread: 1, updated_at: UpdatedAt),
  RepoSlug := concat([Owner, "/", Name]).

recent_event(RepoSlug, EventType, Actor, CreatedAt, Action) <-
  repo_event(repo_ref: repo(Owner, Name), event_type: EventType, actor: Actor, payload: Payload, created_at: CreatedAt),
  decode(Payload, {action: Action: text}),
  RepoSlug := concat([Owner, "/", Name]).

# Grouped columns must all come from one positive body atom's own delta rows
# (lower.pl:4635); call_log carries rate_remaining/rate_reset itself.
rate_pool(ApiType, RateRemaining, RateReset, count(AtTick)) <-
  call_log(AtTick, ApiType, RateRemaining, RateReset).

# ── the engine measuring itself ─────────────────────────────────────────────

rel tick_cost(bucket: int) ->
  (executor: text, wall_ms: int, sqlite_ms: int, calls: int, rows_out: int,
   bytes: int, rss_kb: int).

rel measured(bucket: int, executor: text, wall_ms: int, sqlite_ms: int,
             calls: int, rows_out: int, bytes: int, rss_kb: int).
measured(Bucket, Executor, WallMs, SqliteMs, Calls, RowsOut, Bytes, RssKb) <-
  current_clock(60, Bucket),
  tick_cost(Bucket, Executor, WallMs, SqliteMs, Calls, RowsOut, Bytes, RssKb).

# 93.23 rows per minute bucket MEASURED over 1422 buckets, 243 executors;
# 140000 is 25.0 h, and its prune DELETE measures 59 ms at that depth.
rel engine_tick_cost(bucket: int, executor: text, wall_ms: int, sqlite_ms: int,
       calls: int, rows_out: int, bytes: int, rss_kb: int) log keep(count(140000)).
engine_tick_cost(Bucket, Executor, WallMs, SqliteMs, Calls, RowsOut, Bytes, RssKb) <+
  measured(Bucket, Executor, WallMs, SqliteMs, Calls, RowsOut, Bytes, RssKb).

# ── queries ─────────────────────────────────────────────────────────────────

? open_pr(RepoSlug, Number, Title, Author, HeadRef, Draft, Mergeable,
          Additions, Deletions, CreatedAt, UpdatedAt)
  order by RepoSlug, Number.
? unread_notification(GhId, SubjectType, SubjectTitle, SubjectNumber, HtmlUrl,
                      Reason, UpdatedAt, RepoSlug)
  order by UpdatedAt desc.
? recent_event(RepoSlug, EventType, Actor, CreatedAt, Action)
  order by CreatedAt desc.
? call_log(AtTick, ApiType, EndpointPath, Status, RateRemaining, RateReset,
           Bytes, CacheHit)
  order by AtTick desc.
? change_log(AtTick, EntityType, EntityKey, RepoSlug) order by AtTick desc.
? rate_pool(ApiType, Remaining, ResetAt, Calls).
? due(EndpointPath, Bucket, ApiType).
? over_budget(ApiType, Bucket).
? poll_state(PageUrl, Etag, LastModified, PollInterval, LastPolledBucket,
             LastChangedBucket).
? branch(RepoRef, BranchName, Sha, UpdatedAt).
? repo_checkout(RepoRef, BranchName, LocalPath, Sha, CheckedOutBucket).
? lane_proof(repo_slug, branch, pr, merge_commit_sha).
? pr_transition(repo_ref, number, from_state, to_state, at_tick).
? engine_tick_cost(bucket, executor, wall_ms, sqlite_ms, calls, rows_out, bytes, rss_kb).
