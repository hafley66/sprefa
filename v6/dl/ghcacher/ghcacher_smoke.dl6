# http.get links the Rust HttpGetExecutor directly by name (registry.pl
# arrival_executor/2); no adapters override and no shell runs.

use http.

rel watch(url: text).
rel etag_event(url: text, tag: text) log keep(all).
rel current_etag(url: text, tag: text) key(1).
rel current_clock(period: int, bucket: int) key(1).

rel interval(period: int, bucket: int).

rel get(url: text, headers: text, prev_etag: text, bucket: int) ->
  (status: int, response_headers: json, body: json, bytes: int).

rel request_header(url: text, header_name: text, header_value: text).
rel request_headers(url: text, headers: text).
rel poll(url: text, headers: text, prev_etag: text, bucket: int).
rel resp(url: text, headers: text, prev_etag: text, bucket: int, status: int,
         response_headers: json, body: json, bytes: int).
rel fresh_hit(url: text, tag: text).
rel not_modified(url: text, bucket: int).

current_etag(Url, Tag) <+ etag_event(Url, Tag).
current_clock(Period, Bucket) <+ interval(Period, Bucket).

# The conditional GET is the PROGRAM's: If-None-Match is a header row, so the
# transport carries no ETag of its own.
request_header(Url, "Accept", "application/vnd.github+json") <- watch(Url).
request_header(Url, "If-None-Match", PrevEtag) <-
  watch(Url),
  current_etag(Url, PrevEtag),
  PrevEtag != "".

request_headers(Url, json_object(HeaderName, HeaderValue)) <-
  request_header(Url, HeaderName, HeaderValue).

poll(Url, Headers, PrevEtag, Bucket) <-
  watch(Url),
  request_headers(Url, Headers),
  current_etag(Url, PrevEtag),
  current_clock(300, Bucket).

resp(Url, Headers, PrevEtag, Bucket, Status, RespHeaders, Body, Bytes) <-
  poll(Url, Headers, PrevEtag, Bucket),
  get(Url, Headers, PrevEtag, Bucket, Status, RespHeaders, Body, Bytes).

fresh_hit(Url, Tag) <-
  resp(Url, _H, _P, _Bucket, Status, RespHeaders, _Body, _Bytes),
  Status == 200,
  decode(RespHeaders, {etag: Tag: text}).

not_modified(Url, Bucket) <-
  resp(Url, _H, _P, Bucket, Status, _RespHeaders, _Body, _Bytes),
  Status == 304.

? fresh_hit(Url, Tag).
? not_modified(Url, Bucket).
