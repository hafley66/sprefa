# Deterministic ghcacher clock golden over the current v6 text surface.
#
# The interval and host response rows are schedule-fed by the lab gate. This is
# the same hermetic seam used by the compiler sweep: a bind/world firing and a
# host completion are ordinary committed arrival batches. No shell, network, or
# wall clock participates in the grade.

rel watch(ep: text).
rel etag_event(ep: text, tag: text) log keep(all).
rel current_etag(ep: text, tag: text) key(1).
rel current_clock(period: int, bucket: int) key(1).

rel interval(period: int, bucket: int).

rel /http/fetch(ep: text, prev: text, bucket: int) ->
  (status: int, tag: text, stars: int, full_name: text) key(1, 2).

rel poll(ep: text, prev: text, bucket: int).
rel resp(ep: text, bucket: int, status: int, tag: text, stars: int, full_name: text).
rel fresh_hit(ep: text, tag: text, stars: int, full_name: text).
rel cache_view(ep: text, tag: text, stars: int, full_name: text) key(1).

current_etag(Ep, Tag) <+ etag_event(Ep, Tag).
current_clock(Period, Bucket) <+ interval(Period, Bucket).

poll(Ep, Prev, Bucket) <-
  watch(Ep),
  current_etag(Ep, Prev),
  current_clock(300, Bucket).

resp(Ep, Bucket, Status, Tag, Stars, FullName) <-
  poll(Ep, Prev, Bucket),
  /http/fetch(Ep, Prev, Bucket, Status, Tag, Stars, FullName).

fresh_hit(Ep, Tag, Stars, FullName) <-
  resp(Ep, _, Status, Tag, Stars, FullName),
  Status == 200.

cache_view(Ep, Tag, Stars, FullName) <+ fresh_hit(Ep, Tag, Stars, FullName).

? cache_view(Ep, Tag, Stars, FullName).
