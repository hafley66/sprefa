# serde-default-rail.dl6 -- a required serde field that a committed JSON
# snapshot does not carry.
#
# Measured (TASKS/extract-rails.REPORT.md): 15 rows at 0bf43e111, of which 8 are
# ProgramJson/incremental_safe, the defect PR #391 fixed, one row per snapshot
# that stopped loading. 7 rows on main, stable across both revisions, so the
# rail's DELTA against its own baseline is exactly the defect.
#
# The four extraction families carry no Rust ATTRIBUTE at all, so
# `#[serde(default)]` comes from the extractor's other door, `--ast-pattern`
# mode, whose capture records carry flat text and byte offsets. The committed
# JSON lives inside a Rust `const`, which the type family emits whole as `text`.
#
# rx lowering, per the standing law:
#
#   sourceRs$.pipe(map(mintIdentityAndWitness), distinct(row => row.witnessDigest),
#                  mergeMap(runPattern), mergeMap(commitEdbArrival))
#   fieldDecl$.pipe(withLatestFrom(structDef$), map(nearestAbove),
#                   groupBy(row => row.fieldStart),
#                   mergeMap(group => group.pipe(reduce(maxOf))))
#   requiredField$.pipe(withLatestFrom(snapshotJson$), filter(keyAbsent))
#
# HOST NAMES ARE BORROWED for ast-pattern queries; `families` below is a
# placeholder ("type"), since the executor has no ast-pattern family to pass.

use extract.
use soopy.

rel span(start: int, end: int).

rel files(glob: text) -> (path: text, digest: text).

# struct entity nodes; the span is the IDENT, never the item, so every join
# below is nearest-declaration-above rather than containment.
rel type_node_at(path: text, digest: text, families: text) -> (record: text, family: text, span: span, kind: text, name: text) key(1, 3).

# the const rows: one per `const NAME: &str = r#"..."#`, carrying the whole
# literal as `text`.
rel sig_at(path: text, digest: text, families: text) -> (record: text, family: text, owner: span, kind: text, text: text) key(1, 3).

# field names. A field_declaration with a visibility modifier and one without
# are two ast-grep patterns; the pattern language has no optional-child form.
rel call_node(path: text, digest: text, families: text) -> (record: text, query: text, capture: text, text: text, start: int, end: int) key(1, 3).
rel call_ref(path: text, digest: text, families: text) -> (record: text, query: text, capture: text, text: text, start: int, end: int) key(1, 3).

# attribute text. The `type`/`call`/`df` families carry no attribute at all, so
# the pattern door is the only one that sees `#[serde(default)]`.
rel df_node_at(path: text, digest: text, families: text) -> (record: text, query: text, capture: text, text: text, start: int, end: int) key(1, 3).

rel want_source(glob: text).
rel want_snapshot(glob: text).

rel source_rs(path: text, digest: text).
source_rs(Path, Digest) <- want_source(Glob), files(Glob, Path, Digest).

rel snapshot_file(path: text, digest: text).
snapshot_file(Path, Digest) <- want_snapshot(Glob), files(Glob, Path, Digest).

rel struct_def(path: text, struct_start: int, struct_name: text).
struct_def(Path, StructStart, StructName) <-
  source_rs(Path, Digest),
  type_node_at(Path, Digest, "type", 'node', 'type', StructAt, 'struct', StructName),
  decode(StructAt, {start: StructStart, end: _StructEnd}).

rel attr_text(path: text, attr_start: int, attr_end: int, attr_body: text).
attr_text(Path, AttrStart, AttrEnd, AttrBody) <-
  source_rs(Path, Digest),
  df_node_at(Path, Digest, "type", 'capture', 'attr', 'ARG', AttrBody, AttrStart, AttrEnd).

rel field_decl(path: text, field_start: int, field_name: text).
field_decl(Path, FieldStart, FieldName) <-
  source_rs(Path, Digest),
  call_node(Path, Digest, "type", 'capture', 'fld', 'NAME', FieldName, FieldStart, _FieldEnd).
field_decl(Path, FieldStart, FieldName) <-
  source_rs(Path, Digest),
  call_ref(Path, Digest, "type", 'capture', 'fld', 'NAME', FieldName, FieldStart, _FieldEnd).

# ── nearest declaration above ───────────────────────────────────────────────
rel field_struct_candidate(path: text, field_start: int, struct_start: int).
field_struct_candidate(Path, FieldStart, StructStart) <-
  field_decl(Path, FieldStart, _),
  struct_def(Path, StructStart, _),
  StructStart < FieldStart.

rel field_struct(path: text, field_start: int, struct_start: int).
field_struct(Path, FieldStart, max(StructStart)) <-
  field_struct_candidate(Path, FieldStart, StructStart).

rel struct_prev_candidate(path: text, struct_start: int, prev_start: int).
struct_prev_candidate(Path, StructStart, PrevStart) <-
  struct_def(Path, StructStart, _),
  struct_def(Path, PrevStart, _),
  PrevStart < StructStart.

rel struct_prev(path: text, struct_start: int, prev_start: int).
struct_prev(Path, StructStart, max(PrevStart)) <-
  struct_prev_candidate(Path, StructStart, PrevStart).

rel struct_window(path: text, struct_start: int, window_start: int).
struct_window(Path, StructStart, PrevStart) <- struct_prev(Path, StructStart, PrevStart).
struct_window(Path, StructStart, 0) <-
  struct_def(Path, StructStart, _), not(struct_prev(Path, StructStart, _)).

rel deserialize_struct(path: text, struct_start: int, struct_name: text).
deserialize_struct(Path, StructStart, StructName) <-
  struct_def(Path, StructStart, StructName),
  struct_window(Path, StructStart, WindowStart),
  attr_text(Path, AttrStart, AttrEnd, AttrBody),
  AttrStart > WindowStart,
  AttrEnd < StructStart,
  DeriveHit := instr(AttrBody, 'Deserialize'),
  DeriveHit > 0.

rel field_prev_candidate(path: text, field_start: int, prev_start: int).
field_prev_candidate(Path, FieldStart, PrevStart) <-
  field_decl(Path, FieldStart, _),
  field_decl(Path, PrevStart, _),
  PrevStart < FieldStart.

rel field_prev(path: text, field_start: int, prev_start: int).
field_prev(Path, FieldStart, max(PrevStart)) <- field_prev_candidate(Path, FieldStart, PrevStart).

rel field_window(path: text, field_start: int, window_start: int).
field_window(Path, FieldStart, PrevStart) <-
  field_prev(Path, FieldStart, PrevStart),
  field_struct(Path, FieldStart, StructStart),
  PrevStart > StructStart.
field_window(Path, FieldStart, StructStart) <-
  field_struct(Path, FieldStart, StructStart),
  field_prev(Path, FieldStart, PrevStart),
  PrevStart =< StructStart.
field_window(Path, FieldStart, StructStart) <-
  field_struct(Path, FieldStart, StructStart),
  not(field_prev(Path, FieldStart, _)).

rel field_defaulted(path: text, field_start: int).
field_defaulted(Path, FieldStart) <-
  field_window(Path, FieldStart, WindowStart),
  attr_text(Path, AttrStart, AttrEnd, AttrBody),
  AttrStart > WindowStart,
  AttrEnd < FieldStart,
  DefaultHit := instr(AttrBody, 'default'),
  DefaultHit > 0.

rel required_field(path: text, struct_name: text, field_name: text).
required_field(Path, StructName, FieldName) <-
  field_decl(Path, FieldStart, FieldName),
  field_struct(Path, FieldStart, StructStart),
  deserialize_struct(Path, StructStart, StructName),
  not(field_defaulted(Path, FieldStart)).

rel snapshot_json(snapshot: text, json_text: text).
snapshot_json(Path, JsonText) <-
  snapshot_file(Path, Digest),
  sig_at(Path, Digest, "type", 'const', 'type', _Owner, 'lit', JsonText).

rel field_present(path: text, struct_name: text, field_name: text, snapshot: text).
field_present(Path, StructName, FieldName, Snapshot) <-
  required_field(Path, StructName, FieldName),
  snapshot_json(Snapshot, JsonText),
  Needle := concat(['"', FieldName, '"']),
  KeyHit := instr(JsonText, Needle),
  KeyHit > 0.

rel field_absent(path: text, struct_name: text, field_name: text, snapshot: text).
field_absent(Path, StructName, FieldName, Snapshot) <-
  required_field(Path, StructName, FieldName),
  snapshot_json(Snapshot, JsonText),
  Needle := concat(['"', FieldName, '"']),
  KeyHit := instr(JsonText, Needle),
  KeyHit == 0.

rel struct_required_count(path: text, struct_name: text, required: int).
struct_required_count(Path, StructName, count(FieldName)) <-
  required_field(Path, StructName, FieldName).

# A snapshot is a document of the struct when it carries every required field
# BUT ONE. Two or more missing is a different document that happens to share
# some key names, which is what a nested struct's fields look like from a
# whole-text search.
rel snapshot_present_count(path: text, struct_name: text, snapshot: text, present: int).
snapshot_present_count(Path, StructName, Snapshot, count(FieldName)) <-
  field_present(Path, StructName, FieldName, Snapshot).

rel rail_e_missing_serde_default(struct_name: text, field_name: text, snapshot: text).
rail_e_missing_serde_default(StructName, FieldName, Snapshot) <-
  field_absent(Path, StructName, FieldName, Snapshot),
  snapshot_present_count(Path, StructName, Snapshot, Present),
  struct_required_count(Path, StructName, Required),
  Required >= 3,
  AllButOne := Required - 1,
  Present == AllButOne.

? rail_e_missing_serde_default(struct_name, field_name, snapshot).
