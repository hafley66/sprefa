# openapi-data-family.dl6 -- AN OPENAPI SPEC READ AS ROWS, NO CONVERSION STEP.
#
# `sprefa-extract --family data` reads json / jsonl / yaml / toml through one
# grammar each and answers two record shapes off ONE parse: a `data_doc` per
# document carrying it as a json VALUE, and a span-carrying `data_value` per
# value inside it. `decode/2` is the query over the document column, so a yaml
# spec reaches rules with no yaml-to-json pass anywhere.
#
# ── WHY THE HOST IS NAMED `records` ─────────────────────────────────
# `families` is a plain INPUT column now (registry.pl arrival_executor), not a
# hardcoded-name lookup, so the identity is spelled the same way any extract.*
# rel spells it: path/families identity, digest freshness.
#
# ── WHY ONLY THE DOCUMENT ROWS ARRIVE ───────────────────────────────────────
# The declared response carries `doc`, and a row missing a declared column is
# dropped, so the `data_value` rows stay out of this program by construction.
# A program that wants the spans declares `path`/`kind`/`span` instead.
#
# ── BOTH DOORS, SAME ROWS ───────────────────────────────────────────────────
# Measured on pokeapi.openapi.yml: spec_doc 1, spec_operation 100, spec_path
# 100. The TS door's emitted template spawns $DL_EXTRACT_BIN, so it reads the
# family the CLI has. The Rust door reads it in-process through the mask parser
# at sprefa-engine-rs src/hosts.rs, pinned by tests/data_family.rs. An unlisted
# family still stops by name there (a silent zero-row rc=0 is the F2 defect
# scip_combo pins).
#
# ── THE RX LOWERING ─────────────────────────────────────────────────────────
#   specFile$.pipe(map(mintIdentityAndWitness),
#                  distinct(demand => demand.witnessDigest),
#                  mergeMap(runExtract), mergeMap(commitEdbArrival))
#   specDoc$.pipe(mergeMap(doc => from(jsonEach(doc, '$.paths'))),
#                 mergeMap(([pathTemplate, methods]) =>
#                   from(jsonEach(methods)).pipe(
#                     map(([method, body]) =>
#                       ({ pathTemplate, method, operationId: body.operationId })))))

use extract.

rel spec_file(path: text, digest: text) key(1, 2).

rel records(path: text, digest: text, families: text) -> (record: text, doc: json) key(1, 3).

rel spec_doc(path: text, doc: json).
spec_doc(path, doc) <-
  spec_file(path, digest),
  records(path, digest, "data", 'data_doc', doc).

rel spec_operation(path_template: text, method: text, operation_id: text).
spec_operation(path_template, method, operation_id) <-
  spec_doc(_spec_path, doc),
  decode(doc, {paths: {$path_template: {$method: {operationId: operation_id}}}}).

rel spec_path(path_template: text).
spec_path(path_template) <-
  spec_operation(path_template, _method, _operation_id).
