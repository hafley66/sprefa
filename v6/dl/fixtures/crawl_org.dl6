# crawl_org.dl6 -- THE ORG CRAWL AS ONE PROGRAM.
#
# This is stopping-point program #5 ("auto-synced repo list") and the thing the
# v5 two-liner has never been in v6: one loaded program that discovers the
# repository set itself, enumerates each repository's files at a pinned
# revision, extracts from them, and derives a finding -- with NO shell loop over
# repositories anywhere. Before this file, v6/tsv2/scripts/crawl-bench.sh ran
# one served process per repository and smuggled the root in through
# `$DL_CRAWL_REPO`; the repo column is what kills that.
#
# TWO RULINGS MEET HERE:
#   org_fanout = repos_host_on_clock          the repo set is an sh host's
#                                             answer, re-asked on an interval
#                                             bind -- zero new constructs
#   repo_column_spelling = distinct_name_hosts  every repo-scoped host is its
#                                             own NAME (repos, repo_files_at,
#                                             repo_extract), never an optional
#                                             leading column on the unscoped one
#
# THE WHOLE PIPELINE, in one read:
#
#   want_org(org)                  the world names an org (one /arrivals row)
#     -> repos(org, bucket, root)  host: which repositories exist, on a clock
#     -> repo(root)
#     -> repo_files_at(root, 'HEAD', glob, path, digest)   host, per repository
#     -> repo_file(root, path, digest)
#     -> repo_extract(root, path, digest, callee)          host, per file
#     -> repo_call(root, path, callee)
#     -> banned_call(root, path)                           the finding
#
# Its rx lowering, per the "every snippet carries its lowering" law. Note there
# is no nested subscription and no per-repository lifetime: every fan-out is one
# more mergeMap over rows, which is exactly why the shell loop disappears.
#
#   interval(86400).pipe(
#     withLatestFrom(wantOrg$),
#     map(mintIdentityAndWitness), distinct(r => r.witnessDigest),
#     mergeMap(runShell), mergeMap(commitEdbArrival))      // repos
#
#   repo$.pipe(map(mintIdentityAndWitness), distinct(r => r.witnessDigest),
#              mergeMap(runShell), mergeMap(commitEdbArrival))   // repo_files_at
#
#   repoFile$.pipe(map(mintIdentityAndWitness), distinct(r => r.witnessDigest),
#                  mergeMap(runShell), mergeMap(commitEdbArrival)) // repo_extract
#
#   repoCall$.pipe(filter(row => row.callee === 'eval'))           // banned_call

# ── the cadence ─────────────────────────────────────────────────────────────
# 86400 is the user's own spelling of this ("data from host gh org call on a
# timer of 1 day"). The number is a LITERAL in the rule body below and nowhere
# else: emit_ts.pl's bind_read_literals/4 collects exactly that literal and
# serve/2_binds.ts spins exactly that one rx interval. Changing the cadence is
# editing the rule.
rel interval(period: int, bucket: int).

# ── which repositories exist ────────────────────────────────────────────────
#
# THE LOCAL VARIANT, and it is the one that is graded, because it works offline:
# `org` is a directory holding checkouts, and the answer is one absolute path
# per repository, which is what `git -C` downstream needs.
#
# `bucket` is a FRESHNESS input (registry.pl host_input_contract): it does not
# appear in the template and does not return on the response row. What it does
# is extend the witness, so each day's tick re-asks and an org whose membership
# has not changed absorbs as ZERO DELTA -- the SWR shape the clock_residency
# ruling promised, with no stale-fill rel and no cache policy code.
#
# The `if` is not decoration: `[ -d ... ] && printf` leaves the loop's exit
# status at 1 whenever the LAST candidate is not a repository, and a nonzero
# exit is a host failure (serve/1_hosts.ts runShellLine). `if` returns 0.
rel repos(org: text, bucket: int) -> (root: text) key(1).

# THE GH-SHAPED VARIANT, written and NOT graded (it needs credentials), and its
# gap is named rather than papered over: `gh repo list` answers SLUGS, not
# checkout paths, so its rows cannot feed repo_files_at as they stand. Turning
# a slug into a path is a clone -- a WRITE effect with a cache directory and a
# retry policy -- and no such host exists here. So this host is the org
# MEMBERSHIP source and the clone host is a named absence, not a silent one.
#
# It reaches GitHub through the ONE transport: the endpoint, the header set and
# the decode of the answer are rules, and `http.get` only moves bytes.
rel http.get(url: text, headers: text, prev_etag: text, bucket: int)
  -> (status: int, response_headers: json, body: json, bytes: int).

rel want_org(org: text).

rel org_endpoint(org: text, url: text, headers: text).
org_endpoint(Org, Url, Headers) <-
  want_org(Org),
  Url := concat(["orgs/", Org, "/repos?per_page=100"]),
  Headers := "{\"Accept\":\"application/vnd.github+json\"}".

rel org_answer(org: text, bucket: int, status: int, body: json).
org_answer(Org, Bucket, Status, Body) <-
  org_endpoint(Org, Url, Headers),
  interval(86400, Bucket),
  http.get(Url, Headers, "", Bucket, Status, _RespHeaders, Body, _Bytes).

rel org_member(org: text, slug: text).
org_member(Org, Slug) <-
  org_answer(Org, _Bucket, Status, Body),
  Status == 200,
  decode(Body, [... {full_name: Slug: text}]).

rel repo(root: text).
repo(root) <- want_org(org), interval(86400, bucket), repos(org, bucket, root).

# ── each repository's files, at a pinned revision ───────────────────────────
#
# 'HEAD' rather than the worktree because a crawl wants an answer that does not
# move under it: repo_files_at reports blob oids out of the object database, so
# its witness caches FOREVER and re-crawling an unchanged repository costs one
# `ls-files` and zero file reads. The worktree twin (repo_files) is the right
# host for a repository being edited; this one is right for 389 that are not.
rel repo_files_at(repo: text, rev: text, glob: text) -> (path: text, digest: text).

rel repo_file(repo: text, path: text, digest: text).
repo_file(root, path, digest) <-
  repo(root), repo_files_at(root, 'HEAD', '*.ts', path, digest).

# ── extraction, repo-scoped ─────────────────────────────────────────────────
#
# `repo` is what makes this a DIFFERENT EXECUTOR from the unscoped `/extract/records`
# host (registry.pl arrival_executor(extract__repo_records, '/extract/repo_records')).
#
# `digest` is freshness -- unchanged blob oids are a cache hit per file, and the
# extractor does not run at all.
rel /extract/repo_records(repo: text, path: text, digest: text, families: text) -> (callee: text) key(1, 2, 4).

rel repo_call(repo: text, path: text, callee: text).
repo_call(root, path, callee) <-
  repo_file(root, path, digest), /extract/repo_records(root, path, digest, "call", callee).

# ── the finding ─────────────────────────────────────────────────────────────
# One rail over the whole org, written once, with no idea how many repositories
# it is looking at. That is the point of the file.
rel banned_call(repo: text, path: text).
banned_call(root, path) <- repo_call(root, path, callee), callee == 'eval'.
