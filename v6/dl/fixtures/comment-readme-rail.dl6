# Technique 3: README(anchor) prose capture, then a per-file anchor join and
# drift antijoin. The source comment is grammar-witnessed before policy parses it.

rel watch(glob: text, path: text, digest: text).
rel file(path: text, digest: text).
file(path, digest) <- watch('**/*.rs', path, digest).

rel /extract/comment_fact(path: text, digest: text, families: text) -> (line: int, kind: text, comment_text: text) key(1, 3).
rel comment_node(path: text, digest: text, line: int, kind: text, comment_text: text).
comment_node(path, digest, line, kind, comment_text) <- file(path, digest), /extract/comment_fact(path, digest, "cst", line, kind, comment_text).

rel readme_marker(path: text, digest: text) -> (line: int, anchor: text, prose: text) key(1).
rel readme_text(path: text, digest: text, line: int, anchor: text, prose: text).
readme_text(path, digest, line, anchor, prose) <- file(path, digest), readme_marker(path, digest, line, anchor, prose).

rel readme_note(path: text, line: int, anchor: text, prose: text).
readme_note(path, line, anchor, prose) <- readme_text(path, digest, line, anchor, prose), comment_node(path, digest, line, kind, comment_text).

rel readme_row(path: text, digest: text) -> (anchor: text) key(1).
rel readme_anchor(path: text, anchor: text).
readme_anchor(path, anchor) <- file(path, digest), readme_row(path, digest, anchor).

rel readme_drift(path: text, line: int, anchor: text).
readme_drift(path, line, anchor) <- readme_note(path, line, anchor, prose), not(readme_anchor(path, anchor)).

? readme_note(path, line, anchor, prose).
