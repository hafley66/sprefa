# no-console rail over a fixture repo: ast-grep hits become diag rows.

use extract.

rel ast_rule(path: text, digest: text, request: text) ->
  (record: text, query: text, span: json) key(1, 3).

rel console_rule(id: text, request: text).
console_rule('console_log_hit', 'id: console_log_hit
rule:
  has:
    pattern: console.log($$$ARGS)
').

rel console_hit(path: text, start: int, end: int).

# newest row only (rel(1) state): the live count of remaining hits.
rel(1) hit_count(hits: int).

# demand: one ast_rule run per (path, content witness, rule); the (path,
# request) key re-fires on either the file's digest or the rule text changing.
console_hit(path, start, end) <-
    file(path, content_hash),
    console_rule(_, request),
    ast_rule(path, content_hash, request, 'console_log_hit', _query, span),
    decode(span, {start: start, end: end}).

hit_count(hits: count(path)) <- console_hit(path).

# end_line/end_col/hint unfilled: diag head defaults fill them.
diag(path: path, line: line, col: col, severity: "warn", code: "no-console",
     msg: "console.log left in source") <-
    console_hit(path, start, _, text),
    span_line(path, start, line, col).
