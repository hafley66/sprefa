# flagship-flow.dl6 -- v6 value-plane port of examples/flow-interproc.dl.
#
# `span` preserves the extractor's half-open byte identities. Each extractor
# host is one named JSONL projection. `df_node` deliberately omits `name`: many
# value nodes have `name: null`, and node identity is its file plus span.
#
# NAMED STOP host_struct_output_type: the current text door refuses every
# span-typed host output with
# `unsupported_surface(column_type_wrapper(<host>, <column>, none))`.
# If that compiler stop is lifted, host_struct_output_coercion remains: the
# served host currently serializes an object returned for a declared `span`
# output as text before arrival. These rules and the promoted fixtures state
# the intended exact joins; this program must not replace them with
# callable-plane edges.

use extract.

rel span(start: int, end: int).

rel files_at(rev: text, glob: text) -> (path: text, digest: text).

rel df_node_at(path: text, digest: text, families: text) -> (record: text, family: text, span: span, kind: text) key(1, 3).
rel df_edge_at(path: text, digest: text, families: text) -> (record: text, family: text, kind: text, from: span, to: span) key(1, 3).
rel df_param_at(path: text, digest: text, families: text) -> (record: text, family: text, span: span, pos: int) key(1, 3).
rel df_arg_at(path: text, digest: text, families: text) -> (record: text, family: text, call: span, pos: int, arg: span) key(1, 3).
rel call_node_at(path: text, digest: text, families: text) -> (record: text, family: text, span: span, kind: text) key(1, 3).
rel type_node_at(path: text, digest: text, families: text) -> (record: text, family: text, span: span, kind: text, name: text) key(1, 3).
rel sig_at(path: text, digest: text, families: text) -> (record: text, family: text, owner_start: int, owner_end: int, slot: text, pos: int, ty: text) key(1, 3).
rel resolve_at(rev: text, glob: text) -> (caller_path: text, caller_name: text, callee_path: text, callee_name: text, caller_site_start: int, caller_site_end: int, kind: text).

rel want_at(rev: text, glob: text).
rel file(path: text, digest: text).
file(path, digest) <- want_at(rev, glob), files_at(rev, glob, path, digest).

rel df_node(path: text, at: span, kind: text).
df_node(path, at, kind) <-
  file(path, digest), df_node_at(path, digest, "cst,type,call,df", 'node', 'df', at, kind).

rel df_edge(path: text, from: span, to: span).
df_edge(path, from, to) <-
  file(path, digest), df_edge_at(path, digest, "cst,type,call,df", 'edge', 'df', 'direct', from, to).

rel df_param(path: text, at: span, pos: int).
df_param(path, at, pos) <-
  file(path, digest), df_param_at(path, digest, "cst,type,call,df", 'param', 'df', at, pos).

rel df_arg(path: text, call: span, pos: int, arg: span).
df_arg(path, call, pos, arg) <-
  file(path, digest), df_arg_at(path, digest, "cst,type,call,df", 'arg', 'df', call, pos, arg).

rel call_span(path: text, at: span, kind: text).
call_span(path, at, kind) <-
  file(path, digest), call_node_at(path, digest, "cst,type,call,df", 'node', 'call', at, kind).

rel type_callable(path: text, at: span, name: text).
type_callable(path, at, name) <-
  file(path, digest), type_node_at(path, digest, "cst,type,call,df", 'node', 'type', at, _, name).

rel sig(path: text, owner_start: int, owner_end: int, slot: text, pos: int, ty: text).
sig(path, owner_start, owner_end, slot, pos, ty) <-
  file(path, digest), sig_at(path, digest, "cst,type,call,df", 'sig', 'type', owner_start, owner_end, slot, pos, ty).

rel resolved_call_edge(caller_path: text, caller_name: text, callee_path: text, callee_name: text, caller_site_start: int, caller_site_end: int, kind: text).
resolved_call_edge(caller_path, caller_name, callee_path, callee_name, caller_site_start, caller_site_end, kind) <-
  want_at(rev, glob), resolve_at(rev, glob, caller_path, caller_name, callee_path, callee_name, caller_site_start, caller_site_end, kind).

rel df_value(path: text, start: int, end: int, kind: text).
df_value(path, start, end, kind) <- df_node(path, at, kind), decode(at, {start: start, end: end}).

rel df_direct(from: text, to: text).
df_direct(from, to) <-
  df_edge(path, from_at, to_at),
  decode(from_at, {start: from_start, end: from_end}),
  decode(to_at, {start: to_start, end: to_end}),
  from := concat([path, ':', from_start, ':', from_end]),
  to := concat([path, ':', to_start, ':', to_end]).

rel type_owner(path: text, name: text, start: int, end: int).
type_owner(path, name, start, end) <- type_callable(path, at, name), decode(at, {start: start, end: end}).

# Type nodes span the callable name. Call nodes span the callable body. Sig
# owner keys use the former; df ownership requires the latter.
rel callable_owner(path: text, name: text, start: int, end: int).
callable_owner(path, name, start, end) <-
  call_span(path, call_at, _),
  decode(call_at, {start: start, end: end}),
  type_callable(path, type_at, name),
  decode(type_at, {start: start, end: _}).

# A df parameter or return belongs to the innermost named callable containing
# its span. Joining every enclosing callable makes a nested value an outer
# callable slot.
rel smaller_callable_owner(path: text, value_start: int, value_end: int, owner_start: int, owner_end: int).
smaller_callable_owner(path, value_start, value_end, owner_start, owner_end) <-
  df_value(path, value_start, value_end, _),
  callable_owner(path, _, owner_start, owner_end),
  call_span(path, inner_at, _),
  decode(inner_at, {start: inner_start, end: inner_end}),
  value_start >= inner_start, value_end =< inner_end,
  inner_start >= owner_start, inner_end =< owner_end,
  inner_start \== owner_start.
smaller_callable_owner(path, value_start, value_end, owner_start, owner_end) <-
  df_value(path, value_start, value_end, _),
  callable_owner(path, _, owner_start, owner_end),
  call_span(path, inner_at, _),
  decode(inner_at, {start: inner_start, end: inner_end}),
  value_start >= inner_start, value_end =< inner_end,
  inner_start >= owner_start, inner_end =< owner_end,
  inner_end \== owner_end.

rel value_owner(path: text, value_start: int, value_end: int, callee_path: text, callee_name: text).
value_owner(path, value_start, value_end, callee_path, callee_name) <-
  df_value(path, value_start, value_end, _),
  callable_owner(callee_path, callee_name, owner_start, owner_end),
  path == callee_path,
  value_start >= owner_start, value_end =< owner_end,
  not(smaller_callable_owner(path, value_start, value_end, owner_start, owner_end)).

rel call_target(caller_path: text, call_start: int, callee_path: text, callee_name: text).
call_target(caller_path, call_start, callee_path, callee_name) <-
  resolved_call_edge(caller_path, _, callee_path, callee_name, call_start, _, _).

rel flow_arg_edge(from: text, to: text).
flow_arg_edge(arg, param) <-
  df_arg(caller_path, call_at, pos, arg_at),
  decode(call_at, {start: call_start, end: _}),
  decode(arg_at, {start: arg_start, end: arg_end}),
  call_target(caller_path, call_start, callee_path, callee_name),
  df_param(callee_path, param_at, pos),
  decode(param_at, {start: param_start, end: param_end}),
  value_owner(callee_path, param_start, param_end, callee_path, callee_name),
  arg := concat([caller_path, ':', arg_start, ':', arg_end]),
  param := concat([callee_path, ':', param_start, ':', param_end]).

rel flow_ret_edge(from: text, to: text).
flow_ret_edge(ret, call) <-
  call_target(caller_path, call_start, callee_path, callee_name),
  value_owner(callee_path, ret_start, ret_end, callee_path, callee_name),
  df_value(callee_path, ret_start, ret_end, 'ret'),
  ret := concat([callee_path, ':', ret_start, ':', ret_end]),
  call := concat([caller_path, ':', call_start, ':', call_start]).

rel flow_edge(from: text, to: text).
flow_edge(from, to) <- df_direct(from, to).
flow_edge(from, to) <- flow_arg_edge(from, to).
flow_edge(from, to) <- flow_ret_edge(from, to).

rel flow_reach(from: text, to: text).
flow_reach(from, to) <- flow_edge(from, to).
flow_reach(from, to) <- flow_reach(from, middle), flow_edge(middle, to).

rel sink_callee(callee_path: text, callee_name: text).
sink_callee(callee_path, callee_name) <- call_target(_, _, callee_path, callee_name).

rel flow_param_type(callee_path: text, callee_name: text, pos: int, ty: text).
flow_param_type(callee_path, callee_name, pos, ty) <-
  sink_callee(callee_path, callee_name),
  type_owner(callee_path, callee_name, owner_start, owner_end),
  sig(callee_path, owner_start, owner_end, 'param', pos, ty).

rel flow_node_type(node: text, callee_path: text, callee_name: text, ty: text).
flow_node_type(node, callee_path, callee_name, ty) <-
  sink_callee(callee_path, callee_name),
  df_param(callee_path, param_at, pos),
  decode(param_at, {start: param_start, end: param_end}),
  value_owner(callee_path, param_start, param_end, callee_path, callee_name),
  type_owner(callee_path, callee_name, owner_start, owner_end),
  sig(callee_path, owner_start, owner_end, 'param', pos, ty),
  node := concat([callee_path, ':', param_start, ':', param_end]).

? flow_edge(from, to).
? flow_reach(from, to).
? flow_param_type(callee_path, callee_name, pos, ty).
? flow_node_type(node, callee_path, callee_name, ty).
