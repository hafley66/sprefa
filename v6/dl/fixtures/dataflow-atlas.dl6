# dataflow-atlas.dl6 -- FOUR LANGUAGES, ONE DATAFLOW GRAPH, drawn by graphviz.
#
# The question this program answers: what actually happens when someone types
# `bop run x.dl6`, all the way down to the SQLite statements that execute, and
# how much of that chain can be EXTRACTED rather than asserted.
#
# Four fact planes, one auto-extractor each, none of which can see the others:
#
#   typescript  the FIXED `sprefa-extract` binary (families call + type) over
#               v6/tsv2/cli, v6/tsv2/serve, v6/tsv2/runtime and one emitted
#               module. Projections: defs, call sites, import specifiers.
#   prolog      `library(prolog_xref)` through v6/prolog/tools/xref_facts.pl
#               over v6/prolog/compile and the shared expansion modules.
#               Projections: pred_defined, pred_called.
#   shell       a REGEX host over the shell scripts, the justfile, and the two
#               TypeScript files that spawn processes. Projections: prolog goal
#               mentions, tool mentions, entry-path mentions, extractor
#               mentions, the emitter's generated-file marker.
#   sql         a REGEX host over one emitted module: (verb, table).
#
# Six BRIDGE rules join across the language gaps. Each one is marked BRIDGE and
# carries the reason it has to be written by hand: the fact it derives is one
# that NEITHER extractor can see, because it lives in the gap between two
# languages rather than inside either of them.
#
# ── this is a RAIL, not a fixture ────────────────────────────────────────────
#
# It writes two files, so it is not byte-graded against the oracle -- a program
# with a staged write trades that away, the same call self-map.dl6 and the
# comment rails make. What it is graded on instead: `just atlas` twice produces
# a byte-identical .dot, and deleting a bridge rule in a scratch copy shortens
# the longest path (sabotage receipt in v6/tsv2/scripts/atlas.sh's header).
#
# ── ZERO NEW CONSTRUCTS ──────────────────────────────────────────────────────
#
# `bind watch`, `sh` host + probe, colon-typed decls, `not/1` and comparison
# guards in level bodies, `:=` binds, `concat`, `count`/`max` aggregate heads,
# ordered `group_concat`, RECURSIVE level rules (the reachability stratum), and
# `coalesce`. Every one of them shipped before this file was written.
#
# ── NAMED COMPILER REFUSALS HIT WHILE WRITING THIS (findings, not workarounds) ─
#
#   unsupported_construct(unbound_head_var(_))
#       A guard over a probe OUTPUT variable is refused (flagship-callgraph.dl6
#       documents the minimal repro and design-review finding B4 notes the
#       message names the wrong thing). Every `record` filter below is therefore
#       a CONSTANT IN ARGUMENT POSITION, never a `record == 'goal'` guard.
#   aggregate head cannot mix with a plain clause
#       `fwd` and `bwd` each need one aggregate clause and one base clause, so
#       each is split into an aggregate rel plus a plain rel that reads it
#       (the `fan_in_rank` / `fan_in_row` shape self-map.dl6 already uses).
#   coalesce_no_output
#       coalesce's output variable may appear only in the coalesce atom and the
#       head, which is why `bwd` reads `bwd_positive` through its own rel.
#
# The recursive longest-path shape the brief asked to attempt COMPILED, first
# try, with no refusal at all: see `reach` below. What it needed instead was a
# graph that is actually acyclic, and getting there found a real defect in the
# naive cross-file join -- see BRIDGE-FREE FINDING at `pl_edge`.
#
# ── the rx lowering, per the standing law ────────────────────────────────────
#
#   watchSource(root).pipe(                       // RX-B1, the watch bind
#     bufferTime(coalesceMs),
#     map(diffAgainstLastDigest),
#     concatMap(batch => engine.submit(batch)))   // -> seed(path, digest)
#
#   want$.pipe(                                   // RX-H2, the demand mint
#     map(mintIdentityAndWitness),                // witness = (glob) or (path, digest)
#     distinct(row => row.witnessDigest),         // one subprocess per file, not per projection
#     mergeMap(runShell),                         // RX-H1
#     mergeMap(commitEdbArrival))                 // -> the fact planes
#
#   combineLatest([tsSpec$, tsDef$]).pipe(...)    // the delta joins below
#   expand(frontier => joinOnce(frontier))        // the `reach` fixpoint
#
# ── the two output effects ───────────────────────────────────────────────────
#
# `write_file` performs the sole text write and `render_dot` shells out to
# graphviz. Everything between the extractors and those two boundaries is a
# relational value: node identity, edge derivation, reachability, DOT escaping,
# cluster folds and the final document concat.

# ═════════════════════════════════════════════════════════════════════════════
# THE SEED, and the file sets
# ═════════════════════════════════════════════════════════════════════════════

# The atlas watches ITSELF. That is the whole seed: one watched source supplies
# the world witness every `want` row hangs off, so the program needs no posted
# EDB arrival to start, and editing this file redraws the atlas live.
bind watch(glob: text, path: text, digest: text).

rel seed(path: text, digest: text).
seed(path, digest) <- watch('v6/dl/fixtures/dataflow-atlas.dl6', path, digest).

# The ruled file-set host (rulings.pl `files_naming =
# files_unmarked_worktree_marked_rev`), with ONE column added: `base`, the path
# after the last slash. The extra column is computed by the same shell in the
# same pass, and it exists because import resolution needs it and this language
# has no substring expression -- `module` arrives from the extractor as
# `../runtime/1_incremental.ts` and the file it names arrives from git as
# `v6/tsv2/runtime/1_incremental.ts`, so the join has to happen on a common
# form. The producing side computing it is one `${entry##*/}`; the consuming
# side computing it is a construct this language does not have.
sh files(glob: text) -> (path: text, digest: text, base: text) =
  `git ls-files -- '{glob}' | while IFS= read -r entry; do printf '%s %s %s\n' "$entry" "$(git hash-object -- "$entry")" "${entry##*/}"; done`.

rel want_ts(glob: text).
want_ts('v6/tsv2/cli/*.ts') <- seed(_, _).
want_ts('v6/tsv2/serve/*.ts') <- seed(_, _).
want_ts('v6/tsv2/runtime/*.ts') <- seed(_, _).
want_ts('v6/tsv2/gen_emitted/callgraph_derivation_over_extraction.ts') <- seed(_, _).

rel want_pl(glob: text).
want_pl('v6/prolog/compile/*.pl') <- seed(_, _).
want_pl('v6/prolog/0_*.pl') <- seed(_, _).
want_pl('v6/prolog/1_*.pl') <- seed(_, _).

rel want_sh(glob: text).
want_sh('v6/tsv2/scripts/*.sh') <- seed(_, _).
want_sh('v6/prolog/compile/scripts/*.sh') <- seed(_, _).
want_sh('v6/justfile') <- seed(_, _).

# The ONE emitted module the SQL plane reads. It is a fixture output of the
# sweep, checked in, and it is the callgraph program -- the flagship's own
# compiled form -- so the SQL this atlas draws is the SQL the alpha's headline
# receipt executes.
rel want_gen(glob: text).
want_gen('v6/tsv2/gen_emitted/callgraph_derivation_over_extraction.ts') <- seed(_, _).

# The emitter, read for its generated-file marker only. It is in the prolog
# plane too; this second demand exists so the marker host runs over it.
rel want_marker(glob: text).
want_marker('v6/prolog/compile/emit_ts.pl') <- seed(_, _).

rel ts_file(path: text, digest: text, base: text).
ts_file(path, digest, base) <- want_ts(glob), files(glob, path, digest, base).

rel pl_file(path: text, digest: text, base: text).
pl_file(path, digest, base) <- want_pl(glob), files(glob, path, digest, base).

rel sh_file(path: text, digest: text, base: text).
sh_file(path, digest, base) <- want_sh(glob), files(glob, path, digest, base).

rel gen_file(path: text, digest: text, base: text).
gen_file(path, digest, base) <- want_gen(glob), files(glob, path, digest, base).

rel marker_file(path: text, digest: text, base: text).
marker_file(path, digest, base) <- want_marker(glob), files(glob, path, digest, base).

# ═════════════════════════════════════════════════════════════════════════════
# PLANE 1 -- TYPESCRIPT, through the fixed extractor
# ═════════════════════════════════════════════════════════════════════════════
#
# Three named projections over ONE extractor invocation per file: the served
# runner groups identical templates and inputs, decodes the shared stdout once
# per projection, and `carriesEveryColumn` drops any line missing a declared
# column (or carrying it as JSON null), which is what lets one heterogeneous
# JSONL stream serve three different rel shapes.
#
# THE ONE PIPE IN THE TEMPLATE, and why it is not a second extractor: `module`
# arrives as the specifier AS WRITTEN (`../runtime/1_incremental.ts`) and the
# join needs its last segment. A `sed` that adds a FLAT `module_base` key beside
# it keeps the decode a projection over top-level keys, which is the only shape
# the host reads. The alternative was a nested-object decode, which is exactly
# the construct the flagship rail documents as refused. The sed is part of every
# one of the three templates so all three still group into one subprocess.
#
# BOTH `call` AND `type` FAMILIES, measured not assumed: with `--family call`
# alone the cross-file import join resolved 10 edges, because CallF nodes are
# callables only and most of what crosses a module boundary here is a `const`
# namespace object or an interface. Adding `type` took the same join to 112.
sh ts_def(path: text, digest: text) -> (record: text, family: text, kind: text, name: text) =
  `: {digest}; "$DL_EXTRACT_BIN" --family call,type {path} | sed -E 's|"module":"(([^"]*)/)?([^"/]*)"|"module":"\1\3","module_base":"\3"|'`.

sh ts_site(path: text, digest: text) -> (record: text, family: text, callee: text) =
  `: {digest}; "$DL_EXTRACT_BIN" --family call,type {path} | sed -E 's|"module":"(([^"]*)/)?([^"/]*)"|"module":"\1\3","module_base":"\3"|'`.

sh ts_spec(path: text, digest: text) -> (record: text, family: text, name: text, kind: text, module_base: text) =
  `: {digest}; "$DL_EXTRACT_BIN" --family call,type {path} | sed -E 's|"module":"(([^"]*)/)?([^"/]*)"|"module":"\1\3","module_base":"\3"|'`.

# The record filter is a CONSTANT IN ARGUMENT POSITION, never a guard: a guard
# over a probe output variable is `unsupported_construct(unbound_head_var(_))`.
rel ts_def_row(path: text, kind: text, name: text).
ts_def_row(path, kind, name) <- ts_file(path, digest, _), ts_def(path, digest, 'node', 'call', kind, name).
ts_def_row(path, kind, name) <- ts_file(path, digest, _), ts_def(path, digest, 'node', 'type', kind, name).

rel ts_site_row(path: text, callee: text).
ts_site_row(path, callee) <- ts_file(path, digest, _), ts_site(path, digest, 'site', 'call', callee).

rel ts_spec_row(path: text, name: text, module_base: text).
ts_spec_row(path, name, module_base) <- ts_file(path, digest, _), ts_spec(path, digest, 'specifier', 'call', name, 'named', module_base).

rel ts_def_total(path: text, defs: int).
ts_def_total(path, count(name)) <- ts_def_row(path, _, name).

rel ts_site_total(path: text, sites: int).
ts_site_total(path, count(callee)) <- ts_site_row(path, callee).

# ── the resolved cross-file import edge ──────────────────────────────────────
#
# BRIDGE-FREE: this one IS derivable from the TypeScript plane alone, because
# the extractor emits both halves. It is a three-way join and it is the reason
# the atlas can draw symbol-level TypeScript at all: a specifier says WHAT name
# a file imports and from WHICH module text; a def row says which file OWNS a
# name; the base match resolves the module text to a path. No single record
# carries the pair.
#
# The equijoin is positional (`module_base` appears in both atoms) rather than a
# `base == module_base` guard, which is both shorter and immune to the probe-
# output guard refusal.
rel ts_import_edge(from_path: text, to_path: text, symbol_name: text).
ts_import_edge(from_path, to_path, symbol_name) <-
  ts_spec_row(from_path, symbol_name, module_base),
  ts_file(to_path, _, module_base),
  ts_def_row(to_path, _, symbol_name).

rel ts_crossing_symbol(path: text, symbol_name: text).
ts_crossing_symbol(to_path, symbol_name) <- ts_import_edge(_, to_path, symbol_name).

# ═════════════════════════════════════════════════════════════════════════════
# PLANE 2 -- PROLOG, through library(prolog_xref)
# ═════════════════════════════════════════════════════════════════════════════
#
# Two projections over one `xref_facts.pl` one-shot per file. XREF READS, IT
# DOES NOT RUN: `xref_source/2` parses and expands without executing directives,
# so pointing it at `compile.pl` costs a parse and never a load.
sh pl_def(path: text, digest: text) -> (record: text, name: text, arity: int, how: text) =
  `: {digest}; swipl -q -l "$ATLAS_XREF_FACTS" -g main -t halt -- {path}`.

sh pl_call(path: text, digest: text) -> (record: text, caller: text, caller_arity: int, callee: text, callee_arity: int) =
  `: {digest}; swipl -q -l "$ATLAS_XREF_FACTS" -g main -t halt -- {path}`.

rel pl_def_row(path: text, name: text, arity: int).
pl_def_row(path, name, arity) <- pl_file(path, digest, _), pl_def(path, digest, 'pred_defined', name, arity, 'local').
pl_def_row(path, name, arity) <- pl_file(path, digest, _), pl_def(path, digest, 'pred_defined', name, arity, 'dynamic').
pl_def_row(path, name, arity) <- pl_file(path, digest, _), pl_def(path, digest, 'pred_defined', name, arity, 'multifile').

rel pl_call_row(path: text, caller: text, caller_arity: int, callee: text, callee_arity: int).
pl_call_row(path, caller, caller_arity, callee, callee_arity) <-
  pl_file(path, digest, _),
  pl_call(path, digest, 'pred_called', caller, caller_arity, callee, callee_arity).

rel pl_def_total(path: text, predicates: int).
pl_def_total(path, count(name)) <- pl_def_row(path, name, _).

rel pl_call_total(path: text, calls: int).
pl_call_total(path, count(callee)) <- pl_call_row(path, _, _, callee, _).

# ── the resolved cross-file predicate call ───────────────────────────────────
#
# BRIDGE-FREE FINDING, and the atlas earned it the hard way. `xref_called/3`
# reports a callee as name/arity with NO home file, so the naive resolution is
# "join the callee against every pred_defined row". That resolution MANUFACTURES
# CYCLES: `conjunction_goals/2` is defined in BOTH 0_coalesce_expand.pl and
# 0_seq_expand.pl, each calling its own local copy, and the naive join draws an
# arrow from each file's copy to the other's. Measured on this corpus: 5 back
# edges, all of them false, all of them from name collisions.
#
# `not(pl_def_row(from_file, ...))` is the fix and it is not a hack -- it is
# prolog's own scoping written down. A predicate defined in the calling file IS
# the one called, so the call never leaves the file and there is no cross-file
# edge to draw. With the antijoin the graph is a DAG: 0 back edges, 401 edges
# over 309 predicates, longest prolog-only chain 4 hops.
#
# The antijoin also makes `to_path \== from_path` unnecessary: if from_path
# defined the callee the rule already failed.
rel pl_edge(from_path: text, from_pred: text, from_arity: int, to_path: text, to_pred: text, to_arity: int).
pl_edge(from_path, from_pred, from_arity, to_path, to_pred, to_arity) <-
  pl_call_row(from_path, from_pred, from_arity, to_pred, to_arity),
  pl_def_row(to_path, to_pred, to_arity),
  not(pl_def_row(from_path, to_pred, to_arity)).

# ═════════════════════════════════════════════════════════════════════════════
# PLANE 3 -- SHELL, and the two TypeScript files that spawn processes
# ═════════════════════════════════════════════════════════════════════════════
#
# ONE regex host, five record shapes, two columns each, whitespace-decoded. Say
# it plainly in the document: this plane is REGEX-SHAPED. It has no parser and
# it makes no claim to know shell syntax; it knows five token patterns.
#
#   goal     a snake_case identifier. STATED LIMIT: single-word prolog goals
#            (`main`, `go`, `halt`) are NOT matched, because a regex that
#            matched them would match every English word in every comment. The
#            cost is that `swipl ... -g main` invocations show as a tool edge
#            with no goal edge; the benefit is that every goal row that survives
#            the join against `pred_defined` is a real predicate.
#   tool     one of the nine process names this repository's scripts spawn.
#   entry    a path-shaped token with a known extension.
#   extract  a mention of the fixed extractor, by env var or by crate name.
#   marker   the generated-module header text, present in exactly two places in
#            two different languages -- see BRIDGE 5.
#
# `: {digest};` is a no-op that puts the content digest into the command line,
# so the witness changes when the file does.
sh text_scan(path: text, digest: text) -> (record: text, token: text) =
  `: {digest}; grep -ohE "[a-z][a-z0-9]*(_[a-z0-9]+)+" {path} | sort -u | sed -E 's/^/goal /'; grep -ohE "(swipl|node|dot|git|cargo|jq|curl|python3|sqlite3)" {path} | sort -u | sed -E 's/^/tool /'; grep -ohE "[A-Za-z0-9_./-]+[.](ts|sh|pl|dl6|py|rs)" {path} | sort -u | sed -E 's|^|entry |'; grep -ohE "(DL_EXTRACT_BIN|sprefa-extract)" {path} | sort -u | sed -E 's/^/extract /'; grep -qE "GENERATED by v6/prolog/compile" {path} && printf "marker generated_by_v6_prolog_compile\n"; true`.

# The scanned set is deliberately NOT the prolog plane: a prolog file mentions
# its own predicate names on every line, so scanning it would turn the goal
# bridge into a self-join over the whole language. The emitter is the one
# exception and it is here for its marker only.
rel scan_file(path: text, digest: text).
scan_file(path, digest) <- sh_file(path, digest, _).
scan_file(path, digest) <- ts_file(path, digest, _).
scan_file(path, digest) <- marker_file(path, digest, _).

rel goal_mention(path: text, goal_name: text).
goal_mention(path, goal_name) <- scan_file(path, digest), text_scan(path, digest, 'goal', goal_name).

rel tool_mention(path: text, tool_name: text).
tool_mention(path, tool_name) <- scan_file(path, digest), text_scan(path, digest, 'tool', tool_name).

rel entry_mention(path: text, entry_base: text).
entry_mention(path, entry_base) <- scan_file(path, digest), text_scan(path, digest, 'entry', entry_base).

rel extract_mention(path: text, extract_token: text).
extract_mention(path, extract_token) <- scan_file(path, digest), text_scan(path, digest, 'extract', extract_token).

rel marker_mention(path: text, marker_token: text).
marker_mention(path, marker_token) <- scan_file(path, digest), text_scan(path, digest, 'marker', marker_token).

# ── the commander verb table ─────────────────────────────────────────────────
#
# A one-file awk state machine, because the pairing is POSITIONAL in a builder
# chain: `.command("q")` and `.action(query)` are two statements apart and the
# name on each side is different. The extractor sees a string literal and an
# identifier; nothing in its output says they are the same command.
sh cli_verbs(path: text, digest: text) -> (verb: text, action_name: text) =
  `: {digest}; awk -F'"' '/[.]command[(]"/ { held = $2 } /[.]action[(]/ { line = $0; sub(/.*[.]action[(]/, "", line); sub(/[)].*/, "", line); if (held != "") { print held, line; held = "" } }' {path}`.

rel cli_command(verb: text, action_name: text, path: text).
cli_command(verb, action_name, path) <-
  ts_file(path, digest, 'bop.ts'), cli_verbs(path, digest, verb, action_name).

# ═════════════════════════════════════════════════════════════════════════════
# PLANE 4 -- SQL, by regex, over the one emitted module
# ═════════════════════════════════════════════════════════════════════════════
#
# REGEX-SHAPED and the document says so. It reads a statement verb and the
# quoted identifier that follows it. Emitted SQL always double-quotes its table
# identifiers (lower.pl `table_name`), which is exactly what makes this cheap
# and exactly why it does not generalize to hand-written SQL.
sh sql_scan(path: text, digest: text) -> (verb: text, table_name: text) =
  `: {digest}; grep -ohE "(CREATE TABLE IF NOT EXISTS|CREATE INDEX IF NOT EXISTS|CREATE TEMP TABLE IF NOT EXISTS|INSERT OR IGNORE INTO|INSERT OR REPLACE INTO|INSERT INTO|DELETE FROM|UPDATE|JOIN|FROM) +\"[A-Za-z_][A-Za-z0-9_]*" {path} | tr -d '"' | awk '{ last = $NF; head = $1; for (i = 2; i < NF; i++) head = head "_" $i; print head, last }' | sort -u`.

rel sql_touch(path: text, verb: text, table_name: text).
sql_touch(path, verb, table_name) <- gen_file(path, digest, _), sql_scan(path, digest, verb, table_name).

rel sql_table(table_name: text).
sql_table(table_name) <- sql_touch(_, _, table_name).

rel sql_table_total(table_name: text, statements: int).
sql_table_total(table_name, count(verb)) <- sql_touch(_, verb, table_name).

# ═════════════════════════════════════════════════════════════════════════════
# THE sprefa-extract CLUSTER
# ═════════════════════════════════════════════════════════════════════════════
#
# The extractor is FIXED (ruling: read-only use), so the atlas reads it the only
# two honest ways: it asks the binary what flags it takes, and it runs it once
# and reads back which record kinds actually came out. Both are the tool's own
# answer rather than a reading of its source.
# THE BINARY IS NAMED BY ENVIRONMENT, NOT BY COLUMN, and that is forced rather
# than chosen: `fillTemplate` escapes `$` when it splices a value into a
# double-quoted position (1_hosts.ts:177), so a `$DL_EXTRACT_BIN` arriving as a
# COLUMN would render as the literal seven-character string and never expand.
# `"$DL_EXTRACT_BIN"` written into the template text is read by the shell, which
# is the same spelling flagship-callgraph.dl6 uses.
sh extract_flags(token: text) -> (flag_name: text) =
  `: {token}; "$DL_EXTRACT_BIN" --help 2>&1 | grep -ohE "^ +--[a-z-]+" | tr -d ' ' | sort -u`.

sh extract_records(sample_path: text) -> (record_kind: text) =
  `"$DL_EXTRACT_BIN" --family cst,type,call,df {sample_path} | grep -ohE "\"record\":\"[a-z_]+\"" | sed -E 's|.*:"(.*)"|\1|' | sort -u`.

rel extract_flag(flag_name: text).
extract_flag(flag_name) <- seed(_, digest), extract_flags(digest, flag_name).

rel extract_record(record_kind: text).
extract_record(record_kind) <- seed(_, _), extract_records('v6/tsv2/cli/bop.ts', record_kind).

# ═════════════════════════════════════════════════════════════════════════════
# NODES -- every candidate, in every plane
# ═════════════════════════════════════════════════════════════════════════════
#
# `node_meta` is the candidate set; `atlas_node` is the DRAWN set, and a node is
# drawn exactly when some edge touches it. That keeps the picture honest in both
# directions: a symbol nothing imports never appears, and an edge can never
# point at a node the graph does not show.
#
# `container` is the graphviz sub-cluster (a file, or a plane-level bucket for
# the nodes that have no file). `plane` is the outer cluster.

rel node_meta(node_id: text, plane: text, container: text, label_text: text, shape_name: text).

# TypeScript: one module node per file, one symbol node per definition.
node_meta(node_id, 'typescript', path, base, 'component') <-
  ts_file(path, _, base), node_id := concat(['ts:', path, '#module']).
node_meta(node_id, 'typescript', path, name, 'box') <-
  ts_def_row(path, _, name), node_id := concat(['ts:', path, '#', name]).

# Prolog: one node per predicate, no module node -- xref gives a REAL caller, so
# the prolog plane draws predicate to predicate and never file to file.
node_meta(node_id, 'prolog', path, label_text, 'box') <-
  pl_def_row(path, name, arity),
  node_id := concat(['pl:', path, '#', name, '/', arity]),
  label_text := concat([name, '/', arity]).

# Shell: the script is the node. A shell script has no exported symbol to speak
# of, and pretending otherwise would be a granularity this plane cannot support.
node_meta(node_id, 'shell', 'scripts', base, 'note') <-
  sh_file(path, _, base), node_id := concat(['sh:', path]).

# CLI verbs, SQL tables, and the extractor's own surface.
node_meta(node_id, 'cli', 'verbs', verb, 'ellipse') <-
  cli_command(verb, _, _), node_id := concat(['cli:', verb]).
node_meta(node_id, 'sqlite', 'tables', table_name, 'cylinder') <-
  sql_table(table_name), node_id := concat(['sql:', table_name]).
node_meta('ex:bin', 'extractor', 'binary', 'sprefa-extract', 'box3d') <- seed(_, _).
node_meta(node_id, 'extractor', 'flags', flag_name, 'plaintext') <-
  extract_flag(flag_name), node_id := concat(['ex:flag:', flag_name]).
node_meta(node_id, 'extractor', 'records', record_kind, 'plaintext') <-
  extract_record(record_kind), node_id := concat(['ex:record:', record_kind]).

# ═════════════════════════════════════════════════════════════════════════════
# EDGES -- six of them are BRIDGES and every bridge says why
# ═════════════════════════════════════════════════════════════════════════════

rel atlas_edge(from_id: text, to_id: text, edge_kind: text).

# ── within TypeScript: import, then residency ────────────────────────────────
# The importing FILE points at the imported SYMBOL, and the symbol points at its
# own module. Caller attribution inside the importing file is deliberately NOT
# drawn: phase-1 extraction gives call sites without an enclosing callable, and
# the file-scoped co-occurrence heuristic that flagship-callgraph.dl6 ports from
# v5 would multiply 136 defs by 1373 sites into tens of thousands of edges that
# are mostly false. A file-to-symbol edge is a fact; a def-to-site pair is a
# guess.
atlas_edge(from_id, to_id, 'import') <-
  ts_import_edge(from_path, to_path, symbol_name),
  from_id := concat(['ts:', from_path, '#module']),
  to_id := concat(['ts:', to_path, '#', symbol_name]).

atlas_edge(from_id, to_id, 'resides') <-
  ts_crossing_symbol(path, symbol_name),
  from_id := concat(['ts:', path, '#', symbol_name]),
  to_id := concat(['ts:', path, '#module']).

# ── within prolog: the real call edge ────────────────────────────────────────
atlas_edge(from_id, to_id, 'calls') <-
  pl_edge(from_path, from_pred, from_arity, to_path, to_pred, to_arity),
  from_id := concat(['pl:', from_path, '#', from_pred, '/', from_arity]),
  to_id := concat(['pl:', to_path, '#', to_pred, '/', to_arity]).

# ── BRIDGE 1: commander verb -> its action function ──────────────────────────
# WHY IT IS BESPOKE: the TypeScript extractor sees `"run"` as a string literal
# argument and `run` as an identifier argument, two unrelated call sites in a
# builder chain. That `.command("q")` and `.action(query)` name ONE command is
# knowledge of commander's API, and no extractor of TypeScript syntax can hold
# it. The awk state machine above is the smallest thing that does.
atlas_edge(from_id, to_id, 'bridge_verb') <-
  cli_command(verb, action_name, path),
  ts_def_row(path, _, action_name),
  from_id := concat(['cli:', verb]),
  to_id := concat(['ts:', path, '#', action_name]).

# ── BRIDGE 2: a TypeScript module -> the prolog predicate it spawns ──────────
# WHY IT IS BESPOKE: `v6/tsv2/serve/0_compile.ts` builds the string
# `compile_dl6('...', '...')` and hands it to `swipl -g`. To the TypeScript
# extractor that is a template literal. To prolog_xref that predicate has no
# caller at all -- nothing in the prolog corpus calls `compile_dl6/2`, which is
# exactly what an entry point looks like from inside its own language. The edge
# exists only in the gap, and the join that recovers it is: a snake_case token
# in a non-prolog file that a prolog file DEFINES, in a file that also mentions
# `swipl`.
rel spawns_swipl(path: text).
spawns_swipl(path) <- tool_mention(path, 'swipl').

atlas_edge(from_id, to_id, 'bridge_spawn') <-
  goal_mention(from_path, goal_name),
  spawns_swipl(from_path),
  ts_file(from_path, _, _),
  pl_def_row(to_path, goal_name, arity),
  from_id := concat(['ts:', from_path, '#module']),
  to_id := concat(['pl:', to_path, '#', goal_name, '/', arity]).

# ── BRIDGE 3: a shell script -> the prolog predicate it invokes ──────────────
# WHY IT IS BESPOKE: same gap, other side. `compile_dl6.sh` writes
# `-g "compile_dl6('$INPUT', '$OUTPUT')"`; the shell has no notion of a prolog
# predicate and prolog_xref has no notion of a shell script. This is the brief's
# `script_invokes_swipl(script, goal)` joined against `pred_defined`, and it is
# the join that turns two token streams into one arrow.
atlas_edge(from_id, to_id, 'bridge_invoke') <-
  goal_mention(from_path, goal_name),
  spawns_swipl(from_path),
  sh_file(from_path, _, _),
  pl_def_row(to_path, goal_name, arity),
  from_id := concat(['sh:', from_path]),
  to_id := concat(['pl:', to_path, '#', goal_name, '/', arity]).

# ── BRIDGE 4: a shell script -> the TypeScript entry it runs ─────────────────
# WHY IT IS BESPOKE: `node --experimental-transform-types "$SERVE"` names a file
# through a shell variable that was assigned three lines earlier from a path
# expression. Nothing extracts a process edge from that; what IS extractable is
# a path-shaped token, and joining its last segment against the TypeScript file
# set is what makes it an arrow. The `node` requirement keeps a script that
# merely NAMES a .ts file (a comment, a grep target) from claiming to run it.
rel spawns_node(path: text).
spawns_node(path) <- tool_mention(path, 'node').

atlas_edge(from_id, to_id, 'bridge_run') <-
  entry_mention(from_path, entry_base),
  spawns_node(from_path),
  sh_file(from_path, _, _),
  ts_file(to_path, _, entry_base),
  from_id := concat(['sh:', from_path]),
  to_id := concat(['ts:', to_path, '#module']).

# ── BRIDGE 5: the emitter -> the module it emits ─────────────────────────────
# WHY IT IS BESPOKE: the emitted module DOES NOT EXIST until the compiler runs,
# so no static reading of either language can attribute it to its producer. What
# both sides do carry is one identical run of text: emit_ts.pl holds
# `'// GENERATED by v6/prolog/compile (tsv2 emitter P3). Do not'` as a format
# string, and every emitted module carries it as its first comment line. Joining
# a prolog file that WRITES the marker to a TypeScript file that CARRIES it is
# the whole bridge, and it is the one edge in this atlas that crosses from a
# string literal in one language to a comment in another.
atlas_edge(from_id, to_id, 'bridge_emit') <-
  marker_mention(from_path, marker_token),
  pl_file(from_path, _, _),
  marker_mention(to_path, marker_token),
  gen_file(to_path, _, _),
  from_id := concat(['pl:', from_path, '#emit_program_text/2']),
  to_id := concat(['ts:', to_path, '#module']).

# ── BRIDGE 6: everything that touches the fixed extractor ────────────────────
# WHY IT IS BESPOKE: `sprefa-extract` is reached through the env var
# `DL_EXTRACT_BIN`, whose value is set by a shell script and read by a template
# in a dl6 program. There is no call, no import, and no symbol -- the edge is an
# environment variable, and the only extractable trace of it is the variable's
# own name appearing in both places.
atlas_edge(from_id, 'ex:bin', 'bridge_extract') <-
  extract_mention(from_path, _), sh_file(from_path, _, _),
  from_id := concat(['sh:', from_path]).
atlas_edge(from_id, 'ex:bin', 'bridge_extract') <-
  extract_mention(from_path, _), ts_file(from_path, _, _),
  from_id := concat(['ts:', from_path, '#module']).

atlas_edge('ex:bin', to_id, 'flag') <-
  extract_flag(flag_name), to_id := concat(['ex:flag:', flag_name]).
atlas_edge('ex:bin', to_id, 'record') <-
  extract_record(record_kind), to_id := concat(['ex:record:', record_kind]).

# ── the SQL plane: the emitted module reaches its tables ─────────────────────
atlas_edge(from_id, to_id, 'statement') <-
  sql_touch(path, _, table_name),
  from_id := concat(['ts:', path, '#module']),
  to_id := concat(['sql:', table_name]).

# ── the drawn node set ───────────────────────────────────────────────────────
rel atlas_node(node_id: text, plane: text, container: text, label_text: text, shape_name: text).
atlas_node(node_id, plane, container, label_text, shape_name) <-
  node_meta(node_id, plane, container, label_text, shape_name), atlas_edge(node_id, _, _).
atlas_node(node_id, plane, container, label_text, shape_name) <-
  node_meta(node_id, plane, container, label_text, shape_name), atlas_edge(_, node_id, _).

# An edge whose endpoint has no `node_meta` row would draw a naked node with a
# raw id for a label. There is none, and this rel is how that is checked rather
# than assumed.
rel edge_without_node(node_id: text).
edge_without_node(from_id) <- atlas_edge(from_id, _, _), not(node_meta(from_id, _, _, _, _)).
edge_without_node(to_id) <- atlas_edge(_, to_id, _), not(node_meta(to_id, _, _, _, _)).

# ═════════════════════════════════════════════════════════════════════════════
# THE LONGEST PATH -- a recursive stratum, and it compiled first try
# ═════════════════════════════════════════════════════════════════════════════
#
# The brief expected a refusal here and banked a fallback. There was none: a
# recursive level rule carrying an incrementing hop count is an ordinary
# stratum, and the emitter's P3 reseed handles it. What the shape DOES need is a
# graph without cycles, since a cycle makes `hops` climb forever. Every edge
# family above is acyclic by construction:
#
#   import/resides  follow the ES module graph, which is a DAG by the loader's
#                   own rules and by this package's numeric-prefix convention
#   calls           acyclic ONLY because of the local-definition antijoin at
#                   `pl_edge`; without it, 5 false back edges (measured)
#   the bridges     each crosses a language once, in one direction
#   statement       terminal, nothing leaves a table node
#
# `prior < 32` is a TERMINATION FLOOR, not the answer: it exists so that a
# future edge family that reintroduces a cycle fails as a bounded wrong number
# rather than as a hung rail. `cycle_node` below reports whether the floor was
# ever near, and the document prints its count.
rel reach(from_id: text, to_id: text, hops: int).
reach(from_id, to_id, 1) <- atlas_edge(from_id, to_id, _).
reach(from_id, to_id, hops) <-
  reach(from_id, mid_id, prior), atlas_edge(mid_id, to_id, _), prior < 32, hops := prior + 1.

rel cycle_node(node_id: text).
cycle_node(node_id) <- reach(node_id, node_id, _).

# The entry is `bop run`, grounded in the fact that the verb exists rather than
# written as a constant: delete the `run` subcommand and the atlas has no entry.
rel atlas_entry(node_id: text).
atlas_entry('cli:run') <- cli_command('run', _, _).

# Longest distance FROM the entry, and longest chain ONWARD from each node. The
# aggregate clause and the base clause live in separate rels because an
# aggregate head cannot mix with a plain clause.
# REFUSAL HIT HERE, and the message was exact: writing this as one rule,
# `forward_positive(node_id, max(hops)) <- atlas_entry(entry_id),
# reach(entry_id, node_id, hops)`, is refused
# `unsupported_construct(aggregate_group_not_delta_local(...))`. An aggregate's
# GROUP columns have to be bound by EVERY positive body atom on its own, because
# the emitter seeds the aggregate's scope table once per body atom from that
# atom's delta rows alone (lower.pl:2165 says so and says why: an under-
# approximated scope would leave a stale aggregate row with no delta behind it).
# `atlas_entry` does not bind `node_id`, so the join gets its own rel and the
# aggregate reads a single atom.
rel entry_reach(node_id: text, hops: int).
entry_reach(node_id, hops) <- atlas_entry(entry_id), reach(entry_id, node_id, hops).

rel forward_positive(node_id: text, hops: int).
forward_positive(node_id, max(hops)) <- entry_reach(node_id, hops).

rel forward_depth(node_id: text, hops: int).
forward_depth(node_id, hops) <- forward_positive(node_id, hops).
forward_depth(node_id, 0) <- atlas_entry(node_id).

rel onward_positive(node_id: text, hops: int).
onward_positive(node_id, max(hops)) <- reach(node_id, _, hops).

# coalesce's output variable may appear only in the coalesce atom and the head
# (`coalesce_no_output` otherwise), so the zero floor for a sink is its own read.
rel onward_depth(node_id: text, hops: int).
onward_depth(node_id, hops) <- forward_depth(node_id, _), coalesce(onward_positive(node_id, hops), 0).

rel path_span(node_id: text, span: int).
path_span(node_id, span) <- forward_depth(node_id, forward), onward_depth(node_id, onward), span := forward + onward.

rel longest_span(span: int).
longest_span(max(span)) <- path_span(_, span).

# A node is ON a longest path exactly when the longest chain through it is the
# longest chain there is. If every depth holds one node, that set IS the path;
# where a depth holds several, the document prints them all rather than picking.
rel on_longest(node_id: text, depth_index: int).
on_longest(node_id, depth_index) <-
  path_span(node_id, span), longest_span(span), forward_depth(node_id, depth_index).

rel longest_level(depth_index: int, node_list: text).
longest_level(depth_index, group_concat(node_id, ' | ')) <- on_longest(node_id, depth_index).

# ═════════════════════════════════════════════════════════════════════════════
# COUNTS -- everything the document states, derived rather than typed
# ═════════════════════════════════════════════════════════════════════════════

rel plane_node_total(plane: text, nodes: int).
plane_node_total(plane, count(node_id)) <- atlas_node(node_id, plane, _, _, _).

rel edge_plane(from_plane: text, to_plane: text, edge_kind: text, from_id: text, to_id: text).
edge_plane(from_plane, to_plane, edge_kind, from_id, to_id) <-
  atlas_edge(from_id, to_id, edge_kind),
  atlas_node(from_id, from_plane, _, _, _),
  atlas_node(to_id, to_plane, _, _, _).

rel plane_edge_total(from_plane: text, to_plane: text, edges: int).
plane_edge_total(from_plane, to_plane, count(from_id)) <- edge_plane(from_plane, to_plane, _, from_id, _).

rel kind_edge_total(edge_kind: text, edges: int).
kind_edge_total(edge_kind, count(from_id)) <- atlas_edge(from_id, _, edge_kind).

rel node_total(nodes: int).
node_total(count(node_id)) <- atlas_node(node_id, _, _, _, _).

rel edge_total(edges: int).
edge_total(count(from_id)) <- atlas_edge(from_id, _, _).

rel cycle_total(nodes: int).
cycle_total(count(node_id)) <- cycle_node(node_id).

rel reach_total(pairs: int).
reach_total(count(from_id)) <- reach(from_id, _, _).

rel container_node_total(container: text, nodes: int).
container_node_total(container, count(node_id)) <- atlas_node(node_id, _, container, _, _).

rel ts_fact_total(rows: int).
ts_fact_total(count(name)) <- ts_def_row(_, _, name).

rel pl_fact_total(rows: int).
pl_fact_total(count(callee)) <- pl_call_row(_, _, _, callee, _).

# ═════════════════════════════════════════════════════════════════════════════
# DOT RENDERING -- the output plane is ordinary dl6 data
# ═════════════════════════════════════════════════════════════════════════════
#
# rankdir=TB and never LR: the reader's viewer cannot use a horizontal strip,
# and a graph this wide laid out left to right is a mile of whitespace.

rel dot_line(section: text, ordinal: int, line_text: text).

rel plane_label(plane: text, label_text: text).
plane_label('cli', 'cli (commander)') <- seed(_, _).
plane_label('typescript', 'typescript (sprefa-extract: call + type)') <- seed(_, _).
plane_label('prolog', 'prolog (library(prolog_xref))') <- seed(_, _).
plane_label('shell', 'shell + justfile (regex)') <- seed(_, _).
plane_label('sqlite', 'sqlite (regex over emitted SQL)') <- seed(_, _).
plane_label('extractor', 'sprefa-extract (fixed, read-only)') <- seed(_, _).

rel plane_colour(plane: text, colour_name: text).
plane_colour('cli', '#b45309') <- seed(_, _).
plane_colour('typescript', '#1d4ed8') <- seed(_, _).
plane_colour('prolog', '#15803d') <- seed(_, _).
plane_colour('shell', '#7c3aed') <- seed(_, _).
plane_colour('sqlite', '#be123c') <- seed(_, _).
plane_colour('extractor', '#0f766e') <- seed(_, _).

rel edge_style(edge_kind: text, style_text: text).
edge_style('import', 'color="#1d4ed8"') <- seed(_, _).
edge_style('resides', 'color="#93c5fd",arrowhead=none') <- seed(_, _).
edge_style('calls', 'color="#15803d"') <- seed(_, _).
edge_style('statement', 'color="#be123c"') <- seed(_, _).
edge_style('flag', 'color="#5eead4",arrowhead=none') <- seed(_, _).
edge_style('record', 'color="#5eead4",arrowhead=none') <- seed(_, _).
edge_style('bridge_verb', 'color="#b45309",penwidth=3') <- seed(_, _).
edge_style('bridge_spawn', 'color="#b45309",penwidth=3') <- seed(_, _).
edge_style('bridge_invoke', 'color="#b45309",penwidth=3') <- seed(_, _).
edge_style('bridge_run', 'color="#b45309",penwidth=3') <- seed(_, _).
edge_style('bridge_emit', 'color="#b45309",penwidth=3') <- seed(_, _).
edge_style('bridge_extract', 'color="#b45309",penwidth=3') <- seed(_, _).

# A node on a longest path is filled; every other node is plain. The highlight
# is derived, so it moves when the graph does.
rel node_line(plane: text, container: text, line_text: text).
node_line(plane, container, line_text) <-
  atlas_node(node_id, plane, container, label_text, shape_name),
  on_longest(node_id, _),
  line_text := concat(['    "', node_id, '" [label="', label_text, '",shape=', shape_name, ',style=filled,fillcolor="#fde68a"];']).
node_line(plane, container, line_text) <-
  atlas_node(node_id, plane, container, label_text, shape_name),
  not(on_longest(node_id, _)),
  line_text := concat(['    "', node_id, '" [label="', label_text, '",shape=', shape_name, '];']).

# Ordered by the line text itself, so the fold is deterministic without a
# separate ordinal column and without leaning on the engine's row order.
rel container_body(plane: text, container: text, body_text: text).
container_body(plane, container, group_concat(line_text, '\n')) <- node_line(plane, container, line_text).

rel container_fragment(plane: text, container: text, fragment: text).
container_fragment(plane, container, fragment) <-
  container_body(plane, container, body_text),
  container_id := norm(container),
  fragment := concat(['  subgraph cluster_', container_id, ' {\n    label="', container, '";\n    style=dotted;\n', body_text, '\n  }']).

rel plane_body(plane: text, body_text: text).
plane_body(plane, group_concat(fragment, '\n')) <- container_fragment(plane, _, fragment).

rel plane_fragment(plane: text, fragment: text).
plane_fragment(plane, fragment) <-
  plane_body(plane, body_text), plane_label(plane, label_text), plane_colour(plane, colour_name),
  fragment := concat([' subgraph cluster_plane_', plane, ' {\n  label="', label_text,
                      '";\n  color="', colour_name, '";\n  penwidth=2;\n', body_text, '\n }']).

rel graph_body(body_text: text).
graph_body(group_concat(fragment, '\n')) <- plane_fragment(_, fragment).

rel edge_line(line_text: text).
edge_line(line_text) <-
  atlas_edge(from_id, to_id, edge_kind), edge_style(edge_kind, style_text),
  line_text := concat(['  "', from_id, '" -> "', to_id, '" [', style_text, '];']).

rel edges_text(body_text: text).
edges_text(group_concat(line_text, '\n')) <- edge_line(line_text).

dot_line('head', 10, 'digraph dataflow_atlas {') <- seed(_, _).
dot_line('head', 20, '  rankdir=TB;') <- seed(_, _).
dot_line('head', 30, '  compound=true;') <- seed(_, _).
dot_line('head', 40, '  newrank=true;') <- seed(_, _).
dot_line('head', 50, '  ranksep=0.7;') <- seed(_, _).
dot_line('head', 60, '  nodesep=0.25;') <- seed(_, _).
dot_line('head', 70, '  graph [fontname="Helvetica",fontsize=14,labelloc=t];') <- seed(_, _).
dot_line('head', 80, '  node [fontname="Helvetica",fontsize=10,margin="0.06,0.03"];') <- seed(_, _).
dot_line('head', 90, '  edge [fontname="Helvetica",fontsize=8];') <- seed(_, _).
dot_line('head', 100, line_text) <- node_total(nodes), edge_total(edges), longest_span(span),
  line_text := concat(['  label="sprefa v6 dataflow atlas -- ', nodes, ' nodes, ', edges,
                       ' edges, longest path from bop run = ', span, ' hops (GENERATED, do not edit)";']).
dot_line('body', 10, body_text) <- graph_body(body_text).
dot_line('edges', 10, body_text) <- edges_text(body_text).
dot_line('tail', 10, '}') <- seed(_, _).

rel section_text(section: text, body_text: text).
section_text(section, group_concat(line_text, '\n', ordinal)) <- dot_line(section, ordinal, line_text).

rel dot_document(document: text).
dot_document(document) <-
  section_text('head', head_text), section_text('body', body_text),
  section_text('edges', edges_body), section_text('tail', tail_text),
  document := concat([head_text, '\n', body_text, '\n', edges_body, '\n', tail_text, '\n']).

# ═════════════════════════════════════════════════════════════════════════════
# THE MARKDOWN COMPANION
# ═════════════════════════════════════════════════════════════════════════════

rel md_line(section: text, ordinal: int, line_text: text).

md_line('doc', 10, '# The v6 dataflow atlas') <- seed(_, _).
md_line('doc', 20,
  'GENERATED by `just atlas` (`v6/tsv2/scripts/atlas.sh`). Do not edit: the next run overwrites it, byte for byte. The graph is `v6/DATAFLOW-ATLAS.svg`, rendered by graphviz from `v6/DATAFLOW-ATLAS.dot`, which `v6/dl/fixtures/dataflow-atlas.dl6` assembles from extracted facts.') <- seed(_, _).
md_line('doc', 30, line_text) <- node_total(nodes), edge_total(edges), reach_total(pairs), cycle_total(cycles),
  line_text := concat(['**', nodes, ' nodes, ', edges, ' edges.** The reachability stratum settled at ',
                       pairs, ' (from, to, hops) triples with ', cycles,
                       ' node(s) reaching themselves; zero is what makes the longest path a number rather than a bound.']).
md_line('doc', 40, '') <- seed(_, _).
md_line('doc', 50, '## Nodes per plane') <- seed(_, _).
md_line('doc', 60, '') <- seed(_, _).
md_line('doc', 70, '| plane | nodes |') <- seed(_, _).
md_line('doc', 80, '|---|---|') <- seed(_, _).

rel plane_row(line_text: text).
plane_row(line_text) <- plane_node_total(plane, nodes),
  line_text := concat(['| `', plane, '` | ', nodes, ' |']).
rel plane_rows(body_text: text).
plane_rows(group_concat(line_text, '\n')) <- plane_row(line_text).
md_line('doc', 90, body_text) <- plane_rows(body_text).

md_line('doc', 100, '') <- seed(_, _).
md_line('doc', 110, '## Edges per kind') <- seed(_, _).
md_line('doc', 120, '') <- seed(_, _).
md_line('doc', 130, '| edge kind | edges | bespoke bridge |') <- seed(_, _).
md_line('doc', 140, '|---|---|---|') <- seed(_, _).

rel bridge_reason(edge_kind: text, reason_text: text).
bridge_reason('bridge_verb', 'commander pairs a subcommand STRING with an action IDENTIFIER two statements apart; no TypeScript extractor holds commander API knowledge') <- seed(_, _).
bridge_reason('bridge_spawn', 'a TS template literal becomes a prolog goal at `swipl -g`; prolog_xref sees the predicate with no caller, the TS extractor sees a string') <- seed(_, _).
bridge_reason('bridge_invoke', 'the same gap from the shell side: a shell has no notion of a predicate and xref has no notion of a script') <- seed(_, _).
bridge_reason('bridge_run', 'a `node "$SERVE"` invocation names a file through a shell variable; the path token joined against the TS file set is the only extractable trace') <- seed(_, _).
bridge_reason('bridge_emit', 'the emitted module does not exist until the compiler runs; the join is the generated-header text, a string literal in prolog and a comment in TypeScript') <- seed(_, _).
bridge_reason('bridge_extract', 'the fixed extractor is reached through the env var DL_EXTRACT_BIN: no call, no import, no symbol') <- seed(_, _).

rel kind_row(line_text: text).
kind_row(line_text) <- kind_edge_total(edge_kind, edges), bridge_reason(edge_kind, reason_text),
  line_text := concat(['| `', edge_kind, '` | ', edges, ' | ', reason_text, ' |']).
kind_row(line_text) <- kind_edge_total(edge_kind, edges), not(bridge_reason(edge_kind, _)),
  line_text := concat(['| `', edge_kind, '` | ', edges, ' | auto-extracted, no bridge |']).
rel kind_rows(body_text: text).
kind_rows(group_concat(line_text, '\n')) <- kind_row(line_text).
md_line('doc', 150, body_text) <- kind_rows(body_text).

md_line('doc', 160, '') <- seed(_, _).
md_line('doc', 170, '## Edges between planes') <- seed(_, _).
md_line('doc', 180, '') <- seed(_, _).
md_line('doc', 190, '| from plane | to plane | edges |') <- seed(_, _).
md_line('doc', 200, '|---|---|---|') <- seed(_, _).

rel crossing_row(line_text: text).
crossing_row(line_text) <- plane_edge_total(from_plane, to_plane, edges),
  line_text := concat(['| `', from_plane, '` | `', to_plane, '` | ', edges, ' |']).
rel crossing_rows(body_text: text).
crossing_rows(group_concat(line_text, '\n')) <- crossing_row(line_text).
md_line('doc', 210, body_text) <- crossing_rows(body_text).

md_line('doc', 220, '') <- seed(_, _).
md_line('doc', 230, '## The longest path, hop by hop') <- seed(_, _).
md_line('doc', 240, '') <- seed(_, _).
md_line('doc', 250, line_text) <- longest_span(span),
  line_text := concat(['`bop run` to the deepest node the graph reaches is **', span,
                       ' hops**. A row below is one hop; where a hop holds more than one node, every one of them lies on some longest chain and the atlas does not pick between them.']).
md_line('doc', 260, '') <- seed(_, _).
md_line('doc', 270, '| hop | node(s) |') <- seed(_, _).
md_line('doc', 280, '|---|---|') <- seed(_, _).

rel hop_row(depth_index: int, line_text: text).
hop_row(depth_index, line_text) <- longest_level(depth_index, node_list),
  line_text := concat(['| ', depth_index, ' | `', node_list, '` |']).
rel hop_rows(body_text: text).
hop_rows(group_concat(line_text, '\n', depth_index)) <- hop_row(depth_index, line_text).
md_line('doc', 290, body_text) <- hop_rows(body_text).

md_line('doc', 300, '') <- seed(_, _).
md_line('doc', 310, '## Fact volume behind the picture') <- seed(_, _).
md_line('doc', 320, '') <- seed(_, _).
md_line('doc', 330, line_text) <- ts_fact_total(ts_rows), pl_fact_total(pl_rows),
  line_text := concat(['The drawn graph is a projection. Underneath it the program holds ', ts_rows,
                       ' TypeScript definition rows and ', pl_rows,
                       ' prolog call rows, plus every call site, import specifier, shell token and SQL statement row the four hosts returned. Nothing is drawn that no fact supports, and the counts above are derived by `count` aggregates in the same file, never typed in.']).

rel md_section_text(section: text, body_text: text).
md_section_text(section, group_concat(line_text, '\n', ordinal)) <- md_line(section, ordinal, line_text).

rel md_document(document: text).
md_document(document) <- md_section_text('doc', body_text), document := concat([body_text, '\n']).

# ═════════════════════════════════════════════════════════════════════════════
# THE TWO OUTPUT EFFECTS
# ═════════════════════════════════════════════════════════════════════════════

sh write_file(path: text, document: text) -> (status: text) =
  `printf '%s' "$document" > "$path"; printf '%s' written`.

sh render_dot(dot_path: text, svg_path: text) -> (status: text) =
  `dot -Tsvg "$dot_path" -o "$svg_path" && printf '%s' rendered`.

rel dot_receipt(status: text).
dot_receipt(status) <- dot_document(document), write_file('v6/DATAFLOW-ATLAS.dot', document, status).

rel md_receipt(status: text).
md_receipt(status) <- md_document(document), write_file('v6/DATAFLOW-ATLAS.md', document, status).

# The render's demand row cannot be minted before the write has answered, which
# is what sequences the two effects: `dot` reads the file `write_file` produced.
rel render_receipt(status: text).
render_receipt(status) <-
  dot_receipt('written'), render_dot('v6/DATAFLOW-ATLAS.dot', 'v6/DATAFLOW-ATLAS.svg', status).

? edge_without_node(node_id).
? cycle_node(node_id).
? longest_level(depth_index, node_list).
? dot_receipt(status).
? md_receipt(status).
? render_receipt(status).
