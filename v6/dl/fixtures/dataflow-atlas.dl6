# dataflow-atlas.dl6 -- FOUR LANGUAGES, ONE DATAFLOW GRAPH, drawn by graphviz.
#
# The question this program answers: what actually happens when someone types
# `bop run x.dl6`, all the way down to the SQLite statements that execute, and
# how much of that chain can be EXTRACTED rather than asserted.
#
# Four fact planes, one auto-extractor each, none of which can see the others:
#
#   typescript  the FIXED `sprefa-extract` binary (families call + type) over
#               v6/tsv2/cli, v6/tsv2/serve, v6/tsv2/runtime and one emitted
#               module. Projections: defs, call sites, import specifiers.
#   prolog      `library(prolog_xref)` through v6/prolog/tools/xref_facts.pl
#               over v6/prolog/compile and the shared expansion modules.
#               Projections: pred_defined, pred_called.
#   shell       a REGEX host over the shell scripts, the justfile, and the two
#               TypeScript files that spawn processes. Projections: prolog goal
#               mentions, tool mentions, entry-path mentions, extractor
#               mentions, the emitter's generated-file marker.
#   sql         a REGEX host over one emitted module: (verb, table).
#
# Seven BRIDGE rules join across the language gaps. Each one is marked BRIDGE and
# carries the reason it has to be written by hand: the fact it derives is one
# that NEITHER extractor can see, because it lives in the gap between two
# languages rather than inside either of them.
#
# ── this is a RAIL, not a fixture ────────────────────────────────────────────
#
# It writes files, so it is not byte-graded against the oracle -- a program
# with a staged write trades that away, the same call self-map.dl6 and the
# comment rails make. What it is graded on instead: `just atlas` twice produces
# byte-identical .dot files; deleting a bridge rule in a scratch copy shortens
# the longest path; pointing one plane's nodes at the wrong file lands them in
# the wrong cluster and the nesting check names every one. Both sabotage
# receipts are in v6/tsv2/scripts/atlas.sh's header.
#
# ── FIVE DRAWINGS OF ONE GRAPH ───────────────────────────────────────────────
#
# The node set, the edge set and every count are derived ONCE. What varies is
# `rankdir` and which clusters the node lines are folded into, and that is one
# rel: `variant/7`, five rows, near the DOT section. The five files:
#
#   lang      DATAFLOW-ATLAS.dot          TB, clustered by language then file
#   flat_td   DATAFLOW-ATLAS-flat-td.dot  TB, no clusters at all
#   flat_lr   DATAFLOW-ATLAS-flat-lr.dot  LR, no clusters at all
#   fs_td     DATAFLOW-ATLAS-fs-td.dot    TB, nested clusters mirroring the
#                                         directory tree, one exploded file
#   fs_lr     DATAFLOW-ATLAS-fs-lr.dot    LR, the same nesting
#
# WHAT THE FOUR EXTRA VIEWS COST, measured on this machine with the same swipl:
# the text door compiles this file in 4m16s where it compiled the pre-variant
# file in 30s. The whole difference is `3_clock_check.pl`'s `clock_path_conflict`,
# which enumerates every simple path between every pair of refs; the filesystem
# fold is a sixteen-rel chain that four different file depths enter, so the path
# count through it multiplies against every rel upstream of `node_line`. Two
# numbers from the same rig, both on the default 1GB stack unless stated:
#
#   30s     the file at HEAD before this change
#   86s     + the variant / flat / markdown machinery, no filesystem fold
#   4m16s   + the filesystem fold, counting rels read off the FOLD SOURCES
#   9m40s   the same fold with the cluster counts read off `fs_frag_d1..d4`
#           (four extra taps into the middle of the chain) -- and this one
#           needed an 8GB stack; at 1GB the served compile died with
#           `Stack limit (1.0Gb) exceeded` inside `clock_violation/2`'s setof
#
# That last pair is the finding worth carrying out of this file: a checker
# whose cost is the simple-path count is a cliff, not a slope, and the program
# that walks off it gets a stack-limit crash rather than a refusal. Nothing
# here is a workaround for it -- rerouting the counts off the fold is the
# correct spelling anyway -- but the cliff is real and unowned.
#
# Because the node lines are shared, the rail can assert what would otherwise
# be a claim: the five files carry the SAME node id set, and only layout and
# grouping move. `lang` keeps an empty label suffix so its .dot stays byte
# identical to the one that existed before the variants were added.
#
# ── ZERO NEW CONSTRUCTS ──────────────────────────────────────────────────────
#
# `bind watch`, `sh` host + probe, colon-typed decls, `not/1` and comparison
# guards in level bodies, `:=` binds, `concat`, `count`/`max` aggregate heads,
# ordered `group_concat`, RECURSIVE level rules (the reachability stratum), and
# `coalesce`. Every one of them shipped before this file was written.
#
# ── NAMED COMPILER REFUSALS HIT WHILE WRITING THIS (findings, not workarounds) ─
#
#   unsupported_construct(unbound_head_var(_))
#       A guard over a probe OUTPUT variable is refused (flagship-callgraph.dl6
#       documents the minimal repro and design-review finding B4 notes the
#       message names the wrong thing). Every `record` filter below is therefore
#       a CONSTANT IN ARGUMENT POSITION, never a `record == 'goal'` guard.
#   aggregate head cannot mix with a plain clause
#       `fwd` and `bwd` each need one aggregate clause and one base clause, so
#       each is split into an aggregate rel plus a plain rel that reads it
#       (the `fan_in_rank` / `fan_in_row` shape self-map.dl6 already uses).
#   coalesce_no_output
#       coalesce's output variable may appear only in the coalesce atom and the
#       head, which is why `bwd` reads `bwd_positive` through its own rel.
#   unsupported_construct(aggregate_ordinal_not_int(_, text))
#       `group_concat(x, sep, x)` is refused: an ordered aggregate's ordinal
#       must be an int. It is also unnecessary -- the TWO-argument form already
#       lowers to `group_concat(x, sep ORDER BY x)` (lower.pl:2894), so a fold
#       ordered by its own value needs no third argument and no ordinal column.
#   unsupported_construct(aggregate_group_not_delta_local(_))
#       an aggregate's GROUP columns must be bound by EVERY positive body atom
#       on its own, because the emitter seeds the scope table once per body atom
#       from that atom's delta rows. Three aggregates here read a join, so each
#       join gets its own rel and the aggregate reads a single atom.
#
# TWO DEFECTS THIS PROGRAM FOUND AND DID NOT FIX (each recorded where it bit):
#   a rel named `sqlite_*` compiles clean and then KILLS THE SERVED PROCESS at
#   DDL time -- see the note above `db_table_node`;
#   a negation that answers zero where the same negation over a projection rel
#   answers correctly, cause NOT identified -- see the note above `ts_defines`.
#
# The recursive longest-path shape the brief asked to attempt COMPILED, first
# try, with no refusal at all: see `reach` below. What it needed instead was a
# graph that is actually acyclic, and getting there found a real defect in the
# naive cross-file join -- see BRIDGE-FREE FINDING at `pl_edge`.
#
# ── the rx lowering, per the standing law ────────────────────────────────────
#
#   watchSource(root).pipe(                       // RX-B1, the watch bind
#     bufferTime(coalesceMs),
#     map(diffAgainstLastDigest),
#     concatMap(batch => engine.submit(batch)))   // -> seed(path, digest)
#
#   want$.pipe(                                   // RX-H2, the demand mint
#     map(mintIdentityAndWitness),                // witness = (glob) or (path, digest)
#     distinct(row => row.witnessDigest),         // one subprocess per file, not per projection
#     mergeMap(runShell),                         // RX-H1
#     mergeMap(commitEdbArrival))                 // -> the fact planes
#
#   combineLatest([tsSpec$, tsDef$]).pipe(...)    // the delta joins below
#   expand(frontier => joinOnce(frontier))        // the `reach` fixpoint
#
# ── the three output effects ─────────────────────────────────────────────────
#
# `write_file` performs every text write (five .dot files and one .md),
# `render_dot` shells out to graphviz once per drawing, and `svg_size` reads
# back the canvas graphviz chose. Everything between the extractors and those
# boundaries is a relational value: node identity, edge derivation,
# reachability, DOT escaping, cluster folds and the final document concat.

# ═════════════════════════════════════════════════════════════════════════════
# THE SEED, and the file sets
# ═════════════════════════════════════════════════════════════════════════════

# The atlas watches ITSELF. That is the whole seed: one watched source supplies
# the world witness every `want` row hangs off, so the program needs no posted
# EDB arrival to start, and editing this file redraws the atlas live.
bind watch(glob: text, path: text, digest: text).

rel seed(path: text, digest: text).
seed(path, digest) <- watch('v6/dl/fixtures/dataflow-atlas.dl6', path, digest).

# The ruled file-set host (rulings.pl `files_naming =
# files_unmarked_worktree_marked_rev`), with ONE column added: `base`, the path
# after the last slash. The extra column is computed by the same shell in the
# same pass, and it exists because import resolution needs it and this language
# has no substring expression -- `module` arrives from the extractor as
# `../runtime/1_incremental.ts` and the file it names arrives from git as
# `v6/tsv2/runtime/1_incremental.ts`, so the join has to happen on a common
# form. The producing side computing it is one `${entry##*/}`; the consuming
# side computing it is a construct this language does not have.
sh files(glob: text) -> (path: text, digest: text, base: text) =
  `git ls-files -- '{glob}' | while IFS= read -r entry; do printf '%s %s %s\n' "$entry" "$(git hash-object -- "$entry")" "${entry##*/}"; done`.

# THE DIRECTORY DECOMPOSITION, and why it is a host and not an expression.
#
# The filesystem views need every ancestor directory of every drawn file: for
# `v6/prolog/compile/analyze.pl`, the four rows `v6`, `v6/prolog`,
# `v6/prolog/compile` with their parents and their own last segment. That is a
# repeated string split on `/`, and this language has no string split.
#
# THE FINDING IS NOT "IT IS REFUSED", WHICH IS WHAT THE BRIEF EXPECTED. A probe
# program compiled through the real text door:
#
#   rel dir_part(path: text, head_text: text).
#   dir_part(path, head_text) <- source_path(path), head_text := split(path, '/').
#
#   compile_dl6.sh -> `wrote split_probe.ts`, exit 0, NO refusal, and the
#   emitted statement is
#     INSERT OR IGNORE INTO "dir_part" ("path", "head_text")
#     SELECT b0."path", json_object('fn', 'split', 'args', json_array(b0."path", '/'))
#     FROM "source_path" b0
#
# An unknown functor on the right of `:=` is NOT caught by the registry's
# refusal-by-absence: that gate covers BODY GOALS, and an expression-position
# compound falls through to the generic compound-term encoder, so `split(...)`
# is stored as the literal TEXT of a term that was never evaluated. The program
# runs, the column fills, and every value in it is wrong. That is the same
# silent class the expression lift closed for braces and list VALUES, one step
# up the grammar, and it is unowned here: this rail records it and does the
# split where the language can be honest about it, in the fact host.
#
# One subprocess per GLOB, not per file: the demand column is the same glob set
# `files` already uses, so this adds twelve content-addressed demand rows and no
# per-file cost. The output is a five-column grid, one line per (file, ancestor).
#
# THE SHELL LOOP COUNTER IS `level` AND NOT `depth`, and that is a real check
# doing its job rather than a style choice: `validate_template/3` refuses a
# template that names an OUTPUT column, and it reads `$depth` in the shell as
# exactly that (`template_mismatch(output_used_as_input(depth))`, hit on the
# first load of this rule). The refusal is right -- an output name in a template
# is either a typo or a value the host cannot have yet.
sh file_dirs(glob: text) -> (path: text, depth: int, dir_path: text, parent_path: text, segment: text) =
  `git ls-files -- '{glob}' | while IFS= read -r entry; do rest="${entry%/*}"; if [ "$rest" = "$entry" ]; then rest=""; fi; prefix=""; level=0; while [ -n "$rest" ]; do seg="${rest%%/*}"; parent="$prefix"; if [ -z "$prefix" ]; then prefix="$seg"; else prefix="$prefix/$seg"; fi; level=$((level + 1)); if [ -z "$parent" ]; then parent="."; fi; printf '%s %s %s %s %s\n' "$entry" "$level" "$prefix" "$parent" "$seg"; case "$rest" in */*) rest="${rest#*/}" ;; *) rest="" ;; esac; done; done`.

rel want_ts(glob: text).
want_ts('v6/tsv2/cli/*.ts') <- seed(_, _).
want_ts('v6/tsv2/serve/*.ts') <- seed(_, _).
want_ts('v6/tsv2/runtime/*.ts') <- seed(_, _).
want_ts('v6/tsv2/gen_emitted/callgraph_derivation_over_extraction.ts') <- seed(_, _).

# `:(glob)` is git pathspec MAGIC and it is here for a measured reason: without
# it `*` crosses slashes, so `v6/prolog/compile/*.pl` also swallows
# `compile/test/` and `compile/scripts/`. `test/run_sql_check.pl` defines
# `rel_ref/2` under the same name as `analyze.pl`, and a cross-file join on
# name/arity then drew an arrow from the compiler into its own test harness and
# back -- a false cycle in a graph whose longest path is only an answer while it
# stays acyclic. With `:(glob)` the plane is the 27 files of the compiler front.
rel want_pl(glob: text).
want_pl(':(glob)v6/prolog/compile/*.pl') <- seed(_, _).
want_pl(':(glob)v6/prolog/0_*.pl') <- seed(_, _).
want_pl(':(glob)v6/prolog/1_*.pl') <- seed(_, _).

rel want_sh(glob: text).
want_sh('v6/tsv2/scripts/*.sh') <- seed(_, _).
want_sh('v6/prolog/compile/scripts/*.sh') <- seed(_, _).
want_sh('v6/justfile') <- seed(_, _).

# The ONE emitted module the SQL plane reads. It is a fixture output of the
# sweep, checked in, and it is the callgraph program -- the flagship's own
# compiled form -- so the SQL this atlas draws is the SQL the alpha's headline
# receipt executes.
rel want_gen(glob: text).
want_gen('v6/tsv2/gen_emitted/callgraph_derivation_over_extraction.ts') <- seed(_, _).

# The emitter, read for its generated-file marker only. It is in the prolog
# plane too; this second demand exists so the marker host runs over it.
rel want_marker(glob: text).
want_marker('v6/prolog/compile/emit_ts.pl') <- seed(_, _).

rel ts_file(path: text, digest: text, base: text).
ts_file(path, digest, base) <- want_ts(glob), files(glob, path, digest, base).

rel pl_file(path: text, digest: text, base: text).
pl_file(path, digest, base) <- want_pl(glob), files(glob, path, digest, base).

rel sh_file(path: text, digest: text, base: text).
sh_file(path, digest, base) <- want_sh(glob), files(glob, path, digest, base).

rel gen_file(path: text, digest: text, base: text).
gen_file(path, digest, base) <- want_gen(glob), files(glob, path, digest, base).

rel marker_file(path: text, digest: text, base: text).
marker_file(path, digest, base) <- want_marker(glob), files(glob, path, digest, base).

# The same glob demand, decomposed. `path_dir` holds one row per (file,
# ancestor); `dir_meta` forgets the file and keeps the directory tree itself.
rel path_dir(path: text, depth: int, dir_path: text, parent_path: text, segment: text).
path_dir(path, depth, dir_path, parent_path, segment) <-
  want_ts(glob), file_dirs(glob, path, depth, dir_path, parent_path, segment).
path_dir(path, depth, dir_path, parent_path, segment) <-
  want_pl(glob), file_dirs(glob, path, depth, dir_path, parent_path, segment).
path_dir(path, depth, dir_path, parent_path, segment) <-
  want_sh(glob), file_dirs(glob, path, depth, dir_path, parent_path, segment).

rel dir_meta(dir_path: text, depth: int, parent_path: text, segment: text).
dir_meta(dir_path, depth, parent_path, segment) <- path_dir(_, depth, dir_path, parent_path, segment).

# A file's own directory is its DEEPEST ancestor. The aggregate reads a single
# atom for the delta-local reason recorded at `forward_positive`.
rel path_dir_depth(path: text, depth: int).
path_dir_depth(path, max(depth)) <- path_dir(path, depth, _, _, _).

rel file_dir(path: text, dir_depth: int, dir_path: text).
file_dir(path, depth, dir_path) <- path_dir_depth(path, depth), path_dir(path, depth, dir_path, _, _).

# Every drawn file, with the label the filesystem view puts on its cluster and
# the plane that colours it. The three file sets are disjoint by construction:
# the globs never overlap between languages, and `gen_file` / `marker_file` are
# subsets of `ts_file` / `pl_file` rather than sets of their own.
rel drawn_file(path: text, base: text, plane: text).
drawn_file(path, base, 'typescript') <- ts_file(path, _, base).
drawn_file(path, base, 'prolog') <- pl_file(path, _, base).
drawn_file(path, base, 'shell') <- sh_file(path, _, base).

# ═════════════════════════════════════════════════════════════════════════════
# PLANE 1 -- TYPESCRIPT, through the fixed extractor
# ═════════════════════════════════════════════════════════════════════════════
#
# Three named projections over ONE extractor invocation per file: the served
# runner groups identical templates and inputs, decodes the shared stdout once
# per projection, and `carriesEveryColumn` drops any line missing a declared
# column (or carrying it as JSON null), which is what lets one heterogeneous
# JSONL stream serve three different rel shapes.
#
# THE ONE PIPE IN THE TEMPLATE, and why it is not a second extractor: `module`
# arrives as the specifier AS WRITTEN (`../runtime/1_incremental.ts`) and the
# join needs its last segment. A `sed` that adds a FLAT `module_base` key beside
# it keeps the decode a projection over top-level keys, which is the only shape
# the host reads. The alternative was a nested-object decode, which is exactly
# the construct the flagship rail documents as refused. The sed is part of every
# one of the three templates so all three still group into one subprocess.
#
# THE LEADING DOT IS MANDATORY IN THAT PATTERN, and it is a defect fix with a
# receipt. Matching any specifier and keeping its last segment made
# `sprefa-store-engine/src/engine/types.ts` -- a BARE PACKAGE specifier naming a
# file in a different package -- resolve to `v6/tsv2/runtime/types.ts`, because
# both end in `types.ts`. The result was a module importing ITSELF, and the
# rail's own cycle check refused the run by name: `1 node(s) reach themselves`.
# Requiring `([.][^"]*/)` means only a RELATIVE specifier gets a `module_base`
# at all, and a specifier with no base is dropped by the decode's
# every-declared-column rule. Bare package imports are then absent from the
# graph, which is correct: they name no file in this tree.
#
# BOTH `call` AND `type` FAMILIES, measured not assumed: with `--family call`
# alone the cross-file import join resolved 10 edges, because CallF nodes are
# callables only and most of what crosses a module boundary here is a `const`
# namespace object or an interface. Adding `type` took the same join to 112.
sh ts_def(path: text, digest: text) -> (record: text, family: text, kind: text, name: text) =
  `: {digest}; "$DL_EXTRACT_BIN" --family call,type {path} | sed -E 's|"module":"([.][^"]*/)([^"/]*)"|"module":"\1\2","module_base":"\2"|'`.

sh ts_site(path: text, digest: text) -> (record: text, family: text, callee: text) =
  `: {digest}; "$DL_EXTRACT_BIN" --family call,type {path} | sed -E 's|"module":"([.][^"]*/)([^"/]*)"|"module":"\1\2","module_base":"\2"|'`.

sh ts_spec(path: text, digest: text) -> (record: text, family: text, name: text, kind: text, module_base: text) =
  `: {digest}; "$DL_EXTRACT_BIN" --family call,type {path} | sed -E 's|"module":"([.][^"]*/)([^"/]*)"|"module":"\1\2","module_base":"\2"|'`.

# The record filter is a CONSTANT IN ARGUMENT POSITION, never a guard: a guard
# over a probe output variable is `unsupported_construct(unbound_head_var(_))`.
rel ts_def_row(path: text, kind: text, name: text).
ts_def_row(path, kind, name) <- ts_file(path, digest, _), ts_def(path, digest, 'node', 'call', kind, name).
ts_def_row(path, kind, name) <- ts_file(path, digest, _), ts_def(path, digest, 'node', 'type', kind, name).

rel ts_site_row(path: text, callee: text).
ts_site_row(path, callee) <- ts_file(path, digest, _), ts_site(path, digest, 'site', 'call', callee).

rel ts_spec_row(path: text, name: text, module_base: text).
ts_spec_row(path, name, module_base) <- ts_file(path, digest, _), ts_spec(path, digest, 'specifier', 'call', name, 'named', module_base).

rel ts_def_total(path: text, defs: int).
ts_def_total(path, count(name)) <- ts_def_row(path, _, name).

rel ts_site_total(path: text, sites: int).
ts_site_total(path, count(callee)) <- ts_site_row(path, callee).

# ── the resolved cross-file import edge ──────────────────────────────────────
#
# BRIDGE-FREE: this one IS derivable from the TypeScript plane alone, because
# the extractor emits both halves. It is a three-way join and it is the reason
# the atlas can draw symbol-level TypeScript at all: a specifier says WHAT name
# a file imports and from WHICH module text; a def row says which file OWNS a
# name; the base match resolves the module text to a path. No single record
# carries the pair.
#
# The equijoin is positional (`module_base` appears in both atoms) rather than a
# `base == module_base` guard, which is both shorter and immune to the probe-
# output guard refusal.
rel ts_import_edge(from_path: text, to_path: text, symbol_name: text).
ts_import_edge(from_path, to_path, symbol_name) <-
  ts_spec_row(from_path, symbol_name, module_base),
  ts_file(to_path, _, module_base),
  ts_def_row(to_path, _, symbol_name).

rel ts_crossing_symbol(path: text, symbol_name: text).
ts_crossing_symbol(to_path, symbol_name) <- ts_import_edge(_, to_path, symbol_name).

# ── the import that resolves to a FILE and not to a symbol, an EXTRACTOR GAP ──
#
# FINDING, and it is the one that cost this lane the most runs. The atlas's
# longest path stopped inside TypeScript and would not reach the compiler, and
# the reason is that `v6/tsv2/serve/4_http.ts` imports `ProgramCompiler` from
# `./0_compile.ts` while `0_compile.ts`'s node records are exactly
# `runSwipl`, `sourceDigest`, `sourcePath`, `modulePath` -- `ProgramCompiler` is
# NOT among them. It is `export const ProgramCompiler: IProgramCompiler = { ...
# }`, an interface-annotated namespace object, and neither the CallF nor the
# TypeF node arm emits a node for that shape.
#
# That shape is not a corner case here: CLAUDE.md's own law says "important
# functions are interface-bound, never bare `export function`", with the
# namespace object as THE DEFAULT. So the pattern this codebase is required to
# use is the pattern its own extractor does not name, and a symbol-level import
# graph silently loses those edges.
#
# The atlas does not paper over it and does not drop the edge either: an import
# whose name has no def row in the target file lands on the target's MODULE node
# and is drawn as its own edge kind, so the count of them is visible in the
# document and this reads as the measurement it is.
# AN UNEXPLAINED OBSERVATION, recorded because it is not yet a finding and must
# not be written as one. This rel exists because
# `not(ts_def_row(to_path, _, symbol_name))` produced ZERO rows on real data
# while `not(ts_defines(to_path, symbol_name))` over the same data produced the
# right ones; the two runs differed in nothing else. The obvious reading -- a
# wildcard inside a negated atom -- was then MEASURED AND REFUTED: a minimal
# program with the identical shape (a wildcard between two bound columns bound
# by two different preceding atoms) answers correctly on both spellings. So the
# trigger is something else about `ts_def_row` (two clauses, both fed by a probe
# response) and it is NOT identified. The projection rel stays because it works;
# the cause is open, and this comment is the whole of what is known.
rel ts_defines(path: text, symbol_name: text).
ts_defines(path, name) <- ts_def_row(path, _, name).

rel ts_import_unresolved(from_path: text, to_path: text, symbol_name: text).
ts_import_unresolved(from_path, to_path, symbol_name) <-
  ts_spec_row(from_path, symbol_name, module_base),
  ts_file(to_path, _, module_base),
  not(ts_defines(to_path, symbol_name)).

# ═════════════════════════════════════════════════════════════════════════════
# PLANE 2 -- PROLOG, through library(prolog_xref)
# ═════════════════════════════════════════════════════════════════════════════
#
# Two projections over one `xref_facts.pl` one-shot per file. XREF READS, IT
# DOES NOT RUN: `xref_source/2` parses and expands without executing directives,
# so pointing it at `compile.pl` costs a parse and never a load.
sh pl_def(path: text, digest: text) -> (record: text, name: text, arity: int, how: text) =
  `: {digest}; swipl -q -l "$ATLAS_XREF_FACTS" -g main -t halt -- {path}`.

sh pl_call(path: text, digest: text) -> (record: text, caller: text, caller_arity: int, callee: text, callee_arity: int) =
  `: {digest}; swipl -q -l "$ATLAS_XREF_FACTS" -g main -t halt -- {path}`.

rel pl_def_row(path: text, name: text, arity: int).
pl_def_row(path, name, arity) <- pl_file(path, digest, _), pl_def(path, digest, 'pred_defined', name, arity, 'local').
pl_def_row(path, name, arity) <- pl_file(path, digest, _), pl_def(path, digest, 'pred_defined', name, arity, 'dynamic').
pl_def_row(path, name, arity) <- pl_file(path, digest, _), pl_def(path, digest, 'pred_defined', name, arity, 'multifile').

rel pl_call_row(path: text, caller: text, caller_arity: int, callee: text, callee_arity: int).
pl_call_row(path, caller, caller_arity, callee, callee_arity) <-
  pl_file(path, digest, _),
  pl_call(path, digest, 'pred_called', caller, caller_arity, callee, callee_arity).

rel pl_def_total(path: text, predicates: int).
pl_def_total(path, count(name)) <- pl_def_row(path, name, _).

rel pl_call_total(path: text, calls: int).
pl_call_total(path, count(callee)) <- pl_call_row(path, _, _, callee, _).

# ── the resolved cross-file predicate call ───────────────────────────────────
#
# BRIDGE-FREE FINDING, and the atlas earned it the hard way. `xref_called/3`
# reports a callee as name/arity with NO home file, so the naive resolution is
# "join the callee against every pred_defined row". That resolution MANUFACTURES
# CYCLES: `conjunction_goals/2` is defined in BOTH 0_coalesce_expand.pl and
# 0_seq_expand.pl, each calling its own local copy, and the naive join draws an
# arrow from each file's copy to the other's. Measured on this corpus: 5 back
# edges, all of them false, all of them from name collisions.
#
# `not(pl_def_row(from_file, ...))` is the fix and it is not a hack -- it is
# prolog's own scoping written down. A predicate defined in the calling file IS
# the one called, so the call never leaves the file and there is no cross-file
# edge to draw. With the antijoin the graph is a DAG: 0 back edges, 401 edges
# over 309 predicates, longest prolog-only chain 4 hops.
#
# The antijoin also makes `to_path \== from_path` unnecessary: if from_path
# defined the callee the rule already failed.
rel pl_edge(from_path: text, from_pred: text, from_arity: int, to_path: text, to_pred: text, to_arity: int).
pl_edge(from_path, from_pred, from_arity, to_path, to_pred, to_arity) <-
  pl_call_row(from_path, from_pred, from_arity, to_pred, to_arity),
  pl_def_row(to_path, to_pred, to_arity),
  not(pl_def_row(from_path, to_pred, to_arity)).

# ── the prolog module node, and the reason it exists ─────────────────────────
#
# The first working atlas drew ONLY predicate-to-predicate arrows, and the chain
# from the CLI died one hop into prolog: `compile_dl6/2` calls `compile_program/6`,
# which is LOCAL TO compile.pl, and the cross-file antijoin above (correctly)
# drops it. Every prolog entry point is like that -- a public predicate calls
# private helpers and those call out.
#
# Within-file calls cannot simply be added: they are recursive. Measured on this
# corpus, adding every within-file call between two cross-file-visible predicates
# adds 187 edges and 2 genuine back edges (`lower.pl:decode_slot/7 <->
# decode_pattern_atoms/5`, `intern_relation_value/6 <->
# rewrite_relation_arguments/6`), and a cyclic family turns the longest path from
# an answer into a cap.
#
# So the prolog plane takes the SAME shape the TypeScript plane already has: a
# MODULE node per file, `predicate -> its own module` residency, and
# `module -> the predicate it calls in another file`. Entering a file is then one
# node and what the file reaches is the file's cross-file call set, which is a
# DAG here (measured: 0 back edges, 249 edges over 117 nodes, 12-hop chain).
#
# That measurement is also what narrowed `want_pl` to `:(glob)` pathspecs. With
# `*` crossing slashes the scope swallowed `compile/test/` and `compile/scripts/`,
# and `test/run_sql_check.pl` defines `rel_ref/2` under the same name as
# `analyze.pl` -- a name collision that put a false arrow from the compiler into
# its own test harness and back, 2 of the 4 back edges seen before the narrowing.
rel pl_node(path: text, pred_name: text, arity: int).
pl_node(to_path, to_pred, to_arity) <- pl_edge(_, _, _, to_path, to_pred, to_arity).
pl_node(to_path, goal_name, arity) <- goal_target(_, to_path, goal_name, arity).
pl_node(to_path, pred_name, arity) <- pl_dispatch_edge(_, to_path, pred_name, arity).

# ── BRIDGE 7: the higher-order emitter dispatch, a gap INSIDE one language ────
#
# WHY IT IS BESPOKE, and this one is the sharpest gap the atlas found. The chain
# from the CLI reached `compile.pl` and stopped: `compile.pl` never calls the
# emitter. It calls `compile_fixture(Name, File, OutFile, emit_ts:emit_program)`
# and the emitter runs through `call/6`. The target is a TERM PASSED AS AN
# ARGUMENT, so prolog_xref reports no call at all -- correctly, because at the
# source level there is none.
#
# That is not an accident of style. compile.pl's own header says the emitter is a
# parameter precisely so `emit_rust.pl` can plug in later. The backend neutrality
# the compiler is designed for is exactly what makes its most important edge
# invisible to static analysis, and without this bridge the atlas cannot reach
# the emitted module or a single SQL statement from `bop run`.
#
# THE REGEX IS NARROW ON PURPOSE, measured three ways. Matching any
# `module:predicate` token yields 12 candidate edges and 5 back edges (files
# mentioning `analyze:...` that analyze.pl already reaches). Adding "and xref did
# not already report this call" still leaves 6. Requiring the qualified term to
# sit in ARGUMENT POSITION -- preceded by `(` or `,` and followed by `)` or `,`,
# which is what a callback looks like and what a goal never looks like -- yields
# exactly ONE edge and zero back edges. One edge is the honest answer: this
# codebase does higher-order dispatch in exactly one place.
sh pl_dispatch(path: text, digest: text) -> (module_file: text, pred_name: text) =
  `: {digest}; grep -ohE "[(,] *[a-z_][a-zA-Z0-9_]*:[a-z_][a-zA-Z0-9_]* *[),]" {path} | tr -d "(), " | tr ':' ' ' | awk '{ print $1 ".pl", $2 }' | sort -u`.

rel pl_dispatch_row(from_path: text, module_file: text, pred_name: text).
pl_dispatch_row(from_path, module_file, pred_name) <-
  pl_file(from_path, digest, _), pl_dispatch(from_path, digest, module_file, pred_name).

# "xref did not already see it" IS the definition of this bridge, so it is a
# condition and not an optimisation. The projection rel follows the shape used
# at `ts_defines` for the reason recorded there.
rel pl_calls_name(path: text, callee: text).
pl_calls_name(path, callee) <- pl_call_row(path, _, _, callee, _).

rel pl_dispatch_edge(from_path: text, to_path: text, pred_name: text, arity: int).
pl_dispatch_edge(from_path, to_path, pred_name, arity) <-
  pl_dispatch_row(from_path, module_file, pred_name),
  pl_file(to_path, _, module_file),
  pl_def_row(to_path, pred_name, arity),
  not(pl_calls_name(from_path, pred_name)),
  from_path \== to_path.

# ── the ONE within-file prolog call the atlas draws, and why only one ────────
#
# BRIDGE 5 lands on the predicate that HOLDS the generated-header text, and that
# predicate is called only from inside its own file, so without this rule the
# emitter is a dead end and the chain never reaches the emitted module or the
# SQL. The edge is drawn from emit_ts.pl's MODULE node rather than from the
# calling predicate, which keeps it out of the residency family: the marker
# predicate gets no `-> its own module` arrow, so `module -> marker -> module`
# cannot close. Its only way out is BRIDGE 5, which leaves prolog.
rel marker_call_edge(path: text, callee: text, callee_arity: int).
marker_call_edge(path, pred_name, arity) <-
  marker_pred(path, pred_name),
  pl_file(path, _, _),
  pl_call_row(path, _, _, pred_name, arity),
  pl_def_row(path, pred_name, arity).

# ═════════════════════════════════════════════════════════════════════════════
# PLANE 3 -- SHELL, and the two TypeScript files that spawn processes
# ═════════════════════════════════════════════════════════════════════════════
#
# ONE regex host, five record shapes, two columns each, whitespace-decoded. Say
# it plainly in the document: this plane is REGEX-SHAPED. It has no parser and
# it makes no claim to know shell syntax; it knows five token patterns.
#
#   goal     a snake_case identifier. STATED LIMIT: single-word prolog goals
#            (`main`, `go`, `halt`) are NOT matched, because a regex that
#            matched them would match every English word in every comment. The
#            cost is that `swipl ... -g main` invocations show as a tool edge
#            with no goal edge; the benefit is that every goal row that survives
#            the join against `pred_defined` is a real predicate.
#   tool     one of the nine process names this repository's scripts spawn.
#   entry    a path-shaped token with a known extension.
#   extract  a mention of the fixed extractor, by env var or by crate name.
#   marker   the generated-module header text, present in exactly two places in
#            two different languages -- see BRIDGE 5.
#   markerpred  the prolog clause head the marker text sits inside.
#
# COMMENT LINES ARE DROPPED for the goal, tool, entry and extract records, and
# that filter is a DEFECT FIX with a receipt. Without it the atlas drew
# `v6/tsv2/runtime/types.ts -> compile.pl#compile_dl6/2`, a cross-language spawn
# arrow whose entire evidence was a doc comment on `IProgramCompiler` that
# happens to say the words `swipl` and `compile_dl6`. It was on the reported
# longest path. `^[[:space:]]*([/][/]|[/][*]|[*]|#|%)` covers line comments,
# block-comment openers and continuations in all four languages here, and after
# it exactly two TypeScript files still claim to spawn swipl: `cli/bop.ts` and
# `serve/0_compile.ts`, which are the two that do.
#
# The marker records are deliberately NOT filtered: the marker is a comment in
# the emitted module by construction, which is the whole point of BRIDGE 5.
#
# `: {digest};` is a no-op that puts the content digest into the command line,
# so the witness changes when the file does.
sh text_scan(path: text, digest: text) -> (record: text, token: text) =
  `: {digest}; grep -vE "^[[:space:]]*([/][/]|[/][*]|[*]|#|%)" {path} | grep -ohE "[a-z][a-z0-9]*(_[a-z0-9]+)+" | sort -u | sed -E 's/^/goal /'; grep -vE "^[[:space:]]*([/][/]|[/][*]|[*]|#|%)" {path} | grep -ohE "(swipl|node|dot|git|cargo|jq|curl|python3|sqlite3)" | sort -u | sed -E 's/^/tool /'; grep -vE "^[[:space:]]*([/][/]|[/][*]|[*]|#|%)" {path} | grep -ohE "[A-Za-z0-9_./-]+[.](ts|sh|pl|dl6|py|rs)" | sort -u | sed -E 's|^|entry |'; grep -vE "^[[:space:]]*([/][/]|[/][*]|[*]|#|%)" {path} | grep -ohE "(DL_EXTRACT_BIN|sprefa-extract)" | sort -u | sed -E 's/^/extract /'; grep -qE "GENERATED by v6/prolog/compile" {path} && printf "marker generated_by_v6_prolog_compile\n"; awk '/^[a-z_][a-zA-Z0-9_]*[(: ]/ { head = $0; sub(/[(: ].*/, "", head) } /GENERATED by v6.prolog.compile/ { if (head != "") print "markerpred", head }' {path}; true`.

# The scanned set is deliberately NOT the prolog plane: a prolog file mentions
# its own predicate names on every line, so scanning it would turn the goal
# bridge into a self-join over the whole language. The emitter is the one
# exception and it is here for its marker only.
rel scan_file(path: text, digest: text).
scan_file(path, digest) <- sh_file(path, digest, _).
scan_file(path, digest) <- ts_file(path, digest, _).
scan_file(path, digest) <- marker_file(path, digest, _).

rel goal_mention(path: text, goal_name: text).
goal_mention(path, goal_name) <- scan_file(path, digest), text_scan(path, digest, 'goal', goal_name).

rel tool_mention(path: text, tool_name: text).
tool_mention(path, tool_name) <- scan_file(path, digest), text_scan(path, digest, 'tool', tool_name).

rel entry_mention(path: text, entry_base: text).
entry_mention(path, entry_base) <- scan_file(path, digest), text_scan(path, digest, 'entry', entry_base).

rel extract_mention(path: text, extract_token: text).
extract_mention(path, extract_token) <- scan_file(path, digest), text_scan(path, digest, 'extract', extract_token).

rel marker_mention(path: text, marker_token: text).
marker_mention(path, marker_token) <- scan_file(path, digest), text_scan(path, digest, 'marker', marker_token).

# The `markerpred` record names the prolog PREDICATE the marker text sits inside,
# tracked by the awk state machine as the last clause head seen before the
# matching line. It exists because the atlas's own integrity check refused the
# first draft of BRIDGE 5: that draft anchored the edge on `emit_program_text/2`,
# a name this reader INVENTED and no `pred_defined` row backed, and
# `edge_without_node` printed it by name. `header_lines/2` is the real answer and
# the extractor found it.
rel marker_pred(path: text, pred_name: text).
marker_pred(path, pred_name) <- scan_file(path, digest), text_scan(path, digest, 'markerpred', pred_name).

# ── the commander verb table ─────────────────────────────────────────────────
#
# A one-file awk state machine, because the pairing is POSITIONAL in a builder
# chain: `.command("q")` and `.action(query)` are two statements apart and the
# name on each side is different. The extractor sees a string literal and an
# identifier; nothing in its output says they are the same command.
sh cli_verbs(path: text, digest: text) -> (verb: text, action_name: text) =
  `: {digest}; awk -F'"' '/[.]command[(]"/ { held = $2 } /[.]action[(]/ { line = $0; sub(/.*[.]action[(]/, "", line); sub(/[)].*/, "", line); if (held != "") { print held, line; held = "" } }' {path}`.

rel cli_command(verb: text, action_name: text, path: text).
cli_command(verb, action_name, path) <-
  ts_file(path, digest, 'bop.ts'), cli_verbs(path, digest, verb, action_name).

# ═════════════════════════════════════════════════════════════════════════════
# PLANE 4 -- SQL, by regex, over the one emitted module
# ═════════════════════════════════════════════════════════════════════════════
#
# REGEX-SHAPED and the document says so. It reads a statement verb and the
# quoted identifier that follows it. Emitted SQL always double-quotes its table
# identifiers (lower.pl `table_name`), which is exactly what makes this cheap
# and exactly why it does not generalize to hand-written SQL.
sh sql_scan(path: text, digest: text) -> (verb: text, table_name: text) =
  `: {digest}; grep -ohE "(CREATE TABLE IF NOT EXISTS|CREATE INDEX IF NOT EXISTS|CREATE TEMP TABLE IF NOT EXISTS|INSERT OR IGNORE INTO|INSERT OR REPLACE INTO|INSERT INTO|DELETE FROM|UPDATE|JOIN|FROM) +\"[A-Za-z_][A-Za-z0-9_]*" {path} | tr -d '"' | awk '{ last = $NF; head = $1; for (i = 2; i < NF; i++) head = head "_" $i; print head, last }' | sort -u`.

rel sql_touch(path: text, verb: text, table_name: text).
sql_touch(path, verb, table_name) <- gen_file(path, digest, _), sql_scan(path, digest, verb, table_name).

rel sql_table(table_name: text).
sql_table(table_name) <- sql_touch(_, _, table_name).

rel sql_table_total(table_name: text, statements: int).
sql_table_total(table_name, count(verb)) <- sql_touch(_, verb, table_name).

# ═════════════════════════════════════════════════════════════════════════════
# THE sprefa-extract CLUSTER
# ═════════════════════════════════════════════════════════════════════════════
#
# The extractor is FIXED (ruling: read-only use), so the atlas reads it the only
# two honest ways: it asks the binary what flags it takes, and it runs it once
# and reads back which record kinds actually came out. Both are the tool's own
# answer rather than a reading of its source.
# THE BINARY IS NAMED BY ENVIRONMENT, NOT BY COLUMN, and that is forced rather
# than chosen: `fillTemplate` escapes `$` when it splices a value into a
# double-quoted position (1_hosts.ts:177), so a `$DL_EXTRACT_BIN` arriving as a
# COLUMN would render as the literal seven-character string and never expand.
# `"$DL_EXTRACT_BIN"` written into the template text is read by the shell, which
# is the same spelling flagship-callgraph.dl6 uses.
sh extract_flags(token: text) -> (flag_name: text) =
  `: {token}; "$DL_EXTRACT_BIN" --help 2>&1 | grep -ohE "^ +--[a-z-]+" | tr -d ' ' | sort -u`.

sh extract_records(sample_path: text) -> (record_kind: text) =
  `"$DL_EXTRACT_BIN" --family cst,type,call,df {sample_path} | grep -ohE "\"record\":\"[a-z_]+\"" | sed -E 's|.*:"(.*)"|\1|' | sort -u`.

rel extract_flag(flag_name: text).
extract_flag(flag_name) <- seed(_, digest), extract_flags(digest, flag_name).

rel extract_record(record_kind: text).
extract_record(record_kind) <- seed(_, _), extract_records('v6/tsv2/cli/bop.ts', record_kind).

# ═════════════════════════════════════════════════════════════════════════════
# NODES -- every candidate, in every plane
# ═════════════════════════════════════════════════════════════════════════════
#
# `node_meta` is the candidate set; `atlas_node` is the DRAWN set, and a node is
# drawn exactly when some edge touches it. That keeps the picture honest in both
# directions: a symbol nothing imports never appears, and an edge can never
# point at a node the graph does not show.
#
# `container` is the graphviz sub-cluster (a file, or a plane-level bucket for
# the nodes that have no file). `plane` is the outer cluster.

rel node_meta(node_id: text, plane: text, container: text, label_text: text, shape_name: text).

# TypeScript: one module node per file, one symbol node per definition.
node_meta(node_id, 'typescript', path, base, 'component') <-
  ts_file(path, _, base), node_id := concat(['ts:', path, '#module']).
node_meta(node_id, 'typescript', path, name, 'box') <-
  ts_def_row(path, _, name), node_id := concat(['ts:', path, '#', name]).

# Prolog: one module node per file and one node per predicate. xref gives a REAL
# caller, so the predicate-to-predicate arrows below are facts and not the
# co-occurrence guess the TypeScript plane has to avoid; the module node is what
# carries a chain THROUGH a file whose entry predicate calls private helpers.
node_meta(node_id, 'prolog', path, base, 'component') <-
  pl_file(path, _, base), node_id := concat(['pl:', path, '#module']).
node_meta(node_id, 'prolog', path, label_text, 'box') <-
  pl_def_row(path, name, arity),
  node_id := concat(['pl:', path, '#', name, '/', arity]),
  label_text := concat([name, '/', arity]).

# Shell: the script is the node. A shell script has no exported symbol to speak
# of, and pretending otherwise would be a granularity this plane cannot support.
node_meta(node_id, 'shell', 'scripts', base, 'note') <-
  sh_file(path, _, base), node_id := concat(['sh:', path]).

# CLI verbs, SQL tables, and the extractor's own surface.
node_meta(node_id, 'cli', 'verbs', verb, 'ellipse') <-
  cli_command(verb, _, _), node_id := concat(['cli:', verb]).
node_meta(node_id, 'sqlite', 'tables', table_name, 'cylinder') <-
  sql_table(table_name), node_id := concat(['sql:', table_name]).
node_meta('ex:bin', 'extractor', 'binary', 'sprefa-extract', 'box3d') <- seed(_, _).
node_meta(node_id, 'extractor', 'flags', flag_name, 'plaintext') <-
  extract_flag(flag_name), node_id := concat(['ex:flag:', flag_name]).
node_meta(node_id, 'extractor', 'records', record_kind, 'plaintext') <-
  extract_record(record_kind), node_id := concat(['ex:record:', record_kind]).

# ═════════════════════════════════════════════════════════════════════════════
# EDGES -- seven of them are BRIDGES and every bridge says why
# ═════════════════════════════════════════════════════════════════════════════

rel atlas_edge(from_id: text, to_id: text, edge_kind: text).

# ── within TypeScript: import, then residency ────────────────────────────────
# The importing FILE points at the imported SYMBOL, and the symbol points at its
# own module. Caller attribution inside the importing file is deliberately NOT
# drawn: phase-1 extraction gives call sites without an enclosing callable, and
# the file-scoped co-occurrence heuristic that flagship-callgraph.dl6 ports from
# v5 would multiply 136 defs by 1373 sites into tens of thousands of edges that
# are mostly false. A file-to-symbol edge is a fact; a def-to-site pair is a
# guess.
atlas_edge(from_id, to_id, 'import') <-
  ts_import_edge(from_path, to_path, symbol_name),
  from_id := concat(['ts:', from_path, '#module']),
  to_id := concat(['ts:', to_path, '#', symbol_name]).

atlas_edge(from_id, to_id, 'import_unnamed') <-
  ts_import_unresolved(from_path, to_path, _),
  from_id := concat(['ts:', from_path, '#module']),
  to_id := concat(['ts:', to_path, '#module']).

atlas_edge(from_id, to_id, 'resides') <-
  ts_crossing_symbol(path, symbol_name),
  from_id := concat(['ts:', path, '#', symbol_name]),
  to_id := concat(['ts:', path, '#module']).

# A CLI action function is a symbol node that NOTHING imports -- it is reached
# from the verb table, not from another module -- so `ts_crossing_symbol` does
# not cover it and without this clause the path from `bop run` is ONE HOP LONG.
# Measured: the first end-to-end run reported `LONGEST=1` with a 491-node graph,
# which is what a dangling entry looks like from the outside.
atlas_edge(from_id, to_id, 'resides') <-
  cli_command(_, action_name, path),
  ts_def_row(path, _, action_name),
  from_id := concat(['ts:', path, '#', action_name]),
  to_id := concat(['ts:', path, '#module']).

# ── within prolog: the real call edge, at both granularities ─────────────────
# Predicate to predicate is what xref actually reports and it is drawn as such.
# Module to predicate is what carries a chain THROUGH a file: an entry predicate
# reaching a cross-file call by way of private helpers is not one xref row, and
# the file is the smallest node that honestly stands for "somewhere in here".
atlas_edge(from_id, to_id, 'calls') <-
  pl_edge(from_path, from_pred, from_arity, to_path, to_pred, to_arity),
  from_id := concat(['pl:', from_path, '#', from_pred, '/', from_arity]),
  to_id := concat(['pl:', to_path, '#', to_pred, '/', to_arity]).

atlas_edge(from_id, to_id, 'calls') <-
  pl_edge(from_path, _, _, to_path, to_pred, to_arity),
  from_id := concat(['pl:', from_path, '#module']),
  to_id := concat(['pl:', to_path, '#', to_pred, '/', to_arity]).

atlas_edge(from_id, to_id, 'resides') <-
  pl_node(path, pred_name, arity),
  from_id := concat(['pl:', path, '#', pred_name, '/', arity]),
  to_id := concat(['pl:', path, '#module']).

atlas_edge(from_id, to_id, 'calls') <-
  marker_call_edge(path, callee, callee_arity),
  from_id := concat(['pl:', path, '#module']),
  to_id := concat(['pl:', path, '#', callee, '/', callee_arity]).

atlas_edge(from_id, to_id, 'bridge_dispatch') <-
  pl_dispatch_edge(from_path, to_path, pred_name, arity),
  from_id := concat(['pl:', from_path, '#module']),
  to_id := concat(['pl:', to_path, '#', pred_name, '/', arity]).

# ── BRIDGE 1: commander verb -> its action function ──────────────────────────
# WHY IT IS BESPOKE: the TypeScript extractor sees `"run"` as a string literal
# argument and `run` as an identifier argument, two unrelated call sites in a
# builder chain. That `.command("q")` and `.action(query)` name ONE command is
# knowledge of commander's API, and no extractor of TypeScript syntax can hold
# it. The awk state machine above is the smallest thing that does.
atlas_edge(from_id, to_id, 'bridge_verb') <-
  cli_command(verb, action_name, path),
  ts_def_row(path, _, action_name),
  from_id := concat(['cli:', verb]),
  to_id := concat(['ts:', path, '#', action_name]).

# ── BRIDGE 2: a TypeScript module -> the prolog predicate it spawns ──────────
# WHY IT IS BESPOKE: `v6/tsv2/serve/0_compile.ts` builds the string
# `compile_dl6('...', '...')` and hands it to `swipl -g`. To the TypeScript
# extractor that is a template literal. To prolog_xref that predicate has no
# caller at all -- nothing in the prolog corpus calls `compile_dl6/2`, which is
# exactly what an entry point looks like from inside its own language. The edge
# exists only in the gap, and the join that recovers it is: a snake_case token
# in a non-prolog file that a prolog file DEFINES, in a file that also mentions
# `swipl`.
rel spawns_swipl(path: text).
spawns_swipl(path) <- tool_mention(path, 'swipl').

# The join itself, shared by BRIDGE 2 and BRIDGE 3 and read once more by
# `pl_node` (a goal predicate is an entry point, so nothing inside prolog makes
# it a node and the residency arrow has to come from here).
rel goal_target(from_path: text, to_path: text, goal_name: text, arity: int).
goal_target(from_path, to_path, goal_name, arity) <-
  goal_mention(from_path, goal_name),
  spawns_swipl(from_path),
  pl_def_row(to_path, goal_name, arity).

atlas_edge(from_id, to_id, 'bridge_spawn') <-
  goal_target(from_path, to_path, goal_name, arity),
  ts_file(from_path, _, _),
  from_id := concat(['ts:', from_path, '#module']),
  to_id := concat(['pl:', to_path, '#', goal_name, '/', arity]).

# ── BRIDGE 3: a shell script -> the prolog predicate it invokes ──────────────
# WHY IT IS BESPOKE: same gap, other side. `compile_dl6.sh` writes
# `-g "compile_dl6('$INPUT', '$OUTPUT')"`; the shell has no notion of a prolog
# predicate and prolog_xref has no notion of a shell script. This is the brief's
# `script_invokes_swipl(script, goal)` joined against `pred_defined`, and it is
# the join that turns two token streams into one arrow.
atlas_edge(from_id, to_id, 'bridge_invoke') <-
  goal_target(from_path, to_path, goal_name, arity),
  sh_file(from_path, _, _),
  from_id := concat(['sh:', from_path]),
  to_id := concat(['pl:', to_path, '#', goal_name, '/', arity]).

# ── BRIDGE 4: a shell script -> the TypeScript entry it runs ─────────────────
# WHY IT IS BESPOKE: `node --experimental-transform-types "$SERVE"` names a file
# through a shell variable that was assigned three lines earlier from a path
# expression. Nothing extracts a process edge from that; what IS extractable is
# a path-shaped token, and joining its last segment against the TypeScript file
# set is what makes it an arrow. The `node` requirement keeps a script that
# merely NAMES a .ts file (a comment, a grep target) from claiming to run it.
rel spawns_node(path: text).
spawns_node(path) <- tool_mention(path, 'node').

atlas_edge(from_id, to_id, 'bridge_run') <-
  entry_mention(from_path, entry_base),
  spawns_node(from_path),
  sh_file(from_path, _, _),
  ts_file(to_path, _, entry_base),
  from_id := concat(['sh:', from_path]),
  to_id := concat(['ts:', to_path, '#module']).

# ── BRIDGE 5: the emitter -> the module it emits ─────────────────────────────
# WHY IT IS BESPOKE: the emitted module DOES NOT EXIST until the compiler runs,
# so no static reading of either language can attribute it to its producer. What
# both sides do carry is one identical run of text: emit_ts.pl holds
# `'// GENERATED by v6/prolog/compile (tsv2 emitter P3). Do not'` as a format
# string, and every emitted module carries it as its first comment line. Joining
# a prolog file that WRITES the marker to a TypeScript file that CARRIES it is
# the whole bridge, and it is the one edge in this atlas that crosses from a
# string literal in one language to a comment in another.
#
# The prolog END of the arrow is `header_lines/2`, and it is EXTRACTED, not
# named: the scanner's `markerpred` record reports the clause head the marker
# text sits inside, and `pl_def_row` supplies its arity. The first draft wrote a
# predicate name from memory instead; `edge_without_node` caught it on the first
# run and printed the invented name. That is the integrity rel earning its keep.
atlas_edge(from_id, to_id, 'bridge_emit') <-
  marker_mention(from_path, marker_token),
  pl_file(from_path, _, _),
  marker_pred(from_path, pred_name),
  pl_def_row(from_path, pred_name, arity),
  marker_mention(to_path, marker_token),
  gen_file(to_path, _, _),
  from_id := concat(['pl:', from_path, '#', pred_name, '/', arity]),
  to_id := concat(['ts:', to_path, '#module']).

# ── BRIDGE 6: everything that touches the fixed extractor ────────────────────
# WHY IT IS BESPOKE: `sprefa-extract` is reached through the env var
# `DL_EXTRACT_BIN`, whose value is set by a shell script and read by a template
# in a dl6 program. There is no call, no import, and no symbol -- the edge is an
# environment variable, and the only extractable trace of it is the variable's
# own name appearing in both places.
atlas_edge(from_id, 'ex:bin', 'bridge_extract') <-
  extract_mention(from_path, _), sh_file(from_path, _, _),
  from_id := concat(['sh:', from_path]).
atlas_edge(from_id, 'ex:bin', 'bridge_extract') <-
  extract_mention(from_path, _), ts_file(from_path, _, _),
  from_id := concat(['ts:', from_path, '#module']).

atlas_edge('ex:bin', to_id, 'flag') <-
  extract_flag(flag_name), to_id := concat(['ex:flag:', flag_name]).
atlas_edge('ex:bin', to_id, 'record') <-
  extract_record(record_kind), to_id := concat(['ex:record:', record_kind]).

# ── the SQL plane: the emitted module reaches its tables ─────────────────────
atlas_edge(from_id, to_id, 'statement') <-
  sql_touch(path, _, table_name),
  from_id := concat(['ts:', path, '#module']),
  to_id := concat(['sql:', table_name]).

# ── the drawn node set ───────────────────────────────────────────────────────
rel atlas_node(node_id: text, plane: text, container: text, label_text: text, shape_name: text).
atlas_node(node_id, plane, container, label_text, shape_name) <-
  node_meta(node_id, plane, container, label_text, shape_name), atlas_edge(node_id, _, _).
atlas_node(node_id, plane, container, label_text, shape_name) <-
  node_meta(node_id, plane, container, label_text, shape_name), atlas_edge(_, node_id, _).

# An edge whose endpoint has no `node_meta` row would draw a naked node with a
# raw id for a label. There is none, and this rel is how that is checked rather
# than assumed.
rel edge_without_node(node_id: text).
edge_without_node(from_id) <- atlas_edge(from_id, _, _), not(node_meta(from_id, _, _, _, _)).
edge_without_node(to_id) <- atlas_edge(_, to_id, _), not(node_meta(to_id, _, _, _, _)).

# ═════════════════════════════════════════════════════════════════════════════
# THE LONGEST PATH -- a recursive stratum, and it compiled first try
# ═════════════════════════════════════════════════════════════════════════════
#
# The brief expected a refusal here and banked a fallback. There was none: a
# recursive level rule carrying an incrementing hop count is an ordinary
# stratum, and the emitter's P3 reseed handles it. What the shape DOES need is a
# graph without cycles, since a cycle makes `hops` climb forever. Every edge
# family above is acyclic by construction:
#
#   import/resides  follow the ES module graph, which is a DAG by the loader's
#                   own rules and by this package's numeric-prefix convention
#   calls           acyclic ONLY because of the local-definition antijoin at
#                   `pl_edge`; without it, 5 false back edges (measured)
#   the bridges     each crosses a language once, in one direction
#   statement       terminal, nothing leaves a table node
#
# `prior < 32` is a TERMINATION FLOOR, not the answer: it exists so that a
# future edge family that reintroduces a cycle fails as a bounded wrong number
# rather than as a hung rail. `cycle_node` below reports whether the floor was
# ever near, and the document prints its count.
rel reach(from_id: text, to_id: text, hops: int).
reach(from_id, to_id, 1) <- atlas_edge(from_id, to_id, _).
reach(from_id, to_id, hops) <-
  reach(from_id, mid_id, prior), atlas_edge(mid_id, to_id, _), prior < 32, hops := prior + 1.

rel cycle_node(node_id: text).
cycle_node(node_id) <- reach(node_id, node_id, _).

# The entry is `bop run`, grounded in the fact that the verb exists rather than
# written as a constant: delete the `run` subcommand and the atlas has no entry.
rel atlas_entry(node_id: text).
atlas_entry('cli:run') <- cli_command('run', _, _).

# Longest distance FROM the entry, and longest chain ONWARD from each node. The
# aggregate clause and the base clause live in separate rels because an
# aggregate head cannot mix with a plain clause.
# REFUSAL HIT HERE, and the message was exact: writing this as one rule,
# `forward_positive(node_id, max(hops)) <- atlas_entry(entry_id),
# reach(entry_id, node_id, hops)`, is refused
# `unsupported_construct(aggregate_group_not_delta_local(...))`. An aggregate's
# GROUP columns have to be bound by EVERY positive body atom on its own, because
# the emitter seeds the aggregate's scope table once per body atom from that
# atom's delta rows alone (lower.pl:2165 says so and says why: an under-
# approximated scope would leave a stale aggregate row with no delta behind it).
# `atlas_entry` does not bind `node_id`, so the join gets its own rel and the
# aggregate reads a single atom.
rel entry_reach(node_id: text, hops: int).
entry_reach(node_id, hops) <- atlas_entry(entry_id), reach(entry_id, node_id, hops).

rel forward_positive(node_id: text, hops: int).
forward_positive(node_id, max(hops)) <- entry_reach(node_id, hops).

rel forward_depth(node_id: text, hops: int).
forward_depth(node_id, hops) <- forward_positive(node_id, hops).
forward_depth(node_id, 0) <- atlas_entry(node_id).

rel onward_positive(node_id: text, hops: int).
onward_positive(node_id, max(hops)) <- reach(node_id, _, hops).

# coalesce's output variable may appear only in the coalesce atom and the head
# (`coalesce_no_output` otherwise), so the zero floor for a sink is its own read.
rel onward_depth(node_id: text, hops: int).
onward_depth(node_id, hops) <- forward_depth(node_id, _), coalesce(onward_positive(node_id, hops), 0).

rel path_span(node_id: text, span: int).
path_span(node_id, span) <- forward_depth(node_id, forward), onward_depth(node_id, onward), span := forward + onward.

rel longest_span(span: int).
longest_span(max(span)) <- path_span(_, span).

# A node is ON a longest path exactly when the longest chain through it is the
# longest chain there is. If every depth holds one node, that set IS the path;
# where a depth holds several, the document prints them all rather than picking.
rel on_longest(node_id: text, depth_index: int).
on_longest(node_id, depth_index) <-
  path_span(node_id, span), longest_span(span), forward_depth(node_id, depth_index).

rel longest_level(depth_index: int, node_list: text).
longest_level(depth_index, group_concat(node_id, ' | ')) <- on_longest(node_id, depth_index).

# ── the CLI-to-SQLite chain, which is the question the atlas was built for ───
#
# THE RELS BELOW ARE NAMED `db_*` AND NOT `sqlite_*`, and that is a REAL ENGINE
# DEFECT written down rather than worked around. `lower.pl` names a table after
# its rel, and SQLite reserves every identifier beginning with `sqlite_`, so a
# rel called `sqlite_level` compiles CLEANLY through both doors and then dies at
# DDL time with `SQLITE_ERROR: object name reserved for internal use:
# sqlite_level`. Worse than the error: the served process does not survive it.
# The POST to /program returned curl code 000 with no body, because the failure
# escaped the load path and killed the server instead of answering 400.
#
# Two things are owed and neither is this lane's to fix: a load-time refusal for
# a rel name SQLite will not accept, and a load path that answers an error
# instead of exiting. Receipt: the server log line above, reproduced twice.
#
# The longest path above is whatever the graph's longest chain happens to be.
# This one is the specific claim: from `bop run` to a SQLite TABLE, through
# every language in between. It is the same machinery restricted at the far end,
# and it is reported separately because "the longest chain" and "the chain that
# reaches the database" are two different answers and only one of them is the
# headline.
rel db_table_node(node_id: text).
db_table_node(node_id) <- sql_table(table_name), node_id := concat(['sql:', table_name]).

# Both aggregates read a SINGLE atom, for the delta-local reason recorded at
# `forward_positive`: an aggregate's group columns must be bound by every
# positive body atom on its own, so the join gets its own rel first.
rel entry_reach_db(node_id: text, hops: int).
entry_reach_db(node_id, hops) <- entry_reach(node_id, hops), db_table_node(node_id).

rel db_span(span: int).
db_span(max(hops)) <- entry_reach_db(_, hops).

rel reach_db(node_id: text, hops: int).
reach_db(node_id, hops) <- reach(node_id, target_id, hops), db_table_node(target_id).

rel onward_to_db(node_id: text, hops: int).
onward_to_db(node_id, max(hops)) <- reach_db(node_id, hops).

rel on_db_path(node_id: text, depth_index: int).
on_db_path(node_id, depth_index) <-
  forward_depth(node_id, depth_index),
  onward_to_db(node_id, onward),
  db_span(span),
  total := depth_index + onward,
  total == span.
on_db_path(node_id, depth_index) <-
  forward_depth(node_id, depth_index), db_table_node(node_id), db_span(depth_index).

rel db_level(depth_index: int, node_list: text).
db_level(depth_index, group_concat(node_id, ' | ')) <- on_db_path(node_id, depth_index).

# ═════════════════════════════════════════════════════════════════════════════
# COUNTS -- everything the document states, derived rather than typed
# ═════════════════════════════════════════════════════════════════════════════

rel plane_node_total(plane: text, nodes: int).
plane_node_total(plane, count(node_id)) <- atlas_node(node_id, plane, _, _, _).

rel edge_plane(from_plane: text, to_plane: text, edge_kind: text, from_id: text, to_id: text).
edge_plane(from_plane, to_plane, edge_kind, from_id, to_id) <-
  atlas_edge(from_id, to_id, edge_kind),
  atlas_node(from_id, from_plane, _, _, _),
  atlas_node(to_id, to_plane, _, _, _).

rel plane_edge_total(from_plane: text, to_plane: text, edges: int).
plane_edge_total(from_plane, to_plane, count(from_id)) <- edge_plane(from_plane, to_plane, _, from_id, _).

rel kind_edge_total(edge_kind: text, edges: int).
kind_edge_total(edge_kind, count(from_id)) <- atlas_edge(from_id, _, edge_kind).

rel node_total(nodes: int).
node_total(count(node_id)) <- atlas_node(node_id, _, _, _, _).

rel edge_total(edges: int).
edge_total(count(from_id)) <- atlas_edge(from_id, _, _).

rel cycle_total(nodes: int).
cycle_total(count(node_id)) <- cycle_node(node_id).

rel reach_total(pairs: int).
reach_total(count(from_id)) <- reach(from_id, _, _).

rel container_node_total(container: text, nodes: int).
container_node_total(container, count(node_id)) <- atlas_node(node_id, _, container, _, _).

rel ts_fact_total(rows: int).
ts_fact_total(count(name)) <- ts_def_row(_, _, name).

rel pl_fact_total(rows: int).
pl_fact_total(count(callee)) <- pl_call_row(_, _, _, callee, _).

# ═════════════════════════════════════════════════════════════════════════════
# DOT RENDERING -- the output plane is ordinary dl6 data
# ═════════════════════════════════════════════════════════════════════════════
#
# This section used to say "rankdir=TB and never LR", on the grounds that a
# graph this wide read left to right is a mile of whitespace. The four extra
# views measured that claim and it is half right: LR does not widen the band,
# it ROTATES it (`flat_lr` unlevered is 3511 x 10253, a vertical strip), and
# under the same `ratio` lever both directions land on the same page. The
# numbers are in the table above `dot_line('head', 25, ...)`.

# ── THE FIVE VIEWS ───────────────────────────────────────────────────────────
#
# One row per drawing. Everything that differs between the five .dot files is
# in this rel and nowhere else: the layout direction, which grouping folds the
# node lines, the aspect lever, the label suffix and the two output paths. The
# node lines, the edge lines and every count are derived once and shared, which
# is exactly why the rail can assert that the five files hold the same graph.
rel variant(variant: text, rankdir: text, grouping: text, ratio_value: text, title_suffix: text, dot_path: text, svg_path: text).
variant('lang', 'TB', 'language', '0.4', '',
        'v6/DATAFLOW-ATLAS.dot', 'v6/DATAFLOW-ATLAS.svg') <- seed(_, _).
variant('flat_td', 'TB', 'none', '0.4', ' -- flat, no grouping, top to bottom',
        'v6/DATAFLOW-ATLAS-flat-td.dot', 'v6/DATAFLOW-ATLAS-flat-td.svg') <- seed(_, _).
variant('flat_lr', 'LR', 'none', '0.4', ' -- flat, no grouping, left to right',
        'v6/DATAFLOW-ATLAS-flat-lr.dot', 'v6/DATAFLOW-ATLAS-flat-lr.svg') <- seed(_, _).
variant('fs_td', 'TB', 'filesystem', '0.4', ' -- filesystem nesting, top to bottom',
        'v6/DATAFLOW-ATLAS-fs-td.dot', 'v6/DATAFLOW-ATLAS-fs-td.svg') <- seed(_, _).
variant('fs_lr', 'LR', 'filesystem', '0.4', ' -- filesystem nesting, left to right',
        'v6/DATAFLOW-ATLAS-fs-lr.dot', 'v6/DATAFLOW-ATLAS-fs-lr.svg') <- seed(_, _).

rel dot_line(variant: text, section: text, ordinal: int, line_text: text).

rel plane_label(plane: text, label_text: text).
plane_label('cli', 'cli (commander)') <- seed(_, _).
plane_label('typescript', 'typescript (sprefa-extract: call + type)') <- seed(_, _).
plane_label('prolog', 'prolog (library(prolog_xref))') <- seed(_, _).
plane_label('shell', 'shell + justfile (regex)') <- seed(_, _).
plane_label('sqlite', 'sqlite (regex over emitted SQL)') <- seed(_, _).
plane_label('extractor', 'sprefa-extract (fixed, read-only)') <- seed(_, _).

rel plane_colour(plane: text, colour_name: text).
plane_colour('cli', '#b45309') <- seed(_, _).
plane_colour('typescript', '#1d4ed8') <- seed(_, _).
plane_colour('prolog', '#15803d') <- seed(_, _).
plane_colour('shell', '#7c3aed') <- seed(_, _).
plane_colour('sqlite', '#be123c') <- seed(_, _).
plane_colour('extractor', '#0f766e') <- seed(_, _).

rel edge_style(edge_kind: text, style_text: text).
edge_style('import', 'color="#1d4ed8"') <- seed(_, _).
edge_style('import_unnamed', 'color="#1d4ed8",style=dashed') <- seed(_, _).
edge_style('resides', 'color="#93c5fd",arrowhead=none') <- seed(_, _).
edge_style('calls', 'color="#15803d"') <- seed(_, _).
edge_style('statement', 'color="#be123c"') <- seed(_, _).
edge_style('flag', 'color="#5eead4",arrowhead=none') <- seed(_, _).
edge_style('record', 'color="#5eead4",arrowhead=none') <- seed(_, _).
edge_style('bridge_verb', 'color="#b45309",penwidth=3') <- seed(_, _).
edge_style('bridge_spawn', 'color="#b45309",penwidth=3') <- seed(_, _).
edge_style('bridge_invoke', 'color="#b45309",penwidth=3') <- seed(_, _).
edge_style('bridge_run', 'color="#b45309",penwidth=3') <- seed(_, _).
edge_style('bridge_emit', 'color="#b45309",penwidth=3') <- seed(_, _).
edge_style('bridge_extract', 'color="#b45309",penwidth=3') <- seed(_, _).
edge_style('bridge_dispatch', 'color="#b45309",penwidth=3') <- seed(_, _).

# A node on a longest path is filled; every other node is plain. The highlight
# is derived, so it moves when the graph does.
#
# THE NODE LINE IS DERIVED ONCE AND SHARED BY ALL FIVE VIEWS. That is not a
# saving, it is the invariant the rail asserts: the five .dot files hold the
# SAME node id set and the same label, shape and highlight for every one of
# them, and differ only in rankdir and in which clusters the lines are nested
# inside. `node_id` rides in the rel so the filesystem view can join a line to
# the file it belongs to; the language view still folds on (plane, container).
rel node_line(node_id: text, plane: text, container: text, line_text: text).
node_line(node_id, plane, container, line_text) <-
  atlas_node(node_id, plane, container, label_text, shape_name),
  on_longest(node_id, _),
  line_text := concat(['    "', node_id, '" [label="', label_text, '",shape=', shape_name, ',style=filled,fillcolor="#fde68a"];']).
node_line(node_id, plane, container, line_text) <-
  atlas_node(node_id, plane, container, label_text, shape_name),
  not(on_longest(node_id, _)),
  line_text := concat(['    "', node_id, '" [label="', label_text, '",shape=', shape_name, '];']).

# Ordered by the line text itself, so the fold is deterministic without a
# separate ordinal column and without leaning on the engine's row order.
rel container_body(plane: text, container: text, body_text: text).
container_body(plane, container, group_concat(line_text, '\n')) <- node_line(_, plane, container, line_text).

rel container_fragment(plane: text, container: text, fragment: text).
container_fragment(plane, container, fragment) <-
  container_body(plane, container, body_text),
  container_id := norm(container),
  fragment := concat(['  subgraph cluster_', container_id, ' {\n    label="', container, '";\n    style=dotted;\n', body_text, '\n  }']).

rel plane_body(plane: text, body_text: text).
plane_body(plane, group_concat(fragment, '\n')) <- container_fragment(plane, _, fragment).

rel plane_fragment(plane: text, fragment: text).
plane_fragment(plane, fragment) <-
  plane_body(plane, body_text), plane_label(plane, label_text), plane_colour(plane, colour_name),
  fragment := concat([' subgraph cluster_plane_', plane, ' {\n  label="', label_text,
                      '";\n  color="', colour_name, '";\n  penwidth=2;\n', body_text, '\n }']).

rel graph_body(body_text: text).
graph_body(group_concat(fragment, '\n')) <- plane_fragment(_, fragment).

# ── GROUPING 2 of 3: none. The raw graph, no cluster of any kind ─────────────
#
# The same lines, folded once. A cluster in graphviz is a layout constraint as
# much as a box, so this is the only view where dot is free to rank a node
# purely by its edges, and it is the view that answers "what does the dataflow
# look like when nothing about the source tree is allowed to shape it".
rel flat_body(body_text: text).
flat_body(group_concat(line_text, '\n')) <- node_line(_, _, _, line_text).

# ── GROUPING 3 of 3: the filesystem, nested ──────────────────────────────────
#
# One big exploded file: the directory tree becomes nested graphviz clusters,
# `v6` containing `tsv2` containing `serve` containing `1_hosts.ts` containing
# the symbols that file defines. Every box in it is derived from the paths the
# facts already carry -- `node_meta`'s container for TypeScript and prolog is
# the file path, and the shell plane's node id is `sh:` plus the path.
#
# THE NESTING IS FOUR LEVELS DEEP AND WRITTEN OUT FOUR TIMES, on purpose. The
# natural spelling is one recursive rule -- a directory's body is the fold of
# its children, where a child is a file cluster OR a deeper directory cluster --
# and that is a group_concat whose input depends on its own output: a RECURSIVE
# AGGREGATE, which no stratification admits. So the fold is unrolled by depth,
# deepest first, each level an ordinary rel reading the level below. The corpus
# reaches depth 4 (`v6/prolog/compile/scripts`), and `fs_dir_too_deep` below
# turns a fifth level into a rail failure rather than a silently dropped
# cluster -- the same choice `prior < 32` makes in the reachability stratum.

# Where a node lives. TypeScript and prolog carry the file path as their
# container already; the shell plane's container is a bucket, so its path comes
# back through the node id the way `db_table_node` recovers a table node.
rel sh_node(node_id: text, path: text).
sh_node(node_id, path) <- sh_file(path, _, _), node_id := concat(['sh:', path]).

rel node_file(node_id: text, path: text).
node_file(node_id, path) <- atlas_node(node_id, 'typescript', path, _, _).
node_file(node_id, path) <- atlas_node(node_id, 'prolog', path, _, _).
node_file(node_id, path) <- atlas_node(node_id, 'shell', _, _, _), sh_node(node_id, path).

# The CLI verbs, the SQLite tables and the extractor's own surface name no file
# in this tree, and inventing one for them would be a lie in a picture whose
# whole claim is that the boxes come from the paths. They get their own
# top-level dashed clusters beside the directory tree.
rel node_unfiled(node_id: text, bucket: text).
node_unfiled(node_id, container) <- atlas_node(node_id, 'cli', container, _, _).
node_unfiled(node_id, container) <- atlas_node(node_id, 'sqlite', container, _, _).
node_unfiled(node_id, container) <- atlas_node(node_id, 'extractor', container, _, _).

# INTEGRITY, the filesystem half. A drawn node that lands in neither the
# directory tree nor a bucket would silently vanish from two of the five views
# while the other three still drew it, so the rail refuses on it.
rel fs_placed(node_id: text).
fs_placed(node_id) <- node_file(node_id, path), file_dir(path, _, _).
fs_placed(node_id) <- node_unfiled(node_id, _).

rel fs_unplaced(node_id: text).
fs_unplaced(node_id) <- atlas_node(node_id, _, _, _, _), not(fs_placed(node_id)).

rel fs_dir_too_deep(dir_path: text, depth: int).
fs_dir_too_deep(dir_path, depth) <- dir_meta(dir_path, depth, _, _), depth > 4.

rel fs_node_line(path: text, line_text: text).
fs_node_line(path, line_text) <- node_file(node_id, path), node_line(node_id, _, _, line_text).

rel fs_file_body(path: text, body_text: text).
fs_file_body(path, group_concat(line_text, '\n')) <- fs_node_line(path, line_text).

rel fs_file_fragment(path: text, dir_path: text, dir_depth: int, fragment: text).
fs_file_fragment(path, dir_path, dir_depth, fragment) <-
  fs_file_body(path, body_text), file_dir(path, dir_depth, dir_path),
  drawn_file(path, base, plane), plane_colour(plane, colour_name),
  fragment := concat(['   subgraph cluster_fsfile_', norm(path), ' {\n   label="', base,
                      '";\n   style=dotted;\n   color="', colour_name, '";\n', body_text, '\n   }']).

# Depth 4, the deepest directory level the corpus reaches. It folds files only:
# a depth-5 directory would have to appear here and `fs_dir_too_deep` refuses
# the run before it can be dropped.
rel fs_body_d4(dir_path: text, body_text: text).
fs_body_d4(dir_path, group_concat(fragment, '\n')) <- fs_file_fragment(_, dir_path, 4, fragment).
rel fs_frag_d4(dir_path: text, parent_path: text, fragment: text).
fs_frag_d4(dir_path, parent_path, fragment) <-
  fs_body_d4(dir_path, body_text), dir_meta(dir_path, 4, parent_path, segment),
  fragment := concat(['  subgraph cluster_fsdir_', norm(dir_path), ' {\n  label="', segment,
                      '/";\n  style=rounded;\n  penwidth=2;\n', body_text, '\n  }']).

rel fs_item_d3(dir_path: text, fragment: text).
fs_item_d3(dir_path, fragment) <- fs_file_fragment(_, dir_path, 3, fragment).
fs_item_d3(dir_path, fragment) <- fs_frag_d4(_, dir_path, fragment).
rel fs_body_d3(dir_path: text, body_text: text).
fs_body_d3(dir_path, group_concat(fragment, '\n')) <- fs_item_d3(dir_path, fragment).
rel fs_frag_d3(dir_path: text, parent_path: text, fragment: text).
fs_frag_d3(dir_path, parent_path, fragment) <-
  fs_body_d3(dir_path, body_text), dir_meta(dir_path, 3, parent_path, segment),
  fragment := concat(['  subgraph cluster_fsdir_', norm(dir_path), ' {\n  label="', segment,
                      '/";\n  style=rounded;\n  penwidth=2;\n', body_text, '\n  }']).

rel fs_item_d2(dir_path: text, fragment: text).
fs_item_d2(dir_path, fragment) <- fs_file_fragment(_, dir_path, 2, fragment).
fs_item_d2(dir_path, fragment) <- fs_frag_d3(_, dir_path, fragment).
rel fs_body_d2(dir_path: text, body_text: text).
fs_body_d2(dir_path, group_concat(fragment, '\n')) <- fs_item_d2(dir_path, fragment).
rel fs_frag_d2(dir_path: text, parent_path: text, fragment: text).
fs_frag_d2(dir_path, parent_path, fragment) <-
  fs_body_d2(dir_path, body_text), dir_meta(dir_path, 2, parent_path, segment),
  fragment := concat(['  subgraph cluster_fsdir_', norm(dir_path), ' {\n  label="', segment,
                      '/";\n  style=rounded;\n  penwidth=2;\n', body_text, '\n  }']).

rel fs_item_d1(dir_path: text, fragment: text).
fs_item_d1(dir_path, fragment) <- fs_file_fragment(_, dir_path, 1, fragment).
fs_item_d1(dir_path, fragment) <- fs_frag_d2(_, dir_path, fragment).
rel fs_body_d1(dir_path: text, body_text: text).
fs_body_d1(dir_path, group_concat(fragment, '\n')) <- fs_item_d1(dir_path, fragment).
rel fs_frag_d1(dir_path: text, parent_path: text, fragment: text).
fs_frag_d1(dir_path, parent_path, fragment) <-
  fs_body_d1(dir_path, body_text), dir_meta(dir_path, 1, parent_path, segment),
  fragment := concat([' subgraph cluster_fsdir_', norm(dir_path), ' {\n label="', segment,
                      '/";\n color="#334155";\n penwidth=3;\n', body_text, '\n }']).

rel fs_bucket_line(bucket: text, line_text: text).
fs_bucket_line(bucket, line_text) <- node_unfiled(node_id, bucket), node_line(node_id, _, _, line_text).
rel fs_bucket_body(bucket: text, body_text: text).
fs_bucket_body(bucket, group_concat(line_text, '\n')) <- fs_bucket_line(bucket, line_text).
rel fs_bucket_fragment(bucket: text, fragment: text).
fs_bucket_fragment(bucket, fragment) <-
  fs_bucket_body(bucket, body_text),
  fragment := concat([' subgraph cluster_fsbucket_', norm(bucket), ' {\n label="(no file) ', bucket,
                      '";\n style=dashed;\n color="#64748b";\n', body_text, '\n }']).

rel fs_top_fragment(fragment: text).
fs_top_fragment(fragment) <- fs_frag_d1(_, _, fragment).
fs_top_fragment(fragment) <- fs_bucket_fragment(_, fragment).

rel fs_body(body_text: text).
fs_body(group_concat(fragment, '\n')) <- fs_top_fragment(fragment).

# ── how many boxes each grouping draws, counted rather than typed ────────────
#
# One id per emitted `subgraph cluster_`, so the number in the document is the
# number in the file. The flat grouping contributes NO rows at all, which is
# why the per-variant read below goes through `coalesce`: a `count` aggregate
# over an empty rel yields no row, never a zero.
#
# EVERY CLAUSE READS THE SOURCE OF A CLUSTER, NEVER THE FOLD THAT EMITS IT, and
# that is a compile-cost fix with a measured receipt. Counting `fs_frag_d1..d4`
# taps the nesting fold at four separate depths, and `3_clock_check.pl`'s
# `clock_path_conflict` enumerates every simple path between every pair of
# refs: four extra routes through a sixteen-rel chain took the compile from 30s
# to 9m40s at an 8GB stack (the served compiler runs at 1GB and simply died).
# Read off the sources instead and the counts are the same numbers -- a
# directory cluster is emitted exactly when some drawn node's file sits under
# it, which is what these clauses say -- for a fraction of the path count.
rel grouping_cluster(grouping: text, cluster_id: text).
grouping_cluster('language', cluster_id) <- atlas_node(_, plane, container, _, _), cluster_id := concat(['file:', plane, ':', container]).
grouping_cluster('language', cluster_id) <- atlas_node(_, plane, _, _, _), cluster_id := concat(['plane:', plane]).
grouping_cluster('filesystem', cluster_id) <- node_file(_, path), file_dir(path, _, _), cluster_id := concat(['file:', path]).
grouping_cluster('filesystem', cluster_id) <- node_file(_, path), path_dir(path, _, dir_path, _, _), cluster_id := concat(['dir:', dir_path]).
grouping_cluster('filesystem', cluster_id) <- node_unfiled(_, bucket), cluster_id := concat(['bucket:', bucket]).

rel grouping_cluster_total(grouping: text, clusters: int).
grouping_cluster_total(grouping, count(cluster_id)) <- grouping_cluster(grouping, cluster_id).

rel variant_clusters(variant: text, clusters: int).
variant_clusters(variant, clusters) <-
  variant(variant, _, grouping, _, _, _, _), coalesce(grouping_cluster_total(grouping, clusters), 0).

rel edge_line(line_text: text).
edge_line(line_text) <-
  atlas_edge(from_id, to_id, edge_kind), edge_style(edge_kind, style_text),
  line_text := concat(['  "', from_id, '" -> "', to_id, '" [', style_text, '];']).

rel edges_text(body_text: text).
edges_text(group_concat(line_text, '\n')) <- edge_line(line_text).

dot_line(variant, 'head', 10, 'digraph dataflow_atlas {') <- variant(variant, _, _, _, _, _, _).
dot_line(variant, 'head', 20, line_text) <-
  variant(variant, rankdir, _, _, _, _, _), line_text := concat(['  rankdir=', rankdir, ';']).
# `ratio` is here because TB alone did not deliver what TB is for. MEASURED on
# this graph: plain TB renders 27303 x 1900pt, a 14:1 horizontal band, because
# 421 nodes over 26 ranks puts 20 to 40 nodes side by side on every rank and no
# layout choice makes that narrow. Four levers were tried and their numbers are
# the reason for this one line: `ratio=compress` with `size` only downscales
# (2880 x 200, same 14:1); `unflatten -l 8 -c 12` reaches 24358 x 2325 and then
# IGNORES ratio; dropping the per-file sub-clusters reaches 14913 x 1756 and
# costs the file grouping, which is information the picture is for. `ratio=0.4`
# gives 27303 x 10945, a 2.5:1 canvas: the same drawing with the ranks given
# room, which is a page a reader scrolls in two directions instead of one
# endless band.
#
# THE OTHER FOUR VIEWS KEEP THE SAME 0.4, and that is a measurement rather
# than a default. Each drawing was rendered at five settings of the lever
# (v6/tsv2/scripts/atlas.sh's sabotage-and-measurement notes hold the command);
# the canvas graphviz chose, in points:
#
#              no ratio         0.2            0.4             0.7            1.0
#   flat_td  15207 x  1701  15207 x  3071  15207 x  6111  15207 x 10671  15207 x 15230
#   flat_lr   3511 x 10253  50458 x 10283  25233 x 10265  14422 x 10238  10098 x 10304
#   fs_td    27759 x  2064  27759 x  5581  27759 x 11131  27759 x 19457  27759 x 27782
#   fs_lr     3937 x 15802  78863 x 15802  39436 x 15802  22538 x 15802  15779 x 15802
#
# Two things fall out of that table. The lever stretches whichever dimension
# the layout did NOT fix -- height under TB, width under LR -- so the untouched
# column is the layout's own answer and the moving one is the page. And LR does
# not fix the band problem, it rotates it: `flat_lr` unlevered is 3511 x 10253,
# a 1:2.9 vertical strip, exactly as unreadable as TB's 8.9:1 horizontal one.
#
# 0.4 is kept for all five because it is the only value that gives all five the
# SAME page: 2.5:1, within half a percent of each other (0.401, 0.402, 0.407,
# 0.401, 0.401). That is what makes the five drawings comparable -- what a
# reader sees differing between two of them is the grouping and the rankdir,
# never the lever. The alternative worth knowing about is `fs_lr` at 0.7
# (22538 x 15802), which halves the widest canvas at the cost of that
# comparability.
dot_line(variant, 'head', 25, line_text) <-
  variant(variant, _, _, ratio_value, _, _, _), line_text := concat(['  ratio=', ratio_value, ';']).
dot_line(variant, 'head', 30, '  compound=true;') <- variant(variant, _, _, _, _, _, _).
dot_line(variant, 'head', 40, '  newrank=true;') <- variant(variant, _, _, _, _, _, _).
dot_line(variant, 'head', 50, '  ranksep=0.7;') <- variant(variant, _, _, _, _, _, _).
dot_line(variant, 'head', 60, '  nodesep=0.25;') <- variant(variant, _, _, _, _, _, _).
dot_line(variant, 'head', 70, '  graph [fontname="Helvetica",fontsize=14,labelloc=t];') <- variant(variant, _, _, _, _, _, _).
dot_line(variant, 'head', 80, '  node [fontname="Helvetica",fontsize=10,margin="0.06,0.03"];') <- variant(variant, _, _, _, _, _, _).
dot_line(variant, 'head', 90, '  edge [fontname="Helvetica",fontsize=8];') <- variant(variant, _, _, _, _, _, _).
# The language view's suffix is the EMPTY STRING, which is what keeps
# v6/DATAFLOW-ATLAS.dot byte-identical to the file this change found on disk.
dot_line(variant, 'head', 100, line_text) <-
  variant(variant, _, _, _, title_suffix, _, _),
  node_total(nodes), edge_total(edges), longest_span(span),
  line_text := concat(['  label="sprefa v6 dataflow atlas -- ', nodes, ' nodes, ', edges,
                       ' edges, longest path from bop run = ', span, ' hops (GENERATED, do not edit)',
                       title_suffix, '";']).

# The grouping word is a CONSTANT IN ARGUMENT POSITION, never a guard, for the
# reason recorded at the top of this file: a guard over a probe output variable
# is refused, and this program keeps one spelling for every filter.
dot_line(variant, 'body', 10, body_text) <- variant(variant, _, 'language', _, _, _, _), graph_body(body_text).
dot_line(variant, 'body', 10, body_text) <- variant(variant, _, 'none', _, _, _, _), flat_body(body_text).
dot_line(variant, 'body', 10, body_text) <- variant(variant, _, 'filesystem', _, _, _, _), fs_body(body_text).
dot_line(variant, 'edges', 10, body_text) <- variant(variant, _, _, _, _, _, _), edges_text(body_text).
dot_line(variant, 'tail', 10, '}') <- variant(variant, _, _, _, _, _, _).

rel section_text(variant: text, section: text, body_text: text).
section_text(variant, section, group_concat(line_text, '\n', ordinal)) <- dot_line(variant, section, ordinal, line_text).

rel dot_document(variant: text, document: text).
dot_document(variant, document) <-
  section_text(variant, 'head', head_text), section_text(variant, 'body', body_text),
  section_text(variant, 'edges', edges_body), section_text(variant, 'tail', tail_text),
  document := concat([head_text, '\n', body_text, '\n', edges_body, '\n', tail_text, '\n']).

# ═════════════════════════════════════════════════════════════════════════════
# THE MARKDOWN COMPANION
# ═════════════════════════════════════════════════════════════════════════════

rel md_line(section: text, ordinal: int, line_text: text).

md_line('doc', 10, '# The v6 dataflow atlas') <- seed(_, _).
md_line('doc', 20,
  'GENERATED by `just atlas` (`v6/tsv2/scripts/atlas.sh`). Do not edit: the next run overwrites it, byte for byte. The default graph is `v6/DATAFLOW-ATLAS.svg`, rendered by graphviz from `v6/DATAFLOW-ATLAS.dot`, which `v6/dl/fixtures/dataflow-atlas.dl6` assembles from extracted facts. Four more drawings of the same graph sit beside it, listed below.') <- seed(_, _).
md_line('doc', 30, line_text) <- node_total(nodes), edge_total(edges), reach_total(pairs), cycle_total(cycles),
  line_text := concat(['**', nodes, ' nodes, ', edges, ' edges.** The reachability stratum settled at ',
                       pairs, ' (from, to, hops) triples with ', cycles,
                       ' node(s) reaching themselves; zero is what makes the longest path a number rather than a bound.']).
md_line('doc', 40, '') <- seed(_, _).

md_line('doc', 41, '## The five views') <- seed(_, _).
md_line('doc', 42, '') <- seed(_, _).
md_line('doc', 43,
  'ONE graph, five drawings. The node set, the edge set, the labels, the shapes and the longest-path highlight are derived once and shared, so the five `.dot` files differ only in `rankdir` and in which clusters the node lines are nested inside. `just atlas` asserts exactly that: the same node id set in all five files, every node in the two filesystem views inside the cluster chain its own path spells, and every `.dot` byte-stable across two runs. Canvas is what graphviz chose, read back out of the rendered SVG; clusters are counted from the fragments the program emitted. All five carry `ratio=0.4`, which is the one setting that gives them the same 2.5:1 page, so what differs between two views is the grouping and the direction rather than the lever (the five-setting measurement is in the program header).') <- seed(_, _).
md_line('doc', 44, '') <- seed(_, _).
md_line('doc', 45, '| view | file | rankdir | grouping | clusters | canvas pt | what it is for |') <- seed(_, _).
md_line('doc', 46, '|---|---|---|---|---|---|---|') <- seed(_, _).

rel variant_order(variant: text, ordinal: int).
variant_order('lang', 1) <- seed(_, _).
variant_order('flat_td', 2) <- seed(_, _).
variant_order('flat_lr', 3) <- seed(_, _).
variant_order('fs_td', 4) <- seed(_, _).
variant_order('fs_lr', 5) <- seed(_, _).

rel variant_purpose(variant: text, purpose_text: text).
variant_purpose('lang', 'the default: which LANGUAGE each box belongs to, with the file it lives in as an inner box, so a bridge arrow is visibly a line between two coloured regions') <- seed(_, _).
variant_purpose('flat_td', 'the raw graph with nothing imposed on it: ranks come only from edges, so the layers dot finds are the layers the dataflow actually has') <- seed(_, _).
variant_purpose('flat_lr', 'the same raw graph read as a pipeline: entry on the left, SQLite tables on the right, one rank per hop of the longest path') <- seed(_, _).
variant_purpose('fs_td', 'the source tree as one exploded file: nested directory boxes down to the file, so an arrow leaving a box is a dependency leaving a directory') <- seed(_, _).
variant_purpose('fs_lr', 'the same nesting read left to right, which is the shape that shows the repository laid out as a flow rather than as a tree') <- seed(_, _).

rel variant_row(ordinal: int, line_text: text).
variant_row(ordinal, line_text) <-
  variant(variant, rankdir, grouping, _, _, dot_path, _),
  variant_order(variant, ordinal), variant_purpose(variant, purpose_text),
  variant_clusters(variant, clusters), variant_canvas(variant, canvas_width, canvas_height),
  line_text := concat(['| `', variant, '` | `', dot_path, '` | ', rankdir, ' | ', grouping, ' | ',
                       clusters, ' | ', canvas_width, ' x ', canvas_height, ' | ', purpose_text, ' |']).
rel variant_rows(body_text: text).
variant_rows(group_concat(line_text, '\n', ordinal)) <- variant_row(ordinal, line_text).
md_line('doc', 47, body_text) <- variant_rows(body_text).

md_line('doc', 48, '') <- seed(_, _).
md_line('doc', 49,
  'The filesystem nesting is unrolled to four levels (`v6/prolog/compile/scripts` is the deepest directory the corpus reaches) because the natural spelling -- a directory folds its children, where a child may be another directory -- is a `group_concat` reading its own output, and a recursive aggregate has no stratification. A fifth level is a rail FAILURE via `fs_dir_too_deep`, never a silently dropped cluster. The directory split itself is done in the fact host: this language has no string split, and the probe that proved it found something worse than a refusal -- see the note above `file_dirs` in the program.') <- seed(_, _).

md_line('doc', 50, '') <- seed(_, _).
md_line('doc', 51, '## Nodes per plane') <- seed(_, _).
md_line('doc', 60, '') <- seed(_, _).
md_line('doc', 70, '| plane | nodes |') <- seed(_, _).
md_line('doc', 80, '|---|---|') <- seed(_, _).

rel plane_row(line_text: text).
plane_row(line_text) <- plane_node_total(plane, nodes),
  line_text := concat(['| `', plane, '` | ', nodes, ' |']).
rel plane_rows(body_text: text).
plane_rows(group_concat(line_text, '\n')) <- plane_row(line_text).
md_line('doc', 90, body_text) <- plane_rows(body_text).

md_line('doc', 100, '') <- seed(_, _).
md_line('doc', 110, '## Edges per kind') <- seed(_, _).
md_line('doc', 120, '') <- seed(_, _).
md_line('doc', 130, '| edge kind | edges | bespoke bridge |') <- seed(_, _).
md_line('doc', 140, '|---|---|---|') <- seed(_, _).

rel bridge_reason(edge_kind: text, reason_text: text).
bridge_reason('bridge_verb', 'commander pairs a subcommand STRING with an action IDENTIFIER two statements apart; no TypeScript extractor holds commander API knowledge') <- seed(_, _).
bridge_reason('bridge_spawn', 'a TS template literal becomes a prolog goal at `swipl -g`; prolog_xref sees the predicate with no caller, the TS extractor sees a string') <- seed(_, _).
bridge_reason('bridge_invoke', 'the same gap from the shell side: a shell has no notion of a predicate and xref has no notion of a script') <- seed(_, _).
bridge_reason('bridge_run', 'a `node "$SERVE"` invocation names a file through a shell variable; the path token joined against the TS file set is the only extractable trace') <- seed(_, _).
bridge_reason('bridge_emit', 'the emitted module does not exist until the compiler runs; the join is the generated-header text, a string literal in prolog and a comment in TypeScript') <- seed(_, _).
bridge_reason('bridge_extract', 'the fixed extractor is reached through the env var DL_EXTRACT_BIN: no call, no import, no symbol') <- seed(_, _).
bridge_reason('bridge_dispatch', 'a gap INSIDE one language: compile.pl passes `emit_ts:emit_program` as an ARGUMENT and runs it through call/6, so xref reports no call at all -- the backend neutrality the compiler is designed for is what hides its most important edge') <- seed(_, _).

rel kind_row(line_text: text).
kind_row(line_text) <- kind_edge_total(edge_kind, edges), bridge_reason(edge_kind, reason_text),
  line_text := concat(['| `', edge_kind, '` | ', edges, ' | ', reason_text, ' |']).
kind_row(line_text) <- kind_edge_total(edge_kind, edges), not(bridge_reason(edge_kind, _)),
  line_text := concat(['| `', edge_kind, '` | ', edges, ' | auto-extracted, no bridge |']).
bridge_reason('import_unnamed', 'EXTRACTOR GAP, not a bridge: the imported name has no node record in the target file. `export const X: IX = { ... }` -- the interface-bound namespace object CLAUDE.md mandates as the default -- emits no node, so the edge lands on the module') <- seed(_, _).
rel kind_rows(body_text: text).
kind_rows(group_concat(line_text, '\n')) <- kind_row(line_text).
md_line('doc', 150, body_text) <- kind_rows(body_text).

md_line('doc', 160, '') <- seed(_, _).
md_line('doc', 170, '## Edges between planes') <- seed(_, _).
md_line('doc', 180, '') <- seed(_, _).
md_line('doc', 190, '| from plane | to plane | edges |') <- seed(_, _).
md_line('doc', 200, '|---|---|---|') <- seed(_, _).

rel crossing_row(line_text: text).
crossing_row(line_text) <- plane_edge_total(from_plane, to_plane, edges),
  line_text := concat(['| `', from_plane, '` | `', to_plane, '` | ', edges, ' |']).
rel crossing_rows(body_text: text).
crossing_rows(group_concat(line_text, '\n')) <- crossing_row(line_text).
md_line('doc', 210, body_text) <- crossing_rows(body_text).

md_line('doc', 220, '') <- seed(_, _).
md_line('doc', 230, '## The longest path, hop by hop') <- seed(_, _).
md_line('doc', 240, '') <- seed(_, _).
md_line('doc', 250, line_text) <- longest_span(span),
  line_text := concat(['`bop run` to the deepest node the graph reaches is **', span,
                       ' hops**. A row below is one hop; where a hop holds more than one node, every one of them lies on some longest chain and the atlas does not pick between them.']).
md_line('doc', 260, '') <- seed(_, _).
md_line('doc', 270, '| hop | node(s) |') <- seed(_, _).
md_line('doc', 280, '|---|---|') <- seed(_, _).

rel hop_row(depth_index: int, line_text: text).
hop_row(depth_index, line_text) <- longest_level(depth_index, node_list),
  line_text := concat(['| ', depth_index, ' | `', node_list, '` |']).
rel hop_rows(body_text: text).
hop_rows(group_concat(line_text, '\n', depth_index)) <- hop_row(depth_index, line_text).
md_line('doc', 290, body_text) <- hop_rows(body_text).

md_line('doc', 292, '') <- seed(_, _).
md_line('doc', 293, '## `bop run` to an executed SQLite statement') <- seed(_, _).
md_line('doc', 294, '') <- seed(_, _).
md_line('doc', 295, line_text) <- db_span(span),
  line_text := concat(['The chain the atlas was built to answer: **', span,
                       ' hops** from the `run` subcommand to a table the emitted SQL touches, crossing commander, TypeScript, prolog and back into TypeScript before it reaches SQLite.']).
md_line('doc', 296, '') <- seed(_, _).
md_line('doc', 297, '| hop | node(s) |') <- seed(_, _).
md_line('doc', 298, '|---|---|') <- seed(_, _).

rel db_row(depth_index: int, line_text: text).
db_row(depth_index, line_text) <- db_level(depth_index, node_list),
  line_text := concat(['| ', depth_index, ' | `', node_list, '` |']).
rel db_rows(body_text: text).
db_rows(group_concat(line_text, '\n', depth_index)) <- db_row(depth_index, line_text).
md_line('doc', 299, body_text) <- db_rows(body_text).

md_line('doc', 300, '') <- seed(_, _).
md_line('doc', 310, '## Fact volume behind the picture') <- seed(_, _).
md_line('doc', 320, '') <- seed(_, _).
md_line('doc', 330, line_text) <- ts_fact_total(ts_rows), pl_fact_total(pl_rows),
  line_text := concat(['The drawn graph is a projection. Underneath it the program holds ', ts_rows,
                       ' TypeScript definition rows and ', pl_rows,
                       ' prolog call rows, plus every call site, import specifier, shell token and SQL statement row the four hosts returned. Nothing is drawn that no fact supports, and the counts above are derived by `count` aggregates in the same file, never typed in.']).

rel md_section_text(section: text, body_text: text).
md_section_text(section, group_concat(line_text, '\n', ordinal)) <- md_line(section, ordinal, line_text).

rel md_document(document: text).
md_document(document) <- md_section_text('doc', body_text), document := concat([body_text, '\n']).

# ═════════════════════════════════════════════════════════════════════════════
# THE OUTPUT EFFECTS
# ═════════════════════════════════════════════════════════════════════════════

# THE WRITE RETURNS A DIGEST, not the word `written`, and that is a defect fix
# rather than a flourish. A host's answer is cached against its DEMAND ROW
# (ruling salt_minting = content_addressed), and `render_dot('...dot',
# '...svg')` has two CONSTANT columns: it is one demand row for the life of the
# db, so it runs EXACTLY ONCE, on whatever the .dot happened to contain at that
# tick. Measured on the first end-to-end run: a 491-node .dot beside a 14KB SVG
# of a handful of boxes, because the render fired on an early partial document
# and its demand never changed again.
#
# Returning `shasum` of what was written turns the write receipt into a
# CONTENT-DERIVED value, and feeding it to the render as a third column makes
# the render's demand row change whenever the document does. The dependency is
# then real in both directions: the render cannot run before the write (it needs
# the digest), and it must run again after every write that changes anything.
sh write_file(path: text, document: text) -> (status: text) =
  `printf '%s' "$document" > "$path"; shasum -a 256 "$path" | cut -c1-16`.

# THE RENDER RETURNS THE RENDERED FILE'S DIGEST BESIDE ITS STATUS, for the
# reason the write does: `svg_size` below has to read a file this host writes,
# and a demand row of constant columns would let it read whatever happened to
# be on disk at the tick it first fired. With the digest in the answer the read
# cannot be demanded before the render produced it, and it is re-demanded every
# time the drawing changes.
#
# PER-RENDER BUDGET (timeout-gun lane, 2026-07-31). graphviz is a third-party
# layout engine handed a graph this program derives, so its cost is a function
# of data the program can change: a future edge family that makes layout
# explode would hang the render, and from outside the rail a hung `dot` and a
# hung server read identically. `$ATLAS_RUN_CAPPED` is v6/tools/run-capped.sh
# in command form (fork + setpgrp + SIGALRM -> SIGKILL the group, exit 124);
# `$ATLAS_DOT_BUDGET_S` is atlas.sh's default of 180s. Both arrive as
# ENVIRONMENT names, like DL_EXTRACT_BIN and ATLAS_XREF_FACTS above, because
# fillTemplate escapes `$` in any value it splices and a path arriving as a rel
# column could never expand. A killed render writes no .svg, so the rail's own
# "no .svg was rendered" check is what the caller sees.
sh render_dot(dot_path: text, svg_path: text, source_digest: text) -> (status: text, svg_digest: text) =
  `: {source_digest}; "$ATLAS_RUN_CAPPED" "$ATLAS_DOT_BUDGET_S" dot -Tsvg "$dot_path" -o "$svg_path" && printf '%s %s' rendered "$(shasum -a 256 "$svg_path" | cut -c1-16)"`.

# The canvas graphviz actually chose. It is a property of the RENDER, not of
# the graph, so it cannot be derived: the only honest source is the header
# attributes of the file `dot` just wrote.
sh svg_size(svg_path: text, svg_digest: text) -> (canvas_width: int, canvas_height: int) =
  `: {svg_digest}; sed -n 's/.*width="\([0-9]*\)pt" height="\([0-9]*\)pt".*/\1 \2/p' "$svg_path" | head -1`.

# FIVE WRITES AND FIVE RENDERS, from one pair of hosts. The output paths are
# columns of `variant`, so adding a sixth drawing is one row in that rel and no
# change here at all -- and the digest chain that makes the render re-fire when
# the document changes is per variant, because the digest is content-derived.
rel dot_receipt(variant: text, source_digest: text).
dot_receipt(variant, source_digest) <-
  dot_document(variant, document), variant(variant, _, _, _, _, dot_path, _),
  write_file(dot_path, document, source_digest).

rel md_receipt(source_digest: text).
md_receipt(source_digest) <- md_document(document), write_file('v6/DATAFLOW-ATLAS.md', document, source_digest).

rel render_receipt(variant: text, status: text, svg_digest: text).
render_receipt(variant, status, svg_digest) <-
  dot_receipt(variant, source_digest), variant(variant, _, _, _, _, dot_path, svg_path),
  render_dot(dot_path, svg_path, source_digest, status, svg_digest).

rel variant_canvas(variant: text, canvas_width: int, canvas_height: int).
variant_canvas(variant, canvas_width, canvas_height) <-
  render_receipt(variant, _, svg_digest), variant(variant, _, _, _, _, _, svg_path),
  svg_size(svg_path, svg_digest, canvas_width, canvas_height).

? edge_without_node(node_id).
? cycle_node(node_id).
? fs_unplaced(node_id).
? fs_dir_too_deep(dir_path, depth).
? longest_level(depth_index, node_list).
? dot_receipt(variant, status).
? md_receipt(status).
? render_receipt(variant, status, svg_digest).
? variant_canvas(variant, canvas_width, canvas_height).
