# reference-docs-rail.dl6 -- Tier 1 (per-construct docs) + Tier 3 (concept
# notes) of the docs-from-comments rail (plans/2026-08-10-docs-from-comments.PLAN.md,
# user verdicts 2026-08-10). Tier 2 (host/bind contract tables) is pure
# registry.pl data and is generated by v6/prolog/compile/1_emit_registry_docs.pl
# instead -- no comment join needed there.
#
# ── ATTACHMENT (overrides the recon's marker recommendation) ────────────────
# No `docs:` marker convention. The comment run that ends exactly one line
# above a declaration IS that declaration's doc text -- loose comments near
# declarations, per the user verdict, using the SAME run-coalescing boundary
# technique as v6/tsv2/goldens/comment_rail_golden/0_comment_rail_golden.dl6
# (strat.pl refuses a recursive stratum, so a run start/end is found by
# boundary -- a node no other node ends one line above is a run START, a node
# no other node starts one line below is a run END -- never propagated node by
# node).
#
# ── ONE SOURCE, registry.pl -- NOT self-map.dl6, and the reason is measured ──
# The recon (`plans/2026-08-10-docs-from-comments.PLAN.md:92-94`) claims dl6
# `#` comments are "proven by the verdict's parity run, 745/745"; traced to
# `plans/2026-07-29-comment-node-verdict.md:313-316`, that corpus is 5 `.rs`
# files, zero `.dl6`. Measured here instead: `v6/sprefa-extract/src/lang/mod.rs`
# `sources()` matches Rust/Go/Kotlin/Prolog/Ts/ast-grep-fallback, none of it
# `.dl6`; booting this rail against self-map.dl6 landed 0 `comment_node` rows
# against registry.pl's 302 (same server, same tick). The throw site is
# `source_for` returning `None` for an unregistered extension, not a design
# decision -- self-map.dl6's own EDB/IDB paragraph (self-map.dl6:251-259, the
# recon's own citation at :256) is therefore NOT reachable by this rail until
# `.dl6` gets an extractor grammar, which is a sprefa-extract change this
# lane does not own. registry.pl alone still gives Tier 3 its 18 concept rows.
#
# A construct with NO directly preceding run gets no Tier 1 row; a group of
# constructs sharing one preceding comment (registry.pl:45-48's four
# lifecycle rows under one block) only attaches to the FIRST of the group.
# Both are honest consequences of preceding-decl attachment, not bugs.

use extract.

rel watch(glob: text, path: text, digest: text).

rel source(path: text, digest: text).
source(path, digest) <- watch('v6/prolog/0_dot_expand/registry.pl', path, digest).

rel comment_fact(path: text, digest: text, families: text)
  -> (line: int, end_line: int, kind: text, comment_text: text) key(1, 3).
rel comment_node(path: text, digest: text, start_line: int, end_line: int, comment_text: text).
comment_node(path, digest, start_line, end_line, comment_text) <-
  source(path, digest), comment_fact(path, digest, "cst", start_line, end_line, _kind, comment_text).

rel construct_marker(path: text, digest: text)
  -> (line: int, name: text, arity: text, axis: text, status: text) key(1).
rel construct_line(path: text, line: int, name: text, arity: text, axis: text, status: text).
construct_line(path, line, name, arity, axis, status) <-
  source(path, digest), construct_marker(path, digest, line, name, arity, axis, status).

rel decl_marker(path: text, digest: text) -> (line: int) key(1).
rel decl_line(path: text, line: int).
decl_line(path, line) <- source(path, digest), decl_marker(path, digest, line).

# ── run coalescing ───────────────────────────────────────────────────────────
rel node_successor_line(path: text, successor_line: int).
node_successor_line(path, successor_line) <-
  comment_node(path, _, _, end_line, _), successor_line := end_line + 1.

rel node_predecessor_line(path: text, predecessor_line: int).
node_predecessor_line(path, predecessor_line) <-
  comment_node(path, _, start_line, _, _), predecessor_line := start_line - 1.

rel run_start(path: text, start_line: int).
run_start(path, start_line) <-
  comment_node(path, _, start_line, _, _), not(node_successor_line(path, start_line)).

rel run_end(path: text, end_line: int).
run_end(path, end_line) <-
  comment_node(path, _, _, end_line, _), not(node_predecessor_line(path, end_line)).

rel run_end_candidate(path: text, start_line: int, end_line: int).
run_end_candidate(path, start_line, end_line) <-
  run_start(path, start_line), run_end(path, end_line), end_line >= start_line.

rel run_extent(path: text, start_line: int, end_line: int).
run_extent(path, start_line, min(end_line)) <- run_end_candidate(path, start_line, end_line).

rel run_text_row(path: text, start_line: int, end_line: int, line: int, comment_text: text).
run_text_row(path, start_line, end_line, line, comment_text) <-
  run_extent(path, start_line, end_line),
  comment_node(path, _, line, _, comment_text),
  line >= start_line, line =< end_line.

rel run_prose(path: text, start_line: int, end_line: int, prose: text).
run_prose(path, start_line, end_line, group_concat(comment_text, ' ', line)) <-
  run_text_row(path, start_line, end_line, line, comment_text).

# ── Tier 1: construct docs (registry.pl only) ───────────────────────────────
rel construct_doc(decl_line: int, name: text, arity: text, axis: text, status: text, prose: text).
construct_doc(next_line, name, arity, axis, status, prose) <-
  run_extent(path, start_line, end_line),
  next_line := end_line + 1,
  construct_line(path, next_line, name, arity, axis, status),
  run_prose(path, start_line, end_line, prose).

# ── Tier 3: concept notes (orphan runs, >= 3 lines) ──────────────────────────
rel concept_run(path: text, start_line: int, end_line: int).
concept_run(path, start_line, end_line) <-
  run_extent(path, start_line, end_line),
  next_line := end_line + 1,
  not(decl_line(path, next_line)),
  end_line - start_line >= 2.

rel concept_note(path: text, start_line: int, end_line: int, prose: text).
concept_note(path, start_line, end_line, prose) <-
  concept_run(path, start_line, end_line), run_prose(path, start_line, end_line, prose).

# ── render (devlog.dl6's group_concat fold, self-map.dl6's checked-in write) ─
rel doc_line(ordinal: int, line: text).

doc_line(ordinal, '# Registry Reference (generated from comments)') <-
  construct_doc(_, _, _, _, _, _), ordinal := 0 - 9000000000000000.
doc_line(ordinal, '') <-
  construct_doc(_, _, _, _, _, _), ordinal := 0 - 8999999999999999.
doc_line(ordinal, 'Generated by v6/dl/fixtures/reference-docs-rail.dl6 from loose comments preceding registry.pl surface/5 rows, plus orphan comment runs read as concept notes.') <-
  construct_doc(_, _, _, _, _, _), ordinal := 0 - 8999999999999998.
doc_line(ordinal, '') <-
  construct_doc(_, _, _, _, _, _), ordinal := 0 - 8999999999999997.
doc_line(ordinal, '## Contents') <-
  construct_doc(_, _, _, _, _, _), ordinal := 0 - 8999999999999996.
doc_line(ordinal, '- [Constructs](#constructs)') <-
  construct_doc(_, _, _, _, _, _), ordinal := 0 - 8999999999999995.
doc_line(ordinal, '- [Concepts](#concepts)') <-
  concept_note(_, _, _, _), ordinal := 0 - 8999999999999994.
doc_line(ordinal, '') <-
  construct_doc(_, _, _, _, _, _), ordinal := 0 - 8999999999999993.
doc_line(ordinal, '## Constructs') <-
  construct_doc(_, _, _, _, _, _), ordinal := 0 - 8999999999999992.
doc_line(ordinal, '') <-
  construct_doc(_, _, _, _, _, _), ordinal := 0 - 8999999999999991.
doc_line(ordinal, '| construct | axis | status | doc |') <-
  construct_doc(_, _, _, _, _, _), ordinal := 0 - 8999999999999990.
doc_line(ordinal, '|---|---|---|---|') <-
  construct_doc(_, _, _, _, _, _), ordinal := 0 - 8999999999999989.

doc_line(ordinal, line) <-
  construct_doc(decl_line, name, arity, axis, status, prose),
  ordinal := decl_line,
  line := concat(['| `', name, '/', arity, '` | ', axis, ' | ', status, ' | ', prose, ' |']).

doc_line(ordinal, '') <- concept_note(_, _, _, _), ordinal := 1000000.
doc_line(ordinal, '## Concepts') <- concept_note(_, _, _, _), ordinal := 1000001.
doc_line(ordinal, '') <- concept_note(_, _, _, _), ordinal := 1000002.
doc_line(ordinal, '| source | note |') <- concept_note(_, _, _, _), ordinal := 1000003.
doc_line(ordinal, '|---|---|') <- concept_note(_, _, _, _), ordinal := 1000004.

doc_line(ordinal, line) <-
  concept_note(path, start_line, end_line, prose),
  ordinal := 1000010 + start_line,
  line := concat(['| `', path, ':', start_line, '-', end_line, '` | ', prose, ' |']).

rel reference_document(document: text).
reference_document(group_concat(line, '\n', ordinal)) <- doc_line(ordinal, line).

rel write_reference_docs(path: text, document: text) -> (status: text).

rel write_receipt(document: text, status: text).
write_receipt(document, status) <-
  reference_document(document),
  write_reference_docs('v6/prolog/compile/CONSTRUCT-REFERENCE.md', document, status).
