# Exhaustive executable language composition. Comments name only required absences.
# json_each/2: registry status `refused`.
# json_array/1: registry status `refused`.
# sg_pattern/3: registry status `refused`.
# tagged_brace/1: reserved.
# set/0: removed word.
# scan/variadic: reserved removed word.
# zip/2: reserved.
# subscribe/1, unsubscribe/1, complete/1, error/1: reserved lifecycle wrappers.
# split/2: defect list-column-raw-snapshot-crash.
# zero-arity relation: defect zero-arity runtime SQL.
# option(bytes): defect option bytes wrapper semantics.

use "0_golden-flex-imported.dl6".
use "1_golden-flex-namespaced.dl6" as types.

interface json_encodable.
interface addressable.
interface container(T).
interface codec(Format).

rel GenericPair(T: json_encodable)(first: T, second: T).
rel GenericBox(T: json_encodable + addressable)(value: T).
rel GenericEntry(Key: json_encodable, Value)(key: Key, value: Value).
rel CodecBox(T: codec(any))(value: T).
rel CodecDocument(value: json) is codec(json).
rel AddressValue(value: text) is json_encodable, addressable.
rel GenericUse(pair: GenericPair(int), entry: GenericEntry(text,int)).

rel CapabilityRow(value: text) is json_encodable, container(text).
rel Person(name: text).
rel person(name: text).
rel Status(ready() ; failed(reason: text)).
rel OrchardRoot(root_id: int).
rel OrchardRoot.Child(value: text).

rel WrapperStates(nested: option(option(int)), result: option(Status),
                  brief: text?, content: bytes).

rel Revision(oid: text).
rel File(revision: Revision, path: text).
rel RevisionEndpoint(revision_id: Revision.id).
rel RevisionEndpoints(revisions: list(Revision.id)).
rel FileHolder(file: File).
rel HeldRevisionEndpoint(revision_id: Revision.id).
HeldRevisionEndpoint(RevisionId) <-
  FileHolder(FileValue),
  RevisionId := FileValue.revision.id.

rel ImportedProjection(value: text).
ImportedProjection(Value) <- ExternalRow(Value).
rel NamespacedProjection(value: text).
NamespacedProjection(Value) <- types.NamedRow(Value).

rel plot(row: int, col: int).                      # type_decl/2 leaf; col_type/3 int
rel patch(label: text, at: plot).                  # depth 1: a struct field typed by a struct

rel tree(tree_id: int, species: text, site: patch).   # depth 2: patch -> plot
rel pick_event(tree_id: int, picker: text, kilos: float, sugar: int).
rel retire_event(tree_id: int).
rel quarantined(species: text).
rel sensor(tree_id: int, healthy: bool).

rel orchard_json(tree_id: int, payload: json).
rel orchard_card(tree_id: int, species: text).
orchard_card(TreeId, Species) <-
  orchard_json(TreeId, JsonPayload),
  decode(JsonPayload, {species: Species}).
orchard_card(TreeId, Species) <-
  orchard_json(TreeId, JsonPayload),
  decode(JsonPayload, {'species': Species}).
orchard_card(TreeId, Species) <-
  orchard_json(TreeId, JsonPayload),
  decode(JsonPayload, {"species": Species}).

rel orchard_stars(tree_id: int, stars: int).
orchard_stars(TreeId, Stars) <-
  orchard_json(TreeId, JsonPayload),
  decode(JsonPayload, {stars: Stars: int}).

rel orchard_tag(tree_id: int, tag: text, value: int).
orchard_tag(TreeId, TagKey, TagValue) <-
  orchard_json(TreeId, JsonPayload),
  decode(JsonPayload, {tags: {$TagKey: TagValue: int}}).

rel orchard_tag_document(tree_id: int, snapshot: json).
orchard_tag_document(TreeId, json_object(TagKey, TagValue)) <-
  orchard_tag(TreeId, TagKey, TagValue).

rel orchard_patch_sample(tree_id: int, patch: json) log keep(all).
rel orchard_snapshot(tree_id: int, document: json) key(1).
orchard_snapshot(TreeId, Patch) <+
  orchard_patch_sample(TreeId, Patch),
  not(orchard_snapshot(TreeId, _AnyPriorDocument)).
orchard_snapshot(TreeId, Next) <+
  orchard_patch_sample(TreeId, Patch),
  pre(orchard_snapshot(TreeId, Prior)),
  Next := json_patch(Prior, Patch).

rel orchard_leaf(tree_id: int, leaf: int).
orchard_leaf(TreeId, Leaf) <-
  orchard_json(TreeId, JsonPayload),
  decode(JsonPayload, {'**': {leaf: Leaf: int}}).

rel orchard_item(tree_id: int, fruit: text, item_stars: int).
orchard_item(TreeId, Fruit, ItemStars) <-
  orchard_json(TreeId, JsonPayload),
  decode(JsonPayload, {items: spread({fruit: Fruit, stars: ItemStars: int})}).

rel orchard_has_empty(tree_id: int).
orchard_has_empty(TreeId) <-
  orchard_json(TreeId, JsonPayload),
  decode(JsonPayload, {empty: {}}).

rel orchard_list(tree_id: int, tags: json_list(text)).
rel orchard_list_tag(tree_id: int, tag: text).
orchard_list_tag(TreeId, Tag) <-
  orchard_list(TreeId, Tags),
  decode(Tags, spread(Tag)).

rel orchard_tag_source(tree_id: int, tag: text).
rel orchard_tag_list(tree_id: int, tags: json_list(text)).
orchard_tag_list(TreeId, json_group_array(Tag)) <-
  orchard_tag_source(TreeId, Tag).

rel orchard_tag_roundtrip(tree_id: int, tag: text).
orchard_tag_roundtrip(TreeId, Tag) <-
  orchard_tag_list(TreeId, Tags),
  decode(Tags, spread(Tag)).

rel pick_log(tree_id: int, picker: text) log keep(all).
rel recent_pick(tree_id: int, picker: text) log keep(count(2)).

rel pick_ordinal(tree_id: int, ordinal: int) log keep(all).
pick_ordinal(TreeId, PickOrdinal) <+
  pick_event(TreeId, _Picker, _Kilos, _Sugar), PickOrdinal := seq(TreeId).

rel pick_count(tree_id: int, count: int) key(1).
pick_count(TreeId, 1) <+
  pick_event(TreeId, _Picker, _Kilos, _Sugar), not(pick_count(TreeId, _Previous)).
pick_count(TreeId, PickCountValue) <+
  pick_event(TreeId, _Picker, _Kilos, _Sugar),
  pre(pick_count(TreeId, PickPreviousCount)),
  PickCountValue := PickPreviousCount + 1.

rel grade(ripe(sugar: int) ; green(days: int) ; bruised(reason: text)).

rel ParseError(code: text).
rel Ast(node: text).
rel Result(E, T)(err(error: E); ok(value: T)).
rel parse(source: text) -> Result(ParseError, Ast).

rel weigh(tree_id: int, grams: int) -> (label: text).

rel interval(period: int, bucket: int).


rel tree_label(tree_id: int, label: text).
tree_label(TreeId, Label) <- tree(TreeId, _Species, Site), decode(Site, {label: Label}).


rel pickable(tree_id: int, species: text, lane: int).
pickable(TreeId, Species, Lane) <-
  tree(TreeId, Species, _Site),
  not(quarantined(Species)),
  Species != 'weed',
  Species \== 'weed',
  Species = Species,
  Species == Species,
  TreeId > 0,
  TreeId > -1,
  Lane := (TreeId * 3 + 1) mod 7.


rel grade_artifact_read(grade_id: int, tag: text).
grade_artifact_read(GradeId, Tag) <-
  grade_ripe(GradeId, _Sugar),
  grade_tag(GradeId, Tag).

rel harvest(ripe(site: patch) ; bruised(reason: text)).
rel harvest_site_read(tree_id: int, label: text).
harvest_site_read(TreeId, Label) <-
  harvest_ripe(TreeId, Site),
  decode(Site, {label: Label}).

rel pick_count_seeded(tree_id: int, count: int) key(1).
pick_count_seeded(TreeId, Count) <+
  pick_event(TreeId, _Picker, _Kilos, _Sugar),
  pre(pick_count_seeded(TreeId, Previous), 0),
  Count := Previous + 1.
pick_count_seeded(TreeId, Count) <+
  retire_event(TreeId),
  pre(pick_count_seeded(TreeId, Previous), 0),
  Count := Previous - 1.

rel optional_picker(tree_id: int, picker: option(text)).
rel optional_picker_read(tree_id: int, option_id: int).
optional_picker_read(TreeId, OptionId) <-
  optional_picker(TreeId, OptionId).
rel tree_bundle(tree_id: int, sites: list(patch)).
rel tree_bundle_read(tree_id: int, label: text).
tree_bundle_read(TreeId, Label) <-
  tree_bundle(TreeId, ListId),
  __gen__list_patch_ad51169ab9220e8a__member(ListId, _Index, Site),
  decode(Site, {label: Label}).
rel lane_gap(tree_id: int, gap: int).
lane_gap(TreeId, Gap) <- pickable(TreeId, _Species, Lane), Gap is (Lane - 1) / 2.

rel heirloom(tree_id: int, species: text).
heirloom(TreeId, Species) <- tree(TreeId, Species, _Site), regexp(Species, "^[ap].*e").

rel monitored(tree_id: int, species: text).
monitored(TreeId, Species) <-
  combine(pickable(TreeId, Species, _Lane), sensor(TreeId, Healthy)),
  Healthy == true.

rel display(tree_id: int, note: text).
display(TreeId, Note) <-
  next(monitored(TreeId, Species)),
  Note := concat(['tree ', TreeId, ' is ', Species, " (monitored)"]).

rel display_key(tree_id: int, key: text).
display_key(TreeId, norm(Note)) <- display(TreeId, Note).

rel heavy_pick(tree_id: int, kilos: float).
heavy_pick(TreeId, Kilos) <-
  pick_event(TreeId, _Picker, Kilos, _Sugar),
  Kilos >= 1.5,
  Kilos < 100.0,
  Kilos <= 99.5,
  Kilos =< 99.5.

rel picked_by_ada(tree_id: int).
picked_by_ada(TreeId) <- pick_event(tree_id: TreeId, picker: 'ada').

rel pun_before_keyword(tree_id: int, picker: text).
pun_before_keyword(Tree_id, picker: Picker) <-
  pick_event(Tree_id, picker: Picker).

rel keyword_before_pun(tree_id: int, picker: text).
keyword_before_pun(Tree_id, Picker) <-
  pick_event(picker: Picker, Tree_id).

rel multiple_puns(tree_id: int, picker: text, kilos: float).
multiple_puns(Tree_id, Picker, kilos: Kilos) <-
  pick_event(Tree_id, Picker, kilos: Kilos).

rel unmatched_after_pun(tree_id: int, kilos: float).
unmatched_after_pun(Tree_id, Kilos) <-
  pick_event(Tree_id, picker: 'ada', Kilos).

rel body_pun(tree_id: int).
body_pun(Tree_id) <- pick_event(picker: 'ada', Tree_id).

rel pick_stats(tree_id: int, picks: int, total: int, lowest: int, highest: int).
pick_stats(TreeId, count(Sugar), sum(Sugar), min(Sugar), max(Sugar)) <-
  pick_event(TreeId, _Picker, _Kilos, Sugar).

rel mean_kilos(tree_id: int, kilos: float).
mean_kilos(TreeId, avg(Kilos)) <- pick_event(TreeId, _Picker, Kilos, _Sugar).

rel picker_roster(picker: text, tree_ids: json).
picker_roster(Picker, json_group_array(TreeId)) <-
  pick_event(TreeId, Picker, _Kilos, _Sugar).

rel sugar_ladder(picker: text, sugars: json).
sugar_ladder(Picker, json_group_array(Sugar, TreeId)) <-
  pick_event(TreeId, Picker, _Kilos, Sugar).

rel lane_manifest(lane: int, species_list: text).
lane_manifest(Lane, group_concat(Species, ', ')) <-
  pickable(_TreeId, Species, Lane).

rel pick_story(story: text).
pick_story(group_concat(Picker, ' > ', TreeId)) <-
  pick_event(TreeId, Picker, _Kilos, _Sugar).

rel picker_dump(roster: text).
picker_dump(group_concat(Picker)) <- pick_event(_TreeId, Picker, _Kilos, _Sugar).

rel sugar_equals_two(tree_id: int).
sugar_equals_two(TreeId) <- pick_event(TreeId, _Picker, _Kilos, Sugar), Sugar =:= 2.
rel sugar_is_not_two(tree_id: int).
sugar_is_not_two(TreeId) <- pick_event(TreeId, _Picker, _Kilos, Sugar), Sugar =\= 2.


rel pick_tick(tree_id: int, tick: int) log keep(all).
pick_tick(TreeId, Tick) <+ pick_event(TreeId, _Picker, _Kilos, _Sugar), now(Tick).

pick_log(TreeId, Picker) <+ pick_event(TreeId, Picker, _Kilos, _Sugar).
recent_pick(TreeId, Picker) <+ pick_event(TreeId, Picker, _Kilos, _Sugar).

rel last_picker(tree_id: int, picker: text) key(1).
last_picker(TreeId, Picker) <+
  pick_event(TreeId, Picker, _Kilos, _Sugar),
  latest(pickable(TreeId, _Species, _Lane)).

rel picker_of(tree_id: int, picker: text).
picker_of(TreeId, Picker) <-
  pickable(TreeId, _Species, _Lane),
  coalesce(last_picker(TreeId, Picker), 'nobody').

rel fell_out(tree_id: int, species: text) log keep(all).
fell_out(TreeId, Species) <+ finalize(pickable(TreeId, Species, _Lane)).

rel unmonitored_pick(tree_id: int) key(1).
unmonitored_pick(TreeId) <+
  pick_event(TreeId, _Picker, _Kilos, _Sugar),
  not(monitored(TreeId, _Species)).

rel weighed(tree_id: int, grams: int, label: text).
weighed(TreeId, Grams, Label) <-
  pick_stats(TreeId, _Picks, Grams, _Lowest, _Highest),
  weigh(TreeId, Grams, Label).

rel roll_call(tree_id: int, bucket: int).
roll_call(TreeId, Bucket) <- pickable(TreeId, _Species, _Lane), interval(1, Bucket).

rel graded(grade_id: int, verdict: text).
match grade_tag(GradeId, Tag) (
  ; Tag == 'ripe'  |-> graded(GradeId, "pick it")
  ; Tag == 'green' |-> graded(GradeId, "wait")
  ; true           |-> graded(GradeId, "compost")
).

rel retired_tree(tree_id: int) key(1).
match retire_event(TreeId) (
  ; TreeId > 0 |+> retired_tree(TreeId)
).

rel orchard_query(query: text).
orchard_query(ts_query([node('call_expression', [capture('callee', 'wildcard')])])) <-
  quarantined(_Species).


rel dispatch_manifest(dispatch_id: int, payload: json).
rel dispatch_leg(leg_id: int, dispatch_id: int, previous_leg: int, kilos: int,
                 origin: patch).
rel dispatch_ack(dispatch_id: int).
rel dispatch_seal(dispatch_id: int).

rel dispatch(air(hours: int) ; road(miles: int) ; rail(stops: int)).

rel dispatch_route(dispatch_id: int, route: text, hops: int).
dispatch_route(DispatchId, RouteName, HopCount) <-
  dispatch_manifest(DispatchId, ManifestPayload),
  decode(ManifestPayload, {route: {name: RouteName, hops: HopCount: int}}).

rel route_flattened(dispatch_id: int, flat: text).
route_flattened(DispatchId, Flat) <-
  dispatch_route(DispatchId, RouteName, _HopCount), Flat := replace(RouteName, '/', '_').
rel route_bare(dispatch_id: int, bare: text).
route_bare(DispatchId, Bare) <-
  dispatch_route(DispatchId, RouteName, _HopCount), Bare := rtrim(RouteName, '/').

rel route_strings(dispatch_id: int, shouted: text, mumbled: text, trimmed: text,
                   trimmed_charset: text, led: text, led_charset: text,
                   written: text, mirrored: text, titled: text, clipped: text,
                   middle: text, found_at: int, measured: int).
route_strings(DispatchId, Shouted, Mumbled, Trimmed, TrimmedCharset, Led,
              LedCharset, Written, Mirrored, Titled, Clipped, Middle, FoundAt,
              Measured) <-
  dispatch_route(DispatchId, RouteName, _HopCount),
  Shouted := upper(RouteName),
  Mumbled := lower(RouteName),
  Trimmed := trim(RouteName),
  TrimmedCharset := trim(RouteName, 'h'),
  Led := ltrim(RouteName),
  LedCharset := ltrim(RouteName, 'e'),
  Written := rtrim(RouteName),
  Mirrored := reverse(RouteName),
  Titled := initcap(RouteName),
  Clipped := substr(RouteName, 2),
  Middle := substr(RouteName, 2, 2),
  FoundAt := instr(RouteName, 'o'),
  Measured := length(RouteName).

rel dispatch_ticket(dispatch_id: int, tag: text, route: text, hops: int).
dispatch_ticket(DispatchId, DispatchTag, RouteName, HopCount) <-
  dispatch_tag(DispatchId, DispatchTag),
  dispatch_route(DispatchId, RouteName, HopCount).

rel dispatch_plan(dispatch_id: int, route: text, verdict: text).
match dispatch_ticket(DispatchId, DispatchTag, RouteName, HopCount) (
  ; DispatchTag == 'air'  |-> dispatch_plan(DispatchId, RouteName, "fly it")
  ; DispatchTag == 'road' |-> dispatch_plan(DispatchId, RouteName, "truck it")
  ; HopCount > 2          |-> dispatch_plan(DispatchId, RouteName, "stage it")
).

rel leg_origin(leg_id: int, label: text).
leg_origin(LegId, OriginLabel) <-
  dispatch_leg(LegId, _DispatchId, _PreviousLeg, _Kilos, Origin),
  decode(Origin, {label: OriginLabel}).

rel leg_total(leg_id: int, dispatch_id: int, kilos_so_far: int).
leg_total(LegId, DispatchId, Kilos) <-
  dispatch_leg(LegId, DispatchId, 0, Kilos, _Origin).
leg_total(LegId, DispatchId, KilosSoFar) <-
  dispatch_leg(LegId, DispatchId, PreviousLeg, Kilos, _Origin),
  leg_total(PreviousLeg, DispatchId, KilosBefore),
  KilosSoFar := KilosBefore + Kilos.

rel dispatch_note(dispatch_id: int, note_tag: text) log keep(all).
dispatch_note(DispatchId, 'acked') <+ dispatch_ack(DispatchId).
dispatch_note(SealedId, 'sealed') <+ dispatch_seal(SealedId).

? display(_TreeId, _Note).
? pick_stats(_StatTree, _Picks, _Total, _Lowest, _Highest).
? dispatch_plan(_PlanDispatch, _PlanRoute, _PlanVerdict).
? leg_total(_TotalLeg, _TotalDispatch, _KilosSoFar).
? dispatch_note(_NoteDispatch, _NoteTag).
? heirloom(_HeirloomTree, _HeirloomSpecies).
