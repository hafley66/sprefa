# xrepo.dl6 -- THE CROSS-REPO RECEIPT (lab question Q3).
#
# Three repos arrive as six rows: each repo's OpenAPI contract and each repo's
# package.json, both as ordinary json columns. Nothing else is fed. Every fact
# below is derived by rules over those documents.
#
#   pet-contracts   SERVES the shapes. Its openapi.json is the real Swagger
#                   Petstore document, 17,106 bytes, vendored byte-unmodified.
#   pet-dashboard   USES four of them by external $ref, and DECLARES the
#                   dependency in package.json. One of its four refs names a
#                   shape pet-contracts does not have.
#   pet-billing     USES two of them and DECLARES NO SUCH DEPENDENCY. This is
#                   the negative the join has to catch.
#
# t2 (the type surface) and t1 (the dependency edge) meet in `calls_shape`, and
# the two lints under it are the reason the fever dream wants the join at all:
# a shape used across a repo boundary with no declared dependency, and a
# contract reference that resolves nowhere in the federation.
#
# NO SUBSTRING, ANYWHERE. dl6 has concat but no split, slice or regex, so a
# JSON Pointer is never taken apart -- the pointer each repo WOULD export is
# built forward with concat and the join is an equality on the whole string.
# That is the same shape openapi.dl6 uses for internal refs, and it is the one
# real constraint the algebra pushed back on. Verdict finding A3.

rel spec(repo: text, body: json).
rel manifest(repo: text, body: json).
rel contract_file(repo: text, file: text).

rel type_def(repo: text, type_name: text, kind: text).
rel export_pointer(repo: text, pointer: text, type_name: text).
rel internal_pointer(repo: text, pointer: text, type_name: text).
rel depends_on(from_repo: text, to_repo: text).
rel uses_pointer(repo: text, type_name: text, field_name: text, pointer: text).
rel resolves(repo: text, pointer: text).

rel calls_shape(from_repo: text, from_type: text, field_name: text, to_repo: text, to_type: text).
rel undeclared_shape_dep(from_repo: text, to_repo: text, to_type: text).
rel dangling_shape(repo: text, type_name: text, field_name: text, pointer: text).

# ── t2: what each repo declares ──────────────────────────────────────────────
type_def(Repo, Name, 'record') <-
  spec(Repo, Body), decode(Body, {components: {schemas: {$Name: {type: 'object'}}}}).

# The pointer another repo would have to write to reach this type.
export_pointer(Repo, Pointer, Name) <-
  type_def(Repo, Name, 'record'),
  contract_file(Repo, File),
  Pointer := concat([File, '#/components/schemas/', Name]).

# The pointer this repo writes to reach its OWN type.
internal_pointer(Repo, Pointer, Name) <-
  type_def(Repo, Name, 'record'),
  Pointer := concat(['#/components/schemas/', Name]).

# ── t1: the dependency edge, from the real package.json ──────────────────────
depends_on(Repo, Dep) <-
  manifest(Repo, Body), decode(Body, {dependencies: {$Dep: _Version}}).

# ── use sites: every $ref in a repo's own contract, both positions ───────────
uses_pointer(Repo, Owner, Field, Pointer) <-
  spec(Repo, Body),
  decode(Body, {components: {schemas: {$Owner: {properties: {$Field: {'$ref': Pointer}}}}}}).

uses_pointer(Repo, Owner, Field, Pointer) <-
  spec(Repo, Body),
  decode(Body, {components: {schemas: {$Owner: {properties: {$Field: {items: {'$ref': Pointer}}}}}}}).

# ── THE JOIN: who calls what shape, across the repo boundary ─────────────────
calls_shape(FromRepo, FromType, Field, ToRepo, ToType) <-
  uses_pointer(FromRepo, FromType, Field, Pointer),
  export_pointer(ToRepo, Pointer, ToType),
  FromRepo != ToRepo.

# ── lint 1: the shape is used, the dependency is not declared ────────────────
undeclared_shape_dep(FromRepo, ToRepo, ToType) <-
  calls_shape(FromRepo, _FromType, _Field, ToRepo, ToType),
  not(depends_on(FromRepo, ToRepo)).

# ── lint 2: a reference nothing in the federation can answer ─────────────────
# A pointer resolves if it names a type in the referring repo, or a type any
# repo exports. Anything else dangles.
resolves(Repo, Pointer) <- internal_pointer(Repo, Pointer, _Name).
resolves(Repo, Pointer) <- uses_pointer(Repo, _Owner, _Field, Pointer), export_pointer(_To, Pointer, _Type).

dangling_shape(Repo, Owner, Field, Pointer) <-
  uses_pointer(Repo, Owner, Field, Pointer),
  not(resolves(Repo, Pointer)).
