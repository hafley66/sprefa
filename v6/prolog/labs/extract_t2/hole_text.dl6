# hole_text.dl6 -- MINIMAL PROBE for lab finding D2.
#
# A decode/2 value hole binds a STRUCTURED json value (object or array) and the
# head column it lands in is declared `text`. Nothing else happens.
#
# Twin: hole_json.dl6, identical but for the one column type.

rel doc(body: json).
rel bound(key: text, value: text).

bound(Key, Value) <- doc(Body), decode(Body, {$Key: Value}).
