# avro.dl6 -- reify an Avro schema into the t2 type algebra.
#
# Avro is the cheapest format in the survey: a .avsc file IS already JSON, so
# nothing sits between the repo's file and the json plane. Nothing is bought
# here and nothing is parsed.
#
# Source: corpus/avro-interop.avsc, Apache Avro's own cross-language interop
# test schema, 1,238 bytes, vendored byte-unmodified. It is the only file in the
# corpus carrying every claimed gap at once: bytes, null, fixed, float and double
# beside int and long, a union spelled as a bare array, a map, and a record that
# refers to ITSELF (Node.children is an array of Node).
#
# ── ONE HOLE, ONE KIND (verdict finding D2) ──────────────────────────────────
#
# Avro's `type` slot is genuinely HETEROGENEOUS: it holds the string "int" for a
# primitive, an OBJECT for an array/map/enum/fixed/nested record, and an ARRAY
# for a union. avro-heterogeneous.dl6 is the obvious spelling that binds that
# slot to one variable, and it DIVERGES ACROSS THE DOORS -- 8 of its 17 rows
# render as json values on the reference engine and as json STRINGS on the
# emitted engine. There is no column type that fixes it: `text` diverges,
# `json` silently DROPS every scalar row (INSERT OR IGNORE over a
# CHECK(json_valid) the decoded scalar cannot pass). hole_text.dl6 and
# hole_json.dl6 are the two-row probes that pin both halves.
#
# So every hole below binds ONE kind. The discriminator is a JOIN, not a guard:
# avro's primitive names are a closed, normative set, fed as ordinary EDB rows
# (`avro_primitive`), and a named type is one this document declares. The join
# runs in the SAME rule as the decode, so a structured value is filtered before
# it is ever written to a column -- which is exactly why openapi.dl6 and
# proto.dl6 never hit this: their `type` slots are homogeneous by the format.

rel avro(body: json).
rel avro_primitive(name: text).

rel type_def(repo: text, type_name: text, kind: text).
rel field_def(repo: text, type_name: text, field_name: text).
rel field_prim(repo: text, type_name: text, field_name: text, prim: text).
rel field_ref(repo: text, type_name: text, field_name: text, target: text).
rel field_union_member(repo: text, type_name: text, field_name: text, member: text).
rel field_array_items(repo: text, type_name: text, field_name: text, items: text).
rel field_map(repo: text, type_name: text, field_name: text).
rel enum_variant(repo: text, type_name: text, variant: text).
rel fixed_width(repo: text, type_name: text, size: int).

# ── named types ──────────────────────────────────────────────────────────────
type_def('interop', Name, 'record') <-
  avro(Body), decode(Body, {'**': {type: 'record', name: Name}}).

type_def('interop', Name, 'enum') <-
  avro(Body), decode(Body, {'**': {type: 'enum', name: Name}}).

type_def('interop', Name, 'fixed') <-
  avro(Body), decode(Body, {'**': {type: 'fixed', name: Name}}).

enum_variant('interop', Name, Variant) <-
  avro(Body), decode(Body, {'**': {type: 'enum', name: Name, symbols: spread(Variant)}}).

# `fixed` is avro's BYTES-WITH-A-WIDTH. The width is data here; no column type
# in the algebra carries it. That is slot_bytes_spelling, stated not solved.
fixed_width('interop', Name, Size) <-
  avro(Body), decode(Body, {'**': {type: 'fixed', name: Name, size: Size}}).

# ── fields ───────────────────────────────────────────────────────────────────
# The field NAME is homogeneous (always a string), so it needs no discriminator.
field_def('interop', Record, Field) <-
  avro(Body),
  decode(Body, {'**': {type: 'record', name: Record, fields: spread({name: Field})}}).

# primitive: the join against the closed primitive set IS the discriminator.
field_prim('interop', Record, Field, Token) <-
  avro(Body),
  decode(Body, {'**': {type: 'record', name: Record,
                       fields: spread({name: Field, type: Token})}}),
  avro_primitive(Token).

# named reference: avro spells "the record Node" as the bare string "Node", so
# the same slot resolves against the type table -- proto.dl6's join, again.
field_ref('interop', Record, Field, Token) <-
  avro(Body),
  decode(Body, {'**': {type: 'record', name: Record,
                       fields: spread({name: Field, type: Token})}}),
  type_def('interop', Token, _Kind).

# ── union: avro spells it as a bare ARRAY of types ───────────────────────────
# A spread INSIDE a spread. Only a field whose type is an array matches, and the
# primitive join keeps the members homogeneous (interop's union has one member
# that is itself an array type -- it is correctly NOT reported as a member name,
# and that omission is recorded as a hole rather than papered over).
field_union_member('interop', Record, Field, Member) <-
  avro(Body),
  decode(Body, {'**': {type: 'record', name: Record,
                       fields: spread({name: Field, type: spread(Member)})}}),
  avro_primitive(Member).

# ── array and map ────────────────────────────────────────────────────────────
field_array_items('interop', Record, Field, Items) <-
  avro(Body),
  decode(Body, {'**': {type: 'record', name: Record,
                       fields: spread({name: Field, type: {type: 'array', items: Items}})}}),
  avro_primitive(Items).

field_array_items('interop', Record, Field, Items) <-
  avro(Body),
  decode(Body, {'**': {type: 'record', name: Record,
                       fields: spread({name: Field, type: {type: 'array', items: Items}})}}),
  type_def('interop', Items, _Kind).

field_map('interop', Record, Field) <-
  avro(Body),
  decode(Body, {'**': {type: 'record', name: Record,
                       fields: spread({name: Field, type: {type: 'map'}})}}).
