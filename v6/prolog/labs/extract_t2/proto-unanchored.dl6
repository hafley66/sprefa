# proto.dl6 -- reify a protobuf schema into the t2 type algebra.
#
# The document is protobufjs's `pbjs -t json` descriptor of a real .proto. That
# tool is the BUY for this format: protoc alone emits a BINARY FileDescriptorSet
# and has no JSON output flag at all (`protoc --help` carries none), so the only
# zero-parser route to a JSON document is a tool that already speaks .proto.
# See the buy table in the verdict.
#
# Source: corpus/proto-struct.json, generated from the vendored, unmodified
# google/protobuf/struct.proto (4,317 bytes) shipped with protoc 35.1.
#
# WHY THIS DOCUMENT: struct.proto carries the four algebra rows the Petstore
# has none of -- a map field, a oneof (union), a repeated field, and an enum
# that is a NAMED top-level type rather than an anonymous property member.
#
# The package nesting (nested.google.nested.protobuf.nested.X) is why every
# rule below opens with `**`: message definitions sit at a depth that is a
# function of the package name, and descent is the production that does not
# care.

rel proto(body: json).

rel type_def(repo: text, type_name: text, kind: text).
rel field_def(repo: text, type_name: text, field_name: text).
rel field_type_name(repo: text, type_name: text, field_name: text, named: text).
rel field_prim(repo: text, type_name: text, field_name: text, prim: text).
rel field_ref(repo: text, type_name: text, field_name: text, target: text).
rel field_repeated(repo: text, type_name: text, field_name: text).
rel field_required(repo: text, type_name: text, field_name: text).
rel field_map(repo: text, type_name: text, field_name: text, key_prim: text, value_type: text).
rel enum_variant(repo: text, type_name: text, variant: text).
rel union_member(repo: text, type_name: text, member: text).

# ── records and enums ────────────────────────────────────────────────────────
# A message is a node carrying `fields`; an enum is a node carrying `values`.
type_def('wkt', Name, 'record') <-
  proto(Body), decode(Body, {'**': {$Name: {fields: {}}}}).

type_def('wkt', Name, 'enum') <-
  proto(Body), decode(Body, {'**': {$Name: {values: {}}}}).

enum_variant('wkt', Name, Variant) <-
  proto(Body), decode(Body, {'**': {$Name: {values: {$Variant: _Number}}}}).

# ── fields ───────────────────────────────────────────────────────────────────
field_def('wkt', Message, Field) <-
  proto(Body), decode(Body, {'**': {$Message: {fields: {$Field: {id: _Id}}}}}).

field_type_name('wkt', Message, Field, Named) <-
  proto(Body), decode(Body, {'**': {$Message: {fields: {$Field: {type: Named}}}}}).

# THE SAME JOIN THE OPENAPI REIFIER USES, one format over. proto's `type` is
# one slot holding either a scalar keyword or a declared type's name; which one
# it is, is decided by the type table, never by the token. So `ref` is the
# join and `prim` is its negation -- and that is the algebra's named-ref row
# doing real work rather than being asserted.
field_ref('wkt', Message, Field, Named) <-
  field_type_name('wkt', Message, Field, Named),
  type_def('wkt', Named, _Kind).

field_prim('wkt', Message, Field, Named) <-
  field_type_name('wkt', Message, Field, Named),
  not(type_def('wkt', Named, _Kind)).

# ── repeated ─────────────────────────────────────────────────────────────────
field_repeated('wkt', Message, Field) <-
  proto(Body), decode(Body, {'**': {$Message: {fields: {$Field: {rule: 'repeated'}}}}}).

# proto3 singular fields are OPTIONAL by construction (no presence without the
# `optional` keyword). The one required-shaped marker protobufjs emits is
# rule 'required', which is proto2 only. Absence of a row is optionality, in
# exactly the algebra's sense -- and here it is the format's own default.
field_required('wkt', Message, Field) <-
  proto(Body), decode(Body, {'**': {$Message: {fields: {$Field: {rule: 'required'}}}}}).

# ── map ──────────────────────────────────────────────────────────────────────
# `keyType` is the marker: a map field carries one, an ordinary field does not.
field_map('wkt', Message, Field, KeyPrim, ValueType) <-
  proto(Body),
  decode(Body, {'**': {$Message: {fields: {$Field: {keyType: KeyPrim, type: ValueType}}}}}).

# ── oneof = union ────────────────────────────────────────────────────────────
# A oneof IS named in proto, so unlike the OpenAPI enum no name has to be
# minted; it is qualified by its message to keep it unique across the file.
type_def('wkt', UnionName, 'union') <-
  proto(Body),
  decode(Body, {'**': {$Message: {oneofs: {$Oneof: {oneof: spread(_M)}}}}}),
  UnionName := concat([Message, '.', Oneof]).

union_member('wkt', UnionName, Member) <-
  proto(Body),
  decode(Body, {'**': {$Message: {oneofs: {$Oneof: {oneof: spread(Member)}}}}}),
  UnionName := concat([Message, '.', Oneof]).
