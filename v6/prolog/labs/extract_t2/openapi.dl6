# openapi.dl6 -- reify an OpenAPI 3.x document into the t2 type algebra.
#
# The document arrives as ONE row in a json column. Every rule below is an
# ordinary level rule over the json plane: exact keys, key capture ($Name),
# array spread. No host, no TS, no bespoke parser.
#
# Source: corpus/openapi-petstore.json, the canonical Swagger Petstore, 17,106
# bytes, fetched unmodified.
#
# THE ALGEBRA (the claim under test, one rel per row of it):
#   record     -> type_def(kind 'record') + field_def rows        [struct_as_rows]
#   enum       -> type_def(kind 'enum') + enum_variant rows       [variant rels]
#   optional   -> ABSENCE from field_required                     [no flag column]
#   repeated   -> field_repeated row present
#   named-ref  -> field_ref, resolved through the pointer join
#   primitive  -> field_prim
#   map        -> field_map          (openapi: additionalProperties; petstore has none)
#   union      -> union_member       (openapi 3.1: oneOf; petstore has none)

rel spec(body: json).

rel type_def(repo: text, type_name: text, kind: text).
rel type_pointer(repo: text, pointer: text, type_name: text).
rel field_def(repo: text, type_name: text, field_name: text).
rel field_prim(repo: text, type_name: text, field_name: text, prim: text).
rel field_format(repo: text, type_name: text, field_name: text, format: text).
rel field_repeated(repo: text, type_name: text, field_name: text).
rel field_required(repo: text, type_name: text, field_name: text).
rel field_raw_ref(repo: text, type_name: text, field_name: text, pointer: text).
rel field_ref(repo: text, type_name: text, field_name: text, target: text).
rel enum_variant(repo: text, type_name: text, variant: text).

# ── records ──────────────────────────────────────────────────────────────────
type_def('petstore', Name, 'record') <-
  spec(Body), decode(Body, {components: {schemas: {$Name: {type: 'object'}}}}).

# The pointer a $ref uses to name this schema. dl6 has concat but no substring
# or split, so the ref is resolved by BUILDING the pointer forward and joining
# on it, never by stripping the prefix off the ref. See verdict finding A3.
type_pointer('petstore', Pointer, Name) <-
  type_def('petstore', Name, 'record'),
  Pointer := concat(['#/components/schemas/', Name]).

# ── fields ───────────────────────────────────────────────────────────────────
field_def('petstore', Name, Field) <-
  spec(Body), decode(Body, {components: {schemas: {$Name: {properties: {$Field: {}}}}}}).

# A scalar property. `array` is excluded because its own `items` carries the
# element type; `object` is excluded because an inline object is a nested
# record the algebra has no name for (verdict finding A5).
field_prim('petstore', Name, Field, Prim) <-
  spec(Body),
  decode(Body, {components: {schemas: {$Name: {properties: {$Field: {type: Prim}}}}}}),
  Prim != 'array',
  Prim != 'object'.

# `format` is the int-width / bytes / date carrier. It is reified as its own
# fact because dl6 has ONE int type: int32 and int64 are the same column here.
field_format('petstore', Name, Field, Format) <-
  spec(Body),
  decode(Body, {components: {schemas: {$Name: {properties: {$Field: {format: Format}}}}}}).

# ── repeated ─────────────────────────────────────────────────────────────────
field_repeated('petstore', Name, Field) <-
  spec(Body),
  decode(Body, {components: {schemas: {$Name: {properties: {$Field: {type: 'array'}}}}}}).

field_prim('petstore', Name, Field, Prim) <-
  spec(Body),
  decode(Body, {components: {schemas: {$Name: {properties: {$Field: {items: {type: Prim}}}}}}}).

# ── named references, both positions ─────────────────────────────────────────
field_raw_ref('petstore', Name, Field, Pointer) <-
  spec(Body),
  decode(Body, {components: {schemas: {$Name: {properties: {$Field: {'$ref': Pointer}}}}}}).

field_raw_ref('petstore', Name, Field, Pointer) <-
  spec(Body),
  decode(Body, {components: {schemas: {$Name: {properties: {$Field: {items: {'$ref': Pointer}}}}}}}).

field_ref('petstore', Name, Field, Target) <-
  field_raw_ref('petstore', Name, Field, Pointer),
  type_pointer('petstore', Pointer, Target).

# ── required is a positive fact; OPTIONAL IS ITS ABSENCE ─────────────────────
field_required('petstore', Name, Field) <-
  spec(Body),
  decode(Body, {components: {schemas: {$Name: {required: spread(Field)}}}}).

# ── inline enums ─────────────────────────────────────────────────────────────
# An OpenAPI enum has NO NAME: it is an anonymous member of one property. The
# algebra's enum row needs a name, so one is minted from its position. That
# minting is a decision, not a translation -- verdict finding A2.
type_def('petstore', EnumName, 'enum') <-
  spec(Body),
  decode(Body, {components: {schemas: {$Name: {properties: {$Field: {enum: spread(_V)}}}}}}),
  EnumName := concat([Name, '.', Field]).

enum_variant('petstore', EnumName, Variant) <-
  spec(Body),
  decode(Body, {components: {schemas: {$Name: {properties: {$Field: {enum: spread(Variant)}}}}}}),
  EnumName := concat([Name, '.', Field]).
