# idiom 8: rendezvous (unbuffered channel, capacity 0).
#
# Go equivalent (unexecuted, the external referent):
#   ch := make(chan string)     // NO buffer
#   go func() { ch <- "v" }()   // this send BLOCKS until a receiver is ready
#   v := <-ch                   // and this receive blocks until a sender is
#   // the handoff is a synchronisation point: neither side proceeds alone
#
# slot_rendezvous_meaning. keep(count(0)) is NOT this. That spelling is
# deliver-and-forget (rel_as_stream lab receipt (c)): the row fires whatever
# listens THIS tick and is gone, so an offer with no receiver present is LOST.
# Rendezvous requires the opposite -- the offer must WAIT. So capacity 0 is a
# JOIN condition (meet only when both sides are present), not a retention
# policy. Both sides therefore need queues, and both get numbered.
#
rel offer(payload: text)                log keep(all).
rel arrive(receiver: text)              log keep(all).
rel pend_offer(ordinal: int, payload: text)  log keep(all).
rel pend_recv(ordinal: int, receiver: text)  log keep(all).
rel cursor_o(name: text, at: int)       key(1).
rel cursor_r(name: text, at: int)       key(1).
rel met_offer(ordinal: int)             key(1).
rel met_recv(ordinal: int)              key(1).
rel met(offer_ordinal: int, recv_ordinal: int, receiver: text, payload: text) log keep(all).

# numbering block, offer side
cursor_o('o', 1)            <+ offer(_Payload), not(cursor_o('o', _At)).
pend_offer(1, Payload)      <+ offer(Payload), not(cursor_o('o', _At)).
cursor_o('o', NextAt)       <+ offer(_Payload), pre(cursor_o('o', At)), NextAt := At + 1.
pend_offer(NextAt, Payload) <+ offer(Payload), pre(cursor_o('o', At)), NextAt := At + 1.

# numbering block, receiver side -- VERBATIM SHAPE REPEAT
cursor_r('r', 1)            <+ arrive(_Receiver), not(cursor_r('r', _At)).
pend_recv(1, Receiver)      <+ arrive(Receiver), not(cursor_r('r', _At)).
cursor_r('r', NextAt)       <+ arrive(_Receiver), pre(cursor_r('r', At)), NextAt := At + 1.
pend_recv(NextAt, Receiver) <+ arrive(Receiver), pre(cursor_r('r', At)), NextAt := At + 1.

item_o(Ordinal, Payload)    <- pend_offer(Ordinal, Payload).
item_r(Ordinal, Receiver)   <- pend_recv(Ordinal, Receiver).
next_o(min(Ordinal))        <- item_o(Ordinal, _Payload), not(met_offer(Ordinal)).
next_r(min(Ordinal))        <- item_r(Ordinal, _Receiver), not(met_recv(Ordinal)).

# A rendezvous has NO drain: it fires spontaneously when both sides are present.
# An edge rule needs a trigger, and EITHER side arriving can complete the pair,
# so the two sides are merged into one trigger rel. Without this merge every
# meeting rule below has to be written twice, once per trigger.
beat('o', Ordinal)          <- pend_offer(Ordinal, _Payload).
beat('r', Ordinal)          <- pend_recv(Ordinal, _Receiver).

met_offer(OfferOrdinal)     <+ beat(_Side, _N), latest(next_o(OfferOrdinal)), latest(next_r(_RecvOrdinal)).
met_recv(RecvOrdinal)       <+ beat(_Side, _N), latest(next_o(_OfferOrdinal)), latest(next_r(RecvOrdinal)).
met(OfferOrdinal, RecvOrdinal, Receiver, Payload)
                            <+ beat(_Side, _N),
                               latest(next_o(OfferOrdinal)), latest(next_r(RecvOrdinal)),
                               latest(item_o(OfferOrdinal, Payload)), latest(item_r(RecvOrdinal, Receiver)).

waiting_offers(count(Ordinal))   <- item_o(Ordinal, _Payload), not(met_offer(Ordinal)).
waiting_receivers(count(Ordinal)) <- item_r(Ordinal, _Receiver), not(met_recv(Ordinal)).
