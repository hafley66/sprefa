# idiom 3: pipeline. 3 stages, item flows source -> 1 -> 2 -> 3.
# Question the header asks: ticks per item per stage. The effect-chain lab found
# N+1 ticks per stage on HOST chains; a pure-rel edge chain is measured here.
#
# Go equivalent (unexecuted, the external referent):
#   gen := make(chan int); sq := make(chan int); out := make(chan int)
#   go func() { for v := range gen { sq <- v * v } }()
#   go func() { for v := range sq  { out <- v + 1 } }()
#   // each stage is its own goroutine; latency is 3 hops, throughput is 1/stage
#
rel source(payload: text) log keep(all).
rel stage1(payload: text) log keep(all).
rel stage2(payload: text) log keep(all).
rel stage3(payload: text) log keep(all).

stage1(Payload) <+ source(Payload).
stage2(Payload) <+ stage1(Payload).
stage3(Payload) <+ stage2(Payload).
