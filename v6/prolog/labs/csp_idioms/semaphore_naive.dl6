# idiom 9, THE NAIVE DRAFT -- kept because it is the receipt for error E3.
#
# This is what the author actually wrote first. It compiles clean through BOTH
# doors (bop check exit 0, oracle runs to completion) and grants ZERO leases:
# every tick of its log shows only the `acquire` arrival and nothing else.
#
# Cause: count() over an EMPTY set produces NO ROW, not 0. Before the first
# grant held_count is empty, so latest(held_count(Outstanding)) matches nothing,
# so the first lease is never granted -- and because no lease is granted the set
# stays empty forever. The semaphore is permanently closed.
#
# No refusal, no warning, no diagnostic. This is the design review's A11
# ("count never 0") biting a real program. The fix is the same base/step
# two-rule split the cursor block already needs; see semaphore.dl6.
#
rel acquire(who: text, token: int) log keep(all).
rel release(token: int)            log keep(all).
rel granted(token: int, who: text) log keep(all).

released(Token)          <- release(Token).
held(Token, Who)         <- granted(Token, Who), not(released(Token)).
held_count(count(Token)) <- held(Token, _Who).

granted(Token, Who)      <+ acquire(Who, Token), latest(held_count(Outstanding)), Outstanding < 2.
