# idiom 9: semaphore. At most K=2 concurrent leases; lease/release as rows.
#
# Go equivalent (unexecuted, the external referent):
#   sem := make(chan struct{}, 2)
#   sem <- struct{}{}          // acquire, blocks when 2 are outstanding
#   defer func() { <-sem }()   // release
#   // the channel's own capacity IS the counter; no arithmetic is written
#
# The base/step split below is FORCED, not stylistic: count() over an empty set
# yields no row, so the "nothing held yet" case cannot be expressed by the
# arithmetic rule. semaphore_naive.dl6 is the same program without the split and
# it grants zero leases, silently. Same shape as the cursor block's
# not(cursor(...)) base rule -- see the boilerplate census.
#
rel acquire(who: text, token: int) log keep(all).
rel release(token: int)            log keep(all).
rel granted(token: int, who: text) log keep(all).

released(Token)          <- release(Token).
held(Token, Who)         <- granted(Token, Who), not(released(Token)).
held_count(count(Token)) <- held(Token, _Who).

granted(Token, Who)      <+ acquire(Who, Token), not(held_count(_Any)).
granted(Token, Who)      <+ acquire(Who, Token), latest(held_count(Outstanding)), Outstanding < 2.
