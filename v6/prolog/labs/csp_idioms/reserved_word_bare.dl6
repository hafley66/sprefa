# ERROR-SURFACE PROBE (receipt E2a). Not an idiom.
#
# `subscribe` is a RESERVED surface word (compile/registry.pl:52,
# surface(subscribe/1, time, ..., reserved)). Naming an ordinary rel that way --
# the most natural name for the fan-out idiom's reader-registration rel, and the
# name this lab reached for first -- does NOT produce the named refusal. It
# produces:
#
#   dl_parse_error(statement,[114,101,97,100,95,97,116,40,...])
#
# a list of CHARACTER CODES: no word named, no file, no line, and a body running
# from the offending statement to end of file. Compare reserved_word_relatom.dl6,
# which reaches the good path.
#
rel subscribe(reader: text)        log keep(all).
rel read_at(reader: text, at: int) key(1).

read_at(Reader, 0) <+ subscribe(Reader).
