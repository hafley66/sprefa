# PROBE 1 -- deliverable 3's first question, asked of the compiler and not of
# my memory: can a declared struct type be a HOST OUTPUT column, so an ARCH
# marker's JSON payload arrives already destructurable by decode/2?
#
# The rx lowering this asks for (snippet law): the host's stdout item carries a
# nested object, the runtime interns it into the type's dictionary, and the
# column holds the ref.
#
#   const archMarker$ = demand$.pipe(
#     mergeMap(runExtract),
#     map((item) => ({ ...item, payload: internStruct(item.payload) })),
#     mergeMap(commitEdbArrival));

type arch_payload(url: text, role: text).

sh arch_marker(path: text) -> (line: int, payload: arch_payload) =
  `"$DL_COMMENT_BIN" --markers ARCH {path}`.

rel file(path: text, digest: text).
bind watch(glob: text, path: text, digest: text).
file(path, digest) <- watch('**/*.pl', path, digest).

rel marker(path: text, line: int, payload: arch_payload).
marker(path, line, payload) <-
  file(path, digest), ? arch_marker(path, line, payload) @ salt(digest: digest).

rel arch_node(path: text, line: int, url: text).
arch_node(path, line, url) <- marker(path, line, payload), decode(payload, {url: url}).
