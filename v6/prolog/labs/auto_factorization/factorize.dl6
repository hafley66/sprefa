# Depth, cohesion and the derived file prefix, expressed in dl6 and graded
# against the networkx referee.

rel dep(tail: text, head: text).
rel file_folder(path: text, folder: text).

# `prior < 64` is a termination floor, not the answer: a cycle would otherwise
# hang the fixpoint instead of arriving as a bounded wrong number.
rel reach(tail: text, head: text, hops: int).
reach(tail, head, 1) <- dep(tail, head).
reach(tail, head, hops) <-
  reach(tail, mid, prior), dep(mid, head), prior < 64, hops := prior + 1.

rel cycle_file(path: text).
cycle_file(path) <- reach(path, path, _).

rel onward_positive(path: text, depth: int).
onward_positive(path, max(hops)) <- reach(path, _, hops).

rel file_depth(path: text, depth: int).
file_depth(path, depth) <- file_folder(path, _), coalesce(onward_positive(path, depth), 0).

rel edge_pair(tail_folder: text, head_folder: text, tail: text, head: text).
edge_pair(tail_folder, head_folder, tail, head) <-
  dep(tail, head), file_folder(tail, tail_folder), file_folder(head, head_folder).

rel internal_edge(folder: text, tail: text, head: text).
internal_edge(folder, tail, head) <- edge_pair(folder, folder, tail, head).

# One crossing edge is counted by BOTH endpoint folders, which is what makes
# the per-folder ratio comparable across folders.
rel crossing_edge(folder: text, tail: text, head: text).
crossing_edge(tail_folder, tail, head) <-
  edge_pair(tail_folder, head_folder, tail, head), tail_folder \== head_folder.
crossing_edge(head_folder, tail, head) <-
  edge_pair(tail_folder, head_folder, tail, head), tail_folder \== head_folder.

rel internal_total(folder: text, edges: int).
internal_total(folder, count(tail)) <- internal_edge(folder, tail, _).

rel crossing_total(folder: text, edges: int).
crossing_total(folder, count(tail)) <- crossing_edge(folder, tail, _).

# The prefix is the DENSE RANK of a file's depth among the distinct depths its
# own folder holds. A bare rel is a set, so the two rels below dedup and the
# count is a count of distinct depths rather than of files.
rel folder_depth_seen(folder: text, depth: int).
folder_depth_seen(folder, depth) <- file_depth(path, depth), file_folder(path, folder).

rel lower_depth(path: text, other_depth: int).
lower_depth(path, other_depth) <-
  file_depth(path, depth), file_folder(path, folder),
  folder_depth_seen(folder, other_depth), other_depth < depth.

rel prefix_positive(path: text, prefix: int).
prefix_positive(path, count(other_depth)) <- lower_depth(path, other_depth).

rel file_prefix(path: text, prefix: int).
file_prefix(path, prefix) <- file_depth(path, _), coalesce(prefix_positive(path, prefix), 0).
