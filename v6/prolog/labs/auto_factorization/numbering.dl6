# Everything the lab first computed in the referee, spelled in dl6: cohesion on
# EVERY axis, modularity as an exact scaled integer, the folder-quotient depth
# the folder ordering comes from, and the hand-prefix violation check that
# classifies the rename table.
#
# Two world inputs exist because the language cannot make them, and each is a
# recorded gap rather than a convenience:
#   node_index   ordered comparison is both_number, so text keys cannot be put
#                in canonical order to dedup an undirected edge
#   hand_prefix  reading the leading digits off a filename is a string split

rel dep(tail: text, head: text).
rel file_group(axis: text, path: text, grp: text).
rel node_index(path: text, idx: int).
rel hand_prefix(path: text, prefix: int).

rel reach(tail: text, head: text, hops: int).
reach(tail, head, 1) <- dep(tail, head).
reach(tail, head, hops) <-
  reach(tail, mid, prior), dep(mid, head), prior < 64, hops := prior + 1.

rel onward_positive(path: text, depth: int).
onward_positive(path, max(hops)) <- reach(path, _, hops).

rel file_depth(path: text, depth: int).
file_depth(path, depth) <- file_group('folder', path, _), coalesce(onward_positive(path, depth), 0).

# ── cohesion on every axis ───────────────────────────────────────────────────

rel axis_edge(axis: text, tail_grp: text, head_grp: text, tail: text, head: text).
axis_edge(axis, tail_grp, head_grp, tail, head) <-
  dep(tail, head), file_group(axis, tail, tail_grp), file_group(axis, head, head_grp).

rel axis_internal(axis: text, grp: text, tail: text, head: text).
axis_internal(axis, grp, tail, head) <- axis_edge(axis, grp, grp, tail, head).

rel axis_crossing(axis: text, grp: text, tail: text, head: text).
axis_crossing(axis, tail_grp, tail, head) <-
  axis_edge(axis, tail_grp, head_grp, tail, head), tail_grp \== head_grp.
axis_crossing(axis, head_grp, tail, head) <-
  axis_edge(axis, tail_grp, head_grp, tail, head), tail_grp \== head_grp.

rel axis_internal_total(axis: text, grp: text, edges: int).
axis_internal_total(axis, grp, count(tail)) <- axis_internal(axis, grp, tail, _).

rel axis_crossing_total(axis: text, grp: text, edges: int).
axis_crossing_total(axis, grp, count(tail)) <- axis_crossing(axis, grp, tail, _).

# ── modularity, exact, as Q * 4 * m * m ──────────────────────────────────────
#
# Q = sum over groups of ( e/m - (d/2m)^2 ), so Q*4*m*m = sum of (4*m*e - d*d)
# and every term is an integer. The scale is carried out instead of dividing,
# because integer division would silently truncate every term to zero.

rel und_edge(low: int, high: int).
und_edge(first, second) <-
  dep(tail, head), node_index(tail, first), node_index(head, second), first < second.
und_edge(second, first) <-
  dep(tail, head), node_index(tail, first), node_index(head, second), second < first.

rel und_total(edges: int).
und_total(count(low)) <- und_edge(low, _).

rel incident(node: text, other_idx: int).
incident(node, high) <- und_edge(low, high), node_index(node, low).
incident(node, low) <- und_edge(low, high), node_index(node, high).

rel node_degree(node: text, degree: int).
node_degree(node, count(other_idx)) <- incident(node, other_idx).

rel member_degree(axis: text, grp: text, node: text, degree: int).
member_degree(axis, grp, node, degree) <- node_degree(node, degree), file_group(axis, node, grp).

rel axis_degree(axis: text, grp: text, degree: int).
axis_degree(axis, grp, sum(degree)) <- member_degree(axis, grp, _, degree).

rel und_internal(axis: text, grp: text, low: int, high: int).
und_internal(axis, grp, low, high) <-
  und_edge(low, high), node_index(tail, low), node_index(head, high),
  file_group(axis, tail, grp), file_group(axis, head, grp).

rel und_internal_total(axis: text, grp: text, edges: int).
und_internal_total(axis, grp, count(low)) <- und_internal(axis, grp, low, _).

# A group with no internal edge still owes its negative term. The aggregate above
# emits NO ROW for such a group rather than a zero, so the zero has to be put
# back explicitly or every sparse group silently leaves the sum.
rel axis_group(axis: text, grp: text).
axis_group(axis, grp) <- file_group(axis, _, grp).

rel und_internal_filled(axis: text, grp: text, edges: int).
und_internal_filled(axis, grp, edges) <-
  axis_group(axis, grp), coalesce(und_internal_total(axis, grp, edges), 0).

rel modularity_term(axis: text, grp: text, term: int).
modularity_term(axis, grp, term) <-
  und_internal_filled(axis, grp, internal), axis_degree(axis, grp, degree),
  und_total(edges), term := 4 * edges * internal - degree * degree.

rel modularity_scaled(axis: text, scaled: int).
modularity_scaled(axis, sum(term)) <- modularity_term(axis, _, term).

# ── folder quotient, which the folder ordering reads ─────────────────────────

rel folder_dep(tail_folder: text, head_folder: text).
folder_dep(tail_folder, head_folder) <-
  dep(tail, head), file_group('folder', tail, tail_folder),
  file_group('folder', head, head_folder), tail_folder \== head_folder.

rel folder_reach(tail_folder: text, head_folder: text, hops: int).
folder_reach(tail_folder, head_folder, 1) <- folder_dep(tail_folder, head_folder).
folder_reach(tail_folder, head_folder, hops) <-
  folder_reach(tail_folder, mid, prior), folder_dep(mid, head_folder),
  prior < 16, hops := prior + 1.

# A folder reaching itself means the quotient has no layering, so the depth
# below is a bounded wrong number for those folders and this rel says which.
rel folder_cycle(folder: text).
folder_cycle(folder) <- folder_reach(folder, folder, _).

rel folder_onward(folder: text, depth: int).
folder_onward(folder, max(hops)) <- folder_reach(folder, _, hops).

rel folder_depth(folder: text, depth: int).
folder_depth(folder, depth) <-
  file_group('folder', _, folder), coalesce(folder_onward(folder, depth), 0).

# ── the rename table's own checks ────────────────────────────────────────────

rel folder_depth_seen(folder: text, depth: int).
folder_depth_seen(folder, depth) <- file_depth(path, depth), file_group('folder', path, folder).

rel lower_depth(path: text, other_depth: int).
lower_depth(path, other_depth) <-
  file_depth(path, depth), file_group('folder', path, folder),
  folder_depth_seen(folder, other_depth), other_depth < depth.

rel prefix_positive(path: text, prefix: int).
prefix_positive(path, count(other_depth)) <- lower_depth(path, other_depth).

rel file_prefix(path: text, prefix: int).
file_prefix(path, prefix) <- file_depth(path, _), coalesce(prefix_positive(path, prefix), 0).

rel same_folder_path(tail: text, head: text).
same_folder_path(tail, head) <-
  reach(tail, head, _), file_group('folder', tail, folder), file_group('folder', head, folder).

# A dependency running uphill under the numbering: the depender claims a layer
# below something it uses.
rel hand_violation(tail: text, head: text, tail_prefix: int, head_prefix: int).
hand_violation(tail, head, tail_prefix, head_prefix) <-
  same_folder_path(tail, head),
  hand_prefix(tail, tail_prefix), hand_prefix(head, head_prefix),
  tail_prefix < head_prefix.

rel derived_violation(tail: text, head: text, tail_prefix: int, head_prefix: int).
derived_violation(tail, head, tail_prefix, head_prefix) <-
  same_folder_path(tail, head),
  file_prefix(tail, tail_prefix), file_prefix(head, head_prefix),
  tail_prefix < head_prefix.

# A file outside a folder reaching into it while the quotient is cyclic. Not a
# numbering contradiction on its own, because a cyclic quotient has no folder
# order to contradict; the cycle is the finding and these are its reach-ins.
rel cycle_reach_in(tail: text, head: text, tail_folder: text, head_folder: text).
cycle_reach_in(tail, head, tail_folder, head_folder) <-
  reach(tail, head, _),
  file_group('folder', tail, tail_folder), file_group('folder', head, head_folder),
  tail_folder \== head_folder,
  folder_cycle(tail_folder), folder_cycle(head_folder).

rel hand_agrees(path: text, prefix: int).
hand_agrees(path, prefix) <- hand_prefix(path, prefix), file_prefix(path, prefix).

rel hand_differs(path: text, hand: int, derived: int).
hand_differs(path, hand, derived) <-
  hand_prefix(path, hand), file_prefix(path, derived), hand \== derived.

# Derived depth 0 with nothing depended on inside the set while the hand number
# is above zero: a dependency the fact base may not see.
rel metric_blind(path: text, hand: int).
metric_blind(path, hand) <-
  hand_prefix(path, hand), file_depth(path, 0), hand > 0, not(dep(path, _)).
