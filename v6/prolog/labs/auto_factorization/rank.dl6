# Question 5's ranking step in the language. There is no ORDER BY and no LIMIT,
# so a rank is a COUNT of the candidates that beat this one, which is the same
# rank-by-counting shape the file prefix uses. Ties share a rank by construction.

rel candidate(cut_name: text, edge_delta: int, depth_after: int, spliced: int).

# Two ranks, because "how many beat me" and "how many BETTER SCORES exist" are
# different questions and only the second one matches the file-prefix idiom. The
# rels differ by ONE column: keying on the other candidate's NAME counts rivals,
# keying on its SCORE counts distinct scores, because a bare rel is a set.
rel beaten_by_name(cut_name: text, other_name: text).
beaten_by_name(cut_name, other_name) <-
  candidate(cut_name, edge_delta, _, _),
  candidate(other_name, other_delta, _, _),
  other_delta < edge_delta.

rel beaten_by_score(cut_name: text, other_delta: int).
beaten_by_score(cut_name, other_delta) <-
  candidate(cut_name, edge_delta, _, _),
  candidate(_, other_delta, _, _),
  other_delta < edge_delta.

rel competition_positive(cut_name: text, rank: int).
competition_positive(cut_name, count(other_name)) <- beaten_by_name(cut_name, other_name).

rel dense_positive(cut_name: text, rank: int).
dense_positive(cut_name, count(other_delta)) <- beaten_by_score(cut_name, other_delta).

rel competition_rank(cut_name: text, rank: int).
competition_rank(cut_name, rank) <-
  candidate(cut_name, _, _, _), coalesce(competition_positive(cut_name, rank), 0).

rel dense_rank(cut_name: text, rank: int).
dense_rank(cut_name, rank) <-
  candidate(cut_name, _, _, _), coalesce(dense_positive(cut_name, rank), 0).

rel best_delta(edge_delta: int).
best_delta(min(edge_delta)) <- candidate(_, edge_delta, _, _).

rel best_cut(cut_name: text, edge_delta: int).
best_cut(cut_name, edge_delta) <- candidate(cut_name, edge_delta, _, _), best_delta(edge_delta).
