# corpus 6 -- RETRY WITH BACKOFF. rx: source$.pipe(retryWhen(errors =>
#   errors.pipe(scan((attempt, _) => attempt + 1, 0), delayWhen(a => timer(a * a)))))
#
# The attempt counter is a fold; the wait is derived from it. Today: two arms
# plus the derived rule.
rel failure(job: text).
rel attempt(job: text, tries: int) key(1).
rel backoff(job: text, wait: int).

attempt(Job, 1) <+ failure(Job), not(attempt(Job, _Any)).
attempt(Job, Tries) <+ failure(Job), pre(attempt(Job, Carried)), Tries := Carried + 1.

backoff(Job, Wait) <- attempt(Job, Tries), Wait := Tries * Tries.
