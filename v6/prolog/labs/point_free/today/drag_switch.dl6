# corpus 8 -- DRAG STATE (switchMap). rx: pointerDown$.pipe(
#   switchMap(down => pointerMove$.pipe(takeUntil(pointerUp$))))
#
# Two rules and no move. switchMap's "latest inner wins" IS `key(1)`: the key
# says which rows replace which, and the two sources are two ordinary rules
# heading it. They are allowed to share the head only because they are
# triggered by DIFFERENT refs -- one shared ref would be
# edge_head_conflict_risk.
rel drag_start(pointer: text, at: int).
rel drag_move(pointer: text, at: int).
rel position(pointer: text, at: int) key(1).

position(Pointer, At) <+ drag_start(Pointer, At).
position(Pointer, At) <+ drag_move(Pointer, At).
