# corpus 7 -- RATE LIMITER. rx: request$.pipe(windowTime(1000),
#   mergeMap(w => w.pipe(take(2))))
#
# Two rules and no move. The window is a bucket column the world supplies (the
# clock_residency ruling: cadence enters as ordinary bind rows), and the cap is
# an aggregate plus a comparison. No fold, no cursor, no chain.
rel request(client: text, bucket: int, nonce: int).
rel hits(client: text, bucket: int, seen: int).
rel throttled(client: text, bucket: int).

hits(Client, Bucket, count(Nonce)) <- request(Client, Bucket, Nonce).
throttled(Client, Bucket) <- hits(Client, Bucket, Seen), Seen > 2.
