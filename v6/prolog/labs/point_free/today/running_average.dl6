# corpus 2 -- RUNNING AVERAGE, today's spelling.
#
# rx: sample$.pipe(scan(([sum, count], s) => [sum + s.value, count + 1], [0, 0]),
#                  map(([sum, count]) => sum / count))
#
# The two accumulators advance on the SAME event, so they are one fold over a
# pair, not two folds. Today that is two arms of one rule plus the derived mean.
rel sample(sensor: text, value: int).
rel running(sensor: text, total: int, seen: int) key(1).
rel mean(sensor: text, average: int).

running(Sensor, Value, 1) <+ sample(Sensor, Value), not(running(Sensor, _T, _C)).
running(Sensor, Total, Seen) <+ sample(Sensor, Value),
                                pre(running(Sensor, CarriedTotal, CarriedSeen)),
                                Total := CarriedTotal + Value,
                                Seen := CarriedSeen + 1.

mean(Sensor, Average) <- running(Sensor, Total, Seen), Average := Total / Seen.
