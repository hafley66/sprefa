# The program break/pipe_in_edge.sugar.pl claims to be sugar for: one edge
# rule, the whole chain inline. `logged` is a log rel, so the SAME ping twice
# appends twice.
rel ping(client: text, size: int).
rel logged(client: text, size: int) log keep(all).

logged(Client, Scaled) <+ ping(Client, Size), Doubled := Size * 2, Scaled := Doubled + 1.
