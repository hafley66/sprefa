# M1 probe: the same fold with `latest` in place of `pre`.
rel tick_event(counter: text, delta: int).
rel total(counter: text, amount: int) key(1).

total(Counter, Amount) <+ tick_event(Counter, Delta), not(total(Counter, _Prev)),
                          Amount := 0 + Delta.
total(Counter, Amount) <+ tick_event(Counter, Delta), latest(total(Counter, Prev)),
                          Amount := Prev + Delta.
