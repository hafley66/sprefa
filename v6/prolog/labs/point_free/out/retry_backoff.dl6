rel failure(job: text).
rel attempt(job: text, tries: int) key(1).
rel backoff(job: text, wait: int).

attempt(Job, Tries) <+ failure(Job), not(attempt(Job, _)), Tries := 0 + 1.
attempt(Job, Tries) <+ failure(Job), pre(attempt(Job, Carried)), Tries := Carried + 1.
backoff(Job, Wait) <- attempt(Job, Tries), Wait := Tries * Tries.
