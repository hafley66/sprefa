# 15_three_rel_cycle with stage_a's two rules made ADJACENT, nothing else
# changed. Isolates rule ORDER as the variable.

rel seed(value: int).
rel stage_a(value: int).
rel stage_b(value: int).
rel stage_c(value: int).

stage_a(Value) <- seed(Value).
stage_a(Value) <- stage_c(Value).
stage_b(Value) <- stage_a(Value).
stage_c(Value) <- stage_b(Value).
