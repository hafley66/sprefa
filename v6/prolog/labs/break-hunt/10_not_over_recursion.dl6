# Lead 12: not() over a RECURSIVE rel, and the retraction that should flip it
# back.

rel edge(from_node: text, to_node: text).
rel node_name(name: text).
rel reach(from_node: text, to_node: text).
rel unreachable(from_node: text, to_node: text).

reach(FromNode, ToNode) <- edge(FromNode, ToNode).
reach(FromNode, ToNode) <- reach(FromNode, MidNode), edge(MidNode, ToNode).

unreachable(FromNode, ToNode) <-
  node_name(FromNode),
  node_name(ToNode),
  not(reach(FromNode, ToNode)).
