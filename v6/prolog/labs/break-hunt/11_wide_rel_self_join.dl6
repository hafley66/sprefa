# Lead 11: a 16-column rel that joins itself.

rel wide_row(row_id: int, c01: int, c02: int, c03: int, c04: int, c05: int,
             c06: int, c07: int, c08: int, c09: int, c10: int, c11: int,
             c12: int, c13: int, c14: text, partner_id: int).
rel wide_pair(left_id: int, right_id: int, shared: text).

wide_pair(LeftId, RightId, Shared) <-
  wide_row(LeftId, _L01, _L02, _L03, _L04, _L05, _L06, _L07, _L08, _L09,
           _L10, _L11, _L12, _L13, Shared, RightId),
  wide_row(RightId, _R01, _R02, _R03, _R04, _R05, _R06, _R07, _R08, _R09,
           _R10, _R11, _R12, _R13, Shared, _RPartner).
