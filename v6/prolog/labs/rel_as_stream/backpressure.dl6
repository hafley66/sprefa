# Can the WRITER be gated on the reader watermark, so retention never needs a rule?
rel produce(payload: text) log keep(all).
rel cursor(name: text, at: int) key(1).
rel chan(ordinal: int, payload: text) log keep(all).
rel read_at(reader: text, at: int) key(1).
rel watermark(at: int) .
rel dropped(payload: text) log keep(all).

watermark(min(At)) <- read_at(_Reader, At).

cursor('chan', 1) <+ produce(_P), not(cursor('chan', _A)), latest(watermark(Mark)), Mark >= 0.
cursor('chan', Next) <+ produce(_P), pre(cursor('chan', At)), latest(watermark(Mark)),
                        Next := At + 1, Next - Mark =< 2.
chan(1, Payload) <+ produce(Payload), not(cursor('chan', _A)), latest(watermark(Mark)), Mark >= 0.
chan(Next, Payload) <+ produce(Payload), pre(cursor('chan', At)), latest(watermark(Mark)),
                       Next := At + 1, Next - Mark =< 2.
dropped(Payload) <+ produce(Payload), pre(cursor('chan', At)), latest(watermark(Mark)),
                    Next := At + 1, Next - Mark > 2.
