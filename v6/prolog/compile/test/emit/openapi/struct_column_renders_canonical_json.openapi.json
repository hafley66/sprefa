{
  "components": {
    "schemas": {
      "finding": {
        "additionalProperties":false,
        "properties": {
          "at": {"$ref":"#/components/schemas/span"},
          "path": {"type":"string"}
        },
        "required": ["path", "at" ],
        "type":"object"
      },
      "span": {
        "additionalProperties":false,
        "properties": {"end": {"type":"integer"},"start": {"type":"integer"}},
        "required": ["start", "end" ],
        "type":"object"
      },
      "touched": {
        "additionalProperties":false,
        "properties": {"path": {"type":"string"}},
        "required": ["path" ],
        "type":"object"
      }
    }
  },
  "info": {
    "description":"The served tsv2 datalog engine (v6/tsv2/serve). One program at a time; POST /program swaps it. Every response body is JSON except GET /ticks, which is an SSE stream of canonical tick-log lines.",
    "title":"sprefa tsv2 served engine",
    "version":"6.2.0"
  },
  "openapi":"3.1.0",
  "paths": {
    "/edb/events": {
      "post": {
        "operationId":"postArrivals",
        "responses": {
          "200": {"description":"HTTP 200"},
          "400": {"description":"HTTP 400"},
          "409": {"description":"HTTP 409"}
        },
        "summary":"submit signed EDB arrivals"
      }
    },
    "/idb/{rel}": {
      "get": {
        "operationId":"readRelation",
        "parameters": [
          {
            "in":"path",
            "name":"rel",
            "required":true,
            "schema": {"type":"string"}
          }
        ],
        "responses": {
          "200": {"description":"HTTP 200"},
          "404": {"description":"HTTP 404"}
        },
        "summary":"read one relation snapshot"
      }
    },
    "/openapi.json": {
      "get": {
        "operationId":"readOpenapi",
        "responses": {"200": {"description":"HTTP 200"}},
        "summary":"read the loaded program OpenAPI document"
      }
    },
    "/program": {
      "post": {
        "operationId":"loadProgram",
        "responses": {
          "200": {"description":"HTTP 200"},
          "400": {"description":"HTTP 400"}
        },
        "summary":"compile and load a DL6 program"
      }
    },
    "/stats": {
      "get": {
        "operationId":"readStats",
        "responses": {
          "200": {"description":"HTTP 200"},
          "404": {"description":"HTTP 404"}
        },
        "summary":"read process memory and SQLite storage statistics"
      }
    },
    "/ticks": {
      "get": {
        "operationId":"streamTicks",
        "responses": {
          "200": {"description":"HTTP 200"},
          "404": {"description":"HTTP 404"}
        },
        "summary":"stream tick events as SSE"
      }
    }
  },
  "servers": [ {"description":"bop serve default port","url":"http://127.0.0.1:17500"} ]
}
