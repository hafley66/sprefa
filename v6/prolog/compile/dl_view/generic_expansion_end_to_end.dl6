rel priority(low() ; high()).
rel person(id: int, name: text) key(1).
rel ticket(id: int, title: option(text)) key(1).
rel ticket_copy(id: int, title: option(text)) key(1).
rel metric(id: int, value: option(int)) key(1).
rel metric_copy(id: int, value: option(int)) key(1).
rel review(id: int, reviewer: option(person)) key(1).
rel bucket(id: int, entries: option(list(text))) key(1).
rel seen_ticket(id: int, tag: text).
rel author_audit(id: int, tag: text).
rel seen_review(id: int, name: text).
rel seen_bucket(id: int, list_id: int).

seen_ticket(Id, Tag) <- ticket(Id, Option), __opt_text_tag(Option, Tag).
author_audit(Id, Tag) <- seen_ticket(Id, Tag).
seen_review(Id, Name) <- review__reviewer(Id, PersonId), person(PersonId, Name).
seen_bucket(Id, ListId) <- bucket__entries(Id, ListId).
