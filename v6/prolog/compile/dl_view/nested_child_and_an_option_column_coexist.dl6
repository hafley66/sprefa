rel orchard(orchard_id: int).
rel orchard.tree(tree_id: int, label: option(text)).
rel planted(orchard_id: int, tree_id: int).
rel labelled(tree_id: int, state: text).

orchard(OrchardId) <- planted(OrchardId, _).
orchard__tree(TreeId, 801) <-
  orchard(Oid),
  planted(Oid, TreeId).
labelled(TreeId2, State) <-
  orchard__tree(TreeId2, LabelOption),
  __opt_text_tag(LabelOption, State).
