rel orchard(orchard_id: int).
rel orchard.tree(tree_id: int).
rel planted(orchard_id: int, tree_id: int).
rel per_orchard(orchard_id: int, trees: int).

orchard(OrchardId) <- planted(OrchardId, _).
orchard__tree(TreeId) <-
  orchard(Oid),
  planted(Oid, TreeId).
per_orchard(GroupId, count(TreeId2)) <- planted(GroupId, TreeId2).
