rel route_change(session_id, route_id) log keep(all).
rel route_row(route_id, body) set.
rel open_scope(session_id, target) key(1).

open_scope(SessionId, route_data(RouteId)) <+ only(route_change(SessionId, RouteId)).
demanded(Target, SessionId) <- open_scope(SessionId, Target).
route_view(RouteId, Body) <- demanded(route_data(RouteId), _), route_row(RouteId, Body).
