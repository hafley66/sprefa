rel fill_arrived(target, body) log keep(all).
rel open_feed(session_id, target) key(1).
rel cache_row(target, body) key(1).

demanded(Target, SessionId) <- open_feed(SessionId, Target).
cache_row(Target, Body) <+ only(fill_arrived(Target, Body)).
feed_view(Target, Body) <- demanded(Target, _), cache_row(Target, Body).
