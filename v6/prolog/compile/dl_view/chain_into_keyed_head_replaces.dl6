rel every_300(bucket) log keep(all).
rel fetch(endpoint, prev_tag, bucket, result) log keep(all).
rel demand_row(endpoint, result) log keep(all).
rel cache(endpoint, prev_tag) key(1).

demand_row(Endpoint, Result) <+
  watch(Endpoint),
  cache(Endpoint, PrevTag),
  every_300(Bucket),
  fetch(Endpoint, PrevTag, Bucket, Result).
cache(Endpoint, Tag) <+
  demand_row(Endpoint, Response),
  decode(Response, fresh(Tag, _Body)).
