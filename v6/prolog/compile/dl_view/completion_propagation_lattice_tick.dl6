rel end_a_signal(outer_id) log keep(all).
rel end_b_signal(outer_id) log keep(all).
rel end_c_signal(inner_id) log keep(all).
rel closed_outer(outer_id) log keep(all).
rel closed_inner(outer_id, inner_id) log keep(all).
rel open_outer(outer_id) key(1).
rel open_inner(outer_id, inner_id) key(1, 2).

closed_outer(OuterId) <+
  end_a_signal(OuterId),
  end_b_signal(OuterId),
  open_outer(OuterId).
live_outer(OuterId) <-
  open_outer(OuterId),
  not(closed_outer(OuterId)).
closed_inner(OuterId, InnerId) <+
  end_c_signal(InnerId),
  latest(open_inner(OuterId, InnerId)).
live_inner(OuterId, InnerId) <-
  open_inner(OuterId, InnerId),
  live_outer(OuterId),
  not(closed_inner(OuterId, InnerId)).
