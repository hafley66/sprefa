rel watch_request(col1, args, salt) log keep(all).
rel fill(args, salt, payload) log keep(all).
rel response(args, salt, payload) log keep(all).
rel demand(args, salt) set key(1, 2).

demand(Args, Salt) <+ watch_request(_, Args, Salt).
response(Args, Salt, Payload) <+ only(fill(Args, Salt, Payload)), demand(Args, Salt).
