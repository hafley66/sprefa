rel pin_extracted(from_span_id: int, to_repo_id: int, to_rev_id: int, to_path: text, kind: text) log keep(all).
rel xref(from_span_id, to_repo_id, to_rev_id, to_path, col5, kind) key(1).
rel known_repo(to_repo_id: int).

xref(FromSpanId, ToRepoId, ToRevId, ToPath, 'none', Kind) <+ pin_extracted(FromSpanId, ToRepoId, ToRevId, ToPath, Kind).
repo_candidate(ToRepoId) <- pin_extracted(_, ToRepoId, _, _, _), not(known_repo(ToRepoId)).
