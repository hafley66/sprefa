rel span(end: int, start: int).
rel source_path(path: text).
rel host_span(path: text, at: span).
rel host_start(path: text, start: int).
rel scan_span(path: text) -> (at: span).

host_span(Path, At) <-
  source_path(Path),
  scan_span(Path, At).
host_start(Path, Start) <-
  host_span(Path, At),
  decode(At, {start: Start}).

? host_start(Path, Start).
