rel resp_raw(endpoint: text, status: int, tag: text, body: text) log keep(all).

match resp_raw(Endpoint, Status, Tag, Body) (
  ; Status == 200 |-> fetch_result_fresh(Endpoint, Tag, Body)
  ; Status == 304 |-> fetch_result_unchanged(Endpoint)
  ; Status >= 400 |-> fetch_result_error(Endpoint, Status)
).
