rel worktree_edit(path: text, digest: text) log keep(all).
rel worktree_file(path, digest) key(1).
rel tree_file(rev_id: int, path: text, tree_digest: text) key(1, 2).
rel head(_repo_id: int, rev_id: int) key(1).

worktree_file(Path, Digest) <+ worktree_edit(Path, Digest).
dirty(Path) <- worktree_file(Path, WorktreeDigest), head(_RepoId, RevId), tree_file(RevId, Path, TreeDigest), WorktreeDigest \== TreeDigest.
