(: boop_lane
   (* (: lane text)
      (: branch text)
      (: goal text)
      (: spawned_ts int)))

(: boop_lane_error
   (* (: lane text)
      (: message text)))

(: Watch (* (: lane text)))

(Watch "sprefa-coordinator")

(: Lane
   (* (: lane text)
      (: branch text)))

(<- (Lane ?Lane ?Branch)
    (Watch ?Lane)
    (boop_lane ?Lane ?Branch ?Goal ?SpawnedTs))
