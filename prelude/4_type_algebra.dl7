; Structural contracts are ordinary product nodes. `Extends` answers the
; asked pairs whose check finds no failure and returns the source. Only
; asked pairs are checked: a caller or a prelude rule writes `asked`.
(Extends:
   (* (source: type)
      (contract: type)
      (return: type)))

(asked:
   (* (source: type)
      (contract: type)))

; A contract list is a declared tuple; the source must extend every position.
(ExtendsAll:
   (* (source: type)
      (contracts: any)
      (return: type)))

(asked_all:
   (* (source: type)
      (contracts: any)))

(ExtendsReason:
   (+ (missing: (*))
      (primitive: (*))
      (nested: (*))
      (sum_contract: (*))))

; Reason values are facts, so a rule reads one instead of building it.
(extends_reason:
   (* (label: str)
      (reason: ExtendsReason)))

; Every pair the walk reaches from an asked pair through same-named fields.
(candidate:
   (* (source: type)
      (contract: type)))

(same_pair:
   (* (source: type)
      (contract: type)))

(has_field:
   (* (source: type)
      (name: any)))

(primitive_contract:
   (* (contract: type)))

(primitive_mismatch:
   (* (source: type)
      (contract: type)))

(fails_at:
   (* (source: type)
      (contract: type)
      (name: any)
      (reason: ExtendsReason)))

(fails:
   (* (source: type)
      (contract: type)))

; A sum on either side is "one of these": outside the conjunctive check.
(undecided:
   (* (source: type)
      (contract: type)))

(extends_diagnostic:
   (* (source: type)
      (contract: type)
      (name: any)
      (reason: ExtendsReason)))

(missing_contract:
   (* (source: type)
      (contracts: any)))

; Intersection constructs a canonical product from two ordered edge sets.
(: Intersect
   (* (: left type)
      (: right type)
      (: return type)))

(: intersection_candidate
   (* (: left type)
      (: right type)
      (: result type)))

(: intersection_left_name
   (* (: left type)
      (: right type)
      (: name any)))

(: same_intersection_target
   (* (: left type)
      (: right type)
      (: name any)))

(: intersection_conflict
   (* (: left type)
      (: right type)
      (: name any)))

(: has_intersection_conflict
   (* (: left type)
      (: right type)))

(: valid_intersection
   (* (: left type)
      (: right type)))

(: intersection_edge_candidate
   (* (: left type)
      (: right type)
      (: side str)
      (: name any)
      (: target any)
      (: source_index int)))

(: intersection_predecessor
   (* (: left type)
      (: right type)
      (: side str)
      (: source_index int)
      (: prior_side str)
      (: prior_index int)))

(: intersection_has_predecessor
   (* (: left type)
      (: right type)
      (: side str)
      (: source_index int)))

(: intersection_rank
   (* (: left type)
      (: right type)
      (: side str)
      (: source_index int)
      (: result_index int)))

; Extend is an ordinary userland alias over intersection.
(: Extend
   (* (: base type)
      (: extension type)
      (: return type)))

; Impl evidence is authored data. The witness is checked structurally.
(: implements
   (* (: contract type)
      (: source type)
      (: witness type)))

(: valid_impl
   (* (: contract type)
      (: source type)
      (: witness type)))

(invalid_impl_edge:
   (* (contract: type)
      (source: type)
      (witness: type)
      (name: any)
      (reason: ExtendsReason)))

(extends_reason "missing" ExtendsReason.missing)
(extends_reason "primitive" ExtendsReason.primitive)
(extends_reason "nested" ExtendsReason.nested)
(extends_reason "sum_contract" ExtendsReason.sum_contract)

(primitive_contract int)
(primitive_contract float)
(primitive_contract bool)
(primitive_contract str)

; The walk reads `edge_snapshot`, never `:`: last round's edges, so a check
; answered this round reads the graph one round late. A primitive's binds
; are its namespace members, so the walk stops at a primitive contract.
(<- (candidate ?Source ?Contract)
    (asked ?Source ?Contract))

(<- (candidate ?SourceTarget ?ContractTarget)
    (candidate ?Source ?Contract)
    (not (primitive_contract ?Contract))
    (edge_snapshot ?Contract ?Name ?ContractTarget ?ContractIndex)
    (edge_snapshot ?Source ?Name ?SourceTarget ?SourceIndex))

(<- (same_pair ?Node ?Node)
    (candidate ?Node ?Node))

(<- (has_field ?Source ?Name)
    (candidate ?Source ?Contract)
    (edge_snapshot ?Source ?Name ?Target ?Index))

(<- (primitive_mismatch ?Source ?Contract)
    (candidate ?Source ?Contract)
    (primitive_contract ?Contract)
    (not (same_pair ?Source ?Contract)))

(<- (fails_at ?Source ?Contract ?Name ?Reason)
    (extends_reason "missing" ?Reason)
    (candidate ?Source ?Contract)
    (not (primitive_contract ?Contract))
    (edge_snapshot ?Contract ?Name ?ContractTarget ?ContractIndex)
    (not (has_field ?Source ?Name)))

(<- (fails_at ?Source ?Contract "" ?Reason)
    (extends_reason "primitive" ?Reason)
    (primitive_mismatch ?Source ?Contract))

(<- (fails_at ?Source ?Contract ?Name ?Reason)
    (extends_reason "nested" ?Reason)
    (candidate ?Source ?Contract)
    (edge_snapshot ?Contract ?Name ?ContractTarget ?ContractIndex)
    (edge_snapshot ?Source ?Name ?SourceTarget ?SourceIndex)
    (fails ?SourceTarget ?ContractTarget))

(<- (fails ?Source ?Contract)
    (fails_at ?Source ?Contract ?Name ?Reason))

(<- (undecided ?Source ?Contract)
    (candidate ?Source ?Contract)
    (sum ?Contract)
    (not (same_pair ?Source ?Contract)))

(<- (undecided ?Source ?Contract)
    (candidate ?Source ?Contract)
    (sum ?Source)
    (not (same_pair ?Source ?Contract)))

(<- (undecided ?Source ?Contract)
    (candidate ?Source ?Contract)
    (not (primitive_contract ?Contract))
    (edge_snapshot ?Contract ?Name ?ContractTarget ?ContractIndex)
    (edge_snapshot ?Source ?Name ?SourceTarget ?SourceIndex)
    (undecided ?SourceTarget ?ContractTarget))

(<- (Extends ?Source ?Contract ?Source)
    (asked ?Source ?Contract)
    (not (fails ?Source ?Contract))
    (not (undecided ?Source ?Contract)))

(<- (extends_diagnostic ?Source ?Contract ?Name ?Reason)
    (asked ?Source ?Contract)
    (fails_at ?Source ?Contract ?Name ?Reason))

(<- (extends_diagnostic ?Source ?Contract "" ?Reason)
    (extends_reason "sum_contract" ?Reason)
    (asked ?Source ?Contract)
    (undecided ?Source ?Contract))

; Each list position is asked on its own. A rule builds the list, so its
; positions are `:` rows; the check reads them one round later.
(<- (asked ?Source ?Contract)
    (asked_all ?Source ?Contracts)
    (edge_snapshot ?Contracts ?Position ?Contract ?Position))

(<- (missing_contract ?Source ?Contracts)
    (asked_all ?Source ?Contracts)
    (edge_snapshot ?Contracts ?Position ?Contract ?Position)
    (not (Extends ?Source ?Contract ?Source)))

(<- (ExtendsAll ?Source ?Contracts ?Source)
    (asked_all ?Source ?Contracts)
    (not (missing_contract ?Source ?Contracts)))

; Intersection application records the candidate identity before validation.
(<- (Intersect ?Left ?Right ?Result)
    (intern Intersect (tuple ?Left ?Right) ?Result)
    (valid_intersection ?Left ?Right))

(<- (Intersect ?Left ?Right ?Result)
    (intern_snapshot Intersect ?Arguments ?Result)
    (tuple ?Left ?Right ?Arguments)
    (valid_intersection ?Left ?Right))

(<- (intersection_candidate ?Left ?Right ?Result)
    (intern_snapshot Intersect ?Arguments ?Result)
    (tuple ?Left ?Right ?Arguments))

(<- (intersection_left_name ?Left ?Right ?Name)
    (intersection_candidate ?Left ?Right ?Result)
    (edge_snapshot ?Left ?Name ?Target ?Index))

(<- (same_intersection_target ?Left ?Right ?Name)
    (intersection_candidate ?Left ?Right ?Result)
    (edge_snapshot ?Left ?Name ?Target ?LeftIndex)
    (edge_snapshot ?Right ?Name ?Target ?RightIndex))

(<- (intersection_conflict ?Left ?Right ?Name)
    (intersection_candidate ?Left ?Right ?Result)
    (edge_snapshot ?Left ?Name ?LeftTarget ?LeftIndex)
    (edge_snapshot ?Right ?Name ?RightTarget ?RightIndex)
    (not (same_intersection_target ?Left ?Right ?Name)))

(<- (has_intersection_conflict ?Left ?Right)
    (intersection_conflict ?Left ?Right ?Name))

(<- (valid_intersection ?Left ?Right)
    (intersection_candidate ?Left ?Right ?Result)
    (not (has_intersection_conflict ?Left ?Right)))

(<- (intersection_edge_candidate
       ?Left ?Right "left" ?Name ?Target ?SourceIndex)
    (valid_intersection ?Left ?Right)
    (edge_snapshot ?Left ?Name ?Target ?SourceIndex))

(<- (intersection_edge_candidate
       ?Left ?Right "right" ?Name ?Target ?SourceIndex)
    (valid_intersection ?Left ?Right)
    (edge_snapshot ?Right ?Name ?Target ?SourceIndex)
    (not (intersection_left_name ?Left ?Right ?Name)))

; Within-side predecessors preserve source order.
(<- (intersection_predecessor
       ?Left ?Right "left" ?SourceIndex "left" ?PriorIndex)
    (intersection_edge_candidate
      ?Left ?Right "left" ?Name ?Target ?SourceIndex)
    (intersection_edge_candidate
      ?Left ?Right "left" ?PriorName ?PriorTarget ?PriorIndex)
    (int.lt ?PriorIndex ?SourceIndex))

(<- (intersection_predecessor
       ?Left ?Right "right" ?SourceIndex "right" ?PriorIndex)
    (intersection_edge_candidate
      ?Left ?Right "right" ?Name ?Target ?SourceIndex)
    (intersection_edge_candidate
      ?Left ?Right "right" ?PriorName ?PriorTarget ?PriorIndex)
    (int.lt ?PriorIndex ?SourceIndex))

; Every retained left edge precedes every right-only edge.
(<- (intersection_predecessor
       ?Left ?Right "right" ?SourceIndex "left" ?PriorIndex)
    (intersection_edge_candidate
      ?Left ?Right "right" ?Name ?Target ?SourceIndex)
    (intersection_edge_candidate
      ?Left ?Right "left" ?PriorName ?PriorTarget ?PriorIndex))

(<- (intersection_has_predecessor
       ?Left ?Right ?Side ?SourceIndex)
    (intersection_predecessor
      ?Left ?Right ?Side ?SourceIndex ?PriorSide ?PriorIndex))

(<- (intersection_rank
       ?Left ?Right ?Side ?SourceIndex (count ?PriorIndex))
    (intersection_predecessor
      ?Left ?Right ?Side ?SourceIndex ?PriorSide ?PriorIndex))

(<- (intersection_rank ?Left ?Right ?Side ?SourceIndex 0)
    (intersection_edge_candidate
      ?Left ?Right ?Side ?Name ?Target ?SourceIndex)
    (not (intersection_has_predecessor
           ?Left ?Right ?Side ?SourceIndex)))

(<- (: ?Result ?Name ?Target ?ResultIndex)
    (Intersect ?Left ?Right ?Result)
    (intersection_edge_candidate
      ?Left ?Right ?Side ?Name ?Target ?SourceIndex)
    (intersection_rank
      ?Left ?Right ?Side ?SourceIndex ?ResultIndex))

(<- (node ?Result)
    (Intersect ?Left ?Right ?Result))

(<- (product ?Result)
    (Intersect ?Left ?Right ?Result))

(<- (Extend ?Base ?Extension ?Result)
    (Intersect ?Base ?Extension ?Result))


; Impl witnesses are asked against their contract.
(<- (asked ?Witness ?Contract)
    (implements ?Contract ?Source ?Witness))

(<- (valid_impl ?Contract ?Source ?Witness)
    (implements ?Contract ?Source ?Witness)
    (Extends ?Witness ?Contract ?Witness))

(<- (invalid_impl_edge ?Contract ?Source ?Witness ?Name ?Reason)
    (implements ?Contract ?Source ?Witness)
    (fails_at ?Witness ?Contract ?Name ?Reason))
