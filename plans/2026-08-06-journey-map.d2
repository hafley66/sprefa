    }
    dict: ":851 dictionary table\n__id INTEGER PRIMARY KEY,\nUNIQUE(cols), __refcount" { shape: package; class: shipped; link: "${src}/v6/prolog/lower.pl#851" }
    cat: ":635-658 catalog contract,\nchild-walk index, one INSERT OR IGNORE" { shape: package; class: shipped; link: "${src}/v6/prolog/lower.pl#635" }

    dd -> tn: "names it" { style.stroke: "#c5221f"; style.stroke-width: 2 }
    dd -> dict: "a declared type" { style.stroke: "#137333" }
