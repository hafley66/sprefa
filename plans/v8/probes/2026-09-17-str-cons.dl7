; `str.cons` builds with head and tail bound and splits with the text bound;
; `str.nil` binds the empty string.
(: Name (* (: name str)))

(Name "ada")

(: Greeting (* (: greeting str)))

(<- (Greeting ?Greeting)
    (Name ?Name)
    (str.cons "hi " ?Name ?Greeting))

(: Word (* (: word str)))

(Word "hello")

(: Split (* (: head str) (: rest str)))

(<- (Split ?Head ?Rest)
    (Word ?Word)
    (str.cons ?Head ?Rest ?Word))

(: Empty (* (: empty str)))

(<- (Empty ?Empty)
    (str.nil ?Empty))
