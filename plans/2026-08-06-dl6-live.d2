s3: "supportSql[6] fill the new-row set, ONE antijoin · 146 ms · 6.4%" {
  grid-columns: 2
  grid-gap: 20
  class: cool

  sql: |`sql
  INSERT INTO "__new_reachable" ("source", "target",
    "__refcount")
  SELECT n."source", n."target", n."__refcount"
  FROM "__support_next_reachable" n
  LEFT JOIN "reachable" h
  ON n."source" = h."source" AND n."target" = h."target"
  WHERE h."source" IS NULL
  `|
  sql.class: code
  sql.link: vscode://file/Users/chrishafley/projects/sprefa-lanes/emitrace/v6/prolog/lower.pl:2386
