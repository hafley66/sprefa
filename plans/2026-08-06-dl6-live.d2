chain -> emitter: "step 3 is this file's output"

flow: "one tick, as a sequence" {
  shape: sequence_diagram

  driver: run.ts
  fold: TickFold
  module: "compiled module"
  runtime: IncrementalRuntime
  seam: SqlRunner
  db: SQLite

  driver -> fold: "3,960 edges, ONE batch"
  fold -> module: "tick(seam, arrivals)"

  arrivals: {
    module -> runtime: prepareTick
    runtime -> seam: "clear delta + next-frontier"
    seam -> db: batch
    module -> runtime: applyArrivals
    runtime -> seam: "json_each insert"
    seam -> db: "batch, 3 statements"
    db -> runtime: "3,960 edge rows staged"
  }

  the closure: {
    module -> runtime: applyLevelsBeforeEdges
    runtime -> runtime: "head on a cycle?"
    runtime -> seam: "the 11 refCount statements, ONE batch"
    seam -> db: "batch"
    db -> db: "WITH RECURSIVE, 1478 ms"
    db -> db: "antijoin into the scratch set, 146 ms"
    db -> db: "stage delta, 308 ms"
    db -> db: "stage frontier, 206 ms"
    db -> db: "fill the head, 145 ms"
    db -> runtime: "no rows cross"
  }

  the rest: {
    module -> runtime: applyEdges
    module -> runtime: recomputeLevelsAfterEdges
    runtime -> seam: "retraction guard"
    seam -> db: "EXISTS _sign = -1"
    db -> runtime: "0, so skip the reconcile"
    module -> runtime: readBoundary
    runtime -> runtime: "rel in unreadRels?"
    runtime -> module: "empty delta, rows stay in SQLite"
    module -> runtime: promoteFrontiers
    runtime -> seam: "merge next into current"
  }

  module -> fold: "ITickDeltas"
  fold -> driver: "one tick-log line"
  driver -> db: "paged checksum fold, 250k rows at a time"
  db -> driver: "1,069,200 rows, 9d7239568960d6a8"
}
emitter -> flow: "and this is the order it runs in"

legend: |~md
  ### colour on the statements below is share of the tick
  | | |
  |---|---|
  | 🟥 | 40% or more |
  | 🟧 | 10% to 40% |
  | 🟨 | 1% to 10% |
  | ⬜ | under 1% |

  Every statement below was handed to step 6 by step 5.
~|
legend.class: head
flow -> legend

s0: "supportSql[1] seed the scratch table, the recursive CTE · 1478 ms · 64.8%" {
  grid-columns: 2
  grid-gap: 20
  class: hot

  sql: |`sql
  INSERT INTO "__support_next_reachable" ("source", "target",
    "__refcount")
  WITH RECURSIVE "reachable" ("source", "target") AS (
  SELECT b0."source" AS "source", b0."target" AS "target"
  FROM "edge" b0
  UNION
  SELECT b0."source" AS "source", b1."target" AS "target"
  FROM "reachable" b0, "edge" b1
  WHERE b1."source" = b0."target")
  SELECT "source", "target", 1
  FROM "reachable"
  `|
  sql.class: code
  sql.link: vscode://file/Users/chrishafley/projects/sprefa-lanes/emitrace/v6/prolog/lower.pl:2386
  sql.tooltip: written by v6/prolog/lower.pl:2386

  runtime: |~md
    ### measured
    | | |
    |---|---|
    | wall | **1478.4 ms** · ▲ 97 ms |
    | share of tick | **64.8%** |
    | executions | 1 |
    | rows returned | 0 |
    | head rel | `reachable` |

    ### SQLite's plan for it
    - `CO-ROUTINE reachable`
    - `SETUP`
    - `SCAN b0`
    - `RECURSIVE STEP`
    - `SCAN b0`
    - `SEARCH b1 USING PRIMARY KEY (source=?)`
    - `SCAN reachable`

    ### written by
    [`v6/prolog/lower.pl:2386`](vscode://file/Users/chrishafley/projects/sprefa-lanes/emitrace/v6/prolog/lower.pl:2386)
  ~|
  runtime.class: plan
  runtime.link: vscode://file/Users/chrishafley/projects/sprefa-lanes/emitrace/v6/prolog/lower.pl:2386
}
legend -> s0

