unrun: |~md
  ### emitted but never executed on this workload
  - `supportSql[9] stage the next-frontier copy`
  - `insertSql, the delta join`
  - `boundarySql edge`
  - `boundarySql reachable`

  Every one is dead weight for `grid_10000` and live for some other program.
~|
unrun.class: cold
s9 -> unrun

schema: "the schema this tick writes into" {
  grid-columns: 2
  grid-gap: 24
  class: head

  tables: |`sql
    CREATE TABLE "edge" ("source" INTEGER NOT NULL, "target"
      INTEGER NOT NULL, PRIMARY KEY ("source", "target")) WITHOUT
      ROWID
    CREATE TABLE "reachable" ("source" INTEGER NOT NULL, "target"
      INTEGER NOT NULL, "__refcount" INTEGER NOT NULL DEFAULT 1,
      PRIMARY KEY ("source", "target")) WITHOUT ROWID
    CREATE TEMP TABLE "__delta_edge" ("_sign" INTEGER NOT NULL,
      "_sequence" INTEGER NOT NULL, "source" INTEGER NOT NULL,
      "target" INTEGER NOT NULL)
    CREATE INDEX "__delta_edge_sign"
    ON "__delta_edge" ("_sign")
    CREATE INDEX "__delta_edge_group"
    ON "__delta_edge" ("source", "target")
    CREATE TEMP TABLE "__frontier_edge" ("_phase" INTEGER NOT
      NULL, "_sequence" INTEGER NOT NULL, "source" INTEGER NOT
      NULL, "target" INTEGER NOT NULL)
    CREATE INDEX "__frontier_edge_phase"
    ON "__frontier_edge" ("_phase")
    CREATE TEMP TABLE "__next_frontier_edge" ("_phase" INTEGER NOT
      NULL, "_sequence" INTEGER NOT NULL, "source" INTEGER NOT
      NULL, "target" INTEGER NOT NULL)
  `|
  tables.class: code

  cost: |~md
    ### what every staged row pays
    7 indexes on this program, so each staged row
    costs its table write plus one btree write per index over that table.

    - `__delta_edge_sign`
    - `__delta_edge_group`
    - `__frontier_edge_phase`
    - `__delta_reachable_sign`
    - `__delta_reachable_group`
    - `__frontier_reachable_phase`
    - `reachable_zero`
  ~|
  cost.class: plan
}
unrun -> schema
