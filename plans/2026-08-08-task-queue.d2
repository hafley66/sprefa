vars: {
  d2-config: {
    layout-engine: dagre
    theme-id: 0
    pad: 20
  }
}
direction: down

classes: {
  word: { style.fill: "#fff8c5"; style.stroke: "#9a6700"; style.font-color: "#6f5500" }
  lane: { style.fill: "#ddf4ff"; style.stroke: "#0969da"; style.font-color: "#0a3069" }
  gatebox: { style.fill: "#dafbe1"; style.stroke: "#1a7f37"; style.font-color: "#116329" }
  prizebox: { style.fill: "#ffeff7"; style.stroke: "#bf3989"; style.font-color: "#99286e" }
  side: { style.fill: "#eef1f4"; style.stroke: "#57606a"; style.font-color: "#1f2328" }
  code: { style.fill: "#f6f8fa"; style.stroke: "#d0d7de"; style.font-color: "#1f2328" }
}

legend: {
  near: top-right
  grid-rows: 4
  grid-gap: 4
  a: "your word" { class: word; width: 190 }
  b: "lane / agent work" { class: lane; width: 190 }
  c: "gate" { class: gatebox; width: 190 }
  d: "measured payoff" { class: prizebox; width: 190 }
}

s1: "1. DONE 2026-08-08" {
  merge: "PR #17 merged (b4431308):\ninterning phase 1 on main,\nsnake_case collision resolved,\nall gates re-run green" { class: side }
  cull: "race/ culled, one sweep;\nflash+terra logs salvaged\nto plans/" { class: side }
}

s2: "2. contract rev 3.1 (planner)" {
  defects: "fold opus's 7 filed defects; re-scope I-F; record direct default" {
    class: lane
    ex: |`text
      defect example: namespace check
      placed AFTER expansion would
      refuse the compiler's own
      __host_demand_* heads
    `| { class: code }
  }
}

s3: "3. remaining interning lanes (two-pass each)" {
  ic: "I-C literals: quoted strings intern at boot, reads + writes" {
    class: lane
    ex: |`sql
      -- before: id = text, matches NOTHING
      WHERE "kind" = 'warning'
      -- after: boot interned 'warning' = 7
      WHERE "kind" = 7
    `| { class: code }
  }
  ik: "I-K built strings: intern on write" {
    class: lane
    ex: |`sql
      -- Count || ' hits' built at runtime:
      INSERT OR IGNORE INTO __str
        SELECT DISTINCT (cnt || ' hits') ...;
      -- head row then JOINs __str for the id
    `| { class: code }
  }
  itel: "I-F/I-G telemetry: dictionary watched from in-language" {
    class: lane
    ex: |`text
      __str_stats(tick, rows, bytes,
                  interned, looked_up)
      "did it stop growing when
       ingest went quiet?" = a query
    `| { class: code }
  }
}

s4: "4. the flip" {
  flip: "default_intern_mode -> dict" {
    class: lane
    ex: |`prolog
      % the entire flip:
      default_intern_mode(direct).
      % becomes
      default_intern_mode(dict).
    `| { class: code }
  }
  referee: "final referee:\nfull 211-schedule sweep\nEXECUTING under dict,\nwrong=0" { class: gatebox }
}

s5: "5. collect the speed (tsv2 endgame)" {
  heads: "I-E rowid+unique heads: sub-1,000 grid, chain-tail attack" {
    class: lane
    ex: |`sql
      -- head today (deep key btree):
      PRIMARY KEY (a,b,c) WITHOUT ROWID
      -- after (append + range delta):
      id INTEGER PRIMARY KEY, UNIQUE(a,b,c)
    `| { class: code }
  }
  bench: "bench rerun: 1.7-2.0x\ncollected, FACTS updated\n(86% of keyed tables)" { class: prizebox }
}

s6: "6. rust track (opens after 5)" {
  p1b: "P1-B: TS reference\ninterpreter (referee)" { class: lane }
  p1c: "P1-C: rust executor + one-shot CLI" {
    class: lane
    ex: |`bash
      # souffle mode, no server:
      sprefa-fixpoint run \
        --ir reach.fixpointIr.json \
        --facts edges.jsonl
    `| { class: code }
  }
  lab: "P1-D-T row transport lab:\naddon / pipes / shm / socket" { class: lane }
  seam: "P1-D: runtime seam,\nfourth dispatch arm" { class: lane }
  forced: "P1-E: forced-offload sweep,\n211 byte-identical" { class: gatebox }
}

s7: "7. endgame" {
  codegen: "compiled mode: per-program rust from the same IR, retraction included" {
    class: lane
    ex: |`rust
      // generated for THIS program only:
      fn hop(wave: &FxHashSet<(i64,i64)>,
             edge: &Edge) { /* ... */ }
      // no interpreter, no 18% tax
    `| { class: code }
  }
  dd: "vs differential-dataflow\non retraction schedules;\noracle referees" { class: prizebox }
}

anytime: "anytime, no dependency" {
  ci: "release-workflow CI:\nflash lane dispatched" { class: lane }
  pack: "pack1 follow-ups: libexec\nlayout, module trim,\nbun:sqlite" { class: side }
  debur: "debur: dead recompute code,\ngen-index flip (coordinator)" { class: lane }
}

v5: "v5 items, expanded: each is one word from you" {
  roots: "orphan db roots: rm 3, frees 1.86GB" {
    class: word
    ex: |`text
      'dl daemon health' already prints:
      "3 orphan roots, 1.86GB, no daemon
       nor .dl file references them"
      yes = one rm, nothing referenced
    `| { class: code }
  }
  port: "drop rel_port_of_reach + VACUUM" {
    class: word
    ex: |`text
      dead rel's table still on disk;
      drop + VACUUM reclaims 15.5MB.
      yes = 2 statements, one-time
    `| { class: code }
  }
  lazy: "lazy-rel-tier: wake or keep parked" {
    class: word
    ex: |`text
      plan 2026-07-19: rels nobody read
      recently stop being maintained,
      recompute on next demand.
      yes = a real lane, not a chore
    `| { class: code }
  }
  fsize: "filesize rail: 29 files > 500 lines" {
    class: word
    ex: |`text
      decide: a .dl rail failing new
      500+ files (waivers allowed),
      or drop the idea. 29 existing
      would need waive-or-split calls
    `| { class: code }
  }
  dmatch: "instant dom-match.dl rewrite:\nschedule or park" { class: word }
}

v6note: |||md
  ## when to expand the v6 side of this diagram
  Trigger: the FLIP lands (stage 4 referee green).
  Then redraw stages 5-7 at lane grain:

  | expand | into |
  |---|---|
  | stage 5 | I-E head shapes per rel family + bench cases |
  | stage 6 | transport lab candidates w/ measured rows/s |
  | stage 7 | codegen walk-by-walk vs DD schedule table |

  Also fold in: telemetry queries as .dl snippets once
  I-F/I-G land, and the anim board (cytoscape <-> d2)
  when ~/projects/anim is ready for the queue to live there.
|||
v6note.shape: rectangle
v6note.class: side

s1.merge -> s2.defects
s2.defects -> s3.ic
s2.defects -> s3.itel
s3.ic -> s4.flip
s3.ik -> s4.flip
s3.itel -> s4.flip
s4.flip -> s4.referee
s4.referee -> s5.heads
s5.heads -> s5.bench
s5.bench -> s6.p1b: "tsv2-first gate opens"
s6.p1b -> s6.p1c
s6.p1c -> s6.lab
s6.lab -> s6.seam
s6.seam -> s6.forced
s6.forced -> s7.codegen
s7.codegen -> s7.dd
