{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "sprf",
  "scopeName": "source.sprf",
  "patterns": [
    { "include": "#comment"          },
    { "include": "#dsl-re"           },
    { "include": "#dsl-glob"         },
    { "include": "#dsl-ast-yaml"     },
    { "include": "#dsl-ast"          },
    { "include": "#dsl-json"         },
    { "include": "#dsl-markdown"     },
    { "include": "#dsl-plain"        },
    { "include": "#atom"             },
    { "include": "#number"           },
    { "include": "#predicate-suffix" },
    { "include": "#op-name"          },
    { "include": "#chain-separator"  },
    { "include": "#fork-separator"   },
    { "include": "#delimiters"       }
  ],
  "repository": {
    "comment": {
      "match": "#.*$",
      "name":  "comment.line.number-sign.sprf"
    },

    "hole": {
      "match": "\\$\\{([A-Za-z_][A-Za-z0-9_]*)(\\??)\\}",
      "name":  "meta.embedded.hole.sprf",
      "captures": {
        "1": { "name": "variable.other.capture.sprf"   },
        "2": { "name": "keyword.operator.unbound.sprf" }
      }
    },

    "dsl-re": {
      "begin":         "\\b(re)(\\?)?(`)",
      "end":           "`",
      "beginCaptures": {
        "1": { "name": "entity.name.function.op.dsl-tag.re.sprf"     },
        "2": { "name": "keyword.operator.predicate.sprf"             },
        "3": { "name": "punctuation.definition.string.begin.dsl.sprf" }
      },
      "endCaptures":   { "0": { "name": "punctuation.definition.string.end.dsl.sprf" } },
      "name":          "string.regexp.dsl.re.sprf",
      "contentName":   "string.regexp.dsl.re.sprf",
      "patterns": [
        { "include": "#hole"     },
        { "include": "#re-body"  }
      ]
    },
    "re-body": {
      "patterns": [
        { "match": "\\\\.",                 "name": "constant.character.escape.regexp.sprf"  },
        { "match": "\\(\\?P?<[^>]+>",       "name": "entity.name.function.capture.regexp.sprf" },
        { "match": "\\(\\?[:=!]",           "name": "punctuation.definition.group.regexp.sprf" },
        { "match": "[()|]",                 "name": "keyword.operator.regexp.sprf"           },
        { "match": "\\[\\^?",               "name": "punctuation.character.class.regexp.sprf" },
        { "match": "\\]",                   "name": "punctuation.character.class.regexp.sprf" },
        { "match": "[*+?]\\??",             "name": "keyword.operator.quantifier.regexp.sprf" },
        { "match": "\\{\\d+(?:,\\d*)?\\}",  "name": "keyword.operator.quantifier.regexp.sprf" },
        { "match": "[\\^$]",                "name": "keyword.operator.anchor.regexp.sprf"    },
        { "match": "\\.",                   "name": "constant.character.wildcard.regexp.sprf" }
      ]
    },

    "dsl-glob": {
      "begin":         "\\b(glob)(\\?)?(`)",
      "end":           "`",
      "beginCaptures": {
        "1": { "name": "entity.name.function.op.dsl-tag.glob.sprf"   },
        "2": { "name": "keyword.operator.predicate.sprf"             },
        "3": { "name": "punctuation.definition.string.begin.dsl.sprf" }
      },
      "endCaptures":   { "0": { "name": "punctuation.definition.string.end.dsl.sprf" } },
      "name":          "string.unquoted.dsl.glob.sprf",
      "contentName":   "string.unquoted.dsl.glob.sprf",
      "patterns": [
        { "include": "#hole" },
        { "match": "\\*\\*",                          "name": "keyword.operator.globstar.glob.sprf"      },
        { "match": "[*?]",                            "name": "keyword.operator.wildcard.glob.sprf"      },
        { "match": "\\{[^}]*\\}",                     "name": "string.unquoted.alternation.glob.sprf"    },
        { "match": "\\[!?[^\\]]*\\]",                 "name": "constant.other.character-class.glob.sprf" },
        { "match": "<[A-Za-z_][A-Za-z0-9_]*>",        "name": "entity.name.function.capture.glob.sprf"   },
        { "match": "/",                               "name": "punctuation.separator.path.glob.sprf"     }
      ]
    },

    "dsl-ast": {
      "begin":         "\\b(ast)(\\[[^\\]]*\\])?(\\?)?(`)",
      "end":           "`",
      "beginCaptures": {
        "1": { "name": "entity.name.function.op.dsl-tag.ast.sprf"     },
        "2": { "name": "support.type.language-arg.ast.sprf"           },
        "3": { "name": "keyword.operator.predicate.sprf"              },
        "4": { "name": "punctuation.definition.string.begin.dsl.sprf" }
      },
      "endCaptures":   { "0": { "name": "punctuation.definition.string.end.dsl.sprf" } },
      "name":          "string.template.dsl.ast.sprf",
      "contentName":   "string.template.dsl.ast.sprf",
      "patterns": [
        { "include": "#hole" },
        { "match": "\\$\\$\\$[A-Za-z_][A-Za-z0-9_]*", "name": "variable.parameter.metavar-rest.ast.sprf" },
        { "match": "\\$[A-Za-z_][A-Za-z0-9_]*",       "name": "variable.parameter.metavar.ast.sprf"      }
      ]
    },

    "dsl-ast-yaml": {
      "begin":         "\\b(ast_yaml)(\\s*\\(\\s*:[A-Za-z_][A-Za-z0-9_]*\\s*\\))?(\\?)?(`)",
      "end":           "`",
      "beginCaptures": {
        "1": { "name": "entity.name.function.op.dsl-tag.ast-yaml.sprf" },
        "2": { "name": "support.type.language-arg.ast-yaml.sprf"       },
        "3": { "name": "keyword.operator.predicate.sprf"                },
        "4": { "name": "punctuation.definition.string.begin.dsl.sprf"   }
      },
      "endCaptures":   { "0": { "name": "punctuation.definition.string.end.dsl.sprf" } },
      "name":          "source.yaml.embedded.ast-yaml.sprf",
      "contentName":   "source.yaml.embedded.ast-yaml.sprf",
      "patterns": [
        { "include": "#hole" },
        { "match": "\\$\\$\\$[A-Za-z_][A-Za-z0-9_]*", "name": "variable.parameter.metavar-rest.ast-yaml.sprf" },
        { "match": "\\$[A-Za-z_][A-Za-z0-9_]*",       "name": "variable.parameter.metavar.ast-yaml.sprf"      },
        { "match": "^\\s*([A-Za-z_][A-Za-z0-9_-]*)\\s*:", "captures": { "1": { "name": "entity.name.tag.yaml.sprf" } } },
        { "match": "\"(?:\\\\.|[^\"\\\\])*\"",        "name": "string.quoted.double.yaml.sprf" },
        { "match": "'(?:''|[^'])*'",                   "name": "string.quoted.single.yaml.sprf" },
        { "match": "\\b(?:true|false|null)\\b",        "name": "constant.language.yaml.sprf" },
        { "match": "-?\\b\\d+(?:\\.\\d+)?\\b",         "name": "constant.numeric.yaml.sprf" },
        { "match": "[-]\\s",                           "name": "punctuation.definition.list.yaml.sprf" },
        { "match": ":",                                "name": "punctuation.separator.key-value.yaml.sprf" }
      ]
    },

    "dsl-json": {
      "begin":         "\\b(json)(\\?)?(`)",
      "end":           "`",
      "beginCaptures": {
        "1": { "name": "entity.name.function.op.dsl-tag.json.sprf"    },
        "2": { "name": "keyword.operator.predicate.sprf"              },
        "3": { "name": "punctuation.definition.string.begin.dsl.sprf" }
      },
      "endCaptures":   { "0": { "name": "punctuation.definition.string.end.dsl.sprf" } },
      "name":          "string.template.dsl.json.sprf",
      "contentName":   "string.template.dsl.json.sprf",
      "patterns": [
        { "include": "#hole" },
        { "match": "\"(?:\\\\.|[^\"\\\\])*\"",        "name": "string.quoted.double.json.sprf"   },
        { "match": "\\b(?:true|false|null)\\b",       "name": "constant.language.json.sprf"      },
        { "match": "-?\\b\\d+(?:\\.\\d+)?(?:[eE][-+]?\\d+)?\\b", "name": "constant.numeric.json.sprf" },
        { "match": "[{}\\[\\]]",                      "name": "punctuation.bracket.json.sprf"    },
        { "match": "[,:]",                            "name": "punctuation.separator.json.sprf"  }
      ]
    },

    "dsl-markdown": {
      "begin":         "\\b(?:(render_markdown)|(render\\.markdown)|(render)(\\s*\\(\\s*:markdown\\s*\\)))(`)",
      "end":           "`",
      "beginCaptures": {
        "1": { "name": "entity.name.function.op.dsl-tag.render-markdown.sprf" },
        "2": { "name": "entity.name.function.op.dsl-tag.render-markdown.sprf" },
        "3": { "name": "entity.name.function.op.dsl-tag.render.sprf"          },
        "4": { "name": "support.type.format.markdown.sprf"                    },
        "5": { "name": "punctuation.definition.string.begin.dsl.sprf"         }
      },
      "endCaptures":   { "0": { "name": "punctuation.definition.string.end.dsl.sprf" } },
      "name":          "markup.raw.markdown.dsl.sprf",
      "contentName":   "markup.raw.markdown.dsl.sprf",
      "patterns": [
        { "include": "#hole" },
        { "match": "^(\\s*)(#{1,6})(\\s+.*)?$", "captures": {
          "1": { "name": "punctuation.whitespace.heading.markdown.sprf" },
          "2": { "name": "markup.heading.markdown.sprf" },
          "3": { "name": "markup.heading.markdown.sprf" }
        }},
        { "match": "^(\\s*)([-*+])(\\s+)", "captures": {
          "1": { "name": "punctuation.whitespace.list.markdown.sprf" },
          "2": { "name": "punctuation.definition.list.begin.markdown.sprf" },
          "3": { "name": "punctuation.whitespace.list.markdown.sprf" }
        }},
        { "match": "(```|~~~).*$", "name": "markup.fenced_code.block.markdown.sprf" },
        { "match": "\\|", "name": "punctuation.separator.table.markdown.sprf" },
        { "match": "\\*\\*[^*]+\\*\\*", "name": "markup.bold.markdown.sprf" },
        { "match": "`[^`]+`", "name": "markup.inline.raw.markdown.sprf" }
      ]
    },

    "dsl-plain": {
      "begin":         "`",
      "end":           "`",
      "beginCaptures": { "0": { "name": "punctuation.definition.string.begin.dsl.sprf" } },
      "endCaptures":   { "0": { "name": "punctuation.definition.string.end.dsl.sprf"   } },
      "name":          "string.template.plain.sprf",
      "contentName":   "string.template.plain.sprf",
      "patterns": [
        { "include": "#hole" },
        { "match": "\\\\.", "name": "constant.character.escape.sprf" }
      ]
    },

    "atom": {
      "match": ":[A-Za-z_][A-Za-z0-9_]*(?:\\.[A-Za-z_][A-Za-z0-9_]*)*",
      "name":  "constant.other.atom.sprf"
    },

    "number": {
      "match": "-?\\b\\d+(?:\\.\\d+)?\\b",
      "name":  "constant.numeric.sprf"
    },

    "predicate-suffix": {
      "match": "([A-Za-z_][A-Za-z0-9_]*)(\\?)(?=[\\[(`]|\\s*\\{)",
      "captures": {
        "1": { "name": "entity.name.function.op.sprf"        },
        "2": { "name": "keyword.operator.predicate.sprf"     }
      }
    },

    "op-name": {
      "match": "\\b([A-Za-z_][A-Za-z0-9_]*)(?=\\??[\\[(`]|\\s*\\{)",
      "captures": {
        "1": { "name": "entity.name.function.op.sprf" }
      }
    },

    "chain-separator": {
      "match": ">",
      "name":  "keyword.operator.chain.sprf"
    },

    "fork-separator": {
      "match": ";",
      "name":  "punctuation.terminator.sprf"
    },

    "delimiters": {
      "patterns": [
        { "match": "[\\[\\]]", "name": "punctuation.bracket.square.sprf" },
        { "match": "[()]",     "name": "punctuation.bracket.round.sprf"  },
        { "match": "[{}]",     "name": "punctuation.bracket.curly.sprf"  },
        { "match": ",",        "name": "punctuation.separator.comma.sprf" }
      ]
    }
  }
}
