{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/grammar.schema.json",
  "name": "sprefa",
  "word": "identifier",
  "rules": {
    "source_file": {
      "type": "REPEAT",
      "content": {
        "type": "SYMBOL",
        "name": "_stmt"
      }
    },
    "_stmt": {
      "type": "SEQ",
      "members": [
        {
          "type": "SYMBOL",
          "name": "pipe"
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "STRING",
              "value": ";"
            },
            {
              "type": "BLANK"
            }
          ]
        }
      ]
    },
    "pipe": {
      "type": "SEQ",
      "members": [
        {
          "type": "SYMBOL",
          "name": "_pipe_step"
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "SEQ",
            "members": [
              {
                "type": "STRING",
                "value": ">"
              },
              {
                "type": "SYMBOL",
                "name": "_pipe_step"
              }
            ]
          }
        }
      ]
    },
    "_pipe_step": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "op_invocation"
        },
        {
          "type": "SYMBOL",
          "name": "dsl_body"
        }
      ]
    },
    "op_invocation": {
      "type": "PREC",
      "value": 1,
      "content": {
        "type": "SEQ",
        "members": [
          {
            "type": "FIELD",
            "name": "name",
            "content": {
              "type": "SYMBOL",
              "name": "identifier"
            }
          },
          {
            "type": "CHOICE",
            "members": [
              {
                "type": "FIELD",
                "name": "predicate",
                "content": {
                  "type": "STRING",
                  "value": "?"
                }
              },
              {
                "type": "BLANK"
              }
            ]
          },
          {
            "type": "REPEAT",
            "content": {
              "type": "FIELD",
              "name": "bracket",
              "content": {
                "type": "SYMBOL",
                "name": "bracket_slot"
              }
            }
          },
          {
            "type": "CHOICE",
            "members": [
              {
                "type": "FIELD",
                "name": "paren",
                "content": {
                  "type": "SYMBOL",
                  "name": "paren_slot"
                }
              },
              {
                "type": "BLANK"
              }
            ]
          },
          {
            "type": "CHOICE",
            "members": [
              {
                "type": "FIELD",
                "name": "dsl",
                "content": {
                  "type": "SYMBOL",
                  "name": "dsl_body"
                }
              },
              {
                "type": "BLANK"
              }
            ]
          },
          {
            "type": "CHOICE",
            "members": [
              {
                "type": "FIELD",
                "name": "brace",
                "content": {
                  "type": "SYMBOL",
                  "name": "brace_slot"
                }
              },
              {
                "type": "BLANK"
              }
            ]
          }
        ]
      }
    },
    "bracket_slot": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "["
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SYMBOL",
              "name": "_slot_body"
            },
            {
              "type": "BLANK"
            }
          ]
        },
        {
          "type": "STRING",
          "value": "]"
        }
      ]
    },
    "paren_slot": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "("
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SYMBOL",
              "name": "_slot_body"
            },
            {
              "type": "BLANK"
            }
          ]
        },
        {
          "type": "STRING",
          "value": ")"
        }
      ]
    },
    "brace_slot": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "{"
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SYMBOL",
              "name": "_slot_body"
            },
            {
              "type": "BLANK"
            }
          ]
        },
        {
          "type": "STRING",
          "value": "}"
        }
      ]
    },
    "dsl_body": {
      "type": "TOKEN",
      "content": {
        "type": "SEQ",
        "members": [
          {
            "type": "STRING",
            "value": "`"
          },
          {
            "type": "PATTERN",
            "value": "[^`]*"
          },
          {
            "type": "STRING",
            "value": "`"
          }
        ]
      }
    },
    "_slot_body": {
      "type": "REPEAT1",
      "content": {
        "type": "SYMBOL",
        "name": "_slot_atom"
      }
    },
    "_slot_atom": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "op_invocation"
        },
        {
          "type": "SYMBOL",
          "name": "string_literal"
        },
        {
          "type": "SYMBOL",
          "name": "raw_string_literal"
        },
        {
          "type": "SYMBOL",
          "name": "atom_literal"
        },
        {
          "type": "SYMBOL",
          "name": "dsl_body"
        },
        {
          "type": "SYMBOL",
          "name": "identifier"
        },
        {
          "type": "SYMBOL",
          "name": "number_literal"
        },
        {
          "type": "SYMBOL",
          "name": "_slot_punct"
        },
        {
          "type": "SYMBOL",
          "name": "_balanced_braces"
        },
        {
          "type": "SYMBOL",
          "name": "_balanced_parens"
        },
        {
          "type": "SYMBOL",
          "name": "_balanced_brackets"
        }
      ]
    },
    "_balanced_braces": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "{"
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SYMBOL",
              "name": "_slot_body"
            },
            {
              "type": "BLANK"
            }
          ]
        },
        {
          "type": "STRING",
          "value": "}"
        }
      ]
    },
    "_balanced_parens": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "("
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SYMBOL",
              "name": "_slot_body"
            },
            {
              "type": "BLANK"
            }
          ]
        },
        {
          "type": "STRING",
          "value": ")"
        }
      ]
    },
    "_balanced_brackets": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "["
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SYMBOL",
              "name": "_slot_body"
            },
            {
              "type": "BLANK"
            }
          ]
        },
        {
          "type": "STRING",
          "value": "]"
        }
      ]
    },
    "_slot_punct": {
      "type": "TOKEN",
      "content": {
        "type": "PREC",
        "value": -1,
        "content": {
          "type": "CHOICE",
          "members": [
            {
              "type": "STRING",
              "value": ","
            },
            {
              "type": "STRING",
              "value": "."
            },
            {
              "type": "STRING",
              "value": ":"
            },
            {
              "type": "STRING",
              "value": ";"
            },
            {
              "type": "STRING",
              "value": "/"
            },
            {
              "type": "STRING",
              "value": "\\"
            },
            {
              "type": "STRING",
              "value": "+"
            },
            {
              "type": "STRING",
              "value": "-"
            },
            {
              "type": "STRING",
              "value": "*"
            },
            {
              "type": "STRING",
              "value": "="
            },
            {
              "type": "STRING",
              "value": "!"
            },
            {
              "type": "STRING",
              "value": "?"
            },
            {
              "type": "STRING",
              "value": "|"
            },
            {
              "type": "STRING",
              "value": "^"
            },
            {
              "type": "STRING",
              "value": "%"
            },
            {
              "type": "STRING",
              "value": "@"
            },
            {
              "type": "STRING",
              "value": "~"
            },
            {
              "type": "STRING",
              "value": "&"
            },
            {
              "type": "STRING",
              "value": "<"
            },
            {
              "type": "STRING",
              "value": ">"
            },
            {
              "type": "STRING",
              "value": "$"
            }
          ]
        }
      }
    },
    "atom_literal": {
      "type": "TOKEN",
      "content": {
        "type": "SEQ",
        "members": [
          {
            "type": "STRING",
            "value": ":"
          },
          {
            "type": "PATTERN",
            "value": "[A-Za-z_][A-Za-z0-9_]*"
          }
        ]
      }
    },
    "string_literal": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "\""
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "CHOICE",
            "members": [
              {
                "type": "PATTERN",
                "value": "[^\"\\\\]+"
              },
              {
                "type": "SEQ",
                "members": [
                  {
                    "type": "STRING",
                    "value": "\\"
                  },
                  {
                    "type": "PATTERN",
                    "value": "."
                  }
                ]
              }
            ]
          }
        },
        {
          "type": "STRING",
          "value": "\""
        }
      ]
    },
    "raw_string_literal": {
      "type": "TOKEN",
      "content": {
        "type": "CHOICE",
        "members": [
          {
            "type": "SEQ",
            "members": [
              {
                "type": "STRING",
                "value": "r\""
              },
              {
                "type": "PATTERN",
                "value": "[^\"]*"
              },
              {
                "type": "STRING",
                "value": "\""
              }
            ]
          },
          {
            "type": "SEQ",
            "members": [
              {
                "type": "STRING",
                "value": "r#\""
              },
              {
                "type": "PATTERN",
                "value": "([^\"]|\"[^#])*"
              },
              {
                "type": "STRING",
                "value": "\"#"
              }
            ]
          },
          {
            "type": "SEQ",
            "members": [
              {
                "type": "STRING",
                "value": "r##\""
              },
              {
                "type": "PATTERN",
                "value": "([^\"]|\"[^#]|\"#[^#])*"
              },
              {
                "type": "STRING",
                "value": "\"##"
              }
            ]
          }
        ]
      }
    },
    "number_literal": {
      "type": "TOKEN",
      "content": {
        "type": "CHOICE",
        "members": [
          {
            "type": "PATTERN",
            "value": "-?\\d+"
          },
          {
            "type": "PATTERN",
            "value": "-?\\d+\\.\\d+"
          }
        ]
      }
    },
    "identifier": {
      "type": "PATTERN",
      "value": "[A-Za-z_][A-Za-z0-9_]*"
    },
    "line_comment": {
      "type": "TOKEN",
      "content": {
        "type": "SEQ",
        "members": [
          {
            "type": "STRING",
            "value": "#"
          },
          {
            "type": "PATTERN",
            "value": "[^\\n]*"
          }
        ]
      }
    }
  },
  "extras": [
    {
      "type": "PATTERN",
      "value": "\\s+"
    },
    {
      "type": "SYMBOL",
      "name": "line_comment"
    }
  ],
  "conflicts": [
    [
      "op_invocation",
      "_slot_atom"
    ],
    [
      "op_invocation"
    ]
  ],
  "precedences": [],
  "externals": [],
  "inline": [],
  "supertypes": [],
  "reserved": {}
}