# every DSL covered + host syntax. Open in VS Code with the v4
# extension installed; tmGrammar should render this without LSP help.
#
# v4 host syntax rules:
#   1. Strings = backticks only. No `"..."`, no `r#"..."#`.
#   2. `${X}` is template-literal interpolation — valid ONLY inside a
#      backtick body. Outside, use barewords or `:atom`.
#   3. Slot openers `?`, `[`, `(`, `` ` `` must immediately follow the
#      op name (no whitespace). Block `{ … }` is the only space-OK slot.
#   4. Top-level statements are `;`-terminated. Pipes inside `( … )`
#      grouping or `{ … }` blocks are NOT terminated; only the outer
#      statement is.
#   5. Bareword in arg position desugars by case:
#        ALL_CAPS   → `term(:CAPS)`        (read existing capture)
#        ALL_CAPS?  → `term_bind(:CAPS)`   (introduce / bind capture)
#        lower-case → `Value::Atom`         (named atom)

rule(:greet, NAME?, DAY?) {
    `hello ${NAME}, today is ${DAY}`
};

# regex DSL — captures (?P<NAME>) + alternation + escapes
re`\b(?P<WORD>[a-zA-Z]+)\s+\d+\b`;

# glob DSL — globstar, alternation, char-class, capture
glob`**/<DIR>/*.{ts,tsx,rs}`;

# ast-grep DSL with [lang] arg, $METAVAR + $$$REST
ast`fn $NAME($$$ARGS) -> $RET { $$$BODY }`;

# json DSL — structural shape
json`{ "kind": "User", "id": ${UID}, "tags": [ ] }`;

# bare backticks at pipe-step = `str` op sugar; X? introduces capture X
rule(:x, X?) { `plain template with ${X} hole` };

# atoms, barewords, predicate-suffix, fork; UID reads an existing capture
fact?(:user, UID, `alice`);

# pipe — ALL_CAPS barewords flow as term refs/binders at host level
glob`**/*.rs` > re`fn (?P<NAME>\w+)` > fact(:rust_fn, NAME);

# parens — host-level grouping. Inner pipe steps inline into the outer.
( glob`**/*.rs` > re`fn (?P<NAME>\w+)` ) > fact(:rust_fn, NAME);
