# Discover support branch/tag revisions with rev(glob`...`) and query them.
#
# Requires configured repos in sprefa config.
#
# Run:
#   cargo run --manifest-path v4/Cargo.toml --bin sprefa-run -- \
#     v4/examples/rev-glob-support-tags.sprf --root . --show-rows

rule(:support_revs, REPO?, PATCH?, REV?, NAME?, KIND?, COMMIT_TS?);

repo()
  > rev(glob`support/0.1.${PATCH?}`)
  > support_revs(REPO, PATCH, REV, NAME, KIND, COMMIT_TS);

support_revs?(REPO?, PATCH?, REV?, NAME?, KIND?, COMMIT_TS?)
  > render.markdown`- ${REPO} ${KIND} ${NAME}: patch ${PATCH}, ${REV}, ${COMMIT_TS}
`;
