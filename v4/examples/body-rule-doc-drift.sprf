# Body-style docs drift check.
#
# Body rules derive the relation tables. The final query joins them.
#
# Run:
#   cargo run --manifest-path v4/Cargo.toml --bin sprefa-run -- \
#     v4/examples/body-rule-doc-drift.sprf --root . --show-rows

rule(:expected_docs, DOC?) {
  `v4-rule-query-semantics.md
v4-sql-rule-query-plan.md
v4-runtime-batching.md
v4-made-up-required-doc.md`
    > split(DOC?)`
`
};

rule(:actual_docs, DOC?) {
  sh`find v4/docs -maxdepth 1 -name '*.md' | sed 's#v4/docs/##'`
    > split(DOC?)`
`
};

rule(:missing_docs, DOC?) {
  expected_docs(DOC?)
    > sql`
        SELECT input.__cursor_idx, input.DOC
        FROM input
        WHERE NOT EXISTS (
          SELECT 1
          FROM actual_docs
          WHERE actual_docs.DOC = ${DOC}
        )
      `
};

missing_docs(DOC?)
  > lsp_warn(:missing_doc)`expected doc is missing: ${DOC}`;
