# Generate a docs TOC from the docs folder.
#
# Run:
#   cargo run --manifest-path v4/Cargo.toml --bin sprefa-run -- \
#     v4/examples/docs-toc.sprf --root . --show-rows

rule(:doc_page, DOC?, TITLE?);

fs
  > glob`v4/docs/${DOC?}`
  > read
  > split(TITLE?)`
`
  > glob`# V4 *`
  > doc_page(DOC, TITLE);

`v4/docs/v4-docs-toc.md`
  > render.markdown`# V4 Docs TOC

Generated by <code>v4/examples/docs-toc.sprf</code>.

${ doc_page?(DOC?, TITLE?)
  > sql`
      SELECT input.DOC, substr(input.TITLE, 3) AS TITLE
      FROM input
      WHERE input.DOC != 'v4-docs-toc.md'
      ORDER BY input.DOC
    `
  > render.markdown`- [${TITLE}](./${DOC})
`
}
`
  > write_file`v4/docs/v4-docs-toc.md`;
