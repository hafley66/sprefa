# Dogfood: ast_yaml comment adjacency can drive LSP diagnostics.
#
# This uses ast-grep RuleCore instead of raw tree-sitter queries:
# line_comment nodes matching /// that precede a function pattern.
#
# Run:
#   cargo run --manifest-path v4/Cargo.toml --bin sprefa-run -- \
#     v4/examples/dogfood-rust-doc-lsp.sprf --root . --show-rows

rule(:documented_fns, NAME?, DOC?, FS?, LO?);

fs
  > glob`v4/examples/dogfood-rust-doc-target.rs`
  > ast_yaml(:rs)`
      rule:
        kind: line_comment
        regex: "^///"
        precedes:
          pattern: "fn ${NAME?}() {}"
    `
  > term_bind(:DOC)
  > documented_fns(NAME, DOC, FS, LO)
  > lsp_info[NAME](:documented_fn)`documented function ${NAME}`;
