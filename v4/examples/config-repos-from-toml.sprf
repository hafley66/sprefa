# Config is data. This reads the shipped TOML config through the normal
# path/read/json pipeline and records repo rows without a special Rust op.
#
# Run:
#   cargo run --manifest-path v4/Cargo.toml --bin sprefa-run -- \
#     v4/examples/config-repos-from-toml.sprf --root . --show-rows
#
# Note: TOML [[repos]] is exposed by the current TOML walker as repeated
# root entries named `repos`, not as one grouped array value.

rule(:config_repos, SLUG?, ROOT?);

path`v4/examples/sprefa.config.example.toml`
  > read
  > json(:toml)`{ repos: { slug: ${SLUG?}, root: ${ROOT?} } }`
  > config_repos.(SLUG, ROOT);
