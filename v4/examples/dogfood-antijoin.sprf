# Dogfood: `not(rule?(args))` antijoin surface.
#
# Same shape as `dev-missing-frontend-hook.sprf`, but instead of
# hand-rolling a `sql\`NOT EXISTS ...\`` block, the missing-hooks rule
# computes its rows inside a `{ … }` body using the new surface:
#
#   rule(:missing_frontend_hooks, OP?) {
#       openapi_ops?(OP?, SPEC?) > not(frontend_hooks?(OP))
#   }
#
# The fuser sees `not(frontend_hooks?(OP))`, classifies it as an
# AntiJoin liftable, and emits one fused INSERT:
#
#   INSERT OR IGNORE INTO missing_frontend_hooks_facts (_id, "OP")
#   SELECT sprf_blake3_id('missing_frontend_hooks', r0."OP") AS _id,
#          r0."OP" AS "OP"
#   FROM   openapi_ops_facts r0
#   WHERE  NOT EXISTS (
#            SELECT 1 FROM frontend_hooks_facts AS ax1
#            WHERE  ax1."OP" = r0."OP"
#          )
#
# Rule bodies run in program declaration order; the antijoin rule is
# declared LAST so the seed pipes above have already populated
# openapi_ops_facts and frontend_hooks_facts when its INSERT runs.
#
# Run (needs --fact-db: fused INSERT/SELECT only executes on SQLite;
# the default MemFactStore falls back to the legacy expand path):
#
#   cargo run --manifest-path v4/Cargo.toml --bin sprefa-run -- \
#     v4/examples/dogfood-antijoin.sprf --show-rows --fact-db /tmp/dogfood.db

rule(:openapi_ops, OP?, SPEC?);
rule(:frontend_hooks, OP?, FILE?);

# Seed: two API ops, one frontend hook (for getUser only).
`getUser`
  > term_bind(:OP)
  > `openapi.yaml`
  > term_bind(:SPEC)
  > openapi_ops(OP, SPEC);

`listPets`
  > term_bind(:OP)
  > `openapi.yaml`
  > term_bind(:SPEC)
  > openapi_ops(OP, SPEC);

`getUser`
  > term_bind(:OP)
  > `src/hooks.ts`
  > term_bind(:FILE)
  > frontend_hooks(OP, FILE);

# Antijoin: declared after the seeds so the rule's full-SQL body sees
# the populated source tables. Expected output: one row, `listPets`.
rule(:missing_frontend_hooks, OP?) {
    openapi_ops?(OP?, SPEC?) > not(frontend_hooks?(OP))
};

# Read the antijoin result and warn for each row. Expected: one warn
# for `listPets` (no row in frontend_hooks).
missing_frontend_hooks?(OP?)
  > lsp_warn(:missing_frontend_hook)`missing frontend hook for ${OP}`;
