# Synthetic API coverage check.
#
# This is the small version of "OpenAPI operation should have a frontend hook".
# Empty rules are replay tables. Dotted calls write facts. Plain calls query.

rule(:openapi_ops, OP?, SPEC?);
rule(:frontend_hooks, OP?, FILE?);
rule(:missing_frontend_hooks, OP?);

`getUser`
  > term_bind(:OP)
  > `openapi.yaml`
  > term_bind(:SPEC)
  > openapi_ops.(OP, SPEC);

`listPets`
  > term_bind(:OP)
  > `openapi.yaml`
  > term_bind(:SPEC)
  > openapi_ops.(OP, SPEC);

`getUser`
  > term_bind(:OP)
  > `src/hooks.ts`
  > term_bind(:FILE)
  > frontend_hooks.(OP, FILE);

openapi_ops(OP?, SPEC?)
  > sql`
      SELECT input.__cursor_idx, input.OP
      FROM input
      WHERE NOT EXISTS (
        SELECT 1
        FROM frontend_hooks
        WHERE frontend_hooks.OP = ${OP}
      )
    `
  > missing_frontend_hooks.(OP)
  > lsp_warn(:missing_frontend_hook)`missing frontend hook for ${OP}`;
