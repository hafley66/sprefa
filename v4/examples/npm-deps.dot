digraph npm_deps {
  rankdir=LR
  compound=true
  labelloc=t
  label="npm deps grouped by repo -- shared dep + version skew"
  node [shape=box style=rounded fontname=Helvetica]
  subgraph cluster_repoMain { label="repoMain"; style=filled; fillcolor=gray95; subgraph cluster_repoMain_r1 { label="r1"; style=filled; fillcolor=white; "main-app" } }
  subgraph cluster_repoB { label="repoB"; style=filled; fillcolor=gray95; subgraph cluster_repoB_bbbb111 { label="bbbb111"; style=filled; fillcolor=white; "lib-b" } }
  subgraph cluster_repoAppOne { label="repoAppOne"; style=filled; fillcolor=gray95; subgraph cluster_repoAppOne_a1c0ffee { label="a1c0ffee"; style=filled; fillcolor=white; "app-one" } }
  subgraph cluster_repoAppTwo { label="repoAppTwo"; style=filled; fillcolor=gray95; subgraph cluster_repoAppTwo_b2d0caf0 { label="b2d0caf0"; style=filled; fillcolor=white; "app-two" } }
  subgraph cluster_repoShared { label="repoShared"; style=filled; fillcolor=gray95; subgraph cluster_repoShared_5ha23d { label="5ha23d"; style=filled; fillcolor=white; "lib-shared" } }

  "main-app" -> "app-one" [label="1.0.0" fontsize=9]
  "main-app" -> "app-two" [label="1.0.0" fontsize=9]
  "app-one" -> "lib-shared" [label="3.1.0" fontsize=9]
  "app-one" -> "lib-b" [label="1.0.0" fontsize=9]
  "app-two" -> "lib-shared" [label="3.1.0" fontsize=9]
  "app-two" -> "lib-b" [label="2.0.0" fontsize=9]

}
