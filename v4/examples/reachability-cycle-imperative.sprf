# Reachability + cycle detection using ONLY empty rules and the
# imperative send/recv form. No `rule(){ body }` overloads anywhere.
#
#   rule(:r, COLS);     -- declare an empty relation (a table)
#   ... > r(COLS)       -- SEND: write/apply rows into it
#   r?(COLS) > ...      -- RECV: read/query rows out of it
#
# The recursion is expressed as a standalone pipe that RECVs from
# `reaches` + `edge` and SENDs back into `reaches`. The engine detects
# a relation reading its own table and loops it to a fixed point (same
# fixpoint as the braced recursive rule, just driven imperatively).
#
# Graph (a cycle a->b->c->a, plus a tail c->d):
#       a -> b -> c -> d
#       ^---------'
# Expected:
#   reaches: full transitive closure, INCLUDING (a,a) (b,b) (c,c)
#            because each of a,b,c reaches itself around the cycle.
#   cycle:   a, b, c   (d is not on a cycle: d has no out-edge)
#
# Run from repo root (recursion needs the sqlite store):
#   cargo run --manifest-path v4/Cargo.toml --bin sprefa-run -- \
#     v4/examples/reachability-cycle-imperative.sprf --root . \
#     --fact-db /tmp/cyc.db --show-rows
#
# Output: v4/examples/reach-cycle.dot + .svg (cycle nodes filled red).

# --- empty relations (declare-only; no body) ---
rule(:edge, A?, B?);
rule(:reaches, SRC?, DST?);
rule(:cycle, NODE?);

# --- SEND edges in (imperative write into the empty `edge` table) ---
`a|b
b|c
c|a
c|d`
  > split_line()
  > re`${A?}\|${B?}`
  > edge(A, B);

# --- base: every edge is a length-1 reach ---
# RECV from edge, SEND into reaches.
edge?(A?, B?)
  > reaches(A, B);

# --- step: extend a reach by one more edge ---
# RECV from reaches AND edge (shared term MID = the join), SEND back
# into reaches. reaches reads its own table => recursive => fixpoint.
reaches?(SRC?, MID?)
  > edge?(MID?, DST?)
  > reaches(SRC, DST);

# --- cycle = a node that reaches ITSELF ---
# Project both columns of reaches, then keep only the rows where the
# two are equal (a node reachable from itself = on a cycle). The
# self-equality is a `where` predicate, not a call-arg constraint:
# `reaches?(N?, N)` can't say it because the second N is introduced by
# this very read, so there's no prior cursor N to constrain against.
reaches?(SRC?, DST?)
  > where`${SRC} = ${DST}`
  > cycle(SRC);

# --- project to Graphviz: edges + cycle nodes highlighted ---
`reach-cycle`
  > render.markdown`digraph reach_cycle {
  rankdir=LR
  labelloc=t
  label="reachability + cycle detection (empty rules, imperative)"
  node [shape=circle fontname=Helvetica]
${ cycle?(NODE?)
  > render.markdown`  "${NODE}" [style=filled fillcolor=salmon]
`
}
${ edge?(A?, B?)
  > render.markdown`  "${A}" -> "${B}"
`
}
}
`
  > write_file`v4/examples/reach-cycle.dot`
  > sh`dot -Tsvg v4/examples/reach-cycle.dot -o v4/examples/reach-cycle.svg && echo reach-cycle-rendered`;
