# Dynamic cross-repo crawl: you DON'T know who points to whom. You
# know ONE thing -- the registry repo at a rev -- and a simple
# extraction rule for what a "pointer" looks like in a file. sprf
# crawls outward from the registry and DISCOVERS the rest. This is the
# scenario that genuinely needs recursion: the edges are not given,
# they are found by following pointers, and each repo you reach can
# reveal more repos. Transitive closure over a graph you materialize
# as you crawl = the recursive-rule fixpoint.
#
# Simulated 500-repos-but-tiny: one registry + 5 repos it can reach,
# only via pointers in each repo's deps.json (the "manifest"):
#
#   crawl-sim/<repo>/<revkind>/<revval>/deps.json
#   { "points": [ { "repo": "...", "rev": "..." }, ... ] }
#
#   registry/branch/main      -> acme-store-web@main, acme-checkout@v1.4.0
#   acme-store-web/branch/main-> acme-billing@9f3a1c2
#   acme-checkout/tag/v1.4.0  -> acme-ui-kit@v3.1.0, acme-logger@main
#   acme-billing/sha/9f3a1c2  -> acme-ui-kit@v3.1.0   (ui-kit reached
#   acme-ui-kit/tag/v3.1.0    -> (leaf)                two ways = the
#   acme-logger/branch/main   -> (leaf)                crawl dedups)
#
# The program only ever NAMES the registry. Everything else is
# discovered by the recursive `crawl` rule. Add more extraction pipes
# (lockfiles, shell, comments, path conventions) and they all just
# feed `pointer` -- the crawl logic does not change.
#
# Run from repo root:
#   cargo run --manifest-path v4/Cargo.toml --bin sprefa-run -- \
#     v4/examples/registry-crawl-discovery.sprf --root . \
#     --fact-db /tmp/crawl.db --show-rows
#
# Output: v4/examples/crawl-discovered.dot + .svg
#         (registry node gold; everything else was discovered)

# --- the programmed extraction rule: what a pointer looks like ---
# repo+rev of the SOURCE come from its checkout path; the targets come
# from the deps.json `points[]` array. Swap/extend this pipe for other
# pointer shapes; `pointer` is the stable interface the crawl reads.
rule(:pointer, FROMR?, FROMV?, TOR?, TOV?);

fs
  > glob`**/crawl-sim/${FROMR?}/${FK?}/${FROMV?}/deps.json`
  > read
  > json`{ points: [ ... { repo: ${TOR?}, rev: ${TOV?} } ] }`
  > pointer(FROMR, FROMV, TOR, TOV);

# also capture each repo's rev KIND for the picture (branch|tag|sha)
rule(:repo_rev, REPO?, KIND?, REV?);
fs
  > glob`**/crawl-sim/${REPO?}/${KIND?}/${REV?}/deps.json`
  > read
  > repo_rev(REPO, KIND, REV);

# --- the crawl: seed = the registry; recurse along pointers ---
# `root` is the ONLY thing we know up front, seeded imperatively
# (empty-rule send form) -- the single named entry point.
rule(:root, R?, V?);
`registry|main`
  > split_line()
  > re`${R?}\|${V?}`
  > root(R, V);

# base overload: the crawl starts at the root.
rule(:crawl, R?, V?) { root?(R?, V?) };
# recursive overload: from any crawled node, every pointer it declares
# reaches a new crawled node. Fixpoint = all repos reachable from the
# registry, discovered, deduped, terminating on the leaves.
rule(:crawl, R?, V?) { crawl?(PR?, PV?) > pointer?(PR?, PV?, R?, V?) };

# --- render what was discovered ---
# Node = repo (one per repo), drawn in its rev box, in its repo box.
# The registry is gold; every other box is something the crawl found.
`crawl-discovered`
  > render.markdown`digraph crawl_discovered {
  rankdir=LR
  compound=true
  labelloc=t
  label="dynamic crawl from the registry -- repos DISCOVERED, not listed"
  node [shape=box style=rounded fontname=Helvetica]
  "registry" [style=filled fillcolor=gold]
${ repo_rev?(REPO?, KIND?, REV?)
  > render.markdown`  subgraph "cluster_${REPO}" { label="${REPO}"; style=filled; fillcolor=gray95; subgraph "cluster_${REPO}_${REV}" { label="${KIND} ${REV}"; style=filled; fillcolor=white; "${REPO}" } }
`
}
${ pointer?(FROMR?, FROMV?, TOR?, TOV?)
  > render.markdown`  "${FROMR}" -> "${TOR}"
`
}
}
`
  > write_file`v4/examples/crawl-discovered.dot`
  > sh`dot -Tsvg v4/examples/crawl-discovered.dot -o v4/examples/crawl-discovered.svg && echo crawl-discovered-rendered`;
