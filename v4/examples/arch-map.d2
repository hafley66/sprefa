vars: {
  d2-config: {
    layout-engine: elk
    theme-id: 300
    pad: 40
  }
}

title: sprefa v4 architecture {
  near: top-center
  shape: text
  style: { font-size: 30; bold: true }
}

direction: down

classes: {
  stage: {
    shape: rectangle
    style: { fill: royalblue; stroke: navy; font-color: white; border-radius: 8; bold: true; shadow: true }
  }
  data: {
    shape: rectangle
    style: { fill: aliceblue; stroke: steelblue; border-radius: 12; font-size: 13 }
  }
  store: {
    shape: cylinder
    style: { fill: cornsilk; stroke: darkgoldenrod; font-size: 13 }
  }
  reg: {
    shape: package
    style: { fill: lavender; stroke: indigo; font-size: 13 }
  }
  op: {
    shape: hexagon
    style: { fill: thistle; stroke: indigo; font-size: 12 }
  }
  trait: {
    shape: rectangle
    style: { fill: honeydew; stroke: seagreen; border-radius: 4; multiple: true; font-size: 13 }
  }
  dispatch: {
    shape: diamond
    style: { fill: mistyrose; stroke: firebrick; font-size: 12; bold: true }
  }
}

arch: sprf to facts processing strata {
  grid-rows: 9
  grid-columns: 1
  grid-gap: 34
  style: { fill: white; stroke: white; font-size: 13 }
}
arch.t1: 1 · parse · first read of the sprf {
  style: { fill: ghostwhite; stroke: slategray; stroke-dash: 3; font-size: 16; bold: true }
}
arch.t2: 2 · lower · CST to rules {
  style: { fill: ghostwhite; stroke: slategray; stroke-dash: 3; font-size: 16; bold: true }
}
arch.t3: 3 · rule · the lowered unit {
  style: { fill: ghostwhite; stroke: slategray; stroke-dash: 3; font-size: 16; bold: true }
}
arch.t4: 4 · op registry · resolved during lower {
  style: { fill: ghostwhite; stroke: slategray; stroke-dash: 3; font-size: 16; bold: true }
}
arch.t5: 5 · runtime traits · the op contract {
  style: { fill: ghostwhite; stroke: slategray; stroke-dash: 3; font-size: 16; bold: true }
}
arch.t6: 6 · execute · run the op chain {
  style: { fill: ghostwhite; stroke: slategray; stroke-dash: 3; font-size: 16; bold: true }
}
arch.t7: 7 · facts · derived rows land {
  style: { fill: ghostwhite; stroke: slategray; stroke-dash: 3; font-size: 16; bold: true }
}
arch.t8: 8 · reactive state · subscribe and keep-alive {
  style: { fill: ghostwhite; stroke: slategray; stroke-dash: 3; font-size: 16; bold: true }
}
arch.t9: 9 · rule-call dispatch · drives expand {
  style: { fill: ghostwhite; stroke: slategray; stroke-dash: 3; font-size: 16; bold: true }
}

arch.t1.n_host_parse: host_parse. tree-sitter CST per host file { class: stage; tooltip: &tree_sitter::Tree over host file bytes }
arch.t2.n_walk_program: walk_program. CST to FusedRule list { class: stage; tooltip: Vec<PipeAst> lowered to FusedRule }
arch.t3.n_FusedRule: FusedRule. one lowered rule plus its op chain { class: data; tooltip: FusedRule struct, kind plus fused_sql }
arch.t4.n_OpRegistry: OpRegistry. name to OperatorDef table { class: reg; tooltip: HashMap<str, Arc<dyn OperatorDef>> }
arch.t4.n_split_op: split. backtick literal to row stream { class: op; tooltip: Arc<dyn OperatorDef> SplitDef }
arch.t4.n_re_op: re. regex capture groups to named terms { class: op; tooltip: Arc<dyn OperatorDef> ReDef regex::Regex }
arch.t4.n_render_op: render.markdown. template body to text { class: op; tooltip: Arc<dyn OperatorDef> RenderDef }
arch.t4.n_sh_op: sh. shell out effect node { class: op; tooltip: Arc<dyn OperatorDef> wraps std::process::Command }
arch.t5.n_OperatorDef: OperatorDef. compile-time op trait. lower bridge { class: trait; tooltip: trait, fn lower -> Box<dyn Component> }
arch.t5.n_Component: Component. runtime op trait. render render_batch { class: trait; tooltip: Box<dyn Component>, render_batch over a tick }
arch.t5.n_Node: Node. output algebra. Emit Many Park Done { class: trait; tooltip: enum Node, Emit Many Park Done }
arch.t5.n_RenderCtx: RenderCtx. pipe hash depth generation bus { class: trait; tooltip: &RenderCtx, pipe_hash depth tick bus }
arch.t5.n_Cursor: Cursor. payload. focal term plus named terms { class: data; tooltip: Arc<Cursor> with Vec<CursorTerm> }
arch.t6.n_expand: expand. run op chain bind term cursors { class: stage; tooltip: PipeInstance over Vec<Arc<Cursor>> batches }
arch.t7.n_FactStore: FactStore. derived rows keyed by rule name { class: store; tooltip: rule_facts rows, blake3 _id keys }
arch.t8.n_FactRuntimeGraph: FactRuntimeGraph. subscribe support dirty sweep { class: store; tooltip: Z-set deltas plus subscribe and support edges }
arch.t8.n_RuntimeGraph: RuntimeGraph. v4 facade over FactRuntimeGraph { class: store; tooltip: thin facade over FactRuntimeGraph }
arch.t8.n_owner_uri: owner_uri. owner identity key. switchMap key { class: data; tooltip: OwnerUri, the switchMap key }
arch.t8.n_Subscribe: Subscribe. source in-edge. owner consumes source { class: data; tooltip: subscribe_edge, a source stream in-edge }
arch.t8.n_support: support. keyed-children keep-alive set { class: data; tooltip: support_edge refcount keep-alive set }
arch.t9.n_call_r: CALL r. eager rule-call. emit rows now { class: dispatch; tooltip: eager expand, emit rows now }
arch.t9.n_force_r: force r. drain rule to fixpoint { class: dispatch; tooltip: loop expand until no delta }
arch.t9.n_query_r: QUERY r. subscribe to rule rows { class: dispatch; tooltip: read rule_facts, body never runs }

arch.t1.n_host_parse -> arch.t2.n_walk_program: CST feeds walk { style.font-size: 11 }
arch.t2.n_walk_program -> arch.t3.n_FusedRule: lowers each rule { style.font-size: 11 }
arch.t3.n_FusedRule -> arch.t6.n_expand: op chain executed by { style.font-size: 11 }
arch.t6.n_expand -> arch.t7.n_FactStore: emits derived rows { style.font-size: 11 }
arch.t6.n_expand -> arch.t4.n_OpRegistry: resolves op by name { style.font-size: 11 }
arch.t4.n_OpRegistry -> arch.t4.n_split_op: registers { style.font-size: 11 }
arch.t4.n_OpRegistry -> arch.t4.n_re_op: registers { style.font-size: 11 }
arch.t4.n_OpRegistry -> arch.t4.n_render_op: registers { style.font-size: 11 }
arch.t4.n_OpRegistry -> arch.t4.n_sh_op: registers { style.font-size: 11 }
arch.t4.n_split_op -> arch.t5.n_OperatorDef: implements { style.font-size: 11 }
arch.t4.n_re_op -> arch.t5.n_OperatorDef: implements { style.font-size: 11 }
arch.t4.n_render_op -> arch.t5.n_OperatorDef: implements { style.font-size: 11 }
arch.t4.n_sh_op -> arch.t5.n_OperatorDef: implements { style.font-size: 11 }
arch.t5.n_OperatorDef -> arch.t5.n_Component: lower compiles to { style.font-size: 11 }
arch.t5.n_Component -> arch.t5.n_Node: dispatch returns { style.font-size: 11 }
arch.t5.n_Component -> arch.t5.n_RenderCtx: dispatch reads { style.font-size: 11 }
arch.t5.n_Cursor -> arch.t5.n_Component: batch input to { style.font-size: 11 }
arch.t6.n_expand -> arch.t5.n_Cursor: binds term cursors { style.font-size: 11 }
arch.t7.n_FactStore -> arch.t8.n_FactRuntimeGraph: rows land in { style.font-size: 11 }
arch.t8.n_RuntimeGraph -> arch.t8.n_FactRuntimeGraph: delegates all state { style.font-size: 11 }
arch.t8.n_Subscribe -> arch.t8.n_FactRuntimeGraph: inserts subscribe edge { style.font-size: 11 }
arch.t8.n_owner_uri -> arch.t8.n_RuntimeGraph: keys owner instances { style.font-size: 11 }
arch.t8.n_support -> arch.t8.n_FactRuntimeGraph: refcount keep-alive { style.font-size: 11 }
arch.t8.n_FactRuntimeGraph -> arch.t5.n_Node: dirty sweep re-runs owners { style.font-size: 11 }
arch.t9.n_call_r -> arch.t6.n_expand: triggers eager expand { style.font-size: 11 }
arch.t9.n_force_r -> arch.t6.n_expand: drains to fixpoint { style.font-size: 11 }
arch.t9.n_query_r -> arch.t8.n_FactRuntimeGraph: subscribes via { style.font-size: 11 }

