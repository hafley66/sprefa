# Repo/rev DISCOVERY as a pattern-matching query, rendered to Graphviz.
#
# This is the proof that the recursive-rule milestone gives you a real
# discovery algorithm at the .sprf surface:
#
#   dep(SRC, DST)      -- the RAW edges you can observe directly
#                         (here: a literal block; in the wild this is
#                          fs>read>re over manifests, or a `repo`/`rev`
#                          op stream -- same rule shape either way).
#
#   reaches(SRC, DST)  -- DISCOVERY. The transitive closure: every repo
#                         reachable from every repo, computed by a
#                         self-recursive rule looped to a fixed point.
#                         This is the algorithm. No Rust, no crawler.
#
# Then sprf PROJECTS both relations to Graphviz `digraph` source, writes
# the .dot files, and shells out to `dot` to render .svg. The discovered
# graph has strictly more edges than the input (the indirect ones the
# recursion found) -- that difference IS the discovery, on screen.
#
# Identical rule shape does rev ancestry: feed `dep` from
#   rev_parent(REV, PARENT)
# and `reaches` becomes full commit-ancestry discovery. Repo dep vs rev
# parent is just which edges you load; the recursion is the same.
#
# Run from repo root:
#   cargo run --manifest-path v4/Cargo.toml --bin sprefa-run -- \
#     v4/examples/repo-rev-discovery-graphviz.sprf --root . --show-rows
#
# Outputs:
#   v4/examples/repo-deps.dot        + .svg   (raw observed edges)
#   v4/examples/repo-discovered.dot  + .svg   (transitive closure)

rule(:dep, X?, Y?);

# --- raw observed edges: repo | dependency-repo ---
# A small polyglot dep graph with depth, so the closure is visibly
# bigger than the input.
`app|auth
app|web
auth|crypto
web|http
http|net
crypto|net
net|sys`
  > split`
`
  > re`${X?}|${Y?}`
  > dep(X, Y);

# --- DISCOVERY: recursive transitive closure of `dep` ---
# Base: a direct dependency is a length-1 reach.
rule(:reaches, SRC?, DST?) { dep?(SRC?, DST?) };
# Recursive: extend any known reach by one more dependency edge.
# reaches(SRC,MID) AND dep(MID,DST) => reaches(SRC,DST).
rule(:reaches, SRC?, DST?) { reaches?(SRC?, MID?) > dep?(MID?, DST?) };

# (`dep` is declared with X?/Y?; the reaches binds use SRC?/DST?/MID?
#  so the recursive self-read and the base read don't collide on the
#  declared column identifiers.)

# --- project RAW edges -> Graphviz, write, render ---
# Body opens with the literal `digraph` token (not `${`) per the
# render.markdown parser workaround. Node ids are clean words so no
# quotes (no `"` adjacent to `${`) and no `#` literals are needed.
`repo-deps`
  > render.markdown`digraph repo_deps {
  rankdir=LR
  labelloc=t
  label="observed repo dependencies"
  node [shape=box style=rounded fontname=Helvetica]
${ dep?(SRC?, DST?)
  > render.markdown`  ${SRC} -> ${DST}
`
}
}
`
  > write_file`v4/examples/repo-deps.dot`
  > sh`dot -Tsvg v4/examples/repo-deps.dot -o v4/examples/repo-deps.svg && echo deps-rendered`;

# --- project DISCOVERED closure -> Graphviz, write, render ---
# Every edge here was DERIVED by the recursive rule. Direct edges are
# solid; the ones the recursion discovered (length >= 2) can't be told
# apart structurally without negation, so the whole closure is drawn --
# count the edges vs repo-deps to see the discovery.
`repo-discovered`
  > render.markdown`digraph repo_discovered {
  rankdir=LR
  labelloc=t
  label="discovered transitive reach -- recursive rule"
  node [shape=box style=rounded fontname=Helvetica]
  edge [color=slategray]
${ reaches?(SRC?, DST?)
  > render.markdown`  ${SRC} -> ${DST}
`
}
}
`
  > write_file`v4/examples/repo-discovered.dot`
  > sh`dot -Tsvg v4/examples/repo-discovered.dot -o v4/examples/repo-discovered.svg && echo discovered-rendered`;
