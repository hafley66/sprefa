# Render current open PRs known by ghcacher.
#
# Requires config:
#   [daemon]
#   ghcache_db = "/path/to/gh.db"
#
# Run:
#   cargo run --manifest-path v4/Cargo.toml --bin sprefa-run -- \
#     v4/examples/gh-pr-map.sprf --root . --show-rows

rule(:open_prs, REPO?, NUMBER?, TITLE?, STATE?, HEAD?, BASE?, UPDATED_AT?);

gh.prs(
  REPO: REPO?,
  NUMBER: NUMBER?,
  TITLE: TITLE?,
  STATE: `open`,
  HEAD: HEAD?,
  BASE: BASE?,
  UPDATED_AT: UPDATED_AT?
)
  > open_prs(REPO, NUMBER, TITLE, STATE, HEAD, BASE, UPDATED_AT);

`v4/examples/gh-pr-map.md`
  > render.markdown`# ghcache open PRs

${ open_prs?(REPO?, NUMBER?, TITLE?, STATE?, HEAD?, BASE?, UPDATED_AT?)
  > render.markdown`- ${REPO}#${NUMBER}: ${TITLE}
  - state: ${STATE}
  - branch: ${HEAD} -> ${BASE}
  - updated: ${UPDATED_AT}
`
}
`
  > write_file`v4/examples/gh-pr-map.md`;
