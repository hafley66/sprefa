digraph entrypoint_drift {
  rankdir=LR
  compound=true
  labelloc=t
  label="drift from entrypoint app@main -- same repo, two revs = salmon"
  node [shape=box style=rounded fontname=Helvetica]
  subgraph "cluster_app" { label="app"; style=filled; fillcolor=gray95; subgraph "cluster_app_main" { label="branch main"; style=filled; fillcolor=white; "app@main" [label="app"] } }
  subgraph "cluster_acme-libb" { label="acme-libb"; style=filled; fillcolor=gray95; subgraph "cluster_acme-libb_v1.0.0" { label="tag v1.0.0"; style=filled; fillcolor=white; "acme-libb@v1.0.0" [label="acme-libb"] } }
  subgraph "cluster_acme-core" { label="acme-core"; style=filled; fillcolor=gray95; subgraph "cluster_acme-core_v2.0.0" { label="tag v2.0.0"; style=filled; fillcolor=white; "acme-core@v2.0.0" [label="acme-core"] } }
  subgraph "cluster_acme-core" { label="acme-core"; style=filled; fillcolor=gray95; subgraph "cluster_acme-core_v2.1.0" { label="tag v2.1.0"; style=filled; fillcolor=white; "acme-core@v2.1.0" [label="acme-core"] } }
  subgraph "cluster_acme-liba" { label="acme-liba"; style=filled; fillcolor=gray95; subgraph "cluster_acme-liba_v1.0.0" { label="tag v1.0.0"; style=filled; fillcolor=white; "acme-liba@v1.0.0" [label="acme-liba"] } }

  "acme-core@v2.0.0" [style=filled fillcolor=salmon]
  "acme-core@v2.1.0" [style=filled fillcolor=salmon]

  "app@main" -> "acme-liba@v1.0.0"
  "app@main" -> "acme-libb@v1.0.0"
  "acme-libb@v1.0.0" -> "acme-core@v2.1.0"
  "acme-liba@v1.0.0" -> "acme-core@v2.0.0"

}
