# Rust panic call map.
#
# Scans Rust files, parses them with ast-grep, writes one row per panic!
# call byte range, and emits a warning suitable for CLI/LSP display.

rule(:panic_sites, FS?, LO?, HI?);

fs
  > glob`**/*.rs`
  > read
  > ast(:rs)`panic!($$$ARGS)`
  > panic_sites.(FS, LO, HI)
  > lsp_warn(:panic_site)`panic! call at ${FS}:${LO}`;
