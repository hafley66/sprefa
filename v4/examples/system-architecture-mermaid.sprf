# Generated architecture audit.
#
# Run:
#   cargo run --manifest-path v4/Cargo.toml --bin sprefa-run -- \
#     v4/examples/system-architecture-mermaid.sprf --root . --show-rows

rule(:arch_node, ID?, LABEL?, NOTE?);
rule(:arch_edge, FROM?, TO?, LABEL?);
rule(:audit_finding, AREA?, FINDING?, REF?);
rule(:next_task, TASK?, WHY?);

arch_node(ID: `Compile`, LABEL: `compile/lower`, NOTE: `host parse, binding graph, op signatures, DSL lowering`);
arch_node(ID: `Runtime`, LABEL: `effect_runtime`, NOTE: `queue rows, batches, ticks, wakes, components`);
arch_node(ID: `Cursor`, LABEL: `cursor model`, NOTE: `current value, CursorValue, source address, terms`);
arch_node(ID: `Source`, LABEL: `repo rev fs read`, NOTE: `repo config, git refs, file walks, byte reads`);
arch_node(ID: `Dsl`, LABEL: `pattern DSLs`, NOTE: `glob, re, json, ast, ast_yaml, sql, markdown`);
arch_node(ID: `Rule`, LABEL: `rule tables`, NOTE: `empty-rule fact bags, bodied rules, apply, query`);
arch_node(ID: `Store`, LABEL: `SprfStore and FactStore`, NOTE: `strings, norm, where bytes, files, revs, rule rows`);
arch_node(ID: `Sql`, LABEL: `sql relation runtime`, NOTE: `batch input, temp SQLite, joins, antijoins, mounted outputs`);
arch_node(ID: `Queue`, LABEL: `durable queue`, NOTE: `serialized cursors, parked wakes, resume from SQLite`);
arch_node(ID: `Lsp`, LABEL: `LSP surface`, NOTE: `hover, diagnostics, semantic tokens, completions`);
arch_node(ID: `Cli`, LABEL: `CLI daemon vscode`, NOTE: `sprefa-run, daemon, VS Code extension, dogfood examples`);
arch_node(ID: `Telemetry`, LABEL: `telemetry and benches`, NOTE: `fs, ast, stages, fact store counters, linux perf`);

arch_edge(FROM: `Compile`, TO: `Runtime`, LABEL: `lowers pipes into components`);
arch_edge(FROM: `Runtime`, TO: `Cursor`, LABEL: `moves cursor batches`);
arch_edge(FROM: `Source`, TO: `Cursor`, LABEL: `hydrates current value and where bytes`);
arch_edge(FROM: `Dsl`, TO: `Cursor`, LABEL: `narrows and captures`);
arch_edge(FROM: `Cursor`, TO: `Rule`, LABEL: `writes table rows`);
arch_edge(FROM: `Rule`, TO: `Store`, LABEL: `persists queryable facts`);
arch_edge(FROM: `Sql`, TO: `Store`, LABEL: `reads declared rule tables`);
arch_edge(FROM: `Sql`, TO: `Queue`, LABEL: `parks on dirty table deps`);
arch_edge(FROM: `Queue`, TO: `Runtime`, LABEL: `revives parked continuations`);
arch_edge(FROM: `Store`, TO: `Lsp`, LABEL: `feeds diagnostics and hover rows`);
arch_edge(FROM: `Runtime`, TO: `Telemetry`, LABEL: `counts batches and stages`);
arch_edge(FROM: `Cli`, TO: `Runtime`, LABEL: `runs programs and app sessions`);
arch_edge(FROM: `Lsp`, TO: `Compile`, LABEL: `uses parse and DSL location metadata`);
arch_edge(FROM: `Cli`, TO: `Lsp`, LABEL: `serves editor requests`);

audit_finding(
  AREA: `Fact identity`,
  FINDING: `FactStore row identity only sees Row::fields, while Cursor identity also has value, CursorValue, at, and compact terms`,
  REF: `v4/src/lib.rs:385; v4/src/lib.rs:585; v3/crates/effect_runtime/src/v2/fact_store.rs:181`,
);
audit_finding(
  AREA: `Store parity`,
  FINDING: `MemFactStore and SqliteFactStore use different visible identity when undeclared raw terms are present`,
  REF: `v3/crates/effect_runtime/src/v2/fact_store.rs:86; v3/crates/effect_runtime/src/v2/fact_store.rs:575`,
);
audit_finding(
  AREA: `SQL n plus one`,
  FINDING: `sql runtime copies every referenced relation into fresh temp SQLite and prepares one insert per row`,
  REF: `v4/src/sql.rs:164; v4/src/sql.rs:322; v4/src/sql.rs:381`,
);
audit_finding(
  AREA: `SQL deps`,
  FINDING: `referenced fact table extraction is lexical and feeds cache keys plus dirty subscriptions`,
  REF: `v4/src/sql.rs:40; v4/src/sql.rs:401`,
);
audit_finding(
  AREA: `Mounted output`,
  FINDING: `mounted_query removes visible output rows but retains historical cursor blobs`,
  REF: `v4/src/mounted_query.rs:84; v4/src/mounted_query.rs:453`,
);
audit_finding(
  AREA: `Queue hash`,
  FINDING: `SqliteQueue persists encoded cursor bytes and separately recomputes content_hash`,
  REF: `v3/crates/effect_runtime/src/v2/sqlite_queue.rs:252; v4/src/runtime_bridge.rs:19`,
);
audit_finding(
  AREA: `Batch hint`,
  FINDING: `Component batch_hint exists but expand uses ExpandOpts batch_cap directly`,
  REF: `v3/crates/effect_runtime/src/v2/component.rs:89; v3/crates/effect_runtime/src/v2/expand.rs:175`,
);
audit_finding(
  AREA: `CAPS bang`,
  FINDING: `NAME bang is bind in binding graph but read in runtime slot classification`,
  REF: `v4/src/compile/binding_graph.rs:284; v4/src/compile/walk.rs:559`,
);
audit_finding(
  AREA: `Rule decls`,
  FINDING: `binding graph collect_rule_decls can treat later rule sink calls as declarations`,
  REF: `v4/src/compile/binding_graph.rs:49; v4/src/compile/walk.rs:250`,
);
audit_finding(
  AREA: `Slots`,
  FINDING: `multiple bracket flow slots parse but only the first is lowered`,
  REF: `v4/crates/tree-sitter-sprefa/grammar.js:88; v4/src/compile/parse.rs:104`,
);
audit_finding(
  AREA: `Block parse`,
  FINDING: `brace block reparsing drops inner parse diagnostics`,
  REF: `v4/src/compile/parse.rs:31; v4/src/compile/parse.rs:137`,
);
audit_finding(
  AREA: `LSP DSL coverage`,
  FINDING: `hover completion and semantic token provider maps diverge for sql json ast markdown aliases`,
  REF: `v4/src/app.rs:1093; v4/crates/sprefa-lsp/src/dsl_lookup.rs:13; v4/crates/sprefa-lsp/src/semantic.rs:105`,
);
audit_finding(
  AREA: `LSP op names`,
  FINDING: `docs use lsp.warn while registered warning op is lsp_warn`,
  REF: `v4/src/lsp.rs:365; v4/docs/v4-rule-query-semantics.md:335`,
);
audit_finding(
  AREA: `Rev reads`,
  FINDING: `rev-backed fs can do git ls-tree per rev and git show per file`,
  REF: `v4/src/v2_ops.rs:270; v4/src/source.rs:124`,
);
audit_finding(
  AREA: `Source reads`,
  FINDING: `source-aware ast and json can reread bytes in each matcher stage`,
  REF: `v4/src/source.rs:83; v4/src/v2_ops.rs:666; v4/src/v2_ops.rs:3250`,
);
audit_finding(
  AREA: `Perf docs`,
  FINDING: `linux bench fixture path differs between justfile and v4 bench sprf comments`,
  REF: `justfile:55; v4/bench/linux.sprf:10`,
);
audit_finding(
  AREA: `Generated churn`,
  FINDING: `tests and render recipes write tracked generated outputs`,
  REF: `v4/tests/sprefa_run_cli_smoke.rs:180; v4/examples/runtime-map-html.sprf:103`,
);

next_task(TASK: `Hydrate rev query cursors`, WHY: `rev? should restore repo plus rev cursor.at so stored rev rows can feed fs/json/ast`);
next_task(TASK: `Unify fact identity`, WHY: `memory and sqlite stores need one declared-column identity contract`);
next_task(TASK: `Batch SQL materialization`, WHY: `prepare once per temp table and insert in transaction or reuse SQLite physical tables`);
next_task(TASK: `Centralize DSL registry`, WHY: `one op-to-DSL provider table should drive hover completion semantic tokens and docs`);
next_task(TASK: `Fix CAPS bang semantics`, WHY: `binding graph and runtime classification must agree or reject the suffix`);
next_task(TASK: `Add rev-source perf case`, WHY: `bench repo rev fs read and source-aware ast/json across historical revisions`);
next_task(TASK: `Stabilize generated outputs`, WHY: `examples that write tracked files need deterministic output or temp targets in tests`);

