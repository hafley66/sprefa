digraph reach_cycle {
  rankdir=LR
  labelloc=t
  label="reachability + cycle detection (empty rules, imperative)"
  node [shape=circle fontname=Helvetica]
  "a" [style=filled fillcolor=salmon]
  "b" [style=filled fillcolor=salmon]
  "c" [style=filled fillcolor=salmon]

  "a" -> "b"
  "b" -> "c"
  "c" -> "a"
  "c" -> "d"

}
