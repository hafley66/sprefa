# "Is there drift from an entrypoint?" -- i.e. does ONE entrypoint,
# crawled transitively, end up importing the SAME repo at TWO different
# revs? That is rev drift (the cross-repo version-skew, but discovered
# by crawling, not read from a single lockfile).
#
# Engineered drift-sim (drift-sim/<repo>/<revkind>/<revval>/deps.json):
#
#   app@main  -> acme-liba@v1.0.0 -> acme-core@v2.0.0
#             -> acme-libb@v1.0.0 -> acme-core@v2.1.0
#                                    ^^^^^^^^^^^^^^^^^^ same repo,
#                                    acme-core, reached at v2.0.0 AND
#                                    v2.1.0 from the one entrypoint
#                                    => DRIFT.
#
# We name ONLY the entrypoint (app@main). The crawl discovers the rest
# recursively; the drift rule then self-joins the crawl on repo with
# two distinct revs and raises an LSP warning.
#
# Run from repo root:
#   cargo run --manifest-path v4/Cargo.toml --bin sprefa-run -- \
#     v4/examples/entrypoint-rev-drift.sprf --root . \
#     --fact-db /tmp/drift.db --show-rows
#
# Output: v4/examples/entrypoint-drift.dot + .svg
#         (acme-core appears as ONE repo box with TWO rev boxes = drift,
#          filled salmon; an lsp_warn fires for it).

# --- programmed extraction: what a pointer looks like ---
rule(:pointer, FROMR?, FROMV?, TOR?, TOV?);
fs
  > glob`**/drift-sim/${FROMR?}/${FK?}/${FROMV?}/deps.json`
  > read
  > json`{ points: [ ... { repo: ${TOR?}, rev: ${TOV?} } ] }`
  > pointer(FROMR, FROMV, TOR, TOV);

# rev kind per discovered checkout, for the picture
rule(:repo_rev, REPO?, KIND?, REV?);
fs
  > glob`**/drift-sim/${REPO?}/${KIND?}/${REV?}/deps.json`
  > read
  > repo_rev(REPO, KIND, REV);

# --- crawl: the ONLY named thing is the entrypoint ---
rule(:root, R?, V?);
`app|main`
  > split_line()
  > re`${R?}\|${V?}`
  > root(R, V);

rule(:crawl, R?, V?) { root?(R?, V?) };
rule(:crawl, R?, V?) { crawl?(PR?, PV?) > pointer?(PR?, PV?, R?, V?) };

# --- DRIFT: a repo the entrypoint crawls to at two distinct revs ---
# Self-join crawl on the repo; `${V1} < ${V2}` makes the revs distinct
# AND dedups the pair (one row per drifted repo, not both orderings).
rule(:drift, REPO?, V1?, V2?);
crawl?(REPO?, V1?)
  > crawl?(REPO, V2?)
  > where`${V1} < ${V2}`
  > drift(REPO, V1, V2)
  > lsp_warn(:rev-drift)`entrypoint app@main imports ${REPO} at BOTH ${V1} and ${V2} (rev drift)`;

# --- render: repo > rev boxes; the drifted repo's boxes go salmon ---
# Node id is repo@rev so a drifted repo shows TWO nodes in TWO rev
# boxes inside its ONE repo box. `drift` rows recolour those nodes.
`entrypoint-drift`
  > render.markdown`digraph entrypoint_drift {
  rankdir=LR
  compound=true
  labelloc=t
  label="drift from entrypoint app@main -- same repo, two revs = salmon"
  node [shape=box style=rounded fontname=Helvetica]
${ repo_rev?(REPO?, KIND?, REV?)
  > render.markdown`  subgraph "cluster_${REPO}" { label="${REPO}"; style=filled; fillcolor=gray95; subgraph "cluster_${REPO}_${REV}" { label="${KIND} ${REV}"; style=filled; fillcolor=white; "${REPO}@${REV}" [label="${REPO}"] } }
`
}
${ drift?(REPO?, V1?, V2?)
  > render.markdown`  "${REPO}@${V1}" [style=filled fillcolor=salmon]
  "${REPO}@${V2}" [style=filled fillcolor=salmon]
`
}
${ pointer?(FROMR?, FROMV?, TOR?, TOV?)
  > render.markdown`  "${FROMR}@${FROMV}" -> "${TOR}@${TOV}"
`
}
}
`
  > write_file`v4/examples/entrypoint-drift.dot`
  > sh`dot -Tsvg v4/examples/entrypoint-drift.dot -o v4/examples/entrypoint-drift.svg && echo entrypoint-drift-rendered`;
