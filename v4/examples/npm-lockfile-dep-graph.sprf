# Cross-repo npm dependency graph, grouped REPO > REV > package.
#
# A "rev" is a revision: the point a repo is checked out at. A rev is
# one of three KINDs -- a BRANCH, a TAG, or a SHA -- never assumed to
# be a tag. The sim encodes repo + revkind + revval as path segments
# so the picture can label which kind each rev is:
#
#   v4/examples/npm-sim/<repo>/<revkind>/<revval>/<pkg>/package-lock.json
#
#   acme-store-web  branch main      store-web   (the root app)
#   acme-checkout   tag    v1.4.0    checkout-svc
#   acme-billing    sha    9f3a1c2   billing-svc
#   acme-ui-kit     tag    v3.1.0    ui-kit       (shared lib)
#   acme-logger     branch main      logger       (the skewed lib)
#
# Topology (npm `version` from each lockfile is the EDGE label; the
# repo's git rev is the BOX it sits in -- two different things):
#
#   store-web    -> checkout-svc, billing-svc
#   checkout-svc -> ui-kit@3.1.0, logger@1.0.0
#   billing-svc  -> ui-kit@3.1.0, logger@2.0.0
#                    ^^^^^^ SHARED        ^^^^^^ SAME pkg (acme-logger),
#                                                two versions = SKEW
#
# Node = package (one per name), drawn in an inner "<kind> <val>" rev
# box, inside its repo's outer box. `logger` is ONE node in
# acme-logger/branch main with two version-labelled in-edges (the
# skew); `ui-kit` one node with two in-edges (shared). repo > rev >
# package is the nesting; the rev box says branch/tag/sha explicitly.
#
# Two capture forms:
#   rule(:pkg, ...);  rule(:dep, ...);   -- declared, fed by fs pipes
#   rule(:reaches, ...) { ... };         -- braced recursive overload
#
# Run from repo root:
#   cargo run --manifest-path v4/Cargo.toml --bin sprefa-run -- \
#     v4/examples/npm-lockfile-dep-graph.sprf --root . \
#     --fact-db /tmp/npm.db --show-rows
#
# Outputs:
#   v4/examples/npm-deps.dot     + .svg   (direct, repo>rev boxes)
#   v4/examples/npm-reaches.dot  + .svg   (transitive closure)

# --- CAPTURE 1: each package's identity = repo + rev(kind,val), from
#                its own checkout path on disk ---
rule(:pkg, NAME?, REPO?, KIND?, REV?);

fs
  > glob`**/npm-sim/${REPO?}/${KIND?}/${REV?}/${NAME?}/package-lock.json`
  > read
  > pkg(NAME, REPO, KIND, REV);

# --- CAPTURE 2: dependency edges; SRC from path, DST/VER from json ---
rule(:dep, SRC?, DST?, VER?);

fs
  > glob`**/npm-sim/${RP?}/${RK?}/${RV?}/${SRC?}/package-lock.json`
  > read
  > json`{ deps: [ ... { name: ${DST?}, version: ${VER?} } ] }`
  > dep(SRC, DST, VER);

# --- CAPTURE 3: braced recursive overloads (rule(){}) ---
# Transitive reachability over dep edges (version-agnostic).
rule(:reaches, SRC?, DST?) { dep?(SRC?, DST?, V?) };
rule(:reaches, SRC?, DST?) { reaches?(SRC?, MID?) > dep?(MID?, DST?, V?) };

# --- GRAPH 1: direct edges, nested REPO > REV boxes ---
# pkg row emits: outer cluster_<REPO> (repo) wrapping inner
# cluster_<REPO>_<REV> labelled "<kind> <val>" (the branch/tag/sha)
# wrapping the package node. Graphviz merges same-name reopens.
`npm-deps`
  > render.markdown`digraph npm_deps {
  rankdir=LR
  compound=true
  labelloc=t
  label="npm deps -- repo > rev(branch|tag|sha) > package; shared + skew"
  node [shape=box style=rounded fontname=Helvetica]
${ pkg?(NAME?, REPO?, KIND?, REV?)
  > render.markdown`  subgraph "cluster_${REPO}" { label="${REPO}"; style=filled; fillcolor=gray95; subgraph "cluster_${REPO}_${REV}" { label="${KIND} ${REV}"; style=filled; fillcolor=white; "${NAME}" } }
`
}
${ dep?(SRC?, DST?, VER?)
  > render.markdown`  "${SRC}" -> "${DST}" [label="${VER}" fontsize=9]
`
}
}
`
  > write_file`v4/examples/npm-deps.dot`
  > sh`dot -Tsvg v4/examples/npm-deps.dot -o v4/examples/npm-deps.svg && echo npm-deps-rendered`;

# --- GRAPH 2: transitive closure (braced recursive rule), same boxes -
`npm-reaches`
  > render.markdown`digraph npm_reaches {
  rankdir=LR
  compound=true
  labelloc=t
  label="npm transitive reach -- repo > rev > package (recursive rule)"
  node [shape=box style=rounded fontname=Helvetica]
  edge [color=slategray]
${ pkg?(NAME?, REPO?, KIND?, REV?)
  > render.markdown`  subgraph "cluster_${REPO}" { label="${REPO}"; style=filled; fillcolor=gray95; subgraph "cluster_${REPO}_${REV}" { label="${KIND} ${REV}"; style=filled; fillcolor=white; "${NAME}" } }
`
}
${ reaches?(SRC?, DST?)
  > render.markdown`  "${SRC}" -> "${DST}"
`
}
}
`
  > write_file`v4/examples/npm-reaches.dot`
  > sh`dot -Tsvg v4/examples/npm-reaches.dot -o v4/examples/npm-reaches.svg && echo npm-reaches-rendered`;
