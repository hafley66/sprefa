# linux-antijoin.sprf - materialization + SQL antijoin stress
#
# Materializes printk hit coordinates, then asks for .c/.h source files
# with no printk hit. This stresses source fanout, SQL NOT EXISTS, and
# anti-join materialization without producing a combinatorial explosion.

rule(:files, :FS) {
  fs(glob`**/*.{c,h}`)
};

rule(:hits, :FS, :LO, :HI) {
  fs(glob`**/*.{c,h}`) > ast(:c)`printk($$$)`
};

rule(:files_without_printk, :FS) {
  files?(FS?)
    > sql`
        SELECT input.__cursor_idx, input.FS
        FROM input
        WHERE NOT EXISTS (
          SELECT 1
          FROM hits
          WHERE hits.FS = ${FS}
        )
      `
};
