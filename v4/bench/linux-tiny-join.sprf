# bench/linux-tiny-join.sprf — fused-path microbench fixture.
#
# Two rules over a ~50-file synthetic kernel tree
# (`v4/bench/.fixtures/linux-micro/`). `hits` is the source-scan rule
# (Stream kind via fs+ast). `hit_pairs` self-joins `hits` on FS and
# emits ordered LO pairs per file (full-SQL kind: pure RuleQuery +
# where).
#
# Run target: <1s end-to-end. Used to iterate on the fuser without
# burning a real linux checkout each turn.
#
#   cargo run --release --bin sprefa-run -- v4/bench/linux-tiny-join.sprf \
#     --root v4/bench/.fixtures/linux-micro --no-show-rows

rule(:hits, FS?, LO?) {
  fs(glob`**/*.c`) > ast(:c)`printk($$$)`
};

rule(:hit_pairs, FS?, LO?, OTHER_LO?) {
  hits(FS?, LO?) > hits(FS?, OTHER_LO?) > where(${LO} != ${OTHER_LO})
};
