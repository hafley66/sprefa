# bench/linux.sprf - bench-as-language
#
# Mirrors the shape of v4_bench's `bare` mode:
#   FsComponent > AstNmComponent(:c, "printk($$$)") > FactWrite
#
# Source-aware AST path (2026-05-10): `ast` can read file bytes from
# path/rev cursors without materializing whole files through cursor.value.
# `re` remains string-only and still needs an explicit `read`.
#
# Run with:
#   cargo run --release --bin sprefa-run -- v4/bench/linux.sprf \
#     --root .bench/linux --no-show-rows
#
# Each row carries FS / LO / HI for the printk match site.

rule(:hits, :FS, :LO, :HI) {
  fs(glob`**/*.{c,h}`) > ast(:c)`printk($$$)`
};
