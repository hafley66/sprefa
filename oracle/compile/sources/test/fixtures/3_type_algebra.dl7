; Ordinary products serve as structural contracts.
(: Named
   (* (: name str)))

(: Identified
   (* (: id int)))

(: UserContract
   (* (: id int)
      (: name str)))

(: User
   (* (: id int)
      (: name str)
      (: active int)))

(User 7 "Ada" 1)
(json User)

(: MissingName
   (* (: id int)))

(asked User UserContract)

(: UserConformance (Extends User UserContract))

; A failed check derives no row and a diagnostic at the asking site.
(: conformance_attempt
   (* (: source type)
      (: contract type)))

(asked MissingName Named)

(<- (conformance_attempt MissingName Named)
    (Extends MissingName Named ?Checked))

; Contract conjunction is a closed tuple built by an ordinary relation.
(: user_contracts
   (* (: return any)))

(user_contracts (tuple Identified Named))

(: all_contract_proof
   (* (: proof type)))

(<- (asked_all User ?Contracts)
    (user_contracts ?Contracts))

(<- (all_contract_proof ?Checked)
    (user_contracts ?Contracts)
    (ExtendsAll User ?Contracts ?Checked))

; Relation-valued edges use the same type identities as every other edge.
(: HashFunction
   (* (: input type)
      (: return int)))

(: Hashable
   (* (: hash HashFunction)))

(: UserHashWitness
   (* (: hash HashFunction)))

(: BrokenHashWitness
   (* (: hash int)))

(implements Hashable User UserHashWitness)
(implements Hashable User BrokenHashWitness)

; A generic constraint is a bound on the parameter, checked by `Extends`.
(NamedBox:
   (* (Source: Named)
      (return: (*))))

(: UserBox (NamedBox User))

; Intersection keeps left order, deduplicates name, then appends updated.
(: IdentifiedNamed
   (* (: id int)
      (: name str)))

(: NamedTimestamped
   (* (: name str)
      (: updated int)))

(: UserView (Intersect IdentifiedNamed NamedTimestamped))
(: ExtendedUserView (Extend IdentifiedNamed NamedTimestamped))

(: NumericName
   (* (: name int)))

(: intersection_attempt
   (* (: left type)
      (: right type)))

(<- (intersection_attempt Named NumericName)
    (Intersect Named NumericName ?Result))

; HistoryV1 reads its source contract from ordinary options data.
(: HistoryOptions
   (* (: mode "copy")
      (: contract UserContract)))

(: UserHistory (HistoryV1 User HistoryOptions))
