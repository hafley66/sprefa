target/
**/target/
*.db
*.db-wal
*.db-shm
.claude/

.DS_Store
.ext-survey
**/.path_index_cache/
**/.fixtures/

# Beads / Dolt files (added by bd init)
.dolt/
.beads-credential-key

# rust-analyzer SCIP index (generated by `just oracle-index`; RA oracle artifact)
index.scip

tools/macos-text-overlay/

# Local-only build tweaks (nightly -Z threads + lld); not portable to stable CI / cargo install.
.cargo/config.toml

# runtime state under .dl/ is self-ignored by .dl/.gitignore
# npm-crawl generated output (pulled source repos, rendered graph)
examples/_npm/

# mkdir-lock serializer for `just ext-reload` (editors/vscode-dl)
.ext-reload.lock

# perf telemetry written by every dl run; runtime state, never fixture content
**/.dl/perf.jsonl

# parity corpora: separate repos, never part of this repo's scan horizon.
# gitignore has no effect on the tracked gitlinks themselves. This fence is
# still required for the RUNNING daemon (an old binary predating the native
# nested-repo prune in enumerate_with_hash/watchgate); it is redundant for a
# freshly built binary, which now prunes any dir owning a `.git` entry
# (submodule worktrees included) the same way it prunes `.git` itself.
/bench/corpus/otel-*/
# cached compiler truth indexes built by oracle_corpus.rs
/bench/corpus/.indexes/
