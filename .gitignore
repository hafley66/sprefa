target/
**/target/
*.db
*.db-wal
*.db-shm
.claude/*
!.claude/skills/

.DS_Store
.ext-survey
**/.path_index_cache/
**/.fixtures/
# gh-cache e2e fixtures (recorded fake-GitHub responses, small + hand-written)
# are the reproducibility guarantee for tests/it/gh_cache.rs and ARE committed;
# every other **/.fixtures/ dir (vendored oracle corpora: redis, rust-analyzer,
# v3/tests/smoke) stays excluded.
!tests/.fixtures/
tests/.fixtures/*
!tests/.fixtures/gh-cache/

# Beads / Dolt files (added by bd init)
.dolt/
.beads-credential-key

# rust-analyzer SCIP index (generated by `just oracle-index`; RA oracle artifact)
index.scip

tools/macos-text-overlay/

# Local-only build tweaks (nightly -Z threads + lld); not portable to stable CI / cargo install.
.cargo/config.toml

# runtime state under .dl/ is self-ignored by .dl/.gitignore
# npm-crawl generated output (pulled source repos, rendered graph)
examples/_npm/

# mkdir-lock serializer for `just ext-reload` (editors/vscode-dl)
.ext-reload.lock

# perf telemetry written by every dl run; runtime state, never fixture content
**/.dl/perf.jsonl

# parity corpora: separate repos, never part of this repo's scan horizon.
# gitignore has no effect on the tracked gitlinks themselves. This fence is
# still required for the RUNNING daemon (an old binary predating the native
# nested-repo prune in enumerate_with_hash/watchgate); it is redundant for a
# freshly built binary, which now prunes any dir owning a `.git` entry
# (submodule worktrees included) the same way it prunes `.git` itself.
/bench/corpus/otel-*/
# cached compiler truth indexes built by oracle_corpus.rs
/bench/corpus/.indexes/

# sqry analysis snapshots are generated local indexes, not source fixtures.
/.sqry/

# Python bytecode produced by local benchmark helpers.
__pycache__/
*.pyc

# heptagon reference clone (lustre-family compiler, lab reading material)
vendor/heptagon/

# heptagon reference clone (lustre-family compiler, lab reading material)
vendor/heptagon/
vendor/trealla/
v6/prolog/compile/out/text-door/
v6/prolog/compile/scripts/out/text-door/

# Sweep caches and measurements: the per-stage digest stores, the per-worker
# fragments stage 1 folds back into manifest.json (scripts/sweep-stage1.sh),
# and the timing ledger. Each is a fact about this machine on this pass, never
# about the corpus. The out/*.oracle.jsonl snapshots they key on stay tracked.
v6/prolog/compile/out/sweep.digests
v6/prolog/compile/out/oracle.digests
v6/prolog/compile/out/sweep.replay.digests.json
v6/prolog/compile/out/sweep.timings.tsv
v6/prolog/compile/out/oracle.timings.tsv
v6/prolog/compile/out/.sweep-shards/

# tsv2 served-program compile output (one emitted module per loaded .dl6)
v6/tsv2/gen_served/

# haskell lab build output and scratch debris (v6/hs-prolog, labs/hs-prolog)
labs/hs-prolog/interp/dist-newstyle/
labs/hs-prolog/interp/tmp_dbg*.hs
proofs/**/node_modules/
proofs/**/out/

# d2 multi-board SVG output: one directory per book, regenerated by `d2 <book>.d2 <book>.svg`
plans/*-book/
plans/*.gif
plans/*.pptx
v6/labs/exec_shootout/dl6/.bench/
v6/labs/exec_shootout/dl6/.compiled/
v6/labs/exec_shootout/dl6/FACTS.json
v6/labs/exec_shootout/dl6/FACTS.baseline.json
dist-local/
!.claude/skills/
!.claude/skills/**

# sed -i backups; a lane committed five of these through git add -A
*.bak

node_modules

# lane scratch: a tracked BRIEF.md silently replaced a live lane brief
/BRIEF.md
/REPORT.md
.boop-worktrees/
