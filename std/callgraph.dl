# Standard library: one-shot call-graph extraction over the resolved graph.
# closure.
#
# Same shape as examples/callgraph.dl but importable. Compose from a program:
#
#   use "std/callgraph.dl".
#   reaches("my_fn", dst).   # `def`, `calls`, `reaches`, `unused` are all in
#                            # scope after the `use`.
#
# `def` carries the path coordinate so a program can join against its own
# per-file facts; the call graph proper (`calls`, `reaches`) is name-only and
# language-agnostic. This file predates the engine's own call_def/call_name/
# call_edge (the resolved, SCIP-preferred call graph) — `calls` used to be a
# file-scoped regex co-occurrence heuristic; now it reads the resolved edges.

rel seen(path: file).
seen(path) <- scan("WORK", "**/*.rs", path, rev).

rel def(name: text, path: file, line: int).
rel calls(caller: text, callee: text).
rel reaches(src: text, dst: text).
rel unused(name: text).

# A caller is any fn defined in the scanned corpus. The scan glob (in `seen`
# above) is what a program importing this controls the scope by overriding it
# after the use is lowered (a `def` template, Phase A2; for now, edit the glob
# in this file).
def(name, path, line) <-
  call_def(_, sym, _, path, line, _), call_name(sym, name).

calls(caller, callee) <-
  call_edge(cs, ce, _),
  call_name(cs, caller),
  call_name(ce, callee),
  caller != callee.

reaches(src, dst) <- closure(calls).

unused(name) <- def(name, _, _), !calls(_, name).
