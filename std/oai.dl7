; `@std/oai`: an OpenAPI 3.x document as rows. A `document` seed names the
; file; the loader fills `route` and `param` from it and mints the type nodes
; the `request` and `response` columns point at.

(: document
   (* (: path str)))

(: route
   (* (: path str)
      (: method any)
      (: operation_id str)
      (: request type)
      (: response type)))

(: param
   (* (: operation_id str)
      (: name str)
      (: location any)
      (: schema type)
      (: required any)))
