; Wadler document values and their comptime layout effect.
(: Doc
   (+ (: text (* (: s str)))
      (: concat (* (: parts any)))
      (: nest (* (: indent int) (: body Doc)))
      (: group (* (: body Doc)))
      (: line (*))))

(: layout
   (* (: doc Doc)
      (: width int)
      (: return str)))

; Ordered join, a fold step: `(fold doc.join "" ?Item)` over items
; `(tuple Key Document)` concatenates the documents in key order (term order;
; ints compare as numbers, tuples position by position). The seed `""` stands
; for the empty document: the first item is the document itself, every later
; item one `concat` of the documents so far and its own. No text is built; the
; `fs.file` sink renders the tree once. An aggregate body reads stored rows
; only, so the items are a relation of their own.
(: empty
   (* (: seed any)))

(empty "")

(: join
   (* (: accumulator any)
      (: item any)
      (: next Doc)))

(<- (join ?Accumulator ?Item ?Document)
    (empty ?Accumulator)
    (tuple ?Key ?Document ?Item))

(<- (join ?Accumulator ?Item (Doc.concat ?Parts))
    (tuple ?Key ?Document ?Item)
    (tuple ?Accumulator ?Document ?Parts)
    (not (empty ?Accumulator)))
