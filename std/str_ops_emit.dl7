; Renders every generated site of the string kernel op table in
; `std/str_ops.dl7` into two Rust files. `piece` rows carry one Doc per line
; part, `section_document` the parts joined in (index, position) order, and
; `fs.file` each file: template chunks and sections joined in order, one
; document the sink renders once. Run from the repository root:
;
;     dl8 build std/str_ops_emit.dl7
(doc: (import "@std/doc"))
(fs: (import "@std/fs"))
(ops: (import "./std/str_ops.dl7"))

(: kind_out (* (: kind str) (: rust str)))
(kind_out "str" "Some(StrKind::Text)")
(kind_out "int" "Some(StrKind::Int)")
(kind_out "none" "None")

(: kind_rust (* (: kind str) (: rust str)))
(kind_rust "str" "Text")
(kind_rust "int" "Int")

(: piece
   (* (: section str)
      (: index int)
      (: position int)
      (: document doc.Doc)))

; ivm-ir: enum variants, the variant list, name and kind tables.
(<- (piece "ir_variant" ?Index 0
       (doc.Doc.concat
          [(doc.Doc.text "    ")
           (doc.Doc.text ?Variant)
           (doc.Doc.text ",")]))
    (ops.str_op ?Index ?Owner ?Name ?Arity ?Out ?Group ?Expression)
    (str.pascal ?Name ?Variant))

(<- (piece "ir_all" ?Index 0
       (doc.Doc.concat
          [(doc.Doc.text "        StrOp::")
           (doc.Doc.text ?Variant)
           (doc.Doc.text ",")]))
    (ops.str_op ?Index ?Owner ?Name ?Arity ?Out ?Group ?Expression)
    (str.pascal ?Name ?Variant))

(<- (piece "ir_name" ?Index 0
       (doc.Doc.concat
          [(doc.Doc.text "            StrOp::")
           (doc.Doc.text ?Variant)
           (doc.Doc.text " => \"")
           (doc.Doc.text ?Owner)
           (doc.Doc.text ".")
           (doc.Doc.text ?Name)
           (doc.Doc.text "\",")]))
    (ops.str_op ?Index ?Owner ?Name ?Arity ?Out ?Group ?Expression)
    (str.pascal ?Name ?Variant))

(<- (piece "ir_from_name" ?Index 0
       (doc.Doc.concat
          [(doc.Doc.text "            \"")
           (doc.Doc.text ?Owner)
           (doc.Doc.text ".")
           (doc.Doc.text ?Name)
           (doc.Doc.text "\" => Some(StrOp::")
           (doc.Doc.text ?Variant)
           (doc.Doc.text "),")]))
    (ops.str_op ?Index ?Owner ?Name ?Arity ?Out ?Group ?Expression)
    (str.pascal ?Name ?Variant))

(<- (piece "ir_out" ?Index 0
       (doc.Doc.concat
          [(doc.Doc.text "            StrOp::")
           (doc.Doc.text ?Variant)
           (doc.Doc.text " => ")
           (doc.Doc.text ?OutRust)
           (doc.Doc.text ",")]))
    (ops.str_op ?Index ?Owner ?Name ?Arity ?Out ?Group ?Expression)
    (str.pascal ?Name ?Variant)
    (kind_out ?Out ?OutRust))

; ivm-ir: argument kinds, one line per argument between a header and a close.
(<- (piece "ir_args" ?Index 0
       (doc.Doc.concat
          [(doc.Doc.text "            StrOp::")
           (doc.Doc.text ?Variant)
           (doc.Doc.text " => &[")]))
    (ops.str_op ?Index ?Owner ?Name ?Arity ?Out ?Group ?Expression)
    (str.pascal ?Name ?Variant))

(<- (piece "ir_args" ?Index ?Position
       (doc.Doc.concat
          [(doc.Doc.text "StrKind::")
           (doc.Doc.text ?KindRust)
           (doc.Doc.text ", ")]))
    (ops.str_op ?Index ?Owner ?Name ?Arity ?Out ?Group ?Expression)
    (str.pascal ?Name ?Variant)
    (ops.str_op_arg ?Owner ?Name ?ArgPosition ?Slot ?Kind)
    (int.add ?ArgPosition 1 ?Position)
    (kind_rust ?Kind ?KindRust))

(<- (piece "ir_args" ?Index 100
       (doc.Doc.text "],"))
    (ops.str_op ?Index ?Owner ?Name ?Arity ?Out ?Group ?Expression)
    (str.pascal ?Name ?Variant))

; ivm-ir: the apply arm, argument bindings then the table expression.
(<- (piece "ir_apply" ?Index 0
       (doc.Doc.concat
          [(doc.Doc.text "            StrOp::")
           (doc.Doc.text ?Variant)
           (doc.Doc.text " => {")]))
    (ops.str_op ?Index ?Owner ?Name ?Arity ?Out ?Group ?Expression)
    (str.pascal ?Name ?Variant))

(<- (piece "ir_apply" ?Index ?Position
       (doc.Doc.concat
          [(doc.Doc.text "                let a")
           (doc.Doc.text ?ArgText)
           (doc.Doc.text " = ")
           (doc.Doc.text ?Reader)
           (doc.Doc.text "(args, ")
           (doc.Doc.text ?ArgText)
           (doc.Doc.text ")?;")]))
    (ops.str_op ?Index ?Owner ?Name ?Arity ?Out ?Group ?Expression)
    (str.pascal ?Name ?Variant)
    (ops.str_op_arg ?Owner ?Name ?ArgPosition ?Slot ?Kind)
    (int.add ?ArgPosition 1 ?Position)
    (int.to_str ?ArgPosition ?ArgText)
    (reader ?Kind ?Reader))

(<- (piece "ir_apply" ?Index 100
       (doc.Doc.concat
          [(doc.Doc.text "                ")
           (doc.Doc.text ?Expression)]))
    (ops.str_op ?Index ?Owner ?Name ?Arity ?Out ?Group ?Expression)
    (str.pascal ?Name ?Variant))

(<- (piece "ir_apply" ?Index 101
       (doc.Doc.text "            }"))
    (ops.str_op ?Index ?Owner ?Name ?Arity ?Out ?Group ?Expression)
    (str.pascal ?Name ?Variant))

(: reader (* (: kind str) (: function str)))
(reader "str" "text")
(reader "int" "int")

; dl8: the name and arity table.
(<- (piece "dl8_table" ?Index 0
       (doc.Doc.concat
          [(doc.Doc.text "    (\"")
           (doc.Doc.text ?Owner)
           (doc.Doc.text "\", \"")
           (doc.Doc.text ?Name)
           (doc.Doc.text "\", ")
           (doc.Doc.text ?ArityText)
           (doc.Doc.text ", StrOp::")
           (doc.Doc.text ?Variant)
           (doc.Doc.text "),")]))
    (ops.str_op ?Index ?Owner ?Name ?Arity ?Out ?Group ?Expression)
    (str.pascal ?Name ?Variant)
    (int.to_str ?Arity ?ArityText))

; dl8: the kernel relation row `(Some("str"), name, arity)`.
(<- (piece "dl8_relation" ?Index 0
       (doc.Doc.concat
          [(doc.Doc.text "    (Some(\"")
           (doc.Doc.text ?Owner)
           (doc.Doc.text "\"), \"")
           (doc.Doc.text ?Name)
           (doc.Doc.text "\", ")
           (doc.Doc.text ?ArityText)
           (doc.Doc.text "),")]))
    (ops.str_op ?Index ?Owner ?Name ?Arity ?Out ?Group ?Expression)
    (str.pascal ?Name ?Variant)
    (int.to_str ?Arity ?ArityText))

; dl8: slot labels, one arm per argument and one for the return position.
(<- (piece "dl8_slot" ?Index ?Position
       (doc.Doc.concat
          [(doc.Doc.text "        (\"")
           (doc.Doc.text ?Owner)
           (doc.Doc.text "\", \"")
           (doc.Doc.text ?Name)
           (doc.Doc.text "\", ")
           (doc.Doc.text ?ArgText)
           (doc.Doc.text ") => \"")
           (doc.Doc.text ?Slot)
           (doc.Doc.text "\",")]))
    (ops.str_op ?Index ?Owner ?Name ?Arity ?Out ?Group ?Expression)
    (str.pascal ?Name ?Variant)
    (ops.str_op_arg ?Owner ?Name ?Position ?Slot ?Kind)
    (int.to_str ?Position ?ArgText))

(<- (piece "dl8_slot" ?Index 100
       (doc.Doc.concat
          [(doc.Doc.text "        (\"")
           (doc.Doc.text ?Owner)
           (doc.Doc.text "\", \"")
           (doc.Doc.text ?Name)
           (doc.Doc.text "\", ")
           (doc.Doc.text ?ReturnText)
           (doc.Doc.text ") => \"return\",")]))
    (ops.str_op ?Index ?Owner ?Name ?Arity ?Out ?Group ?Expression)
    (str.pascal ?Name ?Variant)
    (kind_rust ?Out ?OutRust)
    (int.add ?Arity -1 ?ReturnPosition)
    (int.to_str ?ReturnPosition ?ReturnText))

; dl8: the typed-op rows the checker's kernel graph reads.
(<- (piece "dl8_typed" ?Index 0
       (doc.Doc.concat
          [(doc.Doc.text "    (\"")
           (doc.Doc.text ?Owner)
           (doc.Doc.text "\", \"")
           (doc.Doc.text ?Name)
           (doc.Doc.text "\", &[")]))
    (ops.str_op ?Index ?Owner ?Name ?Arity ?Out ?Group ?Expression)
    (str.pascal ?Name ?Variant))

(<- (piece "dl8_typed" ?Index ?Position
       (doc.Doc.concat
          [(doc.Doc.text "(\"")
           (doc.Doc.text ?Slot)
           (doc.Doc.text "\", \"")
           (doc.Doc.text ?Kind)
           (doc.Doc.text "\"), ")]))
    (ops.str_op ?Index ?Owner ?Name ?Arity ?Out ?Group ?Expression)
    (str.pascal ?Name ?Variant)
    (ops.str_op_arg ?Owner ?Name ?ArgPosition ?Slot ?Kind)
    (int.add ?ArgPosition 1 ?Position))

(<- (piece "dl8_typed" ?Index 100
       (doc.Doc.concat
          [(doc.Doc.text "(\"return\", \"")
           (doc.Doc.text ?Out)
           (doc.Doc.text "\"), ")]))
    (ops.str_op ?Index ?Owner ?Name ?Arity ?Out ?Group ?Expression)
    (str.pascal ?Name ?Variant)
    (kind_rust ?Out ?OutRust))

(<- (piece "dl8_typed" ?Index 200
       (doc.Doc.text "]),"))
    (ops.str_op ?Index ?Owner ?Name ?Arity ?Out ?Group ?Expression)
    (str.pascal ?Name ?Variant))

; A piece starts a line unless it continues an inline section's line; a line
; start carries the newline before it, so a section's text begins with one.
(: inline_section (* (: section str)))
(inline_section "ir_args")
(inline_section "dl8_typed")

(: line_item
   (* (: section str)
      (: item any)))

(<- (line_item ?Section
       (tuple (tuple ?Index ?Position)
          (doc.Doc.concat
             [(doc.Doc.text "\n")
              ?Document])))
    (piece ?Section ?Index ?Position ?Document)
    (not (inline_section ?Section)))

(<- (line_item ?Section
       (tuple (tuple ?Index 0)
          (doc.Doc.concat
             [(doc.Doc.text "\n")
              ?Document])))
    (piece ?Section ?Index 0 ?Document)
    (inline_section ?Section))

(<- (line_item ?Section (tuple (tuple ?Index ?Position) ?Document))
    (piece ?Section ?Index ?Position ?Document)
    (inline_section ?Section)
    (int.ne ?Position 0))

(: section_document
   (* (: section str)
      (: document doc.Doc)))

(<- (section_document ?Section (fold doc.join "" ?Item))
    (line_item ?Section ?Item))

; The two files: template chunks and section slots in `order`.
(: target
   (* (: file str)
      (: path str)))

(target "ivm" "sqlite_ivm/crates/ivm-ir/src/3_str_ops.rs")
(target "dl8" "src/_6_eval/_4a_str_ops.rs")

(: chunk
   (* (: file str)
      (: order int)
      (: text str)))

(: slot
   (* (: file str)
      (: order int)
      (: section str)))

(chunk "ivm" 0
   "//! Generated by scripts/emit_str_ops.py from std/str_ops.dl7. Do not edit.
use crate::{StrKind, StrOut, StrVal};
use serde::{Deserialize, Serialize};

#[derive(Clone, Copy, Debug, PartialEq, Eq, Serialize, Deserialize)]
pub enum StrOp {")

(slot "ivm" 1 "ir_variant")

(chunk "ivm" 2
   "
}

impl StrOp {
    pub const ALL: &'static [StrOp] = &[")

(slot "ivm" 3 "ir_all")

(chunk "ivm" 4
   "
    ];

    pub fn name(self) -> &'static str {
        match self {")

(slot "ivm" 5 "ir_name")

(chunk "ivm" 6
   "
        }
    }

    pub fn from_name(name: &str) -> Option<StrOp> {
        match name {")

(slot "ivm" 7 "ir_from_name")

(chunk "ivm" 8
   "
            _ => None,
        }
    }

    pub fn args(self) -> &'static [StrKind] {
        match self {")

(slot "ivm" 9 "ir_args")

(chunk "ivm" 10
   "
        }
    }

    pub fn out(self) -> Option<StrKind> {
        match self {")

(slot "ivm" 11 "ir_out")

(chunk "ivm" 12
   "
        }
    }

    pub fn apply(self, args: &[StrVal]) -> Option<StrOut> {
        use crate::{int, text};
        use StrOut::{Holds, Int, Text};
        match self {")

(slot "ivm" 13 "ir_apply")

(chunk "ivm" 14
   "
        }
    }
}
")

(chunk "dl8" 0
   "//! Generated by scripts/emit_str_ops.py from std/str_ops.dl7. Do not edit.
use ivm_ir::StrOp;

/// `(owner, label, arity, op)` of every string function op.
pub const STR_OPS: &[(&str, &str, usize, StrOp)] = &[")

(slot "dl8" 1 "dl8_table")

(chunk "dl8" 2
   "
];

pub const STR_KERNEL_RELATIONS: &[(Option<&str>, &str, i64)] = &[")

(slot "dl8" 3 "dl8_relation")

(chunk "dl8" 4
   "
];

pub fn str_slot_label(owner: &str, label: &str, index: u32) -> Option<&'static str> {
    Some(match (owner, label, index) {")

(slot "dl8" 5 "dl8_slot")

(chunk "dl8" 6
   "
        _ => return None,
    })
}

pub const STR_TYPED_OPS: &[(&str, &str, &[(&str, &str)])] = &[")

(slot "dl8" 7 "dl8_typed")

(chunk "dl8" 8
   "
];
")

(: file_item
   (* (: path str)
      (: item any)))

(<- (file_item ?Path (tuple ?Order (doc.Doc.text ?Text)))
    (target ?File ?Path)
    (chunk ?File ?Order ?Text))

(<- (file_item ?Path (tuple ?Order ?Document))
    (target ?File ?Path)
    (slot ?File ?Order ?Section)
    (section_document ?Section ?Document))

(<- (fs.file ?Path (fold doc.join "" ?Item))
    (file_item ?Path ?Item))
