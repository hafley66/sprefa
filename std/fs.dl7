; `@std/fs`: files read through git when the root is a repository, off the disk
; otherwise. `at` is the tracked tree of one root at one revision.

(: at
   (* (: root text)
      (: sha text)
      (: path text)
      (: blob text)))

(: at_error
   (* (: root text)
      (: sha text)
      (: message text)))

; `json` reads one document into `:` rows under the node it returns.
(: json
   (* (: path text)
      (: return type)))

(: json_error
   (* (: path text)
      (: message text)))
