; `@std/fs`: files read through git when the root is a repository, off the disk
; otherwise. `at` is the tracked tree of one root at one revision.

(: at
   (* (: root str)
      (: sha str)
      (: path str)
      (: blob str)))

(: at_error
   (* (: root str)
      (: sha str)
      (: message str)))

; `json` reads one document into `:` rows under the node it returns.
(: json
   (* (: path str)
      (: return type)))

(: json_error
   (* (: path str)
      (: message str)))

; `watch` keeps one UTF-8 file body current while its request is live.
(: watch
   (* (: path str)
      (: return str)))

; `file` is a sink: `dl8 build` writes every row's text to its path, relative
; to `--out`, after the comptime fixpoint settles.
(: file
   (* (: path str)
      (: text str)))
