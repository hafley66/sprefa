; DL7 shared architecture graph, authored as one userland application.
; Source: v7/receipts/16_dl6_dl7_architecture_inventory.md.
; One DL7 relational kernel is applied at macrotime, comptime, and runtime.

(: ArchEmitter (*))

(: component
   (* (: id text)
      (: label text)
      (: state text)
      (: binding text)
      (: plane text)))

(: attachment_edge
   (* (: id text)
      (: src text)
      (: relation text)
      (: dst text)))

(: milestone
   (* (: id text)
      (: component text)
      (: src text)))

(: acceptance_item
   (* (: id text)
      (: milestone text)
      (: status text)
      (: count int)))

(: evidence
   (* (: id text)
      (: component text)
      (: path text)))

(: phase_axis
   (* (: binding text)
      (: consumes text)
      (: produces text)))

(: flow_step
   (* (: flow text)
      (: step int)
      (: src text)
      (: relation text)
      (: dst text)))

(emits ArchEmitter "components" component)
(emits ArchEmitter "edges" attachment_edge)
(emits ArchEmitter "milestones" milestone)
(emits ArchEmitter "acceptance_items" acceptance_item)
(emits ArchEmitter "evidence" evidence)
(emits ArchEmitter "phase_axis" phase_axis)
(emits ArchEmitter "flow_steps" flow_step)

; --- phase axis: one DL7 fixpoint applied at three binding times ---
(phase_axis "macrotime" "syntax_graph" "expanded_syntax")
(phase_axis "comptime" "tsi_type_module_graph" "checked_runtime_program")
(phase_axis "runtime" "whole_language_facts_deltas" "maintained_query_effect_relations")

; --- concrete runtime-tick flow: event -> extract -> facts -> ivm -> query -> effect ---
(flow_step "runtime_tick" 1 "host.filesystem" "watches" "ext.watch")
(flow_step "runtime_tick" 2 "host.git" "watches" "ext.watch")
(flow_step "runtime_tick" 3 "editor" "watches" "ext.watch")
(flow_step "runtime_tick" 4 "ext.watch" "emits" "ext.core")
(flow_step "runtime_tick" 5 "ext.core" "hosts" "ext.langs")
(flow_step "runtime_tick" 6 "ext.langs" "emits" "ext.tsi")
(flow_step "runtime_tick" 7 "ext.tsi" "writes" "ivm.sqlite")
(flow_step "runtime_tick" 8 "ivm.sqlite" "reads" "dl7.tool_cli")
(flow_step "runtime_tick" 9 "dl7.tool_cli" "emits" "lsp.diagnostics")
(flow_step "runtime_tick" 10 "dl7.tool_cli" "effects" "host.shell")
(flow_step "runtime_tick" 11 "dl7.tool_cli" "effects" "host.http")
(flow_step "dl6_reference" 1 "dl6.rules" "emits" "dl6.lower")
(flow_step "dl6_reference" 2 "dl6.lower" "emits" "ProgramJson")
(flow_step "dl6_reference" 3 "ProgramJson" "reads" "rt.rust")
(flow_step "dl6_reference" 4 "rt.rust" "writes" "ivm.sqlite")
(flow_step "v7_successor" 1 "dl7.emit.rust" "emits" "rt.executor")
(flow_step "v7_successor" 2 "dl7.emit.dbsp" "lowers_to" "rt.executor")
(flow_step "v7_successor" 3 "rt.executor" "lowers_to" "rt.v7")
(flow_step "v7_successor" 4 "rt.v7" "hosts" "ivm.sqlite")

; --- components ---
(component "dd.backend" "differential-dataflow backend" "planned" "runtime" "host-runtime")
(component "dl6.bind" "bind operator and interval/watch bind runners" "implemented" "comptime" "userland")
