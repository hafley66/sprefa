; The checked runtime program doubles as the macrotime evaluator. Claims name
; the macro even when expansion has zero output rows.
(: syntax_frontier
   (* (: ordinal int)
      (: node type)))

(: syntax_form
   (* (: node type)))

(: syntax_atom
   (* (: node type)
      (: name text)))

(: syntax_literal
   (* (: node type)
      (: value any)))

(: syntax_variable
   (* (: node type)
      (: variable type)
      (: name text)))

(: syntax_source
   (* (: node type)
      (: path any)
      (: start_offset int)
      (: end_offset int)
      (: start_line int)
      (: start_column int)
      (: end_line int)
      (: end_column int)))

(: syntax_claim
   (* (: invocation type)
      (: macro text)))

(: GeneratedSyntax
   (* (: invocation type)
      (: output_ordinal int)
      (: template_path int)))

(: generated_atom
   (* (: invocation type)
      (: output type)))

(: plus_form
   (* (: invocation type)
      (: output type)))

(: plus_operator
   (* (: invocation type)
      (: output type)))

(<- (syntax_claim ?Form "drop")
    (syntax_form ?Form)
    (: ?Form item ?Head 0)
    (syntax_atom ?Head "drop"))

(<- (syntax_claim ?Form "splice2")
    (syntax_form ?Form)
    (: ?Form item ?Head 0)
    (syntax_atom ?Head "splice2"))

(<- (: ?Form expansion ?First 0)
    (syntax_claim ?Form "splice2")
    (: ?Form item ?First 1))

(<- (: ?Form expansion ?Second 1)
    (syntax_claim ?Form "splice2")
    (: ?Form item ?Second 2))

(<- (syntax_claim ?Form "emit_atom")
    (syntax_form ?Form)
    (: ?Form item ?Head 0)
    (syntax_atom ?Head "emit_atom"))

(<- (generated_atom ?Form ?Output)
    (syntax_claim ?Form "emit_atom")
    (nil ?Empty)
    (cons 0 ?Empty ?TemplateArguments)
    (cons 0 ?TemplateArguments ?OutputArguments)
    (cons ?Form ?OutputArguments ?Arguments)
    (intern GeneratedSyntax ?Arguments ?Output))

(<- (node ?Output)
    (generated_atom ?Form ?Output))

(<- (syntax_atom ?Output "generated")
    (generated_atom ?Form ?Output))

(<- (syntax_source ?Output ?Path ?StartOffset ?EndOffset
                   ?StartLine ?StartColumn ?EndLine ?EndColumn)
    (generated_atom ?Form ?Output)
    (syntax_source ?Form ?Path ?StartOffset ?EndOffset
                   ?StartLine ?StartColumn ?EndLine ?EndColumn))

(<- (: ?Form expansion ?Output 0)
    (generated_atom ?Form ?Output))

(<- (syntax_claim ?Form "<+")
    (syntax_form ?Form)
    (: ?Form item ?Head 0)
    (syntax_atom ?Head "<+"))

(<- (plus_form ?Form ?Output)
    (syntax_claim ?Form "<+")
    (nil ?Empty)
    (cons 0 ?Empty ?TemplateArguments)
    (cons 0 ?TemplateArguments ?OutputArguments)
    (cons ?Form ?OutputArguments ?Arguments)
    (intern GeneratedSyntax ?Arguments ?Output))

(<- (plus_operator ?Form ?Output)
    (syntax_claim ?Form "<+")
    (nil ?Empty)
    (cons 1 ?Empty ?TemplateArguments)
    (cons 0 ?TemplateArguments ?OutputArguments)
    (cons ?Form ?OutputArguments ?Arguments)
    (intern GeneratedSyntax ?Arguments ?Output))

(<- (node ?Output)
    (plus_form ?Form ?Output))

(<- (node ?Output)
    (plus_operator ?Form ?Output))

(<- (syntax_form ?Output)
    (plus_form ?Form ?Output))

(<- (syntax_atom ?Output "<-")
    (plus_operator ?Form ?Output))

(<- (syntax_source ?Output ?Path ?StartOffset ?EndOffset
                   ?StartLine ?StartColumn ?EndLine ?EndColumn)
    (plus_form ?Form ?Output)
    (syntax_source ?Form ?Path ?StartOffset ?EndOffset
                   ?StartLine ?StartColumn ?EndLine ?EndColumn))

(<- (syntax_source ?Output ?Path ?StartOffset ?EndOffset
                   ?StartLine ?StartColumn ?EndLine ?EndColumn)
    (plus_operator ?Form ?Output)
    (syntax_source ?Form ?Path ?StartOffset ?EndOffset
                   ?StartLine ?StartColumn ?EndLine ?EndColumn))

(<- (: ?Output item ?Operator 0)
    (plus_form ?Form ?Output)
    (plus_operator ?Form ?Operator))

(<- (: ?Output item ?Child ?Index)
    (plus_form ?Form ?Output)
    (: ?Form item ?Child ?Index)
    (before ?Form 0 ?Index))

(<- (: ?Form expansion ?Output 0)
    (plus_form ?Form ?Output))
