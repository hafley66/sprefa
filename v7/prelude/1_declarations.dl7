; Shared relational helpers for closed name collections and edge order.
(: contains
   (* (: list any)
      (: value any)))

(: closed_names
   (* (: list any)))

(: before
   (* (: owner type)
      (: earlier int)
      (: later int)))

(: Pick
   (* (: source type)
      (: names any)
      (: return type)))

(: pick_edge
   (* (: source type)
      (: names any)
      (: name any)
      (: target type)
      (: source_index int)))

(: pick_predecessor
   (* (: source type)
      (: names any)
      (: source_index int)
      (: prior_index int)))

(: pick_has_predecessor
   (* (: source type)
      (: names any)
      (: source_index int)))

(: pick_rank
   (* (: source type)
      (: names any)
      (: source_index int)
      (: result_index int)))

(: Exclude
   (* (: source type)
      (: names any)
      (: return type)))

(: HistoryV1
   (* (: source type)
      (: options type)
      (: return type)))

(: Key
   (* (: name text)
      (: options type)
      (: return type)))

(: keyed_edge
   (* (: source type)
      (: name text)
      (: options type)
      (: target any)
      (: source_index int)))

(: key_predecessor
   (* (: source type)
      (: source_index int)
      (: prior_index int)))

(: key_has_predecessor
   (* (: source type)
      (: source_index int)))

(: key_rank
   (* (: source type)
      (: source_index int)
      (: result_index int)))

(: composite_key
   (* (: source type)
      (: position int)
      (: name text)
      (: options type)))

(: history_v1_edge
   (* (: source type)
      (: options type)
      (: result type)
      (: name text)
      (: target any)
      (: source_index int)))

(: history_v1_arity
   (* (: result type)
      (: arity int)))

(: excluded_name
   (* (: source type)
      (: names any)
      (: name any)))

(: exclude_edge
   (* (: source type)
      (: names any)
      (: name any)
      (: target type)
      (: source_index int)))

(: exclude_predecessor
   (* (: source type)
      (: names any)
      (: source_index int)
      (: prior_index int)))

(: exclude_has_predecessor
   (* (: source type)
      (: names any)
      (: source_index int)))

(: exclude_rank
   (* (: source type)
      (: names any)
      (: source_index int)
      (: result_index int)))

; A call occurrence points at its callable. Supplied arguments and the result
; use ordinary :/4 edges owned by the call node.
(: Apply
   (* (: call type)
      (: callable type)))

; Primitive values and generated variables participate in the same node and
; edge graph as relation references. Literal identity is content-based.
; Variable identity includes its generated callable scope.
(: Literal
   (* (: node type)
      (: primitive type)
      (: raw any)))

(: Variable
   (* (: node type)
      (: scope type)
      (: name text)))

; Curry identities are canonical callable specializations. The compiler
; supplies only specialization and captured-slot facts; the remaining shape
; and forwarding program are derived in userland.
(: Curry
   (* (: source type)
      (: bindings any)
      (: return type)))

(: curry_specialization
   (* (: source type)
      (: result type)))

(: curry_bound
   (* (: result type)
      (: source_index int)
      (: kind text)
      (: value any)))

(: curry_is_bound
   (* (: result type)
      (: source_index int)))

(: curry_unbound
   (* (: source type)
      (: result type)
      (: name any)
      (: target any)
      (: source_index int)))

(: curry_predecessor
   (* (: result type)
      (: source_index int)
      (: prior_index int)))

(: curry_has_predecessor
   (* (: result type)
      (: source_index int)))

(: curry_rank
   (* (: result type)
      (: source_index int)
      (: result_index int)))

(: curry_edge
   (* (: source type)
      (: result type)
      (: name any)
      (: target any)
      (: source_index int)
      (: result_index int)))

(: curry_arity
   (* (: result type)
      (: arity int)))

; An emitter node names each artifact and the relation whose closed rows form
; that artifact. Host-Prolog and DL7 emitters consume the same compiler view.
(: emits
   (* (: emitter type)
      (: name text)
      (: output type)))
