; Userland unary type constructors.
(: Partial
   (* (: source type)
      (: return type)))

(: Option
   (* (: source type)
      (: return type)))

; Shared relational helpers for closed name collections and edge order.
(: contains
   (* (: list any)
      (: value any)))

(: closed_names
   (* (: list any)))

(: before
   (* (: owner type)
      (: earlier int)
      (: later int)))

(: Pick
   (* (: source type)
      (: names any)
      (: return type)))

(: pick_edge
   (* (: source type)
      (: names any)
      (: name any)
      (: target type)
      (: source_index int)))

(: pick_predecessor
   (* (: source type)
      (: names any)
      (: source_index int)
      (: prior_index int)))

(: pick_has_predecessor
   (* (: source type)
      (: names any)
      (: source_index int)))

(: pick_rank
   (* (: source type)
      (: names any)
      (: source_index int)
      (: result_index int)))

(: Exclude
   (* (: source type)
      (: names any)
      (: return type)))

(: HistoryV1
   (* (: source type)
      (: options type)
      (: return type)))

(: history_v1_edge
   (* (: source type)
      (: options type)
      (: result type)
      (: name text)
      (: target any)
      (: source_index int)))

(: history_v1_arity
   (* (: result type)
      (: arity int)))

(: excluded_name
   (* (: source type)
      (: names any)
      (: name any)))

(: exclude_edge
   (* (: source type)
      (: names any)
      (: name any)
      (: target type)
      (: source_index int)))

(: exclude_predecessor
   (* (: source type)
      (: names any)
      (: source_index int)
      (: prior_index int)))

(: exclude_has_predecessor
   (* (: source type)
      (: names any)
      (: source_index int)))

(: exclude_rank
   (* (: source type)
      (: names any)
      (: source_index int)
      (: result_index int)))

; Canonical application identities use the shared cons and intern relations.
(<- (Partial ?Source ?Result)
    (partial_request ?Source)
    (nil ?Empty)
    (cons ?Source ?Empty ?Arguments)
    (intern Partial ?Arguments ?Result))

(<- (Partial ?Source ?Result)
    (intern_snapshot Partial ?Arguments ?Result)
    (nil ?Empty)
    (cons ?Source ?Empty ?Arguments))

(<- (Option ?Source ?Result)
    (nil ?Empty)
    (cons ?Source ?Empty ?Arguments)
    (intern Option ?Arguments ?Result))

(<- (Option ?Source ?Result)
    (intern_snapshot Option ?Arguments ?Result)
    (nil ?Empty)
    (cons ?Source ?Empty ?Arguments))

(<- (Pick ?Source ?Names ?Result)
    (nil ?Empty)
    (cons ?Names ?Empty ?TailArguments)
    (cons ?Source ?TailArguments ?Arguments)
    (intern Pick ?Arguments ?Result))

(<- (Pick ?Source ?Names ?Result)
    (intern_snapshot Pick ?Arguments ?Result)
    (cons ?Source ?TailArguments ?Arguments)
    (nil ?Empty)
    (cons ?Names ?Empty ?TailArguments))

(<- (Exclude ?Source ?Names ?Result)
    (nil ?Empty)
    (cons ?Names ?Empty ?TailArguments)
    (cons ?Source ?TailArguments ?Arguments)
    (intern Exclude ?Arguments ?Result))

(<- (Exclude ?Source ?Names ?Result)
    (intern_snapshot Exclude ?Arguments ?Result)
    (cons ?Source ?TailArguments ?Arguments)
    (nil ?Empty)
    (cons ?Names ?Empty ?TailArguments))

; HistoryV1 options are ordinary typed data. The first version accepts copy
; mode and interns source plus options as the specialization identity.
(<- (HistoryV1 ?Source ?Options ?Result)
    (edge_snapshot ?Options ?Mode "copy" 0)
    (nil ?Empty)
    (cons ?Options ?Empty ?TailArguments)
    (cons ?Source ?TailArguments ?Arguments)
    (intern HistoryV1 ?Arguments ?Result))

(<- (HistoryV1 ?Source ?Options ?Result)
    (intern_snapshot HistoryV1 ?Arguments ?Result)
    (cons ?Source ?TailArguments ?Arguments)
    (nil ?Empty)
    (cons ?Options ?Empty ?TailArguments)
    (edge_snapshot ?Options ?Mode "copy" 0))

(<- (contains ?List ?Value)
    (cons ?Value ?Tail ?List))

(<- (contains ?List ?Value)
    (cons ?Head ?Tail ?List)
    (contains ?Tail ?Value))

(<- (closed_names ?Empty)
    (nil ?Empty))

(<- (closed_names ?List)
    (cons ?Head ?Tail ?List)
    (closed_names ?Tail))

(<- (before ?Owner ?Earlier ?Later)
    (predecessor ?Owner ?Earlier ?Later))

(<- (before ?Owner ?Earlier ?Later)
    (predecessor ?Owner ?Earlier ?Middle)
    (before ?Owner ?Middle ?Later))

(<- (pick_edge ?Source ?Names ?Name ?Target ?SourceIndex)
    (Pick ?Source ?Names ?Result)
    (edge_snapshot ?Source ?Name ?Target ?SourceIndex)
    (contains ?Names ?Name))

(<- (pick_predecessor ?Source ?Names ?SourceIndex ?PriorIndex)
    (pick_edge ?Source ?Names ?Name ?Target ?SourceIndex)
    (pick_edge ?Source ?Names ?PriorName ?PriorTarget ?PriorIndex)
    (before ?Source ?PriorIndex ?SourceIndex))

(<- (pick_has_predecessor ?Source ?Names ?SourceIndex)
    (pick_predecessor ?Source ?Names ?SourceIndex ?PriorIndex))

(<- (pick_rank ?Source ?Names ?SourceIndex (count ?PriorIndex))
    (pick_predecessor ?Source ?Names ?SourceIndex ?PriorIndex))

(<- (pick_rank ?Source ?Names ?SourceIndex 0)
    (pick_edge ?Source ?Names ?Name ?Target ?SourceIndex)
    (not (pick_has_predecessor ?Source ?Names ?SourceIndex)))

(<- (: ?Result ?Name ?Target ?ResultIndex)
    (Pick ?Source ?Names ?Result)
    (pick_edge ?Source ?Names ?Name ?Target ?SourceIndex)
    (pick_rank ?Source ?Names ?SourceIndex ?ResultIndex))

(<- (excluded_name ?Source ?Names ?Name)
    (Exclude ?Source ?Names ?Result)
    (edge_snapshot ?Source ?Name ?Target ?SourceIndex)
    (contains ?Names ?Name))

(<- (exclude_edge ?Source ?Names ?Name ?Target ?SourceIndex)
    (Exclude ?Source ?Names ?Result)
    (edge_snapshot ?Source ?Name ?Target ?SourceIndex)
    (closed_names ?Names)
    (not (excluded_name ?Source ?Names ?Name)))

(<- (exclude_predecessor ?Source ?Names ?SourceIndex ?PriorIndex)
    (exclude_edge ?Source ?Names ?Name ?Target ?SourceIndex)
    (exclude_edge ?Source ?Names ?PriorName ?PriorTarget ?PriorIndex)
    (before ?Source ?PriorIndex ?SourceIndex))

(<- (exclude_has_predecessor ?Source ?Names ?SourceIndex)
    (exclude_predecessor ?Source ?Names ?SourceIndex ?PriorIndex))

(<- (exclude_rank ?Source ?Names ?SourceIndex (count ?PriorIndex))
    (exclude_predecessor ?Source ?Names ?SourceIndex ?PriorIndex))

(<- (exclude_rank ?Source ?Names ?SourceIndex 0)
    (exclude_edge ?Source ?Names ?Name ?Target ?SourceIndex)
    (not (exclude_has_predecessor ?Source ?Names ?SourceIndex)))

(<- (: ?Result ?Name ?Target ?ResultIndex)
    (Exclude ?Source ?Names ?Result)
    (exclude_edge ?Source ?Names ?Name ?Target ?SourceIndex)
    (exclude_rank ?Source ?Names ?SourceIndex ?ResultIndex))

; Partial application results are ordinary product nodes.
(<- (node ?Result)
    (Partial ?Source ?Result))

(<- (product ?Result)
    (Partial ?Source ?Result))

(<- (node ?Result)
    (Pick ?Source ?Names ?Result))

(<- (product ?Result)
    (Pick ?Source ?Names ?Result))

(<- (node ?Result)
    (Exclude ?Source ?Names ?Result))

(<- (product ?Result)
    (Exclude ?Source ?Names ?Result))

; Each source edge keeps its label and ordinal while Option maps the target.
(<- (: ?Result ?Name ?OptionalTarget ?Index)
    (Partial ?Source ?Result)
    (edge_snapshot ?Source ?Name ?Target ?Index)
    (Option ?Target ?OptionalTarget))

; HistoryV1 emits both type-graph rows and a checked executable rule through
; the public generated-program carrier. The generated rule copies source rows
; in this first proof; temporal storage policy remains a later userland layer.
(<- (history_v1_edge ?Source ?Options ?Result ?Name ?Target ?SourceIndex)
    (HistoryV1 ?Source ?Options ?Result)
    (edge_snapshot ?Source ?Name ?Target ?SourceIndex))

(<- (node ?Result)
    (HistoryV1 ?Source ?Options ?Result))

(<- (product ?Result)
    (HistoryV1 ?Source ?Options ?Result))

(<- (: ?Result ?Name ?Target ?SourceIndex)
    (history_v1_edge ?Source ?Options ?Result
                     ?Name ?Target ?SourceIndex))

(<- (history_v1_arity ?Result (count ?SourceIndex))
    (history_v1_edge ?Source ?Options ?Result
                     ?Name ?Target ?SourceIndex))

(<- (def ?Result ?Arity)
    (history_v1_arity ?Result ?Arity))

(<- (head ?Result ?Result)
    (HistoryV1 ?Source ?Options ?Result))

(<- (head_arg ?Result ?Position "variable" ?Name)
    (history_v1_edge ?Source ?Options ?Result
                     ?Name ?Target ?Position))

(<- (body ?Result 0 "positive" ?Source)
    (HistoryV1 ?Source ?Options ?Result))

(<- (body_arg ?Result 0 ?Position "variable" ?Name)
    (history_v1_edge ?Source ?Options ?Result
                     ?Name ?Target ?Position))
