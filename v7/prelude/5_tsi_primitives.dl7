; One empty product per primitive class a foreign type stream can name.
; `tsi.primitive(Id, Class)` binds the foreign id to the product declared
; here, so two languages spelling the same class share one node identity.

; TypeScript classes.
(: string (* ))

(: number (* ))

(: boolean (* ))

(: bigint (* ))

(: symbol (* ))

(: void (* ))

(: undefined (* ))

(: null (* ))

(: never (* ))

(: unknown (* ))

; The `any` class is absent on purpose: `any` is one of the four names
; `1_checker.pl:298-301` pins as a primitive, and a prelude edge of that name
; shadows it for every program. The loader reports the class as absent.

; Rust builtins.
(: i8 (* ))

(: i16 (* ))

(: i32 (* ))

(: i64 (* ))

(: i128 (* ))

(: u8 (* ))

(: u16 (* ))

(: u32 (* ))

(: u64 (* ))

(: u128 (* ))

(: f32 (* ))

(: f64 (* ))

(: bool (* ))

(: char (* ))

(: str (* ))

(: usize (* ))

(: isize (* ))

; The empty tuple, the class `unit` on the wire.
(: () (* ))

; Go builtins. `error` and `any` are an interface and an alias in the
; universe scope; `int` is the checker's pinned primitive, so neither
; is declared here and the loader reports the class as absent.
(: int8 (* ))

(: int16 (* ))

(: int32 (* ))

(: int64 (* ))

(: uint (* ))

(: uint8 (* ))

(: uint16 (* ))

(: uint32 (* ))

(: uint64 (* ))

(: uintptr (* ))

(: float32 (* ))

(: float64 (* ))

(: complex64 (* ))

(: complex128 (* ))

(: byte (* ))

(: rune (* ))
