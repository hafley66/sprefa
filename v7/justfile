# DL7 development entrypoints. Run from this directory with `just`.

v7 := justfile_directory()
grammar := v7 + "/tree-sitter-dl7"

default:
    @just --list

# Generate the C parser and grammar metadata from grammar.js.
tree-sitter-generate:
    cd "{{ grammar }}" && tree-sitter generate

# Verify the generated parser against the focused grammar corpus.
tree-sitter-test: tree-sitter-generate
    cd "{{ grammar }}" && tree-sitter test

# Parse one DL7 file and print its concrete syntax tree.
tree-sitter-parse path:
    cd "{{ grammar }}" && tree-sitter parse "{{ v7 }}/{{ path }}"

# Step 1 compiler-front build gate.
build: tree-sitter-test

# Compile the representative type-program fixture cold and warm. Structural
# budgets use inference, closure-round, and row counts; wall time is reported.
compiler-perf:
    swipl -q -s "{{ v7 }}/bench/0_compiler_performance.pl" -- "{{ v7 }}/test/fixtures/2_partial.dl7"

# Extract one source file, run a DL7 analysis over its TSI rows, and print the
# selected program relation as one JSON array per tuple.
query program source relation:
    cargo build --manifest-path "{{ v7 }}/../v6/sprefa-extract/Cargo.toml" --bin extract --features cli
    swipl -q -s "{{ v7 }}/src/4_tool/0_source_query_mainer.pl" -- "{{ program }}" "{{ source }}" "{{ relation }}" --extract "{{ v7 }}/../v6/sprefa-extract/target/debug/extract"

# Emit the source-visible positive-rule slice as the operator JSON consumed by
# dd-runner's pure RAM kernel. The source supplies the hosted TSI relation set.
dbsp-plan program source:
    cargo build --manifest-path "{{ v7 }}/../v6/sprefa-extract/Cargo.toml" --bin extract --features cli
    swipl -q -s "{{ v7 }}/src/4_tool/1_dbsp_plan_mainer.pl" -- "{{ program }}" "{{ source }}" --extract "{{ v7 }}/../v6/sprefa-extract/target/debug/extract"

# Validate exact closure counts on tiny chain and ring graphs.
runtime-shootout-smoke:
    bash "{{ v7 }}/labs/18_runtime_shootout/4_run.sh" smoke 4

# Run one warmup and five measured repetitions for every native-logic arm.
runtime-shootout n="48":
    bash "{{ v7 }}/labs/18_runtime_shootout/4_run.sh" full "{{ n }}"

# Extract one Rust file's type graph, render compilable DL7, and report whether
# the named generated region differs. Exit 1 means drift.
rust-types-check rust target region="rust-types":
    swipl -q -s "{{ v7 }}/src/3_emit/3_rust_type_region_mainer.pl" -- "{{ rust }}" "{{ target }}" "{{ region }}" --extract "{{ v7 }}/../v6/sprefa-extract/target/debug/extract"

# Run the same pipeline and commit only the generated marker body through
# Soopy's expected-content staging boundary.
rust-types-apply rust target region="rust-types":
    swipl -q -s "{{ v7 }}/src/3_emit/3_rust_type_region_mainer.pl" -- "{{ rust }}" "{{ target }}" "{{ region }}" --extract "{{ v7 }}/../v6/sprefa-extract/target/debug/extract" --apply

# Build the host command and prove extraction, rendering, Soopy replacement,
# unchanged detection, outside-byte preservation, and final DL7 compilation.
rust-types-e2e:
    cargo build --manifest-path "{{ v7 }}/../v6/sprefa-extract/Cargo.toml" --bin extract --features cli
    swipl -q -s "{{ v7 }}/test/7_rust_type_region.e2e.pl"
