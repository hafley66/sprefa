diagram.parse.injected -> diagram.cst.v4_cst: "body trees"
diagram.parse.host_v3 -> diagram.cst.v3_parse: "legacy AST"

diagram.cst.v4_compile_ast -> diagram.lower.v4_lower: "walk program"
diagram.cst.v4_cst -> diagram.lower.v4_lower: "DSL locate + diagnostics"
