diagram.effects.effect_ops -> diagram.effects.editor_output: "LSP rows"
diagram.effects.effect_ops -> diagram.effects.cli_output: "stdout/logs"

# Feedback loops that intentionally live outside the hot path.
diagram.support.v4_tests -> diagram.entry.cli_v4: "cargo tests run binaries"
