# sprefa — entire codebase architecture — dark mode
# render:
#   d2 arch-codebase-codex-dark.d2 arch-codebase-codex-dark.svg
#   d2 arch-codebase-codex-dark.d2 arch-codebase-codex-dark.png

vars: {
  d2-config: {
    layout-engine: elk
    theme-id: 200
    pad: 48
  }
}

direction: down

classes: {
  tier: {
    style: {
      fill: "#0f172a"
      stroke: "#64748b"
      font-color: "#e5e7eb"
      stroke-width: 2
      font-size: 18
      bold: true
    }
  }
  current: {
    style: {
      fill: "#082f49"
      stroke: "#38bdf8"
      font-color: "#e0f2fe"
      stroke-width: 2
      font-size: 15
      bold: true
    }
  }
  legacy: {
    style: {
      fill: "#1f2937"
      stroke: "#9ca3af"
      font-color: "#f3f4f6"
      stroke-width: 2
      stroke-dash: 5
      font-size: 15
      bold: true
    }
  }
  attic: {
    style: {
      fill: "#292524"
      stroke: "#a8a29e"
      font-color: "#e7e5e4"
      stroke-dash: 4
      font-size: 13
      italic: true
    }
  }
  doc: {
    shape: document
    style: {
      fill: "#431407"
      stroke: "#fb923c"
      font-color: "#fed7aa"
      font-size: 13
    }
  }
  plan: {
    shape: document
    style: {
      fill: "#422006"
      stroke: "#facc15"
      font-color: "#fef3c7"
      font-size: 13
    }
  }
  shell: {
    shape: rectangle
    style: {
      fill: "#164e63"
      stroke: "#22d3ee"
      font-color: "#ecfeff"
      stroke-width: 2
      border-radius: 4
      font-size: 13
    }
  }
  io: {
    shape: cloud
    style: {
      fill: "#312e81"
      stroke: "#a5b4fc"
      font-color: "#e0e7ff"
      font-size: 13
    }
  }
  grammar: {
    shape: package
    style: {
      fill: "#431407"
      stroke: "#fb923c"
      font-color: "#ffedd5"
      font-size: 13
      bold: true
    }
  }
  cst: {
    shape: rectangle
    style: {
      fill: "#451a03"
      stroke: "#f59e0b"
      font-color: "#fef3c7"
      border-radius: 6
      font-size: 13
    }
  }
  lower: {
    shape: rectangle
    style: {
      fill: "#0c4a6e"
      stroke: "#38bdf8"
      font-color: "#e0f2fe"
      border-radius: 6
      font-size: 13
      bold: true
    }
  }
  op: {
    shape: hexagon
    style: {
      fill: "#3b0764"
      stroke: "#c084fc"
      font-color: "#f3e8ff"
      font-size: 12
    }
  }
  trait: {
    shape: rectangle
    style: {
      fill: "#064e3b"
      stroke: "#34d399"
      font-color: "#d1fae5"
      border-radius: 4
      multiple: true
      font-size: 13
    }
  }
  runtime: {
    shape: rectangle
    style: {
      fill: "#0e7490"
      stroke: "#67e8f9"
      font-color: "#ffffff"
      border-radius: 7
      font-size: 14
      bold: true
      shadow: true
    }
  }
  store: {
    shape: cylinder
    style: {
      fill: "#052e16"
      stroke: "#4ade80"
      font-color: "#dcfce7"
      font-size: 13
    }
  }
  graph: {
    shape: rectangle
    style: {
      fill: "#500724"
      stroke: "#f472b6"
      font-color: "#fce7f3"
      border-radius: 16
      font-size: 13
      bold: true
    }
  }
  queue: {
    shape: queue
    style: {
      fill: "#1e293b"
      stroke: "#94a3b8"
      font-color: "#e2e8f0"
      font-size: 13
    }
  }
  effect: {
    shape: parallelogram
    style: {
      fill: "#581c87"
      stroke: "#e879f9"
      font-color: "#fae8ff"
      font-size: 13
    }
  }
  test: {
    shape: page
    style: {
      fill: "#082f49"
      stroke: "#38bdf8"
      font-color: "#e0f2fe"
      font-size: 12
    }
  }
  artifact: {
    shape: stored_data
    style: {
      fill: "#111827"
      stroke: "#94a3b8"
      font-color: "#e5e7eb"
      font-size: 12
    }
  }
  note: {
    shape: rectangle
    style: {
      fill: "#111827"
      stroke: "#475569"
      font-color: "#cbd5e1"
      font-size: 12
      italic: true
    }
  }
}

diagram: "" {
  style: {
    fill: "#0b1020"
    stroke: "#0b1020"
  }
  grid-rows: 14
  grid-columns: 1
  grid-gap: 44

  header: "sprefa codebase atlas — executable path, legacy substrate, editor shell, dogfood corpus" {
    shape: text
    style: {
      font-color: "#f8fafc"
      font-size: 26
      bold: true
    }
  }

  repo: "0 · repository strata" {
    class: tier
    grid-columns: 6
    grid-gap: 16

    current_v4: "v4/ current Rust system" {
      class: current
      grid-columns: 1
      lib: "src/lib.rs public module fanout" { class: artifact }
      core: "src/ cursor · term · ref · store" { class: artifact }
      bins: "src/bin: run · daemon · bench · stress" { class: shell }
    }

    legacy_v3: "v3/ legacy workspace plus shared runtime" {
      class: legacy
      grid-columns: 1
      workspace: "pipeline · server · parse · effect_runtime" { class: artifact }
      excluded: "crates/sprefa + experiments excluded from build" { class: attic }
      smoke: "tests/smoke shell corpus" { class: test }
    }

    editor_surface: "editor surfaces" {
      class: current
      grid-columns: 1
      root_ext: "editors/vscode v3 extension package" { class: shell }
      v4_ext: "v4/editors/vscode v4 extension package" { class: shell }
      tm: "sprf tmLanguage + language config" { class: artifact }
    }

    docs: "architecture docs and plans" {
      class: current
      grid-columns: 1
      v4_docs: "v4/docs guardrails, core-store, semantics" { class: doc }
      plans: "plans/ and v4/plans active design queue" { class: plan }
      chat: "chat_log dated decision history" { class: doc }
    }

    dogfood: "dogfood examples and generated outputs" {
      class: current
      grid-columns: 1
      sprf: "v4/examples/*.sprf self-analysis programs" { class: io }
      maps: "DOT · SVG · HTML · Markdown outputs" { class: artifact }
      bench: "v4/bench + v4/perf linux fixtures" { class: test }
    }

    project_ops: "project operations" {
      class: current
      grid-columns: 1
      just: "justfile recipes: tests, benches, regen, package" { class: shell }
      beads: ".beads issue database" { class: artifact; tooltip: "bd CLI is expected by AGENTS.md but is not on PATH in this session" }
      agents: "AGENTS.md + .agents skills" { class: doc }
    }
  }

  entry: "1 · entrypoints and hosts" {
    class: tier
    grid-columns: 4
    grid-gap: 18

    cli_v4: "v4 CLI and daemon" {
      class: current
      grid-columns: 1
      run: "sprefa-run: local or remote app dispatch" { class: shell }
      daemon: "sprefa-daemon: axum service + ghcache loop" { class: shell }
      bench: "v4-bench and stress binaries" { class: shell }
    }

    app_host: "v4/app_host generic host" {
      class: current
      grid-columns: 1
      store: "Store trait" { class: trait }
      dispatch: "Dispatch + Handler reducer" { class: trait }
      service: "AppService tower adapter" { class: shell }
      transport: "InProcess or DaemonProxy transport" { class: shell }
    }

    lsp_v4: "v4 LSP stack" {
      class: current
      grid-columns: 1
      lsp_lib: "v4/src/lsp.rs protocol projections" { class: shell }
      lsp_crate: "v4/crates/sprefa-lsp tower-lsp binary" { class: shell }
      cst_lsp: "cst/lsp providers, highlights, position, shift" { class: cst }
    }

    v3_server: "v3 server crate" {
      class: legacy
      grid-columns: 1
      backend: "backend.rs tower-lsp backend" { class: shell }
      runloop: "run.rs per-seed execution loop" { class: shell }
      transports: "transport_lsp + transport_http" { class: shell }
      bins: "sprefa-run + sprefa-server" { class: shell }
    }
  }

  inputs: "2 · source identities and external inputs" {
    class: tier
    grid-columns: 6
    grid-gap: 14

    sprf: ".sprf program text" { class: io }
    config: "SprfConfig: env, user config, repos.toml" { class: io }
    repo_rev: "repo · rev · fs coordinates" { class: io }
    disk: "disk bytes + buffer overlays" { class: io }
    watch: "notify and git watcher events" { class: io }
    github: "ghcache GitHub API cache" { class: io }
  }

  parse: "3 · parse and injected grammars" {
    class: tier
    grid-columns: 4
    grid-gap: 18

    host_v4: "v4 host grammar" {
      class: current
      grid-columns: 1
      grammar: "crates/tree-sitter-sprefa/grammar.js" { class: grammar }
      parser: "generated parser.c + node-types.json" { class: grammar }
      build: "v4/build.rs and cst/build helpers" { class: shell }
    }

    host_v3: "v3 host grammar" {
      class: legacy
      grid-columns: 1
      grammar: "v3/crates/tree-sitter-sprefa/grammar.js" { class: grammar }
      parser: "checked-in parser.c" { class: grammar }
      parse_crate: "sprefa_parse CST to AST adapter" { class: cst }
    }

    injected: "injected DSL families" {
      class: current
      grid-columns: 3
      re: "re" { class: grammar }
      glob: "glob" { class: grammar }
      ast: "ast and ast-grep" { class: grammar }
      json: "json · yaml · toml" { class: grammar }
      sql: "sql · sql_where" { class: grammar }
      md: "markdown" { class: grammar }
    }

    grammar_regen: "grammar generation lanes" {
      class: note
      grid-columns: 1
      just_host: "just regen-host and v4-regen-host" { class: shell }
      just_ops: "just regen-op and regen-grammars" { class: shell }
      highlights: "queries/highlights.scm bundled per DSL" { class: artifact }
    }
  }

  cst: "4 · CST, AST, and DSL body model" {
    class: tier
    grid-columns: 3
    grid-gap: 20

    v4_cst: "v4/src/cst sprf-blind tree runtime" {
      class: current
      grid-columns: 2
      store: "Store + MemStore" { class: cst }
      doc: "Doc + DocId" { class: cst }
      path: "Path + PathItem + locate/resolve" { class: cst }
      inject: "Injected subtree parse_body" { class: cst }
      dsl: "Dsl trait: compile + capture rows" { class: cst }
      lsp: "DslBodyLsp provider trait" { class: cst }
    }

    v4_compile_ast: "v4 compile AST" {
      class: current
      grid-columns: 1
      ast: "compile/ast.rs value-typed PipeAst" { class: cst }
      parse: "compile/parse.rs host_parse" { class: cst }
      holes: "slots, terms, body DSL text" { class: cst }
    }

    v3_parse: "v3 parse surface" {
      class: legacy
      grid-columns: 1
      ast: "sprefa_parse/ast.rs Pipe, Fork, OpInvocation" { class: cst }
      site: "site.rs source sites and spans" { class: cst }
      exp: "parse_experiment and lang_prototype POCs" { class: attic }
    }
  }

  lower: "5 · lower, binding analysis, and rule fusion" {
    class: tier
    grid-columns: 3
    grid-gap: 20

    v4_lower: "v4 compile pipeline" {
      class: current
      grid-columns: 2
      walk: "walk_program: PipeAst to Pipe<Cursor>" { class: lower }
      bind: "binding_graph: grounded vs holes" { class: lower }
      strat: "stratify: recursion, negation, source gates" { class: lower }
      fuser: "fuser: FusedRule and SQL fusion kind" { class: lower }
      probe: "probe_wrap diagnostics around components" { class: lower }
      lift: "lower/liftable and where_eval" { class: lower }
    }

    v4_registry: "v4 lower registry" {
      class: current
      grid-columns: 1
      opdef: "OperatorDef: validate_call + lower" { class: trait }
      registry: "lower/registry name to op definition table" { class: lower }
      ctx: "LowerCtx carries store, graph, source index, diags" { class: lower }
    }

    v3_lower: "v3 pipeline lower" {
      class: legacy
      grid-columns: 1
      lower: "lower.rs two-pass AST to Pipeline" { class: lower }
      bind: "binding_graph Read vs Unbound modes" { class: lower }
      walk: "walk/ compiled pattern pipeline" { class: lower }
      dd: "dd/ optional differential-dataflow gate" { class: attic }
    }
  }

  ops: "6 · operators, registries, and DSL implementations" {
    class: tier
    grid-columns: 4
    grid-gap: 18

    v4_ops: "v4/src/v2_ops.rs operator catalog" {
      class: current
      grid-columns: 1
      sources: "repo · rev · fs · read · source-aware ast/json" { class: op }
      patterns: "re · glob · json · ast · ast_yaml · markdown" { class: op }
      rules: "rule write · query · apply · force" { class: op }
      effects: "render · sh · lsp · write_cursor · str/split" { class: op }
    }

    v4_op_helpers: "v4 helper modules around ops" {
      class: current
      grid-columns: 1
      source: "source.rs + source_index.rs + source_clock.rs" { class: lower }
      git: "git_watch.rs + ghcache.rs" { class: lower }
      template: "template.rs + term.rs + cursor_codec.rs" { class: lower }
      replay: "runtime_replay.rs + sprf_introspect.rs" { class: lower }
    }

    v3_ops: "v3/crates/pipeline/src/ops" {
      class: legacy
      grid-columns: 2
      p1: "re · glob · ast_grep · ast_yaml · json" { class: op }
      p2: "repo · rev · fs · read" { class: op }
      p3: "tag · fact · rule · relation" { class: op }
      p4: "render · sh · lsp · write_file · write_cursor" { class: op }
      p5: "str · print · comment · void · cursor_ref" { class: op }
      p6: "op_ctor + sprefa_macros helpers" { class: op }
    }

    excluded_ops: "v3 carryover sprefa crate" {
      class: attic
      grid-columns: 1
      old_bridge: "crates/sprefa: reader/writer, DAG, store, server shapes" { class: attic }
      cherry_pick: "kept for cherry-picking, excluded from v3 workspace" { class: note }
    }
  }

  model: "7 · carrier model: cursor, term, refs, rows" {
    class: tier
    grid-columns: 4
    grid-gap: 18

    cursor_v4: "v4 Cursor and coordinate primitives" {
      class: current
      grid-columns: 1
      cursor: "Cursor: value, terms, at, source identity" { class: trait }
      term: "Term, CursorValue, templates" { class: trait }
      coord: "Coord and WhereBytes" { class: trait }
      ids: "RepoId · RevId · FileId · RefId · StringId" { class: trait }
    }

    row_runtime: "effect_runtime v2 generic row model" {
      class: legacy
      grid-columns: 1
      next: "Next carrier and Node algebra" { class: trait }
      row: "Row trait and content_id" { class: trait }
      codec: "Codec for queued continuations" { class: trait }
    }

    relation_v3: "v3 cursor and relation model" {
      class: legacy
      grid-columns: 1
      c0: "_0_cursor: content, range, captures, slots" { class: trait }
      value: "Value, Seg, ArgSpec materialization" { class: trait }
      rel: "RelationStore row bags and wakers" { class: store }
    }

    invariants: "identity and provenance invariants" {
      class: note
      grid-columns: 1
      stable: "blake3-derived ids where possible" { class: note }
      owner: "owner-scoped retraction for full-extent writes" { class: note }
      support: "support rows keep mounted outputs alive" { class: note }
    }
  }

  runtime: "8 · runtime execution: batches, ticks, queues" {
    class: tier
    grid-columns: 3
    grid-gap: 20

    v4_runtime: "v4 runtime facade" {
      class: current
      grid-columns: 2
      pipeline: "pipeline.rs expands lowered Pipe" { class: runtime }
      fixpoint: "fixpoint.rs + rule.rs recursion/retry" { class: runtime }
      bridge: "runtime_bridge.rs to effect_runtime v2" { class: runtime }
      replay: "runtime_replay.rs warm replay hooks" { class: runtime }
      dirty: "dirty_source.rs source-driven reruns" { class: runtime }
      mounted: "mounted_query.rs visible mounted outputs" { class: runtime }
    }

    er_v2: "v3 effect_runtime::v2 used by v4" {
      class: legacy
      grid-columns: 2
      component: "Component + RenderCtx + RuntimePut" { class: runtime }
      expand: "expand.rs PipeInstance batch runner" { class: runtime }
      node: "Node: Emit, Many, Park, Done" { class: runtime }
      queue: "QueueBackend + Wake + ExpandTick" { class: queue }
      memo: "memoize + memo_seam + query cache" { class: queue }
      dispatch: "EffectDispatch + Thread/Tokio spawner" { class: runtime }
    }

    old_runtime: "v3 pre-v2 runtime and experiments" {
      class: legacy
      grid-columns: 1
      rx: "rx.rs + subjects.rs + generation.rs" { class: runtime }
      batchers: "batchers passthrough, bounded, work-steal, cache" { class: queue }
      effect_proof: "experiments/effect_proof benchmark POCs" { class: attic }
      stream_kernel: "pipeline/examples rx and stream kernel proofs" { class: attic }
    }
  }

  persistence: "9 · facts, stores, SQL, and reactive graph" {
    class: tier
    grid-columns: 4
    grid-gap: 18

    sprf_store: "v4 SprfStore semantic core" {
      class: current
      grid-columns: 1
      intern: "_strings, norm, files, repos, revs, paths" { class: store }
      refs: "_where_bytes refs and observations" { class: store }
      pending: "thread-local pending core flush rows" { class: queue }
      lru: "striped LRU hot tier over cold FactStore" { class: queue }
    }

    fact_store: "effect_runtime FactStore backends" {
      class: legacy
      grid-columns: 1
      mem: "MemFactStore" { class: store }
      sqlite: "SqliteFactStore with bundled rusqlite" { class: store }
      declare: "declare, insert_batch, select, anti_join" { class: trait }
    }

    reactive_graph: "runtime graph and mounted queries" {
      class: current
      grid-columns: 1
      facade: "v4 RuntimeGraph facade" { class: graph }
      inner: "FactRuntimeGraph: subscribe, support, dirty owner" { class: graph }
      mounted: "mounted query support cursor ids" { class: graph }
      dirty: "visible delta drives owner reruns" { class: graph }
    }

    sql_queue: "SQL and durable queues" {
      class: current
      grid-columns: 1
      sql: "v4/sql.rs temp SQLite joins, antijoins, fused rules" { class: store }
      memq: "MemQueue" { class: queue }
      sqlq: "SqliteQueue parked continuations" { class: queue }
      hybrid: "HybridQueue memory plus SQLite revival" { class: queue }
    }
  }

  effects: "10 · effects, outputs, and user-visible sinks" {
    class: tier
    grid-columns: 5
    grid-gap: 16

    effect_ops: "effect operators" {
      class: current
      grid-columns: 1
      write_file: "write_file" { class: effect }
      write_cursor: "write_cursor splice aggregation" { class: effect }
      sh: "sh process command" { class: effect }
      render: "render markdown, dot, html, d2-ish maps" { class: effect }
      lsp: "lsp diagnostics, hover, semantic rows" { class: effect }
    }

    output_files: "files and rendered artifacts" {
      class: current
      grid-columns: 1
      md: "Markdown reports" { class: artifact }
      dot: "Graphviz DOT and SVG" { class: artifact }
      html: "runtime-map HTML" { class: artifact }
      d2: "arch-codebase D2/SVG/PNG" { class: artifact }
    }

    editor_output: "editor client output" {
      class: current
      grid-columns: 1
      diag: "diagnostics" { class: shell }
      hover: "hover and DSL body lookup" { class: shell }
      semantic: "semantic tokens and inlay" { class: shell }
    }

    cli_output: "CLI and daemon output" {
      class: current
      grid-columns: 1
      stdout: "stdout rows and telemetry" { class: shell }
      http: "daemon HTTP/JSON routes" { class: shell }
      exit: "process status and logs" { class: shell }
    }

    tests_output: "quality gates" {
      class: current
      grid-columns: 1
      cargo: "v4/tests integration corpus" { class: test }
      lsp_tests: "sprefa-lsp tests" { class: test }
      v3_tests: "v3 cargo + shell smoke suites" { class: test }
    }
  }

  support: "11 · feedback loops: tests, benches, docs, examples" {
    class: tier
    grid-columns: 5
    grid-gap: 16

    v4_tests: "v4/tests behavior targets" {
      class: current
      grid-columns: 1
      a: "parse, walk, lower, v3 parity" { class: test }
      b: "rules, recursion, retraction, antijoin" { class: test }
      c: "runtime graph, queue revival, store smoke" { class: test }
      d: "LSP locate, hover, DSL dogfood" { class: test }
    }

    v4_examples: "v4/examples dogfood apps" {
      class: current
      grid-columns: 1
      repo: "repo deps, crawl, drift, npm graphs" { class: io }
      docs: "docs toc, doc drift, Rust panic maps" { class: io }
      lsp: "LSP flow and transclusion examples" { class: io }
      arch: "arch-map.d2 and system-architecture-mermaid.sprf" { class: io }
    }

    bench_perf: "bench and perf loops" {
      class: current
      grid-columns: 1
      bench: "v4/bench linux, join, antijoin fixtures" { class: test }
      perf: "v4/perf baseline.toml" { class: artifact }
      stress: "cursor codec + sqlite queue stress bins" { class: test }
    }

    v3_corpus: "v3 validation and prior art" {
      class: legacy
      grid-columns: 1
      docs: "v3/docs semantic model and runtime shape" { class: doc }
      smoke: "v3/tests/smoke executable shell specs" { class: test }
      exp: "experiments effect, parse, language prototype" { class: attic }
    }

    meta: "meta-memory and work tracking" {
      class: note
      grid-columns: 1
      goals: "human-goals.md and llm-notes.md" { class: doc }
      plans: "plans active architecture notes" { class: plan }
      beads: ".beads issue store; bd expected" { class: artifact }
      agents: ".agents skills encode durable project heuristics" { class: doc }
    }
  }

  spine: "12 · executable spine in one breath" {
    class: tier
    grid-columns: 8
    grid-gap: 10

    s0: ".sprf bytes" { class: io }
    s1: "tree-sitter host parse" { class: grammar }
    s2: "CST + injected DSL trees" { class: cst }
    s3: "PipeAst lower + binding graph" { class: lower }
    s4: "OperatorDef to Component" { class: op }
    s5: "expand tick over Cursor batches" { class: runtime }
    s6: "FactStore + SprfStore + graph" { class: store }
    s7: "effects, rows, editor, files" { class: effect }
  }

  legend: "legend and reading rules" {
    class: tier
    grid-columns: 6
    grid-gap: 10

    l0: "solid blue container = current v4 path" { class: current }
    l1: "dashed gray container = v3 legacy or shared substrate" { class: legacy }
    l2: "package = grammar or generated parser" { class: grammar }
    l3: "teal rectangle = lowering/runtime stage" { class: lower }
    l4: "hexagon = operator family" { class: op }
    l5: "cylinder = fact or semantic store" { class: store }
    l6: "pink rounded = reactive graph edge/state" { class: graph }
    l7: "queue = parked work, memo, durable queue" { class: queue }
    l8: "purple parallelogram = post-render effect" { class: effect }
    l9: "document/page = docs, plans, tests" { class: doc }
    l10: "long cross-edges omitted; containment carries detail" { class: note }
    l11: "main arrows are the flow you debug first" { class: note }
  }
}

# Main executable flow. Detail is held in containment so the edges stay readable.
diagram.repo.current_v4 -> diagram.entry.cli_v4: "current binaries"
diagram.repo.legacy_v3 -> diagram.entry.v3_server: "legacy binaries"
diagram.repo.editor_surface -> diagram.entry.lsp_v4: "extension launches LSP"

