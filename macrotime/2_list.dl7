; The list-literal macro. `[a b c]` reads as one flat node headed by the atom
; `[`, one item per element, and expands to one `tuple` call node: the
; anonymous product constructor, its arity the argument count.
;
; TypeScript-shaped row signatures (NodeId and Relation as in 0_standard.dl7):
;
; type ListForm = Relation<readonly [form: NodeId]>
; type ListMint = Relation<readonly [
;   form: NodeId,
;   templatePath: number,
;   output: NodeId,
; ]>

(: list_form
   (* (: form type)))

(: list_mint
   (* (: form type)
      (: template_path int)
      (: output type)))

; The two minted nodes per claim: 0 the call, 1 its own head atom.
(: list_template_path
   (* (: template_path int)))

(list_template_path 0)
(list_template_path 1)

; function listForm(form: FormNode<[AtomNode<"[">, ...Item]>): NodeId
(<- (list_form ?Form)
    (syntax_form ?Form)
    (: ?Form item ?Head 0)
    (syntax_atom ?Head "["))

(<- (syntax_claim ?Form "[")
    (list_form ?Form))

; GeneratedSyntax(form, output ordinal, template path): 0 is the single
; expansion output, template path 0 the call node, 1 its head atom.
(<- (list_mint ?Form ?TemplatePath ?Output)
    (list_form ?Form)
    (list_template_path ?TemplatePath)
    (GeneratedSyntax ?Form 0 ?TemplatePath ?Output))

(<- (node ?Output)
    (list_mint ?Form ?TemplatePath ?Output))

(<- (syntax_form ?Output)
    (list_mint ?Form 0 ?Output))

(<- (syntax_atom ?Output "tuple")
    (list_mint ?Form 1 ?Output))

(<- (syntax_source ?Output ?Path ?StartOffset ?EndOffset
                   ?StartLine ?StartColumn ?EndLine ?EndColumn)
    (list_mint ?Form ?TemplatePath ?Output)
    (syntax_source ?Form ?Path ?StartOffset ?EndOffset
                   ?StartLine ?StartColumn ?EndLine ?EndColumn))

(<- (: ?Form expansion ?Output 0)
    (list_mint ?Form 0 ?Output))

; A `tuple` call node carries its own head atom plus every original item at
; its original position.
(<- (: ?Output item ?Atom 0)
    (list_mint ?Form 0 ?Output)
    (list_mint ?Form 1 ?Atom))

(<- (: ?Output item ?Item ?Position)
    (list_mint ?Form 0 ?Output)
    (: ?Form item ?Item ?Position)
    (int.lt 0 ?Position))
