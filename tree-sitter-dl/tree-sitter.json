{
  "grammars": [
    {
      "name": "dl",
      "camelcase": "Dl",
      "scope": "source.dl",
      "file-types": ["dl"],
      "injection-regex": "^dl$",
      "class-name": "TreeSitterDl"
    }
  ],
  "metadata": {
    "version": "0.0.1",
    "license": "MIT",
    "description": "tree-sitter grammar for sprefa v5 .dl source",
    "authors": [
      { "name": "sprefa" }
    ],
    "links": {
      "repository": "https://github.com/sprefa/sprefa"
    }
  },
  "bindings": {
    "c": true,
    "go": false,
    "node": false,
    "python": false,
    "rust": true,
    "swift": false,
    "zig": false
  }
}
