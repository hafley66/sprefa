# ============================================================
# golden_kitchen_sink.sprf
#
# Run from the repo root:
#   v3/target/debug/sprefa-run \
#     v3/crates/server/fixtures/golden_kitchen_sink.sprf --root .
#
# Mock data lives under golden_kitchen_sink_data/ next to this file:
#   openapi.json     — RTKQ-shape OpenAPI spec
#   api/usersApi.ts  — RTKQ slice with hook re-exports
#   api/postsApi.ts  — second RTKQ slice
#   Cargo.toml       — TOML for the json op
#   config.yaml      — YAML for the json op
#   HOOKS.md         — write target with comment-bounded scopes
#
# Comment-bounded auto-render (main goal):
#   HOOKS.md contains `<!-- @sprf-begin <name> -->` / `<!-- @sprf-end -->`
#   marker pairs. The pipes below open the scope via the comment op,
#   render cursors as markdown, and splice them back into HOOKS.md
#   at SCOPE.byte_range. Re-running refreshes the region in place.
#
# Op surface covered:
#   repo, rev, fs, glob, ast, ast_yaml, json (json/yaml/toml),
#   comment (scope-paired), render[md|plain], write_cursor, str, print
#
# Future-extension notes inline:
#   ${re(...)} / ${glob(...)} pattern holes —
#     chat_log/20260427.4.ast-pattern-regex-hole.md
#   <op>/no-output diagnostic on empty cursor stream —
#     chat_log/20260427.3.zero-cursor-diag-lift.md
#   line() — v2 line-by-line regex filter, not yet ported
# ============================================================


# ---------- 1. JSON OP — openapi operationId scan ----------
# json() dispatches on file extension: .json, .yaml, .yml, .toml.
# Fixed-key walk: paths > /users > get/post > operationId.
repo(${R?}) > rev(:HEAD)
  > fs(glob(v3/crates/server/fixtures/golden_kitchen_sink_data/openapi.json))
  > json({ paths: { /users: { get: { operationId: ${OPID?} } } } })
  > print(:openapi_listusers);


# ---------- 2. JSON OP — TOML and YAML parity ----------
# Same op, three serialization formats. Confirms parse_by_ext routing.
repo(${R?}) > rev(:HEAD)
  > fs(glob(v3/crates/server/fixtures/golden_kitchen_sink_data/Cargo.toml))
  > json({ package: { name: ${N?}, version: ${V?} } })
  > print(:cargo);

repo(${R?}) > rev(:HEAD)
  > fs(glob(v3/crates/server/fixtures/golden_kitchen_sink_data/config.yaml))
  > json({ service: { name: ${SVC?}, port: ${PORT?} } })
  > print(:svc);


# ---------- 3. AST OP — RTKQ hook discovery ----------
# Bare identifier with metavar binds the hook root name.
# Today: one pipe per RTKQ suffix.
# Future (re-hole extension): collapse to a single pipe with
#   use${HOOK?}${re(Query|LazyQuery|Mutation)}
# (design: chat_log/20260427.4.ast-pattern-regex-hole.md)
repo(${R?}) > rev(:HEAD)
  > fs(glob(v3/crates/server/fixtures/golden_kitchen_sink_data/api/*.ts))
  > ast[ts](use${HOOK?}Query)
  > print(:rtkq_query);

repo(${R?}) > rev(:HEAD)
  > fs(glob(v3/crates/server/fixtures/golden_kitchen_sink_data/api/*.ts))
  > ast[ts](use${HOOK?}Mutation)
  > print(:rtkq_mut);


# ---------- 4. AST_YAML — composed ast-grep rule ----------
# Raw YAML rule body for predicates the bracket form cannot reach.
repo(${R?}) > rev(:HEAD)
  > fs(glob(v3/crates/server/fixtures/golden_kitchen_sink_data/api/*.ts))
  > ast_yaml[ts](
    pattern: "${EP?}: build.${KIND?}"
  )
  > print(:endpoints);


# ---------- 5. COMMENT OP — sequential narrowing ----------
# Single-marker form narrows cursor.content to the bytes following the
# marker line. Useful for in-source TODO scans / doc-block extraction.
repo(${R?}) > rev(:HEAD)
  > fs(glob(v3/crates/server/fixtures/golden_kitchen_sink_data/api/*.ts))
  > comment("// Mock RTKQ-shaped")
  > print(:doc_banner);


# ---------- 6. STR OP — value passthrough ----------
str("hello-from-golden-demo") > print(:str_demo);


# ---------- 7. COMMENT-BOUNDED AUTO-RENDER (main goal) ----------
# HOOKS.md has two marker-pair scopes. Each pipe opens a scope, renders
# bytes, and splices them into the scope range, replacing whatever was
# there before. Routes through the Phase 1 stage→approve→commit loop:
# WriteRangeEffect → WriteRangeBatcher::stage_and_approve → splice +
# wake the op's pre-subscribed approval key. (Card sprefa-ft8.)
#
# Disk-mode fs (no repo/rev prefix) so the WriteRangeEffect lands on a
# live working-copy path. Run this section by cd'ing into the data dir:
#   cd v3/crates/server/fixtures/golden_kitchen_sink_data
#   sprefa-run ../golden_kitchen_sink.sprf --root .
# The repo/rev path through git needs the auto-worktree work landed by
# sprefa-04w (Phase 2).
#
# Marker text contract: `<!-- @sprf-begin <name> -->` — the comment op
# strips the leading `<!--` and matches marker text against the line
# tail. Pass the marker label (no `<!--` and no trailing `-->`).
#
# CAVEAT — multi-seed write coordination is not landed.
# When the workspace has N seeds (sprefa@HEAD, sprefa@test/1, ...) the
# pipes below run once per seed. The first splice lands fine; the 2nd
# uses a stale SCOPE.byte_range (the file was already mutated) and
# clobbers HOOKS.md. Until per-file write coordination lands, run these
# pipes against a workspace with a single seed, or guard with `rev(:HEAD)`
# once that filter composes with disk-mode fs. Tracked as a follow-on
# to sprefa-ft8.
fs(glob(**/HOOKS.md))
  > comment("@sprf-begin rtkq", ${SCOPE?}, "@sprf-end rtkq")
  > render[plain](
- discovered RTKQ hook scopes go here (Phase 1 staging)
)
  > write_cursor(${SCOPE}, :replace);

fs(glob(HOOKS.md))
  > comment("@sprf-begin openapi", ${SCOPE?}, "@sprf-end openapi")
  > render[plain](
- discovered openapi operationIds go here (Phase 1 staging)
)
  > write_cursor(${SCOPE}, :replace);


# ---------- 8. ZERO-CURSOR DIAG ANCHORS (intentional empty matches) ----------
# Each pipe is crafted to match nothing in the mock data. Once the v2
# zero-cursor diagnostic lands (chat_log/20260427.3.zero-cursor-diag-lift.md)
# the LSP should surface `<op>/no-output` diagnostics anchored to each
# op's source span in this file.
repo(${R?}) > rev(:HEAD)
  > fs(glob(v3/crates/server/fixtures/golden_kitchen_sink_data/api/*.ts))
  > ast[ts](useNonExistentHookQuery) > print(:should_be_empty);

repo(${R?}) > rev(:HEAD)
  > fs(glob(v3/crates/server/fixtures/golden_kitchen_sink_data/openapi.json))
  > json({ paths: { /no-such-route: { get: { operationId: ${X?} } } } })
  > print(:should_also_be_empty);

repo(${R?}) > rev(:HEAD)
  > fs(glob(v3/crates/server/fixtures/golden_kitchen_sink_data/api/*.ts))
  > ast_yaml[ts](pattern: "thisIdentifierDoesNotExist")
  > print(:yaml_empty);

repo(${R?}) > rev(:HEAD)
  > fs(glob(v3/crates/server/fixtures/golden_kitchen_sink_data/api/*.ts))
  > comment("// @no-such-marker") > print(:comment_empty);
