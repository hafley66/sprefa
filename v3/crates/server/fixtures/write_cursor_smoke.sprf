# write_cursor smoke — splice into a cursor's byte_range.
# Spec: v3/docs/v3-render-write-cursor-vision.md
# Status: DOES NOT PARSE TODAY — uses @begin/@end comment markers and
#   dotted carveout access (${rev.head?}) pending grammar landing in
#   sprefa-p0m. Registry impl pending sprefa-1cl.
#
# Positional args, no kwargs:
#   write_cursor(target_cursor)              — :replace (default)
#   write_cursor(target_cursor, :append)     — insert at byte_range.end
#   write_cursor(target_cursor, :prepend)    — insert at byte_range.start
#   write_cursor(target_cursor, :wrap)       — surround existing bytes
#
# Backed by single WriteRangeEffect{file, byte_range, new_bytes, mode}.
# Same effect powers write_file (range = whole file) and LSP code-action
# edits.

# Bind a comment-bounded scope, then replace its body with rendered list.
fs(glob(./src/lib.rs))
  > comment(@begin auto-imports ${SCOPE?} @end)
  > rule(:import_scope);

fs(glob(./src/modules/*.rs))
  > render[rust](use crate::${fs.stem};)
  > write_cursor(${SCOPE});

# Append a generated-on line at end of a marker block.
rule(:import_scope)
  > render[rust](// generated ${rev.head?})
  > write_cursor(${SCOPE?}, :append);

# Wrap an existing token with a macro call (refactor).
fs(glob(**/*.rs))
  > ast[rust](legacy_call(${ARGS?}))
  > render[rust](new_call!(${ARGS?}))
  > write_cursor(${HERE?}, :wrap);
