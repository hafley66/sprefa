{
  "openapi": "3.0.3",
  "info": {
    "title": "Mock RTKQ Demo API",
    "version": "0.2.0"
  },
  "paths": {
    "/users": {
      "get": { "operationId": "listUsers" }
    },
    "/users/{id}": {
      "get": { "operationId": "getUser" },
      "delete": { "operationId": "deleteUser" }
    },
    "/posts": {
      "get": { "operationId": "listPosts" }
    },
    "/comments": {
      "get": { "operationId": "listComments" }
    }
  }
}
