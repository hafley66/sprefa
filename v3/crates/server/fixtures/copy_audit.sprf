# Audit cursor for copies-from-source-bytes hot patterns.
# Run against the v3 pipeline + server tree to surface conversion
# sites that bypass Arc<[u8]> sharing. Each pipe targets one shape;
# review the row counts per pipe to triage.

repo(${R?}) > rev(:HEAD) > fs(glob(**/*.rs)) > ast[rs](${X?}.to_string());
repo(${R?}) > rev(:HEAD) > fs(glob(**/*.rs)) > ast[rs](${X?}.to_owned());
repo(${R?}) > rev(:HEAD) > fs(glob(**/*.rs)) > ast[rs](String::from_utf8_lossy(${X?}).into_owned());
repo(${R?}) > rev(:HEAD) > fs(glob(**/*.rs)) > ast[rs](String::from_utf8_lossy(${X?}));
repo(${R?}) > rev(:HEAD) > fs(glob(**/*.rs)) > ast[rs](String::from_utf8(${X?}));
repo(${R?}) > rev(:HEAD) > fs(glob(**/*.rs)) > ast[rs](format!(${X?}));
