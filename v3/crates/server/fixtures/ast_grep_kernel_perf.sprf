# Perf measurement fixture for sprefa-4m7.2.22.
# Mirrors the FINDINGS §1 baseline: scan kernel for printk call sites
# across both .c and .h (~63k files total — same corpus as the bench
# probe and the ast-grep CLI baseline). The glob sub-grammar today does
# not support alternation (`|`, `{c,h}`, `[ch]`), so the corpus is
# expressed as two pipes; FsListFilesEffect's per-(repo,rev) cache
# makes the second walk free, and the wall sums the two ast passes.
repo(R?) > rev(:HEAD) > fs(glob(**/*.c)) > ast[c](printk($$${ARGS?}))
repo(R?) > rev(:HEAD) > fs(glob(**/*.h)) > ast[c](printk($$${ARGS?}))
fact(:forever_a, A?);

`a/b/c\nx/y/z`
  # > re`${A?}/${B?}/${C?}`
  > {
    > is(A, :a) > forever_a(A);
    > is(A, :x) > forever_a(C);
  }
;

# that runs right away, colon is runsies

rule(:what_am_i_doing_with_my_life_fuck, LOL?) {
  forever_a?(A?) > print(A);
};

what_am_i_doing_with_my_life_fuck(`lol`);
