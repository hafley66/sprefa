# Phase F kernel invalidation probe.
#
# One pipe per kernel/<file>.c so the OpCache populates with independent
# cells per file. Hovering each `ast` op cold drains its pipe and
# populates 4 entries (repo/rev/fs/ast). Mutating one file's source
# bytes should evict ONLY that file's 4 entries; the other pipes' cache
# cells must survive.
#
# The harness hovers each pipe in order, snapshots cache.len, mutates
# acct.c, then re-hovers pipe 0 (acct.c) and asserts the cache shrunk
# by exactly the count tied to that file.
repo(${R?}) > rev(:wt) > fs(glob(kernel/acct.c)) > ast[c](printk($$${ARGS}))
repo(${R?}) > rev(:wt) > fs(glob(kernel/async.c)) > ast[c](printk($$${ARGS}))
repo(${R?}) > rev(:wt) > fs(glob(kernel/audit.c)) > ast[c](printk($$${ARGS}))
repo(${R?}) > rev(:wt) > fs(glob(kernel/audit_tree.c)) > ast[c](printk($$${ARGS}))
