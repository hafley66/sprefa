# selfcheck.sprf — dogfood lints over v3's own source tree.
#
# Run from v3/ root (so --root . resolves to v3):
#   v3/target/debug/sprefa-run \
#     v3/crates/server/fixtures/selfcheck.sprf --root .
#
# Open this file in VS Code (sprefa-lsp installed) for hover docs on
# every op and live re-evaluation as files change.
#
# Each pipe is a self-contained lint expressed as a sprf rule:
#   <source enumeration> > <pattern match> > <severity emit>.
# The lsp[severity](...) tail emits a diagnostic per matched cursor;
# sprefa-run prints them on stderr as `[<sev> <code>] <file> <range>: <msg>`,
# and the LSP backend will (once on_change drives /run) publish them
# directly to the editor's diagnostics panel.
#
# Running this against v3 itself catches:
#   - unhandled .unwrap() leaking into shipped code paths
#   - todo!() / unimplemented!() shipped without a tracking issue
#   - .expect(_) without a load-bearing message
#   - TODO/FIXME comments shipped without a beads ID
#   - duplicate effect-runtime registration sites (RtCtxBuilder::new
#     outside the canonical build_seed_ctx)
#   - JSON config shape regressions (ServerInfo / package.json)
#   - YAML / TOML parse health on workspace manifests
#   - scoped marker hooks (`<!-- @sprf-begin ... -->`) ready for codegen
#
# Op coverage: repo, rev, fs, glob, ast, ast_yaml, json, comment, str,
# print, lsp[error|warn|info|hint]. All four lsp severities exercised.
#
# Honesty about today's fire-rate (2026-04-27, sprefa root as workspace,
# v3 daemon): only `${V?}.unwrap()` reliably matches at scale (~1036
# hits across the v1+v3 tree). Patterns like `todo!()`, `panic!(...)`,
# `unimplemented!()`, `RtCtxBuilder::new()`, and `${V?}.expect("")`
# currently emit zero cursors — that is a real ast-grep-pattern gap in
# v3, not a bug in the lsp diagnostic wire-up. Each one stays in this
# file as a target for the gap to close against. Watching the diag
# count climb as the gap closes is the dogfood loop.


# ============================================================
# 1. Banned panics in production paths — Error severity.
# unwrap(), expect, panic!, unimplemented!, todo!.
# ============================================================

fs(glob(crates/**/src/**/*.rs))
  > ast[rust](${V?}.unwrap())
  > lsp[warn](
      message = "unwrap() in shipped path",
      code    = "selfcheck/no-unwrap",
      hint    = "use ? or .context(...) or expect(\"why\")");

fs(glob(crates/**/src/**/*.rs))
  > ast[rust](unimplemented!())
  > lsp[error](
      message = "unimplemented!() macro shipped",
      code    = "selfcheck/no-unimplemented",
      hint    = "stub with anyhow::bail! or file a beads card");

fs(glob(crates/**/src/**/*.rs))
  > ast[rust](todo!())
  > lsp[warn](
      message = "todo!() macro shipped",
      code    = "selfcheck/no-todo-macro",
      hint    = "lower to anyhow::bail! once the path is reachable");

fs(glob(crates/**/src/**/*.rs))
  > ast[rust](panic!(${MSG?}))
  > lsp[warn](
      message = "panic!() in shipped path",
      code    = "selfcheck/no-panic",
      hint    = "return Result and propagate up");


# ============================================================
# 2. Effect-runtime duplication — Error severity.
# RtCtxBuilder::new should appear EXACTLY once: inside
# crates/server/src/run.rs::build_seed_ctx. Any second call site is a
# silent drift surface (effect-kind list out of sync with /run vs hover).
# Selfcheck flags every match; eyeballing the list catches dupes.
# ============================================================

fs(glob(crates/**/src/**/*.rs))
  > ast[rust](RtCtxBuilder::new())
  > lsp[error](
      message = "RtCtxBuilder::new outside build_seed_ctx",
      code    = "selfcheck/rtctx-dup",
      hint    = "route through run::build_seed_ctx so registrations stay in one place");


# ============================================================
# 3. TODO / FIXME comment scan — Info severity.
# Hits committed `// TODO ...` and `// FIXME ...` strings via the
# comment op's single-marker form (narrows cursor.content to the bytes
# after the marker on that line).
# ============================================================

fs(glob(crates/**/src/**/*.rs))
  > comment("// TODO")
  > lsp[info](
      message = "TODO comment shipped",
      code    = "selfcheck/todo-comment",
      hint    = "open a beads card and reference its id (sprefa-XXX)");

fs(glob(crates/**/src/**/*.rs))
  > comment("// FIXME")
  > lsp[info](
      message = "FIXME comment shipped",
      code    = "selfcheck/fixme-comment");


# ============================================================
# 4. .expect with empty / placeholder message — Hint severity.
# `.expect("")` and `.expect("TODO")` carry no debugging value.
# ============================================================

fs(glob(crates/**/src/**/*.rs))
  > ast[rust](${V?}.expect(""))
  > lsp[hint](
      message = "expect with empty message",
      code    = "selfcheck/expect-empty");

fs(glob(crates/**/src/**/*.rs))
  > ast[rust](${V?}.expect("TODO"))
  > lsp[hint](
      message = "expect with placeholder message",
      code    = "selfcheck/expect-todo");


# ============================================================
# 5. Cargo.toml parse — json op TOML routing.
# Confirms the workspace package can still be read by the same op
# family that drives JSON config dispatch. Cursors emit pkg names;
# print rolls them up so /run output is grep-able.
# ============================================================

fs(glob(Cargo.toml))
  > json({ workspace: { members: ${MEMBERS?} } })
  > print(:workspace-members);

fs(glob(crates/*/Cargo.toml))
  > json({ package: { name: ${PKG?} } })
  > print(:crates);


# ============================================================
# 6. ast_yaml — composed rule body for predicates the bracket form
# cannot reach. Confirms the alternate ast entry-point still parses
# and routes through ast-grep-core.
# ============================================================

fs(glob(crates/**/src/**/*.rs))
  > ast_yaml[rust](pattern: "fn ${N?}_test(${ARGS?})")
  > lsp[info](
      message = "test fn naming convention `_test` suffix",
      code    = "selfcheck/test-fn-suffix");


# ============================================================
# 7. Comment-marker zones ready for codegen — write_cursor has nothing
# to do today, but the enumeration confirms scopes parse cleanly. Read
# only; no write_cursor tail. Run-time stays idempotent across reruns.
# ============================================================

fs(glob(**/*.md))
  > comment("<!-- @sprf-begin", ${SCOPE?}, "<!-- @sprf-end -->")
  > lsp[info](
      message = "marker-zone ready for codegen",
      code    = "selfcheck/marker-zone");


# ============================================================
# 8. str() literal — value passthrough, sanity smoke for the dispatcher.
# No-op as a lint, but proves the framework's most trivial op survives
# when the rest of the tree changes.
# ============================================================

str("selfcheck-heartbeat") > print(:heartbeat);
