# sprefa-4iv smoke: source-op arg-pipe contract.
#
# Pipe 1 populates a :revs bag with explicit literal tag writes.
# Pipe 2 reads :revs as an arg-pipe to rev(): each tag row is one
# resolved rev. The rest of the pipe (fs(glob) > print) sees the
# downstream cursor's rev set from the bag row's value.
#
# Same shape generalizes to repo() and fs() — any tag arg-pipe
# producing last_bound becomes a coord source.
#
# Run from repo root:
#   v3/target/debug/sprefa-run \
#     v3/crates/server/fixtures/argpipe_demo.sprf --root .

# Seed the :revs bag.
tag(:revs, "HEAD");
tag(:revs, "test/1");

# Show what the arg-pipe produces: rev() should fan out the upstream
# cursor into one per :revs row, with cursor.rev rebound from REV.
repo(${R?})
  > rev(tag?(:revs, ${REV?}))
  > print(:after_argpipe);

# Then chain fs(glob) — files only exist at HEAD in this fixture, so
# expected output is HEAD-only file rows (proves rev rebinding survived
# downstream).
repo(${R?})
  > rev(tag?(:revs, ${REV?}))
  > fs(glob(v3/crates/server/fixtures/golden_kitchen_sink_data/api/*.ts))
  > print(:per_rev_files);
