# lsp[severity] smoke — programmable diagnostics, hot-reload on save.
# Spec: v3/docs/v3-render-write-cursor-vision.md
# Status: PARSES TODAY (registry impl pending sprefa-5ii).
#
# Cursor.byte_range IS the diagnostic range. Bracket-arg picks severity:
# error / warn / hint / info. Backend collects per-doc into the LSP
# diag channel.

# Lint: no .unwrap() in production paths.
fs(glob(**/*.rs))
  > ast[rust](unwrap())
  > lsp[warn](
      message = "unwrap in production path",
      code    = "no-unwrap",
      hint    = "use ? or .context(...)");

# Lint: hard-coded localhost in shipped code.
fs(glob(src/**/*.rs))
  > ast[rust]("http://localhost${PORT?}")
  > lsp[error](
      message = "hard-coded localhost",
      code    = "no-localhost");

# Hint: TODO in committed code surfaces as info.
fs(glob(**/*.{rs,ts,py}))
  > comment(TODO ${BODY?})
  > lsp[info](message = ${BODY});
