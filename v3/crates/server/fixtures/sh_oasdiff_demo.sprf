# ============================================================
# sh_oasdiff_demo.sprf
#
# First-pass exercise of the `sh` op + an ast-grep RTKQ scan
# routed through `lsp[warn]`. Run from the data dir:
#
#   cd v3/crates/server/fixtures/golden_kitchen_sink_data
#   ../../../../target/debug/sprefa-run \
#     ../sh_oasdiff_demo.sprf --root .
#
# Pipes:
#   1. sh smoke              hello-world bash through `sh()`
#   2. sh dry-run            shows DryRun policy never spawns subprocess
#   3. sh oasdiff            run oasdiff breaking, parse JSON array,
#                            print per-breaking-op tuple
#   4. ast-grep + lsp warn   every RTKQ Mutation hook gets a `lsp[warn]`
#                            anchored at its source span; pair manually
#                            with pipe 3's output to spot the createUser
#                            removal
# ============================================================

# 1. plain sh
sh(echo hello-from-sh) > print(:sh_demo);

# 2. dry-run policy never executes; staged_sh row should report DryRun
sh[dry](rm -rf would-have-been-bad) > print(:sh_dry);

# 3. oasdiff -> json -> per-row print
#    json walks an array of {operationId, path, operation} objects
sh[cache](oasdiff breaking openapi.json openapi.head.json -f json)
  > json([...{ operationId: ${OPID?}, path: ${PATH?}, operation: ${METHOD?} }])
  > print(:oasdiff_breaking);

# 4. ast-grep scan for every RTKQ Mutation hook, emit lsp[warn] on the
#    hook usage span. Pair with pipe 3 to find createUser -> useCreateUserMutation.
fs(glob(**/api/*.ts))
  > ast[ts](use${HOOK?}Mutation)
  > lsp[warn](
      message="RTKQ mutation hook detected; verify against latest OpenAPI breaking changes (see oasdiff_breaking pipe).",
      code="rtkq/openapi-drift")
  > print(:rtkq_mutations);
