# rule? predicate smoke: Probe (all-bound) + Join (mixed) + Query (all-unbound).
#
# Define a 2-arity rule. Body emits one row per call; capture_row records
# {repo, rev, name, role, R}. Auto-fire seeds one row with empty params.
# Three explicit calls populate rule_rows[:user] with meaningful data.
#
# Then exercise the predicate forms:
#   user?("alpha", "admin") all-bound → Probe HIT
#   user?("missing", "user") all-bound → Probe miss (cursor dropped)
#   user?(${N?}, ${R?})     all-unbound → Query (drains all rows)
#   user?("alpha", ${R?})   mixed → Join (filter name=alpha, project role)

rule(:user, ${name?}, ${role?}) {
  repo($R)
}

repo($Z) > user("alpha", "admin");
repo($Z) > user("beta", "user");
repo($Z) > user("gamma", "user");

user?("alpha", "admin") > print(:HIT);
user?("missing", "user") > print(:MISS);
user?(${N?}, ${R?}) > print(:QUERY);
user?("alpha", ${R?}) > print(:JOIN);
