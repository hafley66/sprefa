# fact(:name, ...) smoke — variadic write + nullary read; reactive.
# Spec: v3/docs/v3-render-write-cursor-vision.md
# Status: DOES NOT PARSE TODAY — uses dotted carveout access (${R.head?})
#   pending grammar landing in sprefa-p0m. Registry impl pending
#   sprefa-465; depends on Pending primitive sprefa-126.
#
# Two modes:
#   fact(:name, ${A?}, ${B?})  — write: assert a fact keyed by bindings
#   fact(:name)                — read:  subscription source

# Producer side: declare each repo+rev pair we currently track as
# "prod-cut". Re-fires whenever any repo or rev binding refreshes.
repo(${R?}) > rev(:prod) > fact(:prod-cut, ${R?}, ${R.head?});

# Consumer side: any pipe step can subscribe and emit one cursor per
# (repo, rev) tuple currently bound to :prod-cut.
fact(:prod-cut)
  > fs(glob(**/*.rs))
  > ast[rust](pub fn ${F?}())
  > rule(:prod_pub_fns);

# Multi-fact join: cursor emitted only when both facts are bound.
fact(:prod-cut) > fact(:in-review)
  > rule(:prod_pending_review);
