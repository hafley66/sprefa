# render[md] smoke — markdown rendering into a comment-bounded scope.
# Spec: v3/docs/v3-render-write-cursor-vision.md
# Status: DOES NOT PARSE TODAY — uses dotted carveout access (${fs.stem})
#   pending grammar landing in sprefa-p0m. Registry impls also pending
#   (sprefa-e6c render + sprefa-1cl write_cursor).
#
# Pattern: walk a folder, emit one bullet per child, splice into the
# `@begin` … `@end` marker pair.

repo(${R?}) > rev(:HEAD)
  > fs(glob(./views/*/))
  > render[md](- ${fs.stem})
  > write_cursor(${SCOPE?});

# Bound elsewhere by:
#   comment(@begin ${SCOPE?} @end)
# which yields SCOPE.byte_range covering the marker body.
