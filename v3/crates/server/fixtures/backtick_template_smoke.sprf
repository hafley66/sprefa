# backtick template-literal smoke.
# Spec: v3/docs/v3-render-write-cursor-vision.md
# Status: DOES NOT PARSE TODAY — backtick is unclaimed in current host
#   grammar; landing pending sprefa-p0m.
#
# JS-template-literal syntax: backticks delimit string body, ${...}
# re-enters the host carveout in read mode (output position only).
# Used by render[*] and the LSP message slot for terse interpolation.
#
# To enable: pin a parsing test against this fixture once grammar
# extension lands.

repo(${R?}) > rev(${REV?})
  > render[md](`# ${R.name} @ ${REV}\n\nGenerated by sprf.`)
  > write_cursor(${SCOPE?});

fs(glob(**/*.rs))
  > ast[rust](unwrap())
  > lsp[warn](
      message = `unwrap in ${fs.path}:${HERE.line} — use ?`);

fs(glob(./src/modules/*.rs))
  > render[rust](`use crate::${fs.stem};`)
  > write_cursor(${SCOPE?}, :append);
