# fact MVP smoke: write 2 rows, read drains both via positional binding.
#
# Three pipes, shared RelationStore on the seed-level RtCtx:
#   * pipes 0+1: fact(:hits, "...") — writes; cursor passes through.
#   * pipe 2: fact(:hits, ${A?}) — reads; emits one cursor per row with
#     $A bound positionally.
#
# The read pipe perpetually subscribes after the snapshot batch, so the
# binary keeps running. The smoke wraps it in `timeout`.
fact(:hits, "alpha");
fact(:hits, "beta");
fact(:hits, ${A?});
