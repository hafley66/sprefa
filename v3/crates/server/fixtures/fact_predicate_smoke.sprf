# fact? predicate smoke: probe Static + join (mixed) + drain query.
#
# pipes 0..2 seed three rows: (alpha, A1), (beta, B1), (gamma, G1).
# pipe 3: fact?(:rel, "alpha", "A1") — strict probe; both cols bound.
# pipe 4: fact?(:rel, "missing") — strict probe miss; cursor dropped
#         so print(:MISS) emits nothing.
# pipe 5: fact?(:rel, ${X?}, ${V?}) — all-unbound; drains every row.
# pipe 6: fact?(:rel, "beta", ${V?}) — mixed; filter X=beta, project V.
fact(:rel, "alpha", "A1");
fact(:rel, "beta", "B1");
fact(:rel, "gamma", "G1");
fact?(:rel, "alpha", "A1") > print(:HIT);
fact?(:rel, "missing") > print(:MISS);
fact?(:rel, "beta", ${V?}) > print(:JOIN);
fact?(:rel, ${X?}, ${V?}) > print(:DRAIN);
