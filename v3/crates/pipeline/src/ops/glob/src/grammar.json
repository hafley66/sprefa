{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/grammar.schema.json",
  "name": "sprefa_glob",
  "rules": {
    "source_file": {
      "type": "REPEAT",
      "content": {
        "type": "SYMBOL",
        "name": "_segment"
      }
    },
    "_segment": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "double_star"
        },
        {
          "type": "SYMBOL",
          "name": "star"
        },
        {
          "type": "SYMBOL",
          "name": "question"
        },
        {
          "type": "SYMBOL",
          "name": "slash"
        },
        {
          "type": "SYMBOL",
          "name": "brace_alt"
        },
        {
          "type": "SYMBOL",
          "name": "term_ref"
        },
        {
          "type": "SYMBOL",
          "name": "literal"
        }
      ]
    },
    "double_star": {
      "type": "STRING",
      "value": "**"
    },
    "star": {
      "type": "STRING",
      "value": "*"
    },
    "question": {
      "type": "STRING",
      "value": "?"
    },
    "slash": {
      "type": "STRING",
      "value": "/"
    },
    "brace_alt": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "{"
        },
        {
          "type": "SYMBOL",
          "name": "brace_alt_item"
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "SEQ",
            "members": [
              {
                "type": "STRING",
                "value": ","
              },
              {
                "type": "SYMBOL",
                "name": "brace_alt_item"
              }
            ]
          }
        },
        {
          "type": "STRING",
          "value": "}"
        }
      ]
    },
    "brace_alt_item": {
      "type": "PATTERN",
      "value": "[^,}]+"
    },
    "literal": {
      "type": "PATTERN",
      "value": "[^*?/${}]+"
    },
    "term_ref": {
      "type": "TOKEN",
      "content": {
        "type": "SEQ",
        "members": [
          {
            "type": "STRING",
            "value": "$"
          },
          {
            "type": "PATTERN",
            "value": "[A-Za-z_][A-Za-z0-9_]*"
          },
          {
            "type": "CHOICE",
            "members": [
              {
                "type": "STRING",
                "value": "?"
              },
              {
                "type": "BLANK"
              }
            ]
          }
        ]
      }
    }
  },
  "extras": [
    {
      "type": "PATTERN",
      "value": "\\s"
    }
  ],
  "conflicts": [],
  "precedences": [],
  "externals": [],
  "inline": [],
  "supertypes": [],
  "reserved": {}
}