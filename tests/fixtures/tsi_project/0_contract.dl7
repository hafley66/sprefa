; A loaded type carries no source name, so the probe reaches it structurally.

(tsi: (import "@std/tsi"))

(: Mapper
   (* (: id tsi.string)))

(: tsi_conforms_probe
   (* (: source type)
      (: proof type)))

(<- (asked ?Source Mapper)
    (field ?Source ?Name ?Target ?Index))

(<- (tsi_conforms_probe ?Source ?Proof)
    (product ?Source)
    (Extends ?Source Mapper ?Proof))
