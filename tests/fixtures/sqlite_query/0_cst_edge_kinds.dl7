(: Node
   (* (: input_path str)
      (: content_id str)
      (: family str)
      (: span_start int)
      (: span_end int)
      (: kind str)))

(: Edge
   (* (: input_path str)
      (: content_id str)
      (: family str)
      (: kind str)
      (: from_start int)
      (: from_end int)
      (: to_start int)
      (: to_end int)))

(: CstEdgeKinds
   (* (: input_path str)
      (: content_id str)
      (: edge_kind str)
      (: from_start int)
      (: from_end int)
      (: source_kind str)
      (: to_start int)
      (: to_end int)
      (: target_kind str)))

(<- (CstEdgeKinds
       ?InputPath ?ContentId ?EdgeKind
       ?FromStart ?FromEnd ?SourceKind
       ?ToStart ?ToEnd ?TargetKind)
    (Edge
      ?InputPath ?ContentId "cst" ?EdgeKind
      ?FromStart ?FromEnd ?ToStart ?ToEnd)
    (Node
      ?InputPath ?ContentId "cst"
      ?FromStart ?FromEnd ?SourceKind)
    (Node
      ?InputPath ?ContentId "cst"
      ?ToStart ?ToEnd ?TargetKind))
