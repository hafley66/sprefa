# G2 — md extracts markdown structure.
# Walks sem's .md files for H2 section headings.
#
# Run: cargo run --bin sprefa-v2 -- run examples/g2_md_sections.sprf --root ../ext/sem
# Expect: one row per `## SECTION` header across the markdown tree.

rule(md_section) {
  > repo($R) > rev($V) > fs(**/*.md)
    > md(## $SECTION)
};
