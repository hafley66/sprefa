# G4 — parse-cache stress. Four rules, same .rs files, different patterns.
# Each rule parses every matched .rs file independently. With a parse cache
# the parse work drops to 1 pass per file; without it, 4 passes.
#
# Run: cargo run --bin sprefa -- run v2/examples/g4_many_rules.sprf --root .

rule(pub_fn) {
  > repo($R) > rev($V) > fs(**/*.rs)
    > ast[rust](pub fn $NAME($$$ARGS) { $$$BODY })
};

rule(pub_struct) {
  > repo($R) > rev($V) > fs(**/*.rs)
    > ast[rust](pub struct $NAME { $$$FIELDS })
};

rule(pub_enum) {
  > repo($R) > rev($V) > fs(**/*.rs)
    > ast[rust](pub enum $NAME { $$$VARIANTS })
};

rule(impl_block) {
  > repo($R) > rev($V) > fs(**/*.rs)
    > ast[rust](impl $T { $$$ITEMS })
};
