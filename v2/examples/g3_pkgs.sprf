# G3 — json extracts scalar fields.
# Walks sem's package.json files and grabs name + version.
#
# Run: cargo run --bin sprefa-v2 -- run examples/g3_pkgs.sprf --root ../ext/sem
# Expect: one row per package.json with N and V bound.

rule(pkg) {
  > repo($R) > rev($V) > fs(**/package.json)
    > json({ name: $N, version: $VER })
};
