# G1 — ast-grep fans out across sources.
# Walks sem's crates, extracts public rust fn names.
#
# Run: cargo run --bin sprefa-v2 -- run v2/examples/g1_fns.sprf --root ../ext/sem
# Expect: one row per `pub fn NAME()` signature in the rust tree.

rule(pub_fn) {
  > repo($R) > rev($V) > fs(**/*.rs)
    > ast[rust](pub fn $NAME($$$ARGS) { $$$BODY })
};
