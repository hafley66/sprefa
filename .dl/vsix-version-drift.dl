# VSIX freshness rail: the embedded VS Code extension must match its source.
#
# `dl setup --vscode` installs a VSIX baked into the `dl` binary via
# `include_bytes!` (src/setup.rs, VSCODE_VSIX / VSCODE_VSIX_NAME). That embedded
# artifact rotted once (embedded 0.3.0 while the source was 0.4.3), so a fresh
# `dl setup --vscode` shipped a stale extension and `--force` install hid it.
# `.dl/watch-ext.dl` only rebuilds the LIVE extension (code --install-extension)
# — it never re-embeds the const, so nothing connected the two version strings.
#
# This rail declares that missing invariant: if editors/vscode-dl/package.json's
# version and the embedded VSIX filename version in src/setup.rs disagree,
# CI's `dl --check --root .` exits 2 and the LSP squiggles line 1.
#
# The fix when it fires: rebuild the VSIX at the package.json version
#   (cd editors/vscode-dl && npm ci && npm run compile && npx vsce package -o dl-lsp-<ver>.vsix)
# then point VSCODE_VSIX / VSCODE_VSIX_NAME at it and `git add -f` the new VSIX.

# The extension's own declared version (top-level "version" key; dependency
# ranges are keyed by package name, so only this one line matches).
rel pkg_version(version: text).
pkg_version(version) <-
    scan("WORK", "editors/vscode-dl/package.json", manifest_path, rev),
    match(manifest_path, rev, /"version"\s*:\s*"(?<version>\d+\.\d+\.\d+)"/, line).

# The version baked into the binary, read off the embedded VSIX filename in the
# two src/setup.rs consts (both lines carry the same version).
rel embedded_version(version: text).
embedded_version(version) <-
    scan("WORK", "src/setup.rs", setup_path, rev),
    match(setup_path, rev, /dl-lsp-(?<version>\d+\.\d+\.\d+)\.vsix/, line).

# Drift, both directions: a declared version with no matching embedded VSIX
# (bumped the extension, forgot to rebuild + re-embed), and an embedded version
# the manifest no longer declares (a hand-edited const).
diag(path: "editors/vscode-dl/package.json", line: 1, severity: "error",
     code: "vsix-version-drift",
     msg: "extension is package.json ${declared} but src/setup.rs embeds a different VSIX — rebuild (vsce package) at ${declared} and point VSCODE_VSIX_NAME at it") <-
    pkg_version(declared), !embedded_version(declared).

diag(path: "src/setup.rs", line: 1, severity: "error",
     code: "vsix-version-drift",
     msg: "src/setup.rs embeds VSIX ${embedded} but editors/vscode-dl/package.json no longer declares that version — the two must agree") <-
    embedded_version(embedded), !pkg_version(embedded).

? diag(path, line, severity, code, msg).
