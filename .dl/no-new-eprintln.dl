# Rail: eprintln containment ratchet
#
# Repo decision (R7 arc): tracing crate, never eprintln. DL_TRACE drives the
# CLI fmt layer, DL_LOG the daemon rolling logs. Internal machinery narration
# always routes through tracing; stderr prints are reserved for the small set
# of human-facing output contracts.
#
# Mechanism: ratchet baseline. Every file that mentions eprintln! today is
# grandfathered at its current survivor count. A file OVER its baseline count
# warns at the file head; a file with NO baseline row warns at every hit line
# (a brand-new eprintln site). When refactoring shrinks a file's count, lower
# its baseline row here in the same commit; rows at 0 get deleted.
#
# Waiver: a comment containing `@eprintln-ok: <reason>` on the hit line or the
# line above exempts that hit. Use it only for prints that are the command's
# output contract for a human at a TTY: final CLI-top-level error report before
# exit, interactive setup/uninstall/doctor prompts and reports, usage/help text.
#
# Run: dl .dl/no-new-eprintln.dl --check

rel eprintln_hit(source_file: file, line_number: int).
eprintln_hit(source_file, line_number) <-
    scan("WORK", "src/**/*.rs", source_file, source_rev),
    match(source_file, source_rev, /eprintln!/, line_number).

# Waiver comment lines (source rel; the range join lives in the derived rule
# below — a source-op body cannot join other rels, the S6 sharp edge).
rel eprintln_waiver_line(source_file: file, waiver_line: int).
eprintln_waiver_line(source_file, waiver_line) <-
    scan("WORK", "src/**/*.rs", source_file, source_rev),
    comment(source_file, source_rev, /@eprintln-ok:/, waiver_line, label: _).

# Waivered hits: @eprintln-ok: comment on the hit line or the line above.
rel eprintln_waived(source_file: file, line_number: int).
eprintln_waived(source_file, line_number) <-
    eprintln_waiver_line(source_file, waiver_line),
    eprintln_hit(source_file, line_number),
    waiver_line >= line_number - 1,
    waiver_line <= line_number.

# Countable hits: not waived.
rel eprintln_counted(source_file: file, line_number: int).
eprintln_counted(source_file, line_number) <-
    eprintln_hit(source_file, line_number),
    !eprintln_waived(source_file, line_number).

rel eprintln_count(source_file: file, hits: int).
eprintln_count(source_file, count(line_number)) <-
    eprintln_counted(source_file, line_number).

# Grandfathered baseline, measured post-conversion on the kimi-eprintln branch.
# Lower a row when your commit shrinks the file's count; never raise one.
rel eprintln_baseline(source_file: file, allowed: int).
eprintln_baseline("src/cli/check_deadline.rs", 2).
eprintln_baseline("src/cli/daemon.rs", 20).
eprintln_baseline("src/cli/mod.rs", 2).
eprintln_baseline("src/cli/query.rs", 10).
eprintln_baseline("src/config.rs", 1).
eprintln_baseline("src/corpus.rs", 2).
eprintln_baseline("src/daemon.rs", 3).
eprintln_baseline("src/docs_cmd.rs", 4).
eprintln_baseline("src/engine/derive.rs", 9).
eprintln_baseline("src/engine/gen.rs", 1).
eprintln_baseline("src/engine/repo.rs", 1).
eprintln_baseline("src/engine/tick.rs", 1).
eprintln_baseline("src/lib.rs", 10).
eprintln_baseline("src/scip_setup.rs", 11).
eprintln_baseline("src/setup.rs", 13).
eprintln_baseline("src/setup/vscode.rs", 1).
eprintln_baseline("src/setup/wire.rs", 1).
eprintln_baseline("src/update.rs", 4).
eprintln_baseline("src/verdict.rs", 2).
eprintln_baseline("src/watchdog.rs", 4).

# A grandfathered file grew past its baseline.
diag(
    path: source_file,
    line: 1,
    severity: "warning",
    code: "eprintln-exceeded",
    msg: "eprintln! use grew past this file's grandfathered baseline — convert to tracing, or waive the line with @eprintln-ok: <reason>"
) <-
    eprintln_count(source_file, hits),
    eprintln_baseline(source_file, allowed),
    hits > allowed.

# A file with no baseline row mentions eprintln!: brand-new spread, flag every
# hit line precisely.
diag(
    path: source_file,
    line: line_number,
    severity: "warning",
    code: "eprintln-new-file",
    msg: "new eprintln! outside the grandfathered baseline — convert to tracing, or waive with @eprintln-ok: <reason>"
) <-
    eprintln_counted(source_file, line_number),
    !eprintln_baseline(source_file, _).

# Route all codes to the agent-turn surface as well as commit: a new
# eprintln should confront the agent that just wrote it, not wait for commit.
diag_stage("eprintln-exceeded", "agent-turn").
diag_stage("eprintln-exceeded", "commit").
diag_stage("eprintln-new-file", "agent-turn").
diag_stage("eprintln-new-file", "commit").

? diag(path, line, severity, code, msg).
