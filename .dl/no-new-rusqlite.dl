# Rail: rusqlite containment
#
# The database seam is src/db.rs + src/storage.rs + src/storage/** (the plural
# Db struct chokepoint). All database code routes through it; rusqlite does not
# exist outside it. User ruling 2026-07-18: the seam stays a struct, welded to
# SQLite on purpose; it becomes a trait only when a second backend arrives.
# A backend-specific need (a pragma, an option) gets a named method on the
# seam, never an inline rusqlite call at the use site.
#
# History: this began as a ratchet with per-file grandfathered baselines while
# the 2026-07-18 seam migration burned ~700 sites down to zero. Migration
# complete, baselines deleted (user word, same day): the rail is now a flat
# ban — any rusqlite mention, `.conn()` escape hatch, or swallowed SQLite
# Result outside the rules below flags at its exact line.
#
# Waiver: a comment containing `@rusqlite-ok: <reason>` on the hit line or the
# line above exempts that hit (for the "this one call needs an SQLite-specific
# option" case; prefer a named seam method first).
#
# Run: dl .dl/no-new-rusqlite.dl --check

rel rusqlite_hit(source_file: file, line_number: int).
rusqlite_hit(source_file, line_number) <-
    scan("WORK", "src/**/*.rs", source_file, source_rev),
    match(source_file, source_rev, /use\s+rusqlite|rusqlite::/, line_number).

# The seam: the only files allowed to use rusqlite.
rel rusqlite_seam(source_file: file).
rusqlite_seam(source_file) <- scan("WORK", "src/db.rs", source_file, _).
rusqlite_seam(source_file) <- scan("WORK", "src/storage.rs", source_file, _).
rusqlite_seam(source_file) <- scan("WORK", "src/storage/**/*.rs", source_file, _).

# Waiver comment lines (source rel; the range join lives in the derived rule
# below — a source-op body cannot join other rels, the S6 sharp edge).
rel rusqlite_waiver_line(source_file: file, waiver_line: int).
rusqlite_waiver_line(source_file, waiver_line) <-
    scan("WORK", "src/**/*.rs", source_file, source_rev),
    comment(source_file, source_rev, /@rusqlite-ok:/, waiver_line, label: _).

# Waivered hits: @rusqlite-ok: comment on the hit line or the line above.
rel rusqlite_waived(source_file: file, line_number: int).
rusqlite_waived(source_file, line_number) <-
    rusqlite_waiver_line(source_file, waiver_line),
    rusqlite_hit(source_file, line_number),
    waiver_line >= line_number - 1,
    waiver_line <= line_number.

diag(
    path: source_file,
    line: line_number,
    severity: "warning",
    code: "rusqlite-outside-seam",
    msg: "rusqlite use outside the Db seam (src/db.rs + src/storage*) — add a named method on the seam instead, or waive with @rusqlite-ok: <reason>"
) <-
    rusqlite_hit(source_file, line_number),
    !rusqlite_seam(source_file),
    !rusqlite_waived(source_file, line_number).

# ---- .conn() escape hatch ----
# `.conn()` bypasses the Db seam without naming rusqlite, so it gets its own
# detection with the same rules. Same waiver comment applies.

rel conn_hit(source_file: file, line_number: int).
conn_hit(source_file, line_number) <-
    scan("WORK", "src/**/*.rs", source_file, source_rev),
    match(source_file, source_rev, /\.conn\(\)/, line_number).

# Waivers must join THIS detection's hit lines: `.conn()` lines don't match
# the rusqlite regex, so rusqlite_waived can never contain them (rail defect
# found red-proving the swallow ratchet 2026-07-18).
rel conn_waived(source_file: file, line_number: int).
conn_waived(source_file, line_number) <-
    rusqlite_waiver_line(source_file, waiver_line),
    conn_hit(source_file, line_number),
    waiver_line >= line_number - 1,
    waiver_line <= line_number.

diag(
    path: source_file,
    line: line_number,
    severity: "warning",
    code: "conn-outside-seam",
    msg: ".conn() escape-hatch use outside the Db seam — add a named method on the seam instead, or waive with @rusqlite-ok: <reason>"
) <-
    conn_hit(source_file, line_number),
    !rusqlite_seam(source_file),
    !conn_waived(source_file, line_number).

# ---- swallowed SQLite Results ----
# `let _ =` on a SQLite call discards the error path (class 13/16: silent
# checkpoint, invlog telemetry); NEW swallows are how the next silent failure
# is born (2026-07-18 poison-job incident: error diagnosis depends on every
# statement failure surfacing). The seam files are IN this check: a swallowed
# Result is a defect risk wherever it lives, seam included. Waive a deliberate
# one with `@rusqlite-ok: <reason>` and say why losing the error is safe.

rel sqlite_swallow_hit(source_file: file, line_number: int).
sqlite_swallow_hit(source_file, line_number) <-
    scan("WORK", "src/**/*.rs", source_file, source_rev),
    match(source_file, source_rev, /let _ = [^;]*(execute|query_row|query\(|prepare)/, line_number).

rel sqlite_swallow_waived(source_file: file, line_number: int).
sqlite_swallow_waived(source_file, line_number) <-
    rusqlite_waiver_line(source_file, waiver_line),
    sqlite_swallow_hit(source_file, line_number),
    waiver_line >= line_number - 1,
    waiver_line <= line_number.

diag(
    path: source_file,
    line: line_number,
    severity: "warning",
    code: "sqlite-swallow",
    msg: "`let _ =` on a SQLite call swallows its Result — propagate the error (?), or waive with @rusqlite-ok: <why losing this error is safe>"
) <-
    sqlite_swallow_hit(source_file, line_number),
    !sqlite_swallow_waived(source_file, line_number).

# Route all codes to the agent-turn surface as well as commit: a seam
# violation should confront the agent that just wrote it, not wait for commit.
diag_stage("rusqlite-outside-seam", "agent-turn").
diag_stage("rusqlite-outside-seam", "commit").
diag_stage("conn-outside-seam", "agent-turn").
diag_stage("conn-outside-seam", "commit").
diag_stage("sqlite-swallow", "agent-turn").
diag_stage("sqlite-swallow", "commit").

? diag(path, line, severity, code, msg).
