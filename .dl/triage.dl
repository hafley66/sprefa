# Editor triage wiring. Loaded by the vscode-dl extension in discovery
# mode (every `.dl/*.dl` in the workspace root merges into one program).
#
# Two jobs:
#   1. Capture type-name spans so textDocument/hover resolves the cursor to
#      a real identifier.
#   2. Reference type_entity so the type indexer opts in (lazy gate). That
#      populates type_edge, which the hover overlay reads to compute
#      Ca/Ce/fields/variants/impls per type.
#
# Once this file exists and the extension is installed, hovering any struct/
# enum/trait name shows the type-profile line:
#   **struct** `...::Engine`  src/engine.rs:144
#   Ca=12 Ce=8 fields=4 variants=0 impls=2
#
# NO SQUIGGLES: this program declares no `diag` relation. The output is the
# hover tooltip, not editor decorations. (rails.dl is what produces squiggles.)

rel type_span(name: text, f: file, l: int).
type_span(name, f, l) <-
    scan("WORK", "src/**/*.rs", f, rev),
    match(f, rev, /\b(struct|enum|trait|type|impl)\s+(?<name>[A-Z][A-Za-z0-9_]*)/, l).
type_span(name, f, l) <-
    scan("WORK", "src/**/*.rs", f, rev),
    match(f, rev, /\b(struct|enum|trait|type|impl)\s+(?<name>[A-Z][A-Za-z0-9_]*)/, l).

rel te(name: text).
te(name) <- type_entity(_, _, name, _, _, _, _).

