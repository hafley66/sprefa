# rusqlite-coupling.dl — turbo dogfood: trace the rusqlite dependency through
# dl's OWN module graph + call shapes, STRUCTURALLY (tree-sitter / ast-grep, no
# `match`/regex). Answers, from dl's own facts:
#   (1) which files bind a rusqlite symbol (import graph, not a text search),
#   (2) where they hand-roll SQL (prepare/execute/query_* — ast-grep byte spans),
#   (3) whether that access routes through the TYPED rel helpers or is bespoke,
#   (4) the call-graph blast radius of the bespoke sites.
# The bespoke count IS the interning-off-ramp surface the 0.10.0 text-is-sym arc
# kept re-hitting: every hand-rolled SQL site is a place the sym/text handshake
# can silently break.
#
#   Run:   dl .dl/rusqlite-coupling.dl
#   Gate:  dl .dl/rusqlite-coupling.dl --check     (warns on bespoke hotspots)

# ── Layer 1: the crate dependency, from the Cargo edge (not a grep) ──────────
rel uses_rusqlite(crate: text).
uses_rusqlite(src) <- crate_edge(src, "rusqlite", _, _).

# ── Layer 2: files that BIND a rusqlite symbol, via the resolved import graph ─
# module_binding(file, local_name, source_module, imported_name, kind). The bind
# is extracted STRUCTURALLY by the module resolver (not a text search); the
# source_module carries the full resolved path (`rusqlite::Connection`,
# `rusqlite::types::Value`), so a crate-root predicate selects every rusqlite
# entry. Catches `use rusqlite::{Connection, params, types::Value, ..}`.
rel rusqlite_file(file: file).
rusqlite_file(file) <- module_binding(file, _, source, _, _), source =~ /^rusqlite(::|$)/.

# The distinct symbols each file pulls in (Connection, Value, OptionalExtension …).
rel rusqlite_binding(file: file, local: text, imported: text).
rusqlite_binding(file, local, imported) <-
    module_binding(file, local, source, imported, _), source =~ /^rusqlite(::|$)/.

# ── Layer 3: SQL access call sites, ast-grep with precise byte spans ─────────
# One rule per rusqlite method that takes a SQL string. `$R` is any receiver
# expression, `$$$A` the argument list; sg yields the whole-match span
# (line,col,end_line,end_col) so overlapping matches dedupe by identical span.
rel raw_sql_site(file: file, line: int, col: int, end_line: int, end_col: int, verb: text).
raw_sql_site(file, line, col, end_line, end_col, "prepare") <- scan("src/**/*.rs", file, rev),
    sg(file, rev, :rust, "$R.prepare($$$A)", line, col, end_line, end_col).
raw_sql_site(file, line, col, end_line, end_col, "prepare_cached") <- scan("src/**/*.rs", file, rev),
    sg(file, rev, :rust, "$R.prepare_cached($$$A)", line, col, end_line, end_col).
raw_sql_site(file, line, col, end_line, end_col, "execute") <- scan("src/**/*.rs", file, rev),
    sg(file, rev, :rust, "$R.execute($$$A)", line, col, end_line, end_col).
raw_sql_site(file, line, col, end_line, end_col, "execute_batch") <- scan("src/**/*.rs", file, rev),
    sg(file, rev, :rust, "$R.execute_batch($$$A)", line, col, end_line, end_col).
raw_sql_site(file, line, col, end_line, end_col, "query_row") <- scan("src/**/*.rs", file, rev),
    sg(file, rev, :rust, "$R.query_row($$$A)", line, col, end_line, end_col).
raw_sql_site(file, line, col, end_line, end_col, "query_map") <- scan("src/**/*.rs", file, rev),
    sg(file, rev, :rust, "$R.query_map($$$A)", line, col, end_line, end_col).

# The TYPED rel-access helpers: the layer bespoke SQL should route through.
rel typed_sql_site(file: file, line: int, col: int, end_line: int, end_col: int, verb: text).
typed_sql_site(file, line, col, end_line, end_col, "insert_rows") <- scan("src/**/*.rs", file, rev),
    sg(file, rev, :rust, "$R.insert_rows($$$A)", line, col, end_line, end_col).
typed_sql_site(file, line, col, end_line, end_col, "encode_rel_rows") <- scan("src/**/*.rs", file, rev),
    sg(file, rev, :rust, "$R.encode_rel_rows($$$A)", line, col, end_line, end_col).
typed_sql_site(file, line, col, end_line, end_col, "refresh_rel") <- scan("src/**/*.rs", file, rev),
    sg(file, rev, :rust, "$R.refresh_rel($$$A)", line, col, end_line, end_col).
typed_sql_site(file, line, col, end_line, end_col, "reload_rel") <- scan("src/**/*.rs", file, rev),
    sg(file, rev, :rust, "$R.reload_rel($$$A)", line, col, end_line, end_col).

# ── Layer 4: combine — bespoke SQL concentrated in rusqlite-binding files ────
rel raw_in_bound_file(file: file, line: int, verb: text).
raw_in_bound_file(file, line, verb) <-
    raw_sql_site(file, line, _, _, _, verb), rusqlite_file(file).

rel raw_count(file: file, n: int).
raw_count(file, count(line)) <- raw_sql_site(file, line, _, _, _, _).
rel typed_count(file: file, n: int).
typed_count(file, count(line)) <- typed_sql_site(file, line, _, _, _, _).

# A bespoke hotspot: a file that hand-rolls SQL but never calls a typed helper
# (the pure off-ramp — a storage-representation change must touch it by hand).
rel bespoke_hotspot(file: file, raw: int).
bespoke_hotspot(file, raw) <- raw_count(file, raw), !typed_count(file, _), raw >= 4.

diag(path, line: 1, severity: "warning", code: "bespoke-sql",
     msg: "${raw} hand-rolled SQL sites, 0 typed rel-helper calls — route rel access through insert_rows/encode_rel_rows/decoded views (interning off-ramp surface)") <-
    bespoke_hotspot(path, raw).

# ── Layer 5: blast radius — functions holding a raw SQL site, followed through
# the call graph. df_node(id, kind, var, fn, file, line) gives the enclosing fn
# of a source line; call_edge(caller, callee, kind) is the resolved call graph.
rel raw_sql_fn(fn: text).
raw_sql_fn(fn) <- raw_sql_site(file, line, _, _, _, _), df_node(_, _, _, fn, file, line).

# Transitive callers of a raw-SQL fn: who is (indirectly) exposed to bespoke SQL.
rel raw_sql_reaches(caller: text, sql_fn: text).
raw_sql_reaches(caller, sql_fn) <- call_edge(caller, sql_fn, _), raw_sql_fn(sql_fn).
raw_sql_reaches(caller, sql_fn) <- call_edge(caller, mid, _), raw_sql_reaches(mid, sql_fn).

# ── Snapshot: one metric row per number (diff the artifact across refactors) ─
rel metric(name: text, n: int).
metric("rusqlite_files",      count(f)) <- rusqlite_file(f).
metric("raw_sql_sites",       count(l)) <- raw_sql_site(_, l, _, _, _, _).
metric("typed_sql_sites",     count(l)) <- typed_sql_site(_, l, _, _, _, _).
metric("bespoke_hotspots",    count(f)) <- bespoke_hotspot(f, _).
metric("raw_sql_fns",         count(f)) <- raw_sql_fn(f).
metric("callers_reaching_sql", count(c)) <- raw_sql_reaches(c, _).

? metric(name, n).
? bespoke_hotspot(file, raw).

# Versioned before/after artifact: re-run after each de-coupling phase, diff the md.
gen("examples/_auto-doc/rusqlite-coupling.md", "- {name}: {n}") <- metric(name, n).

# ── C6: op/family authoring surface — ZERO raw SQL, not a >=N-site threshold ─
# The C1 arc (`src/engine/family/`) made a family declare name/out_cols/
# input_rels/derive and read its inputs only through `Ctx::scan`
# (src/engine/family/mod.rs) — the framework's ONE sanctioned SQL read site.
# An op/family file (`call_site.rs`/`call_edge.rs`/`call_name.rs`, and any
# future `call_*.rs` sibling) must contain NO raw SQL at all. `mod.rs` and
# `router.rs` ARE the framework (Ctx::scan lives in mod.rs; the router only
# replays derives and never touches SQL) so both are excluded from the scope —
# this audits the AUTHORING files only.
#
# Reuses the bespoke-sql scan above (`raw_sql_site`, Layer 3) rather than a
# second scanner, plus two more candidate shapes it doesn't already cover
# (a hand-rolled `format!("SELECT ...")` string, a bare `rusqlite` reference).
# Unlike `bespoke_hotspot` (a >=4-site WARNING), any single hit here is an
# ERROR — an op file gets zero raw SQL, not "under some count".

rel family_op_file(file: file).
family_op_file(file) <- scan("src/engine/family/*.rs", file),
    file != "src/engine/family/mod.rs",
    file != "src/engine/family/router.rs".

# The line span of a family file's own `#[cfg(test)] mod tests { .. }` block
# (the exact `mod_item`/`has: field: name` shape rails.dl uses to exempt
# `mod tests` from the unwrap-budget rail). A family's own test fixtures
# (mirrors mod.rs's own test module, which sets up a fresh engine with raw
# `execute`/`prepare` calls) are not the op-authoring surface, so a candidate
# hit inside this span is exempt.
#
# NOTE: the mod.rs/router.rs exclusion is inlined here (not routed through
# `family_op_file`) — joining that derived rel against a SECOND `scan(...)`
# call on the same glob, in the same rule body, does not filter correctly in
# this engine (confirmed by hand: the join silently admits the excluded
# file). `family_op_file` is safe to join against another DERIVED rel (see
# `family_raw_call` below, which joins it with `raw_sql_site`); it is not
# safe to join against a fresh `scan`.
rel family_test_span(file: file, start_line: int, end_line: int).
family_test_span(file, start_line, end_line) <-
    scan("src/engine/family/*.rs", file, rev),
    file != "src/engine/family/mod.rs",
    file != "src/engine/family/router.rs",
    ast_yaml(file, rev, :rust, `
kind: mod_item
has:
  field: name
  regex: '^tests?$'
`, start_line, _, end_line, _).

# Candidate 1: a raw SQL call verb (prepare/prepare_cached/execute/
# execute_batch/query_row/query_map — "direct db.<verb>(...) SQL calls"),
# scoping the SAME raw_sql_site facts computed above to the op-authoring files.
# Safe: this joins family_op_file against another DERIVED rel, not a scan.
rel family_raw_call(file: file, line: int, verb: text).
family_raw_call(file, line, verb) <-
    raw_sql_site(file, line, _, _, _, verb), family_op_file(file).

# Candidate 2: a hand-authored `format!("...")` string naming a SQL verb — the
# exact `Ctx::scan` shape (`format!("SELECT {cols} FROM {rel}")`), hand-rolled
# directly in an op file instead of routed through the framework helper.
rel family_format_sql(file: file, line: int).
family_format_sql(file, line) <-
    scan("src/engine/family/*.rs", file, rev),
    file != "src/engine/family/mod.rs",
    file != "src/engine/family/router.rs",
    match(file, rev, /format!\(\s*"[^"]*\b(SELECT|INSERT|DELETE|UPDATE|CREATE)\b/, line).

# Candidate 3: a bare `rusqlite` reference — binding the crate directly
# instead of going through `Ctx`/`Db`.
rel family_rusqlite_ref(file: file, line: int).
family_rusqlite_ref(file, line) <-
    scan("src/engine/family/*.rs", file, rev),
    file != "src/engine/family/mod.rs",
    file != "src/engine/family/router.rs",
    match(file, rev, /rusqlite/, line).

# Unify the three candidate shapes, then drop anything inside the file's own
# test-module span (a legitimate fixture, not the authoring surface).
rel family_raw_sql_candidate(file: file, line: int, detail: text).
family_raw_sql_candidate(file, line, verb) <- family_raw_call(file, line, verb).
family_raw_sql_candidate(file, line, "format!(...) SQL string") <- family_format_sql(file, line).
family_raw_sql_candidate(file, line, "rusqlite reference") <- family_rusqlite_ref(file, line).

rel family_raw_sql_in_test(file: file, line: int, detail: text).
family_raw_sql_in_test(file, line, detail) <-
    family_raw_sql_candidate(file, line, detail),
    family_test_span(file, start_line, end_line),
    line >= start_line, line <= end_line.

rel family_raw_sql_finding(file: file, line: int, detail: text).
family_raw_sql_finding(file, line, detail) <-
    family_raw_sql_candidate(file, line, detail),
    !family_raw_sql_in_test(file, line, detail).

diag(path: file, line: line, severity: "error", code: "op-raw-sql",
     msg: "op/family file hand-rolls SQL (${detail}) — the op-authoring surface must read inputs through Ctx::scan (src/engine/family/mod.rs), the sole sanctioned SQL read site") <-
    family_raw_sql_finding(file, line, detail).

? family_raw_sql_finding(file, line, detail).
