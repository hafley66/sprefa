# Rail: static per-row write loop
#
# A `for` loop that drives a per-iteration `.execute("INSERT ...")` or
# `.execute("UPDATE ...")` is the classic N+1 write storm. Whole-table batched
# writes (`insert_rows`) are the fix. Flag the pair when the `for` line is
# within five lines above the `.execute` and the SQL literal starts with INSERT
# or UPDATE.
#
# Scope: src/**/*.rs, warning severity. Test code is excluded. Suppress with a
# comment containing `@per-row-ok:` inside or just above the loop.
#
# Run: dl .dl/static-n1.dl --check

rel per_row_execute(source_file: file, line_number: int).

# A .execute(...) call whose first argument is a double-quoted INSERT/UPDATE
# literal. Multi-line string starts are included; the prefix check is on the
# same line as the .execute opening.
per_row_execute(source_file, line_number) <-
    scan("WORK", "src/**/*.rs", source_file, source_rev),
    match_line(source_file, source_rev, /\.execute\(\s*"(?i)(INSERT|UPDATE)\b/, line_number).

# `for` loop lines.
rel for_loop_line(source_file: file, line_number: int).
for_loop_line(source_file, line_number) <-
    scan("WORK", "src/**/*.rs", source_file, source_rev),
    match_line(source_file, source_rev, /\bfor\s+/, line_number).

# A per-row write: for within five lines above the execute.
rel static_n1_pair(source_file: file, for_line: int, execute_line: int).
static_n1_pair(source_file, for_line, execute_line) <-
    per_row_execute(source_file, execute_line),
    for_loop_line(source_file, for_line),
    for_line >= execute_line - 5,
    for_line < execute_line.

# Test code is not production surface: exempt dedicated test files and anything
# at or below a cfg(test) marker.
rel test_only_file(source_file: file).
test_only_file(source_file) <- scan("WORK", "src/**/*_tests.rs", source_file, _).
test_only_file(source_file) <- scan("WORK", "src/**/tests.rs", source_file, _).

rel test_cfg_gate(source_file: file, line_number: int).
test_cfg_gate(source_file, line_number) <-
    scan("WORK", "src/**/*.rs", source_file, source_rev),
    match_line(source_file, source_rev, /#!?\[cfg\(test\)\]/, line_number).

rel static_n1_test_hit(source_file: file, execute_line: int).
static_n1_test_hit(source_file, execute_line) <-
    per_row_execute(source_file, execute_line), test_only_file(source_file).
static_n1_test_hit(source_file, execute_line) <-
    per_row_execute(source_file, execute_line),
    test_cfg_gate(source_file, gate_line),
    gate_line <= execute_line.

# Waiver: @per-row-ok: in a comment from just above the loop through the
# execute line.
# Waiver comment lines (source-only rel; the range join lives in the derived
# rule below — a source-op body cannot join other rels, the S6 sharp edge).
rel static_n1_waiver_line(source_file: file, waiver_line: int).
static_n1_waiver_line(source_file, waiver_line) <-
    scan("WORK", "src/**/*.rs", source_file, source_rev),
    comment(source_file, source_rev, /@per-row-ok:/, waiver_line, label: _).

rel static_n1_waiver(source_file: file, execute_line: int).
static_n1_waiver(source_file, execute_line) <-
    static_n1_waiver_line(source_file, waiver_line),
    static_n1_pair(source_file, for_line, execute_line),
    waiver_line >= for_line - 2,
    waiver_line <= execute_line.

# The advisory diag.
diag(
    path: source_file,
    line: execute_line,
    severity: "warning",
    code: "static-n1-write-loop",
    msg: "per-row `.execute(INSERT/UPDATE...)` inside a `for` loop — use a batched write instead"
) <-
    static_n1_pair(source_file, _, execute_line),
    !static_n1_test_hit(source_file, execute_line),
    !static_n1_waiver(source_file, execute_line).

? diag(path, line, severity, code, msg).
