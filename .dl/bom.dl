# bom.dl — a bill-of-materials cut of the member-flow graph. Rides
# flow-panel.dl's member_node/member_edge (the assembly hierarchy: repo -> dir
# -> file -> type -> member, via the path trie + `parent` column the panel
# already lists) and annotates every part with four quantities the panel
# renders as a right-aligned numeric band:
#
#   member_count -- direct members (children nested under this sym via parent)
#   fan_in       -- distinct incoming references (where-used: who depends on it)
#   fan_out      -- distinct outgoing references (depends-on: what it needs)
#   weight       -- a callable's span height (call_def end - line); 0 for
#                   types/fields/params/ret (no call_def span)
#
# The distinct counts ride the engine's set semantics: an intermediate rel
# projected to just the (source, target) pair dedups automatically, so a pair
# linked by BOTH a type edge and a call edge still counts once. Each count is
# then made TOTAL and single-valued over member_node's syms by a
# negation-guarded zero default (the same split flow-panel.dl uses for
# member_fn_has_parent / module_node), so the final bom_node join lands exactly
# one row per part.
#
# bom_node/bom_edge are purely derived -- never headed by a scan/ast/match
# source rule -- so the one-rel-one-rule-kind law holds.
#
# Panel SQL (dl: Flow Panel, preset "BOM table"):
#   nodes: SELECT sym, name, kind, file, line, parent,
#                 member_count, fan_in, fan_out, weight FROM rel_bom_node
#   edges: SELECT src, dst, kind FROM rel_bom_edge

use "flow-panel.dl".

# Every directed reference between two parts, whichever layer it came from.
# Set-deduped on (source, target), so type + call double-links count once.
rel bom_ref(source: text, target: text).
bom_ref(source, target) <- type_link(source, target, _).
bom_ref(source, target) <- call_edge(source, target, _).

# fan_in = distinct sources pointing AT a part (where-used).
rel bom_fan_in_raw(sym: text, n: int).
bom_fan_in_raw(target, count(source)) <- bom_ref(source, target).

rel bom_fan_in_has(sym: text).
bom_fan_in_has(sym) <- bom_fan_in_raw(sym, _).

rel bom_fan_in(sym: text, n: int).
bom_fan_in(sym, n) <- bom_fan_in_raw(sym, n).
bom_fan_in(sym, 0) <- member_node(sym, _, _, _, _, _), !bom_fan_in_has(sym).

# fan_out = distinct targets a part points AT (depends-on).
rel bom_fan_out_raw(sym: text, n: int).
bom_fan_out_raw(source, count(target)) <- bom_ref(source, target).

rel bom_fan_out_has(sym: text).
bom_fan_out_has(sym) <- bom_fan_out_raw(sym, _).

rel bom_fan_out(sym: text, n: int).
bom_fan_out(sym, n) <- bom_fan_out_raw(sym, n).
bom_fan_out(sym, 0) <- member_node(sym, _, _, _, _, _), !bom_fan_out_has(sym).

# member_count = direct children (member_node rows whose parent is this sym).
# member_node's own sym is unique per row (its key(sym) lattice), so counting
# the child sym per parent is a direct-member count. parent = "" is a top-level
# part (no owner) -- excluded so it doesn't count itself as its own group.
rel bom_member_count_raw(sym: text, n: int).
bom_member_count_raw(parent, count(child)) <-
  member_node(child, _, _, _, _, parent), parent != "".

rel bom_member_count_has(sym: text).
bom_member_count_has(sym) <- bom_member_count_raw(sym, _).

rel bom_member_count(sym: text, n: int).
bom_member_count(sym, n) <- bom_member_count_raw(sym, n).
bom_member_count(sym, 0) <- member_node(sym, _, _, _, _, _), !bom_member_count_has(sym).

# weight = a callable's span height. call_def(repo, sym, kind, file, line, end)
# carries one row per callable sym in the SAME repo-qualified format
# member_node's function/method rows use, so the sym joins directly. Only
# callables appear in call_def, so types/fields/params/ret fall to the 0
# default below -- the "functions only" weight the plan asks for, for free.
rel bom_weight_raw(sym: text, w: int).
bom_weight_raw(sym, def_end - def_line) <-
  call_def(_, sym, _, _, def_line, def_end).

rel bom_weight_has(sym: text).
bom_weight_has(sym) <- bom_weight_raw(sym, _).

rel bom_weight(sym: text, w: int).
bom_weight(sym, w) <- bom_weight_raw(sym, w).
bom_weight(sym, 0) <- member_node(sym, _, _, _, _, _), !bom_weight_has(sym).

# The BOM table: every member_node part plus its four quantities. Each count
# rel is total + single-valued over member_node.sym, so this inner join yields
# exactly one row per part.
rel bom_node(sym: text, name: text, kind: text, file: file, line: int, parent: text,
  member_count: int, fan_in: int, fan_out: int, weight: int).
bom_node(sym, name, kind, file, line, parent, member_count, fan_in, fan_out, weight) <-
  member_node(sym, name, kind, file, line, parent),
  bom_member_count(sym, member_count),
  bom_fan_in(sym, fan_in),
  bom_fan_out(sym, fan_out),
  bom_weight(sym, weight).

# The assembly edges: member_edge already restricts type_link/call_edge (and
# the fill/read/param/uses edges) to member_node endpoints, which are exactly
# the bom_node parts, so bom_edge is a straight passthrough.
rel bom_edge(src: text, dst: text, kind: text).
bom_edge(src, dst, kind) <- member_edge(src, dst, kind).

# ── bom_tier / bom_weld -- exploded-stratum layering (Track C, C3) ─────────
# Tier-major layering of the FILE import graph (module_edge), via 2-cycle
# condensation + longest-path assignment -- the same shape
# examples/dag-layers.dl uses (see that file's header for the full derivation
# notes: tier 0 = foundations depended on but depending on nothing, tier
# t = 1 + max(tier of dependencies)), but generalized from dag-layers'
# single-global-cluster simplification (`cl_rep(min(f)) <- cyclic(f)` takes
# ONE rep across every cyclic file in the whole graph -- fine for a corpus
# proven to have exactly one cyclic cluster, wrong the moment a corpus has
# TWO unrelated mutual pairs, which real module graphs do) to proper
# per-cluster connected components: label propagation to a fixpoint
# (bom_cluster_label, pure positive recursion) followed by a stratified
# min-reduce (bom_cluster_rep) picks out one rep PER component, so unrelated
# mutual pairs never merge into a single weld. Still only a 2-cycle detector
# (a direct mutual edge) -- a 3+-file cycle with no mutual pair slips through
# undetected, the same acknowledged limit dag-layers documents (the scc
# builtin's closure can't be read unpinned in a derived rule, engine.rs:653).
#
# Panel SQL (exploded list mode, riding the bomTable preset -- see
# PRESETS.bomTable in flow-panel.html):
#   LEFT JOIN rel_bom_tier ON file  -> tier column (stratum assignment)
#   LEFT JOIN rel_bom_weld ON file  -> rep + size columns (weld-card grouping)

rel bom_file(file: file).
bom_file(file) <- member_node(_, _, _, file, _, _).

# a mutual pair: both directions present between two distinct files.
rel bom_cluster_edge(file_a: file, file_b: file).
bom_cluster_edge(file_a, file_b) <-
  module_edge(file_a, file_b), module_edge(file_b, file_a), file_a != file_b.

rel bom_cyclic_file(member_file: file).
bom_cyclic_file(member_file) <- bom_cluster_edge(member_file, _).

# phase 1 (pure positive recursion): every label a member can reach by
# walking bom_cluster_edge (symmetric by construction, so this amounts to
# full connected-component reachability restricted to cyclic files).
rel bom_cluster_label(member_file: file, label_file: file).
bom_cluster_label(member_file, member_file) <- bom_cyclic_file(member_file).
bom_cluster_label(member_file, label_file) <-
  bom_cluster_edge(member_file, neighbor_file), bom_cluster_label(neighbor_file, label_file).

# phase 2 (stratified aggregation, outside the recursive cycle): min-reduce
# each member's reachable label set to ONE representative per component.
rel bom_cluster_rep(member_file: file, rep_file: file).
bom_cluster_rep(member_file, min(label_file)) <- bom_cluster_label(member_file, label_file).

rel bom_cluster_size(rep_file: file, member_count: int).
bom_cluster_size(rep_file, count(member_file)) <- bom_cluster_rep(member_file, rep_file).

# ── condensation + longest-path tiering (mirrors dag-layers.dl exactly) ────
# a cyclic file's rep is its cluster rep; a non-cyclic file is its own rep,
# so the condensation below is a DAG by construction.
rel bom_rep_of(member_file: file, rep_file: file).
bom_rep_of(member_file, rep_file) <- bom_cluster_rep(member_file, rep_file).
bom_rep_of(member_file, member_file) <- !bom_cyclic_file(member_file), module_edge(member_file, _).
bom_rep_of(member_file, member_file) <- !bom_cyclic_file(member_file), module_edge(_, member_file).

rel bom_cond_edge(rep_a: file, rep_b: file).
bom_cond_edge(rep_a, rep_b) <-
  module_edge(source_file, target_file), bom_rep_of(source_file, rep_a),
  bom_rep_of(target_file, rep_b), rep_a != rep_b.

rel bom_path_len(rep_file: file, depth: int).
bom_path_len(rep_file, 0) <- bom_cond_edge(_, rep_file), !bom_cond_edge(rep_file, _).
bom_path_len(rep_file, depth + 1) <- bom_cond_edge(rep_file, dep_file), bom_path_len(dep_file, depth).

rel bom_cluster_tier(rep_file: file, tier: int).
bom_cluster_tier(rep_file, max(depth)) <- bom_path_len(rep_file, depth).

# bom_tier is TOTAL over bom_file: a file with no module_edge participation at
# all (isolated -- no imports, no importers) defaults to tier 0, which is
# also what a corpus with no module-graph data at all collapses to (every
# file lands in one stratum -- the panel's "no layering" degenerate note).
rel bom_tier_has(file: file).
bom_tier_has(file) <- bom_rep_of(file, rep_file), bom_cluster_tier(rep_file, _).

rel bom_tier(file: file, tier: int).
bom_tier(file, tier) <- bom_rep_of(file, rep_file), bom_cluster_tier(rep_file, tier).
bom_tier(file, 0) <- bom_file(file), !bom_tier_has(file).

# bom_weld: every file's cluster rep + cluster size, TOTAL over bom_file so
# the panel's join never lands a NULL. size=1 marks "not welded" (the panel
# only draws a collapsed weld card when size > 1).
rel bom_weld_rep(file: file, rep: file).
bom_weld_rep(file, rep) <- bom_cluster_rep(file, rep).
bom_weld_rep(file, file) <- bom_file(file), !bom_cyclic_file(file).

rel bom_weld_size_has(file: file).
bom_weld_size_has(file) <- bom_weld_rep(file, rep), bom_cluster_size(rep, _).

rel bom_weld(file: file, rep: file, size: int).
bom_weld(file, rep, size) <- bom_weld_rep(file, rep), bom_cluster_size(rep, size).
bom_weld(file, file, 1) <- bom_file(file), !bom_weld_size_has(file).
