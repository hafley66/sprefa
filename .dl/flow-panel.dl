# flow-panel.dl — graph rels for the dl flow panel (editors/vscode-dl).
# A bare scan seeds the file set and triggers type extraction; referencing
# type_entity/type_link opts those built-ins in. panel_node/panel_edge are the
# curated panel-sized view: data types only (no fn/method noise), edges
# restricted to nodes both present.
#
# Panel SQL (paste into the nodes/edges boxes, or use the defaults which read
# rel_type_entity/rel_type_link directly):
#   nodes: SELECT sym, name, kind, file, line FROM rel_panel_node
#   edges: SELECT src, dst, kind FROM rel_panel_edge

rel seen(path: file).
seen(path) <- scan("WORK", "src/**/*.rs", path, rev).

rel panel_node(sym: text, name: text, kind: text, file: file, line: int).
panel_node(sym, name, "struct", file, line) <- type_entity(_, sym, name, "struct", _, file, line).
panel_node(sym, name, "enum", file, line)   <- type_entity(_, sym, name, "enum", _, file, line).
panel_node(sym, name, "trait", file, line)  <- type_entity(_, sym, name, "trait", _, file, line).

rel panel_edge(src: text, dst: text, kind: text).
panel_edge(src, dst, kind) <-
  type_link(src, dst, kind), panel_node(src, _, _, _, _), panel_node(dst, _, _, _, _).

# Module graph: the "Module graph" panel preset reads this section, backed by
# the engine's built-in resolved file-to-file import graph (module_edge)
# instead of the standalone madge.dl example — so it populates on any
# discovery daemon serving this repo's .dl/, not just when madge.dl happens
# to be loaded too. Referencing module_edge below opts module extraction in.
#
# Panel SQL (dl: Flow Panel, preset "Module graph"):
#   nodes: SELECT path, path, kind, path, 1 FROM rel_module_node
#   edges: SELECT src, dst, 'import' FROM rel_module_edge
#
# Universe = files that appear as either endpoint of a module_edge; a file
# with no import edges at all won't show up as a node here (fine for a panel
# preset — it has nothing to draw a line to).
rel mod_reach(src: path, dst: path).
mod_reach(a, b) <- module_edge(a, b).
mod_reach(a, c) <- mod_reach(a, b), module_edge(b, c).

rel module_cycle(path: path).
module_cycle(p) <- mod_reach(p, p).

rel module_node(path: path, kind: text).
module_node(p, "cycle") <- module_cycle(p).
module_node(p, "module") <- module_edge(p, _), !module_cycle(p).
module_node(p, "module") <- module_edge(_, p), !module_cycle(p).
