# D3 fix probe: does the per-repo repo column make BOTH roots' SCIP rows
# survive? Before the fix, merging base+head produced ZERO net rows from the
# second index (identical (symbol, relative_path) strings collapsed on the
# first-wins def_file map), so scip_def stayed at 3548 / scip_ref at 4724 with
# both repos present. After the fix each index is loaded per-input and tagged
# by origin repo, so counts roughly DOUBLE and both repo values appear.
#
# Run:
#   SPREFA_CONFIG=$PWD/bench/graph_diff/diff.config.toml \
#     target/release/dl bench/graph_diff/scip-count-probe.dl --root . --no-daemon \
#     --db <scratch>/count.sqlite

rel seen(path: file).
seen(path) <- scan("*", "WORK", "src/**/*.rs", path, rev).

rel scip_want(repo: text).
scip_want("base").

# Per-repo def/ref counts (grouped by the new repo column).
rel def_by_repo(repo: text, n: int).
def_by_repo(repo, count(sym)) <- scip_def(sym, file, repo).

rel ref_by_repo(repo: text, n: int).
ref_by_repo(repo, count(sym)) <- scip_ref(file, sym, def_file, repo).

# Grand totals across both repos (constant group key).
rel def_total(tag: text, n: int).
def_total("all", count(sym)) <- scip_def(sym, file, repo).

rel ref_total(tag: text, n: int).
ref_total("all", count(sym)) <- scip_ref(file, sym, def_file, repo).

? def_by_repo(repo, n).
? ref_by_repo(repo, n).
? def_total(tag, n).
? ref_total(tag, n).
