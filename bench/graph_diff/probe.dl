# D0 probe: seed interest over both config repos (base + head) so type/member
# extraction runs across both, then confirm both root-basename sym prefixes
# show up. Fan form: scan("*", "WORK", glob, path, rev) — first arg "*" fans
# over every configured repo, second arg "WORK" is the rev selector (each
# repo's own working tree), NOT a repo slug (the 4-ary scan's first string
# IS a rev selector, not a repo — this is the 5-ary fan form instead).
#
# Run: SPREFA_CONFIG=$PWD/bench/graph_diff/diff.config.toml \
#   ~/.cargo/bin/dl bench/graph_diff/probe.dl --root . --no-daemon --db <scratch>/d0.sqlite

rel seen(path: file).
rel ent(repo: text, sym: text).

seen(path) <- scan("*", "WORK", "src/**/*.rs", path, rev).

# Reading type_entity is what triggers type/member extraction to run at all
# (extraction rides the family's rels being USED, per the doc-comment-spine
# precedent — a doc-only program still triggers refresh_type_rels).
ent(repo, sym) <- type_entity(repo, sym, name, kind, parent, file, line).

? seen(path).
? ent(repo, sym).
