+% The dot spelling, printed back as `Root.field.sub`. Only the field names are
+% grammar-constrained to be identifier-shaped (the parser's member dot admits
+% only ident-start after the dot); the receiver prints through the ordinary
+% term printer so a nested proj chain reads left to right.
+print_proj_chain(Term, Bindings, Text) :-
+    flatten_proj(Term, Root, Fields),
+    print_term(Root, Bindings, 0, top, RootText),
+    field_dots(Fields, DotsText),
+    format(atom(Text), "~w~w", [RootText, DotsText]).
+
+flatten_proj(proj(Receiver, Field), Root, Fields) :- !,
+    flatten_proj(Receiver, Root, Prefix),
+    append(Prefix, [Field], Fields).
+flatten_proj(Root, Root, []).
+
+field_dots([], '').
+field_dots([Field | Rest], Text) :-
+    field_dots(Rest, RestText),
+    format(atom(Text), ".~w~w", [Field, RestText]).
+
 print_arg(Bindings, Arg, Text) :- print_term(Arg, Bindings, 0, top, Text).
 
