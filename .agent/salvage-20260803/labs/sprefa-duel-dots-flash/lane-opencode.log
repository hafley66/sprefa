+% Glued member dot `X.field` / `X.a.b` on a VARIABLE receiver. The dot is GLUED:
+% no whitespace before it and it must be followed by an identifier-start, so the
+% statement-terminator dot (followed by whitespace/EOF) and a spaced `x . y`
+% both stay out of this route. Float literals never arrive here (factor tries
+% float_lit first, and the dot of `1.5` requires a digit). The chain is built as
+% a nested proj/2 term, desugared by the dot expansion phase in 1_expansion.
+member_chain(E, _Vars, S0, S, Final) :-
+    ( S0 = [0'. | S1]
+    -> ident(Field, S1, S2),
+       member_chain(proj(E, Field), _Vars, S2, S, Final)
+    ; Final = E, S = S0
+    ).
+
 call_args([], Vars, Vars, S0, S) :- ws0(S0, S1), peek(0'), S1, S), !.
 call_args([Arg | Rest], Vars0, Vars, S0, S) :-
     ws0(S0, S1), expr(Arg, Vars0, Vars1, S1, S2), ws0(S2, S3),
     ( lit_dcg(`,`, S3, S4) -> call_args(Rest, Vars1, Vars, S4, S) ; Rest = [], Vars = Vars1, S = S3 ).

