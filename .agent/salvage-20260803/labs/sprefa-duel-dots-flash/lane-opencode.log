:- begin_tests(dot_member_access).

% Dotted member access is the THIRD spelling of a ref-column read. The parser
% keeps the chain as a nested proj/2 term so the surface program round-trips
% (parse -> print -> parse) with the dot intact; the dot expansion phase in
% 1_expansion then desugars it into the decode/2 nested-brace form the
% lowering already ships.

test(member_access_parses_to_proj_chain) :-
    string_codes(
        "coord(F.at.name, S, E) <- span(F, S, E).\n",
        Codes),
    parse_dl(Codes, Program, _, []),
    Program =@= prog([], [(coord(proj(proj(F, at), name), S, E) <- span(F, S, E))]).

test(single_field_parses_to_proj) :-
    string_codes("hit(F.repo) <- file(F, _).\n", Codes),
    parse_dl(Codes, Program, _, []),
    Program =@= prog([], [(hit(proj(F, repo)) <- file(F, _))]).

test(member_dot_round_trips_through_printer) :-
    string_codes("coord(F.at.name, S, E) <- span(F, S, E).\n", Codes),
    parse_dl(Codes, Program, Bindings, []),
    print_dl_program(Program, Bindings, Printed),
    atom_codes(Printed, PrintedCodes),
    parse_dl(PrintedCodes, RoundTripped, _, []),
    Program =@= RoundTripped.

test(spaced_dot_is_still_a_syntax_error,
     [throws(dl_parse_error(statement, _))]) :-
    string_codes("coord(F . at, S, E) <- span(F, S, E).\n", Codes),
    parse_dl(Codes, _, _, _).

test(statement_terminator_dot_still_terminates) :-
    string_codes("rel a(x: int).\nrel b(y: int).\nb(X) <- a(X).\n", Codes),
    parse_dl(Codes, Program, _, []),
    Program = Prog, memberchk(b(_) <- a(_), Prog).

test(float_literal_unaffected_by_member_dot) :-
    string_codes("rel a(x: float).\na(1.5).\n", Codes),
    parse_dl(Codes, Program, _, []),
    Program = prog(_, Rules),
    member(A, Rules),
    memberchk(float(1.5), A).

test(unbound_member_is_refused,
     [throws(unsupported_construct(unresolvable_member(foo.bar)))]) :-
    expand_program(prog([], [(hit(proj(foo, bar)) <- file(_, _))]), _, _).

test(bound_member_desugars_to_nested_decode) :-
    expand_program(
        prog([], [(coord(proj(proj(F, at), name), S, E) <- span(F, S, E))]),
        Expanded, _),
    Expanded = prog(_, Rules),
    memberchk((coord(Leaf, S, E) <- (span(F, S, E), decode(F, {at: {name: Leaf}}))), Rules).

test(chain_desugars_through_chained_bind) :-
    expand_program(
        prog([], [(hit(PathName) <- (span(FileRec, S, E),
                                     (PathName := proj(proj(FileRec, at), name))))]),
        Expanded, _),
    Expanded = prog(_, Rules),
    memberchk((hit(PathName) <- (span(FileRec, S, E),
                                 decode(FileRec, {at: {name: Leaf}}),
                                 (PathName := Leaf))), Rules).

:- end_tests(dot_member_access).
PLEOF
echo "appended"
appended
