:- use_module(library(occurs), [sub_term/2]).
:- use_module(library(lists), [append/3]).
go :-
    Bound = [RepoName2],
    Term = raw(RepoName, _, _, _),
    rewrite_term(Bound, Term, Out, Goals),
    writeln(user_error, out=Out),
    writeln(user_error, goals=Goals).
rewrite_term(_Bound, Term, Term, []) :- ( var(Term) ; atomic(Term) ), !.
rewrite_term(Bound, Term, Out, Goals) :-
    ( Term = proj(_, _)
    ->  chain_parts(Term, Root, Fields),
        memberchk_eq(Root, Bound),
        copy_term(_, Leaf),
        nested_brace(Fields, Leaf, Brace),
        Out = Leaf,
        Goals = [decode(Root, Brace)]
    ;   compound(Term),
        Term =.. [Functor | Args],
        maplist(rewrite_term(Bound), Args, OutArgs, GoalLists),
        append(GoalLists, Goals),
        Out =.. [Functor | OutArgs]
    ).
chain_parts(Term, Root, Fields) :-
    ( nonvar(Term), Term = proj(Receiver, Field)
    -> chain_parts(Receiver, Root, Prefix),
       append(Prefix, [Field], Fields)
    ; Root = Term, Fields = []
    ).
nested_brace([Field], Leaf, Brace) :- Brace = '{}'((Field : Leaf)).
memberchk_eq(Variable, [Head|_]) :- Head == Variable, !.
memberchk_eq(Variable, [_|Rest]) :- memberchk_eq(Variable, Rest).
EOF
